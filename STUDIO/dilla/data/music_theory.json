  "harmonic_movements": [
    {
      "name": "common-tone drift",
      "principle": "Keep one or two upper notes fixed while bass or inner voices move by step.",
      "use": "Connected motion without a strong cadence."
    },
    {
      "name": "descending inner voice",
      "principle": "Move one chord tone by semitone or whole tone while other voices stay or move minimally.",
      "use": "Bittersweet gravity from small changes."
    },
    {
      "name": "bass pedal",
      "principle": "Hold the bass while upper harmony changes.",
      "use": "Suspension, hypnosis and ambiguity."
    },
    {
      "name": "deceptive landing",
      "principle": "Approach an expected resolution, then move to a related chord that delays closure.",
      "use": "Keep a short loop turning over."
    },
    {
      "name": "chromatic approach",
      "principle": "Approach a target chord tone by semitone.",
      "use": "Give bass and melody a clear destination."
    },
    {
      "name": "third-related shift",
      "principle": "Move roots by a major or minor third, often preserving common tones.",
      "use": "Cinematic colour beyond routine fifth-based movement."
    },
    {
      "name": "upper-structure colour",
      "principle": "Vary ninths, elevenths, sixths and altered tones while preserving a clear bass.",
      "use": "Change emotional light without clutter."
    },
    {
      "name": "phrase-end suspension",
      "principle": "End on a chord that invites continuation rather than full resolution.",
      "use": "Make two- or three-bar loops replay naturally."
    }
  ],
