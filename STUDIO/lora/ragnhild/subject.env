# What differs between one LoRA subject and the next. Everything else lives in
# studio/lora/_toolkit and is shared.
SUBJECT=ragnhild
MODEL=ragnhild_v2
TRIGGER=ragnhild

# What anchors age and appearance when the trigger alone is not enough. The
# trigger carries the face; without this the model reaches for its own average
# of the word, which skews young. Read by _toolkit/shoots.rb.
DESCRIPTOR=adult Norwegian woman in her 40s
