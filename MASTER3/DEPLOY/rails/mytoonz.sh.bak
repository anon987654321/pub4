```zsh
#!/usr/bin/env zsh
set -euo pipefail

# MyToonz: AI-Powered Personalized Comic Strip Generator
# Generates authentic comic strips from user's daily stories using Replicate AI

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_NAME="mytoonz"
TEMP_DIRS=()

cleanup() {
    log "Cleaning up..."
    for dir in "${TEMP_DIRS[@]}"; do
        if [[ -d "$dir" ]]; then
            log "Removing temporary directory: $dir"
            rm -rf "$dir"
        fi
    done
    # Add any additional cleanup operations here
}

trap cleanup EXIT INT TERM

if [[ -f "${BASE_DIR}/__shared.sh" ]]; then
    source "${BASE_DIR}/__shared.sh"
else
    echo "Error: __shared.sh not found in ${BASE_DIR}" >&2
    exit 1
fi

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" >&2
}

log_error() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: $1" >&2
    exit 1
}

log_success() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] ✓ $1" >&2
}

check_dependencies() {
    log "Checking dependencies..."

    # Node.js with version check
    if ! command -v node >/dev/null 2>&1; then
        log_error "Node.js is required but not installed. Please install Node.js 16.0.0 or higher."
    fi

    NODE_VERSION=$(node --version | sed 's/v//')
    REQUIRED_NODE="16.0.0"

    # Improved version comparison using zsh numeric comparison
    if ! autoload is-at-least && is-at-least $REQUIRED_NODE $NODE_VERSION 2>/dev/null; then
        if [[ $? -ne 0 ]]; then
            log_error "Node.js version $REQUIRED_NODE or higher required. Found $NODE_VERSION"
        fi
    else
        # Fallback to awk if zsh's is-at-least not available
        if ! awk 'BEGIN {split(ARGV[1], a, /\./); split(ARGV[2], b, /\./);
                for (i=1; i<=3; i++) {
                    if (a[i] + 0 < b[i] + 0) exit 1;
                    if (a[i] + 0 > b[i] + 0) exit 0;
                }
                exit 0}' "$NODE_VERSION" "$REQUIRED_NODE" 2>/dev/null; then
            log_error "Node.js version $REQUIRED_NODE or higher required. Found $NODE_VERSION"
        fi
    fi
    log_success "Node.js version $NODE_VERSION"

    # Package manager check
    if command -v npm >/dev/null 2>&1; then
        PACKAGE_MANAGER="npm"
        log_success "Using npm"
    elif command -v yarn >/dev/null 2>&1; then
        PACKAGE_MANAGER="yarn"
        log_success "Using yarn"
    else
        log_error "npm or yarn is required but not installed."
    fi

    # Optional dependencies with installation guidance
    local missing_optional=()
    if ! command -v redis-cli >/dev/null 2>&1; then
        missing_optional+=("redis-cli")
        log "Note: redis-cli not found (optional). Install with: brew install redis (macOS) or apt-get install redis-tools (Ubuntu)"
    fi

    if ! command -v git >/dev/null 2>&1; then
        missing_optional+=("git")
        log "Note: git not found (optional). Install with: brew install git (macOS) or apt-get install git (Ubuntu)"
    fi

    if [[ ${#missing_optional[@]} -gt 0 ]]; then
        log "Optional dependencies missing: ${missing_optional[*]}"
    fi
}

validate_redis_url() {
    local redis_url="$1"
    # More comprehensive Redis URL validation
    if [[ ! "$redis_url" =~ ^redis://([^:/]+)(:([0-9]+))?(/.*)?$ ]]; then
        log_error "Invalid Redis URL format. Expected: redis://hostname[:port][/database]"
    fi

    local host=${match[1]}
    local port=${match[3]:=6379}

    if [[ -z "$host" ]]; then
        log_error "Redis URL must include a hostname"
    fi

    if [[ ! "$port" =~ ^[0-9]+$ ]] || [[ $port -lt 1 ]] || [[ $port -gt 65535 ]]; then
        log_error "Invalid Redis port: $port"
    fi
}

validate_replicate_token() {
    local token="$1"
    # Basic format validation for Replicate tokens (typically start with r8_)
    if [[ ${#token} -lt 20 ]] || [[ ! "$token" =~ ^r8_ ]]; then
        log_error "Invalid Replicate token format. Token should start with 'r8_' and be at least 20 characters long."
    fi
}

load_env() {
    local env_file="${BASE_DIR}/.env"
    if [[ -f "$env_file" ]]; then
        log "Loading environment variables from $env_file"
        # Use zsh built-in for safer env loading
        while IFS='=' read -r key value || [[ -n "$key" ]]; do
            # Skip comments and empty lines
            if [[ -z "$key" || "$key" =~ ^# ]]; then
                continue
            fi
            # Remove quotes and export
            value="${value%\"}"
            value="${value#\"}"
            value="${value%\'}"
            value="${value#\'}"
            export "$key"="$value"
        done < "$env_file"
    else
        log "No .env file found at $env_file"
    fi
}

change_to_app_dir() {
    log "Changing to application directory: ${BASE_DIR}"
    cd "${BASE_DIR}" || log_error "Failed to change to application directory: ${BASE_DIR}"
}

# Main execution
main() {
    load_env
    check_dependencies
    change_to_app_dir

    # Validate required environment variables
    if [[ -z "${REDIS_URL:-}" ]]; then
        log_error "REDIS_URL environment variable is required"
    fi
    validate_redis_url "$REDIS_URL"

    if [[ -z "${REPLICATE_API_TOKEN:-}" ]]; then
        log_error "REPLICATE_API_TOKEN environment variable is required"
    fi
    validate_replicate_token "$REPLICATE_API_TOKEN"

    log "Starting ${APP_NAME}..."

    # Use the detected package manager
    case "${PACKAGE_MANAGER}" in
        "npm")
            npm start
            ;;
        "yarn")
            yarn start
            ;;
        *)
            log_error "Unsupported package manager: ${PACKAGE_MANAGER}"
            ;;
    esac
}

main "$@"
```
