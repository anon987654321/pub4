```zsh
#!/usr/bin/env zsh
# Voting System Generator
# Universal voting and reviews for all Rails apps

emulate -L zsh
setopt err_return no_unset pipe_fail extended_glob warn_create_global

log() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1"
}

check_rails_command() {
  if ! command -v bin/rails >/dev/null 2>&1; then
    log "Error: bin/rails command not found"
    return 1
  fi
  return 0
}

add_voting_system() {
  local app_name="${1:-${PWD##*/}}"
  log "Adding voting system to $app_name"

  install_voting_gems || return 1
  check_rails_command || return 1

  if generate_voting_models; then
    create_voting_controllers || return 1
    create_voting_routes || return 1
    create_voting_stimulus || return 1
  else
    log "Failed to generate voting models"
    return 1
  fi
}

install_voting_gems() {
  if [[ ! -f Gemfile ]]; then
    log "Error: Gemfile not found"
    return 1
  fi

  if ! grep -q "acts_as_votable" Gemfile; then
    echo "gem 'acts_as_votable'" >> Gemfile
  fi

  if ! grep -q "rails_ratings" Gemfile; then
    echo "gem 'rails_ratings'" >> Gemfile
  fi

  bundle install || return 1
}

generate_voting_models() {
  if [[ ! -f app/models/review.rb ]]; then
    bin/rails generate model Review rating:integer comment:text user:references reviewable:references{polymorphic} || return 1
  fi

  bin/rails db:migrate || return 1
}

create_voting_controllers() {
  local controller_dir="app/controllers"
  local votes_controller="$controller_dir/votes_controller.rb"

  if [[ ! -f $votes_controller ]]; then
    cat > $votes_controller << 'EOF'
class VotesController < ApplicationController
  before_action :authenticate_user!

  def create
    @votable = find_votable
    @votable.liked_by current_user
    redirect_back fallback_location: root_path
  end

  def destroy
    @votable = find_votable
    @votable.unliked_by current_user
    redirect_back fallback_location: root_path
  end

  private

  def find_votable
    params.each do |name, value|
      if name =~ /(.+)_id$/
        return $1.classify.constantize.find(value)
      end
    end
    nil
  end
end
EOF
  fi
}

create_voting_routes() {
  local routes_file="config/routes.rb"

  if grep -q "resources :votes" "$routes_file"; then
    return 0
  fi

  sed -i.bak '$ a\
resources :votes, only: [:create, :destroy]' "$routes_file"
}

create_voting_stimulus() {
  local stimulus_dir="app/javascript/controllers"
  local votes_controller="$stimulus_dir/votes_controller.js"

  if [[ ! -d $stimulus_dir ]]; then
    mkdir -p "$stimulus_dir"
  fi

  if [[ ! -f $votes_controller ]]; then
    cat > $votes_controller << 'EOF'
import { Controller } from "@hotwired/stimulus"

export default class extends Controller {
  static targets = ["count"]

  vote(event) {
    event.preventDefault()

    fetch(this.element.href, {
      method: this.element.dataset.method,
      headers: {
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
        'Accept': 'text/javascript'
      }
    })
    .then(response => response.text())
    .then(html => {
      eval(html)
    })
  }
}
EOF
  fi
}
```
