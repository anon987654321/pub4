#!/bin/bash

set -euo pipefail

APP_NAME="brgen_tv"
BASE_DIR="${HOME}/rails"
SERVER_IP="${SERVER_IP:-185.52.176.18}"
APP_PORT=$((10000 + RANDOM % 10000))
SCRIPT_DIR=$(dirname "$(realpath "$0")")
MAX_PORT_ATTEMPTS=100
PORT_ATTEMPT=0

if [ -f "${SCRIPT_DIR}/shared_functions.sh" ]; then
    . "${SCRIPT_DIR}/shared_functions.sh"
else
    echo "Error: shared_functions.sh not found in ${SCRIPT_DIR}" >&2
    exit 1
fi

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

handle_error() {
    local exit_code=$1
    local context=$2
    log "ERROR: ${context} failed with exit code ${exit_code}"
    exit ${exit_code}
}

trap 'handle_error $? "Script execution"' ERR

log "Starting Brgen TV setup with video streaming and live broadcasting"

check_port_availability() {
    if command -v nc >/dev/null 2>&1; then
        if nc -z localhost "$1" 2>/dev/null; then
            return 1
        fi
    elif command -v ss >/dev/null 2>&1; then
        if ss -lnt | grep -q ":${1} "; then
            return 1
        fi
    elif command -v netstat >/dev/null 2>&1; then
        if netstat -lnt | grep -q ":${1} "; then
            return 1
        fi
    fi
    return 0
}

log "Finding available port..."
while ! check_port_availability "${APP_PORT}"; do
    PORT_ATTEMPT=$((PORT_ATTEMPT + 1))
    if [ "${PORT_ATTEMPT}" -ge "${MAX_PORT_ATTEMPTS}" ]; then
        log "ERROR: Failed to find available port after ${MAX_PORT_ATTEMPTS} attempts"
        exit 1
    fi
    APP_PORT=$((10000 + RANDOM % 10000))
done
log "Selected port: ${APP_PORT}"

install_redis() {
    case "$(uname -s)" in
        OpenBSD)
            log "Installing Redis on OpenBSD..."
            if ! doas pkg_add redis; then
                log "Failed to install Redis via pkg_add. Check network connectivity and package repository configuration."
                return 1
            fi
            ;;
        Linux)
            if command -v apt-get >/dev/null 2>&1; then
                log "Installing Redis via apt..."
                if ! sudo apt-get update; then
                    log "Failed to update package lists"
                    return 1
                fi
                if ! sudo apt-get install -y redis-server; then
                    log "Failed to install redis-server package. Check dependencies and permissions."
                    return 1
                fi
                sudo systemctl enable redis-server --now
            elif command -v yum >/dev/null 2>&1; then
                log "Installing Redis via yum..."
                if ! sudo yum install -y redis; then
                    log "Failed to install Redis via yum. Check repository configuration."
                    return 1
                fi
                if command -v systemctl >/dev/null 2>&1; then
                    log "Unsupported Linux distribution. Please install Redis manually."
                return 1
            fi
            ;;
        Darwin)
            if command -v brew >/dev/null 2>&1; then
                log "Installing Redis via Homebrew..."
                if ! brew install redis; then
                    log "Failed to install Redis via Homebrew. Check Homebrew installation and permissions."
                    return 1
                fi
                Please install Redis manually or install Homebrew first."
                return 1
            fi
            ;;
        *)
            log "Unsupported operating system: $(un-server >/dev/null 2>&1; then
    if ! install_un the script."
        exit 1
    fi
else
    log "Setting up full Brgen TV application..."

    if [ !p "${BASE_DIR}" || handle_error $? "Create base directory"
_error $? "Clone repository"
        cd "${APP_NAME}" || handle_error $? "Change to app directory"
    else
        cd "${APP log "Updating existing repository..."
        git pull || handle_error $    bundle install || handle_error $? "Bundle install"
    yarn install || handle_error $? "Yarn install"

    log "Setting up database..."
    rails db:setup || handle_error $? "Database setup"

    log "Compiling assets..."
    rails assets:precompile || handle_error $? "Assets precompilation"
}

setup_full_app

log "Brgen TV setup completed successfully on port ${APP_PORT}"
log "Server IP: ${SERVER_IP}"
log "You can start the server with: rails server -p ${APP_PORT} -b ${SERVER_IP}"
