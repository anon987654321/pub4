```zsh
#!/usr/bin/env zsh
set -euo pipefail

# Shared functions for Rails applications
SCRIPT_DIR="${0:a:h}"
[[ -n "$SCRIPT_DIR" && -d "$SCRIPT_DIR" ]] || {
    printf "ERROR: Failed to determine script directory\n" >&2
    exit 1
}

# Logging function
log() {
    printf "[%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# Source all feature files with error handling
feature_files=("${SCRIPT_DIR}"/@*_features.sh "${SCRIPT_DIR}"/@stimulus_controllers/*.sh)
if (( ${#feature_files[@]} )); then
    for feature_file in "${feature_files[@]}"; do
        if [[ -f "$feature_file" ]]; then
            if ! source "$feature_file" 2>/dev/null; then
                log "WARNING: Failed to source $feature_file, continuing..."
            fi
        fi
    done
fi

# Get application port from master.json
# Usage: get_app_port "brgen" -> 10001
get_app_port() {
    local app_name="$1"
    local master_json="${MASTER_JSON:-${SCRIPT_DIR}/../master.json}"

    if [[ -z "$app_name" ]]; then
        log "ERROR: Application name is required"
        return 1
    fi

    if [[ ! -f "$master_json" ]]; then
        log "ERROR: master.json not found at $master_json"
        return 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        log "ERROR: jq is required to parse master.json but not installed"
        return 1
    fi

    local app_data
    if ! app_data=$(jq -e --arg app_name "$app_name" '.apps[] | select(.name == $app_name)' "$master_json" 2>/dev/null); then
        log "ERROR: Application '$app_name' not found in master.json"
        return 1
    fi

    local port
    if ! port=$(jq -e -r '.port' <<< "$app_data" 2>/dev/null) || [[ -z "$port" ]]; then
        log "ERROR: Application '$app_name' found in master.json but no port defined"
        return 1
    fi

    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        log "ERROR: Invalid port number '$port' for application '$app_name'"
        return 1
    fi

    echo "$port"
}
```
