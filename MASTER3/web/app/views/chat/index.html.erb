<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#020000">
  <title>master3</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}

    :root{
      --bg:       #020000;
      --surface:  #0d0000;
      --red:      #cc3333;
      --red-dim:  #661111;
      --red-dark: #330808;
      --text:     #cccccc;
      --text-dim: #555555;
      --text-muted:#333333;
      --prompt:   #993333;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-top:    env(safe-area-inset-top, 0px);
    }

    html,body{
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font: 14px/1.5 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Courier New',monospace;
      overflow: hidden;
    }

    /* ── Layout ── */
    #terminal{
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      padding-top: var(--safe-top);
      padding-bottom: var(--safe-bottom);
    }

    /* ── Header bar (status line) ── */
    #statusbar{
      flex-shrink: 0;
      background: var(--red-dark);
      border-bottom: 1px solid var(--red-dim);
      padding: 4px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--text-dim);
      user-select: none;
    }
    #statusbar .left{ color: var(--red); font-weight: bold; letter-spacing: 0.05em; }
    #statusbar .right{ display: flex; gap: 16px; }
    #statusbar .right span{ color: var(--text-muted); }
    #statusbar .right span.val{ color: var(--text-dim); }

    /* ── Scrollback ── */
    #output{
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 8px 12px 4px;
      scroll-behavior: smooth;
    }
    #output::-webkit-scrollbar{ width: 4px; }
    #output::-webkit-scrollbar-track{ background: transparent; }
    #output::-webkit-scrollbar-thumb{ background: var(--red-dim); border-radius: 2px; }

    /* ── Lines ── */
    .line{
      display: flex;
      gap: 0;
      line-height: 1.55;
      word-break: break-word;
      white-space: pre-wrap;
    }
    .line + .line{ margin-top: 1px; }

    /* Dmesg boot lines */
    .line-dmesg{ color: var(--text-muted); font-size: 12px; }

    /* User input lines */
    .line-user .prompt{
      color: var(--prompt);
      white-space: nowrap;
      flex-shrink: 0;
      font-weight: bold;
    }
    .line-user .content{ color: var(--text); padding-left: 1ch; }

    /* AI response lines */
    .line-ai .content{
      color: var(--text);
      padding-left: 0;
    }
    .line-ai .content.streaming::after{
      content: '▋';
      color: var(--red);
      animation: blink 1s step-end infinite;
    }
    @keyframes blink{ 0%,100%{opacity:1} 50%{opacity:0} }

    /* Error lines */
    .line-err .content{ color: var(--red); }
    .line-err .prefix{ color: var(--red); margin-right: 1ch; }

    /* System / separator */
    .line-sep{ color: var(--text-muted); font-size: 11px; margin: 6px 0 4px; }

    /* ── Thinking indicator ── */
    #thinking{
      display: none;
      padding: 0 12px 4px;
      color: var(--text-muted);
      font-size: 12px;
    }
    #thinking.active{ display: block; }
    #thinking::after{
      content: '...';
      animation: dots 1.2s step-end infinite;
    }
    @keyframes dots{
      0%  { content:'   '; }
      33% { content:'.  '; }
      66% { content:'.. '; }
      100%{ content:'...'; }
    }

    /* ── Input row ── */
    #input-row{
      flex-shrink: 0;
      border-top: 1px solid var(--red-dark);
      background: var(--surface);
      display: flex;
      align-items: center;
      padding: 8px 12px;
      gap: 0;
    }
    #input-prompt{
      color: var(--prompt);
      font-weight: bold;
      white-space: nowrap;
      flex-shrink: 0;
    }
    #input{
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--text);
      font: inherit;
      padding: 0 0 0 1ch;
      caret-color: var(--red);
    }
    #input::placeholder{ color: var(--text-muted); }

    /* ── Model badge ── */
    #model-badge{
      position: fixed;
      top: calc(32px + var(--safe-top));
      right: 12px;
      font-size: 10px;
      color: var(--text-muted);
      pointer-events: none;
      user-select: none;
      letter-spacing: 0.06em;
    }

    /* ── Mobile send button ── */
    @media(max-width:600px){
      #send-btn{
        display: inline-flex;
        align-items: center;
        background: none;
        border: 1px solid var(--red-dim);
        color: var(--red);
        font: inherit;
        font-size: 16px;
        padding: 0 10px;
        height: 32px;
        border-radius: 3px;
        cursor: pointer;
        flex-shrink: 0;
        margin-left: 8px;
      }
    }
    #send-btn{ display: none; }
  </style>
</head>
<body>
<div id="terminal">

  <div id="statusbar">
    <span class="left">master3</span>
    <div class="right">
      <span><span id="s-model" class="val"></span></span>
      <span>tokens:<span id="s-tokens" class="val">0</span></span>
      <span>cost:<span id="s-cost" class="val">$0.00</span></span>
      <span>up:<span id="s-uptime" class="val">0s</span></span>
    </div>
  </div>

  <div id="output"></div>
  <div id="thinking"></div>

  <div id="input-row">
    <span id="input-prompt">master3@<span id="prompt-model"><%= @model %></span>$</span>
    <input id="input" type="text" placeholder="type a message..." autocomplete="off" autocorrect="off" spellcheck="false">
    <button id="send-btn" onclick="sendMessage()">↵</button>
  </div>

</div>

<script>
  const out      = document.getElementById('output');
  const input    = document.getElementById('input');
  const thinking = document.getElementById('thinking');
  const sModel   = document.getElementById('s-model');
  const sTokens  = document.getElementById('s-tokens');
  const sCost    = document.getElementById('s-cost');
  const sUptime  = document.getElementById('s-uptime');
  const promptModel = document.getElementById('prompt-model');

  let model = '<%= @model %>';
  let busy  = false;

  // ── Boot: show dmesg lines ──────────────────────────────────────────────
  const bootDmesg = async () => {
    try {
      const r = await fetch('/chat/dmesg');
      const j = await r.json();
      j.lines.forEach(l => appendDmesg(l));
    } catch(e) {}
    appendSep('');
    appendSep(`master3@${model} ready — web ui on port 3000`);
    appendSep('');
    input.focus();
  };

  // ── Metrics polling ────────────────────────────────────────────────────
  const pollMetrics = async () => {
    try {
      const r = await fetch('/chat/metrics');
      const j = await r.json();
      sModel.textContent   = j.model || model;
      promptModel.textContent = j.model || model;
      model = j.model || model;
      sTokens.textContent  = j.tokens || 0;
      sCost.textContent    = j.cost   || '$0.00';
      const sec = Math.floor((j.uptime || 0) / 1000);
      sUptime.textContent  = sec < 60 ? sec+'s' : Math.floor(sec/60)+'m'+('0'+(sec%60)).slice(-2)+'s';
    } catch(e) {}
  };
  setInterval(pollMetrics, 3000);
  pollMetrics();

  // ── DOM helpers ────────────────────────────────────────────────────────
  const appendDmesg = text => {
    const d = document.createElement('div');
    d.className = 'line line-dmesg';
    d.innerHTML = `<span class="content">${esc(text)}</span>`;
    out.appendChild(d);
    scrollBottom();
  };

  const appendSep = text => {
    const d = document.createElement('div');
    d.className = 'line line-sep';
    d.textContent = text;
    out.appendChild(d);
    scrollBottom();
  };

  const appendUser = text => {
    const d = document.createElement('div');
    d.className = 'line line-user';
    d.innerHTML = `<span class="prompt">master3@${esc(model)}$</span><span class="content">${esc(text)}</span>`;
    out.appendChild(d);
    scrollBottom();
    return d;
  };

  const appendAI = () => {
    const d = document.createElement('div');
    d.className = 'line line-ai';
    d.innerHTML = `<span class="content streaming"></span>`;
    out.appendChild(d);
    scrollBottom();
    return d.querySelector('.content');
  };

  const appendErr = msg => {
    const d = document.createElement('div');
    d.className = 'line line-err';
    d.innerHTML = `<span class="prefix">✘</span><span class="content">${esc(msg)}</span>`;
    out.appendChild(d);
    scrollBottom();
  };

const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

// renderMd — escape first, then apply safe markdown patterns progressively
const renderMd = raw => {
  let t = esc(raw);
  t = t.replace(/```[\w]*\n?([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
  t = t.replace(/`([^`\n]+)`/g, '<code>$1</code>');
  t = t.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
  t = t.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
  t = t.replace(/\n/g, '<br>');
  return t;
};

  const scrollBottom = () => { out.scrollTop = out.scrollHeight; };

  // ── Send ───────────────────────────────────────────────────────────────
  const sendMessage = async () => {
    const text = input.value.trim();
    if (!text || busy) return;
    busy = true;
    input.value = '';

    appendUser(text);

    thinking.textContent = 'thinking';
    thinking.classList.add('active');

    const aiSpan = appendAI();

    try {
      const resp = await fetch('/chat/message', {
        method:  'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                   'X-CSRF-Token': csrfToken() },
        body:    'message=' + encodeURIComponent(text)
      });

      if (!resp.ok) throw new Error('HTTP ' + resp.status);

      thinking.classList.remove('active');

      const reader = resp.body.getReader();
      const dec    = new TextDecoder();
      let   buf    = '';
      let   txt    = '';

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        buf += dec.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop();

        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const chunk = line.slice(6);
          if (chunk === '[DONE]') {
            aiSpan.classList.remove('streaming');
            break;
          }
          txt += chunk;
          aiSpan.innerHTML = renderMd(txt);
          scrollBottom();
        }
      }
      aiSpan.classList.remove('streaming');
      if (!txt) aiSpan.innerHTML = '<em>(no response)</em>';

    } catch(e) {
      thinking.classList.remove('active');
      aiSpan.classList.remove('streaming');
      aiSpan.textContent = '';
      appendErr(e.message || 'request failed');
    }

    appendSep('');
    busy = false;
    input.focus();
    pollMetrics();
  };

  // ── Input handling ─────────────────────────────────────────────────────
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  // Show send button on mobile
  if ('ontouchstart' in window) {
    document.getElementById('send-btn').style.display = 'inline-flex';
  }

  // ── CSRF ───────────────────────────────────────────────────────────────
  const csrfToken = () => {
    const m = document.cookie.match(/(?:^|;\s*)_session_id=([^;]+)/);
    const meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.getAttribute('content') : '';
  };

  // ── Boot ───────────────────────────────────────────────────────────────
  bootDmesg();
</script>
<%= csrf_meta_tags %>
</body>
</html>
