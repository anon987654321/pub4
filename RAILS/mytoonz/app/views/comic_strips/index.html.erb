<% content_for :title, "Comic Strips" %>

<header class="page-header" role="banner" aria-label="Mytoonz header">
  <h1>MyToonz</h1>
</header>
<p class="dim">Turn your day into a comic strip</p>

<% if authenticated? %>
  <section aria-label="Generate comic strip">
    <%= form_with model: ComicStrip.new, url: comic_strips_path, local: true, html: { class: "comic-form" } do |f| %>
      <%= f.text_area :prompt, placeholder: "How was your day?", required: true, rows: 3 %>
      <%= f.select :style, [["Comic", "comic"], ["Anime", "anime"], ["Cartoon", "cartoon"]], {}, required: true %>
      <%= f.submit "Generate Comic" %>
    <% end %>
  </section>
<% else %>
  <p><%= link_to "Sign in", new_session_path %> to generate comic strips.</p>
<% end %>

<%= live_search_index url: comic_strips_path, results_partial: "comic_strips/live_search_results", placeholder: "Search comic strips…", label: "Comic strip search", frame_id: "mytoonz-comics" %>