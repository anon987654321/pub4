<ul role="list" aria-label="Comic strip list" id="comic_strips">
  <% @comic_strips.each do |comic_strip| %>
    <li>
      <article>
        <h2><%= link_to comic_strip.prompt.truncate(60), comic_strip_path(comic_strip) %></h2>
        <p>Style: <%= comic_strip.style %> · Status: <%= comic_strip.status %></p>
        <small>by <%= comic_strip.user.email_address %></small>
      </article>
    </li>
  <% end %>
</ul>
<%= @pagy.series_nav if @pagy.pages > 1 %>