<ul role="list" aria-label="Comic strip list" id="comic_strips" class="comic-strip-list">
  <% @comic_strips.each do |comic_strip| %>
    <%= render "comic_strips/row", comic_strip: %>
  <% end %>
</ul>
<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "ComicStripsInfiniteScrollReflex#load_more",
           sentinel_id: "mytoonz-comic-strips-sentinel",
           q: params[:q] %>