  <% end %>
<% else %>
  <%= link_to new_session_path, class: nav_cls.(new_session_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M13.91 8.41L15.32 7 21 12.68l-5.68 5.68-1.41-1.41 3.26-3.27H3v-2h14.17l-3.26-3.27z"/></svg>
