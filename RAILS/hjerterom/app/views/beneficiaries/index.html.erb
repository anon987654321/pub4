<% content_for :title, "Beneficiaries" %>

<header class="page-header">
  <h1>Beneficiaries</h1>
</header>

<ul id="beneficiaries-list" class="beneficiary-list">
  <% @beneficiaries.each do |beneficiary| %>
    <%= render "beneficiaries/row", beneficiary: %>
  <% end %>
</ul>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "BeneficiariesInfiniteScrollReflex#load_more",
           sentinel_id: "hjerterom-beneficiaries-sentinel" %>