<%= form_with(model: [volunteer, shift], data: { turbo: true }) do |f| %>
  <div data-controller="datepicker">
    <%= render "shared/errors", object: shift %>
    <p><%= f.label :kind %><%= f.select :kind, Shift.kinds.keys.map { |k| [k.humanize, k] } %></p>
    <p><%= f.label :starts_at %><%= f.datetime_local_field :starts_at %></p>
    <p><%= f.label :ends_at %><%= f.datetime_local_field :ends_at %></p>
    <p><%= f.label :notes %><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :notes, rows: 2 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></p>
    <p><%= f.submit "Add shift" %></p>
  </div>
<% end %>