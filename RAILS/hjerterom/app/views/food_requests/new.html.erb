<% content_for :title, "Request #{@listing.title}" %>

<article>
  <h1><%= @listing.title %></h1>
  <%= render "shared/errors", object: @request %>
  <%= form_with url: food_listing_food_requests_path(@listing), data: { turbo: true } do |f| %>
    <p><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :message, rows: 2, placeholder: "Message (optional)…" , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></p>
    <p><%= f.datetime_local_field :pickup_time %></p>
    <p><%= f.submit "Request pickup" %></p>
  <% end %>
  <p><%= link_to "Back to listing", @listing %></p>
</article>