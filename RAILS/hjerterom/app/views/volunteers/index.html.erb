<% content_for :title, "Volunteers" %>
<h1>Volunteers</h1>
<% if @volunteers.any? %>
  <%= turbo_stream_from "hjerterom:volunteers" %>
  <ul id="volunteers" role="list" aria-label="Active volunteers">
    <%= render @volunteers %>
  </ul>
<% else %>
  <div class="empty" role="status" aria-live="polite"><p>No active volunteers yet.</p></div>
<% end %>
<% if authenticated? %>
  <%= link_to "Register as volunteer", new_volunteer_path %>
<% end %>
