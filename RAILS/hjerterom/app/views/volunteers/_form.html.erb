<%= form_with model: volunteer do |f| %>
  <% if volunteer.errors.any? %>
    <ul>
      <% volunteer.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>
  <p><%= f.label :name %><%= f.text_field :name %></p>
  <p><%= f.label :email %><%= f.email_field :email %></p>
  <p><%= f.label :phone %><%= f.telephone_field :phone %></p>
  <p><%= f.label :notes %><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :notes, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></p>
  <p><%= f.submit %></p>
<% end %>
