<% content_for :title, @volunteer.name %>
<%= render "volunteer_details", volunteer: @volunteer %>

<section>
  <h2>Upcoming shifts</h2>
  <ul id="shifts">
    <% if @shifts.any? %>
      <%= render partial: "shifts/shift", collection: @shifts %>
    <% else %>
      <li id="shifts-empty" class="dim">No upcoming shifts.</li>
    <% end %>
  </ul>
  <% if authenticated? %>
    <%= render "shifts/form", volunteer: @volunteer, shift: Shift.new %>
  <% end %>
</section>