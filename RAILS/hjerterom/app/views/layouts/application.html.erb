<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#000000" data-light-color="#ffffff" data-dark-color="#000000">
  <meta name="turbo-cache-control" content="no-preview">
  <%= tag.meta name: "turbo-cache-control", content: "no-cache" %>
  <title><%= content_for?(:title) ? "#{yield :title} — Hjerterom Åsane" : "Hjerterom Åsane" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Hjerterom Åsane — matredistribusjon og møteplass i Åsane, Bergen. Vi deler ut overskuddsmat, klær og bøker til de som trenger det." %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="Hjerterom Åsane">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Hjerterom Åsane" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Matredistribusjon og møteplass i Åsane, Bergen. Vi deler ut overskuddsmat, klær og bøker til de som trenger det." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Hjerterom Åsane" %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "Matredistribusjon og møteplass i Åsane, Bergen. Vi deler ut overskuddsmat, klær og bøker til de som trenger det." %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preload" href="/icon.png" as="image">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= yield :json_ld %>
  <%= json_ld_script(organization_json_ld(site_name: "Hjerterom Åsane", url: root_url)) %>
  <%= javascript_importmap_tags %>
  <%= yield :head if content_for?(:head) %>
</head>
<body class="<%= content_for?(:body_class) ? yield(:body_class) : nil %>" data-pwa-key="hjerterom" data-controller="pwa-standalone">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%= render "shared/theme_toggle", storage_key: "hjerterom-theme" %>

<div class="theme-root">
<% unless content_for?(:body_class) && yield(:body_class).include?("map-home-page") %>
<div class="app-shell">
  <div class="layout">
    <aside class="sidebar" data-turbo-permanent>
      <%= link_to root_path, class: "brand brand-wordmark", aria: { label: "Hjerterom" } do %>
        <span class="brand-text">hjerte</span>
      <% end %>
      <nav role="navigation" aria-label="Primary navigation">
        <%= render "shared/sidebar_nav" %>
      </nav>
    </aside>

    <main id="main-content" role="main">
      <%= tag.p(notice, role: "status", class: "flash-notice") if notice %>
      <%= tag.p(alert, role: "alert", class: "flash-alert") if alert %>
      <%= yield %>
    </main>

    <aside class="widgets" aria-label="Sidebar widgets">
      <%= render "shared/widgets" %>
    </aside>
  </div>

  <nav role="navigation" class="tab-bar" aria-label="Mobile navigation" data-turbo-permanent>
    <%= link_to root_path, class: "tab-item", aria: { label: "Hjem" } do %>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 1.696L.622 8.807l1.06 1.696L3 9.679V19.5C3 20.881 4.119 22 5.5 22h4a1 1 0 001-1v-6h3v6a1 1 0 001 1h4c1.381 0 2.5-1.119 2.5-2.5V9.679l1.318.824 1.06-1.696L12 1.696z"/></svg>
    <% end %>
    <%= link_to food_listings_path, class: "tab-item", aria: { label: "Mat" } do %>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7z"/></svg>
    <% end %>
    <%= link_to resources_path, class: "tab-item", aria: { label: "Ressurser" } do %>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M6 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6H6z"/></svg>
    <% end %>
    <%= link_to community_path, class: "tab-item", aria: { label: "Fellesskap" } do %>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3z"/></svg>
    <% end %>
  </nav>
</div>
<% else %>
  <%= tag.p(notice, role: "status", class: "flash-notice") if notice %>
  <%= tag.p(alert, role: "alert", class: "flash-alert") if alert %>
  <main id="main-content" role="main"><%= yield %></main>
<% end %>
</div>

<%= render "shared/install_prompt" %>
</body>
</html>