<section id="food_listings" class="food-listing-grid">
  <% @listings.each do |listing| %>
    <%= render "food_listings/card", listing: %>
  <% end %>
</section>
<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "FoodListingsInfiniteScrollReflex#load_more",
           sentinel_id: "hjerterom-food-listings-sentinel",
           q: params[:q],
           lat: params[:lat],
           lng: params[:lng],
           radius_km: params[:radius_km] %>