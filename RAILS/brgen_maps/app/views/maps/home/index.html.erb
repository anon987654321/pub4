<% content_for :title, t("maps.map") %>
<%# The page is a full-bleed map, so its heading cannot be visible without
    sitting on top of the map. Hidden rather than absent: this was the one brgen
    surface with no heading at any level, which leaves it with no entry in the
    document outline and nothing for a screen reader to land on after the skip
    link. Same treatment the layout already gives the city apex h1. %>
<h1 class="visually-hidden"><%= t("maps.map") %></h1>

<%# data-controller carries map-morph-guard beside map: MapLibre owns the
    section's DOM once booted (canvas, controls, markers), so a Turbo page
    morph toward server HTML would tear the running map down. The guard keeps
    the section out of a morph; see map_morph_guard_controller.js. %>
<section role="region" aria-label="<%= t("maps.aria_map") %>" data-controller="map map-morph-guard" data-map-points-value="<%= json_escape(@points_json) %>" <%= tag.attributes("data-map-center-lat-value": @map_center_lat, "data-map-center-lng-value": @map_center_lng) %> data-map-zoom-value="<%= @map_center_lat.present? && @map_center_lng.present? ? 12 : 1.5 %>" data-map-style-url-value="https://tiles.openfreemap.org/styles/positron">
  <div id="map" class="map-canvas" data-map-target="canvas" aria-hidden="true"></div>

  <div class="map-hud" role="region" aria-label="<%= t("maps.hud_aria") %>">
    <div class="cluster">
      <input id="map-search" type="search" placeholder="<%= t("search.places") %>" data-map-target="search" role="searchbox" aria-label="<%= t("search.places_label") %>" class="map-search-input">
      <%= link_to t("maps.browse_list"), places_path, class: "btn btn-ghost btn-sm map-browse-link" %>
    </div>
    <div id="place-popup" class="map-place-popup" data-map-target="popup" hidden role="status" aria-live="polite"></div>
  </div>
  <noscript>
    <p class="empty-state"><%= t("maps.needs_js") %> <%= link_to t("maps.browse_as_list"), places_path, class: "btn" %>.</p>
  </noscript>
</section>
