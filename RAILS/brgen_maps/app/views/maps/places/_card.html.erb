<article class="place-card" aria-label="<%= place.name %>">
  <% if place.photo.attached? %>
    <%= link_to place_path(place), class: "place-card__media" do %>
      <%= responsive_image_tag(place.photo, alt: place.name, loading: "lazy", class: "place-card__image") %>
    <% end %>
  <% end %>
  <h2><%= link_to place.name, place_path(place) %></h2>
  <p class="meta-facts">
    <%= tag.span t("maps.kinds.#{place.kind}", default: place.kind.to_s.humanize) %>
    <%= tag.span place.city.name if place.city %>
    <%= tag.span place.neighborhood.name if place.neighborhood %>
  </p>
  <% if place.address.present? %>
    <p><%= place.address %></p>
  <% end %>
</article>
