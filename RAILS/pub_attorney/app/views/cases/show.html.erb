<% content_for :title, @case.title %>

<article role="article" aria-label="Case details">
  <header>
    <h1><%= @case.title %></h1>
    <p><strong>Status:</strong> <%= @case.status %></p>
    <p><strong>Category:</strong> <%= @case.category %></p>
    <p><%= @case.description %></p>
  </header>

  <% if @case.lawyer %>
    <section aria-label="Assigned lawyer">
      <h2>Assigned Lawyer</h2>
      <%= link_to @case.lawyer.name, lawyer_path(@case.lawyer) %>
    </section>
  <% else %>
    <section aria-label="Lawyer matching"
             data-controller="case-match"
             data-case-type="<%= @case.category %>">
      <button data-reflex="click->CaseMatch#find_lawyers"
              data-case-type="<%= @case.category %>">
        Find Matching Lawyers
      </button>
      <div id="lawyer-matches"></div>
    </section>
  <% end %>

  <section aria-label="Documents">
    <h2>Documents</h2>
    <%= form_with model: [@case, Document.new], local: true do |f| %>
      <%= f.text_field :title, placeholder: "Document title", required: true %>
      <%= f.file_field :file %>
      <%= f.submit "Upload" %>
    <% end %>
    <ul role="list">
      <% @documents.each do |doc| %>
        <li>
          <% if doc.file.attached? %>
            <%= link_to doc.title, rails_blob_path(doc.file) %>
          <% else %>
            <%= doc.title %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</article>