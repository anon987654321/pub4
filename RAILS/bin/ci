#!/usr/bin/env ruby
# frozen_string_literal: true

# Canonical local Rails verification entrypoint.
# Contracts run once, then each Rails app runs its own CI entrypoint. This keeps
# the repository contract scope and app security/style/test scope in one watched
# command without using hosted CI.

require "rbconfig"

ROOT = File.expand_path("..", __dir__)
APPS = %w[brgen amber bsdports eritel].freeze

def run(label, *command, chdir: ROOT, env: {})
  puts "ci: #{label} — #{command.join(" ")}"
  ok = system(env, *command, chdir:)
  return true if ok && $?.success?

  warn "ci: #{label} failed"
  false
end

ok = run("contracts", RbConfig.ruby, File.join(ROOT, "test", "run_all.rb"))

APPS.each do |app|
  app_ok = run(app, RbConfig.ruby, File.join(ROOT, app, "bin", "ci"), chdir: File.join(ROOT, app),
               env: { "PUB4_CI_APP" => app })
  ok &&= app_ok
end

exit(ok ? 0 : 1)
