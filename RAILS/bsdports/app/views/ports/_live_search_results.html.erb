<% if @category %>
  <p><mark><%= @category.name %></mark> — <%= @category.description %></p>
<% end %>
<%= turbo_frame_tag "ports", target: "_top" do %>
<ul id="ports" role="list" aria-label="OpenBSD ports list" class="port-list">
  <% @ports.each do |port| %>
    <%= render "ports/row", port: %>
  <% end %>
</ul>
<% if @ports.empty? %>
  <div class="empty" role="status" aria-live="polite"><p>No ports found.</p></div>
<% end %>
<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "PortsInfiniteScrollReflex#load_more",
           sentinel_id: "bsdports-ports-sentinel",
           q: params[:q],
           category_id: params[:category_id],
           sort: params[:sort] %>
<% end %>
