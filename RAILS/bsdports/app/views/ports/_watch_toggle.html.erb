<div id="port_watch_<%= port.id %>">
  <% if watching %>
    <%= button_to t("ports.unwatch"), unwatch_port_path(port), method: :delete, data: { turbo_stream: true } %>
  <% else %>
    <%= button_to t("ports.watch"), watch_port_path(port), method: :post, data: { turbo_stream: true } %>
  <% end %>
</div>
