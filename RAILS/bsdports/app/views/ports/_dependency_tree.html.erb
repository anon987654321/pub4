<%# locals: (tree:, heading: nil) %>
<% if tree.any? %>
  <% if heading.present? %>
    <%= tag.section aria: { label: heading } do %>
      <%= tag.h2 heading %>
      <%= tag.ul role: "tree", aria: { label: heading } do %>
        <% tree.each do |node| %>
          <li role="treeitem" aria-label="<%= node[:label] %>">
            <%= node[:label] %>
            <% if node[:children].any? %>
              <%= render "ports/dependency_tree", tree: node[:children] %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <ul role="group">
      <% tree.each do |node| %>
        <li role="treeitem" aria-label="<%= node[:label] %>">
          <%= node[:label] %>
          <% if node[:children].any? %>
            <%= render "ports/dependency_tree", tree: node[:children] %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
