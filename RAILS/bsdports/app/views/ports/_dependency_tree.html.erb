<%# locals: (tree:, heading: nil) %>
<% if tree.any? %>
  <% if heading.present? %>
    <section aria-label="<%= heading %>">
      <%= tag.h2 heading %>
      <ul role="tree" aria-label="<%= heading %>">
        <% tree.each do |node| %>
          <li role="treeitem" aria-label="<%= node[:label] %>">
            <span><%= node[:label] %></span>
            <% if node[:children].any? %>
              <%= render "ports/dependency_tree", tree: node[:children] %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% else %>
    <ul role="group">
      <% tree.each do |node| %>
        <li role="treeitem" aria-label="<%= node[:label] %>">
          <span><%= node[:label] %></span>
          <% if node[:children].any? %>
            <%= render "ports/dependency_tree", tree: node[:children] %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
