<% content_for :title, "Ports" %>
<%# The page links the feed in its nav; readers and browsers look in the head. %>
<% content_for :head, auto_discovery_link_tag(:rss, ports_url(format: :rss), title: t("ports.rss_link")) %>
<%# search-hotkey was a bsdports-local controller binding / and Cmd-K on this page
    only, so the rest of the app had no search shortcut at all. Both keys are in the
    shared feed-hotkey controller now, declared once on the layout body. %>
<header class="page-header" aria-label="<%= t("ports.header_page_label") %>" data-visitor-orientation>
  <%= tag.h1 t("pages.ports") %>
  <p class="ports-purpose"><%= t("ports.purpose") %></p>
  <p><%= t("ports.search_hint") %></p>
  <nav aria-label="<%= t("nav.ports") %>">
    <%= link_to t("ports.rss_link"), ports_path(format: :rss) %>
  </nav>
  <%# The import date and the sort order belong above the list they describe.
      live_search_index renders the result list itself, so anything after it sat
      below an infinite scroll where nobody reached it. %>
  <% unless @catalog_empty %>
    <%# A ports tree with no date is a ports tree nobody can trust. %>
    <p>
      <% if @last_import %>
        <%= t("ports.last_import",
              status: t("ports.import_status.#{@last_import.status}", default: @last_import.status),
              count: @last_import.ports_count.to_i,
              when: time_ago_in_words(@last_import.started_at)) %>
      <% else %>
        <%= t("ports.never_imported") %>
      <% end %>
    </p>

    <%# sort=updated was written in the controller and reachable only by typing the
        query string. Name is the implicit default, so both are named here. The
        first chip read "OpenBSD ports", the page title, which named no order. %>
    <% by_updated = params[:sort] == "updated" %>
    <%# q rides along, or switching the order threw the search away. %>
    <% kept = { q: params[:q].presence, category_id: params[:category_id].presence } %>
    <nav class="sort-order" aria-label="<%= t("ports.sort_label") %>">
      <%= link_to t("ports.sort_name"), ports_path(kept),
                  class: "chip", aria: { current: by_updated ? nil : "true" } %>
      <%= link_to t("ports.updated"), ports_path(kept.merge(sort: "updated")),
                  class: "chip", aria: { current: by_updated ? "true" : nil } %>
    </nav>
  <% end %>
  <%= live_search_index url: ports_path,
                        results_partial: "ports/live_search_results",
                        placeholder: t("ports.search_placeholder"),
                        label: t("ports.search_label"),
                        frame_id: "bsdports-ports" %>
</header>

<%# An empty tree and a quiet tree look identical once the category list renders
    empty, and only one of them is a problem someone can fix. The controller has
    known which it was all along; nothing asked it. %>
<% if @catalog_empty %>
  <section aria-label="<%= t("ports.categories_section_label") %>">
    <%= tag.p t("ports.empty_unimported") %>
  </section>
<% else %>
  <% if @categories&.any? %>
    <section class="categories" aria-label="<%= t("ports.categories_section_label") %>">
      <h2><%= t("ports.categories") %></h2>
      <ul class="category-list">
        <% @categories.each do |cat| %>
          <li><%= link_to cat.name, ports_path(category_id: cat.id), class: "chip" %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
