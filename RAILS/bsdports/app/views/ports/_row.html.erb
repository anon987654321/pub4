<li role="listitem" class="port-row">
  <p>
    <%= link_to port.name, port, class: "port-name" %>
    <code><%= port.version %></code>
    <code><%= port.pkgpath %></code>
  </p>
  <%# The category and the one-line comment are two facts, not one string with a
      dot between them: an empty comment left "devel ·" on every seeded row. %>
  <%# On a category page every row repeated the heading above it. %>
  <% unless @category == port.category %>
    <%= tag.small link_to(port.category.name, category_path(port.category)) %>
  <% end %>
  <%= tag.small port.comment if port.comment.present? %>
  <%# An unknown age is said once, on the port page. Printed here it was the same
      "update age unknown" under every row of an import that carries no dates. %>
  <% age = port.last_updated && (Date.current - port.last_updated).to_i %>
  <% if age %>
    <% stale = age > 365 %>
    <%# A machine date for the relative age, and the date itself on hover. %>
    <%= tag.span tag.time(t(stale ? "ports.age_stale" : "ports.age_updated", count: age),
                          datetime: port.last_updated.iso8601, title: l(port.last_updated)),
                 class: class_names("data-state", "data-state--stale": stale) %>
  <% end %>
</li>
