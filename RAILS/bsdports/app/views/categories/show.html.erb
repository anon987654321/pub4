<% content_for :title, @category.name %>
<% summary = @category.description.to_s.squish %>
<% content_for :description, summary.truncate(160) if summary.present? %>
<header aria-label="<%= t("ports.category_header_label") %>">
  <%= tag.h1 @category.name %>
  <%= tag.p @category.description %>
</header>
<%# ports/index is a full template, not a partial — rendering it raised
    MissingTemplate on every category page. The list body lives in ports/_list. %>
<%= render "ports/list" %>
