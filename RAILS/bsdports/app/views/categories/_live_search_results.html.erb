<% if live_search_query.present? %>
 <p class="dim"><%= @categories.size %> results for "<%= live_search_query %>"</p>
<% end %>

<%= turbo_frame_tag "bsdports-categories", target: "_top" do %>
<ul id="categories" role="list" aria-label="Categories">
 <% @categories.each do |cat| %>
 <li>
 <%= link_to cat.name, category_path(cat) %>
 <small><%= cat.description %></small>
 <small>(<%= cat.ports.size %> ports)</small>
 </li>
 <% end %>
</ul>

<% if @categories.empty? %>
 <%= render "shared/empty_state",
       title: t("empty.no_categories"),
       body: t("empty.no_categories_search"),
       action: { label: "All categories", path: categories_path } %>
<% end %>
<% end %>
