<% if live_search_query.present? %>
 <p><%= t("search.results_for", count: @categories.size, query: live_search_query) %></p>
<% end %>

<%= turbo_frame_tag "bsdports-categories", target: "_top" do %>
<ul id="categories" role="list" aria-label="<%= t("ports.categories_results_label") %>">
 <% @categories.each do |cat| %>
 <li>
 <%= link_to cat.name, category_path(cat) %>
 <%= tag.small cat.description %>
 <small>(<%= cat.ports.size %> ports)</small>
 </li>
 <% end %>
</ul>

<% if @categories.empty? %>
 <%= render "shared/empty_state",
       title: t("empty.no_categories"),
       body: t("empty.no_categories_search"),
       action: { label: t("actions.all_categories"), path: categories_path } %>
<% end %>
<% end %>
