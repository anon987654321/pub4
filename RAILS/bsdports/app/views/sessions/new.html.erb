<div class="auth-form">
  <%= tag.h1 t("auth.sign_in") %>
  <p class="auth-form-lead"><%= t("auth.sign_in_lead") %></p>
  <%= render "shared/oauth_links" %>
  <%= form_with url: session_path do |f| %>
    <%= render "shared/errors", object: f.object if f.object.respond_to?(:errors) %>
    <div class="field">
      <%= f.label :email_address, t("auth.email") %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= f.label :password, t("auth.password") %>
      <%= password_visibility_field f, :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="actions">
      <%= f.submit t("auth.sign_in"), class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.forgot_password"), new_password_path %>
    </p>
  <% end %>
</div>
