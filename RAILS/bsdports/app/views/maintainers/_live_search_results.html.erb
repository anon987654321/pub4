<% if live_search_query.present? %>
 <p class="dim"><%= @maintainers.size %> results for "<%= live_search_query %>"</p>
<% end %>

<%= turbo_frame_tag "bsdports-maintainers", target: "_top" do %>
<ul id="maintainers" role="list" aria-label="Maintainers">
 <% @maintainers.each do |maintainer| %>
 <li>
 <%= link_to maintainer.name, maintainer_path(maintainer) %>
 <% if maintainer.email.present? %><small><%= maintainer.email %></small><% end %>
 <small>(<%= maintainer.ports.size %> ports)</small>
 </li>
 <% end %>
</ul>

<% if @maintainers.empty? %>
 <%= render "shared/empty_state",
       title: "No maintainers",
       body: "No maintainers match this search.",
       action: { label: "All maintainers", path: maintainers_path } %>
<% end %>
<% end %>
