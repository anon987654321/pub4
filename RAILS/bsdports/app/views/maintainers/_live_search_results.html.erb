<% if live_search_query.present? %>
 <p><%= t("search.results_for", count: @maintainers.size, query: live_search_query) %></p>
<% end %>

<%= turbo_frame_tag "bsdports-maintainers", target: "_top" do %>
<ul id="maintainers" role="list" aria-label="<%= t("ports.maintainers_results_label") %>">
 <% @maintainers.each do |maintainer| %>
 <li>
 <%= link_to maintainer.name, maintainer_path(maintainer) %>
 <% if maintainer.email.present? %><%= tag.small obfuscated_email(maintainer.email) %><% end %>
 <%= tag.small t("ports.port_count", count: @port_counts.fetch(maintainer.id, 0)) %>
 </li>
 <% end %>
</ul>

<% if @maintainers.empty? %>
 <%= render "shared/empty_state",
       title: t("empty.no_maintainers"),
       body: t("empty.no_maintainers_search"),
       action: { label: t("actions.all_maintainers"), path: maintainers_path } %>
<% end %>
<% end %>
