<% content_for :title, @maintainer.name %>
<% content_for :description, t("maintainers.meta_description", name: @maintainer.name,
                                                       ports: t("ports.port_count", count: @pagy.count)) %>
<header>
  <%= tag.h1 @maintainer.name %>
  <% if @maintainer.email.present? %>
    <%= tag.p obfuscated_email(@maintainer.email) %>
  <% end %>
</header>
<%# A re-import can leave a maintainer with no ports; say so instead of an empty list. %>
<%= tag.p t("maintainers.no_ports"), class: "data-state" if @pagy.count.zero? %>
<%# Not id="ports": that id is the ports index turbo-frame. %>
<ul id="maintainer-ports" role="list" class="port-list"
    aria-label="<%= t("maintainers.ports_label", name: @maintainer.name) %>">
  <% @ports.each do |port| %>
    <%= render "ports/row", port: %>
  <% end %>
</ul>
<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "MaintainerPortsInfiniteScrollReflex#load_more",
           sentinel_id: "maintainer-ports-sentinel",
           maintainer_id: @maintainer.id %>
<noscript><%= render "shared/pager", pagy: @pagy %></noscript>
