#!/usr/bin/env ruby
# frozen_string_literal: true

# Eritel is intentionally a standalone Rails app, so its CI entrypoint carries
# the same security/style/test floor as the shared pub4 apps without pretending
# it has their CSS or engine topology.

steps = {
  "bundle" => %w[bundle check],
  "db_prepare" => %w[bundle exec rails db:prepare],
  "rubocop" => %w[bundle exec rubocop],
  "bundler_audit" => %w[bundle exec bundler-audit check --update],
  "brakeman" => %w[bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error],
  "test_db_prepare" => %w[bundle exec rails db:test:prepare],
  "rails_test" => %w[bundle exec rails test]
}.freeze

steps.each do |name, command|
  puts "eritel: #{name} — #{command.join(" ")}"
  system(*command) || exit($?.exitstatus || 1)
end
