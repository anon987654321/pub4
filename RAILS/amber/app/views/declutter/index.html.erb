<div class="declutter-page">
  <header role="banner" aria-label="<%= t("declutter.header_label") %>">
    <h1><%= t("pages.declutter") %></h1>
    <p><%= t("declutter.kondo_lead") %></p>
    <%# ai_declutter was routed and linked from nowhere: reachable only by typing
        the URL. It belongs on this page rather than in a tools drawer — someone
        already here has decided to declutter. %>
    <nav role="navigation" aria-label="<%= t("declutter.tools_label") %>" class="wardrobe-action-group">
      <%= link_to t("declutter.ai_guide"), ai_declutter_path, class: "btn" %>
    </nav>
  </header>

  <% if @summary.present? %>
    <section role="region" aria-label="<%= t("declutter.summary_label") %>">
      <h2><%= t("declutter.summary") %></h2>
      <div class="chips">
        <span class="chip"><%= @summary[:active_items] %> active</span>
        <span class="chip"><%= @summary[:declutter_box] %> in box</span>
        <span class="chip"><%= @summary[:sentimental_archive] %> memory</span>
        <span class="chip"><%= @summary[:never_worn] %> never worn</span>
        <span class="chip"><%= @summary[:released_items] %> released</span>
        <span class="chip"><%= number_to_currency(@summary[:amount_recovered]) %> recovered</span>
      </div>
      <% if @summary[:matrix].present? %>
        <p class="dim"><%= t("declutter.joy_use_matrix") %> <%= @summary[:matrix].map { |k, v| "#{k.to_s.humanize}: #{v}" }.join(" · ") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @overdue_challenges.present? %>
    <section role="region" aria-label="<%= t("declutter.overdue_label") %>">
      <h2><%= t("declutter.overdue_challenges") %></h2>
      <ul>
        <% @overdue_challenges.each do |challenge| %>
          <li>
            <%= link_to challenge.item.title, review_declutter_path(challenge.item) %>
            — due <%= challenge.due_on %>
            <%= button_to t("declutter.complete"), complete_challenge_declutter_path(challenge.item), method: :post, class: "btn-sm" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @active_challenges.present? %>
    <section role="region" aria-label="<%= t("declutter.active_label") %>">
      <h2><%= t("declutter.active_challenges") %></h2>
      <ul>
        <% @active_challenges.each do |challenge| %>
          <li><%= link_to challenge.item.title, item_path(challenge.item) %> — due <%= challenge.due_on %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @aging_box.present? %>
    <section role="region" aria-label="<%= t("declutter.box_label") %>">
      <h2><%= t("declutter.box_heading") %></h2>
      <p class="dim"><%= t("declutter.box_waited") %></p>
      <div class="items-grid">
        <% @aging_box.each do |item| %>
          <%= render "items/item", item: item %>
          <%= link_to t("actions.review"), review_declutter_path(item), class: "btn-sm" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @box_items.present? %>
    <section role="region" aria-label="<%= t("declutter.declutter_box") %>">
      <h2><%= t("declutter.declutter_box") %></h2>
      <div class="items-grid">
        <% @box_items.each do |item| %>
          <%= render "items/item", item: item %>
          <%= link_to t("actions.review"), review_declutter_path(item), class: "btn-sm" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @summary[:top_candidates].present? %>
    <section role="region" aria-label="<%= t("declutter.top_release_label") %>">
      <h2><%= t("declutter.highest_release") %></h2>
      <div class="items-grid">
        <% @summary[:top_candidates].each do |item| %>
          <%= render "items/item", item: item %>
          <%= link_to t("actions.review"), review_declutter_path(item), class: "btn-sm" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= turbo_frame_tag "declutter-duplicates" do %>
    <section role="region" aria-label="<%= t("declutter.duplicate_groups") %>">
      <h2><%= t("declutter.duplicate_groups") %></h2>
      <% if @duplicates.present? %>
        <% @duplicates.each do |group| %>
          <article role="article" aria-label="<%= t("declutter.duplicate_group") %>">
            <% items = group.respond_to?(:items) ? group.items : Array(group[:items] || group["items"] || group) %>
            <h3><%= pluralize(items.size, "item") %></h3>
            <div class="items-grid">
              <% items.each do |item| %>
                <%= render "items/item", item: item %>
                <%= link_to t("actions.review"), review_declutter_path(item), class: "btn-sm" %>
              <% end %>
            </div>
          </article>
        <% end %>
      <% else %>
        <p><%= t("declutter.no_duplicates") %></p>
      <% end %>
    </section>
  <% end %>
</div>
