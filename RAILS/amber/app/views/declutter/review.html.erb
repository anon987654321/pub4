<div class="declutter-page">
  <header aria-label="<%= t("declutter.review_header_label") %>">
    <%= tag.h1 t("declutter.review_title") %>
    <%= tag.p @item.title %>
  </header>

  <section role="region" aria-label="<%= t("declutter.item_under_review") %>">
    <%= render "items/item", item: @item %>
  </section>

  <% if @score.present? %>
    <section role="region" aria-label="<%= t("declutter.score") %>">
      <%= tag.h2 t("declutter.score") %>
      <dl class="meta">
        <% @score.each do |key, value| %>
          <%= tag.dt t("declutter.score_keys.#{key}", default: key.to_s.humanize) %>
          <%= tag.dd declutter_score_value(key, value) %>
        <% end %>
      </dl>
    </section>
  <% end %>

  <% if @action.present? %>
    <section role="region" aria-label="<%= t("declutter.recommended_action") %>">
      <%= tag.h2 t("declutter.recommended_action") %>
      <% recommendation = @action[:recommendation] || @action["recommendation"] %>
      <%= tag.p tag.strong(declutter_score_value(:recommendation, recommendation)) %>
      <p><%= @action[:copy] || @action["copy"] %></p>
      <p><%= t("declutter.destination") %> <%= (@action[:destination] || @action["destination"]).to_s.humanize %></p>
    </section>
  <% end %>

  <section role="region" aria-label="<%= t("declutter.decision_form") %>">
    <%= tag.h2 t("declutter.decision") %>
    <%= form_with model: @review, url: update_review_declutter_path(@item), method: :patch do |form| %>
      <div class="field">
        <%= form.label :decision %>
        <% decisions = %w[keep wear_this_week repair sell donate release sentimental_archive] %>
        <%= form.select :decision, declutter_target_options(decisions), include_blank: true %>
      </div>
      <div class="field">
        <%= form.label :reason_kept %>
        <%= form.text_field :reason_kept, placeholder: t("declutter.reason_kept") %>
      </div>
      <div class="field">
        <%= form.label :notes %>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
          <%= form.text_area :notes, rows: 4, data: { character_counter_target: "input" } %>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
      </div>
      <%= form.submit t("declutter.save_review"), class: "button" %>
    <% end %>
  </section>

  <section>
    <%= tag.h2 t("declutter.move_item") %>
    <nav aria-label="<%= t("declutter.move_item") %>">
      <%# Donate and release take the garment out of the active wardrobe, so they ask first. %>
      <% %w[keep wear_this_week repair sell donate sentimental_archive release].each do |target| %>
        <% confirm = t("declutter.confirm_leave_wardrobe", title: @item.title) if %w[donate release].include?(target) %>
        <%= button_to t("declutter.targets.#{target}"), move_declutter_path(@item, target: target), method: :patch,
              class: "button-small", form: { data: { turbo_confirm: confirm }.compact } %>
      <% end %>
      <%= button_to t("declutter.declutter_box"), move_declutter_path(@item, target: "declutter_box"), method: :patch, class: "button-small" %>
    </nav>
  </section>

  <section>
    <%= tag.h2 t("declutter.week_challenge") %>
    <%= form_with url: challenge_declutter_path(@item), method: :post do |form| %>
      <div class="field">
        <%= form.label :due_on, DeclutterChallenge.human_attribute_name(:due_on) %>
        <%= form.date_field :due_on, value: 7.days.from_now.to_date %>
      </div>
      <div class="field">
        <%= form.label :note, DeclutterChallenge.human_attribute_name(:note) %>
        <%= form.text_field :note, value: t("flash.wear_once_note") %>
      </div>
      <%= form.submit t("declutter.create_challenge"), class: "button" %>
    <% end %>
  </section>

  <% if @last_chance.present? %>
    <section>
      <%= tag.h2 t("declutter.last_chance_outfits") %>
      <p><%= t("declutter.one_more_role") %></p>
      <ul>
        <% @last_chance.each_with_index do |suggestion, index| %>
          <li>
            <%= tag.strong Array(suggestion[:titles] || suggestion["titles"]).join(" · ") %>
            <p><%= suggestion[:reason] || suggestion["reason"] %></p>
            <%= button_to t("declutter.create_outfit"), create_last_chance_outfit_declutter_path(@item, index: index), method: :post, class: "button-small" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= tag.p link_to(t("declutter.back_to_dashboard"), declutter_index_path) %>
</div>
