<%# "Dashboard" is the signed-in label; a guest and a crawler get the page
    they are on, the four looks its h1 names. %>
<% content_for :title, authenticated? ? t("home.dashboard") : t("home.looks.title") %>
<%# The signed-out landing page is the only surface a crawler reaches first.
    Describe the demo capsule it can actually follow; the signed-in dashboard
    is private and gets nothing. %>
<% if !authenticated? && @demo_items&.any? %>
  <% content_for :json_ld, json_ld_script(demo_item_list_schema(@demo_items, title: t("home.demo_capsule"))) %>
<% end %>

<%# The page is the mark (the layout draws it), four looks and the footer. The
    MASTER face is not embedded: its iframe points at ai.brgen.no, and a
    document load waits on its frames, so the page never reached readyState
    "complete" while MASTER was slow or down. ?master=1 still opens it. %>
<%# The heading is what orients a first visitor now that the guest hero is
    gone, so it carries the orientation marker the walkthrough check reads. The
    attribute has no CSS or controller behind it. %>
<h1 class="visually-hidden" data-visitor-orientation><%= t("home.looks.title") %></h1>
<%= render "looks", looks: @looks %>
<%= render "frontpage_posts", posts: @frontpage_posts %>

<%# Chatroulette-style: pair with a stranger now. Guests play; the ask is the
    consent, and no account is needed to talk. %>
<section class="encounter-cta" aria-label="<%= t("encounters.title") %>">
  <%= tag.h2 t("encounters.title") %>
  <p><%= t("encounters.lead") %></p>
  <%= button_to t("encounters.start"), encounters_path, method: :post, class: "button button-primary" %>
</section>

<% if authenticated? %>
  <% if @weather %>
    <div class="weather-bar">
      <%= icon :sun, size: 18 %>
      <%= StyleAssistant.weather_line(@weather) %>
    </div>
  <% end %>

  <header class="dash-stats">
    <dl>
      <div><%= tag.dt t("home.items") %><%= tag.dd @items_count %></div>
      <div><%= tag.dt t("home.spark_joy") %><%= tag.dd @joy_count %></div>
      <div><%= tag.dt t("home.never_worn") %><%= tag.dd @never_worn_count %></div>
      <div>
        <%= tag.dt t("home.utilisation") %>
        <%= tag.dd "#{@utilization_rate}%", class: ("stat-warn" if @utilization_rate < 20) %>
      </div>
    </dl>
    <nav role="navigation" aria-label="<%= t("home.dashboard") %>">
      <%= link_to t("home.add_item"), new_item_path, class: "button button-primary" %>
      <%= link_to t("home.search_wardrobe"), ai_search_path, class: "button" %>
      <%= link_to t("home.capsule_plan"), ai_capsule_path, class: "button" %>
    </nav>
  </header>

  <%= render "today_look", look: @today_look if @today_look&.any? %>

  <% if @planned_this_week.any? %>
    <section>
      <%= tag.h2 t("home.this_week") %>
      <ul class="plan-list" role="list">
        <% @planned_this_week.each do |plan| %>
          <li class="plan-row">
            <span class="plan-date"><%= l(plan.planned_date, format: :day) %></span>
            <%= link_to plan.outfit.name, plan.outfit %>
            <%# destructive: no-confirm-ok — reversible — this drops the outfit from today's plan, not the outfit %>
            <%= button_to t("actions.remove"), planned_outfit_path(plan), method: :delete, class: "button-link" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @worst_cpw.any? %>
    <section>
      <%= tag.h2 t("home.worst_cpw") %>
      <ul class="cpw-list" role="list">
        <% @worst_cpw.each do |item| %>
          <li class="cpw-row">
            <%= link_to item.title, item %>
            <%# Was a hardcoded £ next to eight number_to_currency calls that
                rendered $ — three currencies in one app, for a wardrobe priced
                in øre. %>
            <span class="cpw-val"><%= t("home.cpw_value", amount: number_to_currency(item.cost_per_wear), count: item.times_worn.to_i) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @aging_unworn.any? %>
    <section>
      <%= tag.h2 t("home.aging_unworn") %>
      <div class="item-grid"><%= render @aging_unworn %></div>
    </section>
  <% end %>

  <% if @recent_items.any? %>
    <%= tag.h2 t("home.recent") %>
    <div class="item-grid"><%= render @recent_items %></div>
    <p><%= link_to t("home.all_items"), items_path, class: "more_link" %></p>
  <% else %>
    <p><%= link_to t("home.first_item"), new_item_path, class: "more_link" %></p>
  <% end %>
<% end %>
