<% content_for :title, t("home.dashboard") %>
<%# The signed-out landing page is the only surface a crawler reaches first.
    Describe the demo capsule it can actually follow; the signed-in dashboard
    is private and gets nothing. %>
<% if !authenticated? && @demo_items&.any? %>
  <% content_for :json_ld, json_ld_script(demo_item_list_schema(@demo_items, title: t("home.demo_capsule"))) %>
<% end %>

<%# amber had no MASTER face surface at all; brgen has carried it on its home
    page since the embed landed. Same shared partial, amber's own heading. %>
<%= render "shared/master_embed", heading: "ask amber" %>

<% if authenticated? %>
  <% if @weather %>
    <div class="weather-bar">
      <%= @weather[:description] %> · <%= @weather[:temp] %>°C
      <% if @weather[:temp] < 10 %>· <%= t("home.wear_layers") %><% elsif @weather[:temp] > 20 %>· <%= t("home.light_fabrics") %><% end %>
    </div>
  <% end %>

  <header class="dash-stats">
    <dl>
      <div><%= tag.dt t("home.items") %><%= tag.dd @items_count %></div>
      <div><%= tag.dt t("home.spark_joy") %><%= tag.dd @joy_count %></div>
      <div><%= tag.dt t("home.never_worn") %><%= tag.dd @never_worn_count %></div>
      <div><%= tag.dt t("home.utilisation") %><dd class="<%= @utilization_rate < 20 ? 'stat-warn' : '' %>"><%= @utilization_rate %>%</dd></div>
    </dl>
    <nav role="navigation" aria-label="<%= t("home.dashboard") %>">
      <%= link_to t("home.add_item"), new_item_path, class: "btn btn--primary" %>
      <%= link_to t("home.search_wardrobe"), ai_search_path, class: "btn" %>
      <%= link_to t("home.capsule_plan"), ai_capsule_path, class: "btn" %>
    </nav>
  </header>

  <%= render "today_look", look: @today_look if @today_look&.any? %>

  <% if @planned_this_week.any? %>
    <section>
      <%= tag.h2 t("home.this_week") %>
      <div class="plan-list">
        <% @planned_this_week.each do |plan| %>
          <div class="plan-row">
            <span class="plan-date"><%= plan.planned_date.strftime("%a %-d") %></span>
            <%= link_to plan.outfit.name, plan.outfit %>
            <%= button_to t("actions.remove"), planned_outfit_path(plan), method: :delete, class: "btn-link" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @worst_cpw.any? %>
    <section>
      <%= tag.h2 t("home.worst_cpw") %>
      <div class="cpw-list">
        <% @worst_cpw.each do |item| %>
          <div class="cpw-row">
            <%= link_to item.title, item %>
            <%# Was a hardcoded £ next to eight number_to_currency calls that
                rendered $ — three currencies in one app, for a wardrobe priced
                in øre. %>
            <span class="cpw-val"><%= t("home.cpw_value", amount: number_to_currency(item.cost_per_wear), count: item.times_worn.to_i) %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @aging_unworn.any? %>
    <section>
      <%= tag.h2 t("home.aging_unworn") %>
      <div class="item-grid"><%= render @aging_unworn %></div>
    </section>
  <% end %>

  <% if @recent_items.any? %>
    <%= tag.h2 t("home.recent") %>
    <div class="item-grid"><%= render @recent_items %></div>
    <p><%= link_to t("home.all_items"), items_path %></p>
  <% else %>
    <p><%= link_to t("home.first_item"), new_item_path %></p>
  <% end %>
<% else %>
<%# The hero leads for a signed-out visitor. It used to sit below the feed,
      so the first screen was a chat embed, a compose box and twenty posts of
      seeded lorem before anything said what Amber is -- a visitor had to scroll
      past the entire feed to reach the sentence explaining the product and the
      only sign-in link on the page. Nothing reordered it at runtime either:
      data-visitor-orientation is a bare marker with no controller and no CSS
      behind it, so DOM order was simply render order. %>
  <section class="amber-guest-hero" data-visitor-orientation>
    <%# The Caprasimo SVG lives here now, on the one landing surface, rather than
        in chrome. It is a marketing mark: 1000x500, a radial gradient and its own
        "retro hairlines". Chrome on all three apps is the shared type-only
        wordmark (shared/_brand_mark), fixed top-left. A guest arriving at the
        root still meets the full logo; every other surface gets the wordmark. %>
    <div class="amber-logo-banner amber-logo-banner--hero">
      <%= render "shared/logo" %>
    </div>
    <h1 class="title"><%= t("home.guest_title") %></h1>
    <p class="body"><%= t("home.guest_body") %></p>
    <p class="actions">
      <%= link_to t("home.browse_demo"), demo_wardrobe_path, class: "btn btn--primary" %>
      <%= link_to t("auth.create_account"), new_registration_path, class: "btn btn--ghost" %>
    </p>
    <p class="amber-guest-secondary">
      <%= link_to t("nav.sign_in"), new_session_path %>
      <span aria-hidden="true"> · </span>
      <%= link_to t("home.ask_ai"), root_path(master: 1), data: { turbo: false } %>
    </p>
  </section>

  <%= render "shared/feed_compose" %>

  <section class="amber-guest-feed" aria-label="<%= t("home.style_feed") %>">
    <% if @guest_posts&.any? %>
      <%= render @guest_posts %>
    <% else %>
      <%= render "shared/empty_state",
            title: t("empty.no_posts_yet"),
            body: t("empty.guest_post"),
            action: { label: t("home.browse_demo"), path: demo_wardrobe_path } %>
    <% end %>
    <%= render "shared/pager", pagy: @pagy %>
  </section>

  <% if @demo_items&.any? %>
    <section>
      <%= tag.h2 t("home.demo_capsule") %>
      <p><%= t("home.demo_counts", pieces: t("items.pieces", count: @demo_items.size), outfits: t("outfits.count", count: @demo_outfits&.size.to_i)) %></p>
      <div class="item-grid"><%= render partial: "demo_wardrobe/item", collection: @demo_items %></div>
      <p><%= link_to t("demo.full_wardrobe"), demo_wardrobe_path %></p>
    </section>
  <% end %>
<% end %>
