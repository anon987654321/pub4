<% content_for :title, "Dashboard" %>

<%# amber had no MASTER face surface at all; brgen has carried it on its home
    page since the embed landed. Same shared partial, amber's own heading. %>
<%= render "shared/master_embed", heading: "ask amber" %>

<% if authenticated? %>
  <% if @weather %>
    <div class="weather-bar">
      <%= @weather[:description] %> · <%= @weather[:temp] %>°C
      <% if @weather[:temp] < 10 %>· Wear layers<% elsif @weather[:temp] > 20 %>· Light fabrics<% end %>
    </div>
  <% end %>

  <header class="dash-stats">
    <dl>
      <div><dt>Items</dt><dd><%= @items_count %></dd></div>
      <div><dt>Spark joy</dt><dd><%= @joy_count %></dd></div>
      <div><dt>Never worn</dt><dd><%= @never_worn_count %></dd></div>
      <div><dt>Utilisation</dt><dd class="<%= @utilization_rate < 20 ? 'stat-warn' : '' %>"><%= @utilization_rate %>%</dd></div>
    </dl>
    <nav role="navigation" aria-label="Quick actions">
      <%= link_to "Add item", new_item_path, class: "btn btn--primary" %>
      <%= link_to "Search wardrobe", ai_search_path, class: "btn" %>
      <%= link_to "Capsule plan", ai_capsule_path, class: "btn" %>
    </nav>
  </header>

  <% if @planned_this_week.any? %>
    <section>
      <h2>This week</h2>
      <div class="plan-list">
        <% @planned_this_week.each do |plan| %>
          <div class="plan-row">
            <span class="plan-date"><%= plan.planned_date.strftime("%a %-d") %></span>
            <%= link_to plan.outfit.name, plan.outfit %>
            <%= button_to "✕", planned_outfit_path(plan), method: :delete, class: "btn-link" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @worst_cpw.any? %>
    <section>
      <h2>Worst cost-per-wear</h2>
      <div class="cpw-list">
        <% @worst_cpw.each do |item| %>
          <div class="cpw-row">
            <%= link_to item.title, item %>
            <span class="cpw-val">£<%= item.cost_per_wear %>/wear · worn <%= item.times_worn %>×</span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @aging_unworn.any? %>
    <section>
      <h2>Aging unworn</h2>
      <div class="item-grid"><%= render @aging_unworn %></div>
    </section>
  <% end %>

  <% if @recent_items.any? %>
    <h2>Recent</h2>
    <div class="item-grid"><%= render @recent_items %></div>
    <p><%= link_to "All items →", items_path %></p>
  <% else %>
    <p><%= link_to "Add your first item", new_item_path %></p>
  <% end %>
<% else %>
<%# The hero leads for a signed-out visitor. It used to sit below the feed,
      so the first screen was a chat embed, a compose box and twenty posts of
      seeded lorem before anything said what Amber is -- a visitor had to scroll
      past the entire feed to reach the sentence explaining the product and the
      only sign-in link on the page. Nothing reordered it at runtime either:
      data-visitor-orientation is a bare marker with no controller and no CSS
      behind it, so DOM order was simply render order. %>
  <section class="amber-guest-hero" data-visitor-orientation>
    <h1 class="title">Amber turns your wardrobe into a working system.</h1>
    <p class="body">Catalog what you own, plan outfits, spot what you never wear, and get capsule suggestions before you buy more.</p>
    <p class="actions">
      <%= link_to "Browse demo wardrobe", demo_wardrobe_path, class: "btn btn--primary" %>
      <%= link_to "Create account", new_registration_path, class: "btn btn--ghost" %>
    </p>
    <p class="dim amber-guest-secondary">
      <%= link_to "Sign in", new_session_path %>
      <span aria-hidden="true"> · </span>
      <%= link_to "Ask Amber AI", root_path(master: 1), data: { turbo: false } %>
    </p>
  </section>

  <%= render "shared/feed_compose" %>

  <section class="amber-guest-feed" aria-label="Style feed">
    <% if @guest_posts&.any? %>
      <%= render @guest_posts %>
    <% else %>
      <%= render "shared/empty_state",
            title: "No posts yet",
            body: "Share an #ootd thought above — guests can post without an account.",
            action: { label: "Browse demo wardrobe", path: demo_wardrobe_path } %>
    <% end %>
    <%== pagy_nav(@pagy) if @pagy&.pages.to_i > 1 %>
  </section>

  <% if @demo_items&.any? %>
    <section>
      <h2>Demo capsule</h2>
      <p class="dim"><%= pluralize(@demo_items.size, "piece") %> · <%= pluralize(@demo_outfits&.size.to_i, "outfit") %> — no account required</p>
      <div class="item-grid"><%= render partial: "demo_wardrobe/item", collection: @demo_items %></div>
      <p><%= link_to "Full demo wardrobe →", demo_wardrobe_path %></p>
    </section>
  <% end %>
<% end %>
