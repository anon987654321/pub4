<%# locals: looks — Amber::HomeLooks::Look, four of them.
    Each look is a title and a track that steps from the whole outfit to one
    garment at a time. %>
<section class="amber-looks" aria-label="<%= t("home.looks.title") %>">
  <% looks.each_with_index do |look, index| %>
    <% name = look.name %>
    <% slides = look.captions(t("home.looks.whole")) %>
    <section class="amber-look" aria-labelledby="amber-look-<%= index %>">
      <h2 class="amber-look-title" id="amber-look-<%= index %>"><%= name %></h2>
      <div class="amber-look-stage">
        <div class="amber-look-track"
             tabindex="0"
             role="group"
             aria-label="<%= t("home.looks.swipe", name: name) %>">
          <% slides.each_with_index do |caption, position| %>
            <figure class="amber-look-slide">
              <figcaption>
                <span><%= caption %></span>
                <span class="amber-look-position"><%= t("home.looks.position", index: position + 1, count: slides.size) %></span>
              </figcaption>
            </figure>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</section>
