<%# The shared icon set, not thirteen hand-written glyphs. Each of these was an
    inline SVG element with a path copied into it and a solid fill, while
    shared/views/shared/icons is Lucide at 2px outline — so amber chrome was
    drawn in a different icon language from the rest of the family, and every
    glyph existed only here. shirt, layers, log_out and user_plus joined the
    shared set for this; the rest were already in it. %>
<% nav_cls = ->(path) { "nav-item#{" active" if current_page?(path)}" } %>
<%= link_to root_path, class: nav_cls.(root_path) do %>
  <%= icon :home, size: 26 %>
  <%= t("nav.home") %>
<% end %>
<% if authenticated? %>
  <%= link_to feed_posts_path, class: nav_cls.(feed_posts_path) do %>
    <%= icon :explore, size: 26 %>
    <%= t("nav.feed") %>
  <% end %>
  <%= link_to items_path, class: nav_cls.(items_path) do %>
    <%= icon :shirt, size: 26 %>
    <%= t("nav.wardrobe") %>
  <% end %>
  <%= link_to outfits_path, class: nav_cls.(outfits_path) do %>
    <%= icon :layers, size: 26 %>
    <%= t("nav.outfits") %>
  <% end %>
  <%# Mix & Match was a top-level nav entry in the original spec; the dressing
      room existed but was reachable only from a button on outfits#index. %>
  <%= link_to dressing_room_outfits_path, class: nav_cls.(dressing_room_outfits_path) do %>
    <%= icon :sparkles, size: 26 %>
    <%= t("nav.mix_match") %>
  <% end %>
  <%= link_to planned_outfits_path, class: nav_cls.(planned_outfits_path) do %>
    <%= icon :calendar, size: 26 %>
    <%= t("nav.planner") %>
  <% end %>
  <%= link_to ai_search_path, class: nav_cls.(ai_search_path) do %>
    <%= icon :search, size: 26 %>
    <%= t("nav.search") %>
  <% end %>
  <%= link_to messages_path, class: nav_cls.(messages_path) do %>
    <%= icon :messages, size: 26 %>
    <%= t("nav.messages") %>
  <% end %>
  <%= link_to session_path, class: "nav-item", data: { turbo_method: :delete, turbo_prefetch: false } do %>
    <%= icon :log_out, size: 26 %>
    <%= t("nav.sign_out") %>
  <% end %>
  <%= link_to new_item_path, class: "compose-btn" do %>
    <%= icon :compose, size: 22, css_class: "compose-icon" %>
    <span class="compose-label"><%= t("nav.add_item") %></span>
  <% end %>
<% else %>
  <%= link_to demo_wardrobe_path, class: nav_cls.(demo_wardrobe_path) do %>
    <%= icon :play, size: 26 %>
    <%= t("nav.demo") %>
  <% end %>
  <%= link_to new_session_path, class: nav_cls.(new_session_path) do %>
    <%= icon :sign_in, size: 26 %>
    <%= t("nav.sign_in") %>
  <% end %>
  <%= link_to new_registration_path, class: nav_cls.(new_registration_path) do %>
    <%= icon :user_plus, size: 26 %>
    <%= t("nav.sign_up") %>
  <% end %>
<% end %>
