<%# The shared icon set, not thirteen hand-written glyphs. Each of these was an
    inline SVG element with a path copied into it and a solid fill, while
    shared/views/shared/icons is Lucide at 2px outline — so amber chrome was
    drawn in a different icon language from the rest of the family, and every
    glyph existed only here. shirt, layers, log_out and user_plus joined the
    shared set for this; the rest were already in it. %>
<%= link_to root_path, class: "nav-item", aria: { current: nav_current(root_path) } do %>
  <%= icon :home, size: 26 %>
  <%= t("nav.home") %>
<% end %>
<% if authenticated? %>
  <%= link_to feed_posts_path, class: "nav-item", aria: { current: nav_current(feed_posts_path) } do %>
    <%= icon :explore, size: 26 %>
    <%= t("nav.feed") %>
  <% end %>
  <%= link_to items_path, class: "nav-item", aria: { current: nav_current(items_path, section: "items") } do %>
    <%= icon :shirt, size: 26 %>
    <%= t("nav.wardrobe") %>
  <% end %>
  <%= link_to outfits_path,
        class: "nav-item",
        aria: { current: nav_current(outfits_path, section: "outfits", except: %w[dressing_room]) } do %>
    <%= icon :layers, size: 26 %>
    <%= t("nav.outfits") %>
  <% end %>
  <%# Mix & Match was a top-level nav entry in the original spec; the dressing
      room existed but was reachable only from a button on outfits#index. %>
  <%= link_to dressing_room_outfits_path,
        class: "nav-item",
        aria: { current: nav_current(dressing_room_outfits_path) } do %>
    <%= icon :sparkles, size: 26 %>
    <%= t("nav.mix_match") %>
  <% end %>
  <%= link_to planned_outfits_path,
        class: "nav-item",
        aria: { current: nav_current(planned_outfits_path, section: "planned_outfits") } do %>
    <%= icon :calendar, size: 26 %>
    <%= t("nav.planner") %>
  <% end %>
  <%= link_to ai_search_path, class: "nav-item", aria: { current: nav_current(ai_search_path) } do %>
    <%= icon :search, size: 26 %>
    <%= t("nav.search") %>
  <% end %>
  <%= link_to messages_path, class: "nav-item", aria: { current: nav_current(messages_path, section: "messages") } do %>
    <%= icon :messages, size: 26 %>
    <%= t("nav.messages") %>
  <% end %>
  <%# Reachable before only from the footer or the home page's editorial nav. %>
  <%= link_to notifications_path,
        class: "nav-item",
        aria: { current: nav_current(notifications_path, section: "notifications") } do %>
    <%= icon :notifications, size: 26 %>
    <%= t("nav.notifications") %>
  <% end %>
  <%= link_to live_streams_path,
        class: "nav-item",
        aria: { current: nav_current(live_streams_path, section: "live_streams") } do %>
    <%= icon :video, size: 26 %>
    <%= t("nav.live") %>
  <% end %>
  <%= link_to declutter_index_path,
        class: "nav-item",
        aria: { current: nav_current(declutter_index_path, section: "declutter") } do %>
    <%= icon :chart, size: 26 %>
    <%= t("nav.declutter") %>
  <% end %>
  <%= link_to connections_path,
        class: "nav-item",
        aria: { current: nav_current(connections_path, section: "connections") } do %>
    <%= icon :profile, size: 26 %>
    <%= t("nav.connections") %>
  <% end %>
  <%# destructive: no-confirm-ok — reversible — signing out, and signing in again is the same click %>
  <%= link_to session_path, class: "nav-item", data: { turbo_method: :delete, turbo_prefetch: false } do %>
    <%= icon :log_out, size: 26 %>
    <%= t("nav.sign_out") %>
  <% end %>
  <%= link_to new_item_path, class: "compose-button" do %>
    <%= icon :compose, size: 22, css_class: "compose-icon" %>
    <span class="compose-label"><%= t("nav.add_item") %></span>
  <% end %>
<% else %>
  <%= link_to demo_wardrobe_path, class: "nav-item", aria: { current: nav_current(demo_wardrobe_path) } do %>
    <%= icon :play, size: 26 %>
    <%= t("nav.demo") %>
  <% end %>
  <%= link_to new_session_path, class: "nav-item", aria: { current: nav_current(new_session_path) } do %>
    <%= icon :sign_in, size: 26 %>
    <%= t("nav.sign_in") %>
  <% end %>
  <%= link_to new_registration_path, class: "nav-item", aria: { current: nav_current(new_registration_path) } do %>
    <%= icon :user_plus, size: 26 %>
    <%= t("nav.sign_up") %>
  <% end %>
<% end %>
