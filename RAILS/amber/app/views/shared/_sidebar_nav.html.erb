<% nav_cls = ->(path) { "nav-item#{" active" if current_page?(path)}" } %>
<%= link_to root_path, class: nav_cls.(root_path) do %>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 1.696L.622 8.807l1.06 1.696L3 9.679V19.5C3 20.881 4.119 22 5.5 22h4a1 1 0 001-1v-6h3v6a1 1 0 001 1h4c1.381 0 2.5-1.119 2.5-2.5V9.679l1.318.824 1.06-1.696L12 1.696z"/></svg>
  <%= t("nav.home") %>
<% end %>
<% if authenticated? %>
  <%= link_to feed_posts_path, class: nav_cls.(feed_posts_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 7.521 3.51 7.521 8 0 4.42-3.584 8-8.005 8h-1.061l-.503.501c-.854.854-1.993 1.374-3.249 1.414l-1.82.055.055-1.82c.04-1.256.56-2.395 1.414-3.249l.501-.503V10z"/></svg>
    <%= t("nav.feed") %>
  <% end %>
  <%= link_to items_path, class: nav_cls.(items_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 00-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 12 7.4l3.38 4.6L17 10.83 14.92 8H20v6z"/></svg>
    <%= t("nav.wardrobe") %>
  <% end %>
  <%= link_to outfits_path, class: nav_cls.(outfits_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    <%= t("nav.outfits") %>
  <% end %>
  <%# Mix & Match was a top-level nav entry in the original spec; the dressing
      room existed but was reachable only from a button on outfits#index. %>
  <%= link_to dressing_room_outfits_path, class: nav_cls.(dressing_room_outfits_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a2.5 2.5 0 00-2.5 2.5c0 .87.44 1.63 1.11 2.08L4 11.5V13h2v7h12v-7h2v-1.5l-6.61-4.92A2.49 2.49 0 0014.5 4.5 2.5 2.5 0 0012 2zm0 2a.5.5 0 110 1 .5.5 0 010-1zm0 4.24L16.9 12H7.1L12 8.24zM8 14h8v4H8v-4z"/></svg>
    <%= t("nav.mix_match") %>
  <% end %>
  <%= link_to planned_outfits_path, class: nav_cls.(planned_outfits_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 002 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/></svg>
    <%= t("nav.planner") %>
  <% end %>
  <%= link_to ai_search_path, class: nav_cls.(ai_search_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M10.25 3.75a7.25 7.25 0 105.66 5.66l4.1 4.1 1.06-1.06-4.1-4.1A7.25 7.25 0 0010.25 3.75zm0 1.5a5.75 5.75 0 110 11.5 5.75 5.75 0 010-11.5z"/></svg>
    <%= t("nav.search") %>
  <% end %>
  <%= link_to messages_path, class: nav_cls.(messages_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M1.998 5.5c0-1.381 1.119-2.5 2.5-2.5h15c1.381 0 2.5 1.119 2.5 2.5V16c0 1.381-1.119 2.5-2.5 2.5H9.72l-4.938 2.914A1.25 1.25 0 013 22.33V18h-.5c-.932 0-1.75-.643-1.952-1.556A2.507 2.507 0 011.998 16V5.5z"/></svg>
    <%= t("nav.messages") %>
  <% end %>
  <%= link_to session_path, class: "nav-item", data: { turbo_method: :delete, turbo_prefetch: false } do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
    <%= t("nav.sign_out") %>
  <% end %>
  <%= link_to new_item_path, class: "compose-btn" do %>
    <svg class="compose-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/></svg>
    <span class="compose-label"><%= t("nav.add_item") %></span>
  <% end %>
<% else %>
  <%= link_to demo_wardrobe_path, class: nav_cls.(demo_wardrobe_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
    <%= t("nav.demo") %>
  <% end %>
  <%= link_to new_session_path, class: nav_cls.(new_session_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M13.91 8.41L15.32 7 21 12.68l-5.68 5.68-1.41-1.41 3.26-3.27H3v-2h14.17l-3.26-3.27z"/></svg>
    <%= t("nav.sign_in") %>
  <% end %>
  <%= link_to new_registration_path, class: nav_cls.(new_registration_path) do %>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
    <%= t("nav.sign_up") %>
  <% end %>
<% end %>
