<%= form_with url: ai_search_path, method: :get, class: "widget-search", role: "search", local: true do |form| %>
  <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M10.25 3.75a7.25 7.25 0 105.66 5.66l4.1 4.1 1.06-1.06-4.1-4.1A7.25 7.25 0 0010.25 3.75zm0 1.5a5.75 5.75 0 110 11.5 5.75 5.75 0 010-11.5z"/></svg>
  <%= form.search_field :q, value: params[:q], placeholder: t("search.wardrobe_short"), aria: { label: t("search.wardrobe_short") } %>
<%# tabindex -1: this submit exists only so the form posts on Enter, which
    implicit submission already does. Being focusable AND visually hidden made it
    a keyboard trap — keyboard_flow counted it both as a stop with no visible
    ring (a ring cannot be seen on a hidden element) and among 7 off-screen tab
    stops on /wardrobe. Out of the tab order, Enter still submits. %>
  <%= form.submit t("search.submit"), class: "visually-hidden", tabindex: -1 %>
<% end %>

<% if authenticated? && defined?(@items_count) %>
  <div class="sidebar-card">
    <%= tag.h3 t("wardrobe.your_wardrobe") %>
    <ul>
      <li><%= @items_count %> items</li>
      <li><%= @joy_count %> spark joy</li>
      <li><%= @never_worn_count %> never worn</li>
      <% if @utilization_rate %>
        <li><%= @utilization_rate %>% utilisation</li>
      <% end %>
    </ul>
  </div>
<% elsif @demo_items&.any? %>
  <div class="sidebar-card">
    <%= tag.h3 t("wardrobe.demo_capsule") %>
    <p><%= pluralize(@demo_items.size, "piece") %> · <%= pluralize(@demo_outfits&.size.to_i, "outfit") %></p>
    <p><%= link_to "Browse demo →", demo_wardrobe_path %></p>
  </div>
<% end %>

<div class="sidebar-card">
  <%= tag.h3 t("wardrobe.style_notes") %>
  <p><%= t("wardrobe.style_notes_body") %></p>
  <p><%= link_to "Talk to MASTER", root_path(master: 1) %></p>
</div>
