<%# Semantic status stays shared; Amber keeps its existing flash classes and undo action. %>
<% flash.each do |type, msg| %>
  <% next if type.to_s == "undo" || msg.blank? %>
  <% next if type.to_s == "notice" && flash[:undo].blank? %>
  <% state = case type.to_s
             when "alert", "error" then :error
             when "warning" then :warning
             when "success" then :success
             else :info
             end %>
  <% content = capture do %>
    <%= tag.span msg, class: "flash-msg" %>
    <% if (undo = flash[:undo]).is_a?(Hash) && undo["path"].present? %>
      <%= button_to undo["label"].presence || t("items.undo_restore"),
            undo["path"],
            method: (undo["method"].presence || :post).to_sym,
            class: "btn btn-ghost btn-sm flash-undo" %>
    <% end %>
  <% end %>
  <%= render "shared/system_signal", state:, classes: ["flash", "flash--#{type}"], content: %>
<% end %>
