<% anon = Shared::AnonymousPost.new(request: request, user: Current.user) %>
<%= form_with model: Post.new, url: posts_path, class: "amber-compose-box",
      data: {
        controller: "feed-compose character-counter",
        character_counter_countdown_value: true,
        pwa_offline: true,
        pwa_queued_text: t("pwa.queued"),
        feed_compose_target: "box",
        feed_compose_expanded_class_value: "amber-compose-box--expanded"
      } do |f| %>
  <div class="amber-compose-avatar" aria-hidden="true"><%= guest? ? "✦" : (Current.user.profile&.display_name&.first&.upcase || "A") %></div>
  <div class="amber-compose-inner">
    <%# tiptap-editor mounts over the textarea on first focus; the textarea stays
        the submitted field and the no-JS fallback. maxlength is gone from the
        markup because the field now carries HTML -- the browser would count "<p>"
        against the writer -- and Post validates the stripped text instead. %>
    <div data-controller="tiptap-editor">
      <%= f.text_area :body,
            rows: 1,
            maxlength: 500,
            placeholder: t("amber.feed.compose_prompt"), aria: { label: t("amber.feed.compose_prompt") },
            class: "amber-compose-input",
            data: {
              feed_compose_target: "input",
              tiptap_editor_target: "field",
              character_counter_target: "input",
              action: "focus->feed-compose#expand blur->feed-compose#collapse"
            } %>
      <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
      <%= render "shared/tiptap_toolbar" %>
    </div>
    <div class="amber-compose-footer" data-feed-compose-target="footer" hidden>
      <%# The 500-character budget, counted down as posts/new does. Three
          hashtag pills stood here: aria-hidden decoration that looked tappable
          and did nothing. %>
      <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
      <div class="amber-compose-submit">
        <%# The hint under the box says the post goes out anonymously, so the
            button carries no second "anon" label. %>
        <% if guest? %>
          <%= f.hidden_field :anonymous, value: true %>
        <% end %>
        <%= f.submit t("amber.feed.post_action"), class: "button button-primary amber-compose-button" %>
      </div>
    </div>
    <p class="amber-compose-hint">
      <% if guest? %>
        <%= t("amber.feed.guest_hint", limit: Shared::AnonymousPost::LIMIT, remaining: anon.remaining) %>
      <% else %>
        <%= link_to t("amber.feed.advanced_post"), new_post_path %>
      <% end %>
    </p>
  </div>
<% end %>
