<% anon = Shared::AnonymousPostService.new(request: request, user: Current.user) %>
<%= render "shared/x_compose",
      model: Post.new,
      url: posts_path,
      field: :body,
      variant: :card,
      show_tags: true,
      maxlength: 500,
      i18n_scope: "amber.feed",
      guest_remaining: anon.remaining,
      avatar_glyph: guest? ? "✦" : (Current.user.profile&.display_name&.first&.upcase || "A") %>