<footer class="amber-footer" role="contentinfo">
  <div class="amber-footer-cols">
    <%# These labels were hardcoded English in an app whose default locale is
        nb. With a language switcher below them, untranslated chrome would make
        switching look broken. %>
    <nav aria-label="<%= t("footer.wardrobe") %>">
      <%= tag.h2 t("footer.wardrobe") %>
      <%= link_to t("footer.browse"), authenticated? ? items_path : demo_wardrobe_path %>
      <%= link_to t("pages.outfits"), outfits_path if authenticated? %>
      <%= link_to t("footer.ai_styling"), ai_search_path if authenticated? %>
    </nav>
    <nav aria-label="<%= t("footer.about") %>">
      <%= tag.h2 t("footer.about") %>
      <%= link_to t("app.name"), root_path %>
      <%= link_to t("nav.sign_in"), new_session_path unless authenticated? %>
    </nav>
    <nav aria-label="<%= t("footer.support") %>">
      <%= tag.h2 t("footer.support") %>
      <%= mail_to legal_contact_email, t("footer.contact") %>
    </nav>
    <%# The only route into the English half of the locale files. Plain links,
        so it works before any JavaScript runs; the choice sticks in the
        session. %>
    <nav aria-label="<%= t("footer.language") %>" class="amber-footer-locales">
      <%= tag.h2 t("footer.language") %>
      <% available_locales.each do |locale| %>
        <%= link_to t("footer.locales.#{locale}"),
              locale_url(locale),
              class: ("is-current" if locale == current_locale),
              lang: locale,
              "aria-current": ("true" if locale == current_locale) %>
      <% end %>
    </nav>
  </div>
  <p class="amber-footer-legal">&copy; <%= Date.current.year %> <%= t("app.name") %>. <%= t("footer.tagline") %></p>
</footer>
