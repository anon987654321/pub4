<% rows = Amber::WardrobeShowcase.rows %>
<% return if rows.all? { |row| row.items.empty? } %>

<section class="amber-wardrobe-showcase" aria-label="Wardrobe by body region" data-visitor-orientation>
  <% rows.each do |row| %>
    <% next if row.items.empty? %>
    <div class="wardrobe-carousel-row<%= " wardrobe-carousel-row--reverse" if row.reverse %>">
      <div class="wardrobe-carousel-row__head">
        <h2 class="wardrobe-carousel-row__label"><%= row.label %></h2>
        <p class="wardrobe-carousel-row__hint"><%= row.hint %></p>
      </div>
      <div
        class="swiper wardrobe-swiper"
        data-controller="carousel"
        data-carousel-options-value="<%= Amber::WardrobeShowcase.carousel_options(reverse: row.reverse).to_json %>"
        aria-roledescription="carousel"
        aria-label="<%= row.label %>"
      >
        <div class="swiper-wrapper">
          <% row.items.each do |item| %>
            <div class="swiper-slide" role="group" aria-roledescription="slide">
              <%= render "shared/wardrobe_carousel_slide", item: item %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</section>