<% content_for :title, @item.title %>
<% content_for :description, meta_description_for(@item) if respond_to?(:meta_description_for) %>
<% content_for :json_ld, json_ld_for(@item, type: :product) if respond_to?(:json_ld_for) %>

<article class="item-detail item-detail--luxury">
  <div class="luxury-detail-grid">
  <% if @item.photos.attached? %>
    <div class="luxury-photos">
      <% @item.photos.each do |photo| %>
        <%= responsive_image_tag photo, alt: @item.title, preset: :detail, sizes: "(max-width: 768px) 100vw, 520px", class: "item-photo luxury-photo" %>
      <% end %>
    </div>
  <% end %>

  <div class="luxury-meta">
    <header role="banner" aria-label="Item header">
      <div>
        <p class="dim luxury-dim"><%= @item.category %><%= " · #{@item.brand}" if @item.brand.present? %></p>
        <h1 class="luxury-title"><%= @item.title %></h1>
      </div>
      <% if @item.spark_joy? %><span class="badge">Sparks joy</span><% end %>
      <% if @item.color.present? %>
        <span class="color-swatch" style="display:inline-block;width:1.25rem;height:1.25rem;border-radius:999px;background:<%= wardrobe_color_swatch(@item.color) %>;border:1px solid #ccc;vertical-align:middle" title="<%= @item.color %>" aria-label="Color <%= @item.color %>"></span>
      <% end %>
    </header>

  <div class="tag-row luxury-tags">
    <span class="tag"><%= pluralize(@item.times_worn.to_i, "wear") %></span>
    <% if @item.price? && @item.times_worn.to_i.positive? %>
      <span class="tag"><%= number_to_currency(@item.cost_per_wear || (@item.price / @item.times_worn.to_i)) %> per wear</span>
    <% end %>
    <% if @item.lifecycle_state.present? %><span class="tag"><%= @item.lifecycle_state.humanize %></span><% end %>
    <% if @item.analysis_status.present? %><span class="tag"><%= analysis_status_label(@item.analysis_status) %></span><% end %>
  </div>

  <dl class="meta luxury-meta-list">
    <dt>Category</dt><dd><%= @item.category %></dd>
    <% if @item.color.present? %><dt>Color</dt><dd><%= @item.color %></dd><% end %>
    <% if @item.size.present? %><dt>Size</dt><dd><%= @item.size %></dd><% end %>
    <% if @item.material.present? %><dt>Material</dt><dd><%= @item.material %></dd><% end %>
    <% if @item.brand.present? %><dt>Brand</dt><dd><%= @item.brand %></dd><% end %>
    <% if @item.price? %><dt>Price</dt><dd><%= number_to_currency(@item.price) %></dd><% end %>
    <dt>Worn</dt><dd><%= @item.times_worn.to_i %> times</dd>
    <% if @item.purchase_date? %><dt>Purchased</dt><dd><%= @item.purchase_date.strftime("%b %Y") %></dd><% end %>
  </dl>

  <% if @item.mood_effect.present? || @item.life_phase.present? %>
    <div class="tag-row luxury-tags">
      <% if @item.mood_effect.present? %><span class="tag">Mood: <%= @item.mood_effect %></span><% end %>
      <% if @item.life_phase.present? %><span class="tag tag--phase"><%= @item.life_phase %></span><% end %>
    </div>
  <% end %>

  <section class="luxury-section">
    <h2>Wardrobe intelligence</h2>
    <% if amber_ai_available? %>
      <p class="dim luxury-dim">OpenRouter is configured — joy analysis and mood tags use Gemini when available, with local heuristics as backup.</p>
    <% else %>
      <p class="dim luxury-dim">OpenRouter is not configured. Buttons still run <strong>local heuristics</strong> (wear history, joy flags, capsule rules). Set <code>OPENROUTER_API_KEY</code> for full LLM analysis.</p>
    <% end %>
    <div id="item_<%= @item.id %>_analysis"></div>
    <div id="item_<%= @item.id %>_tags"></div>
  </section>

  <nav role="navigation" aria-label="Item actions" class="luxury-actions">
    <%= button_to "Worn today", wear_item_path(@item), method: :post, class: "btn" %>
    <% if @item.spark_joy? %>
      <%= button_to "Doesn't spark joy", clear_joy_item_path(@item), method: :post, class: "btn" %>
    <% else %>
      <%= button_to "Sparks joy", spark_joy_item_path(@item), method: :post, class: "btn" %>
    <% end %>
    <%= button_to amber_ai_available? ? "AI analyse joy" : "Heuristic joy check", ai_analyze_item_path(@item), method: :post, class: "btn" %>
    <%= button_to amber_ai_available? ? "AI tag mood" : "Default mood tags", ai_tag_item_path(@item), method: :post, class: "btn" %>
    <%= link_to "Declutter review", review_declutter_path(@item), class: "btn" %>
    <%= link_to "Edit", edit_item_path(@item), class: "btn" %>
    <% if @item.lifecycle_state == "sentimental_archive" %>
      <%= button_to "Restore to wardrobe", restore_item_path(@item), method: :post, class: "btn" %>
    <% else %>
      <%= button_to "Archive to memory", archive_item_path(@item), method: :post, class: "btn" %>
    <% end %>
  </nav>

  <section class="luxury-section" aria-label="Affiliate link">
    <h2>Affiliate / commerce link</h2>
    <p class="dim luxury-dim">Optional resale or shop-similar URL for this piece.</p>
    <% if @item.affiliate_links.any? %>
      <ul>
        <% @item.affiliate_links.each do |link| %>
          <li>
            <%= link_to link.merchant, link.url, rel: "sponsored noopener", target: "_blank" %>
            <%= button_to "Remove", item_affiliate_link_path(@item, link), method: :delete, class: "btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with model: [@item, @affiliate_link], url: item_affiliate_links_path(@item), class: "form-wrap" do |f| %>
      <div class="field"><%= f.label :merchant %><%= f.text_field :merchant, required: true, placeholder: "e.g. Finn, Vestiaire" %></div>
      <div class="field"><%= f.label :url %><%= f.url_field :url, required: true, placeholder: "https://…" %></div>
      <div class="field"><%= f.submit "Save link", class: "btn" %></div>
    <% end %>
  </section>

  <details class="danger-zone">
    <summary>Permanent removal</summary>
    <p class="dim luxury-dim">Archiving is safer. Permanent deletion removes the item record and its attached photos.</p>
    <%= button_to "Delete permanently", @item, method: :delete, data: { turbo_confirm: "Permanently delete this item and its photos? This cannot be undone." }, class: "btn btn-danger" %>
  </details>
</div>
</article>
