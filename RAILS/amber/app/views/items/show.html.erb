<%# The one page with a lightbox loads its stylesheet; the layout loaded it,
    and an unused Swiper bundle, render-blocking on every page. %>
<% content_for :head, tag.link(rel: "stylesheet", href: "/lightgallery.css") %>
<% content_for :title, @item.title %>
<% content_for :description, meta_description_for(@item) if respond_to?(:meta_description_for) %>
<% content_for :json_ld, json_ld_for(@item, type: :product) %>

<article class="item-detail item-detail--wardrobe">
  <div class="item-detail-layout">
  <% if @item.photos.attached? %>
    <div class="item-detail-photos" data-controller="lightbox">
      <%# One photo is the garment; several are numbered, so each alt and each
          lightbox link says which one it is. %>
      <% @item.photos.each_with_index do |photo, index| %>
        <% alt, link_label = item_photo_labels(@item, index) %>
        <%= link_to url_for(photo), data: { turbo: false }, aria: { label: link_label } do %>
          <%= responsive_image_tag photo, alt:, preset: :detail, sizes: "(max-width: 768px) 100vw, 520px",
                                          class: "item-photo item-detail-photo" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="item-detail-facts">
    <header aria-label="<%= t("items.header_label") %>">
      <hgroup>
        <%= tag.p [item_category_label(@item.category), @item.brand].compact_blank.join(", ") %>
        <%= tag.h1 @item.title, class: "item-detail-title" %>
      </hgroup>
      <% if @item.spark_joy? %><span class="badge"><%= t("items.sparks_joy") %></span><% end %>
      <% if @item.color.present? %>
        <%= wardrobe_swatch_tag(@item.color, label: t("items.color_named", color: @item.color)) %>
      <% end %>
    </header>

  <%= turbo_frame_tag dom_id(@item, :stats), class: "tag-row item-detail-tags" do %>
    <span class="tag"><%= t("items.wear_count", count: @item.times_worn.to_i) %></span>
    <% if @item.price? && @item.times_worn.to_i.positive? %>
      <span class="tag"><%= t("items.per_wear", amount: number_to_currency(@item.cost_per_wear || (@item.price / @item.times_worn.to_i))) %></span>
    <% end %>
    <%= tag.span lifecycle_state_label(@item.lifecycle_state), class: "tag" if @item.lifecycle_state.present? %>
    <% if @item.analysis_status.present? %><span class="tag"><%= analysis_status_label(@item.analysis_status) %></span><% end %>
  <% end %>

  <dl class="meta item-detail-fact-list">
    <%= tag.dt t("items.category") %><%= tag.dd item_category_label(@item.category) %>
    <% if @item.color.present? %><%= tag.dt t("items.color") %><%= tag.dd @item.color %><% end %>
    <% if @item.size.present? %><%= tag.dt t("items.size") %><%= tag.dd @item.size %><% end %>
    <% if @item.material.present? %><%= tag.dt t("items.material") %><%= tag.dd @item.material %><% end %>
    <% if @item.brand.present? %><%= tag.dt t("items.brand") %><%= tag.dd @item.brand %><% end %>
    <% if @item.price? %><%= tag.dt t("items.price") %><%= tag.dd number_to_currency(@item.price) %><% end %>
    <%= tag.dt t("items.worn") %><dd id="<%= dom_id(@item, :worn) %>"><%= t("items.worn_times", count: @item.times_worn.to_i) %></dd>
    <% if @item.purchase_date? %><%= tag.dt t("items.purchased") %><dd><%= l(@item.purchase_date, format: :month) %></dd><% end %>
  </dl>

  <% if @item.mood_effect.present? || @item.life_phase.present? %>
    <div class="tag-row item-detail-tags">
      <% if @item.mood_effect.present? %>
        <%= tag.span "#{t("items.mood")} #{mood_effect_label(@item.mood_effect)}", class: "tag" %>
      <% end %>
      <%= tag.span life_phase_label(@item.life_phase), class: "tag tag--phase" if @item.life_phase.present? %>
    </div>
  <% end %>

  <section class="item-detail-section">
    <%= tag.h2 t("items.wardrobe_intelligence") %>
    <% if amber_ai_available? %>
      <p><%= t("items.openrouter_set") %></p>
    <% else %>
      <p><%= t("items.openrouter_unset_html") %></p>
    <% end %>
    <div id="item_<%= @item.id %>_analysis"></div>
    <div id="item_<%= @item.id %>_tags"></div>
  </section>

  <nav role="navigation" aria-label="<%= t("items.actions_label") %>" class="item-detail-actions"
       data-controller="haptics">
    <%= button_to t("items.worn_today"), wear_item_path(@item), method: :post, class: "button",
          data: { action: "pointerdown->haptics#press" } %>
    <% if @item.spark_joy? %>
      <%= button_to t("items.no_joy"), clear_joy_item_path(@item), method: :post, class: "button" %>
    <% else %>
      <%= button_to t("items.sparks_joy"), spark_joy_item_path(@item), method: :post, class: "button" %>
    <% end %>
    <%= link_to t("actions.edit"), edit_item_path(@item), class: "button" %>
    <%# Eight buttons in one row; the four used now and then sit one step away,
        as the wardrobe's own "More tools" do. %>
    <details class="wardrobe-more-tools">
      <summary><%= t("wardrobe.more_tools") %></summary>
      <div class="wardrobe-action-group">
        <%= button_to amber_ai_available? ? t("items.analyze_ai") : t("items.analyze_heuristic"),
                      ai_analyze_item_path(@item), method: :post, class: "button" %>
        <%= button_to amber_ai_available? ? t("items.tag_ai") : t("items.tag_heuristic"),
                      ai_tag_item_path(@item), method: :post, class: "button" %>
        <%= link_to t("items.declutter_review"), review_declutter_path(@item), class: "button" %>
        <% if @item.lifecycle_state == "sentimental_archive" %>
          <%= button_to t("items.restore"), restore_item_path(@item), method: :post, class: "button" %>
        <% else %>
          <%= button_to t("items.archive"), archive_item_path(@item), method: :post, class: "button" %>
        <% end %>
      </div>
    </details>
  </nav>

  <section class="item-detail-section" aria-label="<%= t("items.affiliate_label") %>">
    <%= tag.h2 t("items.affiliate_link") %>
    <%# Was a hardcoded English sentence that also stood in for a disclosure. The
        real disclosure is the engine partial: it names the partner programmes that
        are actually configured, and says nothing when none are. %>
    <p><%= t("items.affiliate_help") %></p>
    <%= render "shared/affiliate_disclosure" %>
    <% affiliate_route = "#{params[:controller]}##{params[:action]}" %>
    <% affiliate_click_epi = Shared::LinkConverter.request_epi(route: affiliate_route) %>
    <% if @item.affiliate_links.any? %>
      <ul>
        <% @item.affiliate_links.each do |link| %>
          <li>
            <%# data-controller here rather than on the list: one controller per
                anchor is what carries that anchor's merchant to the beacon. The
                href stays the merchant URL so the Link Converter script can still
                rewrite it — see outbound_click_controller.js. %>
            <%= link_to link.merchant, link.url, rel: "sponsored noopener", target: "_blank",
                  data: { controller: "outbound-click", action: "click->outbound-click#record",
                          outbound_click_merchant_value: link.merchant,
                          outbound_click_surface_value: "item_affiliate",
                          outbound_click_epi_value: affiliate_click_epi } %>
            <%= button_to t("actions.remove"), item_affiliate_link_path(@item, link), method: :delete,
                  class: "button-small",
                  data: { turbo_confirm: t("items.confirm_remove_affiliate_link") } %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if @shop_the_look.present? && @shop_the_look.any? %>
      <%= tag.h3 t("items.shop_the_look") %>
      <ul class="stack commerce-fit-list">
        <% @shop_the_look.each do |suggestion| %>
          <li class="commerce-fit-suggestion">
            <%= link_to "#{suggestion.merchant}: #{suggestion.title}", suggestion.url,
                  rel: "sponsored noopener", target: "_blank",
                  data: { controller: "outbound-click", action: "click->outbound-click#record",
                          outbound_click_merchant_value: suggestion.merchant,
                          outbound_click_surface_value: "shop_the_look",
                          outbound_click_epi_value: affiliate_click_epi } %>
            <span class="tag commerce-fit-source"><%= suggestion.source %></span>
            <% if suggestion.reasons.present? %>
              <span class="commerce-fit-reasons"><%= suggestion.reasons.to_sentence %></span>
            <% end %>
            <% if suggestion.commerce_key.present? %>
              <span class="tag commerce-fit-source commerce-fit-local"><%= t("commerce_fit.local") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with model: [@item, @affiliate_link], url: item_affiliate_links_path(@item), class: "form-wrap" do |f| %>
      <div class="field"><%= f.label :merchant %><%= f.text_field :merchant, required: true, placeholder: t("items.merchant_placeholder") %></div>
      <div class="field"><%= f.label :url %><%= f.url_field :url, required: true, placeholder: t("items.url_placeholder"), inputmode: "url" %></div>
      <div class="field"><%= f.submit t("items.save_link"), class: "button" %></div>
    <% end %>
  </section>

  <details class="danger-zone">
    <summary><%= t("items.permanent_removal") %></summary>
    <p><%= t("items.archiving_safer") %></p>
    <%= button_to t("items.delete_permanent"), @item, method: :delete, data: { turbo_confirm: t("items.confirm_delete") }, class: "button button-danger" %>
  </details>
  </div>
</div>
</article>
