<% content_for :title, t("pages.shopping_list") %>

<h1><%= t("pages.shopping_list") %></h1>

<% if @gaps.any? %>
  <ul>
    <% @gaps.each do |gap| %>
      <li>
        <strong><%= gap[:category] || gap[:name] %></strong>
        <p><%= gap[:reason] %></p>
        <% if gap[:missing] %><span class="tag">missing <%= gap[:missing] %></span><% end %>
        <% if gap[:owned] %><span class="tag">owned <%= gap[:owned] %> / <%= gap[:target] %></span><% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_gaps"),
        body: t("wardrobe.gaps_complete"),
        action: { label: t("actions.back_to_wardrobe"), path: items_path } %>
<% end %>

<h2><%= t("wardrobe.master_recs") %></h2>
<% if @recommendations.any? %>
  <ul>
    <% @recommendations.each do |rec| %>
      <li>
        <%= rec.reason %>
        <span class="tag">score <%= rec.score %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_recommendations"),
        body: t("wardrobe.recs_grow"),
        action: { label: t("pages.add_item"), path: new_item_path } %>
<% end %>

<%= link_to t("actions.back_to_wardrobe"), items_path, class: "btn" %>
