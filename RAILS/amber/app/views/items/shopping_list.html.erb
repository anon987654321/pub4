<% content_for :title, "Shopping list" %>

<h1>Shopping list — gaps to fill</h1>

<% if @gaps.any? %>
  <ul>
    <% @gaps.each do |gap| %>
      <li>
        <strong><%= gap[:category] || gap[:name] %></strong>
        <p><%= gap[:reason] %></p>
        <% if gap[:missing] %><span class="tag">missing <%= gap[:missing] %></span><% end %>
        <% if gap[:owned] %><span class="tag">owned <%= gap[:owned] %> / <%= gap[:target] %></span><% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_gaps"),
        body: "Your wardrobe looks complete for essentials.",
        action: { label: "Back to wardrobe", path: items_path } %>
<% end %>

<h2>MASTER purchase recommendations</h2>
<% if @recommendations.any? %>
  <ul>
    <% @recommendations.each do |rec| %>
      <li>
        <%= rec.reason %>
        <span class="tag">score <%= rec.score %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_recommendations"),
        body: "Add more items or re-run gap analysis when your closet grows.",
        action: { label: "Add item", path: new_item_path } %>
<% end %>

<%= link_to "Back to wardrobe", items_path, class: "btn" %>
