<article class="item-card item-card--luxury" id="<%= dom_id(item) %>" data-id="<%= item.id %>" data-category="<%= item.category %>" data-controller="offline-feed luxury-product" data-offline-feed-key-value="amber-items" data-offline-feed-title-value="<%= item.title %>" data-offline-feed-url-value="<%= item_path(item) %>" data-offline-feed-meta-value="<%= [item.category, item.color, item.brand].compact.join(" · ") %>">
  <div class="item-photo-wrap">
    <% if item.photos.attached? %>
      <%= responsive_image_tag item.photos.first, alt: item.title, preset: :card, sizes: "(max-width: 768px) 50vw, 280px", class: "item-photo" %>
    <% end %>
    <nav role="navigation" aria-label="<%= t("items.actions_label") %>">
      <%= button_to t("items.wear"), wear_item_path(item), method: :post, class: "button-small" %>
      <% if item.spark_joy? %>
        <%= button_to t("items.no_joy_short"), clear_joy_item_path(item), method: :post, class: "button-small" %>
      <% else %>
        <%= button_to t("items.joy_short"), spark_joy_item_path(item), method: :post, class: "button-small" %>
      <% end %>
      <%= link_to t("actions.edit"), edit_item_path(item), class: "button-small" %>
    </nav>
  </div>
  <%= link_to item.title, item, class: "item-title" %>
  <%# The card's facts are separate words in .item-meta, spaced by the
      stylesheet; a middle dot between them was punctuation standing in for layout. %>
  <p class="item-meta">
    <%= tag.span item.category %>
    <%= tag.span item.color if item.color.present? %>
  </p>
</article>
