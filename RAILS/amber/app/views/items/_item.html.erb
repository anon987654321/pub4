<article class="item-card item-card--wardrobe" id="<%= dom_id(item) %>" data-id="<%= item.id %>" data-category="<%= item.category %>" data-controller="offline-feed luxury-product" data-offline-feed-key-value="amber-items" data-offline-feed-title-value="<%= item.title %>" data-offline-feed-url-value="<%= item_path(item) %>" data-offline-feed-meta-value="<%= [item.category, item.color, item.brand].compact.join(" · ") %>">
  <div class="item-photo-wrap">
    <% if item.photos.attached? %>
      <%= responsive_image_tag item.photos.first, alt: item.title, preset: :card, sizes: "(max-width: 768px) 50vw, 280px", class: "item-photo" %>
    <% else %>
      <%# The category's initial, as the demo and outfit cards draw it; the wrap was empty. %>
      <%= tag.div item.category.to_s.first, class: "item-photo item-photo--placeholder", aria: { hidden: true } %>
    <% end %>
    <nav role="navigation" class="item-card-actions" aria-label="<%= t("items.actions_label") %>">
      <%= button_to t("items.wear"), wear_item_path(item), method: :post %>
      <% if item.spark_joy? %>
        <%= button_to t("items.no_joy_short"), clear_joy_item_path(item), method: :post %>
      <% else %>
        <%= button_to t("items.joy_short"), spark_joy_item_path(item), method: :post %>
      <% end %>
      <%= link_to t("actions.edit"), edit_item_path(item) %>
      <%# The declutter page's Review sat beside each card as a grid cell of its own. %>
      <%= link_to t("actions.review"), review_declutter_path(item) if local_assigns[:review] %>
    </nav>
  </div>
  <%= link_to item.title, item, class: "item-title" %>
  <%# The card's facts are separate words in .item-meta, spaced by the
      stylesheet; a middle dot between them was punctuation standing in for layout. %>
  <p class="item-meta">
    <%= tag.span item_category_label(item.category) %>
    <%= tag.span item.color if item.color.present? %>
  </p>
</article>
