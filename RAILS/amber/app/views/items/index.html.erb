<% content_for :title, t("pages.wardrobe") %>
<%= turbo_stream_from "items" %>

<section data-controller="filter" role="region" aria-label="Wardrobe items">
  <header role="banner" aria-label="Wardrobe header">
    <div>
      <p class="dim">Closet intelligence</p>
      <h1><%= t("pages.wardrobe") %> (<%= @pagy.count %>)</h1>
    </div>
    <div class="wardrobe-action-groups">
      <nav role="navigation" aria-label="Primary wardrobe actions" class="wardrobe-action-group">
        <%= link_to t("home.add_item"), new_item_path, class: "btn btn--primary" %>
        <%= link_to "Compose an outfit", new_outfit_path, class: "btn" %>
      </nav>
      <details class="wardrobe-more-tools">
        <summary>More tools</summary>
        <nav role="navigation" aria-label="Use what I own" class="wardrobe-action-group">
          <h2>Use what I own</h2>
          <%= link_to "AI pair from my wardrobe", ai_suggest_outfits_path, class: "btn" %>
          <%= link_to "Packing list", ai_packing_list_path, class: "btn" %>
          <%= link_to "Declutter thoughtfully", declutter_index_path, class: "btn" %>
        </nav>
        <nav role="navigation" aria-label="Wardrobe records and shopping" class="wardrobe-action-group wardrobe-action-group--secondary">
          <h2>Records &amp; genuine gaps</h2>
          <%= link_to "Wear analytics", analytics_wardrobe_items_path, class: "btn" %>
          <%= link_to "Color palette", ai_palette_path, class: "btn" %>
          <%= link_to "Shop only for a gap", shopping_list_items_path, class: "btn" %>
          <%= button_to "Archive out-of-season", archive_seasonal_items_path, method: :post, class: "btn" %>
          <%= button_to "Resurface this season", resurface_seasonal_items_path, method: :post, class: "btn" %>
        </nav>
      </details>
    </div>
  </header>

  <div class="chips" aria-label="Wardrobe analytics summary">
    <span class="chip"><%= @analytics[:active_items] %> active</span>
    <span class="chip"><%= @analytics[:never_worn] %> never worn</span>
    <span class="chip"><%= @analytics[:underused] %> underused</span>
    <span class="chip"><%= @analytics[:declutter_box] %> box</span>
    <span class="chip"><%= @analytics[:sentimental_archive] %> memory</span>
    <% if @analytics[:cost_per_wear] %><span class="chip"><%= number_to_currency(@analytics[:cost_per_wear]) %> avg/wear</span><% end %>
  </div>

  <nav class="chips" aria-label="Lifecycle filter">
    <% [
      ["active", "Active"],
      ["box", "Declutter box"],
      ["memory", "Memory archive"],
      ["seasonal", "Seasonal"],
      ["repair", "Repair"],
      ["all", "All"]
    ].each do |key, label| %>
      <%= link_to label, items_path(lifecycle: key), class: "chip#{" chip--active" if @lifecycle_filter == key}" %>
    <% end %>
  </nav>

  <%= live_search_index url: items_path(lifecycle: @lifecycle_filter), results_partial: "items/live_search_results", placeholder: t("search.wardrobe"), label: t("search.wardrobe_label") %>
</section>
