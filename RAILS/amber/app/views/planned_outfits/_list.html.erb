<%= turbo_frame_tag "planned-outfits" do %>
<div class="plan-list">
  <% @planned.each do |plan| %>
    <div class="plan-row" id="<%= dom_id(plan) %>">
      <span class="plan-date"><%= l(plan.planned_date, format: :long) %></span>
      <%= link_to plan.outfit.name, plan.outfit %>
      <% if plan.notes.present? %><span class="dim"><%= plan.notes %></span><% end %>
      <%= button_to t("actions.remove"), planned_outfit_path(plan), method: :delete, class: "btn-link", data: { turbo_frame: "planned-outfits" } %>
    </div>
  <% end %>
  <% if @planned.empty? %>
    <%= render "shared/empty_state",
          title: t("empty.no_planned"),
          body: t("empty.planned_body"),
          action: { label: t("planned.browse_outfits"), path: outfits_path } %>
  <% end %>
</div>
<% end %>
