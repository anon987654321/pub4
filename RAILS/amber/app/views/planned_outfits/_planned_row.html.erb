<%# One planned wear. Extracted from planned_outfits/_list for the reflex. %>
<li>
  <div class="plan-row" id="<%= dom_id(planned_outfit) %>">
    <span class="plan-date"><%= l(planned_outfit.planned_date, format: :long) %></span>
    <%= link_to planned_outfit.outfit.name, planned_outfit.outfit %>
    <% if planned_outfit.notes.present? %><%= planned_outfit.notes %><% end %>
    <%# destructive: no-confirm-ok — reversible — this drops the outfit from the plan, not the outfit %>
    <%= button_to t("actions.remove"), planned_outfit_path(planned_outfit), method: :delete, class: "btn-link", data: { turbo_frame: "planned-outfits" } %>
  </div>
</li>
