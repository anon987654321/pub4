<article class="item-card item-card--demo" id="<%= dom_id(item) %>">
  <% if item.photos.attached? %>
    <%= responsive_image_tag item.photos.first, alt: item.title, preset: :card, sizes: "(max-width: 768px) 50vw, 240px", class: "item-photo" %>
  <% else %>
    <div class="item-photo item-photo--placeholder" aria-hidden="true"><%= item.category.first %></div>
  <% end %>
  <%= link_to item.title, demo_wardrobe_item_path(item), class: "item-title" %>
  <%# The card's facts are separate words in .item-meta, spaced by the
      stylesheet; a middle dot between them was punctuation standing in for layout. %>
  <p class="item-meta">
    <%= tag.span item.category %>
    <%= tag.span item.color if item.color.present? %>
  </p>
  <p class="item-meta">
    <%= tag.span item.brand if item.brand.present? %>
    <%= tag.span t("items.worn_times_short", count: item.times_worn.to_i) %>
    <%= tag.span cost_per_wear_label(item) if cost_per_wear_label(item).present? %>
  </p>
</article>
