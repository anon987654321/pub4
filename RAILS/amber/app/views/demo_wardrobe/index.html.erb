<% content_for :title, t("demo.wardrobe") %>
<%# The demo wardrobe is amber's one public catalogue. Structured data stopped
    at items#show, which is behind authentication and therefore invisible to a
    crawler — this page is the one that was worth describing. %>
<% content_for :json_ld, json_ld_script(demo_item_list_schema(@items, title: t("demo.wardrobe"))) %>

<header role="banner" aria-label="<%= t("demo.wardrobe_header") %>">
  <p class="dim"><%= t("demo.capsule_kicker", name: Amber::DemoWardrobe::DEMO_DISPLAY_NAME) %></p>
  <%= tag.h1 t("demo.wardrobe") %>
  <p class="tagline"><%= t("demo.index_tagline") %></p>
  <nav role="navigation" aria-label="<%= t("demo.wardrobe_actions") %>">
    <%= link_to t("auth.create_account"), new_registration_path, class: "btn btn--primary" %>
    <%= link_to t("nav.sign_in"), new_session_path, class: "btn btn--ghost" %>
  </nav>
</header>

<% if @outfits.any? %>
  <%= turbo_frame_tag "demo-outfits" do %>
    <section>
      <h2>Outfits</h2>
      <div class="plan-list">
        <% @outfits.each do |outfit| %>
          <div class="plan-row">
            <%= tag.strong outfit.name %>
            <span class="dim"><%= outfit.context_label %> · <%= pluralize(outfit.items.size, "piece") %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<section>
  <%= tag.h2 t("demo.all_pieces") %>
  <div class="item-grid">
    <%= render partial: "demo_wardrobe/item", collection: @items %>
  </div>
  <% if @pagy.next %>
    <p><%= link_to "Next page", demo_wardrobe_path(page: @pagy.next), class: "btn btn--ghost" %></p>
  <% end %>
</section>
