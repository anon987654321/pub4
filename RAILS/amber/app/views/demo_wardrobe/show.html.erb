<% content_for :title, @item.title %>

<article class="item-detail">
  <p class="dim"><%= link_to "← Demo wardrobe", demo_wardrobe_path %></p>
  <% if @item.photos.attached? %>
    <%= responsive_image_tag @item.photos.first, alt: @item.title, preset: :detail, sizes: "(max-width: 768px) 100vw, 600px", class: "item-photo item-photo--detail" %>
  <% end %>
  <h1><%= @item.title %></h1>
  <p class="dim"><%= [@item.brand, @item.category, @item.color, @item.size].compact.join(" · ") %></p>
  <p>Worn <%= @item.times_worn.to_i %>× · <%= @item.value_label %></p>
  <% if @item.spark_joy? %>
    <p class="chip">Spark joy</p>
  <% end %>
  <p class="hint">Create an account to track wears, declutter scores, and outfit suggestions on your own wardrobe.</p>
  <p class="actions">
    <%= link_to t("auth.create_account"), new_registration_path, class: "btn btn--primary" %>
    <%= link_to t("nav.sign_in"), new_session_path, class: "btn btn--ghost" %>
  </p>
</article>
