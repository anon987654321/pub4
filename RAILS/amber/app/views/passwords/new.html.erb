<div class="auth-form">
  <h1>Reset password</h1>
  <p class="auth-form-lead">We will email a link to set a new password.</p>
  <%= form_with url: passwords_path do |f| %>
    <div class="field">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, autofocus: true, autocomplete: "email" %>
    </div>
    <div class="actions">
      <%= f.submit "Send reset link", class: "btn btn--primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to "Back to sign in", new_session_path %>
    </p>
  <% end %>
</div>
