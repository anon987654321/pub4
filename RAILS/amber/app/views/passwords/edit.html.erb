<div class="auth-form">
  <%= tag.h1 t("auth.update_password") %>
  <p class="auth-form-lead"><%= t("auth.update_password_lead") %></p>
  <%= form_with model: @user, url: password_path(params[:token]), method: :put do |f| %>
    <div class="field">
      <%= f.label :password, t("auth.new_password") %>
      <%= password_visibility_field f, :password, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, t("auth.confirm_password") %>
      <%= password_visibility_field f, :password_confirmation, autocomplete: "new-password" %>
    </div>
    <div class="actions">
      <%= f.submit t("auth.save_password"), class: "btn btn--primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.back_to_sign_in"), new_session_path %>
    </p>
  <% end %>
</div>
