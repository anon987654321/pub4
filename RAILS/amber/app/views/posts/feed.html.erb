<div class="page-header">
  <%= tag.h1 t("pages.feed") %>
  <%= link_to t("actions.new_post"), new_post_path, class: "btn" %>
</div>
<%= turbo_frame_tag "amber-feed" do %>
<%= render @posts %>
<%= render "shared/newsletter_cta",
      heading: t("newsletter.style_notes"),
      blurb: t("newsletter.style_blurb"),
      button_label: t("newsletter.get_letter") %>
<%= render "shared/pager", pagy: @pagy %>
<% end %>
