<div class="page-header">
  <h1><%= t("pages.feed") %></h1>
  <%= link_to t("nav.new_post"), new_post_path, class: "btn" %>
</div>
<%= turbo_frame_tag "amber-feed" do %>
<%= render @posts %>
<%= render "shared/newsletter_cta",
      heading: "Style notes",
      blurb: "Weekly wardrobe essays, outfit ideas, and capsule tips. No spam.",
      button_label: "Get the letter" %>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
<% end %>
