<%= turbo_stream_from "posts" %>
<%= turbo_frame_tag "amber-posts" do %>
<%= tag.h1 t("pages.community") %>
<% if @posts.any? %>
  <div id="amber-posts-list"><%= render @posts %></div>
  <%= render "shared/infinite_scroll_sentinel",
             pagy: @pagy,
             reflex: "PostsInfiniteScrollReflex#load_more",
             sentinel_id: "amber-posts-sentinel" %>
  <%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
      ActionCable, so without JavaScript a truncated list would say nothing about
      the rest of itself. noscript, so a reader with JavaScript sees one
      mechanism rather than two. %>
  <noscript><%= render "shared/pager", pagy: @pagy %></noscript>

<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_posts_yet"),
        body: t("empty.guest_post"),
        action: { label: t("empty.first_post"), path: new_post_path } %>
<% end %>
<% end %>
