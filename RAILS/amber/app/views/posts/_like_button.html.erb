<%= button_to like_post_path(post),
              method: :post,
              class: "feed-action",
              form_class: "feed-action-form",
              form: { id: dom_id(post, :like) },
              aria: { label: t("post.like_count", count: post.likes_count), pressed: false },
              title: t("post.like", default: "Like") do %>
  <%= render "shared/feed_icon", name: "like" %>
  <span class="feed-action-count"><%= post.likes_count.to_i.positive? ? post.likes_count : "" %></span>
<% end %>
