<% content_for :title, t("post.share_look") %>
<%= tag.h1 t("post.share_look") %>
<%= form_with model: @post do |f| %>
  <%= render "shared/errors", object: @post %>
  <div class="field">
    <%= f.label :body, t("post.body_label") %>
    <div class="compose-surface" data-controller="tiptap-editor character-counter link-preview"
         data-character-counter-countdown-value="true">
      <%= f.text_area :body, rows: 3,
            placeholder: t("post.body_placeholder"),
            data: { character_counter_target: "input", tiptap_editor_target: "field",
                    action: "input->link-preview#scan" } %>
      <%= tag.output data: { link_preview_target: "preview" },
                     aria: { live: "polite", label: t("link_preview.label") } %>
      <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
      <%= render "shared/tiptap_toolbar" %>
      <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
    </div>
  </div>
  <div class="field">
    <%= f.label :outfit_id, t("post.tag_outfit") %>
    <%= f.select :outfit_id, Current.user.outfits.map { |o| [o.name, o.id] }, { include_blank: "—" } %>
  </div>
  <div class="field">
    <%= f.label :item_id, t("post.tag_item") %>
    <%= f.select :item_id, Current.user.items.map { |i| [i.title, i.id] }, { include_blank: "—" } %>
  </div>
  <div class="actions"><%= f.submit t("post.submit"), class: "button button-primary" %></div>
<% end %>
