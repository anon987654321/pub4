<%# posts#show is public. The shared Article schema builds its URL from
    url_for(@post), which is already the public path, so it needs no override. %>
<% content_for :title, strip_tags(@post.body.to_s).squish.truncate(80, separator: " ") %>
<% content_for :description, strip_tags(@post.body.to_s).squish.truncate(160, separator: " ") %>
<% content_for :json_ld, json_ld_for(@post, type: :article) %>
<%= turbo_stream_from @post %>
<article id="<%= dom_id(@post) %>" class="post-reading-card post-show-reading">
  <div class="post-reading-layout">
    <%= render "shared/post_vote_rail", post: @post, vote_path: post_vote_path(@post), vote_score: @post.score %>
    <div class="post-reading-main">
  <header class="feed-post-meta feed-post-byline">
    <span class="author"><%= @post.author_name %></span>
    <%# time_ago, not time_ago_in_words: Norwegian marks a past span on both
        sides ("for 2 måneder siden"), so the suffix cannot be appended. The
        timeago Stimulus controller that used to hang off this tag is gone —
        it read data-timeago-datetime-value, which no view ever set. %>
    <%= tag.time time_ago(@post.created_at),
                 datetime: @post.created_at.iso8601,
                 title: l(@post.created_at, format: :long) %>
  </header>
  <%# Stripped first: truncating the raw field would cut inside a tag and put
      half an element in the page title. Hidden from sight: the body below
      opens with the same words, and printed it read twice. %>
  <%= tag.h1 strip_tags(@post.body.to_s).truncate(80, separator: " "), class: "visually-hidden" %>
  <div class="feed-post-body feed-post-prose prose"><%= rich_text @post.body %></div>
  <% if (embed = @post.link_embed_record) %>
    <%= render "shared/link_embed", embed: embed %>
  <% end %>
  <% if @post.outfit %><p><em><%= t("post.outfit_label") %>: <%= link_to @post.outfit.name, outfit_path(@post.outfit) %></em></p><% end %>
  <% if @post.item %><p><em><%= t("post.item_label") %>: <%= link_to @post.item.title, item_path(@post.item) %></em></p><% end %>
  <footer class="post-show-actions feed-card-actions">
    <%= link_to post_path(@post, anchor: "comments"), class: "feed-action",
          aria: { label: t("post.comment_aria", count: @post.comment_count) } do %>
      <%= render "shared/feed_icon", name: "comment" %>
      <span class="feed-action-count"><%= @post.comment_count.to_i.positive? ? @post.comment_count : "" %></span>
    <% end %>
    <%= render "posts/like_button", post: @post %>
    <%= render "shared/post_embed_action", post: @post, url: post_url(@post) %>
    <% if @post.user == Current.user %>
      <%# The same action button the feed card draws, not a second style. %>
      <%= button_to t("actions.delete"), post_path(@post), method: :delete,
            class: "feed-action", form_class: "feed-action-form",
            data: { turbo_confirm: t("actions.confirm_delete") } %>
    <% end %>
  </footer>
    </div>
  </div>
</article>

<section id="comments" class="post-show-comments" aria-label="<%= t("comments.title") %>">
  <%= tag.h2 t("post.comments_heading", count: @post.comment_count.to_i) %>
  <div id="<%= dom_id(@post, "comments") %>">
    <%= render partial: "comments/comment", collection: @comments, as: :comment %>
  </div>
  <% if authenticated? %>
    <%= render "comments/form", comment: @comment, commentable: @post %>
  <% else %>
    <%= render "shared/post_auth_prompt", post: @post %>
  <% end %>
</section>

<nav class="post-show-back" aria-label="<%= t("comments.back") %>">
  <%= link_to t("comments.back"), posts_path %>
</nav>
