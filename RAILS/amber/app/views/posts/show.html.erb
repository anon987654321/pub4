<%= turbo_stream_from @post %>
<article class="post">
  <header class="post-meta byline">
    <span class="author"><%= @post.user.email_address.split("@").first %></span>
    · <time datetime="<%= @post.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(@post.created_at) %> ago</time>
  </header>
  <h1 class="post-title"><%= @post.body.truncate(80, separator: " ") %></h1>
  <div class="post-body prose"><%= @post.body %></div>
  <% if @post.outfit %><p class="dim"><em>Outfit: <%= link_to @post.outfit.name, outfit_path(@post.outfit) %></em></p><% end %>
  <% if @post.item %><p class="dim"><em>Item: <%= link_to @post.item.title, item_path(@post.item) %></em></p><% end %>
  <footer>
    <%= button_to "♥ #{@post.likes_count}", like_post_path(@post), method: :post %>
    <% if @post.user == Current.user %>
      <%= button_to "Delete", post_path(@post), method: :delete, data: { turbo_confirm: "Delete?" } %>
    <% end %>
  </footer>
</article>

<section id="comments" aria-label="Comments">
  <h2>Comments (<%= @post.comment_count %>)</h2>
  <div id="<%= dom_id(@post, "comments") %>">
    <%= render partial: "comments/comment", collection: @comments, as: :comment %>
  </div>
  <% if authenticated? %>
    <%= render "comments/form", comment: @comment, post: @post %>
  <% end %>
</section>

<%= link_to "Back", posts_path %>
