<%# I18n.locale is in the key because the fragment holds translated chrome and
    Rails does not add the locale to fragment cache keys itself — without it,
    switching language served whichever language rendered the post first. %>
<% cache [post, Current.user&.id, post.anonymous?, I18n.locale] do %>
  <% post_actions = capture do %>
    <% unless guest? %>
      <%= button_to t("post.like_count", count: post.likes_count), like_post_path(post), method: :post %>
    <% end %>
    <% if post.user == Current.user && !guest? %>
      <%= button_to t("actions.delete"), post_path(post), method: :delete, data: { turbo_confirm: t("actions.confirm_delete") } %>
    <% end %>
  <% end %>

  <% post_meta = capture do %>
    <% if post.outfit %>
      <em><%= t("post.outfit_label") %>: <%= link_to post.outfit.name, outfit_path(post.outfit) %></em>
    <% end %>
    <% if post.item %>
      <em><%= t("post.item_label") %>: <%= link_to post.item.title, item_path(post.item) %></em>
    <% end %>
  <% end %>

  <%= render "shared/post_card",
        post: post,
        variant: :prose,
        name: post.author_name,
        url: (post.anonymous? || post.user&.guest? ? nil : user_path(post.user)),
        content: post.body,
        title: nil,
        meta: post_meta.presence,
        actions: post_actions,
        frame: false %>
<% end %>
