<% cache [post, Current.user&.id, post.anonymous?] do %>
  <article class="feed-post" role="article" aria-label="Post by <%= post.author_name %>">
    <header class="post-meta byline" role="banner" aria-label="Post header">
      <span class="author">
        <% if post.anonymous? || post.user&.guest? %>
          <%= post.author_name %>
        <% else %>
          <%= link_to post.author_name, user_path(post.user) %>
        <% end %>
      </span>
      · <time datetime="<%= post.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(post.created_at) %> ago</time>
    </header>
    <div class="post-body prose"><%= post.body %></div>
    <% if post.outfit %><p><em>Outfit: <%= link_to post.outfit.name, outfit_path(post.outfit) %></em></p><% end %>
    <% if post.item %><p><em>Item: <%= link_to post.item.title, item_path(post.item) %></em></p><% end %>
    <footer>
      <% unless guest? %>
        <%= button_to "♥ #{post.likes_count}", like_post_path(post), method: :post %>
      <% end %>
      <% if post.user == Current.user && !guest? %>
        <%= button_to "Delete", post_path(post), method: :delete, data: { turbo_confirm: "Delete?" } %>
      <% end %>
    </footer>
  </article>
<% end %>