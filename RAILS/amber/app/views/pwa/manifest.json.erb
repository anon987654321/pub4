{
  "name": "Amber",
  "short_name": "Amber",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/icon-mono-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "monochrome"
    },
    {
      "src": "/icon-mono-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "monochrome"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "Social fashion. Share outfits, keep a wardrobe, and dress with people you follow.",
  "theme_color": "#FFB999",
  "background_color": "#FFFFFF",
  "shortcuts": [
    {
      "name": <%= raw t("pwa.add_item").to_json %>,
      "short_name": <%= raw t("pwa.item").to_json %>,
      "url": "/items/new"
    },
    {
      "name": <%= raw t("pwa.create_outfit").to_json %>,
      "short_name": <%= raw t("pwa.outfit").to_json %>,
      "url": "/outfits/new"
    }
  ],
  "lang": <%= raw I18n.locale.to_s.to_json %>,
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/items/new",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".heic", ".heif"]
      }
    }
  ]
}
