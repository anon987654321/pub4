<aside class="ai-card">
  <% if result["sparks_joy"].nil? %>
    <p><%= t("ai.analysis_unavailable") %></p>
  <% else %>
    <%= tag.strong result["sparks_joy"] ? "Sparks joy" : "Does not spark joy" %>
    <%= tag.p result["reason"] %>
    <p><%= tag.em result["suggestion"] %></p>
    <% if result["source"] %>
      <p><%= t("ai.source", source: result["source"] == "heuristic" ? t("ai.heuristic_source") : result["source"]) %></p>
    <% end %>
  <% end %>
</aside>
