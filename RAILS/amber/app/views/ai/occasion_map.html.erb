<% content_for :title, t("pages.occasion_map") %>
<%= tag.h1 t("pages.occasion_map") %>
<div class="occasion-grid">
  <% @coverage.each do |occasion, items| %>
    <div class="occasion-card occasion-card--<%= items.size < 2 ? 'sparse' : 'covered' %>">
      <%= tag.h2 occasion.capitalize %>
      <span class="occasion-count"><%= items.size %> items</span>
      <% if items.size < 2 %>
        <p class="occasion-warn">Gap — consider adding pieces</p>
      <% end %>
      <% items.first(3).each do |item| %>
        <div><%= link_to item.title, item %></div> <%# scan: intentional — an anonymous text block; the flex row is the layout and a name here would have no reader %>
      <% end %>
    </div>
  <% end %>
</div>
<p><%= link_to "← Dashboard", root_path %></p>
