<% content_for :title, t("pages.packing_list") %>

<%= tag.h1 t("pages.packing_list") %>
<p><%= t("ai.packing_lead") %></p>

<%= form_with url: ai_packing_list_path, method: :get, class: "form" do |f| %>
  <%# f.label, not a bare <label>. These were <label>text</label> sitting beside
      the field rather than wrapping it or carrying for=, so they named nothing:
      a screen reader read the select as unlabelled and clicking the text did
      not focus it. Same copy, same markup order, now actually associated. %>
  <div class="field">
    <%= f.label :duration, t("ai.duration") %>
    <%= f.select :duration, (1..14).map { |d| [d, d] }, { selected: params[:duration] } %>
  </div>
  <div class="field">
    <%= f.label :climate, t("ai.climate") %>
    <%= f.select :climate, ["hot", "cold", "mild", "rainy", "dry"], { selected: params[:climate] } %>
  </div>
  <div class="actions"><%= f.submit t("ai.generate_master"), class: "btn btn--primary" %></div>
<% end %>

<% if @result %>
  <%= tag.h2 t("ai.suggested_outfits", days: @duration, climate: @climate) %>
  <% if @result["outfits"] %>
    <ul>
      <% @result["outfits"].each do |o| %>
        <li>
          <%= tag.strong o["name"] %>
          <ul><% Array(o["items"]).each do |it| %><li><%= it %></li><% end %></ul>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if @result["tips"] %><p><%= @result["tips"] %></p><% end %>
  <%= tag.p t("ai.packing_created") %>
<% end %>

<%= link_to t("actions.back_to_ai"), ai_suggest_outfits_path %>
