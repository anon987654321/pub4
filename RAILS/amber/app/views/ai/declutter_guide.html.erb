<% content_for :title, t("pages.declutter_guide") %>
<h1><%= t("pages.declutter_guide") %></h1>
<p><%= link_to t("ai.declutter_dashboard"), declutter_index_path, class: "btn" %></p>
<% if @candidates.any? %>
  <p class="dim"><%= t("ai.letting_go") %></p>
  <div class="item-grid"><%= render @candidates %></div>
<% else %>
  <p><%= t("ai.no_candidates") %></p>
<% end %>
<p><%= link_to t("actions.back"), items_path %></p>
