<% content_for :title, t("pages.colour_palette") %>
<%= tag.h1 t("pages.colour_palette_title") %>
<% if @result["source"] %><p class="dim">Source: <%= @result["source"] %></p><% end %>

<% if @swatches.present? %>
  <section aria-label="<%= t("ai.palette_aria") %>">
    <%= tag.h2 t("ai.swatches_from_items", default: "Swatches from your items") %>
    <div class="tag-row color-swatch-row">
      <% @swatches.each do |title, color| %>
        <span class="chip" title="<%= title %>">
          <span class="color-swatch color-swatch--sm" style="--swatch: <%= wardrobe_color_swatch(color) %>"></span>
          <%= color %>
        </span>
      <% end %>
    </div>
  </section>
<% end %>

<% if @result["palette"] %>
  <div class="ai-card">
    <p><strong>Palette:</strong> <%= @result["palette"] %></p>
    <% if @result["season_type"].present? %><p><strong>Seasonal type:</strong> <%= @result["season_type"] %></p><% end %>
  </div>
  <% if @result["clashing"]&.any? %>
    <%= tag.h2 t("ai.clashing_items") %>
    <ul><% @result["clashing"].each do |i| %><li><%= i %></li><% end %></ul>
  <% end %>
  <% if @result["suggestions"]&.any? %>
    <h2>Suggestions</h2>
    <ul><% @result["suggestions"].each do |s| %><li><%= s %></li><% end %></ul>
  <% end %>
<% else %>
  <p class="dim"><%= t("ai.not_enough_items") %></p>
<% end %>
<p><%= link_to t("ai.dashboard_back"), root_path %></p>
