<% content_for :title, t("pages.suggest_outfits") %>
<header role="banner" aria-label="<%= t("ai.suggest_header") %>">
  <%= tag.h1 t("pages.suggest_outfits") %>
  <% if @ai_available %>
    <p><%= t("ai.suggest_lead", vision: (Current.user.items.joins(:photos_attachments).exists? ? t("ai.suggest_vision") : "")) %></p>
  <% else %>
    <p><%= t("ai.suggest_local_html") %></p>
  <% end %>
  <% if @master_photo %>
    <p><%= t("ai.master_photo_html") %></p>
  <% end %>
</header>

<turbo-frame aria-live="polite" id="amber-ai-suggest" data-turbo-action="replace">
<%= form_with url: ai_suggest_outfits_path, method: :get, class: "form", html: { role: "form", "aria-label": t("ai.generate_form") } do |f| %>
  <%# f.label rather than a bare <label> beside the field — see packing_list. %>
  <div class="field">
    <%= f.label :occasion, t("ai.occasion") %>
    <%= f.text_field :occasion, value: params[:occasion], placeholder: t("ai_forms.occasion_example") %>
  </div>
  <div class="field">
    <%= f.label :season, t("ai.season") %>
    <%= f.select :season, Item::SEASONS, { selected: params[:season] }, { include_blank: t("ai.any_season") } %>
  </div>
  <div class="actions">
    <%= f.submit @ai_available ? t("ai.generate_suggestions") : t("ai.generate_rules"), class: "btn btn-primary" %>
    <%= button_to t("ai_forms.generate_save"), ai_generate_outfit_path, method: :post, params: { occasion: params[:occasion], season: params[:season] }, class: "btn" %>
  </div>
<% end %>

<% if @suggestions.present? %>
  <% @suggestions.each_with_index do |s, i| %>
    <article class="ai-card">
      <%= tag.h2 s["name"] || "Option #{i + 1}" %>
      <p><%= Array(s["items"]).join(", ") %></p>
      <%# The rationale was rendered bare, so a reader couldn't tell it *was* the
          reasoning rather than a product blurb. Labelling it is the point of the
          suggestion: you should be able to judge the advice, not just take it. %>
      <% if s["description"].present? %>
        <p><%= tag.strong t("ai.why_it_works") %> <%= s["description"] %></p>
      <% end %>
      <% if s["source"] %><p>Source: <%= s["source"] %></p><% end %>
      <% if s["outfit_id"] %>
        <p><%= link_to t("actions.view_outfit", default: "View outfit"), outfit_path(s["outfit_id"]), class: "btn" %></p>
      <% end %>
    </article>
  <% end %>
<% else %>
  <p><%= t("ai.submit_to_compose") %></p>
<% end %>

<p><%= link_to t("actions.back_to_wardrobe"), items_path %></p>
</turbo-frame>
