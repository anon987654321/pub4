<% content_for :title, t("pages.suggest_outfits") %>
<header role="banner" aria-label="AI outfit suggestions header">
  <h1><%= t("pages.suggest_outfits") %></h1>
  <% if @ai_available %>
    <p class="dim">OpenRouter + wardrobe metadata<% if Current.user.items.joins(:photos_attachments).exists? %> (vision when photos exist)<% end %>. Shopping links are not used for ranking.</p>
  <% else %>
    <p class="dim"><strong>OpenRouter not configured</strong> — suggestions use local rules from your joy/active wardrobe. Set <code>OPENROUTER_API_KEY</code> for LLM + vision styling.</p>
  <% end %>
  <% if @master_photo %>
    <p class="dim">MASTER photograph is enabled (<code>AMBER_ENABLE_MASTER_PHOTO=1</code>) — look photos may attach when generation succeeds.</p>
  <% end %>
</header>

<turbo-frame id="amber-ai-suggest" data-turbo-action="replace">
<%= form_with url: ai_suggest_outfits_path, method: :get, class: "form", html: { role: "form", "aria-label": "Generate outfit suggestions" } do |f| %>
  <%# f.label rather than a bare <label> beside the field — see packing_list. %>
  <div class="field">
    <%= f.label :occasion, t("ai.occasion") %>
    <%= f.text_field :occasion, value: params[:occasion], placeholder: t("ai_forms.occasion_example") %>
  </div>
  <div class="field">
    <%= f.label :season, t("ai.season") %>
    <%= f.select :season, Item::SEASONS, { selected: params[:season] }, { include_blank: "Any" } %>
  </div>
  <div class="actions">
    <%= f.submit @ai_available ? t("ai.generate_suggestions") : t("ai.generate_rules"), class: "btn btn--primary" %>
    <%= button_to t("ai_forms.generate_save"), ai_generate_outfit_path, method: :post, params: { occasion: params[:occasion], season: params[:season] }, class: "btn", form_class: "inline" %>
  </div>
<% end %>

<% if @suggestions.present? %>
  <% @suggestions.each_with_index do |s, i| %>
    <article class="ai-card">
      <h2><%= s["name"] || "Option #{i + 1}" %></h2>
      <p class="dim"><%= Array(s["items"]).join(", ") %></p>
      <%# The rationale was rendered bare, so a reader couldn't tell it *was* the
          reasoning rather than a product blurb. Labelling it is the point of the
          suggestion: you should be able to judge the advice, not just take it. %>
      <% if s["description"].present? %>
        <p><strong>Why it works:</strong> <%= s["description"] %></p>
      <% end %>
      <% if s["source"] %><p class="dim">Source: <%= s["source"] %></p><% end %>
      <% if s["outfit_id"] %>
        <p><%= link_to t("actions.view_outfit", default: "View outfit"), outfit_path(s["outfit_id"]), class: "btn" %></p>
      <% end %>
    </article>
  <% end %>
<% else %>
  <p class="dim">Submit the form to compose from clothes you already own.</p>
<% end %>

<p><%= link_to t("actions.back_to_wardrobe"), items_path %></p>
</turbo-frame>
