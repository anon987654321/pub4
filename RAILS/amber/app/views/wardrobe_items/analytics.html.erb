<% content_for :title, t("pages.analytics") %>

<header role="banner" aria-label="<%= t("pages.analytics") %>">
  <hgroup>
    <p><%= t("wardrobe.closet_signals") %></p>
    <%= tag.h1 t("pages.analytics") %>
  </hgroup>
  <nav role="navigation" aria-label="<%= t("wardrobe.analytics_actions") %>">
    <%= link_to t("actions.wardrobe"), items_path, class: "btn" %>
    <%= link_to t("nav.outfits"), outfits_path, class: "btn" %>
    <%= link_to t("pages.organize"), organize_wardrobe_items_path, class: "btn" %>
    <%= link_to t("pages.timeline"), timeline_wardrobe_items_path, class: "btn" %>
    <%= link_to t("wardrobe.color_palette"), ai_palette_path, class: "btn" %>
  </nav>
</header>

<section class="chips" aria-label="<%= t("wardrobe.metrics") %>">
  <span class="chip"><%= t("wardrobe.chip_total", count: @analytics[:total_items]) %></span>
  <span class="chip"><%= t("wardrobe.chip_active", count: @analytics[:active_items]) %></span>
  <span class="chip"><%= t("wardrobe.chip_never_worn", count: @analytics[:never_worn]) %></span>
  <span class="chip"><%= t("wardrobe.chip_underused", count: @analytics[:underused]) %></span>
  <span class="chip"><%= t("wardrobe.chip_box", count: @analytics[:declutter_box]) %></span>
  <span class="chip"><%= t("wardrobe.chip_memory", count: @analytics[:sentimental_archive]) %></span>
  <%# cost-per-wear was computed by WardrobeAnalytics and then dropped on the
      floor by this page for its whole life. It is the metric the original
      specification named, so it leads the figures below as well as sitting
      here. %>
  <% if @analytics[:cost_per_wear] %>
    <span class="chip"><%= t("wardrobe.chip_avg_wear", amount: number_to_currency(@analytics[:cost_per_wear])) %></span>
  <% end %>
</section>

<section aria-label="<%= t("wardrobe.viz.region") %>">
  <%= render "figure",
        id: "category-mix",
        title: t("wardrobe.category_mix"),
        caption: t("wardrobe.viz.category_caption", count: @analytics[:active_items]),
        empty: t("wardrobe.viz.category_empty"),
        # No href: items#index filters on lifecycle and free-text search only,
        # so a category link would carry a parameter nothing reads.
        rows: @charts[:category_mix].map { |bar|
          { label: bar.label.presence || t("wardrobe.unsorted"), share: bar.share, value: bar.value }
        } %>

  <%= render "histogram",
        id: "wear-distribution",
        title: t("wardrobe.viz.usage"),
        caption: t("wardrobe.viz.usage_caption"),
        columns: @charts[:wear_distribution].map { |bar|
          { label: bar.key == :never ? t("wardrobe.viz.never") : bar.label,
            share: bar.share, value: bar.value, emphasis: bar.key == :never && bar.value.positive? }
        } %>

  <%= render "figure",
        id: "cost-per-wear",
        title: t("wardrobe.viz.cost"),
        caption: @analytics[:cost_per_wear] ? t("wardrobe.viz.cost_caption", amount: number_to_currency(@analytics[:cost_per_wear])) : t("wardrobe.viz.cost_caption_none"),
        empty: t("wardrobe.viz.cost_empty"),
        rows: @charts[:cost_per_wear].map { |bar|
          { label: bar.label, share: bar.share, value: number_to_currency(bar.value),
            note: t("wardrobe.viz.worn_times", count: bar.item.times_worn.to_i), href: item_path(bar.item) }
        } %>

  <%= render "figure",
        id: "idle",
        title: t("wardrobe.viz.idle"),
        caption: t("wardrobe.viz.idle_caption"),
        empty: t("wardrobe.viz.idle_empty"),
        rows: @charts[:idle].map { |bar|
          { label: bar.label, share: bar.share, value: t("wardrobe.viz.days", count: bar.value),
            note: t("wardrobe.viz.worn_times", count: bar.item.times_worn.to_i), href: item_path(bar.item) }
        } %>
</section>

<section>
  <h2><%= t("wardrobe.coach_tips") %> <span class="tag"><%= t("wardrobe.coach_rules") %></span></h2>
  <p><%= t("wardrobe.coach_body") %></p>
  <% if @analytics[:tips].any? %>
    <% @analytics[:tips].each do |tip| %><%= tag.p tip %><% end %>
  <% else %>
    <%# empty_state: no-action-ok — calm state when heuristics have nothing urgent %>
    <p><%= t("wardrobe.no_urgent_tips") %></p>
  <% end %>
</section>

<section>
  <%= tag.h2 t("wardrobe.recommendations") %>
  <% if @recommendations.blank? %>
    <%= render "shared/empty_state",
          title: t("empty.no_recommendations"),
          body: t("wardrobe.recommendations_body"),
          action: { label: t("actions.wardrobe"), path: items_path } %>
  <% else %>
    <% @recommendations.each do |recommendation| %>
      <article>
        <%= tag.strong recommendation.kind.humanize %>
        <p><%= recommendation.reason %></p>
      </article>
    <% end %>
  <% end %>
</section>
