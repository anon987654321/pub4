<%#
  A distribution, drawn as columns rather than the ranked bars of _figure: the
  axis here is ordered and continuous, and reading it left to right is the
  whole point. Column heights ride on --share against the plot band's height.

  Locals: id, title, columns [{label:, share:, value:, emphasis:}], and
  optionally caption.
%>
<figure class="viz viz-columns" aria-labelledby="viz-<%= id %>-title">
  <figcaption class="viz-head">
    <h3 class="viz-title" id="viz-<%= id %>-title"><%= title %></h3>
    <% if local_assigns[:caption].present? %>
      <p class="viz-caption"><%= caption %></p>
    <% end %>
  </figcaption>

  <ol class="viz-plot">
    <% columns.each do |column| %>
      <%# One sentence per column for a screen reader ("Never worn: 12 garments");
          the drawn value and label read as two loose fragments. %>
      <li class="viz-column<%= " is-emphasis" if column[:emphasis] %>">
        <%= tag.span t("wardrobe.viz.column_items", label: column[:label], count: column[:value].to_i),
                     class: "visually-hidden" %>
        <%= tag.span column[:value], class: "viz-column-value", aria: { hidden: true } %>
        <% if column[:share].to_f.positive? %>
          <span class="viz-column-fill" style="--share: <%= column[:share] %>"></span>
        <% end %>
        <%= tag.span column[:label], class: "viz-column-label", aria: { hidden: true } %>
      </li>
    <% end %>
  </ol>
</figure>
