<% content_for :title, @live_stream.title %>

<header role="banner" aria-label="<%= t("live_streams.header_label") %>">
  <div>
    <p class="dim"><%= t("live_streams.style_session", status: @live_stream.status) %></p>
    <h1><%= @live_stream.title %></h1>
  </div>
</header>

<p><%= @live_stream.description %></p>
<% if @live_stream.scheduled_at %><p class="dim">Scheduled: <%= @live_stream.scheduled_at %></p><% end %>
<%= link_to t("live_streams.all"), live_streams_path, class: "btn" %>
