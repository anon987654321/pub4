<% content_for :title, @live_stream.title %>

<header role="banner" aria-label="<%= t("live_streams.header_label") %>">
  <hgroup>
    <p><%= t("live_streams.style_session", status: @live_stream.status) %></p>
    <%= tag.h1 @live_stream.title %>
  </hgroup>
</header>

<%= tag.p @live_stream.description %>
<% if @live_stream.scheduled_at %><p>Scheduled: <%= @live_stream.scheduled_at %></p><% end %>
<%= link_to t("live_streams.all"), live_streams_path, class: "btn" %>
