<% content_for :title, @live_stream.title %>

<header aria-label="<%= t("live_streams.header_label") %>">
  <hgroup>
    <%= tag.p t("live_streams.style_session", status: live_stream_status_label(@live_stream.status)) %>
    <%= tag.h1 @live_stream.title %>
  </hgroup>
</header>

<%= tag.p @live_stream.description %>
<% if @live_stream.scheduled_at %>
  <%= tag.p t("live_streams.scheduled_at", at: l(@live_stream.scheduled_at, format: :datetime)) %>
<% end %>
<%= link_to t("live_streams.all"), live_streams_path, class: "button" %>
