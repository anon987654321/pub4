<% content_for :title, t("live_streams.title") %>

<header role="banner" aria-label="<%= t("live_streams.title") %>">
  <h1><%= t("live_streams.title") %></h1>
  <p class="dim"><%= t("wardrobe.sessions_lead") %></p>
</header>

<section class="form-wrap" aria-label="<%= t("live_streams.schedule_region") %>">
  <%= form_with model: @live_stream do |f| %>
    <%= render "shared/errors", object: @live_stream if lookup_context.exists?("shared/errors", [], true) %>
    <div class="field"><%= f.label :title, t("wardrobe.session_title") %><%= f.text_field :title, required: true %></div>
    <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 3 %></div>
    <div class="field"><%= f.label :scheduled_at %><%= f.datetime_field :scheduled_at %></div>
    <div class="field"><%= f.submit t("live_streams.schedule"), class: "btn" %></div>
  <% end %>
</section>

<%= turbo_frame_tag "live-streams" do %>
  <section aria-label="<%= t("live_streams.scheduled_region") %>">
    <% if @live_streams.any? %>
      <% @live_streams.each do |stream| %>
        <article>
          <h2><%= link_to stream.title, live_stream_path(stream) %></h2>
          <p class="dim"><%= stream.status %> · <%= stream.scheduled_at || stream.created_at %></p>
          <% if stream.user == Current.user %>
            <%= button_to t("live_streams.mark_live"), live_stream_path(stream), method: :patch, params: { start: true }, class: "btn" if stream.status == "scheduled" %>
            <%= button_to t("live_streams.mark_ended"), live_stream_path(stream), method: :patch, params: { end: true }, class: "btn" if stream.status == "live" %>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <%= render "shared/empty_state",
            title: t("empty.no_sessions"),
            body: t("wardrobe.sessions_empty_body"),
            action: { label: t("actions.wardrobe"), path: items_path } %>
    <% end %>
  </section>
<% end %>
