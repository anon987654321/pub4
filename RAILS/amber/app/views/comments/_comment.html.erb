<%= turbo_frame_tag dom_id(comment) do %>
<article class="comment">
  <header>
    <span><%= comment.user.email_address.split("@").first %></span>
    <span> · <time datetime="<%= comment.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(comment.created_at) %> ago</time></span>
    <% if authenticated? && comment.user == Current.user %>
      · <%= button_to "delete", post_comment_path(comment.commentable, comment), method: :delete, data: { turbo_confirm: "Delete?" } %>
    <% end %>
  </header>
  <p><%= comment.content %></p>
</article>
<% end %>
