<%= form_with model: comment, url: post_comments_path(post), id: "comment_form", data: { turbo: true } do |form| %>
  <p>
    <%= form.label :content, "Comment" %>
    <%= form.text_area :content, rows: 3, required: true %>
  </p>
  <% if comment.errors.any? %>
    <p><%= comment.errors.full_messages.to_sentence %></p>
  <% end %>
  <p><%= form.submit "Comment" %></p>
<% end %>
