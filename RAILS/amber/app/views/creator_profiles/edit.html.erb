<% content_for :title, t("creator_profiles.edit_title", default: "Edit creator profile") %>

<%= tag.h1 t("creator_profiles.edit_title", default: "Edit creator profile") %>
<%= render "form", profile: @profile %>

<section>
  <%= tag.h2 t("creator.showcase_items") %>
  <% if @profile.creator_wardrobe_items.any? %>
    <ul>
      <% @profile.creator_wardrobe_items.includes(:item).order(:position).each do |showcase| %>
        <li>
          <%= showcase.item.title %>
          <% if showcase.caption.present? %> — <%= showcase.caption %><% end %>
          <%# destructive: no-confirm-ok — reversible — the same form re-adds the item to the profile %>
          <%= button_to t("actions.remove"), creator_profile_wardrobe_item_path(handle: @profile.handle, id: showcase), method: :delete, class: "btn btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_showcase"),
          body: "Add a wardrobe piece with the form below.",
          action: { label: t("actions.wardrobe"), path: items_path } %>
  <% end %>

  <%= form_with url: creator_profile_wardrobe_items_path(handle: @profile.handle), method: :post, class: "form-wrap" do |f| %>
    <%= f.label :item_id, "Add item" %>
    <%= f.collection_select :item_id, Current.user.items.order(:title), :id, :title, include_blank: true %>
    <%= f.label :caption, "Caption" %>
    <%= f.text_field :caption %>
    <%= f.submit t("creator.add_showcase") %>
  <% end %>
</section>
