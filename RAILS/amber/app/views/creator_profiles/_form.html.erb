<%= form_with model: profile, url: my_creator_profile_path, method: (profile.persisted? ? :patch : :post) do |form| %>
  <%= render "shared/errors", object: profile %>

  <%= tag.fieldset do %>
    <%= form.label :handle %>
    <%= form.text_field :handle, required: true %>
  <% end %>

  <%= tag.fieldset do %>
    <%= form.label :display_name %>
    <%= form.text_field :display_name, required: true %>
  <% end %>

  <%= tag.fieldset do %>
    <%= form.label :bio %>
    <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <div class="compose-surface" data-controller="tiptap-editor">
    <%= form.text_area :bio, rows: 4 , maxlength: 1000, data: { character_counter_target: "input", tiptap_editor_target: "field", controller: "textarea-autogrow" } %>
    <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
    <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar" hidden>
      <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bold" title="<%= t("compose.bold") %>"><strong>B</strong></button>
      <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#italic" title="<%= t("compose.italic") %>"><em>i</em></button>
      <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bulletList" title="<%= t("compose.bullet_list") %>">&bull;</button>
    </div>
  </div>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
  <% end %>

  <%= tag.fieldset do %>
    <%= form.label :public, t("creator_profiles.public_label") %>
    <%= form.check_box :public %>
  <% end %>

  <%= form.submit profile.persisted? ? t("creator_profiles.save") : t("creator_profiles.create") %>
<% end %>
