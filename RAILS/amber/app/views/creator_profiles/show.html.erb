<% content_for :title, @profile.display_name %>
<%= turbo_stream_from @profile %>

<header class="profile-header" role="banner" aria-label="<%= t("creator.profile_label") %>">
  <%= tag.h1 @profile.display_name %>
  <p>@<%= @profile.handle %></p>
  <% if @profile.bio.present? %>
    <%# The bio is a Tiptap field now; escaped output would print its markup. %>
    <div class="prose"><%= rich_text @profile.bio %></div>
  <% end %>
  <% if authenticated? && Current.user == @profile.user %>
    <%= link_to t("wardrobe.edit_profile", default: t("actions.edit")), edit_my_creator_profile_path, class: "btn btn-sm" %>
  <% elsif @can_remix %>
    <p><%= t("creator.remix_friendly") %></p>
  <% end %>
</header>

<%= tag.h2 t("creator.showcase") %>
<% if @showcase_items.any? %>
  <div class="item-grid">
    <% @showcase_items.each do |showcase| %>
      <%= link_to item_path(showcase.item) do %>
        <% if showcase.item.photos.attached? %>
          <%= responsive_image_tag showcase.item.photos.first, alt: showcase.item.title %>
        <% else %>
          <div class="item-placeholder"><%= showcase.item.category %></div>
        <% end %>
        <%= tag.p showcase.caption.presence || showcase.item.title %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_showcase"),
        body: "Add pieces from your wardrobe when you edit this profile.",
        action: { label: "Edit showcase", path: edit_my_creator_profile_path } %>
<% end %>
