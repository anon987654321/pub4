<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="chrome-hidden">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff" data-light-color="#ffffff" data-dark-color="#000000">
  <title><%= content_for?(:title) ? "#{yield :title} — Amber" : "Amber" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Amber — social fashion. Share outfits, keep a wardrobe, and dress with people you follow." %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="Amber">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Amber" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Social fashion. Share outfits, keep a wardrobe, and dress with people you follow." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Amber" %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "Social fashion. Share outfits, keep a wardrobe, and dress with people you follow." %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <link rel="preload" href="/icon-192.png" as="image">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/caprasimo-latin-400-normal.woff2" crossorigin>
  <link rel="stylesheet" href="/swiper-bundle.min.css">
  <link rel="stylesheet" href="/lightgallery.css">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= yield :json_ld %>
  <%= json_ld_script(organization_json_ld(site_name: "Amber", url: root_url)) %>
  <%= javascript_importmap_tags %>
</head>
<body class="<%= "auth-surface" if controller_path.in?(%w[sessions passwords registrations]) %>"
      data-layout="document"
      data-surface="luxury"
      data-pwa-key="amber"
      data-controller="pwa-standalone browser-fingerprint feed-hotkey battery-aware network-aware viewport-aware"
      data-feed-hotkey-help-value="<%= t("hotkeys.help") %>"
      data-feed-hotkey-coach-value="<%= t("hotkeys.coach") %>"
      data-feed-hotkey-coach-dismiss-value="<%= t("hotkeys.coach_dismiss") %>"
      data-browser-fingerprint-url-value="<%= fingerprint_path %>">
<a class="skip-link" href="#main-content"><%= t("skip_to_content") %></a>
    <%# The shared icon sprite: every icon(...) <use> resolves against it. The
        shared theme toggle's sun icon was referencing symbols this app never
        included. %>
    <%= render "shared/icon_sprite" if icon_sprite? %>
<%# Amber's own Caprasimo mark, not shared/_brand_mark (the type-only wordmark
    brgen and bsdports share). The fleet mark is the wrong identity here.
    It lives inside the banner, not as a second fixed corner, and the nav
    variant of .amber-logo-banner sizes the home link so it does not stretch
    to the viewport the way the hero banner's `a { width: 100% }` would. %>
<%= render "shared/theme_toggle", storage_key: "amber-theme" %>

<div class="theme-root">
<header class="amber-logo-banner amber-logo-banner--nav">
  <%= link_to root_path, class: "amber-logo-home", aria: { label: t("nav.brand_home") } do %>
    <%= render "shared/logo", id_prefix: "amber-nav" %>
  <% end %>
  <div class="amber-nav-actions">
    <% if authenticated? %>
      <%= link_to t("nav.account"), user_path(Current.user), class: "btn-sm" %>
      <%= link_to t("nav.sign_out"), session_path, data: { turbo_method: :delete }, class: "btn-sm" %>
    <% else %>
      <%= link_to t("nav.sign_in"), new_session_path, class: "btn-sm" %>
    <% end %>
  </div>
</header>

<%# shared/_wardrobe_showcase used to render here — four auto-advancing carousel
    rows, above the content of every page a signed-out visitor could reach, at
    1235px each. On the home page that put the logo 5,410 pixels down. A landing
    feature does not belong in the layout; the mannequin that replaces it is
    rendered by home/index, which is the one page it is for. %>
<div class="app-shell" data-controller="scroll-chrome" data-scroll-chrome-storage-key-value="pub4:tab-bar:open">
  <div class="layout">
    <div class="sidebar-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="left" data-turbo-permanent>
    <aside class="sidebar" data-edge-swiper-target="root">
      <nav role="navigation" aria-label="<%= t("nav.primary_nav") %>">
        <%= render "shared/sidebar_nav" %>
      </nav>
    </aside>
    <button type="button" class="edge-grip edge-grip-start" data-edge-swiper-target="grip"
            data-action="click->edge-swiper#toggle" aria-label="<%= t("nav.show_sidebar") %>" aria-expanded="false"></button>
    </div>

    <main id="main-content" role="main" aria-label="<%= t("nav.main") %>">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <div class="widgets-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="right">
    <button type="button" class="edge-grip edge-grip-end" data-edge-swiper-target="grip"
            data-action="click->edge-swiper#toggle" aria-label="<%= t("nav.show_widgets") %>" aria-expanded="false"></button>
    <aside class="widgets" aria-label="<%= t("nav.show_widgets") %>" data-edge-swiper-target="root">
      <%= render "shared/widgets" %>
    </aside>
    </div>
  </div>

  <%= render "shared/footer" %>
  <%= render "shared/site_legal_footer" %>

  <div class="tab-bar-coach"
       data-scroll-chrome-target="coach"
       hidden
       role="status"
       aria-live="polite">
    <p class="tab-bar-coach-text"><%= t("nav.menu_coach") %></p>
    <div class="tab-bar-coach-actions">
      <button type="button" class="tab-bar-coach-dismiss" data-action="scroll-chrome#dismissCoach"><%= t("nav.menu_coach_dismiss") %></button>
      <button type="button" class="tab-bar-coach-show" data-action="scroll-chrome#reveal"><%= t("nav.show_menu") %></button>
    </div>
  </div>
  <button type="button"
          class="tab-bar-peel"
          data-scroll-chrome-target="peel"
          data-action="scroll-chrome#reveal"
          aria-controls="app-tab-bar"
          aria-expanded="false"
          aria-label="<%= t("nav.show_menu") %>"></button>
  <nav id="app-tab-bar"
       role="navigation"
       class="tab-bar"
       aria-label="<%= t("nav.mobile_nav") %>"
       data-scroll-chrome-target="bar"
       data-turbo-permanent
       aria-hidden="true"
       inert>
    <%= link_to root_path, class: "tab-item", aria: { label: t("nav.home"), current: current_page?(root_path) ? "page" : nil } do %>
      <%= icon :home, size: 26 %>
    <% end %>
    <% if authenticated? %>
      <%= link_to feed_posts_path, class: "tab-item", aria: { label: t("nav.feed"), current: current_page?(feed_posts_path) ? "page" : nil } do %>
        <%= icon :explore, size: 26 %>
      <% end %>
      <%= link_to items_path, class: "tab-item", aria: { label: t("nav.wardrobe"), current: current_page?(items_path) ? "page" : nil } do %>
        <%= icon :shirt, size: 26 %>
      <% end %>
      <%= link_to outfits_path, class: "tab-item", aria: { label: t("nav.outfits"), current: current_page?(outfits_path) ? "page" : nil } do %>
        <%= icon :layers, size: 26 %>
      <% end %>
    <% else %>
      <%= link_to posts_path, class: "tab-item", aria: { label: t("nav.feed"), current: current_page?(posts_path) ? "page" : nil } do %>
        <%= icon :explore, size: 26 %>
      <% end %>
      <%= link_to demo_wardrobe_path, class: "tab-item", aria: { label: t("nav.demo"), current: current_page?(demo_wardrobe_path) ? "page" : nil } do %>
        <%= icon :play, size: 26 %>
      <% end %>
      <%= link_to new_session_path, class: "tab-item", aria: { label: t("nav.sign_in"), current: current_page?(new_session_path) ? "page" : nil } do %>
        <%= icon :sign_in, size: 26 %>
      <% end %>
    <% end %>
  </nav>
</div>
</div>

<%= render "shared/install_prompt",
      title: t("install.title"),
      body: t("install.body") %>
<%= render "shared/nearby_chat_widget" %>
<%# Shared::Affiliate attribution. Renders nothing without TRADEDOUBLER_WEBSITE_ID; amber
    showed affiliate links for months with no website id anywhere in its process,
    so every click was unattributed. See Shared::LinkConverter. %>
<%= render "shared/link_converter" %>
</body>
</html>
