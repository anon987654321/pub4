<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff" data-light-color="#ffffff" data-dark-color="#000000">
  <title><%= content_for?(:title) ? "#{yield :title} — Amber" : "Amber" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Amber — AI wardrobe management. Build capsule wardrobes, plan outfits, and discover your personal style." %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="Amber">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Amber" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "AI wardrobe management. Build capsule wardrobes, plan outfits, and discover your personal style." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Amber" %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "AI wardrobe management. Build capsule wardrobes, plan outfits, and discover your personal style." %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preload" href="/icon.png" as="image">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caprasimo&display=optional">
  <link href="https://fonts.googleapis.com/css2?family=Caprasimo&display=optional" rel="stylesheet">
  <link rel="stylesheet" href="/swiper-bundle.min.css">
  <link rel="stylesheet" href="/lightgallery.css">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= yield :json_ld %>
  <%= json_ld_script(organization_json_ld(site_name: "Amber", url: root_url)) %>
  <%= javascript_importmap_tags %>
</head>
<body data-pwa-key="amber"
      data-controller="pwa-standalone browser-fingerprint"
      data-browser-fingerprint-url-value="<%= fingerprint_path %>">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%= render "shared/theme_toggle", storage_key: "amber-theme" %>

<div class="theme-root">
<header class="amber-logo-banner" aria-label="Amber">
  <%= link_to root_path, aria: { label: "Amber home" } do %>
    <%= render "shared/logo", id_prefix: "banner" %>
  <% end %>
</header>

<% unless authenticated? %>
  <%= render "shared/wardrobe_showcase" %>
<% end %>

<div class="app-shell">
  <div class="layout">
    <div class="sidebar-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="left" data-turbo-permanent>
    <aside class="sidebar" data-edge-swiper-target="root">
      <nav role="navigation" aria-label="Primary navigation">
        <%= render "shared/sidebar_nav" %>
      </nav>
    </aside>
    <button type="button" class="edge-grip edge-grip-left" data-edge-swiper-target="grip"
            data-action="click->edge-swiper#toggle" aria-label="Show sidebar" aria-expanded="false"></button>
    </div>

    <main id="main-content" role="main" aria-label="Main content">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <div class="widgets-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="right">
    <button type="button" class="edge-grip edge-grip-right" data-edge-swiper-target="grip"
            data-action="click->edge-swiper#toggle" aria-label="Show widgets" aria-expanded="false"></button>
    <aside class="widgets" aria-label="Sidebar widgets" data-edge-swiper-target="root">
      <%= render "shared/widgets" %>
    </aside>
    </div>
  </div>

  <%= render "shared/footer" %>

  <nav role="navigation" class="tab-bar" aria-label="Mobile navigation" data-turbo-permanent>
    <%= link_to root_path, class: "tab-item", aria: { label: "Home", current: current_page?(root_path) ? "page" : nil } do %>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 1.696L.622 8.807l1.06 1.696L3 9.679V19.5C3 20.881 4.119 22 5.5 22h4a1 1 0 001-1v-6h3v6a1 1 0 001 1h4c1.381 0 2.5-1.119 2.5-2.5V9.679l1.318.824 1.06-1.696L12 1.696z"/></svg>
    <% end %>
    <% if authenticated? %>
      <%= link_to feed_posts_path, class: "tab-item", aria: { label: "Feed", current: current_page?(feed_posts_path) ? "page" : nil } do %>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 7.521 3.51 7.521 8 0 4.42-3.584 8-8.005 8h-1.061l-.503.501c-.854.854-1.993 1.374-3.249 1.414l-1.82.055.055-1.82c.04-1.256.56-2.395 1.414-3.249l.501-.503V10z"/></svg>
      <% end %>
      <%= link_to items_path, class: "tab-item", aria: { label: "Wardrobe", current: current_page?(items_path) ? "page" : nil } do %>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 00-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z"/></svg>
      <% end %>
      <%= link_to outfits_path, class: "tab-item", aria: { label: "Outfits", current: current_page?(outfits_path) ? "page" : nil } do %>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <% end %>
      <%= link_to new_item_path, class: "compose-fab", aria: { label: "Add item" } do %>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11 4h2v16h-2zM4 11h16v2H4z"/></svg>
      <% end %>
    <% else %>
      <%= link_to demo_wardrobe_path, class: "tab-item", aria: { label: "Demo wardrobe", current: current_page?(demo_wardrobe_path) ? "page" : nil } do %>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
      <% end %>
      <%= link_to new_session_path, class: "tab-item", aria: { label: "Sign in", current: current_page?(new_session_path) ? "page" : nil } do %>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M13.91 8.41L15.32 7 21 12.68l-5.68 5.68-1.41-1.41 3.26-3.27H3v-2h14.17l-3.26-3.27z"/></svg>
      <% end %>
    <% end %>
  </nav>
</div>
</div>

<%= render "shared/install_prompt" %>
</body>
</html>
