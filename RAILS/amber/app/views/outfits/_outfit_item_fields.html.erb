<div class="nested-form-wrapper nested-field" data-new-record="<%= f.object.new_record? %>">
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :position, value: (f.object.position || 0) %>
  <div class="field">
    <%= f.label :item_id, t("outfits.item") %>
    <%= f.select :item_id, item_options, { include_blank: t("outfits.select_item") } %>
  </div>
  <%= f.hidden_field :_destroy %>
  <button type="button" class="button-link" data-action="nested-form#remove"><%= t("outfits.remove_item") %></button>
</div>
