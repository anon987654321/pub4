<% content_for :title, @outfit.name %>

<header role="banner" aria-label="Outfit header">
  <div>
    <p class="dim"><%= @outfit.context_label.presence || "Outfit" %></p>
    <%= tag.h1 @outfit.name %>
  </div>
</header>

<div class="tag-row">
  <span class="tag"><%= pluralize(@outfit.items.count, "item") %></span>
  <span class="tag"><%= pluralize(@outfit.likes_count.to_i, "like") %></span>
  <span class="tag"><%= pluralize(@outfit.total_wears, "combined wear") %></span>
  <% if @outfit.estimated_value.positive? %><span class="tag"><%= number_to_currency(@outfit.estimated_value) %> wardrobe value</span><% end %>
</div>

<% if @outfit.description.present? %>
  <%= tag.p @outfit.description %>
<% else %>
  <p class="dim"><%= t("outfits.no_description") %></p>
<% end %>

<% if @outfit.image.attached? %>
  <div class="outfit-visual">
    <%= responsive_image_tag @outfit.image, alt: @outfit.name, preset: :detail, sizes: "(max-width: 768px) 100vw, 400px", style: "max-width: 400px; height: auto;" %>
  </div>
<% end %>

<section>
  <h2>Items</h2>
  <div class="item-grid" data-controller="sortable" data-sortable-update-url-value="<%= reorder_outfit_path(@outfit) %>">
    <%= render @outfit.items %>
  </div>
</section>

<section>
  <%= tag.h2 t("outfits.style_intelligence") %>
  <p class="dim"><%= t("outfits.style_intelligence_lead") %></p>
</section>

<nav role="navigation" aria-label="Outfit actions">
  <%= button_to t("actions.like_count", count: @outfit.likes_count.to_i), like_outfit_path(@outfit), method: :post, class: "btn" %>
  <%= button_to t("outfits.share_brgen"), share_outfit_path(@outfit), method: :post, class: "btn" %>
  <%= button_to t("outfits.wear_again"), wear_outfit_path(@outfit), method: :post, class: "btn" %>
  <%= link_to t("actions.edit"), edit_outfit_path(@outfit), class: "btn" %>
  <%= link_to t("nav.outfits"), outfits_path, class: "btn" %>
  <%= button_to t("actions.delete"), @outfit, method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "btn btn-danger" %>
</nav>
