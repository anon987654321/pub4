<% content_for :title, @outfit.name %>
<% summary = @outfit.description.to_s.squish %>
<% content_for :description, summary.truncate(160).presence ||
                               t("outfits.meta_description", name: @outfit.name, count: @outfit.items.size) %>
<% content_for :json_ld, json_ld_script(outfit_schema(@outfit)) %>

<header aria-label="<%= t("outfits.header_label") %>">
  <hgroup>
    <p><%= @outfit.context_label.presence || t("outfits.fallback_context") %></p>
    <%= tag.h1 @outfit.name %>
  </hgroup>
</header>

<div class="tag-row">
  <%= tag.span t("outfits.linked_items", count: @outfit.items.size), class: "tag" %>
  <%= render "outfits/likes_tag", outfit: @outfit %>
  <span class="tag"><%= t("outfits.combined_wears", count: @outfit.total_wears) %></span>
  <% if @outfit.estimated_value.positive? %><span class="tag"><%= t("outfits.wardrobe_value", amount: number_to_currency(@outfit.estimated_value)) %></span><% end %>
</div>

<% if @outfit.description.present? %>
  <%= tag.p @outfit.description %>
<% else %>
  <p><%= t("outfits.no_description") %></p>
<% end %>

<% if @outfit.image.attached? %>
  <div class="outfit-visual">
    <%# reserved: responsive_image_tag writes the blob's width and height onto the tag %>
    <%= responsive_image_tag @outfit.image, alt: @outfit.name, preset: :detail, sizes: "(max-width: 768px) 100vw, 400px" %>
  </div>
<% end %>

<section>
  <%= tag.h2 t("outfits.items_section") %>
  <%# The move labels are this controller's own values: under the sortable's
      identifier they named nothing, and the buttons said "Move up" in English. %>
  <div class="item-grid" data-controller="outfit-sortable"
       data-outfit-sortable-update-url-value="<%= reorder_outfit_path(@outfit) %>"
       data-outfit-sortable-move-up-label-value="<%= t("actions.move_up") %>"
       data-outfit-sortable-move-down-label-value="<%= t("actions.move_down") %>"
       data-outfit-sortable-status-id-value="outfit-order-status"
       data-outfit-sortable-saved-label-value="<%= t("outfits.order_saved") %>"
       data-outfit-sortable-failed-label-value="<%= t("outfits.order_failed") %>">
    <%= render @outfit.items %>
  </div>
  <p id="outfit-order-status" role="status"></p>
</section>

<nav role="navigation" aria-label="<%= t("outfits.actions_label") %>">
  <%= render "outfits/like_button", outfit: @outfit %>
  <%= button_to t("outfits.share_brgen"), share_outfit_path(@outfit), method: :post, class: "button" %>
  <%= button_to t("outfits.wear_again"), wear_outfit_path(@outfit), method: :post, class: "button" %>
  <%= link_to t("actions.edit"), edit_outfit_path(@outfit), class: "button" %>
  <%= link_to t("nav.outfits"), outfits_path, class: "button" %>
  <%= button_to t("actions.delete"), @outfit, method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "button button-danger" %>
</nav>
