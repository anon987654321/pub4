<% content_for :title, @outfit.name %>

<header role="banner" aria-label="<%= t("outfits.header_label") %>">
  <hgroup>
    <p><%= @outfit.context_label.presence || t("outfits.fallback_context") %></p>
    <%= tag.h1 @outfit.name %>
  </hgroup>
</header>

<div class="tag-row">
  <span class="tag"><%= t("outfits.linked_items", count: @outfit.items.count) %></span>
  <%= render "outfits/likes_tag", outfit: @outfit %>
  <span class="tag"><%= t("outfits.combined_wears", count: @outfit.total_wears) %></span>
  <% if @outfit.estimated_value.positive? %><span class="tag"><%= t("outfits.wardrobe_value", amount: number_to_currency(@outfit.estimated_value)) %></span><% end %>
</div>

<% if @outfit.description.present? %>
  <%= tag.p @outfit.description %>
<% else %>
  <p><%= t("outfits.no_description") %></p>
<% end %>

<% if @outfit.image.attached? %>
  <div class="outfit-visual">
    <%# reserved: responsive_image_tag writes the blob's width and height onto the tag %>
    <%= responsive_image_tag @outfit.image, alt: @outfit.name, preset: :detail, sizes: "(max-width: 768px) 100vw, 400px" %>
  </div>
<% end %>

<section>
  <%= tag.h2 t("outfits.items_section") %>
  <div class="item-grid" data-controller="outfit-sortable" data-outfit-sortable-update-url-value="<%= reorder_outfit_path(@outfit) %>" data-sortable-move-up-label-value="<%= t("actions.move_up") %>" data-sortable-move-down-label-value="<%= t("actions.move_down") %>">
    <%= render @outfit.items %>
  </div>
</section>

<section>
  <%= tag.h2 t("outfits.style_intelligence") %>
  <p><%= t("outfits.style_intelligence_lead") %></p>
</section>

<nav role="navigation" aria-label="<%= t("outfits.actions_label") %>">
  <%= render "outfits/like_button", outfit: @outfit %>
  <%= button_to t("outfits.share_brgen"), share_outfit_path(@outfit), method: :post, class: "btn" %>
  <%= button_to t("outfits.wear_again"), wear_outfit_path(@outfit), method: :post, class: "btn" %>
  <%= link_to t("actions.edit"), edit_outfit_path(@outfit), class: "btn" %>
  <%= link_to t("nav.outfits"), outfits_path, class: "btn" %>
  <%= button_to t("actions.delete"), @outfit, method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "btn btn-danger" %>
</nav>
