<div class="tag-row">
  <span class="tag"><%= pluralize(@outfits.sum { |outfit| outfit.items.count }, "linked item") %></span>
  <span class="tag"><%= pluralize(@outfits.sum { |outfit| outfit.likes_count.to_i }, "like") %></span>
  <span class="tag"><%= pluralize(@outfits.sum(&:total_wears), "combined wear") %></span>
</div>

<%= turbo_frame_tag "outfits", target: "_top" do %>
<div class="item-grid item-grid--luxury" id="outfits"><%= render @outfits %></div>

<% if @outfits.empty? %>
  <%= render "shared/empty_state",
        title: t("empty.no_outfits"),
        body: "Start with a capsule, event, season, or mood.",
        action: { label: "Compose an outfit", path: new_outfit_path } %>
<% end %>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "OutfitsInfiniteScrollReflex#load_more",
           sentinel_id: "amber-outfits-sentinel",
           q: params[:q] %>
<% end %>
