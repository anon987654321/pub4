<div class="tag-row">
  <span class="tag"><%= t("outfits.linked_items", count: @outfits.sum { |outfit| outfit.items.count }) %></span>
  <span class="tag"><%= t("outfits.likes_on_page", count: @outfits.sum { |outfit| outfit.likes_count.to_i }) %></span>
  <span class="tag"><%= t("outfits.combined_wears", count: @outfits.sum(&:total_wears)) %></span>
</div>

<%= turbo_frame_tag "outfits", target: "_top" do %>
<%# Same cadence and the same grid caveat as the wardrobe — see
    items/_live_search_results. %>
<div class="item-grid item-grid--luxury" id="outfits">
  <% @outfits.each_with_index do |outfit, index| %>
    <%= render outfit %>
    <% if ((index + 1) % Shared::AffiliateHelper::FEED_EVERY).zero? && index + 1 < @outfits.size %>
      <%= render "shared/affiliate_feed_unit", category: "fashion", in_grid: true %>
    <% end %>
  <% end %>
</div>

<% if @outfits.empty? %>
  <%= render "shared/empty_state",
        title: t("empty.no_outfits"),
        body: t("empty.outfits_start"),
        action: { label: t("actions.compose_outfit"), path: new_outfit_path } %>
<% end %>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "OutfitsInfiniteScrollReflex#load_more",
           sentinel_id: "amber-outfits-sentinel",
           q: params[:q] %>
<% end %>
