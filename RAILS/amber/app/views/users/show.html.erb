<%= turbo_stream_from @user %>
<header class="profile-header" role="banner" aria-label="User profile header">
  <h1><%= @user.email_address.split("@").first %></h1>
  <p><%= @user.items.count %> items · <%= @user.followers.count %> followers · <%= @user.following.count %> following</p>
  <% if authenticated? && Current.user != @user %>
    <% if Current.user.following?(@user) %>
      <%= button_to t("actions.unfollow"), unfollow_user_path(@user), method: :delete, class: "btn" %>
    <% else %>
      <%= button_to t("actions.follow"), follow_user_path(@user), method: :post, class: "btn btn--primary" %>
    <% end %>
  <% end %>
  <% if @user.public_creator? %>
    <p><%= link_to t("actions.creator_profile", default: "Creator profile"), creator_profile_path(@user.creator_profile.handle), class: "btn btn-sm" %></p>
  <% elsif authenticated? && Current.user == @user %>
    <p><%= link_to t("actions.setup_creator", default: "Set up creator profile"), new_my_creator_profile_path, class: "btn btn-sm" %></p>
  <% end %>
</header>
<h2><%= t("users.recent_items") %></h2>
<div class="item-grid">
  <% @items.each do |item| %>
    <%= link_to item_path(item) do %>
      <% if item.photos.attached? %>
        <%= image_tag item.photos.first, alt: item.title %>
      <% else %>
        <div class="item-placeholder"><%= item.category %></div>
      <% end %>
      <p><%= item.title %></p>
    <% end %>
  <% end %>
</div>
<h2>Posts</h2>
<%= render @posts %>
