<% content_for :title, "Notifications" %>

<%= turbo_frame_tag "notifications" do %>
  <div class="page-header" role="banner" aria-label="Notifications header">
    <div>
      <h1>Notifications</h1>
    </div>
    <% unread = @notifications.count { |n| !n.read? } %>
    <% if unread.positive? %>
      <%= button_to "Mark all read", read_all_notifications_path, method: :patch, class: "btn btn-primary", data: { turbo_stream: true } %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <% @notifications.each do |notification| %>
      <%= render "notifications/notification", notification: notification %>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: "No notifications yet",
          body: "Updates will appear here.",
          action: { label: "Home", path: root_path } %>
  <% end %>
<% end %>
