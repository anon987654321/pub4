<div class="auth-form">
  <%= tag.h1 t("auth.forgot_title") %>
  <p class="auth-form-lead"><%= t("auth.forgot_lead") %></p>
  <% if flash[:alert] %><p class="flash-alert" role="alert"><%= flash[:alert] %></p><% end %>
  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, t("auth.email") %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="actions">
      <%= form.submit t("auth.email_reset"), class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.back_to_sign_in"), new_session_path %>
    </p>
  <% end %>
</div>
