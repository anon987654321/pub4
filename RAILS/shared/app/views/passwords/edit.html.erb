<div class="auth-form">
  <%= tag.h1 t("auth.update_password") %>
  <p class="auth-form-lead"><%= t("auth.update_password_lead") %></p>
  <% if flash[:alert] %><p class="flash-alert" role="alert"><%= flash[:alert] %></p><% end %>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= form.label :password, t("auth.new_password") %>
      <%= password_visibility_field form, :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, t("auth.confirm_password") %>
      <%= password_visibility_field form, :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="actions">
      <%= form.submit t("auth.save_password"), class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.back_to_sign_in"), new_session_path %>
    </p>
  <% end %>
</div>
