<%# Fleet floating chat bar (flush bottom-right).
    Brgen: ambient chat — #brgen lobby without GPS, #nearby when located.
    Other apps: inbox or deep-link to Brgen. %>
<%# The room this visitor lands in, resolved server-side. Rendering "chat"
    here and letting nearby_chat_controller rewrite it once the frame arrived
    was a visible relabel and made the tab's width unstable -- see
    Shared::UiHelper#ambient_chat_room_label. %>
<% widget_title = local_assigns.fetch(:title, ambient_chat_room_label || t("chat.title")) %>
<div class="nearby-chat-widget"
     data-controller="nearby-chat"
     data-nearby-chat-storage-key-value="pub4:ambient-chat:open"
     data-nearby-chat-label-chat-value="<%= t("chat.title") %>"
     data-nearby-chat-label-nearby-value="<%= t("chat.nearby_tab") %>"
     data-nearby-chat-status-asking-value="<%= t("chat.status_asking") %>"
     data-nearby-chat-status-denied-value="<%= t("chat.status_denied") %>"
     data-nearby-chat-status-timeout-value="<%= t("chat.status_timeout") %>"
     data-nearby-chat-status-unavailable-value="<%= t("chat.status_unavailable") %>"
     data-nearby-chat-status-blocked-value="<%= t("chat.status_blocked") %>"
     data-nearby-chat-status-server-value="<%= t("chat.status_server") %>"
     data-nearby-chat-status-network-value="<%= t("chat.status_network") %>">
  <button type="button"
          class="nearby-chat-widget-tab"
          data-nearby-chat-target="tab"
          data-action="nearby-chat#toggle"
          aria-expanded="false"
          aria-controls="nearby-chat-widget-panel"
          aria-haspopup="dialog">
    <%= icon :messages, size: 16 %>
    <span data-nearby-chat-target="tabLabel"><%= widget_title %></span>
  </button>

  <div id="nearby-chat-widget-panel"
       class="nearby-chat-widget-panel"
       data-nearby-chat-target="panel"
       role="dialog"
       aria-modal="false"
       aria-label="<%= widget_title %>"
       hidden>
    <header class="nearby-chat-widget-header">
      <span data-nearby-chat-target="headerLabel"><%= widget_title %></span>
      <button type="button"
              class="nearby-chat-widget-close"
              data-action="nearby-chat#close"
              aria-label="<%= t("chat.close") %>">&times;</button>
    </header>

    <p class="nearby-chat-widget-status dim" data-nearby-chat-target="status" hidden aria-live="polite"></p>

    <div class="nearby-chat-widget-body">
      <%# ambient_chat_frame_path, not respond_to?(:nearby_widget_path): the
          brgen verticals are engines and an engine's helpers do not carry the
          host app's routes. See Shared::UiHelper#ambient_chat_frame_path. %>
      <% if (chat_frame_src = ambient_chat_frame_path) %>
        <%= turbo_frame_tag "nearby-chat-widget-frame", src: chat_frame_src, class: "nearby-chat-widget-frame" do %>
          <div class="nearby-chat-widget-empty">
            <%= tag.strong t("chat.title") %>
            <%= tag.p t("chat.loading") %>
          </div>
        <% end %>
      <% elsif respond_to?(:messages_path) %>
        <div class="nearby-chat-widget-empty">
          <%= tag.strong t("nav.messages") %>
          <% if respond_to?(:authenticated?) && authenticated? %>
            <%= tag.p t("chat.open_inbox") %>
            <%= link_to t("chat.open_messages"), messages_path, class: "nearby-chat-widget-cta" %>
          <% else %>
            <%= tag.p t("chat.sign_in_inbox") %>
            <% if respond_to?(:new_session_path) %>
              <%= link_to t("nav.sign_in"), new_session_path, class: "nearby-chat-widget-cta" %>
            <% end %>
            <%= link_to t("chat.open_brgen"), "https://brgen.no/channels/brgen", class: "nearby-chat-widget-cta", rel: "noopener" %>
          <% end %>
        </div>
      <% else %>
        <div class="nearby-chat-widget-empty">
          <%= tag.strong t("chat.on_brgen") %>
          <%= tag.p t("chat.lobby_body") %>
          <%= link_to t("chat.open_brgen_channel"), "https://brgen.no/channels/brgen", class: "nearby-chat-widget-cta", rel: "noopener" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
