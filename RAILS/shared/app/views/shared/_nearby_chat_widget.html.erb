<%# Fleet floating chat bar (flush bottom-right).
    Brgen: ambient chat — #brgen lobby without GPS, #nearby when located.
    Other apps: inbox or deep-link to Brgen. %>
<% widget_title = local_assigns.fetch(:title, t("chat.title", default: "chat")) %>
<div class="nearby-chat-widget"
     data-controller="nearby-chat"
     data-nearby-chat-storage-key-value="pub4:ambient-chat:open"
     data-nearby-chat-label-chat-value="<%= t("chat.title", default: "chat") %>"
     data-nearby-chat-label-nearby-value="<%= t("chat.nearby_tab", default: "nearby") %>"
     data-nearby-chat-status-asking-value="<%= t("chat.status_asking", default: "Asking for location…") %>"
     data-nearby-chat-status-denied-value="<%= t("chat.status_denied", default: "Location blocked — staying in #brgen. Enable location in the browser for #nearby.") %>"
     data-nearby-chat-status-timeout-value="<%= t("chat.status_timeout", default: "Location timed out — staying in #brgen.") %>"
     data-nearby-chat-status-unavailable-value="<%= t("chat.status_unavailable", default: "Location unavailable — staying in #brgen.") %>"
     data-nearby-chat-status-blocked-value="<%= t("chat.status_blocked", default: "This page cannot read location — #brgen still works.") %>"
     data-nearby-chat-status-server-value="<%= t("chat.status_server", default: "Could not save location — try again.") %>"
     data-nearby-chat-status-network-value="<%= t("chat.status_network", default: "Network error saving location — try again.") %>">
  <button type="button"
          class="nearby-chat-widget-tab"
          data-nearby-chat-target="tab"
          data-action="nearby-chat#toggle"
          aria-expanded="false"
          aria-controls="nearby-chat-widget-panel"
          aria-haspopup="dialog">
    <%= icon :messages, size: 16 %>
    <span data-nearby-chat-target="tabLabel"><%= widget_title %></span>
  </button>

  <div id="nearby-chat-widget-panel"
       class="nearby-chat-widget-panel"
       data-nearby-chat-target="panel"
       role="dialog"
       aria-modal="false"
       aria-label="<%= widget_title %>"
       hidden>
    <header class="nearby-chat-widget-header">
      <span data-nearby-chat-target="headerLabel"><%= widget_title %></span>
      <button type="button"
              class="nearby-chat-widget-close"
              data-action="nearby-chat#close"
              aria-label="<%= t("chat.close", default: "Close") %>">&times;</button>
    </header>

    <p class="nearby-chat-widget-status dim" data-nearby-chat-target="status" hidden aria-live="polite"></p>

    <div class="nearby-chat-widget-body">
      <% if respond_to?(:nearby_widget_path) %>
        <%= turbo_frame_tag "nearby-chat-widget-frame", src: nearby_widget_path, class: "nearby-chat-widget-frame" do %>
          <div class="nearby-chat-widget-empty">
            <strong><%= t("chat.title", default: "Chat") %></strong>
            <p><%= t("chat.loading", default: "Loading the room…") %></p>
          </div>
        <% end %>
      <% elsif respond_to?(:messages_path) %>
        <div class="nearby-chat-widget-empty">
          <strong><%= t("nav.messages", default: t("messages.title", default: "Messages")) %></strong>
          <% if respond_to?(:authenticated?) && authenticated? %>
            <p><%= t("chat.open_inbox", default: "Open your inbox to read and send messages on this app.") %></p>
            <%= link_to t("chat.open_messages", default: "Open messages"), messages_path, class: "nearby-chat-widget-cta" %>
          <% else %>
            <p><%= t("chat.sign_in_inbox", default: "Sign in for this app’s inbox, or chat anonymously on Brgen.") %></p>
            <% if respond_to?(:new_session_path) %>
              <%= link_to t("nav.sign_in", default: "Sign in"), new_session_path, class: "nearby-chat-widget-cta" %>
            <% end %>
            <%= link_to t("chat.open_brgen", default: "Open Brgen chat"), "https://brgen.no/channels/brgen", class: "nearby-chat-widget-cta", rel: "noopener" %>
          <% end %>
        </div>
      <% else %>
        <div class="nearby-chat-widget-empty">
          <strong><%= t("chat.on_brgen", default: "Chat on Brgen") %></strong>
          <p><%= t("chat.lobby_body", default: "City lobby works without GPS.") %></p>
          <%= link_to t("chat.open_brgen_channel", default: "Open #brgen"), "https://brgen.no/channels/brgen", class: "nearby-chat-widget-cta", rel: "noopener" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
