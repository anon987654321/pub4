<% app_name ||= "App" %>
<% storage_key ||= app_name.downcase %>

<section class="offline-page" data-controller="offline-page" data-offline-page-storage-key-value="<%= storage_key %>">
  <div>
    <p class="offline-page-meta"><%= t("offline.badge") %></p>
    <%= tag.h1 t("offline.title", app: app_name) %>
    <p class="offline-page-lead"><%= t("offline.lead") %></p>
    <button type="button" class="offline-page-retry btn btn-primary" data-action="offline-page#retry">
      <%= t("offline.retry") %>
    </button>
  </div>

  <ul class="offline-page-list" data-offline-page-target="list" role="list" aria-label="<%= t("offline.list_label") %>">
    <li class="offline-page-item"><%= t("offline.loading") %></li>
  </ul>
</section>
