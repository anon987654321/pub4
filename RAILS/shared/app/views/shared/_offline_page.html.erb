<% app_name ||= "App" %>
<% storage_key ||= app_name.downcase %>

<section class="offline-page" data-controller="offline-page" data-offline-page-storage-key-value="<%= storage_key %>">
  <div>
    <p class="offline-page-meta">Offline</p>
    <h1><%= app_name %> is offline</h1>
    <p class="offline-page-lead">We’ll show the last cached items from this device when they’re available.</p>
  </div>

  <ul class="offline-page-list" data-offline-page-target="list" role="list" aria-label="Offline content list">
    <li class="offline-page-item">Loading cached items…</li>
  </ul>
</section>