<% if local_assigns[:filter_fields_proc] %>
  <%= live_search_form(
        url: url,
        placeholder: placeholder,
        label: label,
        query: local_assigns[:query],
        show_submit: local_assigns.fetch(:show_submit, true),
        &filter_fields_proc
      ) %>
<% else %>
  <%= live_search_form(
        url: url,
        placeholder: placeholder,
        label: label,
        query: local_assigns[:query],
        show_submit: local_assigns.fetch(:show_submit, true)
      ) %>
<% end %>

<%= live_search_results frame_id: frame_id, results_partial: results_partial, label: label %>
