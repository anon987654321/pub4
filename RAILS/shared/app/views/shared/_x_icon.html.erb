<%# Lucide icons (ISC) -- outlined, 2px stroke, 24x24 grid. %>
<% size = local_assigns.fetch(:size, 18) %>
<svg class="<%= local_assigns[:css_class] %>" viewBox="0 0 24 24" width="<%= size %>" height="<%= size %>" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <%= render "shared/x_icons/#{name}" %>
</svg>
