<div class="sidebar-card newsletter-cta subscribe-box" data-controller="scroll-reveal" data-minimal-reveal>
  <h2><%= local_assigns.fetch(:heading, "The city letter") %></h2>
  <p class="dim"><%= local_assigns.fetch(:blurb, "One email a week. Curated, not cluttered. Unsubscribe any time.") %></p>
  <% if defined?(email_subscriptions_path) %>
    <%= form_with url: email_subscriptions_path, method: :post do |form| %>
      <div class="field mb-8">
        <%= form.email_field :email, name: "email_subscription[email]",
              placeholder: t("newsletter.email_placeholder"), aria: { label: t("newsletter.email_placeholder") }, required: true,
              class: "map-search-input", autocomplete: "email" %>
      </div>
      <label class="field--check-label">
        <input type="checkbox" name="email_subscription[agreed_to_marketing]" value="1">
        <span class="dim">Send me partner offers and sponsored picks (optional)</span>
      </label>
      <%= form.submit local_assigns.fetch(:button_label, "Subscribe"), class: "btn btn-primary btn-sm btn-block" %>
    <% end %>
  <% else %>
    <p class="dim">Newsletter signup opens after email routes are configured for this app.</p>
  <% end %>
</div>
