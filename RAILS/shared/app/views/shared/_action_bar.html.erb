<%# locals: record, reply_path: nil, share_url: nil, liked: false, like_count: 0, repost_count: 0, repost_path: nil, reposted: false, view_count: nil, comment_count: 0 %>
<% like_count = local_assigns.fetch(:like_count, 0).to_i %>
<div class="feed-card-actions">
  <% if local_assigns[:reply_path].present? %>
    <%= link_to reply_path, class: "feed-action feed-action--reply", aria: { label: "Reply" } do %>
      <%= icon(:reply, size: 18) %>
      <% if comment_count.to_i.positive? %>
        <span class="feed-action-count"><%= comment_count %></span>
      <% end %>
    <% end %>
  <% else %>
    <button type="button" class="feed-action feed-action--reply" aria-label="Reply" disabled>
      <%= icon(:reply, size: 18) %>
    </button>
  <% end %>

  <%# repost_path is passed only by surfaces that have somewhere to send it —
      brgen posts today. Everywhere else the button stays disabled rather than
      accepting a press and discarding it, which is what it did for months. %>
  <% if local_assigns[:repost_path].present? %>
    <%# button_to rather than the `action` controller: a form costs no Stimulus
        instance on a feed of cards, and the count comes back from the server
        instead of an optimistic guess that needs rolling back. %>
    <%= button_to repost_path,
                  method: :post,
                  class: "feed-action feed-action--repost#{" active" if local_assigns[:reposted]}",
                  form_class: "feed-action-form",
                  aria: { label: "Repost", pressed: !!local_assigns[:reposted] } do %>
      <%= icon(:repost, size: 18) %>
      <span class="feed-action-count"><%= local_assigns.fetch(:repost_count, 0).to_i.positive? ? repost_count : "" %></span>
    <% end %>
  <% else %>
    <button type="button" class="feed-action feed-action--repost" aria-label="Repost" disabled>
      <%= icon(:repost, size: 18) %>
      <% if local_assigns.fetch(:repost_count, 0).to_i.positive? %>
        <span class="feed-action-count"><%= repost_count %></span>
      <% end %>
    </button>
  <% end %>

  <button type="button"
          class="feed-action feed-action--like<%= " active" if local_assigns[:liked] %>"
          data-controller="action"
          data-action="action#toggle"
          data-action-url-value="<%= reactions_path %>"
          data-action-target-gid-value="<%= record.to_signed_global_id %>"
          data-action-kind-value="like"
          data-action-count-value="<%= like_count %>"
          aria-label="Like">
    <%= icon(:like, size: 18) %>
    <span class="feed-action-count" data-action-target="count"><%= like_count.positive? ? like_count : "" %></span>
  </button>

  <% if local_assigns[:view_count].present? %>
    <span class="feed-action feed-action--views" aria-label="<%= view_count %> views">
      <%= icon(:views, size: 18) %>
      <span class="feed-action-count"><%= view_count %></span>
    </span>
  <% end %>

  <% if local_assigns[:share_url].present? %>
    <span data-controller="clipboard" data-clipboard-success-content-value="Copied">
      <input type="hidden" data-clipboard-target="source" value="<%= share_url %>" aria-hidden="true" tabindex="-1">
      <button type="button"
              class="feed-action feed-action--share"
              aria-label="Share"
              data-action="click->clipboard#copy"
              data-clipboard-target="button">
        <%= icon(:share, size: 18) %>
      </button>
    </span>
  <% else %>
    <button type="button" class="feed-action feed-action--share" aria-label="Share" disabled>
      <%= icon(:share, size: 18) %>
    </button>
  <% end %>
</div>
