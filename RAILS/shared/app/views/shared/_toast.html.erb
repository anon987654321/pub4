<%# data-turbo-temporary keeps a toast out of Turbo's page cache, so a back
    button does not replay a confirmation that already left. %>
<% classes = ["toast", local_assigns[:variant] ? "toast--#{local_assigns[:variant]}" : nil].compact.join(" ") %>
<div class="<%= classes %>" role="status" aria-live="polite" data-controller="toast" data-toast-delay-value="<%= local_assigns.fetch(:delay, 4000) %>" data-turbo-temporary>
  <%= local_assigns[:message] %>
</div>
