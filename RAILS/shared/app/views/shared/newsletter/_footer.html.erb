<tr>
  <td class="mail-footer">
    <%= edition.edition_date.strftime("%-d %B %Y") %> · <%= edition.app_name %>
    <br>
    <a href="<%= unsubscribe_url %>"><%= t("newsletter.unsubscribe") %></a>
    <% if defined?(affiliate_disclosure_text) %>
      <div class="mail-affiliate"><%= affiliate_disclosure_text %></div>
    <% else %>
      <div class="mail-affiliate"><%= t("newsletter.affiliate_disclosure") %></div>
    <% end %>
  </td>
</tr>
