<% if edition.hero_url.present? %>
  <tr>
    <td>
      <img loading="lazy" src="<%= edition.hero_url %>" alt="<%= edition.hero_alt %>" width="620" class="mail-hero">
    </td>
  </tr>
  <% if edition.hero_caption.present? %>
    <tr><td class="mail-hero-caption"><%= edition.hero_caption %></td></tr>
  <% end %>
<% else %>
  <tr>
    <td class="mail-typo-hero">
      <%= tag.h1 edition.city_name %>
      <%= tag.p edition.kind == :weekly_deals ? "Curated offers" : "City letter" %>
    </td>
  </tr>
<% end %>
