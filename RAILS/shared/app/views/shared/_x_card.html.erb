<% 
  # x.com-style card component for brgen and all subapps
  # Structure: avatar + content (header + body + media + actions)
  # Usage example:
  #   render "shared/x_card", 
  #     avatar_url: "...", 
  #     name: "Name", handle: "@handle", time: "2h",
  #     title: "Main text", 
  #     meta: "location · condition",
  #     actions: capture { ... },
  #     url: path,
  #     class: "x-listing"
%>

<article class="x-post <%= local_assigns[:class] %>" <%= local_assigns[:data_attributes] || "" %>>
  <div class="x-avatar">
    <% if local_assigns[:avatar_url].present? %>
      <%= image_tag local_assigns[:avatar_url], class: "x-avatar-img", alt: local_assigns[:name] || "avatar" %>
    <% else %>
      <div class="x-avatar-placeholder"><%= (local_assigns[:name] || "?").first.upcase %></div>
    <% end %>
  </div>

  <div class="x-content">
    <div class="x-header">
      <span class="x-name">
        <% if local_assigns[:url] %>
          <%= link_to local_assigns[:name], local_assigns[:url], class: "link-inherit" %>
        <% else %>
          <%= local_assigns[:name] %>
        <% end %>
      </span>
      <% if local_assigns[:handle] %>
        <span class="x-handle"><%= local_assigns[:handle] %></span>
      <% end %>
      <% if local_assigns[:time] %>
        <span class="x-time">· <%= local_assigns[:time] %></span>
      <% end %>
    </div>

    <% if local_assigns[:title].present? %>
      <div class="x-text">
        <% if local_assigns[:url] %>
          <%= link_to local_assigns[:title], local_assigns[:url] %>
        <% else %>
          <%= local_assigns[:title] %>
        <% end %>
      </div>
    <% end %>

    <% if local_assigns[:content].present? %>
      <div class="x-body"><%= local_assigns[:content] %></div>
    <% end %>

    <% if local_assigns[:meta].present? %>
      <div class="x-meta"><%= local_assigns[:meta] %></div>
    <% end %>

    <% if local_assigns[:media].present? %>
      <div class="x-media"><%= local_assigns[:media] %></div>
    <% end %>

    <% if local_assigns[:actions].present? %>
      <div class="x-actions">
        <%= local_assigns[:actions] %>
      </div>
    <% end %>
  </div>
</article>