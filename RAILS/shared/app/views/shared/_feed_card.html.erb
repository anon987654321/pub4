<%
  # x.com-style card component for brgen and all subapps
  # Structure: avatar + content (header + body + media + actions)
  # Usage example:
  #   render "shared/feed_card",
  #     avatar_url: "...",
  #     name: "Name", handle: "@handle", time: "2h",
  #     title: "Main text",
  #     meta: "location · condition",
  #     actions: capture { ... },
  #     url: path,
  #     class: "listing"
  #
  # When `record:` is passed and `actions:` is blank, the shared action_bar is
  # rendered automatically (like / repost / reply / share). Surfaces that need
  # a richer row (e.g. posts with upvote + quote) still pass custom `actions:`.
%>

<article class="feed-card <%= local_assigns[:class] %>" <%= local_assigns[:data_attributes] || "" %>>
  <div class="feed-card-avatar">
    <% if local_assigns[:avatar_url].present? %>
      <%= image_tag local_assigns[:avatar_url], class: "feed-card-avatar-img", alt: local_assigns[:name] || "avatar", width: 40, height: 40 %>
    <% else %>
      <% monogram = (local_assigns[:name] || "?").first.upcase %>
      <div class="feed-card-avatar-placeholder monogram monogram--<%= monogram.ord % 6 %>" role="img" aria-label="<%= local_assigns[:name] || "Anonymous" %> monogram"><%= monogram %></div>
    <% end %>
  </div>

  <div class="feed-card-content">
    <div class="feed-card-header">
      <span class="feed-card-name">
        <% if local_assigns[:url] %>
          <%= link_to local_assigns[:name], local_assigns[:url], class: "link-inherit" %>
        <% else %>
          <%= local_assigns[:name] %>
        <% end %>
      </span>
      <% if local_assigns[:handle] %>
        <span class="feed-card-handle"><%= local_assigns[:handle] %></span>
      <% end %>
      <% if local_assigns[:time] %>
        <span class="feed-card-time">· <%= local_assigns[:time] %></span>
      <% end %>
    </div>

    <% if local_assigns[:title].present? %>
      <div class="feed-card-text">
        <% if local_assigns[:url] %>
          <%= link_to local_assigns[:title], local_assigns[:url] %>
        <% else %>
          <%= local_assigns[:title] %>
        <% end %>
      </div>
    <% end %>

    <% if local_assigns[:content].present? %>
      <div class="feed-card-body"><%= local_assigns[:content] %></div>
    <% end %>

    <% if local_assigns[:meta].present? %>
      <div class="feed-card-meta"><%= local_assigns[:meta] %></div>
    <% end %>

    <% if local_assigns[:media].present? %>
      <div class="feed-card-media"><%= local_assigns[:media] %></div>
    <% end %>

    <% if local_assigns[:actions].present? %>
      <div class="feed-card-actions">
        <%= local_assigns[:actions] %>
      </div>
    <% elsif local_assigns[:record].present? %>
      <%= render "shared/action_bar",
            record: local_assigns[:record],
            reply_path: local_assigns[:reply_path],
            repost_path: local_assigns[:repost_path],
            reposted: local_assigns.fetch(:reposted, false),
            repost_count: local_assigns.fetch(:repost_count, 0),
            liked: local_assigns.fetch(:liked, false),
            like_count: local_assigns.fetch(:like_count, 0),
            comment_count: local_assigns.fetch(:comment_count, 0),
            view_count: local_assigns[:view_count],
            share_url: local_assigns[:share_url] || local_assigns[:url] %>
    <% end %>
  </div>
</article>
