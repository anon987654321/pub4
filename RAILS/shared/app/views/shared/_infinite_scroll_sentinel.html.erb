<% if pagy&.next %>
  <div id="<%= local_assigns.fetch(:sentinel_id, "infinite-scroll-sentinel") %>"
       class="infinite-scroll-sentinel"
       data-controller="infinite-scroll"
       data-infinite-scroll-reflex-value="<%= reflex %>"
       data-reflex="<%= reflex %>"
       data-turbo="false"
       data-next-page="<%= pagy.next %>"
       <% if local_assigns[:sort].present? %>data-sort="<%= sort %>"<% end %>
       <% if local_assigns[:blog_id].present? %>data-blog-id="<%= blog_id %>"<% end %>
       <% if local_assigns[:q].present? %>data-q="<%= q %>"<% end %>
       <% if local_assigns[:category_id].present? %>data-category-id="<%= category_id %>"<% end %>
       <% if local_assigns[:lat].present? %>data-lat="<%= lat %>"<% end %>
       <% if local_assigns[:lng].present? %>data-lng="<%= lng %>"<% end %>
       <% if local_assigns[:radius_km].present? %>data-radius-km="<%= radius_km %>"<% end %>
       <% if local_assigns[:cuisine].present? %>data-cuisine="<%= cuisine %>"<% end %>
       <% if local_assigns[:kind].present? %>data-kind="<%= kind %>"<% end %>
       <% if local_assigns[:lifecycle].present? %>data-lifecycle="<%= lifecycle %>"<% end %>
       <% if local_assigns[:from].present? %>data-from="<%= from %>"<% end %>
       <% if local_assigns[:vertical].present? %>data-vertical="<%= vertical %>"<% end %>
       <% if local_assigns[:channel_slug].present? %>data-channel-slug="<%= channel_slug %>"<% end %>
       <% if local_assigns[:feed].present? %>data-feed="<%= feed %>"<% end %>
       <% if local_assigns[:maintainer_id].present? %>data-maintainer-id="<%= maintainer_id %>"<% end %>
       aria-live="polite">
    <%= t("status.loading_more") %>
  </div>
<% end %>
