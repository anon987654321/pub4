<%#
  Shared post card for the focus triangle (brgen + amber).

  locals:
    post        — required
    variant     — :card (default, brgen feed_card) or :prose (amber feed-post)
    name        — author display (default post_display_name)
    avatar_url  — optional
    handle      — optional @slug / community
    url         — link for name/title (default post_path if available)
    title       — headline (brgen title; optional for amber)
    content     — body HTML/text
    meta        — optional under body (outfit/item)
    media       — optional media block
    actions     — optional footer actions (capture)
    time        — optional; defaults to time_ago_in_words
    frame       — wrap in turbo_frame_tag dom_id(post) (default false)
    class       — extra classes on the article
%>
<% post = local_assigns.fetch(:post) %>
<% variant = local_assigns.fetch(:variant, :card).to_sym %>
<% name = local_assigns[:name] || post_display_name(post) %>
<% avatar_url = local_assigns.key?(:avatar_url) ? local_assigns[:avatar_url] : post_avatar_url(post) %>
<% handle = local_assigns[:handle] %>
<% title = local_assigns.key?(:title) ? local_assigns[:title] : post_title_text(post) %>
<% content = local_assigns.key?(:content) ? local_assigns[:content] : post_body_text(post) %>
<% time = local_assigns[:time] || (post.created_at ? time_ago_in_words(post.created_at) : nil) %>
<% url = local_assigns[:url] %>
<% if url.nil? && post.persisted? && respond_to?(:post_path) %>
  <% url = post_path(post) rescue nil %>
<% end %>
<% meta = local_assigns[:meta] %>
<% media = local_assigns[:media] %>
<% actions = local_assigns[:actions] %>
<% frame = local_assigns.fetch(:frame, false) %>
<% css_class = local_assigns[:class] %>

<% card = capture do %>
  <% if variant == :prose %>
    <article class="feed-post<%= " #{css_class}" if css_class.present? %>"
             role="article"
             aria-label="<%= t("post.by_author", name: name, default: "Post by %{name}") %>">
      <header class="feed-post-meta feed-post-byline">
        <span class="author">
          <% if url.present? && !(post.try(:anonymous?) || post.try(:user)&.try(:guest?)) %>
            <%= link_to name, url, class: "link-inherit" %>
          <% else %>
            <%= name %>
          <% end %>
        </span>
        <% if time.present? && post.created_at %>
          · <time datetime="<%= post.created_at.iso8601 %>"><%= time %></time>
        <% elsif time.present? %>
          · <span class="feed-post-time"><%= time %></span>
        <% end %>
      </header>
      <% if title.present? && title.to_s != content.to_s %>
        <h2 class="feed-post-title"><%= url.present? ? link_to(title, url) : title %></h2>
      <% end %>
      <% if content.present? %>
        <div class="feed-post-body feed-post-prose prose"><%= content %></div>
      <% end %>
      <% if meta.present? %>
        <div><%= meta %></div> <%# scan: intentional — the caller-supplied meta slot; its content names itself %>
      <% end %>
      <% if media.present? %>
        <div class="feed-post-media"><%= media %></div>
      <% end %>
      <% if actions.present? %>
        <footer class="feed-post-actions"><%= actions %></footer>
      <% end %>
    </article>
  <% else %>
    <%# Card dialect: title line is title, or body when no title (amber-style). %>
    <% card_title = title.presence || content %>
    <% card_body = title.present? ? content : nil %>
    <%= render "shared/feed_card",
          avatar_url: avatar_url,
          name: name,
          handle: handle,
          time: time,
          title: card_title,
          content: card_body,
          meta: meta,
          media: media,
          actions: actions,
          record: (post if actions.blank?),
          reply_path: local_assigns[:reply_path],
          repost_path: local_assigns[:repost_path],
          reposted: local_assigns.fetch(:reposted, false),
          repost_count: local_assigns.fetch(:repost_count, 0),
          liked: local_assigns.fetch(:liked, false),
          like_count: local_assigns.fetch(:like_count, 0),
          comment_count: local_assigns.fetch(:comment_count, 0),
          view_count: local_assigns[:view_count],
          share_url: local_assigns[:share_url] || url,
          url: url,
          class: [ "feed-card", css_class ].compact.join(" ") %>
  <% end %>
<% end %>

<% if frame && post.persisted? %>
  <%= turbo_frame_tag dom_id(post), target: "_top" do %>
    <%= card %>
  <% end %>
<% else %>
  <%= card %>
<% end %>
