<% post = local_assigns.fetch(:post) %>
<% prompt_id = "post-auth-prompt-#{dom_id(post)}" %>
<span class="post-auth-prompt-host">
  <button type="button"
          class="post-auth-prompt-trigger"
          popovertarget="<%= prompt_id %>"
          popovertargetaction="toggle"
          aria-controls="<%= prompt_id %>">
    <%= t("post.auth_prompt_trigger") %>
  </button>

  <section id="<%= prompt_id %>" class="post-auth-prompt" popover
           aria-label="<%= t("post.auth_prompt_title") %>">
    <h2><%= t("post.auth_prompt_title") %></h2>
    <p><%= t("post.auth_prompt_body") %></p>
    <div class="post-auth-prompt-actions">
      <%= link_to t("nav.sign_in"), new_session_path, class: "btn btn-primary" %>
      <%= link_to t("auth.create_account"), new_registration_path, class: "btn btn-ghost" %>
    </div>
    <p class="post-auth-prompt-note"><%= t("post.auth_prompt_note") %></p>
  </section>
</span>
