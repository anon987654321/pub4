<dialog class="newsletter-capture"
         data-controller="newsletter-capture"
         data-newsletter-capture-delay-value="12000"
         data-action="click->newsletter-capture#backdropClose"
         aria-labelledby="newsletter-capture-title"
         aria-describedby="newsletter-capture-lede">
  <button type="button"
          class="newsletter-capture-close"
          data-action="newsletter-capture#close"
          aria-label="<%= t("newsletter_popup.close") %>">×</button>

  <div class="newsletter-capture-art" aria-hidden="true">
    <% if local_assigns[:artwork_url].present? %>
      <%= image_tag local_assigns[:artwork_url], alt: "", loading: "eager", decoding: "async" %>
    <% else %>
      <span>B</span>
    <% end %>
  </div>

  <div class="newsletter-capture-copy">
    <p class="newsletter-capture-kicker"><%= t("newsletter_popup.kicker") %></p>
    <h2 id="newsletter-capture-title"><%= t("newsletter_popup.title") %></h2>
    <p id="newsletter-capture-lede"><%= t("newsletter_popup.lede") %></p>
    <p class="newsletter-capture-reward"><%= t("newsletter_popup.reward") %></p>

    <%= form_with url: email_subscriptions_path, method: :post, scope: :email_subscription,
          data: { action: "submit->newsletter-capture#remember" } do |form| %>
      <%= hidden_field_tag "email_subscription[city]", local_assigns.fetch(:city, nil) %>
      <%= hidden_field_tag "email_subscription[agreed_to_marketing]", "1" %>
      <div class="newsletter-capture-field">
        <%= form.email_field :email,
              placeholder: t("newsletter.email_placeholder"),
              aria: { label: t("newsletter_popup.email_label") },
              autocomplete: "email",
              inputmode: "email",
              required: true,
              data: { newsletter_capture_target: "email" } %>
      </div>
      <p class="newsletter-capture-consent"><%= t("newsletter_popup.consent") %></p>
      <div class="newsletter-capture-actions">
        <%= form.submit t("newsletter_popup.submit") %>
        <button type="button" data-action="newsletter-capture#close"><%= t("newsletter_popup.not_now") %></button>
      </div>
    <% end %>
  </div>
</dialog>
