<% content_for :title, t("legal.privacy") %>
<% contact = legal_contact_email %>
<% social = legal_social_network? %>
<% amber = legal_app_key == "amber" %>

<article class="legal-prose">
  <p class="legal-eyebrow"><%= t("legal.privacy_page.eyebrow") %></p>
  <h1><%= t("legal.privacy_page.heading", host: request.host) %></h1>
  <p class="legal-updated"><%= t("legal.updated_on") %></p>

  <p><%= t("legal.privacy_page.intro_html", contact: mail_to(contact)) %></p>

  <%= tag.h2 t("legal.privacy_page.collect_heading") %>
  <ul>
    <li><%= t("legal.privacy_page.account_item_html") %></li>
    <% if social %>
      <li><%= t("legal.privacy_page.content_item_html",
                wardrobe: amber ? t("legal.privacy_page.content_wardrobe_clause") : "") %></li>
    <% else %>
      <li><%= t("legal.privacy_page.activity_item_html") %></li>
    <% end %>
    <li><%= t("legal.privacy_page.technical_item_html") %></li>
    <% if social %>
      <li><%= t("legal.privacy_page.fingerprint_item_html") %></li>
      <li><%= t("legal.privacy_page.location_item_html") %></li>
    <% end %>
  </ul>

  <% if social %>
    <%= tag.h2 t("legal.privacy_page.ads_heading") %>
    <p><%= t("legal.privacy_page.ads_body_html",
             cookies: link_to(t("legal.privacy_page.ads_cookies_link"), cookies_path)) %></p>
  <% end %>

  <%= tag.h2 t("legal.privacy_page.basis_heading") %>
  <p><%= t("legal.privacy_page.basis_body",
           location: social ? t("legal.privacy_page.basis_location_clause") : "") %></p>

  <%= tag.h2 t("legal.privacy_page.rights_heading") %>
  <p><%= t("legal.privacy_page.rights_body") %></p>

  <%= tag.h2 t("legal.privacy_page.storage_heading") %>
  <p><%= t("legal.privacy_page.storage_body") %></p>

  <nav>
    <%= link_to t("legal.terms"), terms_path %>
    <%= link_to t("legal.cookies"), cookies_path %>
  </nav>
</article>
