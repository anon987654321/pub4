<% content_for :title, t("legal.cookies") %>
<% social = legal_social_network? %>

<article class="legal-prose">
  <p class="legal-eyebrow"><%= t("legal.cookies_page.eyebrow") %></p>
  <h1><%= t("legal.cookies_page.heading", host: request.host) %></h1>
  <p class="legal-updated"><%= t("legal.updated_on") %></p>

  <p><%= t("legal.cookies_page.intro_html") %></p>

  <%= tag.h2 t("legal.cookies_page.necessary_heading") %>
  <p><%= t("legal.cookies_page.necessary_body") %></p>

  <% if social %>
    <%= tag.h2 t("legal.cookies_page.fingerprint_heading") %>
    <p><%= t("legal.cookies_page.fingerprint_body") %></p>

    <%= tag.h2 t("legal.cookies_page.partner_heading") %>
    <p><%= t("legal.cookies_page.partner_body") %></p>

    <%= tag.h2 t("legal.cookies_page.advertising_heading") %>
    <p><%= t("legal.cookies_page.advertising_body_html") %></p>
  <% end %>

  <%= tag.h2 t("legal.cookies_page.control_heading") %>
  <p><%= t("legal.cookies_page.control_body",
           partner: social ? t("legal.cookies_page.control_partner_clause") : "") %></p>

  <nav>
    <%= link_to t("legal.privacy"), privacy_path %>
    <%= link_to t("legal.terms"), terms_path %>
  </nav>
</article>
