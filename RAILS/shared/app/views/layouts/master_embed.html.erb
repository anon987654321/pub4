<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover" %>
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#000000">
  <title><%= master_embed_title %></title>
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/styles/master_embed.css">
</head>
<body>
  <a class="skip-link" href="#main-content"><%= t("skip_to_content", default: "Skip to main content") %></a>
  <iframe
    class="master-embed-frame"
    src="<%= master_web_url(autostart: true, embed: true) %>"
    title="MASTER"
    allow="microphone; autoplay; encrypted-media; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    loading="eager"></iframe>
  <%= yield %>
</body>
</html>
