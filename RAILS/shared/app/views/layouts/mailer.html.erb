<!DOCTYPE html>
<html lang="<%= @edition&.locale || "en" %>" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="x-apple-disable-message-reformatting">
  <%# `||` binds tighter than `?:`, so this read as (a || b || content_for?) ? yield(:title) : "Newsletter" —
      it always yielded :title when any source was present, discarding @edition.subject and @subject. %>
  <title><%= @edition&.subject || @subject || (content_for?(:title) ? yield(:title) : "Newsletter") %></title>
  <% if @edition&.preheader.present? %>
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;"> <%# scan: intentional — the preheader; mail clients load no bundle %>
      <%= @edition.preheader %>
    </div>
  <% end %>
  <%= render "layouts/mailer_styles" %>
</head>
<body class="mail-body">
  <a class="skip-link" href="#main-content"><%= t("a11y.skip_to_content", default: "Skip to main content") %></a>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mail-canvas">
    <tr>
      <td align="center">
        <%= yield %>
      </td>
    </tr>
  </table>
</body>
</html>
