<div class="auth-form">
  <h1><%= t("pages.two_factor", default: "Two-factor authentication") %></h1>
  <p class="auth-form-lead">Scan the QR code or enter the secret in your authenticator app.</p>

  <% if @qr.present? %>
    <div class="auth-form-qr"><%= @qr.html_safe %></div>
  <% end %>

  <%= form_with url: two_factor_setup_path, method: :post do |f| %>
    <div class="field">
      <%= f.label :code, "Verification code" %>
      <%= f.text_field :code, autocomplete: "one-time-code", required: true %>
    </div>
    <div class="actions">
      <%= f.submit "Enable 2FA", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
