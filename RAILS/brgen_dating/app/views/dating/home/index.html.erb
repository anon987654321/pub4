<% content_for :title, t("dating.home_title") %>

<div class="dating-app">
  <header class="dating-page-intro">
    <hgroup>
      <p><%= t("dating.local") %></p>
      <h1><%= t("dating.discover") %></h1>
      <p><%= t("dating.home_blurb") %></p>
    </hgroup>
    <%# One action shows: making the profile while there is none, the matches
        after. Up to six more pills wrapped into a ragged second row beside the
        heading at 1440, so the rest sit behind one «Mer». %>
    <% needs_profile = Current.user.present? && Current.user.dating_profile.blank? %>
    <nav aria-label="<%= t("dating.home_title") %>">
      <% if needs_profile %>
        <%= link_to t("dating.create_profile"), new_profile_path, class: "button button-primary" %>
      <% else %>
        <%= link_to t("dating.matches"), matches_path, class: "button" %>
      <% end %>
      <details>
        <summary class="button button-ghost"><%= t("dating.more") %></summary>
        <div class="swipe-overflow-menu">
          <%= button_to t("dating.rewind"), rewind_path, method: :post, class: "button button-ghost" %>
          <% if needs_profile %>
            <%= link_to t("dating.matches"), matches_path, class: "button button-ghost" %>
          <% end %>
          <% if Current.user.present? %>
            <%= link_to t("dating.who_liked_you"), likes_path, class: "button button-ghost" %>
            <%= link_to t("dating.picks_title"), picks_path, class: "button button-ghost" %>
            <%= link_to t("dating.path_crossings_title"), path_crossings_path, class: "button button-ghost" %>
          <% end %>
          <% if Current.user&.dating_profile.present? && Current.user.dating_profile.verified_at.nil? %>
            <%= link_to t("dating.verify_title"), new_verification_path, class: "button button-ghost" %>
          <% end %>
          <% if Current.user&.dating_profile.present? %>
            <%= link_to t("dating.edit_profile"), edit_profile_path, class: "button button-ghost" %>
          <% end %>
        </div>
      </details>
    </nav>
  </header>

  <section class="dating-discover-panel">
    <turbo-frame id="dating-discover" data-turbo-action="replace">
      <section
        data-controller="swipe"
        data-swipe-like-url-value="<%= likes_path %>"
        data-swipe-dislike-url-value="<%= dislikes_path %>"
        data-action="pointerdown->swipe#pointerDown pointermove->swipe#pointerMove pointerup->swipe#pointerUp
                     pointercancel->swipe#pointerUp keydown.left@window->swipe#pass keydown.right@window->swipe#like"
        class="dating-discover"
      >
        <%# The card leaves the deck silently; this says what the choice was. %>
        <p class="visually-hidden" role="status" aria-live="polite" data-swipe-target="announcement"
           data-liked="<%= t("dating.announce_liked") %>" data-passed="<%= t("dating.announce_passed") %>"></p>
        <div id="swipe-stack">
          <% @profiles.each_with_index do |profile, index| %>
            <%= render "card", profile: profile, index: index %>
          <% end %>
        </div>
        <% if @profiles.empty? %>
          <%# Soft guests can like/dislike (require_user_session) — do not auth-wall discover. %>
          <%= render "shared/empty_state",
                title: t("empty.no_nearby"),
                body: t("dating.empty_nearby_body"),
                action: Current.user&.dating_profile.present? ?
                  { label: t("dating.edit_profile"), path: edit_profile_path } :
                  { label: t("dating.create_profile"), path: new_profile_path } %>
        <% end %>
        <turbo-frame id="dating-next" src="<%= next_path %>" loading="lazy" hidden></turbo-frame>
      </section>
    </turbo-frame>
  </section>
</div>
