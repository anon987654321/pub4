<% display_name = profile.user&.display_name.presence || t("chat.anon") %>
<% first_prompt = profile.prompts.min_by { |prompt| [prompt.position.to_i, prompt.id] } %>
<article
  class="swipe-card swipe-card--stack-<%= index %>"
  data-user-id="<%= profile.user_id %>"
  data-name="<%= display_name %>"
>
  <div class="swipe-photo">
    <% if profile.photos.attached? %>
      <%= lazy_image_tag profile.photos.first, alt: display_name, blurhash: profile.photos.first.try(:metadata).try(:[], "blurhash") %>
    <% else %>
      <div class="swipe-placeholder">
        <%= display_name.to_s.first.upcase %>
      </div>
    <% end %>
    <span class="swipe-stamp swipe-stamp--like" aria-hidden="true"><%= t("dating.stamp_like") %></span>
    <span class="swipe-stamp swipe-stamp--pass" aria-hidden="true"><%= t("dating.stamp_pass") %></span>
    <%# The age follows the name with no whitespace between them, or the
        comma lands one space away from the name it belongs to. %>
    <header class="swipe-caption">
      <%= tag.h2 class: "swipe-name" do %>
        <%= display_name %><%= tag.span(", #{profile.age}", class: "swipe-age") if profile.age %>
      <% end %>
      <% places = [profile.location, profile.neighborhood&.name].compact_blank %>
      <% if places.any? %>
        <%= tag.p safe_join(places.map { |place| tag.span(place) }), class: "swipe-location" %>
      <% end %>
      <%= tag.p t(profile.recency_key), class: "swipe-recency" %>
      <%= tag.span t("dating.verified"), class: "chip" if profile.verified_at %>
    </header>
  </div>

  <div class="swipe-body">
    <% if profile.bio.present? %>
      <%= read_more(profile.bio, lines: 3, more: t("dating.read_bio"), less: t("dating.show_less")) %>
    <% end %>
    <% if first_prompt %>
      <p class="swipe-prompt">
        <%= first_prompt.question_text %>
        <%= first_prompt.answer %>
      </p>
    <% end %>
    <ul class="swipe-traits">
      <%= tag.li profile.gender_label if profile.gender.present? %>
      <%= tag.li "#{t("dating.looking_for")} #{profile.looking_for_label}" if profile.looking_for.present? %>
    </ul>
    <% if Current.user.present? && Current.user != profile.user %>
      <details class="swipe-overflow">
        <summary aria-label="<%= t("dating.more") %>"><%= icon :more, size: 18 %></summary>
        <div class="swipe-overflow-menu">
          <%= render "shared/report_button", target: profile.user, reason: nil %>
          <% if Current.user.blocking?(profile.user) %>
            <%# destructive: no-confirm-ok — reversible — the button becomes Block again in place %>
            <%= button_to t("block.unblock"), main_app.unblock_user_path(profile.user), method: :delete, class: "button button-ghost button-small" %>
          <% else %>
            <%= button_to t("block.block"), main_app.block_user_path(profile.user), method: :post, class: "button button-ghost button-small" %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <% if Current.user.present? %>
    <div class="swipe-actions">
      <%= button_tag "✕", type: "button", class: "swipe-action swipe-action--pass", title: t("dating.pass"), aria: { label: t("dating.pass") }, data: { controller: "haptics", action: "click->swipe#pass click->haptics#warning" } %>
      <%= button_to rewind_path, method: :post, class: "swipe-action swipe-action--rewind", title: t("dating.rewind"), aria: { label: t("dating.rewind") }, data: { controller: "haptics", action: "click->haptics#tick" } do %>
        ↺
      <% end %>
      <%= button_tag "♥", type: "button", class: "swipe-action swipe-action--like", title: t("actions.like"), aria: { label: t("actions.like") }, data: { controller: "haptics", action: "click->swipe#like click->haptics#tick" } %>
    </div>
  <% else %>
    <p class="swipe-signin"><%= t("dating.swipe_guest") %></p>
  <% end %>
</article>
