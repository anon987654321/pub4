<% content_for :title, t("dating.who_liked_you") %>

<div class="page-header">
  <%= tag.h1 t("dating.who_liked_you") %>
  <%= link_to t("dating.back_to_deck"), root_path, class: "button button-ghost button-small" %>
</div>

<% if @likes.any? %>
  <%# A separate page rather than folded into the deck: people who have already
      said yes are a different decision from people who have not seen you. %>
  <ul class="like-list" role="list">
    <% @likes.each do |like| %>
      <% profile = like.liker.dating_profile %>
      <% name = profile&.name || like.liker.display_name %>
      <li class="like-card">
        <% if profile&.photos&.attached? %>
          <%= lazy_image_tag profile.photos.first, alt: name, class: "photo-thumb" %>
        <% end %>
        <%# The age follows the name as it does on the deck card, comma and all. %>
        <p>
          <%= tag.strong name %><%= tag.span(", #{profile.age}", class: "like-age") if profile&.age %>
        </p>

        <%# The comment is the whole point of the Hinge interaction: it says
            what they liked, so the reply has somewhere to start. %>
        <% if like.commented? %>
          <% if like.dating_prompt %>
            <p><%= like.dating_prompt.question_text %></p>
            <p><%= tag.em like.dating_prompt.answer %></p>
          <% end %>
          <blockquote class="like-comment"><%= like.comment %></blockquote>
        <% end %>

        <div class="cluster">
          <%= button_to t("dating.like_back"), likes_path(user_id: like.liker_id),
                method: :post, class: "button button-primary button-small" %>
          <%= button_to t("dating.pass"), dislikes_path(user_id: like.liker_id),
                method: :post, class: "button button-ghost button-small" %>
        </div>
        <%# The same report and block the deck card offers. %>
        <details class="swipe-overflow">
          <summary aria-label="<%= t("dating.more") %>"><%= icon :more, size: 18 %></summary>
          <div class="swipe-overflow-menu">
            <%= render "shared/report_button", target: like.liker, reason: nil %>
            <% if @blocked_ids.include?(like.liker_id) %>
              <%# destructive: no-confirm-ok — reversible — the button becomes Block again in place %>
              <%= button_to t("block.unblock"), main_app.unblock_user_path(like.liker), method: :delete,
                    class: "button button-ghost button-small" %>
            <% else %>
              <%= button_to t("block.block"), main_app.block_user_path(like.liker), method: :post,
                    class: "button button-ghost button-small" %>
            <% end %>
          </div>
        </details>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("dating.no_likes_title"),
        body: t("dating.no_likes_body"),
        action: { label: t("dating.back_to_deck"), path: root_path } %>
<% end %>
