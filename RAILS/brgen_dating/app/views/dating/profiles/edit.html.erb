<% content_for :title, t("dating.edit_profile") %>

<div class="page-header">
  <%= tag.h1 t("dating.edit_profile") %>
  <p><%= t("dating.edit_profile_blurb") %></p>
</div>

<div class="form-wrap dating-profile-form">
  <% draft_key = "brgen-dating-profile-#{@profile.to_param || 'edit'}" %>
  <%= form_with(model: @profile, url: profile_path, method: :patch, data: { controller: "draft-store autosave", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: main_app.draft_path(draft_key)) }) do |f| %>
    <%= render "shared/errors", object: @profile %>

    <fieldset class="dating-profile-essentials">
      <legend class="visually-hidden"><%= t("dating.essentials") %></legend>
      <% if @profile.photos.attached? %>
        <div class="field">
          <%= t("dating.current_photos") %>
          <div class="photo-strip">
            <% @profile.photos.each do |photo| %>
              <label class="photo-thumb-wrap">
                <%= lazy_image_tag photo, alt: t("dating.profile_photo"), class: "photo-thumb" %>
                <%= check_box_tag "#{f.object_name}[remove_photo_ids][]", photo.id, false, id: dom_id(photo, :remove) %>
                <%= t("actions.remove") %>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="field">
        <%= f.label :photos, t("dating.add_photos") %>
        <%= f.file_field :photos, multiple: true, accept: "image/*", direct_upload: true, data: { controller: "direct-upload" } %>
      </div>
      <div class="field">
        <%= f.label :bio, t("dating.about_you") %>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
          <div class="compose-surface" data-controller="tiptap-editor">
            <%= f.text_area :bio, rows: 4, maxlength: 500,
                  data: { character_counter_target: "input", tiptap_editor_target: "field" } %>
            <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
            <%= render "shared/tiptap_toolbar" %>
          </div>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
      </div>
      <div class="field">
        <%= f.label :looking_for, t("dating.looking_for") %>
        <%= f.select :looking_for, Dating::Profile.looking_for_options, { include_blank: "—" } %>
      </div>
      <div class="field"><%= f.label :age, t("dating.age") %><%= f.number_field :age, min: 18, max: 99, required: true, inputmode: "numeric" %></div>
      <p><%= t("legal.dating_age") %></p>
    </fieldset>

    <details class="dating-profile-more">
      <summary><%= t("dating.more_details") %></summary>
      <div class="field"><%= f.label :gender, t("dating.gender") %><%= f.select :gender, Dating::Profile.gender_options, { include_blank: "—" } %></div>
      <div class="field"><%= f.label :location, t("dating.location") %><%= f.text_field :location %></div>
      <div class="field">
        <%= f.label :neighborhood_id, t("dating.neighborhood") %>
        <%= f.select :neighborhood_id, @neighborhoods.map { |n| [n.name, n.id] }, { include_blank: "—" } %>
      </div>
      <div class="field field--check"><%= f.check_box :visible %><%= f.label :visible, t("dating.visible_label") %></div>
      <div class="field field--check"><%= f.check_box :location_discovery_enabled %><%= f.label :location_discovery_enabled, t("dating.path_crossings_consent") %></div>
      <p class="form-help"><%= t("dating.path_crossings_privacy") %></p>
    </details>

    <div class="field">
      <%= f.submit t("dating.save"), class: "button button-primary" %>
      <span data-autosave-target="status" aria-live="polite"></span>
    </div>
  <% end %>
</div>

<section class="dating-prompts" aria-labelledby="dating-prompts-heading">
  <%= tag.h2 t("dating.prompts_heading"), id: "dating-prompts-heading" %>
  <%= tag.p t("dating.prompts_blurb", count: Dating::Prompt::MAX_PER_PROFILE) %>
  <% if @prompts.any? %>
    <ul class="dating-prompt-list">
      <%= render partial: "prompt", collection: @prompts %>
    </ul>
  <% end %>
  <% if @unanswered_questions %>
    <%= form_with(scope: :prompt, url: profile_prompts_path, class: "dating-prompt-form") do |f| %>
      <div class="field">
        <%= f.label :question, t("dating.prompt_question") %>
        <%= f.select :question, @unanswered_questions, {}, required: true %>
      </div>
      <div class="field">
        <%= f.label :answer, t("dating.prompt_answer") %>
        <%= f.text_area :answer, rows: 2, maxlength: 255, required: true %>
      </div>
      <%= f.hidden_field :position, value: @prompts.size %>
      <%= f.submit t("dating.add_prompt"), class: "button button-primary" %>
    <% end %>
  <% end %>
</section>
