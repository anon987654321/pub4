<% content_for :title, t("dating.path_crossings_title") %>

<div class="dating-app">
  <header class="dating-page-intro">
    <div>
      <p><%= t("dating.local") %></p>
      <h1><%= t("dating.path_crossings_title") %></h1>
      <p><%= t("dating.path_crossings_intro") %></p>
    </div>
    <nav aria-label="<%= t("dating.path_crossings_title") %>">
      <%= link_to t("dating.discover"), dating.root_path, class: "btn btn-ghost" %>
      <%= link_to t("dating.edit_profile"), edit_profile_path, class: "btn btn-ghost" %>
    </nav>
  </header>

  <% if @location_enabled %>
    <section class="dating-discover-panel" aria-labelledby="crossed-paths-locate-heading"
             data-controller="dating-location"
             data-dating-location-url-value="<%= locate_path_crossings_path %>">
      <h2 id="crossed-paths-locate-heading"><%= t("dating.path_crossings_check_in") %></h2>
      <p><%= t("dating.path_crossings_check_in_hint") %></p>
      <button type="button" class="btn btn-primary" data-action="dating-location#locate">
        <%= t("dating.path_crossings_locate") %>
      </button>
      <p role="status" aria-live="polite" data-dating-location-target="status"></p>
    </section>

    <section class="section-divider" aria-label="<%= t("dating.path_crossings_title") %>">
      <% if @crossings.any? %>
        <% neighborhood_names = Neighborhood.where(id: @crossings.filter_map(&:neighborhood_id)).pluck(:id, :name).to_h %>
        <% @crossings.each do |crossing| %>
          <% profile = @profiles_by_user_id[crossing.other_user_id(Current.user.id)] %>
          <% next unless profile %>
          <article class="dating-crossing">
            <% if profile.photos.attached? %>
              <%= lazy_image_tag profile.photos.first, alt: t("dating.profile_photo"), class: "photo-thumb" %>
            <% end %>
            <div>
              <h2><%= profile.name %></h2>
              <p><%= neighborhood_names[crossing.neighborhood_id] || t("dating.path_crossings_approximate_area") %> · <%= time_ago_in_words(crossing.crossed_at) %></p>
              <%= button_to t("dating.like"), likes_path, params: { user_id: profile.user_id }, method: :post, class: "btn btn-primary btn-sm" %>
            </div>
          </article>
        <% end %>
      <% else %>
        <%= render "shared/empty_state",
              title: t("dating.path_crossings_empty_title"),
              body: t("dating.path_crossings_empty_body"),
              action: { label: t("dating.discover"), path: dating.root_path } %>
      <% end %>
    </section>
  <% else %>
    <%= render "shared/empty_state",
          title: t("dating.path_crossings_enable_title"),
          body: t("dating.path_crossings_enable_body"),
          action: { label: t("dating.edit_profile"), path: edit_profile_path } %>
  <% end %>
</div>
