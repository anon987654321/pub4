<% content_for :title, t("dating.verify_queue") %>

<div class="page-header">
  <%= tag.h1 t("dating.verify_queue") %>
</div>

<% if @verifications.any? %>
  <ul role="list" class="verify-queue">
    <% @verifications.each do |verification| %>
      <li role="listitem">
        <p><%= verification.profile.user&.display_name %> — <%= t("dating.poses.#{verification.pose}") %></p>
        <% if verification.selfie.attached? %>
          <%= lazy_image_tag verification.selfie, alt: t("dating.selfie_of", name: verification.profile.user&.display_name.presence || t("chat.anon")), width: 320, height: 320 %>
        <% end %>
        <div class="order-actions">
          <%= button_to t("dating.verify_approve"), verification_path(verification, decision: "approve"), method: :patch, class: "button button-small" %>
          <%# The note is what the rejected person is told, in place of the generic line. %>
          <%= form_with url: verification_path(verification), method: :patch, class: "verification-reject" do |form| %>
            <%= hidden_field_tag :decision, "reject", id: nil %>
            <%= form.label :note, t("dating.verify_reject_note"), for: "verification_note_#{verification.id}" %>
            <%= form.text_field :note, id: "verification_note_#{verification.id}", maxlength: 500 %>
            <%= form.submit t("dating.verify_reject"), class: "button button-ghost" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <%# empty_state: no-action-ok — a cleared verification queue is the goal state, not a dead end %>
  <%= render "shared/empty_state", title: t("dating.verify_queue_empty"), body: t("dating.verify_queue_empty_body") %>
<% end %>
