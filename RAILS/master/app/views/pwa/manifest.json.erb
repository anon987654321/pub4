<%#
  The one manifest. public/manifest.json held this content as a static file,
  and a file in public/ is served before the router reaches this template, so
  pwa#manifest and this view answered nothing -- the richer static copy won
  every request while this one drifted. Deleting the file is what makes the
  route real, and the route is what lets the manifest vary by host.
  The colour is emitted raw: ActionView HTML-escapes every template, which
  turns the JSON string's quotes into &quot; and the manifest into invalid JSON.
%><% theme_color = Master.tokens.fetch("face_root").fetch("face_bg") %>{
  "name": <%= raw t("pwa.name").to_json %>,
  "short_name": <%= raw t("pwa.name").to_json %>,
  "description": <%= raw t("pwa.description").to_json %>,
  "lang": <%= raw I18n.locale.to_s.to_json %>,
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "window-controls-overlay", "standalone"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "orientation": "any",
  "background_color": <%= raw theme_color.to_json %>,
  "theme_color": <%= raw theme_color.to_json %>,
  "icons": [
    { "src": "/icon.svg", "sizes": "any",     "type": "image/svg+xml" },
    { "src": "/icon.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": <%= raw t("pwa.chat").to_json %>, "short_name": <%= raw t("pwa.chat").to_json %>,
      "url": "/", "description": <%= raw t("pwa.chat_description").to_json %> },
    { "name": <%= raw t("pwa.focus").to_json %>, "short_name": <%= raw t("pwa.focus_short").to_json %>,
      "url": "/?focus=1", "description": <%= raw t("pwa.focus_description").to_json %> },
    { "name": <%= raw t("pwa.mission").to_json %>, "short_name": <%= raw t("pwa.mission_short").to_json %>,
      "url": "/dashboard", "description": <%= raw t("pwa.mission_description").to_json %> }
  ]
}
