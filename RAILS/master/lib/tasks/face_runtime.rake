# frozen_string_literal: true

require "digest"

namespace :assets do
  desc "Build public/face.runtime.js as a small local loader for the authoritative face sources"
  task build_face_runtime: :environment do
    out = Rails.root.join("public/face.runtime.js")
    segments = (1..3).map { |part| "face.part#{part}.txt" }
    segments << "face_speech_runtime.js"
    segments << "face_speech_playback.js"
    segments << "face.part5.txt"

    segments.each do |name|
      path = Rails.root.join("public", name)
      raise "missing #{path}" unless File.file?(path)
    end

    # The runtime fetches each part with force-cache, and the server marks them cacheable for a
    # year, so a part is named by the digest of its content: an edited part is a new URL.
    versioned = segments.map do |name|
      "#{name}?v=#{Digest::SHA256.file(Rails.root.join("public", name)).hexdigest[0, 10]}"
    end

    source = [
      "// Generated by rails assets:build_face_runtime — do not edit by hand.",
      "// Import map + MASTER_ASSET_PATHS resolve tail module imports at runtime.",
      # One source per line, so a rebuild changes only the lines whose digest moved.
      "const FACE_RUNTIME_SOURCES = [",
      versioned.map { |name| "  #{name.inspect}" }.join(",\n"),
      "];",
      'const FACE_RUNTIME_URL = (name) => new URL(name, document.baseURI).href;',
      'const FACE_RUNTIME_FETCH = (name) => fetch(FACE_RUNTIME_URL(name), { cache: "force-cache" }).then((response) => {',
      '  if (!response.ok) throw new Error("failed to load face source " + name + ": " + response.status);',
      "  return response.text();",
      "});",
      'const FACE_RUNTIME_SOURCE_BLOB = await Promise.all(FACE_RUNTIME_SOURCES.map(FACE_RUNTIME_FETCH)).then((sources) => new Blob([sources.join("\\n")], { type: "text/javascript" }));',
      "const FACE_RUNTIME_BLOB_URL = URL.createObjectURL(FACE_RUNTIME_SOURCE_BLOB);",
      "try {",
      "  await import(FACE_RUNTIME_BLOB_URL);",
      "} finally {",
      "  URL.revokeObjectURL(FACE_RUNTIME_BLOB_URL);",
      "}",
      "",
    ].join("\n")

    File.write(out, source)
    puts "wrote #{out} (#{File.size(out)} bytes)"
  end

  # The face plays the startup sound MASTER renders for the terminal, so both surfaces share one score.
  # The file is generated and uncommitted (.gitignore). Its name carries the score's cache key, and the
  # page asks for the current key only, so an older render is never served. Without ffmpeg the face
  # stays quiet, which is all a missing startup sound costs.
  desc "Render the web startup sound into public/ as Ogg Opus"
  task build_boot_sound: :environment do
    sound = Master::Voice::BootSound
    out = Rails.root.join("public", sound.asset_name)

    next puts("boot sound: #{out.basename} is current") if File.size?(out)
    next warn("boot sound: no ffmpeg on PATH, the face stays quiet") unless Master::Io::Exec.on_path?("ffmpeg")

    wav = sound.ensure_wav(surface: :web)
    log, status = Master::Io::Exec.capture2e("ffmpeg", "-loglevel", "error", "-y", "-i", wav, "-c:a", "libopus",
                                             "-b:a", "64k", "-ar", "48000", out.to_s, timeout: 60)
    next warn("boot sound: ffmpeg failed, the face stays quiet: #{log}") unless status&.success?

    puts "wrote #{out} (#{File.size(out)} bytes)"
  end
end

if Rake::Task.task_defined?("assets:precompile")
  Rake::Task["assets:precompile"].enhance([ "assets:build_face_runtime", "assets:build_boot_sound" ])
end
