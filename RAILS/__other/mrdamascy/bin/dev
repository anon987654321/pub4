#!/usr/bin/env bash

# Start web and Solid Queue side by side (overmind preferred, foreman fallback).

if ! command -v overmind &> /dev/null && ! command -v foreman &> /dev/null; then
  echo "Install overmind or foreman to run multiple processes." >&2
  exit 1
fi

if command -v overmind &> /dev/null; then
  overmind start -f Procfile.dev "$@"
else
  foreman start -f Procfile.dev "$@"
fi
