#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

WEB = File.expand_path("..", __dir__)
FACE_BOOT = File.join(WEB, "test/face_boot.test.mjs")
SSE_CONTRACT = File.join(WEB, "test/sse_contract.test.mjs")
PROBE_FACE = File.join(WEB, "script/probe_face")
PROBE_PRIMER = File.join(WEB, "script/probe_primer_external.rb")
PROBE_CHAT_E2E = File.join(WEB, "script/probe_chat_e2e.rb")
PROBE_WEBGL_GUARD = File.join(WEB, "script/probe_webgl_guard.mjs")
WEB_URL = ENV["WEB_URL"].to_s.strip

checks = []

out, err, status = Open3.capture3("node", "--test", FACE_BOOT, SSE_CONTRACT, chdir: WEB)
checks << ["face_boot + sse_contract node tests", status.success?, [out, err].join.strip]

runtime = File.join(WEB, "public/face.runtime.js")
checks << ["face.runtime.js present", File.file?(runtime), runtime]

bundle = File.join(WEB, "public/face.modules.bundle.js")
checks << ["face.modules.bundle.js present", File.file?(bundle), bundle]

skip_browser = ENV["PROBE_SKIP_BROWSER"] == "1" ||
  (RUBY_PLATFORM.include?("darwin") && ENV["PROBE_FORCE_BROWSER"] != "1")
chrome = [
  ENV["CHROME_PATH"],
  "/usr/local/bin/chromium",
  "/usr/local/bin/chrome",
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
].compact.find { |path| File.executable?(path) }
if skip_browser || chrome.nil?
  reason = if ENV["PROBE_SKIP_BROWSER"] == "1"
             "PROBE_SKIP_BROWSER=1"
           elsif RUBY_PLATFORM.include?("darwin") && ENV["PROBE_FORCE_BROWSER"] != "1"
             "macOS — set PROBE_FORCE_BROWSER=1 for Ferrum"
           else
             "no Chrome executable"
           end
  checks << ["probe_webgl_guard (skipped)", true, reason]
else
  out, err, status = Open3.capture3("env", "CHROME_PATH=#{chrome}", "node", PROBE_WEBGL_GUARD, chdir: WEB)
  checks << ["probe_webgl_guard", status.success?, [out, err].join.strip]
end

probe_http = File.join(WEB, "script/probe_http")
if WEB_URL.empty?
  checks << ["probe_http (skipped)", true, "set WEB_URL to run HTTP probe"]
  checks << ["probe_face (skipped)", true, "set WEB_URL to run browser probe"]
else
  out, err, status = Open3.capture3("env", "WEB_URL=#{WEB_URL}", "ruby", probe_http, chdir: WEB)
  checks << ["probe_http #{WEB_URL}", status.success?, [out, err].join.strip]

  if skip_browser || chrome.nil?
    reason = if ENV["PROBE_SKIP_BROWSER"] == "1"
               "PROBE_SKIP_BROWSER=1"
             elsif RUBY_PLATFORM.include?("darwin") && ENV["PROBE_FORCE_BROWSER"] != "1"
               "macOS — set PROBE_FORCE_BROWSER=1 for Ferrum"
             else
               "no Chrome executable"
             end
    checks << ["probe_face (skipped)", true, reason]
    checks << ["probe_primer (skipped)", true, reason]
  else
    out, err, status = Open3.capture3("env", "CHROME_PATH=#{chrome}", "PROBE_WAIT=12", "ruby", PROBE_FACE, WEB_URL, chdir: WEB)
    checks << ["probe_face #{WEB_URL}", status.success?, [out, err].join.strip]

    if File.file?(PROBE_PRIMER)
      out, err, status = Open3.capture3("env", "CHROME_PATH=#{chrome}", "ruby", PROBE_PRIMER, WEB_URL, chdir: WEB)
      checks << ["probe_primer #{WEB_URL}", status.success?, [out, err].join.strip]
    end

    if File.file?(PROBE_CHAT_E2E)
      out, err, status = Open3.capture3(
        "env", "CHROME_PATH=#{chrome}", "PROBE_FORCE_BROWSER=1", "ruby", PROBE_CHAT_E2E, WEB_URL, chdir: WEB
      )
      checks << ["probe_chat_e2e #{WEB_URL}", status.success?, [out, err].join.strip]
    end
  end
end

failed = checks.reject { |_name, ok, _detail| ok }
checks.each do |name, ok, detail|
  puts "#{ok ? 'ok' : 'fail'} #{name}"
  next if ok || detail.empty?

  detail.lines.first(8).each { |line| puts "  #{line.chomp}" }
end

exit(failed.empty? ? 0 : 1)
