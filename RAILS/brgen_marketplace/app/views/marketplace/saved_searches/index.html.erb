<% content_for :title, t("marketplace.saved_searches") %>

<div class="page-header">
  <hgroup>
    <p><%= t("marketplace.alerts") %></p>
    <%= tag.h1 t("marketplace.saved_searches") %>
  </hgroup>
  <%= link_to t("marketplace.browse_listings"), listings_path, class: "button button-ghost" %>
</div>

<% if @saved_searches.any? %>
  <div class="post-grid">
    <% @saved_searches.each do |saved_search| %>
      <%# The run link carries every part of the search, the place included,
          so it shows what the alert watches. %>
      <% run_path = listings_path(q: saved_search.query, category_id: saved_search.category_id,
                                  location: saved_search.location.presence) %>
      <% search_actions = capture do %>
        <%= link_to t("marketplace.run_search"), run_path, class: "feed-action feed-action--primary" %>
        <%= button_to (saved_search.notify? ? t("marketplace.alerts_turn_off") : t("marketplace.alerts_turn_on")),
              saved_search_path(saved_search), method: :patch, params: { notify: !saved_search.notify? },
              class: "feed-action", aria: { pressed: saved_search.notify? } %>
        <%= button_to t("actions.delete"), saved_search_path(saved_search), method: :delete,
              data: { turbo_confirm: t("marketplace.confirm_delete_saved_search") }, class: "feed-action" %>
      <% end %>
      <%= render "shared/feed_card",
        name: saved_search.title,
        meta: [
          saved_search.query.presence || t("marketplace.any_query"),
          saved_search.category&.name,
          saved_search.location.presence,
          (saved_search.notify? ? t("marketplace.alerts_on") : nil)
        ].compact.join(" · "),
        actions: search_actions,
        url: run_path,
        class: "listing" %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_saved_searches"),
        body: t("actions.save_search_body"),
        action: { label: t("marketplace.browse_listings"), path: listings_path } %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
