<%# Checkout always targets the currently selected shop offer. %>
<% buybar_listing = local_assigns[:listing] || @listing %>
<% if buybar_listing.buyable? && authenticated? && Current.user.id != buybar_listing.user_id %>
  <div class="listing-buy-bar" role="group" aria-label="<%= t("marketplace.buy_actions") %>">
    <div class="listing-buy-bar-actions">
      <% dintero_ready = Marketplace::Payments::DinteroCheckout.configured? &&
           Marketplace::Payments::DinteroCheckout.supported_listing?(buybar_listing) %>
      <% if dintero_ready %>
        <%= button_to t("marketplace.buy_now_dintero"),
              checkout_path,
              params: { provider: "dintero", listing_id: buybar_listing.id },
              class: "button button-primary listing-buy-bar-cta",
              form: { data: { turbo: false } } %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(buybar_listing),
              params: { quantity: 1 },
              class: "button button-ghost listing-buy-bar-secondary" %>
      <% elsif Marketplace::Payments::VippsCheckout.configured? %>
        <%# Without Turbo, as the Dintero button: the answer is a redirect to
            landing.vipps.no, which a Turbo fetch cannot follow cross-origin. %>
        <%= button_to checkout_path,
              params: { provider: "vipps", listing_id: buybar_listing.id },
              class: "button button-primary listing-buy-bar-cta",
              form: { data: { turbo: false } } do %>
          <%= image_tag "vipps/vipps-wordmark-on-orange.svg", alt: "", width: 59, height: 24 %>
          <%= t("marketplace.buy_now_vipps") %>
        <% end %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(buybar_listing),
              params: { quantity: 1 },
              class: "button button-ghost listing-buy-bar-secondary" %>
      <% else %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(buybar_listing),
              params: { quantity: 1 },
              class: "button button-primary listing-buy-bar-cta" %>
      <% end %>
      <a href="#make-offer" class="button button-ghost listing-buy-bar-secondary"><%= t("marketplace.offer") %></a>
    </div>
  </div>
<% end %>
