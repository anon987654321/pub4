<%# Payment action is rendered only when its provider is actually configured. %>
<% if @listing.buyable? && authenticated? && Current.user != @listing.user %>
  <div class="listing-buy-bar" role="group" aria-label="<%= t("marketplace.buy_actions") %>">
    <div class="listing-buy-bar-actions">
      <% dintero_ready = Marketplace::Payments::DinteroCheckout.configured? &&
           Marketplace::Payments::DinteroCheckout.supported_listing?(@listing) %>
      <% if dintero_ready %>
        <%= button_to t("marketplace.buy_now_dintero"),
              checkout_path,
              params: { provider: "dintero", listing_id: @listing.id },
              class: "btn btn-primary listing-buy-bar-cta",
              form: { data: { turbo: false } } %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(@listing),
              params: { quantity: 1 },
              class: "btn btn-ghost listing-buy-bar-secondary" %>
      <% elsif Marketplace::Payments::VippsCheckout.configured? %>
        <%= button_to t("marketplace.buy_now_vipps"),
              checkout_path,
              params: { provider: "vipps", listing_id: @listing.id },
              class: "btn btn-primary listing-buy-bar-cta" %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(@listing),
              params: { quantity: 1 },
              class: "btn btn-ghost listing-buy-bar-secondary" %>
      <% else %>
        <%= button_to t("marketplace.add_to_cart"),
              listing_orders_path(@listing),
              params: { quantity: 1 },
              class: "btn btn-primary listing-buy-bar-cta" %>
      <% end %>
      <a href="#make-offer" class="btn btn-ghost listing-buy-bar-secondary"><%= t("marketplace.offer") %></a>
    </div>
  </div>
<% end %>
