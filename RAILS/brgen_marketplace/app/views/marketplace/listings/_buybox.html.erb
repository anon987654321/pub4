<%# The primary offer is selected among shop listings that share an explicit product key. %>
<% buybox_listing = @buy_box_result&.winner || @listing %>
<section class="store-buybox marketplace-listing" aria-label="<%= t("marketplace.buy_actions") %>">
  <p class="listing-price"><%= buybox_listing.price_display %></p>
  <% if buybox_listing.sold? %>
    <p class="listing-status"><%= t("marketplace.sold_notice") %></p>
  <% elsif buybox_listing.expired? %>
    <p class="listing-status"><%= t("marketplace.expired_notice") %></p>
    <% if Current.user.present? && Current.user&.id == buybox_listing.user_id %>
      <%= button_to t("marketplace.renew"), renew_listing_path(buybox_listing), method: :post, class: "button button-primary button-small" %>
    <% end %>
  <% end %>
  <% if buybox_listing.photo_processing? %>
    <p class="listing-status listing-status--notice"><%= t("marketplace.photo_processing_notice") %></p>
  <% end %>
  <% condition_facts = [buybox_listing.condition_label, buybox_listing.location].compact %>
  <% if condition_facts.any? %>
    <p class="meta-facts"><% condition_facts.each do |fact| %><span><%= fact %></span><% end %></p>
  <% end %>
  <p class="listing-delivery"><%= buybox_listing.delivery_badge %></p>
  <p class="meta-facts"><%= tag.strong(t("marketplace.sold_by", name: (buybox_listing.store&.name || buybox_listing.user&.display_name || t("chat.anon")))) %><span><%= buybox_listing.store_id.present? ? t("marketplace.shop_seller") : t("marketplace.private_seller") %></span><% if buybox_listing.reviews_count.to_i.positive? %><span><%= t("marketplace.seller_rating", rating: number_with_precision(buybox_listing.rating, precision: 1)) %></span><% end %></p>
  <%# A private seller is a stranger, so the box says what can be known about
      them; a shop has its own page and verification instead. %>
  <% if (trust = Marketplace::SellerTrust.for(buybox_listing)) %>
    <ul class="seller-trust" aria-label="<%= t("marketplace.seller_trust_label") %>">
      <%= tag.li t("marketplace.seller_member_since", date: l(trust.member_since, format: "%B %Y")) %>
      <%= tag.li t("marketplace.seller_completed_sales", count: trust.completed_sales) %>
      <%= tag.li t("marketplace.seller_identity_verified") if trust.identity_verified? %>
    </ul>
  <% end %>
  <%# Advance-payment and rental scams target private sales, so the box says
      how to pay safely; a home adds the deposit rule. %>
  <% if buybox_listing.housing? %>
    <%= tag.p t("marketplace.housing_deposit_warning"), class: "listing-status listing-status--notice" %>
  <% elsif buybox_listing.casual? %>
    <%= tag.p t("marketplace.private_seller_safety"), class: "listing-status listing-status--notice" %>
  <% end %>
  <%# Views and saves are the seller's numbers; a buyer deciding reads price,
      delivery and seller, as bol's and Kaufland's boxes hold. %>
  <% if Current.user.present? && Current.user.id == buybox_listing.user_id %>
    <p class="meta-facts"><span><%= t("marketplace.views", count: buybox_listing.views_count.to_i) %></span><span><%= t("marketplace.saves", count: buybox_listing.favorites.size) %></span></p>
  <% end %>
  <% if @buy_box_result && @buy_box_result.offers.size > 1 %>
    <p class="listing-status"><%= t("marketplace.buy_box_heading") %></p>
    <details class="buy-box-offers">
      <%# bol's "andere verkopers (n) vanaf €x": how many others and the lowest
          price, before the reader opens the list. %>
      <% others = @buy_box_result.offers.reject { |offer| offer.id == buybox_listing.id } %>
      <summary><%= t("marketplace.other_sellers_from", count: others.size,
                     price: others.min_by { |offer| offer.price_cents.to_i }&.price_display) %></summary>
      <ul>
        <% @buy_box_result.offers.each do |offer| %>
          <li>
            <%= link_to offer.title, listing_path(offer) %>
            <span><%= offer.price_display %></span>
            <small><%= offer.store&.name || offer.user&.display_name %></small>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <%= render "marketplace/listings/buy_bar", listing: buybox_listing %>
  <%# seller can read back nil: User is acts_as_tenant-scoped on city, so a
      seller with no city (or another city) is invisible under this tenant and
      the association returns nil. Without this guard the != test passes and
      main_app.user_conversations_path(nil) raises UrlGenerationError, 500ing the whole
      listing page. %>
  <% seller = buybox_listing.user %>
  <% if buybox_listing.buyable? && Current.user.present? && seller.present? && Current.user != seller %>
    <%= button_to t("marketplace.message_seller_button"), main_app.user_conversations_path(seller), method: :post, class: "button button-ghost" %>
  <% end %>
</section>
