<%# One review row: the stars drawn from the rating, then who and when. Anyone
    signed in other than its author can report it. %>
<article>
  <%= render "shared/store_stars", rating: review.rating %>
  <p class="deal-meta"><%= review.user&.display_name || t("chat.anon") %> · <%= time_ago(review.created_at) %></p>
  <%= simple_format(review.body) if review.body.present? %>
  <% if authenticated? && review.user_id != Current.user.id %>
    <%= render "shared/report_button", target: review, reason: nil %>
  <% end %>
</article>
