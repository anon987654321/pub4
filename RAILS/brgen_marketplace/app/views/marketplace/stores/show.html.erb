<% content_for :title, @store.name %>
<% content_for :description, meta_description_for(@store) %>
<% content_for :json_ld, json_ld_for(@store, type: :local_business) %>

<%= tag.section class: "marketplace-store" do %>
  <%= tag.header do %>
    <%= tag.h1 @store.name %>
    <%= render "business_verifications/status", business: @store, kind: "store", owner: authenticated? && Current.user&.id == @store.owner_id %>
    <%= tag.p t("marketplace.verticals.#{@store.vertical}") if @store.vertical.present? %>
    <%= tag.p @store.description if @store.description.present? %>
    <% if @store.place.present? %>
      <%= tag.p link_to(t("maps.on_the_map"), record_public_href(@store.place),
            class: "button button-ghost button-small") %>
    <% end %>
    <% if authenticated? && Current.user&.id == @store.owner_id %>
      <%= tag.nav class: "cluster" do %>
        <%= link_to t("marketplace.stores.edit"), edit_shop_path(@store.slug),
              class: "button button-ghost button-small" %>
        <%= link_to t("marketplace.partner_program"), main_app.new_partner_program_path(store_id: @store.slug), class: "button button-ghost button-small" %>
        <%= button_to t("marketplace.stores.delete"), shop_path(@store.slug), method: :delete, data: { turbo_confirm: t("marketplace.stores.delete_confirm") }, class: "button button-danger button-small" %>
      <% end %>
    <% elsif authenticated? %>
      <%= render "shared/report_button", target: @store, reason: nil %>
    <% end %>
  <% end %>

  <% if @seller_summary %>
    <section class="store-seller-center" aria-labelledby="store-seller-center"> <%# scan: intentional — seller center is the feature name, not a text alignment class %>
      <h2 id="store-seller-center"><%= t("marketplace.seller_center.title") %></h2>
      <dl class="seller-summary">
        <dt><%= t("marketplace.seller_center.live") %></dt>
        <dd><%= @inventory_summary[:live] %></dd>
        <dt><%= t("marketplace.seller_center.expiring") %></dt>
        <dd><%= @inventory_summary[:expiring] %></dd>
        <dt><%= t("marketplace.seller_center.sold") %></dt>
        <dd><%= @inventory_summary[:sold] %></dd>
        <dt><%= t("marketplace.seller_center.out_of_stock") %></dt>
        <dd><%= @inventory_summary[:out_of_stock] %></dd>
        <dt><%= t("marketplace.seller_center.purchases") %></dt>
        <dd><%= @seller_summary[:purchases] %></dd>
        <dt><%= t("marketplace.seller_center.delivery_rate") %></dt>
        <dd><%= @seller_summary[:delivery_completion_rate] ? number_to_percentage(@seller_summary[:delivery_completion_rate] * 100, precision: 1) : "—" %></dd>
        <dt><%= t("marketplace.seller_center.return_rate") %></dt>
        <dd><%= @seller_summary[:return_rate] ? number_to_percentage(@seller_summary[:return_rate] * 100, precision: 1) : "—" %></dd>
        <dt><%= t("marketplace.seller_center.rating") %></dt>
        <dd><%= @seller_summary[:average_rating] || "—" %></dd>
      </dl>
    </section>
  <% end %>

  <% if @payouts %>
    <%# A frame, so paging through payouts leaves the listings below in place. The
        release button targets _top: its redirect is the whole store page. %>
    <%= turbo_frame_tag "store-payouts" do %>
      <section aria-label="<%= t("marketplace.payouts") %>">
        <h2><%= t("marketplace.payouts") %></h2>
        <% @payouts.each do |payout| %>
          <article>
            <p data-money><%= Shared::MoneyDisplay.format(payout.amount_cents, payout.currency) %> · <%= t("marketplace.payout_statuses.#{payout.status}") %></p>
            <% if payout.releasable? %>
              <%= button_to t("marketplace.payout_release"), shop_payouts_path(@store, payout_id: payout.id), method: :post, form: { data: { turbo_frame: "_top" } }, data: { turbo_confirm: t("marketplace.payout_release_confirm") }, class: "button button-small" %>
            <% elsif payout.pending? %>
              <p><%= t("marketplace.payout_held") %></p>
            <% end %>
          </article>
        <% end %>
        <%= render "shared/pager", pagy: @pagy_payouts, label: t("marketplace.payouts") %>
      </section>
    <% end %>
  <% end %>

  <% if @listings.any? %>
    <div class="deal-grid" aria-label="<%= t("aria.store_listings") %>">
      <%= render partial: "marketplace/listings/card", collection: @listings, as: :listing %>
    </div>
    <%= render "shared/pager", pagy: @pagy_listings, label: t("aria.store_listings"), param: :listings_page %>
  <% else %>
    <%# empty_state: no-action-ok — a shopper has no step to take in an empty store; other stores follow %>
    <%= render "shared/empty_state",
          title: t("marketplace.stores.no_listings"),
          body: t("marketplace.stores.no_listings_body"),
          live: false %>
  <% end %>

  <% if @other_stores.present? %>
    <aside>
      <%= tag.h2 t("marketplace.stores.also_in_city", city: city_name) %>
      <ul>
        <% @other_stores.each do |store| %>
          <li><%= link_to store.name, shop_path(store) %></li>
        <% end %>
      </ul>
    </aside>
  <% end %>
<% end %>
