<% content_for :title, t("marketplace.orders.title", default: "Your orders") %>

<header class="page-header">
  <%= tag.h1 t("marketplace.orders.title", default: "Your orders") %>
</header>

<% if @orders.any? %>
  <ul class="order-list" id="buyer-orders">
    <%= render partial: "marketplace/orders/order_row", collection: @orders, as: :order %>
  </ul>
<% else %>
  <%# The empty case is the common one for a new account, and it was a page with
      nothing to do on it — the state NO_DEAD_ENDS names. Somebody with no orders
      wants listings, so the empty state hands them the listings. %>
  <%= render "shared/empty_state",
        title: t("marketplace.orders.empty_title"),
        body: t("marketplace.orders.empty_body"),
        action: { label: t("marketplace.orders.empty_action"), path: listings_path } %>
<% end %>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "BuyerOrdersInfiniteScrollReflex#load_more",
           sentinel_id: "buyer-orders-sentinel" %>

<%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
    ActionCable, so without JavaScript a truncated list would say nothing about
    the rest of itself. noscript, so a reader with JavaScript sees one
    mechanism rather than two. %>
<noscript><%= render "shared/pager", pagy: @pagy %></noscript>
