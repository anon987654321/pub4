<% content_for :title, t("marketplace.saved_listings") %>

<div class="page-header">
  <hgroup>
    <p><%= t("marketplace.saved_eyebrow") %></p>
    <%= tag.h1 t("marketplace.saved_listings") %>
  </hgroup>
  <%= link_to t("marketplace.browse_listings"), listings_path, class: "btn btn-ghost" %>
</div>

<% if @listings.any? %>
  <ul class="listing-grid feed_list" id="saved-listings">
    <% @listings.each do |listing| %>
      <li><%= render "marketplace/listings/card", listing: listing %></li>
    <% end %>
  </ul>
  <%= render "shared/infinite_scroll_sentinel",
             pagy: @pagy,
             reflex: "SavedListingsInfiniteScrollReflex#load_more",
             sentinel_id: "saved-listings-sentinel" %>
  <%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
      ActionCable, so without JavaScript a truncated list would say nothing about
      the rest of itself. noscript, so a reader with JavaScript sees one
      mechanism rather than two. %>
  <noscript><%= render "shared/pager", pagy: @pagy %></noscript>

<% else %>
  <%# A sold or withdrawn listing leaves the list on its own — `live` is what
      every public surface reads, and a saved list that shows things nobody can
      buy is a list people stop opening. %>
  <%= render "shared/empty_state",
        title: t("marketplace.saved_empty_title"),
        body: t("marketplace.saved_empty_body"),
        action: { label: t("marketplace.browse_listings"), path: listings_path } %>
<% end %>
