<%# Kaufland.de's grid tile for a kitchen. A restaurant has no price and no
    photograph column, so the well carries its initial and the cuisine badge,
    and the delivery fee stands where a price would, as Wolt and Foodora lead
    with it, the minimum order under it. open_status (:open, :closed, or nil
    when no hours are recorded) is read once for the page; nil claims nothing. %>
<article class="deal-card restaurant" role="listitem">
  <%= link_to restaurant_path(restaurant), class: "deal-card-hit" do %>
    <div class="deal-card-img">
      <% if restaurant.cover.attached? %>
        <%= image_tag main_app.url_for(restaurant.media_variant(:cover, :card)),
              alt: "", class: "restaurant-cover-image", loading: "lazy" %>
      <% else %>
        <div class="deal-card-placeholder" aria-hidden="true"><%= restaurant.name.to_s.first&.upcase %></div>
      <% end %>
      <%= tag.span restaurant.cuisine_type, class: "deal-badge deal-badge--soft" if restaurant.cuisine_type.present? %>
    </div>
    <div class="deal-card-body">
      <%# The storefront ladder (StorefrontCardLadderTest): price, then name,
          then stars, then the meta lines, as on every marketplace tile. %>
      <%= tag.div t("takeaway.delivery_fee_lead", fee: restaurant.delivery_fee_display), class: "deal-price" %>
      <%= tag.h3 restaurant.name, class: "deal-card-title" %>
      <% if restaurant.reviews_count.to_i.positive? %>
        <%= render "shared/store_stars", rating: restaurant.rating, count: restaurant.reviews_count %>
      <% end %>
      <%= tag.p t("takeaway.min_order_short", min: restaurant.min_order_display), class: "deal-meta" %>
      <% open_status = local_assigns[:open_status] %>
      <% if open_status == :open %>
        <%= tag.p tag.strong(t("takeaway.open_now")), class: "deal-meta" %>
      <% elsif open_status == :closed %>
        <%= tag.p t("takeaway.closed_now"), class: "deal-meta" %>
      <% end %>
      <p class="deal-meta"><%= restaurant.city_label %></p>
    </div>
  <% end %>
</article>
