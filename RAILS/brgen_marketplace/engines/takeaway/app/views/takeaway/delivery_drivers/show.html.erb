<% content_for :title, t("takeaway.delivery_driver") %>

<div class="page-header">
  <hgroup>
    <p><%= t("takeaway.operations") %></p>
    <%= tag.h1 @delivery_driver.user&.display_name || t("takeaway.anon") %>
  </hgroup>
  <%= link_to t("actions.all_drivers"), delivery_drivers_path, class: "button button-ghost button-small" %>
</div>

<article aria-label="<%= t("takeaway.driver_details") %>">
  <%# The saved vehicle: a rejected update must not print the value it refused. %>
  <% vehicle = @delivery_driver.vehicle_type_in_database %>
  <% vehicle_label = vehicle.present? ? t("takeaway.vehicle_types.#{vehicle}") : t("takeaway.vehicle_unset") %>
  <p><%= vehicle_label %> · <%= @delivery_driver.available? ? t("takeaway.available") : t("takeaway.unavailable") %></p>
  <% if @delivery_driver.location? && Current.user && Current.user.id == @delivery_driver.user_id %>
    <p><%= @delivery_driver.current_lat %>, <%= @delivery_driver.current_lng %></p>
  <% end %>
</article>

<% if @jobs %>
  <section aria-labelledby="courier-jobs-heading">
    <%= tag.h2 t("takeaway.courier_jobs"), id: "courier-jobs-heading" %>
    <% if @jobs.any? %>
      <ul role="list">
        <%= render partial: "takeaway/delivery_drivers/job", collection: @jobs, as: :order %>
      </ul>
    <% else %>
      <%= tag.p t("takeaway.courier_jobs_empty") %>
    <% end %>
  </section>
<% end %>

<% if authenticated? && Current.user == @delivery_driver.user %>
  <%= form_with model: @delivery_driver, url: delivery_driver_path(@delivery_driver), scope: :delivery_driver, method: :patch do |form| %>
    <%= render "shared/errors", object: @delivery_driver %>
    <div class="field">
      <%= form.label :vehicle_type %>
      <%= form.select :vehicle_type,
            Takeaway::DeliveryDriver::VEHICLE_TYPES.map { |type| [t("takeaway.vehicle_types.#{type}"), type] },
            include_blank: true %>
    </div>
    <div class="field">
      <%= form.label :available %>
      <%= form.check_box :available %>
    </div>
    <div class="field">
      <%= form.label :license_number, t("takeaway.license_number") %>
      <%= form.text_field :license_number %>
    </div>
    <fieldset data-controller="current-location"
              data-current-location-locating-value="<%= t("takeaway.locating") %>"
              data-current-location-denied-value="<%= t("takeaway.location_denied") %>">
      <legend><%= t("takeaway.position") %></legend>
      <div class="field">
        <%= form.label :current_lat, t("takeaway.latitude") %>
        <%= form.text_field :current_lat, inputmode: "decimal", data: { current_location_target: "latitude" } %>
      </div>
      <div class="field">
        <%= form.label :current_lng, t("takeaway.longitude") %>
        <%= form.text_field :current_lng, inputmode: "decimal", data: { current_location_target: "longitude" } %>
      </div>
      <button type="button" class="button button-ghost" data-action="current-location#fill">
        <%= t("takeaway.use_current_location") %>
      </button>
      <p role="status" data-current-location-target="status"></p>
    </fieldset>
    <%= form.submit t("takeaway.update"), class: "button button-primary button-small" %>
  <% end %>
<% end %>
