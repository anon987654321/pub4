<% reset_url = edit_password_url(@user.password_reset_token) %>
<% expires_in = distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mail-shell">
  <tr><%= tag.td t("app.name"), class: "mail-brand" %></tr>
  <tr>
    <td class="mail-lede-wrap">
      <%= tag.p t("mailer.password_reset_lede"), class: "mail-lede" %>
    </td>
  </tr>
  <tr>
    <td class="mail-cta-wrap">
      <%= link_to t("mailer.password_reset_action"), reset_url, class: "mail-cta" %>
    </td>
  </tr>
  <tr><%= tag.td t("mailer.password_reset_expiry", time: expires_in), class: "mail-permission" %></tr>
  <tr><%= tag.td t("mailer.password_reset_ignore"), class: "mail-permission" %></tr>
</table>
