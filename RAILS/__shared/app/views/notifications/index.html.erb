<% content_for :title, t("notifications.title", default: "Notifications") %>

<%= turbo_frame_tag "notifications" do %>
  <div class="page-header">
    <hgroup>
      <%= tag.h1 t("notifications.title", default: "Notifications") %>
    </hgroup>
    <% unread = @notifications.count { |n| !n.read? } %>
    <% if unread.positive? %>
      <%= button_to t("notifications.mark_all", default: "Mark all read"), read_all_notifications_path, method: :patch, class: "btn btn-primary", data: { turbo_stream: true } %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <% @notifications.each do |notification| %>
      <%= render "notifications/notification", notification: notification %>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("notifications.empty_title", default: "No notifications yet"),
          body: t("notifications.empty_body", default: "Updates will appear here."),
          action: { label: t("nav.home", default: "Home"), path: root_path } %>
  <% end %>
<% end %>
