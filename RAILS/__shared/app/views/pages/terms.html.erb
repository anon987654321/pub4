<% content_for :title, t("legal.terms") %>
<% social = legal_social_network? %>
<% amber = legal_app_key == "amber" %>

<article class="legal-prose">
  <p class="legal-eyebrow"><%= t("legal.terms_page.eyebrow") %></p>
  <h1><%= t("legal.terms_page.heading", host: request.host) %></h1>
  <p class="legal-updated"><%= t("legal.updated_on") %></p>

  <p><%= t("legal.terms_page.intro") %></p>

  <%= tag.h2 t("legal.terms_page.who_heading") %>
  <p><%= t("legal.terms_page.who_body",
           dating: (social && !amber) ? t("legal.terms_page.who_dating_clause") : "") %></p>

  <% if social %>
    <%= tag.h2 t("legal.terms_page.content_heading") %>
    <p><%= t("legal.terms_page.content_body",
             wardrobe: amber ? t("legal.terms_page.content_wardrobe_clause") : "") %></p>

    <%= tag.h2 t("legal.terms_page.acceptable_heading") %>
    <p><%= t("legal.terms_page.acceptable_body") %></p>
  <% else %>
    <%= tag.h2 t("legal.terms_page.catalogue_heading") %>
    <p><%= t("legal.terms_page.catalogue_body") %></p>
  <% end %>

  <% if social %>
    <%= tag.h2 t("legal.terms_page.partner_heading") %>
    <p><%= t("legal.terms_page.partner_body_html",
             privacy: link_to(t("legal.terms_page.partner_privacy_link"), privacy_path),
             cookies: link_to(t("legal.terms_page.partner_cookies_link"), cookies_path)) %></p>
  <% end %>

  <%= tag.h2 t("legal.terms_page.liability_heading") %>
  <p><%= t("legal.terms_page.liability_body",
           ugc: social ? t("legal.terms_page.liability_ugc_clause") : "") %></p>

  <%= tag.h2 t("legal.terms_page.termination_heading") %>
  <p><%= t("legal.terms_page.termination_body") %></p>

  <nav>
    <%= link_to t("legal.privacy"), privacy_path %>
    <%= link_to t("legal.cookies"), cookies_path %>
  </nav>
</article>
