<% post = local_assigns.fetch(:post) %>
<% vote_path = local_assigns[:vote_path] %>
<% vote_score = local_assigns.fetch(:vote_score, post.respond_to?(:score) ? post.score : 0).to_i %>
<% voter = Current.user if defined?(Current) %>
<% upvoted = local_assigns.fetch(:upvoted) { voter.present? && post.respond_to?(:upvoted_by?) && post.upvoted_by?(voter) } %>
<% downvoted = local_assigns.fetch(:downvoted) { voter.present? && post.respond_to?(:downvoted_by?) && post.downvoted_by?(voter) } %>
<div class="post-vote-rail" role="group" aria-label="<%= t("post.voting", default: "Post voting") %>">
  <% if vote_path.present? && voter.present? %>
    <%= button_to vote_path, method: :post, params: { vote: { value: 1 } },
          class: "post-vote-btn#{' is-active' if upvoted}", form_class: "post-vote-form",
          aria: { label: t("post.upvote", default: "Upvote"), pressed: upvoted } do %>
      <%= render "shared/feed_icon", name: "upvote" %>
    <% end %>
    <span class="post-vote-score"><%= vote_score %></span>
    <%= button_to vote_path, method: :post, params: { vote: { value: -1 } },
          class: "post-vote-btn#{' is-active' if downvoted}", form_class: "post-vote-form",
          aria: { label: t("post.downvote", default: "Downvote"), pressed: downvoted } do %>
      <%= render "shared/feed_icon", name: "downvote" %>
    <% end %>
  <% else %>
    <span class="post-vote-score post-vote-score--static"><%= vote_score %></span>
  <% end %>
</div>
