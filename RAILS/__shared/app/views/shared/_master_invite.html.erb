<% unless invited %>
  <%= button_to t("messages.invite_master"), path, method: :post,
                class: "button button-ghost button-small",
                data: { turbo: true } %>
<% else %>
  <span class="messenger-master-present" aria-label="<%= t("messages.master_present") %>">
    <%= t("messages.master_present") %>
  </span>
<% end %>
