<% messages = Array(local_assigns.fetch(:messages, [])) %>
<% artifact_message = messages.reverse.find do |message|
     attached = message.respond_to?(:attachment) && message.attachment.attached?
     preview = message.respond_to?(:link_preview) && message.link_preview.present?
     attached || preview
   end %>
<% artifact_kinds = [] %>
<% messages.reverse_each do |message| %>
  <% if message.respond_to?(:attachment) && message.attachment.attached? %>
    <% kind = message.respond_to?(:voice?) && message.voice? ? "voice" : (message.attachment.content_type.to_s.start_with?("image/") ? "image" : "file") %>
    <% artifact_kinds << kind unless artifact_kinds.include?(kind) %>
  <% elsif message.respond_to?(:link_preview) && message.link_preview.present? %>
    <% artifact_kinds << "preview" unless artifact_kinds.include?("preview") %>
  <% end %>
<% end %>
<aside class="messenger-artifact-pane" aria-label="<%= t("messages.artifacts_label") %>">
  <header class="messenger-artifact-header">
    <h2><%= t("messages.artifacts") %></h2>
    <% if artifact_kinds.any? %>
      <span class="messenger-artifact-count"><%= artifact_kinds.size %></span>
    <% end %>
  </header>

  <% if artifact_message %>
    <div class="messenger-artifact-body">
      <% if artifact_message.respond_to?(:attachment) && artifact_message.attachment.attached? %>
        <% if artifact_message.respond_to?(:voice?) && artifact_message.voice? %>
          <p class="messenger-artifact-kind"><%= t("messages.artifact_voice") %></p>
          <%= audio_tag url_for(artifact_message.attachment), controls: true, preload: "metadata", class: "messenger-artifact-audio" %>
        <% elsif artifact_message.attachment.content_type.to_s.start_with?("image/") %>
          <p class="messenger-artifact-kind"><%= t("messages.artifact_image") %></p>
          <%= image_tag url_for(artifact_message.attachment), alt: t("messages.artifact_image_alt"), loading: "lazy", decoding: "async", class: "messenger-artifact-image" %>
        <% else %>
          <p class="messenger-artifact-kind"><%= t("messages.artifact_file") %></p>
          <%= link_to t("messages.open_attachment"), url_for(artifact_message.attachment), class: "btn btn-ghost btn-sm" %>
        <% end %>
      <% elsif artifact_message.respond_to?(:link_preview) && artifact_message.link_preview.present? %>
        <p class="messenger-artifact-kind"><%= t("messages.artifact_preview") %></p>
        <%= render "shared/link_embed", embed: artifact_message.link_preview %>
      <% end %>

      <footer class="messenger-artifact-meta">
        <time datetime="<%= artifact_message.created_at.iso8601 %>"><%= time_ago(artifact_message.created_at) %></time>
      </footer>
    </div>
  <% else %>
    <div class="messenger-artifact-empty" role="status">
      <strong><%= t("messages.no_artifacts") %></strong>
      <p><%= t("messages.no_artifacts_body") %></p>
    </div>
  <% end %>
</aside>
