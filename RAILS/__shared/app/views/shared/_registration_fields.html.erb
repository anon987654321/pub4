<div class="field">
  <%= form.label :email_address, t("auth.email") %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", inputmode: "email" %>
</div>
<% if local_assigns.fetch(:include_username, false) %>
  <div class="field">
    <%= form.label :username, t("auth.username_optional") %>
    <%= form.text_field :username, autocomplete: "nickname" %>
  </div>
<% end %>
<div class="field">
  <%= form.label :password, t("auth.password") %>
  <%= password_visibility_field form, :password, required: true, autocomplete: "new-password", maxlength: 72 %>
</div>
<div class="field">
  <%= form.label :password_confirmation, t("auth.confirm_password") %>
  <%= password_visibility_field form, :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
</div>
<div class="field">
  <label>
    <%= check_box_tag :accept_age, "1", params[:accept_age] == "1", required: true %>
    <%= t("legal.accept_age") %>
  </label>
</div>
<div class="field">
  <label>
    <%= check_box_tag :accept_terms, "1", params[:accept_terms] == "1", required: true %>
    <%= t("legal.accept_terms") %>
    (<%= link_to t("legal.terms"), terms_path %> · <%= link_to t("legal.privacy"), privacy_path %>)
  </label>
</div>
