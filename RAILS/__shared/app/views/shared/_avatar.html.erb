<%# Usage: render "shared/avatar", user: current_user, size: 40 %>
<% size = (local_assigns[:size] || 40).to_i %>
<% size_class = { 24 => "avatar--24", 32 => "avatar--32", 40 => "avatar--40", 48 => "avatar--48", 64 => "avatar--64" }[size] || "avatar--40" %>
<% if local_assigns[:user]&.respond_to?(:avatar) && local_assigns[:user].avatar.attached? %>
  <%= image_tag(main_app.url_for(local_assigns[:user].avatar), class: "avatar #{size_class}", loading: "lazy", width: size, height: size, alt: local_assigns[:user].respond_to?(:name) ? local_assigns[:user].name : "Avatar") %>
<% else %>
  <% initials = if local_assigns[:user]&.respond_to?(:initials)
                  local_assigns[:user].initials
                else
                  (local_assigns[:user]&.respond_to?(:name) ? local_assigns[:user].name.to_s : "U").split.map { |part| part[0] }.join[0, 2].upcase
                end %>
  <%= tag.span initials, class: "avatar-initials #{size_class}" %>
<% end %>
