<%# Usage: render "shared/avatar", user: current_user, size: 40
    The size is the image's width and height attributes, and data-size on the
    initials, which have no intrinsic size (_minimal.scss). Markup names no
    size class. A size off the five steps renders at 40, as it always has. %>
<% size = local_assigns[:size].to_i %>
<% size = 40 unless [24, 32, 40, 48, 64].include?(size) %>
<% user = local_assigns[:user] %>
<% if user&.respond_to?(:avatar) && user.avatar.attached? %>
  <%= image_tag(main_app.url_for(user.avatar), class: "avatar", loading: "lazy", width: size, height: size,
                alt: user.respond_to?(:name) ? user.name : t("shared.avatar.alt")) %>
<% else %>
  <% initials = if user&.respond_to?(:initials)
                  user.initials
                else
                  (user&.respond_to?(:name) ? user.name.to_s : "U").split.map { |part| part[0] }.join[0, 2].upcase
                end %>
  <%= tag.span initials, class: "avatar-initials", data: { size: size } %>
<% end %>
