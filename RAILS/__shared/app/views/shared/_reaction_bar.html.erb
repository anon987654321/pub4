<% kinds = defined?(Shared::Reaction) ? Shared::Reaction::KINDS : %w[like love laugh wow sad angry local] %>
<span id="reactions_<%= dom_id(target) %>">
  <% kinds.each do |k| %>
    <% label = t("reactions.kinds.#{k}") %>
    <%= button_to reactions_path,
        params: { target_gid: target.to_signed_global_id.to_s, kind: k },
        data: { turbo_stream: true },
        class: (defined?(active) && active && k == kind ? "active" : nil),
        aria: { label: t("reactions.aria", kind: label) } do %>
      <%= label %>
    <% end %>
  <% end %>
</span>
