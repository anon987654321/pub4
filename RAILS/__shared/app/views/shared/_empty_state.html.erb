<%#
  Shared empty state — title + body + optional CTA.
  Usage:
    render "shared/empty_state",
      title: "No posts",
      body: "Try another search.",
      action: { label: "Compose", path: new_post_path }
%>
    The legacy actions: String local is deprecated; use only action: { label:, path: }.
<% title = local_assigns[:title] %>
<% body = local_assigns[:body] || local_assigns[:message] %>
<% action = local_assigns[:action] %>
<% if local_assigns[:actions].present? %>
  <%# Compatibility only: the String API is deprecated in favour of action: { label:, path: }. %>
  <% Rails.logger.warn("DEPRECATION: shared/empty_state actions: is deprecated; use action: { label:, path: }") %>
<% end %>
<% live = local_assigns.fetch(:live, true) %>
<section
  class="empty empty-state<%= " #{local_assigns[:class]}" if local_assigns[:class].present? %>"
  role="status"
  <% if live %>aria-live="polite"<% end %>>
  <%# An icon only where a caller has one worth drawing. This was a hardcoded ○
      — a 12px ring above every empty state in three apps, aria-hidden because
      it says nothing, which is the argument for not drawing it at all. %>
  <% if local_assigns[:icon].present? %>
    <span class="empty-state-icon" aria-hidden="true"><%= icon local_assigns[:icon], size: 24 %></span>
  <% end %>
  <% if title.present? %>
    <h2 class="empty-state-title"><%= title %></h2>
  <% end %>
  <% if body.present? %>
    <p class="empty-state-body"><%= body %></p>
  <% end %>
  <% if action.is_a?(Hash) && action[:label].present? && action[:path].present? %>
    <%= link_to action[:label], action[:path], class: "btn btn-primary empty-state-action" %>
  <% elsif local_assigns[:actions].present? %>
    <%# DEPRECATION: use action: { label:, path: }; the String-based actions local is retained only for compatibility. %>
    <% Rails.logger.warn("[DEPRECATION] shared/empty_state actions: use action: { label:, path: }") %>
    <div class="empty-state-actions"><%= local_assigns[:actions] %></div>
  <% end %>
</section>
