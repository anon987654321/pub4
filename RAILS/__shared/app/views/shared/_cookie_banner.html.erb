<section id="cookie-consent-banner"
         class="cookie-banner"
         data-cookie-consent-target="banner"
         hidden
         aria-labelledby="cookie-consent-title">
  <div class="cookie-banner-copy">
    <p class="cookie-banner-kicker"><%= t("cookie_consent.kicker") %></p>
    <h2 id="cookie-consent-title"><%= t("cookie_consent.title") %></h2>
    <p><%= t("cookie_consent.body") %></p>
    <p class="cookie-banner-policy"><%= link_to t("cookie_consent.policy"), main_app.cookies_path %></p>
  </div>

  <div class="cookie-banner-actions">
    <button type="button" class="cookie-banner-button"
            data-action="cookie-consent#reject"><%= t("cookie_consent.reject") %></button>
    <button type="button" class="cookie-banner-button"
            data-action="cookie-consent#manage"
            aria-controls="cookie-consent-preferences"><%= t("cookie_consent.manage") %></button>
    <button type="button" class="cookie-banner-button"
            data-action="cookie-consent#accept"><%= t("cookie_consent.accept") %></button>
  </div>

  <div id="cookie-consent-preferences" class="cookie-consent-preferences"
       data-cookie-consent-target="preferences" hidden>
    <div>
      <h3><%= t("cookie_consent.settings_title") %></h3>
      <p><%= t("cookie_consent.settings_body") %></p>
    </div>

    <fieldset>
      <legend class="visually-hidden"><%= t("cookie_consent.settings_title") %></legend>
      <div class="cookie-purpose cookie-purpose--necessary">
        <span class="cookie-purpose-state" aria-hidden="true">✓</span>
        <span><strong><%= t("cookie_consent.purposes.necessary.title") %></strong><%= t("cookie_consent.purposes.necessary.body") %></span>
      </div>

      <label class="cookie-purpose">
        <input type="checkbox" data-cookie-consent-target="analytics">
        <span><strong><%= t("cookie_consent.purposes.analytics.title") %></strong><%= t("cookie_consent.purposes.analytics.body") %></span>
      </label>
      <label class="cookie-purpose">
        <input type="checkbox" data-cookie-consent-target="advertising">
        <span><strong><%= t("cookie_consent.purposes.advertising.title") %></strong><%= t("cookie_consent.purposes.advertising.body") %></span>
      </label>
    </fieldset>

    <div class="cookie-consent-preferences-actions">
      <button type="button" class="cookie-banner-button"
              data-action="cookie-consent#reject"><%= t("cookie_consent.reject") %></button>
      <button type="button" class="cookie-banner-button"
              data-action="cookie-consent#save"><%= t("cookie_consent.save") %></button>
    </div>
  </div>
</section>