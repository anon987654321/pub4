<table role="presentation" class="mail-story" cellpadding="0" cellspacing="0">
  <tr>
    <% if story.image_url.present? %>
      <td class="mail-story-img" width="176">
        <img loading="lazy" src="<%= story.image_url %>" alt="" width="176" height="110">
      </td>
    <% end %>
    <td>
      <p class="mail-story-title">
        <% if story.url.present? %>
          <a href="<%= story.url %>"><%= story.title %></a>
        <% else %>
          <%= story.title %>
        <% end %>
      </p>
      <% if story.meta.present? %><p class="mail-story-meta"><%= story.meta %></p><% end %>
      <p class="mail-story-teaser"><%= story.teaser %></p>
    </td>
  </tr>
</table>
