<table role="presentation" class="mail-deal" cellpadding="0" cellspacing="0">
  <tr>
    <% if deal.image_url.present? %>
      <td class="mail-deal-img" width="96">
        <img loading="lazy" src="<%= deal.image_url %>" alt="<%= deal.title %>" width="96" height="96">
      </td>
    <% end %>
    <td>
      <p class="mail-deal-title"><a href="<%= deal.url %>" rel="sponsored"><%= deal.title %></a></p>
      <p class="mail-deal-copy"><%= deal.description %></p>
      <% if deal.price.present? %>
        <p class="mail-deal-price"><strong><%= deal.price %> <%= deal.currency %></strong> · <%= deal.merchant %></p>
      <% end %>
      <a href="<%= deal.url %>" class="mail-cta" rel="sponsored"><%= t("newsletter.view_offer") %></a>
    </td>
  </tr>
</table>
