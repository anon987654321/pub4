<%# locals: (embed:) %>
<%# A post's media link, from Shared::LinkEmbed::Record.

    Resolved, it is a facade: the provider's thumbnail under one button. The
    player replaces the facade only when that button is pressed, through
    media_exclusive_controller.js on <body>, so no provider script runs and
    no provider cookie is set until the reader asks. The player address is
    rebuilt from the link's id; nothing the provider sent is rendered as markup.

    Pending or failed, it is the plain link. %>
<% if embed.ok? %>
  <figure class="link_embed">
    <div class="link_embed_stage">
      <% if embed.thumbnail_url %>
        <%# reserved: container — .link_embed_stage is a 16:9 box the img fills %>
        <img src="<%= embed.thumbnail_url %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
      <% end %>
      <button type="button" class="link_embed_play"
              data-action="click->media-exclusive#playEmbed"
              data-media-exclusive-src-param="<%= embed.player_url %>"
              data-media-exclusive-allow-param="<%= embed.allow %>"
              data-media-exclusive-title-param="<%= embed.title %>"
              aria-label="<%= t("link_embed.play", title: embed.title, provider: embed.label) %>">
        <%= icon :play, size: 32, css_class: "link_embed_icon" %>
      </button>
    </div>
    <figcaption>
      <%= tag.strong embed.title %><br>
      <%= tag.small [ embed.label, embed.author_name ].compact.join(" · ") %>
      <%= link_to t("link_embed.open", provider: embed.label), embed.canonical_url,
                  rel: "nofollow noopener noreferrer", target: "_blank" %>
    </figcaption>
  </figure>
<% else %>
  <p class="link_embed">
    <%= link_to embed.source_url, embed.source_url, rel: "nofollow noopener noreferrer", target: "_blank" %>
  </p>
<% end %>
