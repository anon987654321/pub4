<%# locals: (embed:) %>
<%# A post's media link, from Shared::LinkEmbed::Record.

    Resolved, it is a facade: the provider's thumbnail under one button. The
    player replaces the facade only when that button is pressed, through
    media_exclusive_controller.js on the document body, so no provider script
    runs and no provider cookie is set until the reader asks. The player
    address is rebuilt from the link's id; nothing the provider sent is
    rendered as markup.

    Pending or failed, it is the plain link. %>
<% if embed.ok? %>
  <figure class="link-embed">
    <div class="link-embed-stage">
      <% if embed.thumbnail_url %>
        <%# reserved: container — .link-embed-stage is a 16:9 box the img fills %>
        <img src="<%= embed.thumbnail_url %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
      <% end %>
      <button type="button" class="link-embed-play"
              data-action="click->media-exclusive#playEmbed"
              data-media-exclusive-src-param="<%= embed.player_url %>"
              data-media-exclusive-allow-param="<%= embed.allow %>"
              data-media-exclusive-title-param="<%= embed.title %>"
              aria-label="<%= t("link_embed.play", title: embed.title, provider: embed.label) %>"></button>
    </div>
    <figcaption>
      <%= tag.p tag.strong(embed.title) %>
      <p class="link-embed-source">
        <%= safe_join(embed.credits.map { |credit| tag.small(credit) }) %>
      </p>
      <p><%= link_to t("link_embed.open", provider: embed.label), embed.canonical_url,
                     rel: "nofollow noopener noreferrer", target: "_blank" %></p>
    </figcaption>
  </figure>
<% else %>
  <p class="link-embed">
    <%= link_to embed.source_url, embed.source_url, rel: "nofollow noopener noreferrer", target: "_blank" %>
  </p>
<% end %>
