<%
  surface = local_assigns.fetch(:surface, "brgen").to_s
  city = local_assigns.fetch(:city, "Bergen").to_s
  artwork_url = Shared::OnboardingArtwork.url(surface:, city:)
  namespace = "onboarding.#{surface}"
  title_id = "welcome-onboarding-title-#{surface}"
  lead_id = "welcome-onboarding-lead-#{surface}"
  # first_step: { label:, path: } turns the primary button into a link to an
  # app's first real step; it still records the dialog as seen on the way.
  first_step = local_assigns[:first_step]
%>
<div id="welcome-onboarding-<%= surface %>"
     class="welcome-onboarding welcome-onboarding--<%= surface %>"
     data-controller="welcome-onboarding"
     data-welcome-onboarding-surface-value="<%= surface %>"
     hidden
     role="dialog"
     aria-modal="true"
     aria-labelledby="<%= title_id %>"
     aria-describedby="<%= lead_id %>">
  <div class="welcome-onboarding-card">
    <figure class="welcome-onboarding-art">
      <% if artwork_url.present? %>
        <%# Decorative: the title beside it already says what it shows. %>
        <%= image_tag artwork_url,
              alt: "",
              loading: "eager",
              fetchpriority: "high",
              decoding: "async" %>
      <% else %>
        <span class="welcome-onboarding-monogram" aria-hidden="true"><%= city.first(1).presence || surface.first(1).upcase %></span>
      <% end %>
    </figure>

    <div class="welcome-onboarding-copy">
      <button type="button"
              class="welcome-onboarding-close"
              data-action="welcome-onboarding#close"
              aria-label="<%= t("onboarding.skip") %>">×</button>

      <p class="welcome-onboarding-label"><%= t("#{namespace}.kicker") %></p>
      <%# h2: the page under the dialog already has its h1. %>
      <h2 id="<%= title_id %>"><%= t("#{namespace}.title", city: city) %></h2>
      <p id="<%= lead_id %>" class="welcome-onboarding-lead"><%= t("#{namespace}.lead", city: city) %></p>

      <ol class="welcome-onboarding-steps">
        <% (1..3).each do |step| %>
          <li>
            <span class="welcome-onboarding-step-number" aria-hidden="true"><%= step %></span>
            <div> <%# scan: intentional — the ordered-list grid needs one child for each step title and explanation %>
              <strong><%= t("#{namespace}.steps.#{step}.title") %></strong>
              <p><%= t("#{namespace}.steps.#{step}.body", city: city) %></p>
            </div>
          </li>
        <% end %>
      </ol>

      <div class="welcome-onboarding-actions">
        <button type="button"
                class="welcome-onboarding-secondary"
                data-action="welcome-onboarding#close"><%= t("onboarding.skip") %></button>
        <% if first_step %>
          <%= link_to first_step.fetch(:label), first_step.fetch(:path), class: "welcome-onboarding-primary",
                data: { action: "welcome-onboarding#remember" } %>
        <% else %>
          <button type="button"
                  class="welcome-onboarding-primary"
                  data-action="welcome-onboarding#close"><%= t("onboarding.enter") %></button>
        <% end %>
      </div>
    </div>
  </div>
</div>
