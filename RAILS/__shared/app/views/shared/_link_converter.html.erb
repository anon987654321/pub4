<%# TradeDoubler is optional partner/advertising technology.
    The controller does not create the third-party script tag until advertising
    consent exists. %>
<% if Shared::LinkConverter.configured? %>
  <% script_src = Shared::LinkConverter.script_src(Rails.public_path) %>
  <% if script_src.present? %>
    <% route = "#{params[:controller]}##{params[:action]}" %>
    <% epi = Shared::LinkConverter.request_epi(route: route) %>
    <%= tag.div data: {
      controller: "link-converter",
      link_converter_src_value: script_src,
      link_converter_epi_value: epi.to_json
    } %>
  <% end %>
<% end %>
