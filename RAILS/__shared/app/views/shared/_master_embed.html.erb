<%# The MASTER face (ai.brgen.no), embedded as a first-class surface rather than
    an unlabelled black rectangle. Shared so brgen and amber cannot drift.

    Locals:
      heading — section heading; defaults to the app's master_embed_title
      eager   — true to load immediately (above the fold). Defaults to false:
                the face boots a WebGL/THREE scene, so keeping it off the
                critical path matters on a 1 vCPU host. %>
<% heading = local_assigns.fetch(:heading, master_embed_title) %>
<% eager = local_assigns.fetch(:eager, false) %>
<%# bare: the face is the hero rather than a labelled widget, so the chrome bar
    is dropped and the heading goes to screen readers only. The face still has
    to be announced — an unlabelled iframe is not navigable. %>
<% bare = local_assigns.fetch(:bare, false) %>
<section class="ai-embed<%= " ai-embed--bare" if bare %>"
         aria-labelledby="ai-embed-heading"
         data-surface="master-embed">
  <% if bare %>
    <h2 id="ai-embed-heading" class="visually-hidden"><%= heading %></h2>
    <%= link_to t("master.open_full", default: "Open AI"), master_web_url,
          class: "visually-hidden",
          target: "_blank", rel: "noopener" %>
  <% else %>
    <div class="ai-embed-bar">
      <h2 id="ai-embed-heading" class="ai-embed-heading"><%= heading %></h2>
      <%= link_to t("master.open", default: "Open"), master_web_url,
            class: "ai-embed-open",
            target: "_blank",
            rel: "noopener",
            aria: { label: t("master.open_full", default: "Open AI") } %>
    </div>
  <% end %>
  <iframe
    class="ai-embed-frame"
    src="<%= master_web_url(autostart: true, embed: true) %>"
    title="<%= heading %>"
    allow="microphone; autoplay; encrypted-media; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    loading="<%= eager ? "eager" : "lazy" %>"></iframe>
</section>
