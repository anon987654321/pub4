<% channel_content = capture do %>
  <% if channel.live? %><span class="live-badge"><%= t("tv.live_badge") %></span><% end %>
<% end %>
<%= render "shared/feed_card",
  avatar_url: (channel.avatar.attached? ? main_app.url_for(channel.avatar) : nil),
  name: channel.name,
  meta: t("tv.subscribers", count: channel.subscribers_count.to_i),
  content: channel_content.presence,
  url: channel_path(channel),
  class: "tv" %>
