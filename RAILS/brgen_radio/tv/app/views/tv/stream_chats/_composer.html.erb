<%# The chat composer. create.turbo_stream.erb replaces it after a line is
    sent, which is what empties the field. %>
<%= form_with url: live_stream_stream_chats_path(live_stream), scope: :stream_chat,
              id: "tv-live-stream-#{live_stream.id}-composer", data: { turbo: true } do |f| %>
  <%= f.text_field :message, placeholder: t("playlist.say_something"),
        aria: { label: t("playlist.say_something") }, required: true %>
  <%= f.submit t("actions.send"), class: "button button-primary button-small" %>
<% end %>
