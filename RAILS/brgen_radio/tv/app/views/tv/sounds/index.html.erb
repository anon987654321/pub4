<% content_for :title, t("tv.sounds") %>

<div class="page-header">
  <%= tag.h1 t("tv.sounds") %>
</div>

<% if @sounds.any? %>
  <ul role="list" class="sound-list" id="tv-sounds">
    <%= render partial: "tv/sounds/sound", collection: @sounds, as: :sound %>
  </ul>
  <%= render "shared/infinite_scroll_sentinel",
             pagy: @pagy,
             reflex: "SoundsInfiniteScrollReflex#load_more",
             sentinel_id: "tv-sounds-sentinel" %>

  <%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
      ActionCable, so without JavaScript a truncated list would say nothing about
      the rest of itself. noscript, so a reader with JavaScript sees one
      mechanism rather than two. %>
  <noscript><%= render "shared/pager", pagy: @pagy %></noscript>
<% else %>
  <%= render "shared/empty_state", title: t("tv.sounds_empty"), body: t("tv.sounds_empty_body"),
        action: { label: t("tv.browse"), path: root_path } %>
<% end %>
