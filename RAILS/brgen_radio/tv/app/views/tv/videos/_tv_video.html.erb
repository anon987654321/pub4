<article class="tv-card">
  <%= link_to video_path(tv_video), class: "tv-poster-link", aria: { label: tv_video.title } do %>
    <div class="tv-poster<%= " tv-poster--empty" unless tv_video.thumbnail.attached? %>">
      <% if tv_video.thumbnail.attached? %>
        <%= responsive_image_tag(tv_video.thumbnail, alt: tv_video.title, loading: "lazy", class: "tv-poster-img") %>
      <% end %>
      <% if tv_video.duration_formatted.present? %>
        <span class="tv-duration"><%= tv_video.duration_formatted %></span>
      <% end %>
    </div>
  <% end %>
  <div class="tv-card-meta">
    <%= link_to tv_video.title, video_path(tv_video), class: "tv-card-title" %>
    <p class="tv-card-sub"><%= tv_video.channel.name %> · <span class="tv-views"><%= t("tv.feed.views", count: tv_video.views_count.to_i) %></span></p>
  </div>
</article>
