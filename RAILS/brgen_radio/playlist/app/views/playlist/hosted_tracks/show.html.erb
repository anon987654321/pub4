<% content_for :title, @track.title %>

<%= render "playlist/playlists/player",
      playlist: @track,
      playlist_name: @track.title,
      tracks_count: 1,
      plays_count: @track.listens.count,
      tracks: [@track],
      active_track: @track,
      comments: @comments.map { |c| { time: (c.timestamp_seconds || 0).to_f, text: c.body } },
      track_comments: { @track.id => @comments.map { |c| { time: (c.timestamp_seconds || 0).to_f, text: c.body } } } %>

<%# A copyright, abuse or illegal-content report hides the track from everyone
    but its owner until a moderator decides (ModerationWorkflow::HOLD_REASONS). %>
<% if @track.review_held_at %>
  <%= tag.p t("playlist.track_held_for_review"), role: "status" %>
<% elsif authenticated? && @track.user_id != Current.user.id %>
  <%= render "shared/report_button", target: @track, reason: "copyright" %>
<% end %>

<% if authenticated? && @track.user_id == Current.user.id %>
  <section class="playlist-admin" aria-label="<%= t("aria.track_management") %>">
    <div class="cluster">
      <%= link_to t("actions.edit"), edit_hosted_track_path(@track), class: "button button-ghost button-small" %>
      <%= button_to t("actions.delete"), hosted_track_path(@track), method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "button button-danger button-small" %>
    </div>
  </section>
<% end %>

<section class="playlist-analytics" aria-label="<%= t("aria.track_analytics") %>">
  <%= tag.h3 t("playlist.analytics") %>
  <p><%= t("playlist.track_stats", plays: @track.listens.count, comments: @comments.size, versions: @track.audio_versions.count) %></p>
  <p><%= t("playlist.privacy_line", value: @track.privacy.presence || t("playlist.privacy_private")) %> <% if @track.expires_at %><%= t("playlist.expires_on", date: l(@track.expires_at.to_date)) %><% end %></p>
</section>

<% if @comments.any? %>
  <section class="playlist-details">
    <%= tag.h2 t("playlist.timestamped_comments") %>
    <% @comments.each do |comment| %>
      <article>
        <p><%= comment.timestamp_seconds %>s</p>
        <%= tag.p comment.body %>
      </article>
    <% end %>
  </section>
<% end %>
