<% content_for :title, t("playlist.listening_party_title", name: @set.name) %>
<%= turbo_stream_from @party.stream_name %>

<div class="page-header">
  <hgroup>
    <p><%= t("playlist.listening_party") %></p>
    <%= tag.h1 @set.name %>
    <p><%= t("playlist.join_code") %>: <%= tag.strong @party.join_code %></p>
  </hgroup>
  <% if @party.host_id == Current.user&.id %>
    <%= button_to t("playlist.end_party"), set_listening_party_path(@set), method: :delete,
          data: { turbo_confirm: t("playlist.confirm_end_party") }, class: "button button-danger button-small" %>
  <% end %>
</div>

<% host = @party.host_id == Current.user&.id %>
<%# The guest hears the host's track in step: party_audio follows the sync
    element below. The host's own audio reports its track and position back,
    which is what sync! broadcasts. A guest presses Listen along first,
    because a browser plays nothing aloud before the person asks for it. %>
<section class="listening-party-audio"
         aria-label="<%= t("playlist.party_audio") %>"
         data-controller="party-audio"
         data-party-audio-host-value="<%= host %>"
         data-party-audio-sync-url-value="<%= set_listening_party_path(@set) %>"
         data-party-audio-queue-value="<%= @tracks.map(&:id).to_json %>"
         data-party-audio-refused-label-value="<%= t("playlist.status_play_refused") %>"
         data-party-audio-error-label-value="<%= t("playlist.status_load_error") %>">
  <audio controls preload="none" data-party-audio-target="audio"></audio>
  <% unless host %>
    <%= tag.button t("playlist.party_listen_along"), type: "button", class: "button",
                   data: { action: "party-audio#join", party_audio_target: "join" }, hidden: true %>
  <% end %>
  <p role="status" data-party-audio-target="status"></p>
  <%= render "playlist/listening_parties/sync", party: @party, track: @party.current_track %>
</section>

<section>
  <%= tag.h2 t("playlist.queue") %>
  <ol>
    <% @tracks.each do |track| %>
      <li><%= track.title %> — <%= track.artist %></li>
    <% end %>
  </ol>
</section>

<section>
  <%= tag.h2 t("playlist.party_chat") %>
  <div id="party_messages">
    <%= render partial: "playlist/party_messages/message", collection: @messages, as: :message %>
  </div>

  <%= form_with url: set_listening_party_party_messages_path(@set), method: :post, class: "form-wrap" do |f| %>
    <div class="field field--row">
      <%= f.text_field :body, placeholder: t("playlist.say_something"), required: true, class: "field--grow",
            aria: { label: t("playlist.say_something") } %>
      <%= f.submit t("actions.send"), class: "button button-primary button-small" %>
    </div>
  <% end %>
</section>

<p><%= link_to t("playlist.back_to_set"), set_path(@set), class: "button button-ghost button-small" %></p>
