<% content_for :title, t("playlist.sets") %>

<div class="page-header">
  <hgroup>
    <p><%= t("playlist.sets_subtitle") %></p>
    <%= tag.h1 t("playlist.sets") %>
  </hgroup>
  <nav aria-label="<%= t("aria.playlist_set_actions") %>">
    <%= link_to t("playlist.new_set"), new_set_path, class: "btn btn-primary btn-sm" if authenticated? %>
  </nav>
</div>

<%= live_search_index url: sets_path, results_partial: "playlist/sets/live_search_results", placeholder: t("search.playlist"), label: t("search.playlist_label"), frame_id: "playlist-sets" %>
