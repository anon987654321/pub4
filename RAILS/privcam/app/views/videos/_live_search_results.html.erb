<ul id="videos-list" class="video-list" role="list" aria-label="Video list">
  <% @videos.each do |video| %>
    <%= render "videos/row", video: %>
  <% end %>
</ul>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "VideosInfiniteScrollReflex#load_more",
           sentinel_id: "videos-infinite-scroll-sentinel",
           q: params[:q] %>