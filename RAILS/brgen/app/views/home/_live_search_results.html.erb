<% if live_search_query.present? %>
 <p><%= t("search.results_for", count: @posts.size, query: live_search_query) %></p>
<% end %>

<% if @posts.any? %>
 <%= turbo_frame_tag "home-feed", target: "_top" do %>
 <div class="post-feed" id="home-feed">
 <% @posts.each_with_index do |post, index| %>
 <%= render "posts/post", post: post %>
 <%# One unit after every AFFILIATE_EVERY posts, never before the first and
     never trailing the last — an ad in the last slot reads as the end of the
     feed. Posts appended by HomeInfiniteScrollReflex do not carry one yet:
     the reflex renders "posts/post" per row and has no slot for anything
     else, so extending it is its own change. %>
 <% if ((index + 1) % Brgen::HomeFeed::AFFILIATE_EVERY).zero? && index + 1 < @posts.size %>
 <%= render "shared/affiliate_feed_unit" %>
 <% end %>
 <% end %>
 </div>

 <%= render "shared/infinite_scroll_sentinel",
            pagy: @pagy,
            reflex: "HomeInfiniteScrollReflex#load_more",
            sentinel_id: "home-feed-sentinel",
            q: params[:q],
            feed: params[:feed],
            sort: params[:sort] %>
 <% end %>
<% else %>
 <% if live_search_query.present? %>
   <%= render "shared/empty_state",
         title: t("empty.no_posts"),
         body: t("empty.no_posts_search"),
         action: { label: t("empty.clear_search"), path: root_path } %>
 <% elsif authenticated? %>
   <%= render "shared/empty_state",
         title: t("empty.no_posts_yet"),
         body: t("empty.start_city"),
         action: { label: t("empty.create_one"), path: new_post_path } %>
 <% else %>
   <%= render "shared/empty_state",
         title: t("empty.no_posts_yet"),
         body: t("empty.be_first"),
         action: { label: t("empty.post_to_city", city: city_name), path: new_post_path } %>
 <% end %>
<% end %>
