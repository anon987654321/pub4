<% if live_search_query.present? %>
 <p class="dim"><%= @posts.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @posts.any? %>
 <%= turbo_frame_tag "home-feed", target: "_top" do %>
 <div class="post-feed" id="home-feed">
 <% @posts.each do |post| %>
 <%= render "posts/post", post: post %>
 <% end %>
 </div>

 <%= render "shared/infinite_scroll_sentinel",
            pagy: @pagy,
            reflex: "HomeInfiniteScrollReflex#load_more",
            sentinel_id: "home-feed-sentinel",
            q: params[:q],
            feed: params[:feed],
            sort: params[:sort] %>
 <% end %>
<% else %>
 <% if live_search_query.present? %>
   <%= render "shared/empty_state",
         title: "No posts",
         body: "No posts match this search.",
         action: { label: "Clear search", path: root_path } %>
 <% elsif authenticated? %>
   <%= render "shared/empty_state",
         title: "No posts yet",
         body: "Start the conversation for your city.",
         action: { label: "Create one", path: new_post_path } %>
 <% else %>
   <%= render "shared/empty_state",
         title: "No posts yet",
         body: "Be the first — guests can post without an account.",
         action: { label: "Post to Bergen", path: new_post_path } %>
 <% end %>
<% end %>
