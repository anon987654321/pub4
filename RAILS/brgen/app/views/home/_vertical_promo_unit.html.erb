<% slug = promotion.to_s %>
<% href, host = case slug
                when "marketplace"
                  ["//#{marketplace_host}/", marketplace_host]
                when "ai"
                  [brgen_ai_url, "ai.brgen.no"]
                else
                  current_host = "#{slug}.#{Current.domain}"
                  ["//#{current_host}/", current_host]
                end %>

<aside class="brgen-vertical-promo" data-promo="<%= slug %>" aria-label="<%= t("promo.aria_label") %>">
  <%= link_to href, class: "brgen-vertical-promo__link", data: { turbo: false } do %>
    <span class="brgen-vertical-promo__disc" aria-hidden="true">
      <span class="brgen-vertical-promo__host"><%= host %></span>
      <span class="brgen-vertical-promo__dot"></span>
    </span>

    <span class="brgen-vertical-promo__copy">
      <span class="brgen-vertical-promo__kicker"><%= t("promo.#{slug}.kicker") %></span>
      <strong class="brgen-vertical-promo__title"><%= t("promo.#{slug}.title") %></strong>
      <span class="brgen-vertical-promo__body"><%= t("promo.#{slug}.body") %></span>
      <span class="brgen-vertical-promo__action">
        <%= t("promo.#{slug}.action") %> <span aria-hidden="true">→</span>
      </span>
    </span>
  <% end %>
</aside>
