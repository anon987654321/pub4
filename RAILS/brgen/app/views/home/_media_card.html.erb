
<% media_layout = %w[wide regular tall regular regular][local_assigns.fetch(:media_index, 0).to_i % 5] %>
<li class="brgen-media-card brgen-media-card--<%= media_layout %>">
  <div class="brgen-media-image">
    <% if post.image.attached? %>
      <div data-controller="lightbox">
        <a href="<%= url_for(post.image) %>" data-turbo="false" data-lg-size="1600-1200" class="brgen-media-lightbox-link">
          <%= responsive_image_tag(post.image, alt: post.title.presence || "", loading: "lazy", class: "brgen-media-image-tag") %>
        </a>
      </div>
    <% elsif post.video.attached? %>
      <%= video_tag post.video, controls: true, muted: true, playsinline: true, preload: "metadata",
            class: "brgen-media-video",
            aria: { label: post.title.presence || t("post.view") } %>
    <% end %>
  </div>
  <%= link_to post_path(post), class: "brgen-media-caption-link" do %>
    <div class="brgen-media-caption">
      <strong><%= post.title.presence || post.content.to_s.truncate(70, separator: " ") %></strong>
      <span><%= post.author_name %> · <%= time_ago_in_words(post.created_at) %></span>
    </div>
  <% end %>
</li>
