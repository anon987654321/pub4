<%# locals: (track:, position:) %>
<%# A Radio Brgen track between posts: the same player facade a post's link
    gets, under the radio's name and a way to the station. The landmark is
    named by the post it follows: a page carries several, and each needs its own. %>
<aside class="radio-unit" aria-label="<%= t("home.radio_unit.label", position:) %>">
  <%= tag.h2 link_to(t("home.radio_unit.heading"), "//radio.#{Current.domain}/") %>
  <%= render "shared/link_embed", embed: track %>
</aside>
