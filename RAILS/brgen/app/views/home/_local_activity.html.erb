<% if @local_activity && (@local_activity.listing || @local_activity.track) %>
  <aside class="local-activity" data-controller="local-activity"
         aria-label="<%= t("home.local_activity", default: "Local activity") %>">
    <div class="local-activity-heading">
      <h2><%= t("home.local_activity", default: "Local activity") %></h2>
      <button type="button" class="btn btn-ghost btn-sm"
              data-action="click->local-activity#dismiss">
        <%= t("actions.dismiss", default: "Dismiss") %>
      </button>
    </div>
    <% if @local_activity.listing %>
      <article class="local-activity-item">
        <span><%= t("home.local_marketplace", default: "New in the marketplace") %></span>
        <%= link_to @local_activity.listing.title,
              Marketplace::Engine.routes.url_helpers.listing_url(
                @local_activity.listing, host: marketplace_host, protocol: "https"
              ), data: { turbo: false } %>
        <small><%= @local_activity.listing.price_display %></small>
      </article>
    <% end %>
    <% if @local_activity.track %>
      <article class="local-activity-item">
        <span><%= t("home.local_radio", default: "New in Radio") %></span>
        <%= link_to [@local_activity.track.title, @local_activity.track.artist.presence].compact.join(" · "),
              Playlist::Engine.routes.url_helpers.hosted_track_url(
                @local_activity.track, host: "radio.#{Current.domain}", protocol: "https"
              ), data: { turbo: false } %>
      </article>
    <% end %>
  </aside>
<% end %>
