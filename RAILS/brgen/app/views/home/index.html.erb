<% content_for :title, t("pages.home_title") %>
<% content_for :widgets_includes_communities, true %>
<% content_for :widgets do %>
  <aside class="sidebar-card" data-controller="toggle" data-toggle-class="hidden">
    <div class="row-between">
      <h2><%= t("nav.communities") %></h2>
      <button type="button" class="btn btn-ghost btn-sm" data-action="click->toggle#toggle" aria-label="<%= t("nav.hide") %>"><%= t("nav.hide") %></button>
    </div>
    <ul data-toggle-target="item">
      <% @communities.each do |c| %>
        <li><%= link_to c.name, community_path(c) %></li>
      <% end %>
    </ul>
    <% if authenticated? %>
      <p><%= link_to t("nav.new_community"), new_community_path, class: "btn btn-ghost btn-sm" %></p>
    <% end %>
  </aside>
<% end %>

<%# The "Bergen, akkurat nå" intro banner and its paths/AI line were removed:
    the front page opens straight into the feed. Wayfinding to the verticals
    (main / AI / playlist / marketplace / dating) lives in the top nav, and the
    anonymous compose box sits above the posts. %>
<section id="feed-panel" aria-label="<%= t("home.local_posts") %>" data-visitor-orientation>
  <% if authenticated? %>
    <nav class="feed-tabs" aria-label="<%= t("home.feed_sort", default: "Feed") %>">
      <%= link_to t("home.feed_hot", default: "Hot"), main_app.root_path,
            class: "feed-tab#{" active" if params[:feed].blank?}" %>
      <%= link_to t("home.feed_following", default: "Following"), main_app.root_path(feed: "following"),
            class: "feed-tab#{" active" if params[:feed] == "following"}" %>
      <%= link_to t("home.feed_communities", default: "Communities"), main_app.root_path(feed: "communities"),
            class: "feed-tab#{" active" if params[:feed] == "communities"}" %>
    </nav>
  <% end %>
  <% if home_feed_following? && !authenticated? %>
    <p class="dim feed-hint"><%= link_to t("home.follow_sign_in"), new_session_path %><%= t("home.follow_hint") %></p>
  <% end %>
  <%= render "home/live_search_results" %>
</section>
