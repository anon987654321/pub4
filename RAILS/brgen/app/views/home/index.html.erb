<% content_for :title, t("pages.home_title", city: city_name) %>
<% content_for :widgets_includes_communities, true %>
<% content_for :widgets do %>
  <aside class="sidebar-card" data-controller="toggle" data-toggle-class="hidden">
    <div class="row-between">
      <%= tag.h2 t("nav.communities") %>
      <button type="button" class="btn btn-ghost btn-sm" data-action="click->toggle#toggle" aria-label="<%= t("nav.hide") %>"><%= t("nav.hide") %></button>
    </div>
    <ul data-toggle-target="item">
      <% @communities.each do |c| %>
        <li><%= link_to c.name, community_path(c) %></li>
      <% end %>
    </ul>
    <% if authenticated? %>
      <p><%= link_to t("nav.new_community"), new_community_path, class: "btn btn-ghost btn-sm" %></p>
    <% end %>
  </aside>
  <% trending_tags = Hashtag.trending.where("usage_count > 0").limit(8) %>
  <% if trending_tags.any? %>
    <aside class="sidebar-card">
      <%= tag.h2 t("nav.trending_tags", default: "Trending tags") %>
      <ul class="tag-cloud">
        <% trending_tags.each do |tag| %>
          <li><%= link_to "##{tag.name}", hashtag_path(tag.name) %></li>
        <% end %>
      </ul>
    </aside>
  <% end %>
<% end %>

<%# The "Bergen, akkurat nå" intro banner and its paths/AI line were removed:
    the front page opens straight into the feed. Wayfinding to the verticals
    (main / AI / playlist / marketplace / dating) lives in the top nav, and the
    anonymous compose box sits above the posts. %>
<%# No city-today strip. The city right now IS the feed below -- its posts, its
    people, the rooms they are in, what is for sale and what is on. A separate
    strip of links to other hosts said the same thing worse, above the thing
    itself. Operator decision 2026-08-27. %>

<section id="feed-panel" aria-label="<%= t("home.local_posts") %>" data-visitor-orientation>
  <%# Hot / New / Following / Communities order this feed, so they sit with it.
      They spent a while on the nav swiper, which was right about the second
      horizontal row being wrong and wrong about where they belonged: the swiper
      is how you leave brgen — eight verticals, each its own host — and the tab
      bar is how you move within it. An ordering is neither, and putting it on
      the wayfinding bar meant root had two controls for "go to the front page".

      `chips` rather than a tab row, and that is the part that keeps the earlier
      decision intact: four links that wrap is not a second horizontal scroller.
      communities/show uses the same control for the same job, so this invents
      no layout.

      Signed-in only, matching what the swiper group did — guest root carries no
      feed controls. %>
  <% if authenticated? %>
    <%# Fresh is the default, so it is the bare root path and Hot carries the
        parameter. `latest` still lands on fresh because it still means fresh. %>
    <% fresh = params[:feed].blank? && params[:sort].to_s != "hot" %>
    <% ranked = params[:feed].blank? && params[:sort] == "hot" %>
    <nav class="chips" aria-label="<%= t("home.feed_sort", default: "Feed") %>">
      <%= link_to t("home.feed_latest"), root_path,
            class: "chip#{" active" if fresh}",
            "aria-current": ("page" if fresh) %>
      <%= link_to t("home.feed_hot", default: "Hot"), root_path(sort: "hot"),
            class: "chip#{" active" if ranked}",
            "aria-current": ("page" if ranked) %>
      <%# Following and Communities travel with the orderings: they are which
          posts, where Hot and New are which order, and a reader picks one of
          the four. Left behind, feed=following and feed=communities would be
          implemented in the controller and reachable only by typing the query
          string. %>
      <%= link_to t("home.feed_following"), root_path(feed: "following"),
            class: "chip#{" active" if params[:feed] == "following"}",
            "aria-current": ("page" if params[:feed] == "following") %>
      <%= link_to t("home.feed_communities"), root_path(feed: "communities"),
            class: "chip#{" active" if params[:feed] == "communities"}",
            "aria-current": ("page" if params[:feed] == "communities") %>
    </nav>
  <% end %>
  <% if home_feed_following? && !authenticated? %>
    <p class="feed-hint"><%= link_to t("home.follow_sign_in"), new_session_path %><%= t("home.follow_hint") %></p>
  <% end %>
  <%= render "home/live_search_results" %>
</section>
