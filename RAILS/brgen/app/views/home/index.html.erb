<% content_for :title, t("pages.home_title", city: city_name) %>
<%# The "Bergen, akkurat nå" intro banner and its paths/AI line were removed:
    the front page opens straight into the feed. Wayfinding to the verticals
    (main / AI / playlist / marketplace / dating) lives in the top nav, and the
    anonymous compose box sits above the posts. %>
<%# No city-today strip. The city right now IS the feed below -- its posts, its
    people, the rooms they are in, what is for sale and what is on. A separate
    strip of links to other hosts said the same thing worse, above the thing
    itself. Operator decision 2026-08-27. %>

<%# BRGEN-105. The front page is live, and it does not move while you read it.
    Post#broadcast_to_city_feed prepends the new card into #feed-pending, which
    is hidden; feed_updates_controller counts what lands there and offers it on
    a chip. The stream is per city because posts are city-tenanted — one shared
    stream would put Bergen's feed on Oslo's front page.

    Both plural forms are rendered here rather than in the controller, so the
    rule stays I18n's. %>
<%# ActsAsTenant.current_tenant rather than Current.city: acts_as_tenant is what
    scopes posts by city, so its tenant is by definition the city whose feed
    this is, and Current.city is set from a domain-registry entry that need not
    be the City record. %>
<% feed_city = ActsAsTenant.current_tenant %>

<%# One row, two meanings: the nav names the views of the feed, and the
    messenger link beside it is a way out of the feed, so it sits outside the
    labelled nav rather than being read as a third view. %>
<div class="home-feed-views">
<nav class="home-feed-view-group" aria-label="<%= t("home.feed_views") %>">
  <%= link_to t("home.feed_view"), root_path(feed: params[:feed]), class: "home-feed-view#{' is-active' if params[:view].to_s != "media"}", aria: { current: ("page" if params[:view].to_s != "media") } %>
  <%= link_to t("home.media_wall_view"), root_path(feed: params[:feed], view: "media"), class: "home-feed-view#{' is-active' if params[:view].to_s == "media"}", aria: { current: ("page" if params[:view].to_s == "media") } %>
</nav>
  <%# The way into the messenger from the front page, one tap on a phone and
      visible without the tab bar, which rests hidden. It is a link to this
      host's own inbox, not the Messenger host in the swiper: the same session,
      no second sign-in. The count is the unread badge's, and its words are
      spoken because a number alone names nothing. %>
  <%= link_to conversations_path, class: "home-feed-view" do %>
    <%= t("nav.messages") %>
    <% if (unread = messenger_unread_badge) %>
      <sup class="nav_link_badge" aria-hidden="true"><%= unread %></sup>
      <span class="visually-hidden"><%= t("messages.unread_badge", count: messenger_unread_total) %></span>
    <% end %>
  <% end %>
</div>

<% if @neighborhoods.present? %>
  <form class="home-neighborhood-filter" action="<%= root_path %>" method="get"
        data-controller="auto-submit" data-auto-submit-delay-value="0">
    <% if params[:feed].present? %><input type="hidden" name="feed" value="<%= params[:feed] %>"><% end %>
    <% if params[:sort].present? %><input type="hidden" name="sort" value="<%= params[:sort] %>"><% end %>
    <% if params[:view].present? %><input type="hidden" name="view" value="<%= params[:view] %>"><% end %>
    <label for="home-neighborhood"><%= t("home.neighborhood_filter") %></label>
    <select id="home-neighborhood" name="neighborhood_id" data-action="change->auto-submit#submit">
      <option value=""><%= t("home.citywide", city: city_name) %></option>
      <% @neighborhoods.each do |neighborhood| %>
        <option value="<%= neighborhood.id %>" <%= "selected" if @neighborhood_id.to_s == neighborhood.id.to_s %>><%= neighborhood.name %></option>
      <% end %>
    </select>
    <%# Choosing a neighbourhood applies it; the button is for a browser
        without JavaScript, where nothing listens for the change. %>
    <noscript><button type="submit" class="button button-ghost"><%= t("actions.apply") %></button></noscript>
  </form>
<% end %>

<%= render "home/local_activity" %>

<section id="feed-panel" aria-label="<%= t("home.local_posts") %>" data-visitor-orientation
         data-controller="feed-updates"
         data-feed-updates-one-value="<%= t("home.new_posts.one") %>"
         data-feed-updates-other-value="<%= t("home.new_posts.other") %>"
         data-feed-updates-since-url-value="<%= posts_since_path %>"
         data-feed-updates-after-value="<%= newest_post_id %>"
         data-feed-updates-hidden-authors-value="<%= hidden_author_ids.to_json %>"
         data-feed-updates-neighborhood-value="<%= @neighborhood_id.to_i %>"
         data-feed-updates-media-value="<%= params[:view].to_s == "media" %>">
  <%# Inside the panel so the controller sees it reconnect and asks
      PostCatchUpsController for what the stream carried while it was down. %>
  <% if feed_city.respond_to?(:id) %>
    <%= turbo_stream_from Post.city_feed_stream(feed_city.id), data: { feed_updates_target: "source" } %>
  <% end %>
  <%# Where the broadcasts land. Hidden and out of the accessibility tree: these
      cards are not on the page yet in any sense a reader would recognise, and
      announcing them as they arrive is the interruption the chip exists to
      replace. %>
  <div id="feed-pending" hidden aria-hidden="true" data-feed-updates-target="pending"></div>
  <p class="chips" hidden data-feed-updates-target="chip">
    <%= button_tag type: "button", class: "chip", data: { action: "feed-updates#show" } do %>
      <span data-feed-updates-target="count"></span>
      <span class="visually-hidden"><%= t("home.show_new_posts") %></span>
    <% end %>
  </p>
  <%# No feed-ordering chips on the front page — operator decision 2026-09-17.
      Nytt / Hot / Følger / Fellesskap is a which-posts decision, and on root it
      sat above the thing it ordered. communities/show keeps its chips for the
      same job; root opens straight into the feed, and feed=following and
      feed=communities are still reachable by query string. %>
  <%# The follow hint is one sentence with the link interpolated, so a
      language orders its own words around it. %>
  <% if home_feed_following? && !authenticated? %>
    <%= tag.p t("home.follow_hint_html", sign_in: link_to(t("home.follow_sign_in"), new_session_path)),
              class: "feed-hint" %>
  <% end %>
  <%= render "home/live_search_results" %>
</section>
