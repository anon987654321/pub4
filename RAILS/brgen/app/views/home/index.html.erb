<% content_for :widgets_includes_communities, true %>
<% content_for :widgets do %>
  <aside class="sidebar-card" data-controller="toggle" data-toggle-class="hidden">
    <div class="row-between">
      <h2>Communities</h2>
      <button type="button" class="btn btn-ghost btn-sm" data-action="click->toggle#toggle" aria-label="Toggle communities">Hide</button>
    </div>
    <ul data-toggle-target="item">
      <% @communities.each do |c| %>
        <li><%= link_to c.name, community_path(c) %></li>
      <% end %>
    </ul>
    <% if authenticated? %>
      <p><%= link_to "+ New community", new_community_path, class: "btn btn-ghost btn-sm" %></p>
    <% end %>
  </aside>
<% end %>

<section class="city-home-intro" aria-label="City orientation">
  <h2 class="city-home-intro-title">Bergen, right now</h2>
  <p class="city-home-intro-body">
    Neighbourhood notes, weather-window plans, gigs, openings and the useful small things a city tells itself.
  </p>
  <p class="city-home-paths">
    <%= link_to "Live", live_path %>
    <span class="city-home-sep" aria-hidden="true">·</span>
    <%= link_to "Marketplace", marketplace_root_url %>
    <span class="city-home-sep" aria-hidden="true">·</span>
    <%= link_to "Messages", conversations_path %>
    <span class="city-home-note"> — no signup required</span>
  </p>
  <p class="city-home-ai">
    <%= link_to "Ask Brgen AI", root_path(master: 1), class: "city-home-ai-link", data: { turbo: false } %>
  </p>
</section>

<section id="feed-panel" aria-label="Local posts" data-visitor-orientation>
  <% if home_feed_following? && !authenticated? %>
    <p class="dim feed-hint"><%= link_to "Sign in", new_session_path %> to see posts from people you follow.</p>
  <% end %>
  <%= render "home/live_search_results" %>
</section>
