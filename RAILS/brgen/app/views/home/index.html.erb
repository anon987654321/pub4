<% unless authenticated? %>
  <% content_for :splash do %>
    <div data-visitor-orientation>
      <h2 id="splash-title">Brgen</h2>
      <p class="tagline">City-native social. Post, vote, discover local communities across Europe and beyond.</p>
      <nav role="navigation" class="chips" aria-label="Quick links">
        <span class="chip"><%= link_to "sign in", new_session_path %></span>
        <span class="chip"><%= link_to marketplace_subdomain, marketplace_root_url %></span>
        <span class="chip"><%= link_to "tv", tv_root_url(subdomain: "tv") %></span>
        <span class="chip"><%= link_to "dating", dating_root_url(subdomain: "dating") %></span>
        <span class="chip"><%= link_to "playlist", playlist_root_url(subdomain: "playlist") %></span>
        <span class="chip"><%= link_to "takeaway", takeaway_root_url(subdomain: "takeaway") %></span>
        <span class="chip"><%= link_to "maps", maps_maps_root_url(subdomain: "maps") %></span>
        <span class="chip"><%= link_to "messenger", messenger_root_url(subdomain: "messenger") %></span>
      </nav>
      <p class="hint">tap anywhere to browse · <%= link_to "sign in", new_session_path %> to post</p>
    </div>
  <% end %>
<% end %>

<% content_for :widgets_includes_communities, true %>
<% content_for :widgets do %>
  <aside class="sidebar-card" data-controller="toggle" data-toggle-class="hidden">
    <div class="row-between">
      <h3>Communities</h3>
      <button type="button" class="btn btn-ghost btn-sm" data-action="click->toggle#toggle" aria-label="Toggle communities">Hide</button>
    </div>
    <ul data-toggle-target="item">
      <% @communities.each do |c| %>
        <li><%= link_to c.name, community_path(c) %></li>
      <% end %>
    </ul>
    <% if authenticated? %>
      <p><%= link_to "+ New community", new_community_path, class: "btn btn-ghost btn-sm" %></p>
    <% end %>
  </aside>
<% end %>

<section id="feed-panel" aria-label="Local posts">
  <header class="local-feed-intro">
    <p class="local-feed-kicker">Bergen, right now</p>
    <p>Neighbourhood notes, weather-window plans, gigs, openings and the useful small things a city tells itself.</p>
  </header>
  <% if home_feed_following? && !authenticated? %>
    <p class="dim feed-hint"><%= link_to "Sign in", new_session_path %> to see posts from people you follow.</p>
  <% end %>
  <%= render "home/live_search_results" %>
</section>
