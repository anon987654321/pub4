<%# Replace the RSVP frame and the attendee list, so answering does not reload
    the page and lose the reader's place in a long description, and the "N
    going" beside the button is not left stale. The counts come back from the
    server rather than from an optimistic guess. %>
<%= turbo_stream.replace dom_id(@event, :rsvp) do %>
  <%= turbo_frame_tag dom_id(@event, :rsvp) do %>
    <%= render "events/rsvp", event: @event, rsvp: @event.rsvp_for(Current.user), announce: true %>
  <% end %>
<% end %>
<%= turbo_stream.replace dom_id(@event, :attendees) do %>
  <%= render "events/attendees", event: @event, attendees: @event.attendee_preview %>
<% end %>
