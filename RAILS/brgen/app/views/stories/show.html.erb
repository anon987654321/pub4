<% content_for :title, t("stories.by", user: @story.user.display_name) %>

<article class="story-viewer" aria-label="<%= t("stories.by", user: @story.user.display_name) %>">
  <header class="story-viewer-head">
    <p>
      <%= tag.strong @story.user.display_name %>
      ·
      <%# The countdown reads the row's own expires_at rather than re-deriving
          24 hours from created_at, so the label, the alive scope and the sweep
          cannot disagree. %>
      <time datetime="<%= @story.expires_at.iso8601 %>">
        <%= t("stories.expires_in", time: distance_of_time_in_words(Time.current, @story.expires_at)) %>
      </time>
    </p>
    <%= link_to t("actions.close"), stories_path, class: "btn btn-ghost btn-sm" %>
  </header>

  <% if @story.media.attached? %>
    <div class="story-media">
      <%= image_tag @story.media.variant(resize_to_limit: [ 1_080, 1_920 ], format: :webp), alt: @story.caption.to_s, width: 1080, height: 1920 %>
    </div>
  <% end %>

  <% if @story.caption.present? %>
    <p class="story-caption"><%= @story.caption %></p>
  <% end %>

  <% if @ring.size > 1 %>
    <nav class="story-ring-nav" aria-label="<%= t("stories.more_from", user: @story.user.display_name) %>">
      <% @ring.each_with_index do |story, index| %>
        <%= link_to (index + 1), story_path(story),
              class: "chip#{" active" if story.id == @story.id}",
              aria: { current: (story.id == @story.id ? "page" : nil) } %>
      <% end %>
    </nav>
  <% end %>

  <%# Answering goes to the pair's DM thread, so it is still there tomorrow when
      the story is not. The author has nobody to answer but themselves. %>
  <% if Current.user && Current.user.id != @story.user_id %>
    <%= form_with url: story_replies_path(@story), method: :post, class: "story-reply" do |f| %>
      <%= f.label :content, t("stories.reply_label") %>
      <%= f.text_field :content, required: true, maxlength: 500, placeholder: t("stories.reply_placeholder") %>
      <%= f.submit t("actions.send"), class: "btn btn-sm" %>
    <% end %>
  <% end %>

  <%# The viewer list is the author's alone. Everyone else sees the count. %>
  <% if @viewers %>
    <section role="region" aria-label="<%= t("stories.seen_by") %>">
      <%= tag.h2 t("stories.seen_count", count: @story.views_count) %>
      <ul class="viewer-list">
        <% @viewers.each do |view| %>
          <li><%= view.user.display_name %></li>
        <% end %>
      </ul>
      <%= button_to t("actions.delete"), story_path(@story), method: :delete,
            class: "btn btn-ghost btn-sm",
            data: { turbo_confirm: t("stories.confirm_delete") } %>
    </section>
  <% else %>
    <p><%= t("stories.seen_count", count: @story.views_count) %></p>
  <% end %>
</article>
