<%# Out of the index: the address is a secret token. %>
<% content_for :head, robots_meta(index: false) %>
<%# A section: the application layout already provides <main id="main-content">. %>
<section class="form-wrap">
  <h1><%= t("email_preferences.title") %></h1>
  <p><%= t("email_preferences.intro") %></p>

  <%= form_with scope: :email_subscription, url: email_subscription_path(token: @subscription.token), method: :patch do |form| %>
    <fieldset>
      <legend><%= t("email_preferences.marketing_legend") %></legend>
      <label>
        <%= form.check_box :marketing, { checked: @subscription.agreed_to_marketing? }, "1", "0" %>
        <%= t("email_preferences.marketing_label") %>
      </label>
      <p><%= t("email_preferences.marketing_help") %></p>
    </fieldset>

    <%= form.submit t("email_preferences.save"), class: "button" %>
  <% end %>

  <hr>

  <h2><%= t("email_preferences.unsubscribe_title") %></h2>
  <p><%= t("email_preferences.unsubscribe_help") %></p>
  <%# destructive: no-confirm-ok — reversible — the address can subscribe again from any newsletter form %>
  <%= button_to t("email_preferences.unsubscribe"), email_subscription_path(token: @subscription.token),
        method: :delete, class: "button button-ghost" %>
</section>
