<%# At rest this is one thin pill and nothing else — avatar, prompt, no field.
    Clicking it opens the composer as a floating dialog rather than growing the
    feed downward, which is the Facebook shape: the resting row stays the same
    height whether or not you are writing, and the writing surface gets the
    whole screen's attention instead of competing with the post below it.

    The <dialog> carries the real form. It is in the DOM at rest (so the browser
    owns focus trapping, Esc, and the backdrop) but not rendered until
    showModal(). %>
<div class="compose-launcher" data-controller="feed-compose">
  <button type="button" class="compose-trigger" data-action="click->feed-compose#open">
    <% if guest? %>
      <span class="compose-avatar" aria-hidden="true">G</span>
    <% else %>
      <%= image_tag Current.user.avatar_url, class: "compose-avatar", alt: "" %>
    <% end %>
    <span class="compose-trigger-prompt"><%= t("feed.compose_prompt") %></span>
  </button>

  <dialog class="composer" data-feed-compose-target="dialog"
          data-action="click->feed-compose#backdropClose close->feed-compose#closed">
    <%= form_with model: Post.new, url: main_app.posts_path, class: "composer-form",
          data: { controller: "form-submit", feed_compose_target: "box", action: "submit->form-submit#lock" } do |f| %>
      <header class="composer-header">
        <h2 class="composer-title"><%= t("feed.compose_title", default: "Post to %{city}", city: city_name) %></h2>
        <button type="button" class="composer-close" data-action="click->feed-compose#close"
                aria-label="<%= t("common.close", default: "Close") %>">
          <%= icon :close, size: 20 %>
        </button>
      </header>

      <div class="composer-author">
        <% if guest? %>
          <span class="compose-avatar" aria-hidden="true">G</span>
          <span class="composer-author-name">
            <%= t("feed.posting_as_guest", default: "Posting as a guest") %>
            <%= f.hidden_field :anonymous, value: true %>
          </span>
        <% else %>
          <%= image_tag Current.user.avatar_url, class: "compose-avatar", alt: "" %>
          <span class="composer-author-name"><%= Current.user.display_name %></span>
        <% end %>
      </div>

      <div class="composer-body" data-controller="tiptap-editor">
        <%= f.label :content, t("feed.compose_title", default: "Post to %{city}", city: city_name), class: "visually-hidden" %>
        <%= f.hidden_field :title, data: { feed_compose_target: "title" } %>
        <%= f.text_area :content,
              rows: 3,
              placeholder: t("feed.compose_prompt"),
              class: "compose-input",
              data: {
                controller: "textarea-autogrow",
                feed_compose_target: "input",
                tiptap_editor_target: "field",
                action: "input->feed-compose#syncTitle"
              } %>
        <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
        <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar">
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bold" title="Bold"><b>B</b></button>
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#italic" title="Italic"><i>i</i></button>
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bulletList" title="Bullet list">•</button>
        </div>
      </div>

      <div class="composer-attach">
        <span class="composer-attach-label"><%= t("feed.add_to_post", default: "Add to your post") %></span>
        <div class="compose-actions">
          <%# Each of these wraps its input in a <label>, which normally names it —
              but the label's only content is an aria-hidden icon, so the
              accessible name computes to "". title= is a tooltip, not a name.
              The three inputs read as "unlabelled file upload" to a screen
              reader, one after another, with nothing to tell them apart.
              aria-label rather than visible text: these are 20px icon buttons in
              a row and adding words would redesign the compose bar. %>
          <label class="compose-action" title="<%= t("compose.add_photo", default: "Add photo") %>">
            <%= icon :camera, size: 20 %>
            <%= f.file_field :image, accept: "image/*", capture: "environment",
                  class: "visually-hidden", aria: { label: t("compose.add_photo", default: "Add photo") },
                  data: { action: "change->feed-compose#mediaSelected" } %>
          </label>
          <label class="compose-action" title="<%= t("compose.record_video", default: "Record video") %>">
            <%= icon :video, size: 20 %>
            <%= f.file_field :video, accept: "video/*", capture: "environment",
                  class: "visually-hidden", aria: { label: t("compose.record_video", default: "Record video") },
                  data: { action: "change->feed-compose#mediaSelected" } %>
          </label>
          <label class="compose-action" title="<%= t("compose.record_audio", default: "Record audio") %>">
            <%= icon :mic, size: 20 %>
            <%= f.file_field :audio, accept: "audio/*", capture: "user",
                  class: "visually-hidden", aria: { label: t("compose.record_audio", default: "Record audio") },
                  data: { action: "change->feed-compose#mediaSelected" } %>
          </label>
        </div>
      </div>

      <%= f.submit t("feed.post_action"), class: "btn btn-primary composer-submit" %>

      <%# The guest hint used to be a <details> whose summary repeated the author
          row above it word for word -- "Du poster som gjest" twice in one
          dialog, the second time as a disclosure triangle hiding the only part
          that was new. The author row states who you are; this states the one
          consequence, in the open. %>
      <div class="dim compose-hint">
        <% if guest? %>
          <%# Two sentences, so two elements. Rendered as siblings in one text
              node they ran together as "…15 innlegg per nettleser The limit
              slows spam…" with no separator at all. %>
          <p><%= t("feed.guest_hint", limit: Shared::AnonymousPost::LIMIT) %></p>
          <p><%= t("feed.guest_limit_why") %></p>
        <% else %>
          <%= link_to t("feed.advanced_post"), main_app.new_post_path, class: "link-inherit" %>
        <% end %>
      </div>
    <% end %>
  </dialog>
</div>
