<div class="sidebar-card">
  <%= tag.h3 t("newsletter.title") %>
  <p><%= t("newsletter.body") %></p>
  <%= form_with url: main_app.email_subscriptions_path, method: :post do |f| %>
    <div class="field mb-8">
      <%= f.email_field :email, name: "email_subscription[email]",
            placeholder: t("newsletter.email_placeholder"), aria: { label: t("newsletter.email_placeholder") }, required: true,
            autocomplete: "email", class: "map-search-input", inputmode: "email" %>
    </div>
    <label class="field--check-label">
      <input type="checkbox" name="email_subscription[agreed_to_marketing]" value="1">
      <%= t("newsletter.marketing_consent") %>
    </label>
    <%= f.submit t("newsletter.subscribe"), class: "btn btn-primary btn-sm btn-block" %>
  <% end %>
</div>
