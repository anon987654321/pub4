<% if items.present? %>
  <aside class="also-nearby">
    <%= tag.h2 title %>
    <ul>
      <% items.each do |item| %>
        <% href = record_public_href(item) %>
        <li>
          <% if href.present? %>
            <%= link_to item.try(:title) || item.try(:name), href %>
          <% else %>
            <%= item.try(:title) || item.try(:name) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </aside>
<% end %>
