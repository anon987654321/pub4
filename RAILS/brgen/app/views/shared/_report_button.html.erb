<span id="report_<%= dom_id(target) %>">
  <%= button_to t("actions.report"), main_app.reports_path,
      params: { target_gid: target.to_signed_global_id.to_s, reason: reason || "other" },
      data: { turbo_stream: true },
      aria: { label: t("a11y.report_target", type: target.class.model_name.human.downcase) } %>
</span>
