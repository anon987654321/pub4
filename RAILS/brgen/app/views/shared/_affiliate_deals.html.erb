<%# Affiliate, not Tradedoubler: one read path over every network, so a new
    one appears here without editing this view. %>
<% deals = affiliate_deals_for(category: local_assigns[:category], limit: 6) %>
<% if deals.any? %>
  <div class="sidebar-card">
    <%= tag.h3 t("affiliate.deals_title") %>
    <% deals.each do |d| %>
      <a href="<%= d.click_url %>" target="_blank" rel="noopener sponsored" class="affiliate-deal">
        <% if d.image_url.present? %>
          <%# Was emitting loading="lazy" twice on the same tag. %>
          <img loading="lazy" alt="<%= d.title.presence || t("affiliate.deal_alt") %>" src="<%= d.image_url %>">
        <% end %>
        <div>
          <p class="affiliate-title"><%= d.title %></p>
          <p class="affiliate-merchant"><%= d.merchant %></p>
          <% if d.price.present? %>
            <p class="deal-price"><%= d.currency %> <%= d.price %></p>
          <% end %>
          <%# Placeholder inventory is seeded so this surface can be demoed before
              brgen.no is an approved TradeDoubler publisher. Label it: an
              unlabelled placeholder is indistinguishable from a paid deal, both
              to the visitor and to whoever reconciles the payout. %>
          <% if d.placeholder %>
            <p><%= t("affiliate.placeholder_notice") %></p>
          <% end %>
        </div>
      </a>
    <% end %>
    <%= render "shared/affiliate_disclosure" %>
  </div>
<% end %>
