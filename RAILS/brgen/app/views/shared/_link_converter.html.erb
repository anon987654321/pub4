<%# Server-side TradeDoubler Link Converter. Script is synced by LinkConverterSyncJob
    to public/js/td-lc.js so ad blockers targeting tradedoubler.com do not strip it. %>
<% if Tradedoubler.link_converter_configured? && File.exist?(Rails.public_path.join("js/td-lc.js")) %>
  <script type="text/javascript">
    window.tdlcAsyncInit = function() {
      var epi = <%= raw(
        Tradedoubler.epi_for(
          city: (defined?(Current) && (Current.try(:city) || Current.try(:city_record)&.try(:slug))),
          surface: (defined?(Current) && Current.try(:subapp)) || "web"
        ).to_json
      ) %>;
      if (epi) { window.tdlc_epi = epi; }
      if (typeof TDLinkConverter !== "undefined") {
        TDLinkConverter.init({ tdlc_epi: window.tdlc_epi });
      }
    };
    (function(d, s) {
      var js, fjs = d.getElementsByTagName(s)[0];
      var id = "td-link-converter";
      if (d.getElementById(id)) return;
      js = d.createElement(s);
      js.id = id;
      js.async = true;
      js.src = "/js/td-lc.js";
      fjs.parentNode.insertBefore(js, fjs);
    })(document, "script");
  </script>
<% end %>
