<span id="follow_<%= user.id %>">
  <% if current_user == user %>
  <% elsif active %>
    <%= button_to t("actions.unfollow"), unfollow_user_path(user), method: :delete,
        data: { turbo_stream: true }, aria: { label: "Unfollow #{user.display_name}" } %>
  <% else %>
    <%= button_to t("actions.follow"), follow_user_path(user), method: :post,
        data: { turbo_stream: true }, aria: { label: "Follow #{user.display_name}" } %>
  <% end %>
</span>
