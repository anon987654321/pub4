<% communities = Community.popular.limit(4) %>
<% if communities.any? && !content_for?(:widgets_includes_communities) %>
  <div class="sidebar-card" data-controller="scroll-reveal" data-minimal-reveal>
    <h2><%= t("nav.communities") %></h2>
    <ul class="who-follow">
      <% communities.each do |community| %>
        <li><%= link_to community.name, community_path(community) %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<% if authenticated? %>
  <div class="sidebar-card" data-controller="scroll-reveal" data-minimal-reveal>
    <h3>Your feed</h3>
    <p class="dim"><%= link_to t("nav.new_post"), new_post_path %> · <%= link_to t("nav.messages"), conversations_path %></p>
  </div>
<% end %>
