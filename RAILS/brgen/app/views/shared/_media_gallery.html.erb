<% attachments = local_assigns.fetch(:attachments, []) %>
<% title = local_assigns.fetch(:title, "Gallery") %>

<% if attachments.any? %>
  <section
    data-controller="lightbox swipe"
    data-swipe-mode-value="carousel"
    data-action="pointerdown->swipe#pointerDown pointermove->swipe#pointerMove pointerup->swipe#pointerUp pointercancel->swipe#pointerUp touchstart->swipe#pointerDown touchmove->swipe#pointerMove touchend->swipe#pointerUp"
    aria-label="<%= title %>"
  >
    <div class="media-gallery">
      <% attachments.each do |attachment| %>
        <a href="<%= url_for(attachment) %>" class="media-gallery-item">
          <%= lazy_image_tag attachment, alt: title, blurhash: attachment.try(:metadata).try(:[], "blurhash") %>
        </a>
      <% end %>
    </div>
  </section>
<% end %>
