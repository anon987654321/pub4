<% channel_content = capture do %>
  <% if channel.live? %><span class="live-badge">Live</span><% end %>
<% end %>
<%= render "shared/x_card",
  avatar_url: (channel.avatar.attached? ? url_for(channel.avatar) : nil),
  name: channel.name,
  meta: "#{channel.subscribers_count} subscribers",
  content: channel_content.presence,
  url: tv_channel_path(channel),
  class: "x-tv" %>
