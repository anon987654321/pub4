<% content_for :title, @video.title %>

<div class="page-header">
  <div>
    <p class="dim"><%= link_to @video.channel.name, tv_channel_path(@video.channel) %></p>
    <h1><%= @video.title %></h1>
  </div>
  <button class="btn-share" data-controller="share"
          data-share-title-value="<%= @video.title %>"
          data-share-url-value="<%= request.original_url %>"
          data-action="click->share#share">Share</button>
</div>

<div data-controller="tv-player" data-tv-player-auto-wake-lock-value="true" data-tv-player-auto-orientation-value="true" data-tv-player-orientation-value="landscape">
<% if @video.video_file.attached? %>
  <div class="tv-media">
    <%= video_tag url_for(@video.video_file), controls: true, class: "video-player #{tv_media_image_classes(@video.video_file)}" %>
  </div>
<% elsif @video.thumbnail.attached? %>
  <div class="tv-media">
    <%= image_tag @video.thumbnail, class: tv_media_image_classes(@video.thumbnail) %>
  </div>
<% end %>
</div>

<article>
  <div class="chips">
    <span class="chip"><span data-controller="animated-number"
                             data-animated-number-start-value="0"
                             data-animated-number-end-value="<%= @video.views_count.to_i %>"
                             data-animated-number-duration-value="900"><%= @video.views_count.to_i %></span> views</span>
    <span class="chip"><%= @video.duration_formatted %></span>
    <span class="chip"><%= @video.status %></span>
    <% if @video.published_at.present? %><span class="chip"><span data-controller="timeago"><%= time_ago_in_words(@video.published_at) %> ago</span></span><% end %>
  </div>
  <% if @video.description.present? %>
    <p class="mt-12"><%= simple_format(@video.description) %></p>
  <% else %>
    <p class="dim">No description yet.</p>
  <% end %>
</article>

<section>
  <h2>Channel</h2>
  <article>
    <strong><%= link_to @video.channel.name, tv_channel_path(@video.channel) %></strong>
    <p class="dim">
      <span data-controller="animated-number"
            data-animated-number-start-value="0"
            data-animated-number-end-value="<%= @video.channel.subscribers_count.to_i %>"
            data-animated-number-duration-value="900"><%= @video.channel.subscribers_count.to_i %></span> subscribers ·
      <span data-controller="animated-number"
            data-animated-number-start-value="0"
            data-animated-number-end-value="<%= @video.channel.total_views.to_i %>"
            data-animated-number-duration-value="900"><%= @video.channel.total_views.to_i %></span> total views
    </p>
    <% if authenticated? && Current.user != @video.channel.user %>
      <% if @video.channel.subscriptions.exists?(user: Current.user) %>
        <%= button_to "Unsubscribe", unsubscribe_tv_channel_path(@video.channel), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to "Subscribe", subscribe_tv_channel_path(@video.channel), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </article>
</section>

<section>
  <h2>Notes</h2>
  <div id="video_notes_<%= @video.id %>">
    <% @video.video_notes.chronological.includes(:user).each do |note| %>
      <article id="<%= dom_id(note) %>">
        <p class="dim"><% if note.timestamp.present? %><%= note.timestamp %> · <% end %><%= note.user&.email_address || "viewer" %></p>
        <p><%= note.body %></p>
      </article>
    <% end %>
  </div>
  <% if authenticated? %>
    <%= form_with url: tv_video_video_notes_path(@video), scope: :video_note, id: "video_note_form", data: { turbo: true } do |f| %>
      <div class="field">
        <%= f.label :body, "Add a note" %>
        <%= f.text_area :body, rows: 2, placeholder: "Timestamped note…", data: { controller: "char-counter", "char-counter-max-value": 2000 } %>
        <span class="char-counter" data-char-counter-target="counter"></span>
      </div>
      <div class="field">
        <%= f.label :timestamp, "Timestamp (seconds)" %>
        <%= f.number_field :timestamp, min: 0, step: 1 %>
      </div>
      <%= f.submit "Save note", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
</section>

<section>
  <h2>Discussion</h2>
  <% if @video.comments.any? %>
    <% @video.comments.order(created_at: :asc).each do |comment| %>
      <article>
        <p class="dim"><%= comment.user.email_address %></p>
        <p><%= comment.body %></p>
      </article>
    <% end %>
  <% else %>
    <p class="dim">No comments yet.</p>
  <% end %>
  <% if authenticated? %>
    <%= form_with url: tv_video_comments_path(@video), data: { turbo: true } do |f| %>
      <div class="field">
        <%= f.label :body, "Add a comment" %>
        <%= f.text_area :body, rows: 3, placeholder: "Write something…", data: { controller: "char-counter", "char-counter-max-value": 1000 } %>
        <span class="char-counter" data-char-counter-target="counter"></span>
      </div>
      <%= f.submit "Post comment", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
</section>
