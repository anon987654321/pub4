<% content_for :title, "Brgen TV" %>

<div class="page-header" role="banner" aria-label="TV header" data-visitor-orientation>
  <div>
    <h1>Brgen TV</h1>
    <p class="dim">Local channels, shows, and live stages — watch without an account.</p>
  </div>
  <div>
    <%= link_to "All channels", tv_channels_path, class: "btn btn-ghost" %>
    <% if authenticated? %><%= link_to "Create channel", new_tv_channel_path, class: "btn" %><% end %>
  </div>
</div>

<% if @live.any? %>
  <section role="region" aria-label="Live streams now">
    <h2>Live now</h2>
    <% @live.each do |b| %>
      <%= render "shared/feed_card",
        name: b.title,
        handle: b.channel.name,
        content: capture { %(<span class="live-badge">Live</span>).html_safe },
        url: tv_channel_path(b.channel),
        class: "tv" %>
    <% end %>
  </section>
<% end %>

<section role="region" aria-label="Trending content">
  <h2>Trending</h2>
  <% if @trending.any? %>
    <%= render "tv/home/trending_videos" %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_trending"),
          body: "Check back as channels publish.",
          action: { label: "All channels", path: tv_channels_path } %>
  <% end %>
</section>

<section role="region" aria-label="Recent content">
  <h2>Recent</h2>
  <%= render partial: "tv/videos/tv_video", collection: @recent, as: :tv_video %>
</section>
