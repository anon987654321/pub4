<% content_for :title, "Brgen TV" %>

<% unless authenticated? %>
  <% content_for :splash do %>
    <div>
      <h2>Brgen TV</h2>
      <p class="tagline">Live streams and videos from your city. Channels, broadcasts, subscriptions.</p>
      <div class="chips">
        <span class="chip">live stream</span>
        <span class="chip">city channels</span>
        <span class="chip">subscribe</span>
        <span class="chip">stream key</span>
      </div>
      <p class="hint">tap anywhere to browse · <%= link_to "sign in", new_session_path, style: "color:inherit" %> to broadcast</p>
    </div>
  <% end %>
<% end %>

<div class="page-header" role="banner" aria-label="TV header">
  <h1>Brgen TV</h1>
  <div>
    <%= link_to "All channels", tv_channels_path, class: "btn btn-ghost" %>
    <% if authenticated? %><%= link_to "Create channel", new_tv_channel_path, class: "btn" %><% end %>
  </div>
</div>

<% if @live.any? %>
  <section role="region" aria-label="Live streams now">
    <h2>Live now</h2>
    <% @live.each do |b| %>
      <%= render "shared/x_card",
        name: b.title,
        handle: b.channel.name,
        content: capture { %(<span class="live-badge">Live</span>).html_safe },
        url: tv_channel_path(b.channel),
        class: "x-tv" %>
    <% end %>
  </section>
<% end %>

<section role="region" aria-label="Trending content">
  <h2>Trending</h2>
  <% if @trending.any? %>
    <%= render "tv/home/trending_videos" %>
  <% else %>
    <div class="empty empty-state"><p>No trending videos yet.</p></div>
  <% end %>
</section>

<section role="region" aria-label="Recent content">
  <h2>Recent</h2>
  <%= render @recent %>
</section>
