<% content_for :title, t("bookmark.saved_title", default: "Saved") %>

<header class="page-header">
  <%= tag.h1 t("bookmark.saved_title", default: "Saved") %>
</header>

<% if @posts.any? %>
  <ul class="post-feed feed_list">
    <% @posts.each do |post| %>
      <li><%= render "posts/post", post: post %></li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("bookmark.empty_title", default: "Nothing saved yet"),
        body: t("bookmark.empty_body", default: "Tap Save on any post to keep it here."),
        action: { label: t("empty.city_feed"), path: root_path } %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
