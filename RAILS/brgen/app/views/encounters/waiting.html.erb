<% content_for :title, t("encounters.title") %>

<header aria-label="<%= t("encounters.title") %>">
  <%= tag.h1 t("encounters.title") %>
</header>

<section aria-live="polite">
  <p><%= t("encounters.looking") %></p>
  <p><%= t("encounters.looking_note") %></p>
  <%# destructive: no-confirm-ok - reversible - nothing is lost: a wait that is
      abandoned can be asked for again, and nothing has been said yet. %>
  <%= button_to t("encounters.leave"), encounters_path, method: :delete %>
</section>
