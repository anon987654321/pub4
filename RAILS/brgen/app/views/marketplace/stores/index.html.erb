<% content_for :title, t("marketplace.stores.title", default: "Stores") %>

<%= render "marketplace/nav_bar",
      active: "stores",
      search_url: marketplace_shops_path(vertical: params[:vertical]),
      search_placeholder: "Search Markedsplass",
      cart_count: (Current.user.present? ? Current.user.marketplace_orders.where(status: "pending").count : 0) %>

<%= tag.section class: "marketplace-stores", role: "region", "aria-label": "Marketplace stores" do %>
  <%= tag.h1 class: "visually-hidden" do %><%= t("marketplace.stores.title", default: "Stores") %><% end %>

  <%= tag.nav class: "deal-cats", role: "navigation", "aria-label": "Store categories" do %>
    <% Marketplace::Store::VERTICALS.each do |vertical| %>
      <%= link_to vertical.humanize, marketplace_shops_path(vertical: vertical),
            class: "deal-cat#{" active" if params[:vertical].to_s == vertical}" %>
    <% end %>
  <% end %>

  <%= live_search_index url: marketplace_shops_path(vertical: params[:vertical]), results_partial: "marketplace/stores/live_search_results", placeholder: "Search...", label: "Store search", frame_id: "marketplace-stores" %>
<% end %>
