<% content_for :title, t("marketplace.stores.title", default: "Stores") %>

<%= tag.section class: "marketplace-stores", role: "region", "aria-label": "Marketplace stores" do %>
  <%= tag.header role: "banner", "aria-label": "Stores header" do %>
    <%= tag.h1 t("marketplace.stores.title", default: "Stores") %>
    <nav role="navigation" aria-label="Open store action">
      <%= link_to t("marketplace.stores.open", default: "Open a store"), new_marketplace_shop_path %>
    </nav>
  <% end %>

  <%= tag.nav role: "navigation", "aria-label": "Store categories" do %>
    <% Marketplace::Store::VERTICALS.each do |vertical| %>
      <%= link_to vertical.humanize, marketplace_shops_path(vertical: vertical) %>
    <% end %>
  <% end %>

  <%= live_search_index url: marketplace_shops_path(vertical: params[:vertical]), results_partial: "marketplace/stores/live_search_results", placeholder: "Search stores…", label: "Store search", frame_id: "marketplace-stores" %>
<% end %>