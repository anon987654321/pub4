<% if live_search_query.present? %>
 <p class="dim"><%= @stores.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @stores.any? %>
<div class="store-grid" id="marketplace-stores-grid" role="list" aria-label="Stores list">
 <% @stores.each do |store| %>
   <%= render "marketplace/stores/card", store: store %>
 <% end %>
</div>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "StoresInfiniteScrollReflex#load_more",
           sentinel_id: "marketplace-stores-sentinel",
           q: params[:q],
           vertical: params[:vertical] %>
<% else %>
 <p class="empty empty-state">No stores match this search.</p>
<% end %>