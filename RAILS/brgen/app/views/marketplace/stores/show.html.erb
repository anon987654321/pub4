<% content_for :title, @store.name %>

<%= tag.section class: "marketplace-store" do %>
  <%= tag.header do %>
    <%= tag.h1 @store.name %>
    <%= tag.p @store.vertical&.humanize if @store.vertical.present? %>
    <%= tag.p @store.description if @store.description.present? %>
    <% if authenticated? && Current.user == @store.owner %>
      <%= tag.nav class: "cluster" do %>
        <%= link_to t("marketplace.stores.edit", default: "Edit store"), edit_marketplace_shop_path(@store.slug), class: "btn btn-ghost btn-sm" %>
        <%= button_to t("marketplace.stores.delete", default: "Delete store"), marketplace_shop_path(@store.slug), method: :delete, data: { turbo_confirm: t("marketplace.stores.delete_confirm", default: "Delete store?") }, class: "btn btn-danger btn-sm" %>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.div class: "listing-grid" do %>
    <% @listings.each do |listing| %>
      <%= tag.article class: "listing-card" do %>
        <%= tag.h2 link_to(listing.title, marketplace_listing_path(listing)) %>
        <%= tag.p listing.price_display %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
