<%# Amazon Nav Bar structure — styles in _marketplace_nav_bar.scss (exact from source pen). %>
<% active = local_assigns.fetch(:active, "listings") %>
<% search_url = local_assigns.fetch(:search_url, marketplace_listings_path) %>
<% search_placeholder = local_assigns.fetch(:search_placeholder, "Give me all your money") %>
<% cart_count = local_assigns[:cart_count] %>

<div id="navBar">
  <div id="topHalf">
    <div id="logoWrapper">
      <%= link_to marketplace_root_path, id: "logo", class: "marketplace-logo-link", aria: { label: "Markedsplass" } do %>
        <%= render "marketplace/animated_logo" %>
      <% end %>
    </div>
    <div class="search marketplace-nav-search" data-controller="search-focus">
      <%= form_with url: search_url, method: :get, local: true do %>
        <input type="search" name="q" value="<%= params[:q] %>" placeholder="<%= search_placeholder %>" aria-label="Search marketplace" data-action="focus->search-focus#focus blur->search-focus#blur" />
      <% end %>
    </div>
    <% if local_assigns[:banner_src].present? %>
      <img id="backToSchool" src="<%= local_assigns[:banner_src] %>" alt="" />
    <% end %>
  </div>

  <div id="bottomHalf">
    <div id="department">Departments</div>
    <div id="sections">
      <%= link_to "Listings", marketplace_listings_path, class: "section#{" section--active" if active == "listings"}" %>
      <%= link_to "Today's Deals", marketplace_deals_path, class: "section#{" section--active" if active == "deals"}" %>
      <%= link_to "Stores", marketplace_shops_path, class: "section#{" section--active" if active == "stores"}" %>
      <% if authenticated? %>
        <%= link_to "Sell", new_marketplace_listing_path, class: "section" %>
      <% end %>
      <%= link_to "Help", marketplace_listings_path, class: "section" %>
    </div>
    <div id="accountStuff">
      <% if authenticated? %>
        <%= link_to "Your Account", user_path(Current.user), class: "section" %>
        <%= link_to "Lists", marketplace_saved_searches_path, class: "section" %>
        <%= link_to "Cart#{cart_count.to_i.positive? ? " (#{cart_count})" : ""}", marketplace_cart_path, class: "section#{" section--active" if active == "cart"}" %>
      <% else %>
        <%= link_to "Your Account", new_session_path, class: "section" %>
        <%= link_to "Cart", new_session_path, class: "section" %>
      <% end %>
    </div>
  </div>
</div>
