<% content_for :title, "Your Cart" %>

<%= render "marketplace/nav_bar",
      active: "cart",
      search_url: marketplace_listings_path,
      search_placeholder: t("search.marketplace"),
      cart_count: @cart_items.size %>

<div class="page-header" role="banner" aria-label="Cart header">
  <h1>Your Cart</h1>
  <p class="dim"><%= pluralize(@cart_items.size, "item") %></p>
</div>

<% if @cart_items.any? %>
  <div class="cart-items">
    <% @cart_items.each do |item| %>
      <div class="cart-item">
        <div>
          <strong><%= link_to item.listing.title, marketplace_listing_path(item.listing) %></strong>
          <div class="dim"><%= item.listing.price_display %> × <%= item.quantity || 1 %></div>
        </div>
        <div class="text-end">
          <strong><%= item.total_display %></strong>
          <div>
            <%= button_to "Remove", marketplace_listing_order_path(item.listing, item),
                  method: :patch, params: { decline: true }, class: "btn btn-ghost btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="cart-summary">
    <p><strong>Total: <%= @cart_total / 100.0 %> NOK</strong></p>
    <p class="dim">Pay with Vipps (NO) or Stripe (cards), or send classic offers sellers accept/decline.</p>

    <div class="cart-pay-actions" role="group" aria-label="Payment methods">
      <%= button_to "Pay with Vipps", marketplace_checkout_path,
            method: :post, params: { provider: "vipps" },
            class: "btn btn-primary cart-pay-vipps",
            form: { data: { turbo: false } } %>
      <%= button_to "Pay with Stripe", marketplace_checkout_path,
            method: :post, params: { provider: "stripe" },
            class: "btn btn-ghost cart-pay-stripe",
            form: { data: { turbo: false } } %>
    </div>
    <%# Was: "Without VIPPS_EPAYMENT_* / STRIPE_SECRET_KEY the cart fails
        honestly ("not configured") — never fakes a charge." Environment
        variable names in a shopping cart are a note to ourselves. The promise
        underneath is worth keeping; the deploy detail is not. %>
    <p class="hint mt-8">If a payment provider is unavailable we say so. We never take a payment we cannot process.</p>

    <%= button_to "Send all offers", send_offers_marketplace_cart_path,
          method: :post, class: "btn btn-ghost",
          data: { turbo_confirm: "Notify all sellers about your pending offers?" } %>
    <p class="hint mt-8">Sellers get a notification for each pending offer. They accept or decline individually.</p>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: "Your cart is empty",
        body: "Browse listings and send offers — guests can shop without signup.",
        action: { label: "Browse marketplace", path: marketplace_root_path } %>
<% end %>
