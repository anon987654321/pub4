<%= render "shared/feed_card",
  avatar_url: (deal.listing.photos.attached? ? url_for(deal.listing.photos.first) : nil),
  name: deal.headline,
  handle: deal.listing.title,
  meta: deal.badge.presence,
  content: capture { %(<div class="price">#{deal.listing.price_display}</div>).html_safe },
  url: marketplace_deal_path(deal),
  class: "deal" %>
