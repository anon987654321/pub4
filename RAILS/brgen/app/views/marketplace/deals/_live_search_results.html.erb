<% if live_search_query.present? %>
 <p class="dim"><%= @deals.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @featured_deals&.any? && live_search_query.blank? %>
 <section class="featured-deals">
 <h2><%= t("marketplace.deals.featured", default: "Featured deals") %></h2>
 <% @featured_deals.each do |deal| %>
 <article class="deal-card featured">
 <h3><%= link_to deal.headline, marketplace_deal_path(deal) %></h3>
 <% if deal.badge.present? %><p><%= deal.badge %></p><% end %>
 </article>
 <% end %>
 </section>
<% end %>

<% if @deals.any? %>
<div class="deal-grid" id="marketplace-deals-grid">
 <% @deals.each do |deal| %>
   <%= render "marketplace/deals/card", deal: deal %>
 <% end %>
</div>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "DealsInfiniteScrollReflex#load_more",
           sentinel_id: "marketplace-deals-sentinel",
           q: params[:q] %>
<% else %>
 <p class="empty empty-state">No deals match this search.</p>
<% end %>