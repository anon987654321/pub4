<% content_for :title, @category.name %>

<div class="page-header" role="banner" aria-label="Marketplace category header">
  <h1><%= @category.name %></h1>
</div>

<turbo-frame id="marketplace-category" data-turbo-action="replace">
<div id="marketplace-category-listings" class="deal-grid" role="region" aria-label="Category listings">
<% @listings.each do |listing| %>
  <%= render "marketplace/listings/card", listing: %>
<% end %>
<% if @listings.empty? %>
  <div class="empty" role="status" aria-live="polite"><p>No listings in this category.</p></div>
<% end %>
</div>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "CategoryListingsInfiniteScrollReflex#load_more",
           sentinel_id: "marketplace-category-sentinel",
           category_id: @category.id %>
</turbo-frame>
