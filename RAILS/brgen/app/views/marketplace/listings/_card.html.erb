<% listing_actions = capture do %>
  <%= link_to "View", marketplace_listing_path(listing), class: "feed-action" %>
  <% if authenticated? %>
    <%= button_to "Add to cart", marketplace_listing_orders_path(listing), params: { quantity: 1 }, class: "feed-action feed-action--primary" %>
  <% end %>
<% end %>
<% listing_content = capture do %>
  <div class="price"><%= listing.price_display %></div>
  <% if listing.reviews_count.to_i.positive? %>
    <div class="feed-card-meta"><%= number_with_precision(listing.rating, precision: 1) %> ★ <%= pluralize(listing.reviews_count, "review") %></div>
  <% end %>
<% end %>
<%= render "shared/feed_card",
  avatar_url: (listing.photos.attached? ? url_for(listing.photos.first) : nil),
  name: listing.title,
  handle: listing.user&.display_name ? "@#{listing.user.display_name.parameterize}" : nil,
  time: time_ago_in_words(listing.created_at),
  meta: [
    listing.location,
    listing.condition,
    (local_assigns[:distance_km] ? "#{number_with_precision(local_assigns[:distance_km], precision: 1)} km away" : nil),
    listing.category&.name,
    pluralize(listing.views_count.to_i, "view")
  ].compact.join(" · "),
  content: listing_content,
  actions: listing_actions,
  url: marketplace_listing_path(listing),
  class: "listing",
  data_attributes: "data-product-id=\"#{listing.id}\"" %>
