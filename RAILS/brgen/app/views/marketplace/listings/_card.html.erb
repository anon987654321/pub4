<% distance_km = local_assigns[:distance_km] %>
<% photo = listing.photos.attached? ? listing.photos.first : nil %>
<% favorited = local_assigns.fetch(:favorited) {
     @favorited_listing_ids&.include?(listing.id)
   } %>
<%# Tise-style tile: photo wall + price first; heart overlays the photo. %>
<article class="deal-card listing" data-product-id="<%= listing.id %>">
  <div class="deal-card-fav-slot">
    <%= render "marketplace/listings/favorite_button", listing: listing, favorited: favorited == true %>
  </div>

  <%= link_to marketplace_listing_path(listing),
        class: "deal-card-hit",
        aria: { label: "#{listing.title}, #{listing.price_display}" } do %>
    <div class="deal-card-img">
      <% if photo %>
        <%= responsive_image_tag photo, alt: "", widths: [360, 720], sizes: "(max-width: 768px) 50vw, 220px" %>
      <% else %>
        <div class="deal-card-placeholder" aria-hidden="true">
          <span><%= listing.title.to_s.first&.upcase || "?" %></span>
        </div>
      <% end %>
      <% if listing.sold? %>
        <span class="deal-badge">Sold</span>
      <% elsif listing.condition.present? %>
        <span class="deal-badge deal-badge--soft"><%= listing.condition.tr("_", " ") %></span>
      <% end %>
    </div>

    <div class="deal-card-body">
      <div class="deal-price"><%= listing.price_display %></div>
      <h2 class="deal-card-title"><%= listing.title %></h2>
      <div class="deal-meta">
        <% meta_bits = [
             listing.location,
             (distance_km ? "#{number_with_precision(distance_km, precision: 1)} km away" : nil),
             listing.category&.name,
             pluralize(listing.views_count.to_i, "view")
           ].compact %>
        <%= meta_bits.join(" · ") %>
      </div>
      <% if listing.reviews_count.to_i.positive? %>
        <div class="deal-meta deal-meta--rating">
          <span class="deal-rating" aria-label="<%= number_with_precision(listing.rating, precision: 1) %> of 5">
            <%= number_with_precision(listing.rating, precision: 1) %> ★
          </span>
          <%= pluralize(listing.reviews_count, "review") %>
        </div>
      <% end %>
    </div>
  <% end %>
</article>
