<% listing = local_assigns.fetch(:listing) %>
<% favorited = local_assigns.fetch(:favorited) {
     authenticated? && listing.favorite_for(Current.user).present?
   } %>
<% if authenticated? %>
  <% if favorited %>
    <%= button_to marketplace_listing_favorite_path(listing),
          method: :delete,
          class: "deal-fav deal-fav--on",
          form: { class: "deal-fav-form", data: { turbo: true } },
          aria: { label: "Remove from saved", pressed: true } do %>
      <%= icon :like, size: 18 %>
    <% end %>
  <% else %>
    <%= button_to marketplace_listing_favorite_path(listing),
          method: :post,
          class: "deal-fav",
          form: { class: "deal-fav-form", data: { turbo: true } },
          aria: { label: "Save listing", pressed: false } do %>
      <%= icon :like, size: 18 %>
    <% end %>
  <% end %>
<% else %>
  <%= link_to new_session_path,
        class: "deal-fav",
        aria: { label: "Sign in to save" } do %>
    <%= icon :like, size: 18 %>
  <% end %>
<% end %>
