<% content_for :title, t("marketplace.saved_searches") %>

<div class="page-header" role="banner" aria-label="Saved searches header">
  <div>
    <p class="dim">Marketplace alerts</p>
    <h1><%= t("marketplace.saved_searches") %></h1>
  </div>
  <%= link_to "Browse", marketplace_listings_path, class: "btn btn-ghost" %>
</div>

<% if @saved_searches.any? %>
  <div class="post-grid">
    <% @saved_searches.each do |saved_search| %>
      <% search_actions = capture do %>
        <%= link_to "Run", marketplace_listings_path(q: saved_search.query, category_id: saved_search.category_id), class: "feed-action feed-action--primary" %>
        <%= button_to "Delete", marketplace_saved_search_path(saved_search), method: :delete, class: "feed-action" %>
      <% end %>
      <%= render "shared/feed_card",
        name: saved_search.title,
        meta: [
          saved_search.query.presence || "Any query",
          saved_search.category&.name,
          saved_search.location.presence,
          (saved_search.notify? ? "alerts on" : nil)
        ].compact.join(" · "),
        actions: search_actions,
        url: marketplace_listings_path(q: saved_search.query, category_id: saved_search.category_id),
        class: "listing" %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_saved_searches"),
        body: t("actions.save_search_body"),
        action: { label: "Browse listings", path: marketplace_listings_path } %>
<% end %>
