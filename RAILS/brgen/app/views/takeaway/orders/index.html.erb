<% content_for :title, "My Orders" %>

<div class="page-header" role="banner" aria-label="My orders header"><h1>My Orders</h1></div>

<section id="takeaway-orders-list" class="order-list" role="list" aria-label="Order history">
  <% @orders.each do |order| %>
    <%= render "takeaway/orders/order", order: %>
  <% end %>
</section>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "OrdersInfiniteScrollReflex#load_more",
           sentinel_id: "takeaway-orders-sentinel" %>
