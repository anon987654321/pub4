<%= turbo_frame_tag "takeaway-restaurants-list", target: "_top" do %>
<section role="region" aria-label="Restaurant results" id="takeaway-restaurants-list">
  <% @restaurants.each do |r| %>
    <%= render "takeaway/restaurants/card", restaurant: r %>
  <% end %>
  <% if @restaurants.empty? %>
    <% if authenticated? %>
      <%= render "shared/empty_state",
            title: t("empty.no_restaurants"),
            body: "Add the first restaurant for this area.",
            action: { label: "Add one", path: new_takeaway_restaurant_path } %>
    <% else %>
      <%= render "shared/empty_state",
            title: t("empty.no_restaurants"),
            body: "Restaurants will appear here.",
            action: { label: "City feed", path: root_path } %>
    <% end %>
  <% end %>
</section>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "RestaurantsInfiniteScrollReflex#load_more",
           sentinel_id: "takeaway-restaurants-sentinel",
           q: params[:q],
           cuisine: params[:cuisine] %>
<% end %>
