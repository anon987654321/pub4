<% content_for :title, @restaurant.name %>

<div class="page-header" role="banner" aria-label="Takeaway restaurant header">
  <h1><%= @restaurant.name %></h1>
  <nav role="navigation" aria-label="Restaurant actions">
    <% if authenticated? && @restaurant.owner?(Current.user) %>
      <%= link_to "Edit", edit_takeaway_restaurant_path(@restaurant), class: "btn btn-ghost btn-sm" %>
    <% elsif Current.user.present? && @favorited %>
      <%= button_to "Unsave", takeaway_restaurant_favorite_restaurant_path(@restaurant), method: :delete, class: "btn btn-ghost btn-sm" %>
    <% elsif Current.user.present? %>
      <%= button_to "Save", takeaway_restaurant_favorite_restaurant_path(@restaurant), method: :post, class: "btn btn-primary btn-sm" %>
    <% end %>
  </nav>
</div>

<article>
  <p><%= @restaurant.description %></p>
  <p class="dim"><%= @restaurant.cuisine_type %> · <%= @restaurant.address %>, <%= @restaurant.city_label %></p>
  <p class="dim">Min order: <%= @restaurant.min_order_display %> · Delivery: <%= @restaurant.delivery_fee_display %> · <%= pluralize(@restaurant.favorites.size, "save") %></p>
</article>

<% if authenticated? && @restaurant.owner?(Current.user) %>
  <section>
    <h2>Add menu item</h2>
    <div class="form-wrap">
      <%= form_with scope: :takeaway_menu_item, url: takeaway_restaurant_menu_items_path(@restaurant) do |f| %>
        <div class="field"><%= f.text_field :name, placeholder: "Name", required: true %></div>
        <div class="field"><%= f.number_field :price_cents, placeholder: "Price (øre)", required: true %></div>
        <div class="field"><%= f.text_field :description, placeholder: "Description" %></div>
        <div class="field field--check"><%= f.check_box :available, checked: true %><%= f.label :available %></div>
        <div class="field field--check"><%= f.check_box :vegetarian %><%= f.label :vegetarian %></div>
        <div class="field field--check"><%= f.check_box :vegan %><%= f.label :vegan %></div>
        <div class="field"><%= f.submit t("takeaway.add"), class: "btn btn-primary btn-sm" %></div>
      <% end %>
    </div>
  </section>
<% end %>

<section id="menu">
  <h2>Menu</h2>
  <% if @menu_items.empty? %>
    <%= render "shared/empty_state",
          title: t("empty.no_menu"),
          body: "The kitchen has not listed food yet.",
          action: { label: t("actions.all_restaurants"), path: takeaway_restaurants_path } %>

  <% elsif Current.user.present? %>
    <%= form_with scope: :takeaway_order, url: takeaway_restaurant_orders_path(@restaurant) do |f| %>
      <% @menu_items.each do |item| %>
        <article class="menu-row<%= " sold-out" unless item.available? %>" data-available="<%= item.available? %>">
          <% if item.photo.attached? %>
            <%= responsive_image_tag(item.photo, alt: item.name, loading: "lazy", class: "menu-row__photo") %>
          <% end %>
          <div>
            <strong><%= item.name %></strong> · <%= item.price_display %>
            <% unless item.available? %><span class="sold-out-badge">Sold out</span><% end %>
            <% if item.vegetarian? %><span class="chip">Vegetarian</span><% end %>
            <% if item.vegan? %><span class="chip">Vegan</span><% end %>
            <% if item.description.present? %><p class="dim"><%= item.description %></p><% end %>
          </div>
          <% if item.available? %>
            <%= number_field_tag "takeaway_order[items][#{item.id}]", 0, min: 0, class: "qty-field", aria: { label: "Quantity for #{item.name}" } %>
          <% else %>
            <span class="dim" aria-label="<%= item.name %> sold out">—</span>
          <% end %>
        </article>
      <% end %>
      <div class="field">
        <%= f.label :delivery_address, t("takeaway.delivery_address") %>
        <%= f.text_field :delivery_address, required: true %>
      </div>
      <div class="field">
        <%= f.label :special_instructions, t("takeaway.special_instructions") %>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :special_instructions , maxlength: 500, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
      </div>
      <div class="field"><%= f.submit t("takeaway.place_order"), class: "btn btn-primary" %></div>
    <% end %>
  <% else %>
    <% @menu_items.each do |item| %>
      <article class="menu-row<%= " sold-out" unless item.available? %>" data-available="<%= item.available? %>">
        <% if item.photo.attached? %>
          <%= responsive_image_tag(item.photo, alt: item.name, loading: "lazy", class: "menu-row__photo") %>
        <% end %>
        <div>
          <strong><%= item.name %></strong> · <%= item.price_display %>
          <% unless item.available? %><span class="sold-out-badge">Sold out</span><% end %>
          <% if item.description.present? %><p class="dim"><%= item.description %></p><% end %>
        </div>
      </article>
    <% end %>
    <p class="dim">Reload to place an order — guests can order without signup.</p>
    <p><%= link_to "Reload", takeaway_restaurant_path(@restaurant), class: "btn btn-primary" %></p>

  <% end %>
</section>

<section>
  <h2>Reviews from neighbours</h2>
  <% if @reviews.any? %>
    <% @reviews.each do |r| %>
      <article>
        <p>★<%= r.rating %> · <%= r.user&.display_name || "anon" %> · <span data-controller="timeago"><%= time_ago_in_words(r.created_at) %> ago</span></p>
        <% if r.body.present? %><p class="dim"><%= r.body %></p><% end %>
      </article>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_reviews"),
          body: "Order, then leave a rating for neighbours.",
          action: { label: "Browse menu", path: takeaway_restaurant_path(@restaurant, anchor: "menu") } %>
  <% end %>
</section>

<% if @can_review %>
<section>
  <h2>Leave a review</h2>
  <%= form_with scope: :takeaway_review, url: takeaway_restaurant_reviews_path(@restaurant) do |f| %>
    <div class="field">
      <%= f.label :rating, t("takeaway.rating") %>
      <%= f.number_field :rating, min: 1, max: 5, required: true %>
    </div>
    <div class="field">
      <%= f.label :body, t("takeaway.comments_optional") %>
      <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :body, rows: 3 , maxlength: 1000, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
    </div>
    <div class="field"><%= f.submit t("marketplace.post_review"), class: "btn btn-primary btn-sm" %></div>
  <% end %>
</section>
<% end %>
