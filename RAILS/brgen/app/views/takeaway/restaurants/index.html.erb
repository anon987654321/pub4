<% content_for :title, "Takeaway" %>

<div class="page-header" role="banner" aria-label="Takeaway header">
  <h1>Order food</h1>
  <nav role="navigation" aria-label="Takeaway actions">
    <%= link_to "Add restaurant", new_takeaway_restaurant_path, class: "btn" if authenticated? %>
  </nav>
</div>

<%= live_search_index url: takeaway_restaurants_path, results_partial: "takeaway/restaurants/live_search_results", placeholder: "Search restaurants…", label: "Restaurant search", frame_id: "takeaway-restaurants" do |f| %>
  <%= f.select :cuisine, [["All cuisines", ""]] + Takeaway::Restaurant::CUISINE_TYPES.map { |c| [c, c] }, { selected: params[:cuisine] }, {} %>
<% end %>