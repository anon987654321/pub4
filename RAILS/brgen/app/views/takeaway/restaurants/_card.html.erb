<% restaurant_content = capture do %>
  <div class="x-meta">
    <%= restaurant.city %> · ★ <%= restaurant.rating || "—" %>
  </div>
  <div class="x-meta">
    <span class="eta-badge">25–35 min</span> · Min order: <%= restaurant.min_order_cents.to_i / 100.0 %> NOK · Delivery: <%= restaurant.delivery_fee_cents.to_i / 100.0 %> NOK
  </div>
<% end %>
<%= render "shared/x_card",
  name: restaurant.name,
  url: takeaway_restaurant_path(restaurant),
  handle: restaurant.cuisine_type,
  content: restaurant_content,
  actions: link_to("View", takeaway_restaurant_path(restaurant), class: "x-act"),
  class: "x-takeaway" %>
