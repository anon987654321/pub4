<%= turbo_frame_tag dom_id(post) do %>
  <% cache [post, Current.user&.id] do %>
    <% post_actions = capture do %>
      <button type="button" class="x-act" aria-label="Comment, <%= post.comment_count %> comments" data-controller="x-action popover" data-action="click->x-action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" data-x-action-url-value="<%= post_comments_path(post) %>" data-x-action-count-value="<%= post.comment_count %>"><%= render "shared/x_feed_icon", name: "comment" %> <span class="x-count" data-x-action-target="count"><%= post.comment_count %></span><template data-popover-target="content"><div data-popover-target="card">Comment</div></template></button>
      <button type="button" class="x-act" aria-label="Repost" data-controller="x-action popover" data-action="click->x-action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide"><%= render "shared/x_feed_icon", name: "repost" %><template data-popover-target="content"><div data-popover-target="card">Repost</div></template></button>
      <button type="button" class="x-act<%= " active" if authenticated? && post.upvoted_by?(Current.user) %>" aria-label="Vote, score <%= post.score %>" aria-pressed="<%= authenticated? && post.upvoted_by?(Current.user) %>" data-controller="x-action popover" data-action="click->x-action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" data-x-action-url-value="<%= post_vote_path(post) %>" data-x-action-count-value="<%= post.score %>" data-x-action-param-value="1"><%= render "shared/x_feed_icon", name: "upvote" %> <span class="x-count" data-x-action-target="count"><%= post.score %></span><template data-popover-target="content"><div data-popover-target="card">Vote</div></template></button>
      <button type="button" class="x-act" aria-label="More actions" data-controller="popover" data-action="mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide"><%= render "shared/x_feed_icon", name: "more" %><template data-popover-target="content"><div data-popover-target="card">More</div></template></button>
      <button type="button" class="x-act" data-controller="clipboard popover" data-clipboard-source-value="<%= post_url(post) %>" data-action="click->clipboard#copy mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" aria-label="Share post"><%= render "shared/x_feed_icon", name: "share" %><template data-popover-target="content"><div data-popover-target="card">Share</div></template></button>
    <% end %>
    <%= render "shared/x_card",
      avatar_url: nil,
      name: post.author_name,
      handle: (post.community ? "@#{post.community.slug}" : nil),
      time: time_ago_in_words(post.created_at),
      title: post.title,
      url: post_path(post),
      media: (post.image.attached? ? link_to(responsive_image_tag(post.image, alt: post.title, loading: "lazy", class: "post-image"), post) : nil),
      actions: post_actions,
      class: "x-post" %>
  <% end %>
<% end %>
