<%= turbo_frame_tag dom_id(post) do %>
  <% cache [post, Current.user&.id] do %>
    <% post_actions = capture do %>
      <button type="button" class="feed-action" aria-label="Comment, <%= post.comment_count %> comments" data-controller="action popover" data-action="click->action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" data-action-url-value="<%= post_comments_path(post) %>" data-action-count-value="<%= post.comment_count %>"><%= render "shared/feed_icon", name: "comment" %> <span class="feed-action-count" data-action-target="count"><%= post.comment_count %></span><template data-popover-target="content"><div data-popover-target="card">Comment</div></template></button>
      <button type="button" class="feed-action" aria-label="Repost" data-controller="action popover" data-action="click->action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide"><%= render "shared/feed_icon", name: "repost" %><template data-popover-target="content"><div data-popover-target="card">Repost</div></template></button>
      <button type="button" class="feed-action<%= " active" if Current.user.present? && post.upvoted_by?(Current.user) %>" aria-label="Vote, score <%= post.score %>" aria-pressed="<%= Current.user.present? && post.upvoted_by?(Current.user) %>" data-controller="action popover" data-action="click->action#toggle mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" data-action-url-value="<%= post_vote_path(post) %>" data-action-count-value="<%= post.score %>" data-action-param-value="1"><%= render "shared/feed_icon", name: "upvote" %> <span class="feed-action-count" data-action-target="count"><%= post.score %></span><template data-popover-target="content"><div data-popover-target="card">Vote</div></template></button>
      <div class="feed-action-menu" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button type="button" class="feed-action" aria-label="More actions" aria-expanded="false" data-dropdown-button data-action="click->dropdown#toggle"><%= render "shared/feed_icon", name: "more" %></button>
        <div class="feed-action-menu-list hidden" data-dropdown-target="menu">
          <button type="button" data-controller="clipboard" data-clipboard-source-value="<%= post_url(post) %>" data-action="click->clipboard#copy">Copy link</button>
          <%= link_to "View post", post_path(post) %>
        </div>
      </div>
      <button type="button" class="feed-action" data-controller="clipboard popover" data-clipboard-source-value="<%= post_url(post) %>" data-action="click->clipboard#copy mouseenter->popover#show mouseleave->popover#hide focus->popover#show blur->popover#hide" aria-label="Share post"><%= render "shared/feed_icon", name: "share" %><template data-popover-target="content"><div data-popover-target="card">Share</div></template></button>
    <% end %>
    <%= render "shared/feed_card",
      avatar_url: post.author_avatar_url,
      name: post.author_name,
      handle: (post.community ? "@#{post.community.slug}" : nil),
      time: time_ago_in_words(post.created_at),
      title: post.title,
      url: post_path(post),
      media: (post.image.attached? ? link_to(responsive_image_tag(post.image, alt: post.title, loading: "lazy", class: "post-image"), post) : nil),
      actions: post_actions,
      class: "feed-card" %>
  <% end %>
<% end %>
