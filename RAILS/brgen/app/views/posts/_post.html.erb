<%= turbo_frame_tag dom_id(post) do %>
  <% cache [post, Current.user&.id] do %>
    <% post_actions = capture do %>
      <button type="button" class="x-act" aria-label="Comment, <%= post.comment_count %> comments" data-controller="x-action" data-action="click->x-action#toggle" data-x-action-url-value="<%= post_comments_path(post) %>" data-x-action-count-value="<%= post.comment_count %>"><%= render "shared/x_feed_icon", name: "comment" %> <span class="x-count" data-x-action-target="count"><%= post.comment_count %></span></button>
      <button type="button" class="x-act" aria-label="Repost" data-controller="x-action" data-action="click->x-action#toggle"><%= render "shared/x_feed_icon", name: "repost" %></button>
      <button type="button" class="x-act" aria-label="Vote, score <%= post.score %>" data-controller="x-action" data-action="click->x-action#toggle" data-x-action-url-value="<%= post_vote_path(post) %>" data-x-action-count-value="<%= post.score %>"><%= render "shared/x_feed_icon", name: "upvote" %> <span class="x-count" data-x-action-target="count"><%= post.score %></span></button>
      <button type="button" class="x-act" aria-label="More actions"><%= render "shared/x_feed_icon", name: "more" %></button>
      <button type="button" class="x-act" data-controller="clipboard" data-clipboard-source-value="<%= post_url(post) %>" data-action="click->clipboard#copy" aria-label="Share post"><%= render "shared/x_feed_icon", name: "share" %></button>
    <% end %>
    <%= render "shared/x_card",
      avatar_url: nil,
      name: post.author_name,
      handle: (post.community ? "@#{post.community.slug}" : nil),
      time: time_ago_in_words(post.created_at),
      title: post.title,
      url: post_path(post),
      media: (post.image.attached? ? link_to(responsive_image_tag(post.image, alt: post.title, loading: "lazy", class: "post-image"), post) : nil),
      actions: post_actions,
      class: "x-post" %>
  <% end %>
<% end %>