<%# target: _top so a tap on the title leaves the page. Without it, Turbo
    loads posts#show into this frame — the show template has no matching
    id, and the card becomes "Content missing". Vote still replaces the
    frame via turbo_stream; only <a> navigation is affected. %>
<%= turbo_frame_tag dom_id(post), target: "_top" do %>
<%# Keyed on the viewer's vote, not the viewer. The only user-specific output in
    here is post.upvoted_by?(Current.user), twice — the active class and
    aria-pressed on the vote button; everything else, shared/_post_card
    included, derives from the post. Keying on Current.user&.id gave every
    visitor their own copy, and brgen mints a fresh guest user for every request
    that arrives without a session cookie, so for crawlers the fragment cache
    never hit once and each visit wrote 25 single-use entries into the store.
    voted_by? has three outcomes, so this collapses to at most three variants
    per post and renders identically. %>
  <%# reposted_by? is user-specific output inside a shared fragment, so it has to
      be in the key or one viewer's repost state renders for everyone. Computed
      once here and passed down rather than called three times per card. %>
  <% reposted = post.reposted_by?(Current.user) %>
  <% quote = post.quote_comment_by(Current.user) %>
  <% cache [post, post.voted_by?(Current.user), reposted, quote] do %>
    <% post_actions = capture do %>
      <button type="button" class="feed-action"
              aria-label="<%= t("post.comment_aria", count: post.comment_count, default: "Comment, %{count} comments") %>"
              data-controller="action"
              data-action="click->action#toggle"
              title="<%= t("comments.submit") %>"
              data-action-url-value="<%= post_comments_path(post) %>"
              data-action-count-value="<%= post.comment_count %>">
        <%= render "shared/feed_icon", name: "comment" %>
        <span class="feed-action-count" data-action-target="count"><%= post.comment_count %></span>
      </button>
      <%# This button spent a long time with nothing behind it — first carrying
          data-controller="action" with no URL, so a press added the active
          class, sent nothing, and claimed the repost had landed until the next
          render took it back; then with no controller at all, which was at
          least honest. Repost exists now, so it is wired.

          button_to, not the `action` controller the vote button uses: that
          would be a third Stimulus instance on every card, and
          FrontPageWeightTest caps a post at five. A form costs none, works
          without JS, and Turbo swaps the card from the turbo_stream response —
          so the count comes back from the server rather than from an optimistic
          guess that has to be rolled back when the request fails. %>
      <%= button_to post_repost_path(post),
                    method: :post,
                    class: "feed-action#{" active" if reposted}",
                    form_class: "feed-action-form",
                    aria: { label: t("post.repost", default: "Repost"), pressed: reposted },
                    title: t("post.repost", default: "Repost") do %>
        <%= render "shared/feed_icon", name: "repost" %>
        <span class="feed-action-count"><%= post.reposts_count.positive? ? post.reposts_count : "" %></span>
      <% end %>
      <button type="button" class="feed-action<%= " active" if Current.user.present? && post.upvoted_by?(Current.user) %>"
              aria-label="<%= t("post.vote_aria", score: post.score, default: "Vote, score %{score}") %>"
              aria-pressed="<%= Current.user.present? && post.upvoted_by?(Current.user) %>"
              data-controller="action"
              data-action="click->action#toggle"
              title="<%= t("post.vote", default: "Vote") %>"
              data-action-url-value="<%= post_vote_path(post) %>"
              data-action-count-value="<%= post.score %>"
              data-action-param-value="1">
        <%= render "shared/feed_icon", name: "upvote" %>
        <span class="feed-action-count" data-action-target="count"><%= post.score %></span>
      </button>
      <div class="feed-action-menu" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button type="button" class="feed-action" aria-label="<%= t("post.more_actions", default: "More actions") %>"
                aria-expanded="false" data-dropdown-button data-action="click->dropdown#toggle">
          <%= render "shared/feed_icon", name: "more" %>
        </button>
        <div class="feed-action-menu-list hidden" data-dropdown-target="menu">
          <button type="button" data-controller="clipboard" data-clipboard-source-value="<%= post_url(post) %>"
                  data-action="click->clipboard#copy"><%= t("post.copy_link", default: "Copy link") %></button>
          <%= link_to t("post.view", default: "View post"), post_path(post) %>
          <%= form_with url: post_repost_path(post), method: :post, class: "feed-quote-form" do %>
            <%= text_area_tag :comment, quote, maxlength: Repost::COMMENT_MAX, required: true,
                  rows: 2, placeholder: t("post.quote_placeholder"),
                  aria: { label: t("post.quote") } %>
            <%= submit_tag t("post.quote") %>
          <% end %>
        </div>
      </div>
      <button type="button" class="feed-action"
              data-controller="clipboard"
              data-clipboard-source-value="<%= post_url(post) %>"
              data-action="click->clipboard#copy"
              title="<%= t("post.share_short", default: "Share") %>"
              aria-label="<%= t("post.share", default: "Share post") %>">
        <%= render "shared/feed_icon", name: "share" %>
      </button>
    <% end %>

    <%= render "shared/post_card",
          post: post,
          variant: :card,
          name: post.author_name,
          avatar_url: post.author_avatar_url,
          handle: (post.community ? "@#{post.community.slug}" : nil),
          time: time_ago_in_words(post.created_at),
          title: post.title,
          content: nil,
          url: post_path(post),
          media: (post.image.attached? ? link_to(responsive_image_tag(post.image, alt: post.title, loading: "lazy", class: "post-image"), post) : nil),
          actions: post_actions,
          frame: false,
          class: "feed-card" %>
  <% end %>
<% end %>
