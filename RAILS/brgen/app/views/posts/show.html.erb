<% content_for :title, @post.title %>
<% content_for :description, meta_description_for(@post) %>
<% content_for :json_ld, json_ld_for(@post, type: :article) %>
<% if @post.image.attached? %>
  <% content_for :og_image, seo_image_url(@post.image) %>
<% end %>
<%= turbo_stream_from @post %>

<article class="feed-post-show">
  <%= turbo_frame_tag "post-vote-#{@post.id}", "aria-live": "polite" do %>
    <div class="feed-post-votes" role="group" aria-label="<%= t("posts.score") %>">
      <%# Guests vote everywhere else -- the feed card renders a live vote
          button for them and VotesController only asks for require_user_session.
          Gating on authenticated? here left a soft guest looking at a dead,
          aria-hidden icon on the post's own page with nothing explaining why. %>
      <% if authenticated? || guest? %>
        <%= button_to post_vote_path(@post), params: { vote: { value: 1 } },
              class: "vote-btn#{" active-up" if @post.upvoted_by?(Current.user)}",
              form: { class: "vote-form" },
              aria: { label: t("posts.upvote") } do %>
          <%= render "shared/feed_icon", name: "upvote" %>
        <% end %>
      <% else %>
        <span class="vote-btn" aria-hidden="true"><%= render "shared/feed_icon", name: "upvote" %></span>
      <% end %>
      <span class="vote-score"
            data-controller="animated-number"
            data-animated-number-start-value="0"
            data-animated-number-end-value="<%= @post.score.to_i %>"
            data-animated-number-duration-value="900"
            aria-label="<%= t("posts.score") %>"><%= @post.score %></span>
      <% if authenticated? || guest? %>
        <%= button_to post_vote_path(@post), params: { vote: { value: -1 } },
              class: "vote-btn down#{" active-down" if @post.downvoted_by?(Current.user)}",
              form: { class: "vote-form" },
              aria: { label: t("posts.downvote") } do %>
          <%= render "shared/feed_icon", name: "downvote" %>
        <% end %>
      <% else %>
        <span class="vote-btn down" aria-hidden="true"><%= render "shared/feed_icon", name: "downvote" %></span>
      <% end %>
    </div>
  <% end %>

  <p class="feed-post-show-meta">
    <% if @post.community %>
      <%= link_to @post.community.name, community_path(@post.community) %> ·
    <% end %>
    <%= @post.author_name %> ·
    <time datetime="<%= @post.created_at.iso8601 %>"><%= time_ago(@post.created_at) %></time>
    <% if @post.reading_time_minutes.positive? %>
      · <%= t("posts.min_read", n: @post.reading_time_minutes) %>
    <% end %>
  </p>

  <%= tag.h1 @post.title %>

  <% if @post.image.attached? %>
    <div data-controller="lightbox">
      <a href="<%= url_for(@post.image) %>" data-lg-size="1600-1200">
        <%= responsive_image_tag @post.image, alt: @post.title, class: "post-image" %>
      </a>
    </div>
  <% end %>

  <% if @post.content.present? %>
    <div class="post_body prose"><%= sanitize @post.content, tags: %w[p br strong em b i ul ol li], attributes: [] %></div>
  <% end %>

  <%= render "posts/crosspost", post: @post, targets: @crosspost_targets, crossposts: @crossposts %>

  <section id="quotes" class="post-quotes">
    <%= tag.h2 t("post.quotes") %>
    <%= form_with url: post_repost_path(@post), method: :post, class: "feed-quote-form" do %>
      <%= text_area_tag :comment, @quote_comment, maxlength: Repost::COMMENT_MAX, required: true,
            rows: 3, placeholder: t("post.quote_placeholder"),
            aria: { label: t("post.quote") } %>
      <%= submit_tag t("post.quote"), class: "btn btn-sm" %>
    <% end %>
    <% if @quotes.any? %>
      <ul>
        <% @quotes.each do |repost| %>
          <li>
            <blockquote>
              <%= tag.p repost.comment %>
              <cite><%= repost.user.display_name %></cite>
            </blockquote>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div class="feed-post-actions">
    <button type="button" class="feed-action" data-controller="share"
            data-share-title-value="<%= @post.title %>"
            data-share-url-value="<%= request.original_url %>"
            data-action="click->share#share" aria-label="<%= t("posts.share_post") %>">
      <%= render "shared/feed_icon", name: "share" %> <%= t("posts.share") %>
    </button>
    <%# shared/_report_button, ReportsController, ModerationWorkflow, the admin
        queue and the notification job all existed, but no view rendered the
        partial -- the moderation pipeline had no inlet. Gated on authenticated?
        because ReportsController requires a real account. %>
    <% if authenticated? %>
      <% if Current.user.bookmarked?(@post) %>
        <%= button_to t("bookmark.unsave", default: "Unsave"), unbookmark_post_path(@post), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to t("bookmark.save", default: "Save"), bookmark_post_path(@post), method: :post, class: "btn btn-ghost btn-sm" %>
      <% end %>
      <%= render "shared/report_button", target: @post, reason: nil %>
    <% end %>
  </div>
</article>

<section id="comments-section">
  <h2>
    <%= t("comments.submit") %>
    <%= tag.strong Current.user&.guest? ? t("chat.anon") : (Current.user&.username || t("chat.anon")) %>
    <% unless authenticated? %> · <%= link_to t("nav.sign_in"), new_session_path %><% end %>
  </h2>
  <% if authenticated? || guest? %>
    <%= render "comments/form", comment: @new_comment, commentable: @post %>
  <% end %>

  <% if @comments.any? %>
    <nav class="comment-sort feed-tabs" aria-label="<%= t("comments.sort_label", default: "Sort comments") %>">
      <% PostsController::COMMENT_SORTS.each do |sort| %>
        <%= link_to t("comments.sort.#{sort}", default: sort.capitalize),
              main_app.post_path(@post, sort: sort),
              class: "feed-tab#{" active" if @comment_sort == sort}" %>
      <% end %>
    </nav>
  <% end %>

  <%# A div, not a ul: the shared comment partial is a turbo-frame wrapping an
      article. A list whose children are neither li was invalid, and turbo
      append of the first comment left the empty-state li in place because
      create.turbo_stream only appends. %>
  <div id="comments">
    <% if @comments.any? %>
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    <% else %>
      <div id="comments_empty"><%= render "shared/empty_state",
            title: t("empty.no_comments"),
            body: t("comments.empty_body"),
            action: { label: t("comments.write_reply"), path: "#comments-section" } %></div>
    <% end %>
  </div>
</section>

<aside class="post-show-aside">
  <%= tag.h2 t("posts.about") %>
  <% if @post.community %>
    <%= tag.p @post.community.description.presence || @post.community.name %>
    <%= link_to t("posts.view_community"), community_path(@post.community) %>
  <% else %>
    <%= tag.p t("posts.community_platform", city: city_name) %>
  <% end %>
</aside>
