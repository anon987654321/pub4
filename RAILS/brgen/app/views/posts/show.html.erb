<% content_for :title, @post.title %>
<% content_for :description, meta_description_for(@post) %>
<% content_for :json_ld, json_ld_for(@post, type: :article) %>
<%= turbo_stream_from @post %>

<article class="feed-post-show">
  <%= turbo_frame_tag "post-vote-#{@post.id}" do %>
    <div class="feed-post-votes" role="group" aria-label="Post score">
      <%# Guests vote everywhere else -- the feed card renders a live vote
          button for them and VotesController only asks for require_user_session.
          Gating on authenticated? here left a soft guest looking at a dead,
          aria-hidden icon on the post's own page with nothing explaining why. %>
      <% if authenticated? || guest? %>
        <%= button_to post_vote_path(@post), params: { vote: { value: 1 } },
              class: "vote-btn#{" active-up" if @post.upvoted_by?(Current.user)}",
              form: { class: "vote-form" },
              aria: { label: "Upvote" } do %>
          <%= render "shared/feed_icon", name: "upvote" %>
        <% end %>
      <% else %>
        <span class="vote-btn" aria-hidden="true"><%= render "shared/feed_icon", name: "upvote" %></span>
      <% end %>
      <span class="vote-score"
            data-controller="animated-number"
            data-animated-number-start-value="0"
            data-animated-number-end-value="<%= @post.score.to_i %>"
            data-animated-number-duration-value="900"
            aria-label="Score"><%= @post.score %></span>
      <% if authenticated? || guest? %>
        <%= button_to post_vote_path(@post), params: { vote: { value: -1 } },
              class: "vote-btn down#{" active-down" if @post.downvoted_by?(Current.user)}",
              form: { class: "vote-form" },
              aria: { label: "Downvote" } do %>
          <%= render "shared/feed_icon", name: "downvote" %>
        <% end %>
      <% else %>
        <span class="vote-btn down" aria-hidden="true"><%= render "shared/feed_icon", name: "downvote" %></span>
      <% end %>
    </div>
  <% end %>

  <p class="feed-post-show-meta">
    <% if @post.community %>
      <%= link_to @post.community.name, community_path(@post.community) %> ·
    <% end %>
    <%= @post.author_name %> ·
    <time datetime="<%= @post.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(@post.created_at) %> ago</time>
    <% if @post.reading_time_minutes.positive? %>
      · <%= @post.reading_time_minutes %> min read
    <% end %>
  </p>

  <h1><%= @post.title %></h1>

  <% if @post.image.attached? %>
    <div data-controller="lightbox">
      <a href="<%= url_for(@post.image) %>" data-lg-size="1600-1200">
        <%= responsive_image_tag @post.image, alt: @post.title, class: "post-image" %>
      </a>
    </div>
  <% end %>

  <% if @post.content.present? %>
    <div class="post_body"><%= sanitize @post.content, tags: %w[p br strong em b i ul ol li], attributes: [] %></div>
  <% end %>

  <div class="feed-post-actions">
    <button type="button" class="feed-action" data-controller="share"
            data-share-title-value="<%= @post.title %>"
            data-share-url-value="<%= request.original_url %>"
            data-action="click->share#share" aria-label="Share post">
      <%= render "shared/feed_icon", name: "share" %> Share
    </button>
    <%# shared/_report_button, ReportsController, ModerationWorkflow, the admin
        queue and the notification job all existed, but no view rendered the
        partial -- the moderation pipeline had no inlet. Gated on authenticated?
        because ReportsController requires a real account. %>
    <% if authenticated? %>
      <%= render "shared/report_button", target: @post, reason: nil %>
    <% end %>
  </div>
</article>

<section id="comments-section">
  <h3>
    <%= t("comments.submit") %>
    <strong><%= Current.user&.guest? ? t("chat.anon") : (Current.user&.username || t("chat.anon")) %></strong>
    <% unless authenticated? %> · <%= link_to t("nav.sign_in"), new_session_path %><% end %>
  </h3>
  <% if authenticated? || guest? %>
    <%= render "comments/form", comment: @new_comment, commentable: @post %>
  <% end %>

  <ul id="comments">
    <% if @comments.any? %>
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    <% else %>
      <li><%= render "shared/empty_state",
            title: t("empty.no_comments"),
            body: t("comments.empty_body", default: "Be the first to reply — guests can comment without an account."),
            action: { label: t("comments.write_reply", default: "Write a reply"), path: "#comments-section" } %></li>
    <% end %>
  </ul>
</section>

<aside class="post-show-aside">
  <h3>About</h3>
  <% if @post.community %>
    <p><%= @post.community.description.presence || @post.community.name %></p>
    <%= link_to "View community", community_path(@post.community) %>
  <% else %>
    <p>brgen — Bergen community platform</p>
  <% end %>
</aside>
