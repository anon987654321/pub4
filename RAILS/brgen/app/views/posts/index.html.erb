<%= turbo_stream_from "posts" %>
<% content_for :title, t("pages.all_posts") %>
<%# empty_state: coverage-ok — the feed and its empty state render in posts/_live_search_results %>

<div class="page-header" role="banner" aria-label="<%= t("pages.all_posts") %>">
  <%= tag.h1 t("pages.all_posts") %>
  <%= link_to t("nav.new_post"), new_post_path, class: "btn btn-sm" %>
</div>

<nav class="sort-tabs" aria-label="<%= t("sort.posts") %>">
  <%= link_to t("sort.hot"), posts_path, class: "sort-tab#{" active" unless params[:sort]}" %>
  <%= link_to t("sort.fresh"), posts_path(sort: "fresh"), class: "sort-tab#{" active" if params[:sort] == "fresh"}" %>
  <%= link_to t("sort.top"), posts_path(sort: "top"), class: "sort-tab#{" active" if params[:sort] == "top"}" %>
  <%# The lane that makes following mean something: without it the follow
      button wrote a row nothing read. Members only — a guest has no graph. %>
  <% if Current.user && !Current.user.guest? %>
    <%= link_to t("sort.following"), posts_path(sort: "following"), class: "sort-tab#{" active" if params[:sort] == "following"}" %>
  <% end %>
</nav>

<%= live_search_index url: posts_path(sort: params[:sort]), results_partial: "posts/live_search_results", placeholder: t("search.posts"), label: t("search.posts_label"), frame_id: "brgen-posts" %>

<aside>
  <%= tag.h2 t("nav.communities") %>
  <ul>
    <% Community.popular.limit(8).each do |c| %>
      <li><%= link_to c.name, community_path(c) %></li>
    <% end %>
  </ul>
</aside>
