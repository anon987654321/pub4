<%# Per city: one shared stream refreshed every city's index for every post. %>
<% posts_city = ActsAsTenant.current_tenant %>
<%= turbo_stream_from Post.city_posts_stream(posts_city.id) if posts_city.respond_to?(:id) %>
<% content_for :title, t("pages.all_posts") %>
<%# empty_state: coverage-ok — the feed and its empty state render in posts/_live_search_results %>

<div class="page-header">
  <%= tag.h1 t("pages.all_posts"), class: "primary-title" %>
  <%= link_to t("nav.new_post"), new_post_path, class: "button button-small" %>
</div>

<%# The chosen order is marked for assistive technology as well as by colour. %>
<% current_sort = params[:sort].presence %>
<nav class="sort-tabs" aria-label="<%= t("sort.posts") %>">
  <%= link_to t("sort.hot"), posts_path, class: "sort-tab#{" active" unless current_sort}",
        aria: { current: ("true" unless current_sort) } %>
  <%= link_to t("sort.fresh"), posts_path(sort: "fresh"), class: "sort-tab#{" active" if current_sort == "fresh"}",
        aria: { current: ("true" if current_sort == "fresh") } %>
  <%= link_to t("sort.top"), posts_path(sort: "top"), class: "sort-tab#{" active" if current_sort == "top"}",
        aria: { current: ("true" if current_sort == "top") } %>
  <%# The lane that makes following mean something: without it the follow
      button wrote a row nothing read. Members only — a guest has no graph. %>
  <% if Current.user && !Current.user.guest? %>
    <%= link_to t("sort.following"), posts_path(sort: "following"),
          class: "sort-tab#{" active" if current_sort == "following"}",
          aria: { current: ("true" if current_sort == "following") } %>
  <% end %>
</nav>

<%= live_search_index url: posts_path(sort: params[:sort]), results_partial: "posts/live_search_results", placeholder: t("search.posts"), label: t("search.posts_label"), frame_id: "brgen-posts" %>

<aside>
  <%= tag.h2 t("nav.communities") %>
  <ul>
    <%= safe_join(@popular_communities.map { |club| tag.li(link_to(club.name, community_path(club))) }) %>
  </ul>
</aside>
