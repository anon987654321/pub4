<% content_for :title, t("pages.edit_post") %>

<div class="page-header"><%= tag.h1 t("pages.edit_post") %></div>

<div class="form-wrap">
  <% draft_key = "brgen-post-#{@post.to_param}" %>
  <%= form_with(model: @post, data: { controller: "draft-store autosave form-submit", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: draft_path(draft_key)) }) do |f| %>
    <%= render "shared/errors", object: @post %>
    <div class="field">
      <%= f.label :community_id, t("posts.community_optional") %>
      <%= f.collection_select :community_id, Community.order(:name), :id, :name, { include_blank: t("posts.no_community") } %>
    </div>
    <div class="field">
      <%= f.label :title %>
      <%= f.text_field :title, placeholder: t("playlist.title"), autofocus: true, required: true %>
    </div>
    <div class="field">
      <%= f.label :content, t("posts.body_optional") %>
      <div class="compose-surface" data-controller="tiptap-editor character-counter" data-character-counter-countdown-value="true">
  <%# The stored value is already Tiptap's HTML — posts/new has mounted an editor
      since it shipped — so editing a post showed the author raw "<p>" tags in a
      textarea and invited them to save it back. %>
  <%= f.text_area :content, placeholder: t("post.text_optional"), rows: 5, maxlength: 10000,
        data: { character_counter_target: "input", tiptap_editor_target: "field" } %>
  <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
  <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar" hidden>
    <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bold" title="<%= t("compose.bold", default: "Bold") %>"><strong>B</strong></button>
    <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#italic" title="<%= t("compose.italic", default: "Italic") %>"><em>i</em></button>
    <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bulletList" title="<%= t("compose.bullet_list", default: "Bullet list") %>">&bull;</button>
  </div>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
    </div>
    <div class="field" data-controller="media-picker direct-upload">
      <%# The visible affordance is the "Add photo" button below; this input is
          media-input-hidden and reached through it, so it needs its own name. %>
      <%= f.file_field :image,
            accept: "image/*",
            capture: "environment",
            direct_upload: true,
            class: "media-input-hidden",
            aria: { label: t("posts.add_photo", default: "Add photo") },
            data: { media_picker_target: "input", action: "change->media-picker#pick" } %>
      <div class="media-actions">
        <button type="button" class="media-btn" data-action="click->media-picker#trigger"><%= t("posts.photo_camera") %></button>
      </div>
      <div class="media-preview" data-media-picker-target="preview"></div>
      <%= render "shared/preset_strip", f: f %>
    </div>
    <div class="field field--check">
      <%= f.check_box :anonymous %>
      <%= f.label :anonymous, t("posts.post_anonymously") %>
    </div>
    <div class="field">
      <%= f.submit t("actions.save"), class: "btn btn-primary" %>
      <%= link_to t("actions.cancel"), @post, class: "btn btn-ghost" %>
      <span data-autosave-target="status" aria-live="polite"></span>
    </div>
  <% end %>
</div>
