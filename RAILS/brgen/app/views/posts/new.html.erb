<% content_for :title, t("post.new") %>

<div class="page-header"><%= tag.h1 t("post.new") %></div>

<div class="form-wrap">
  <% draft_key = "brgen-post-#{@community&.to_param || 'global'}-new" %>
  <%= form_with(model: [@community, @post].compact,
                data: {
                  controller: "draft-store autosave form-submit post-progressive",
                  "draft-store-key-value": draft_key,
                  **autosave_data(key: draft_key, url: draft_path(draft_key))
                }) do |f| %>
    <%= render "shared/errors", object: @post %>

    <nav class="post-progressive-nav" aria-label="<%= t("post.new_steps") %>">
      <span class="post-progressive-indicator is-active" data-post-progressive-target="indicator">
        <%= t("post.new_step_media") %>
      </span>
      <span class="post-progressive-indicator" data-post-progressive-target="indicator">
        <%= t("post.new_step_text") %>
      </span>
    </nav>

    <p class="post-publishing" data-post-progressive-target="publishing"
       role="status" aria-live="polite" hidden>
      <%= t("post.new_publishing") %>
    </p>

    <section class="post-progressive-step" data-post-progressive-target="step"
             aria-labelledby="post-media-heading">
      <h2 id="post-media-heading" tabindex="-1" data-post-progressive-heading>
        <%= t("post.new_media_heading") %>
      </h2>
      <p class="form-help">
        <%= t("post.new_media_hint") %>
      </p>

      <div class="field post-photo-entry" data-controller="media-picker direct-upload">
        <%= f.file_field :image,
              accept: "image/*",
              capture: "environment",
              direct_upload: true,
              class: "media-input-hidden",
              aria: { label: t("posts.add_photo") },
              data: { media_picker_target: "input", post_progressive_target: "mediaInput",
                      action: "change->media-picker#pick" } %>
        <button type="button" class="post-photo-camera media-btn"
                data-action="click->media-picker#trigger">
          <%= icon :camera, size: 28 %>
          <strong><%= t("posts.add_photo") %></strong>
          <small><%= t("post.new_media_camera_hint") %></small>
        </button>
        <div class="post-media-secondary">
          <label class="post-media-choice">
            <%= icon :video, size: 22 %>
            <span>
              <strong><%= t("compose.record_video") %></strong>
              <small><%= t("post.new_video_hint") %></small>
            </span>
            <%= f.file_field :video,
                  accept: "video/*",
                  capture: "environment",
                  direct_upload: true,
                  class: "visually-hidden",
                  aria: { label: t("compose.record_video") },
                  data: { post_progressive_target: "mediaInput" } %>
          </label>
          <label class="post-media-choice">
            <%= icon :mic, size: 22 %>
            <span>
              <strong><%= t("compose.record_audio") %></strong>
              <small><%= t("post.new_audio_hint") %></small>
            </span>
            <%= f.file_field :audio,
                  accept: "audio/*",
                  direct_upload: true,
                  class: "visually-hidden",
                  aria: { label: t("compose.record_audio") },
                  data: { post_progressive_target: "mediaInput" } %>
          </label>
        </div>
        <div class="media-preview" data-media-picker-target="preview" aria-live="polite"></div>
        <%= render "shared/preset_strip", f: f, hidden: true, picker_target: true %>
      </div>

      <div class="post-progressive-actions">
        <button type="button" class="btn btn-primary"
                data-action="click->post-progressive#next">
          <%= t("post.new_continue") %>
        </button>
        <button type="button" class="btn btn-ghost"
                data-action="click->post-progressive#skipMedia">
          <%= t("post.new_text_only") %>
        </button>
      </div>
    </section>

    <section class="post-progressive-step" data-post-progressive-target="step"
             aria-labelledby="post-content-heading">
      <h2 id="post-content-heading" tabindex="-1" data-post-progressive-heading>
        <%= t("post.new_write_heading") %>
      </h2>

      <div class="field">
        <%= f.label :community_id, t("posts.community_label") %>
        <%= f.collection_select :community_id, Community.order(:name), :id, :name,
              { include_blank: t("posts.anywhere_in", city: Current.city_name) } %>
      </div>
      <% if @neighborhoods.present? %>
        <div class="field">
          <%= f.label :neighborhood_id, t("home.neighborhood_filter", default: "Neighbourhood") %>
          <%= f.collection_select :neighborhood_id, @neighborhoods, :id, :name, { include_blank: t("home.citywide", default: "City-wide") } %>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :title %>
        <%= f.text_field :title, required: true %>
      </div>

      <div class="field" data-controller="tiptap-editor">
        <%= f.label :content, t("posts.body_label") %>
        <div class="compose-surface" data-controller="character-counter"
             data-character-counter-countdown-value="true">
          <%= f.text_area :content, rows: 5, class: "compose-input",
                maxlength: 10000,
                data: { character_counter_target: "input", tiptap_editor_target: "field" } %>
          <div class="tiptap_mount tiptap_mount--post"
               data-tiptap-editor-target="mount" hidden></div>
          <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar" hidden>
            <button type="button" class="tiptap_btn"
                    data-action="mousedown->tiptap-editor#bold"
                    title="<%= t("compose.bold") %>"><b>B</b></button>
            <button type="button" class="tiptap_btn"
                    data-action="mousedown->tiptap-editor#italic"
                    title="<%= t("compose.italic") %>"><i>i</i></button>
            <button type="button" class="tiptap_btn"
                    data-action="mousedown->tiptap-editor#bulletList"
                    title="<%= t("compose.bullet_list") %>">•</button>
          </div>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
      </div>

      <% if authenticated? %>
        <div class="field field--check">
          <%= f.check_box :anonymous %>
          <%= f.label :anonymous, t("posts.post_anonymously") %>
        </div>
      <% else %>
        <p class="mb-12"><%= t("post.posting_as_anon") %> <strong>anon</strong>.
          <%= link_to t("nav.sign_in"), new_session_path %><%= t("post.guest_sign_in") %></p>
      <% end %>

      <div class="post-progressive-actions">
        <button type="button" class="btn btn-ghost"
                data-action="click->post-progressive#back">
          <%= t("actions.back") %>
        </button>
        <%= f.submit t("post.submit"), class: "btn btn-primary" %>
      </div>
      <div class="field">
        <%= link_to t("actions.cancel"), posts_path, class: "btn btn-ghost" %>
        <span data-autosave-target="status" aria-live="polite"></span>
      </div>
    </section>
  <% end %>
</div>
