<% content_for :title, "New post" %>

<div class="page-header" role="banner"><h1>New post</h1></div>

<div class="form-wrap">
  <% draft_key = "brgen-post-#{@community&.to_param || 'global'}-new" %>
  <%= form_with(model: [@community, @post].compact, data: { controller: "draft-store autosave form-submit", "draft-store-key-value": draft_key, "autosave-key-value": draft_key, "autosave-url-value": draft_path(draft_key) }) do |f| %>
    <%= render "shared/errors", object: @post %>
    <div class="field">
      <%= f.label :community_id, "Community (optional)" %>
      <%= f.collection_select :community_id, Community.order(:name), :id, :name, { include_blank: "— no community —" } %>
    </div>
    <div class="field">
      <%= f.label :title %>
      <%= f.text_field :title, placeholder: "Title", autofocus: true, required: true %>
    </div>
    <div class="field" data-controller="tiptap-composer">
      <%= f.label :content, "Body (optional)" %>
      <div class="tiptap-editor" data-tiptap-composer-target="editor"></div>
      <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :content, placeholder: "Text (optional)", rows: 5, class: "tiptap-input" , maxlength: 10000, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
    </div>
    <div class="field" data-controller="media-picker direct-upload">
      <%= f.file_field :image,
            accept: "image/*",
            capture: "environment",
            direct_upload: true,
            class: "media-input-hidden",
            data: { media_picker_target: "input", action: "change->media-picker#pick" } %>
      <div class="media-actions">
        <button type="button" class="media-btn" data-action="click->media-picker#trigger">
          <%= x_icon :camera, size: 20 %>
          Photo / Camera
        </button>
      </div>
      <div class="media-preview" data-media-picker-target="preview"></div>
      <div class="preset-strip">
        <% %w[none portrait landscape street blockbuster].each do |p| %>
          <label class="preset-opt">
            <%= f.radio_button :preset, p %>
            <span><%= p.capitalize %></span>
          </label>
        <% end %>
      </div>
    </div>
    <% if authenticated? %>
      <div class="field field--check">
        <%= f.check_box :anonymous %>
        <%= f.label :anonymous, "Post anonymously" %>
      </div>
    <% else %>
      <p class="dim mb-12">Posting as <strong>anon</strong> · <%= link_to "sign in", new_session_path %> to use your name</p>
    <% end %>
    <div class="field">
      <%= f.submit "Post", class: "btn btn-primary" %>
      <%= link_to "Cancel", posts_path, class: "btn btn-ghost" %>
      <span class="dim" data-autosave-target="status" aria-live="polite"></span>
    </div>
  <% end %>
</div>
