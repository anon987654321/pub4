<% content_for :title, t("post.new") %>

<div class="page-header" role="banner"><%= tag.h1 t("post.new") %></div>

<div class="form-wrap">
  <% draft_key = "brgen-post-#{@community&.to_param || 'global'}-new" %>
  <%= form_with(model: [@community, @post].compact, data: { controller: "draft-store autosave form-submit", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: draft_path(draft_key)) }) do |f| %>
    <%= render "shared/errors", object: @post %>
    <%# Title is the only required field, so it is the only one marked. Labelling
        the other three "(optional)" said the same thing three times and made
        the form read as a list of things you need not do. %>
    <div class="field">
      <%= f.label :community_id, "Community" %>
      <%= f.collection_select :community_id, Community.order(:name), :id, :name, { include_blank: "Anywhere in Bergen" } %>
    </div>
    <div class="field">
      <%= f.label :title %>
      <%= f.text_field :title, autofocus: true, required: true %>
    </div>
    <%# tiptap-editor, the same controller the feed composer uses: the textarea
        stays the submitted field and the no-JS fallback, and is hidden only
        once Tiptap has actually mounted. (This form previously used a second,
        near-duplicate tiptap-composer controller that never booted — see the
        deleted tiptap_composer_controller.js.) %>
    <%# One surface holds the whole editor: the textarea, the Tiptap mount that
        replaces it, the toolbar and the counter. They were four siblings on the
        page background before, so the 160px mount read as a void between a
        stray number and three orphaned buttons. %>
    <div class="field" data-controller="tiptap-editor">
      <%= f.label :content, "Body" %>
      <div class="compose-surface" data-controller="character-counter" data-character-counter-countdown-value="true">
        <%= f.text_area :content, rows: 5, class: "compose-input",
              maxlength: 10000,
              data: { character_counter_target: "input", tiptap_editor_target: "field" } %>
        <div class="tiptap_mount tiptap_mount--post" data-tiptap-editor-target="mount" hidden></div>
        <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar" hidden>
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bold" title="Bold"><b>B</b></button>
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#italic" title="Italic"><i>i</i></button>
          <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bulletList" title="Bullet list">•</button>
        </div>
        <%# Bottom-right, inside the field, and quiet until you are typing — it
            used to render "10,000" above an empty editor, where it read as a
            stray number rather than a budget. %>
        <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
      </div>
    </div>
    <div class="field" data-controller="media-picker direct-upload">
      <%# Named for the same reason as posts/edit: the visible control is the
          "Add photo" button, the input itself is media-input-hidden. %>
      <%= f.file_field :image,
            accept: "image/*",
            capture: "environment",
            direct_upload: true,
            class: "media-input-hidden",
            aria: { label: t("posts.add_photo", default: "Add photo") },
            data: { media_picker_target: "input", action: "change->media-picker#pick" } %>
      <div class="media-actions">
        <button type="button" class="media-btn" data-action="click->media-picker#trigger">
          <%= icon :camera, size: 20 %>
          Add photo
        </button>
      </div>
      <div class="media-preview" data-media-picker-target="preview"></div>
      <%# Five unlabelled pills wrapping onto two lines, offering to restyle a
          photo nobody had chosen yet. They belong to the image, so they appear
          with it — media-picker reveals this once a file is picked. %>
      <fieldset class="preset-strip" data-media-picker-target="presets" hidden>
        <legend class="preset-strip-legend">Look</legend>
        <% %w[none portrait landscape street blockbuster].each do |p| %>
          <label class="preset-opt">
            <%= f.radio_button :preset, p %>
            <span><%= p.capitalize %></span>
          </label>
        <% end %>
      </fieldset>
    </div>
    <% if authenticated? %>
      <div class="field field--check">
        <%= f.check_box :anonymous %>
        <%= f.label :anonymous, "Post anonymously" %>
      </div>
    <% else %>
      <p class="dim mb-12"><%= t("post.posting_as_anon") %> <strong>anon</strong>. <%= link_to t("nav.sign_in"), new_session_path %><%= t("post.guest_sign_in") %></p>
    <% end %>
    <div class="field">
      <%= f.submit t("post.submit"), class: "btn btn-primary" %>
      <%= link_to t("actions.cancel"), posts_path, class: "btn btn-ghost" %>
      <span class="dim" data-autosave-target="status" aria-live="polite"></span>
    </div>
  <% end %>
</div>
