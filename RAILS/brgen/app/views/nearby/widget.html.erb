<turbo-frame id="nearby-chat-widget-frame">
  <% if @located %>
    <%= turbo_stream_from @conversation %>

    <% if @messages.blank? %>
      <div class="nearby-chat-widget-empty">
        <strong>You’re in the room</strong>
        <p>No messages yet within ~10&nbsp;km. Say hi as <strong><%= Current.user.anon_handle %></strong> — no signup.</p>
      </div>
    <% end %>

    <%# id is widget-specific (the channel page's log already owns "messages");
        .conversation-log is what Message#broadcasts_to appends to. %>
    <ul id="nearby-widget-log" class="nearby-chat-widget-log conversation-log"
        data-nearby-chat-target="log"
        data-controller="conversation-log"
        data-conversation-log-viewer-id-value="<%= Current.user&.id %>"
        aria-live="polite">
      <% @messages.each do |m| %>
        <%= render "messages/message", message: m %>
      <% end %>
    </ul>

    <%= render "nearby/widget_composer", conversation: @conversation %>
  <% elsif Current.user.present? %>
    <div class="nearby-chat-widget-empty">
      <strong>Share location to join nearby</strong>
      <p>Hyperlocal room is everyone within about 10&nbsp;km. Anonymous handle, messages fade.</p>
      <button type="button" class="nearby-chat-widget-cta" data-action="nearby-chat#locate">Share location</button>
      <p class="dim nearby-chat-widget-fallback">
        Or chat now without GPS:
        <%= link_to "#brgen city lobby", channel_path("brgen"), class: "nearby-chat-widget-cta", data: { turbo_frame: "_top" } %>
      </p>
      <% unless authenticated? %>
        <p class="dim"><%= link_to "Sign in for a permanent account", new_session_path, data: { turbo_frame: "_top" } %></p>
      <% end %>
    </div>
  <% else %>
    <%# Should not happen on brgen (soft guest is minted every request). Keep a
        path that still lands in anonymous chat instead of a pure sign-in wall. %>
    <div class="nearby-chat-widget-empty">
      <strong>Anonymous chat</strong>
      <p>Open the city lobby — no signup. Nearby room needs location after you load a page.</p>
      <%= link_to "Open #brgen", channel_path("brgen"), class: "nearby-chat-widget-cta", data: { turbo_frame: "_top" } %>
      <%= link_to "What is nearby?", nearby_path, class: "nearby-chat-widget-cta", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</turbo-frame>
