<turbo-frame id="nearby-chat-widget-frame">
  <% if @conversation.present? && Current.user.present? %>
    <%= turbo_stream_from @conversation %>

    <div class="nearby-chat-widget-mode dim" data-nearby-chat-target="mode">
      <% if @located %>
        <strong>#nearby</strong> · ~10&nbsp;km · <%= Current.user.anon_handle %>
        <button type="button" class="nearby-chat-widget-linkish" data-action="nearby-chat#locate" title="<%= t("chat.refresh_location") %>">↻</button>
      <% else %>
        <strong>#brgen</strong> · <%= t("chat.city_lobby") %> · <%= Current.user.channel_handle %>
        <button type="button" class="nearby-chat-widget-linkish" data-action="nearby-chat#locate"><%= t("chat.use_location") %></button>
      <% end %>
    </div>

    <% if @messages.blank? %>
      <div class="nearby-chat-widget-empty">
        <% if @located %>
          <strong><%= t("chat.nearby_title") %></strong>
          <p><%= t("chat.nearby_body") %></p>
        <% else %>
          <strong><%= t("chat.lobby_title") %></strong>
          <p><%= t("chat.lobby_body") %></p>
        <% end %>
      </div>
    <% end %>

    <ul id="nearby-widget-log" class="nearby-chat-widget-log conversation-log"
        data-nearby-chat-target="log"
        data-controller="conversation-log"
        data-conversation-log-viewer-id-value="<%= Current.user&.id %>"
        aria-live="polite">
      <% @messages.each do |m| %>
        <%= render "messages/message", message: m %>
      <% end %>
    </ul>

    <%= render "nearby/widget_composer", conversation: @conversation %>
  <% else %>
    <div class="nearby-chat-widget-empty">
      <strong><%= t("chat.title") %></strong>
      <p><%= t("chat.loading") %></p>
      <%= link_to "Open #brgen", channel_path("brgen"), class: "nearby-chat-widget-cta", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</turbo-frame>
