<turbo-frame id="nearby-chat-widget-frame">
  <% if @located %>
    <%= turbo_stream_from @conversation %>

    <ul id="messages" class="nearby-chat-widget-log">
      <% @messages.each do |m| %>
        <%= render "messages/message", message: m %>
      <% end %>
    </ul>

    <%= form_with model: @message, url: conversation_messages_path(@conversation),
                  id: "new_message", class: "nearby-chat-widget-composer",
                  data: { turbo: true, controller: "typing-input", typing_input_url_value: conversation_typing_indicators_path(@conversation) } do |f| %>
      <%= f.text_area :content, rows: 1, placeholder: "Message as #{Current.user.anon_handle}…", maxlength: 500 %>
      <%= f.hidden_field :message_type, value: "text" %>
      <%= f.submit "Send", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% elsif authenticated? %>
    <p class="dim nearby-chat-widget-empty">Share your location on the <%= link_to "nearby page", nearby_path %> to join the chat.</p>
  <% else %>
    <p class="dim nearby-chat-widget-empty"><%= link_to "Sign in", new_session_path %> and share your location to chat with everyone nearby.</p>
  <% end %>
</turbo-frame>
