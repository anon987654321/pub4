<turbo-frame id="nearby-chat-widget-frame">
  <% if @conversation.present? && Current.user.present? %>
    <%= turbo_stream_from @conversation %>

    <div class="nearby-chat-widget-mode dim" data-nearby-chat-target="mode">
      <% if @located %>
        <strong>#nearby</strong> · ~10&nbsp;km · <%= Current.user.anon_handle %>
        <button type="button" class="nearby-chat-widget-linkish" data-action="nearby-chat#locate" title="Refresh location">↻</button>
      <% else %>
        <strong>#brgen</strong> · city lobby · <%= Current.user.channel_handle %>
        <button type="button" class="nearby-chat-widget-linkish" data-action="nearby-chat#locate">Use location</button>
      <% end %>
    </div>

    <% if @messages.blank? %>
      <div class="nearby-chat-widget-empty">
        <% if @located %>
          <strong>You’re in the nearby room</strong>
          <p>No messages yet within ~10&nbsp;km. Say hi — no signup.</p>
        <% else %>
          <strong>City lobby</strong>
          <p>Anonymous chat without GPS. Share location anytime for the hyperlocal room.</p>
        <% end %>
      </div>
    <% end %>

    <ul id="nearby-widget-log" class="nearby-chat-widget-log conversation-log"
        data-nearby-chat-target="log"
        data-controller="conversation-log"
        data-conversation-log-viewer-id-value="<%= Current.user&.id %>"
        aria-live="polite">
      <% @messages.each do |m| %>
        <%= render "messages/message", message: m %>
      <% end %>
    </ul>

    <%= render "nearby/widget_composer", conversation: @conversation %>
  <% else %>
    <div class="nearby-chat-widget-empty">
      <strong>Anonymous chat</strong>
      <p>Loading… if this sticks, open the city lobby.</p>
      <%= link_to "Open #brgen", channel_path("brgen"), class: "nearby-chat-widget-cta", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</turbo-frame>
