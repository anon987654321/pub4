<% content_for :title, "Nearby" %>

<div class="page-header" role="banner"><h1>Nearby</h1></div>

<p class="channel-crosslink dim">
  <%= link_to "Live feed (anonymous notes nearby)", live_path %> ·
  Prefer a room? <%= link_to "Join a public channel →", channels_path %>
</p>

<% unless @located %>
  <div class="section-divider--24">
    <p class="section-heading--md">Share your location</p>
    <p class="dim">Find strangers within <%= @radius_km.to_i %> km and chat anonymously. Your exact position is never shown.</p>
  </div>
<% end %>

<% if @located %>
  <article class="row-between section-divider--24">
    <div>
      <strong>Nearby chat room</strong>
      <p class="dim">Everyone within <%= Conversation::GEO_ROOM_RADIUS_KM.to_i %> km, one shared room, anonymous.</p>
    </div>
    <%= link_to "Join", nearby_room_path, class: "btn btn-primary btn-sm" %>
  </article>

  <% if @nearby.any? %>
    <% @nearby.each do |u, distance| %>
      <article class="row-between">
        <div>
          <strong><%= u.anon_handle %></strong>
          <p class="dim"><%= number_with_precision(distance, precision: 1) %> km away · anonymous</p>
        </div>
        <%= button_to "Chat", nearby_path, params: { user_id: u.id }, method: :post, class: "btn btn-primary btn-sm" %>
      </article>
    <% end %>
  <% else %>
    <%= render "shared/empty_state", title: "No one nearby", body: "Check back later." %>
  <% end %>
<% else %>
  <%= render "shared/empty_state", title: "Waiting for location", body: "Allow location to see people nearby." %>
<% end %>
