<% content_for :title, t("nearby.page_title") %>

<div class="page-header"><%= tag.h1 t("nearby.page_title") %></div>

<%# The Live link that used to head this list pointed at a second hyperlocal
    surface. /live is this page's own room now, so the link would have sent you
    to the Join button six lines below it. %>
<p>
  <%= t("nearby.prefer_room") %>
  <%= link_to t("nearby.channels_link"), channels_path %>
</p>

<% if @located %>
  <article class="row-between section-divider--24">
    <div> <%# scan: intentional — an anonymous text block; the flex row is the layout and a name here would have no reader %>
      <%= tag.strong t("nearby.room_title") %>
      <p><%= t("nearby.room_body", km: Conversation::GEO_ROOM_RADIUS_KM.to_i) %></p>
    </div>
    <%= link_to t("nearby.join"), nearby_room_path, class: "btn btn-primary btn-sm" %>
  </article>

  <% if @nearby.any? %>
    <% @nearby.each do |u, distance| %>
      <article class="row-between">
        <div> <%# scan: intentional — an anonymous text block; the flex row is the layout and a name here would have no reader %>
          <%= tag.strong u.anon_handle %>
          <p><%= t("nearby.distance_away", km: number_with_precision(distance, precision: 1)) %></p>
        </div>
        <%= button_to t("nearby.chat"), nearby_path, params: { user_id: u.id }, method: :post, class: "btn btn-primary btn-sm" %>
      </article>
    <% end %>
  <% else %>
    <%# Nobody in range is exactly when the room is the useful answer: it is
        radius-bucketed rather than person-to-person, so it has people in it when
        this list does not. %>
    <%= render "shared/empty_state",
          title: t("empty.no_nearby"),
          body: t("nearby.empty_located_body"),
          action: { label: t("nearby.join"), path: nearby_room_path } %>
  <% end %>
<% else %>
  <div class="section-divider--24" data-controller="request-location">
    <p class="section-heading--md"><%= t("nearby.share_location_title") %></p>
    <p><%= t("nearby.share_location_body", km: @radius_km.to_i) %></p>
    <p class="nearby-locate-actions">
      <button type="button"
              class="btn btn-primary btn-sm"
              data-action="request-location#request"><%= t("chat.use_location") %></button>
      <%= link_to t("chat.open_brgen_channel"), channel_path("brgen"), class: "btn btn-sm" %>
    </p>
    <p>
      <%= t("nearby.lobby_hint_before") %>
      <%= link_to "#brgen", channel_path("brgen") %>
      <%= t("nearby.lobby_hint_after") %>
    </p>
  </div>
<% end %>
