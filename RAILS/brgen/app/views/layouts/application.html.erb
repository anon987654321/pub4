<!DOCTYPE html>
<html lang="<%= Current.locale || I18n.locale %>" dir="ltr" class="chrome-hidden">
<head>
  <meta charset="utf-8">
  <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover" %>
  <%= tag.meta name: "mobile-web-app-capable", content: "yes" %>
  <%= tag.meta name: "color-scheme", content: "dark" %>
  <%= tag.meta name: "theme-color", content: "#000000", data: { light_color: "#ffffff", dark_color: "#000000" } %>
  <title><%= content_for?(:title) ? "#{yield :title} — Brgen" : "Brgen" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Brgen — city communities across Scandinavia and Europe. Connect, post, and discover your city." %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="Brgen">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Brgen" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "City communities across Scandinavia and Europe. Connect, post, and discover your city." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Brgen" %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "City communities across Scandinavia and Europe. Connect, post, and discover your city." %>">
  <link rel="preload" href="/icon.png" as="image">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>
  <%# Brand fonts are self-hosted (see _fonts_brand.scss); preload only the face
      this surface actually uses so it is ready before first text paint. %>
  <% if active_vertical.in?(%i[dating maps messenger]) %>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-400-normal.woff2" crossorigin>
  <% elsif active_vertical == :marketplace && File.file?(Rails.root.join("public/fonts/pp-neue-montreal-latin-700-normal.woff2")) %>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pp-neue-montreal-latin-700-normal.woff2" crossorigin>
  <% end %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="/lightgallery.css">
  <meta name="lg-license" content="<%= ENV.fetch("LIGHTGALLERY_LICENSE", "0000-0000-000-0000") %>">
  <%= yield :json_ld %>
  <%= json_ld_script(organization_json_ld(site_name: "Brgen", url: root_url)) %>
  <%= javascript_importmap_tags %>
</head>
<body class="<%= body_surface_classes %>"
      data-layout="document"
      data-surface="social"
      data-controller="feed-hotkey browser-fingerprint brgen-shell"
      data-browser-fingerprint-url-value="<%= fingerprint_path %>">
  <%# Every surface, playlist included. The skip link must be the first focusable
      element on the page or it cannot do its job. The playlist tunnel used to
      opt out because the pill painted as a light rectangle in the brand corner;
      _shell.scss now clips it to 1×1 with clip-path + opacity:0 (see the comment
      at the top of that file, which names this tunnel), so there is nothing left
      to paint. %>
  <a class="skip-link" href="#main-content"><%= t("skip_to_content") %></a>
  <%= link_to root_path, class: "brgen-logo-mark", aria: { label: "Brgen home" } do %>
    <span class="brand-text">brgen</span>
  <% end %>
  <% unless vertical_surface? %>
    <div role="region" aria-label="Theme">
      <input type="checkbox" id="dark-toggle" class="theme-toggle-input" aria-label="Toggle light theme"
        data-controller="theme-toggle" data-theme-toggle-storage-key-value="brgen-theme" data-action="change->theme-toggle#persist">
      <%# Restore the saved theme at parse time, before .theme-root paints, so a
          saved light theme does not flash dark first (the Stimulus controller
          reapplies the same value on connect). %>
      <script src="/theme_boot.js"></script>
      <label for="dark-toggle" class="theme-toggle" title="Toggle light theme" aria-hidden="true">
        <%= icon :sun, size: 20 %>
      </label>
    </div>
  <% end %>

  <div class="theme-root" data-controller="bottom-sheet">
  <%= render "shared/nav_swiper" %>
  <div id="nearby-alerts" class="nearby-alerts" data-turbo-permanent aria-live="polite"></div>
  <div id="match-overlays" data-turbo-permanent aria-live="polite"></div>
  <div data-controller="geolocation"
       data-geolocation-url-value="<%= location_path %>"
       data-geolocation-radius-km-value="10"
       data-turbo-permanent></div>
  <% if Current.user %>
    <%= turbo_stream_from "nearby_alerts_#{Current.user.id}" %>
    <%= turbo_stream_from "brgen:matches:#{Current.user.id}" %>
    <%# DMs only — public channels are ambient and must not light the badge. %>
    <% unread = Conversation.for_user(Current.user).where(slug: nil).sum { |c| c.unread_count_for(Current.user) } %>
    <div data-controller="push"
         data-push-vapid-key-value="<%= Shared::Vapid.public_key %>"
         data-push-subscribe-url-value="<%= push_subscriptions_path %>"
         data-push-unread-value="<%= unread %>"
         data-turbo-permanent></div>
    <button id="push-enable-btn" class="push-enable-btn" hidden>Enable notifications</button>
  <% end %>

  <div id="cityCarousel" class="city-carousel" data-turbo-permanent aria-label="City network" data-brgen-shell-target="carousel">
    <div class="carousel-container" role="list">
      <% %w[
        brgen.no longyearbyn.no oshlo.no stvanger.no trmso.no trndheim.no
        reykjavk.is kbenhvn.dk stholm.se mlmoe.se gtebrg.se hlsinki.fi
        lndon.uk mnchester.uk edinbrgh.uk glasgw.uk amstrdam.nl rottrdam.nl
        brssels.be frankfrt.de zrich.ch mlan.it brdeaux.fr lisbon.pt wrsawa.pl
        newyrk.us lsangeles.com chcago.us houstn.us
      ].each_with_index do |domain, i| %>
        <a class="carousel-slide<%= " active" if i.zero? %>" role="listitem"
           href="https://<%= domain %>/" data-domain="<%= domain %>" data-base="<%= domain %>"><%= domain %></a>
      <% end %>
    </div>
  </div>

  <div class="app-shell" data-controller="scroll-chrome" data-scroll-chrome-storage-key-value="pub4:tab-bar:open">
    <div class="layout">
      <div class="sidebar-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="left" data-turbo-permanent>
      <aside class="sidebar" aria-label="Sidebar" data-edge-swiper-target="root">
        <%= link_to root_path, class: "brand brand-wordmark", aria: { label: "Brgen" } do %>
          <span class="brand-text">brgen</span>
        <% end %>
        <nav role="navigation" data-turbo-permanent aria-label="<%= t("nav.primary_nav") %>">
          <% nav_cls = ->(path) { "nav-item#{" active" if current_page?(path)}" } %>
          <%= link_to root_path, class: nav_cls.(root_path) do %>
            <%= icon :home, size: 26 %>
            <span><%= t("nav.home") %></span>
          <% end %>
          <%= render "shared/ai_nav_link" %>
          <%= link_to communities_path, class: nav_cls.(communities_path) do %>
            <%= icon :explore, size: 26 %>
            <span><%= t("nav.explore") %></span>
          <% end %>
          <%= link_to global_search_path, class: nav_cls.(global_search_path) do %>
            <%= icon :search, size: 26 %>
            <span><%= t("nav.search") %></span>
          <% end %>
          <%= link_to notifications_path, class: nav_cls.(notifications_path) do %>
            <%= icon :notifications, size: 26 %>
            <span><%= t("nav.notifications") %></span>
          <% end %>
          <%= link_to conversations_path, class: nav_cls.(conversations_path) do %>
            <%= icon :messages, size: 26 %>
            <span><%= t("nav.messages") %></span>
          <% end %>
          <%= link_to nearby_path, class: nav_cls.(nearby_path) do %>
            <%= icon :nearby, size: 26 %>
            <span><%= t("nav.nearby") %></span>
          <% end %>
          <% if authenticated? %>
            <%= link_to user_path(Current.user), class: nav_cls.(user_path(Current.user)) do %>
              <%= icon :profile, size: 26 %>
              <span><%= t("nav.profile") %></span>
            <% end %>
          <% else %>
            <%= link_to new_session_path, class: nav_cls.(new_session_path) do %>
              <%= icon :sign_in, size: 26 %>
              <span><%= t("nav.sign_in") %></span>
            <% end %>
          <% end %>
        </nav>
        <% if authenticated? %>
          <div class="sidebar-dropdown" data-controller="dropdown" data-action="click@window->dropdown#hide">
            <button type="button" class="btn btn-ghost btn-sm" data-dropdown-button aria-expanded="false" data-action="click->dropdown#toggle"><%= t("nav.more") %></button>
            <div class="sidebar-dropdown-menu hidden" data-dropdown-target="menu">
              <%= link_to t("nav.profile"), user_path(Current.user) %>
              <%= link_to t("nav.new_post"), new_post_path %>
              <%= link_to t("nav.new_community"), new_community_path %>
              <%= link_to t("nav.sign_out"), session_path, data: { turbo_method: :delete, turbo_prefetch: false } %>
            </div>
          </div>
        <% end %>
        <a href="<%= new_post_path %>" class="compose-btn">
          <%= icon :compose, size: 22, css_class: "compose-icon" %>
          <span class="compose-label"><%= t("nav.post") %></span>
        </a>
      </aside>
      <button type="button" class="edge-grip edge-grip-left" data-edge-swiper-target="grip"
              data-action="click->edge-swiper#toggle" aria-label="<%= t("nav.show_sidebar") %>" aria-expanded="false"></button>
      </div>

      <main id="main-content" role="main" data-controller="pull-to-refresh">
        <% if !vertical_surface? && current_page?(root_path) %>
          <div class="feed-header">
            <%# Visual brand is the fixed top-left .brgen-logo-mark (all surfaces). %>
            <h1 class="visually-hidden">Home</h1>
            <nav class="feed-tabs" aria-label="Subapps">
              <% subapp_nav_items.each do |label, url| %>
                <%= link_to label, url, class: "feed-tab" %>
              <% end %>
            </nav>
          </div>
        <% end %>
        <%# City feed + compose first. AI lives as a compact chip in the home
            intro (and full-page via ?master=1), not as an eager above-fold hero
            that pushed "Bergen, right now" and guest paths below the fold. %>
        <% if current_page?(root_path) && Current.user.present? %>
          <%= render "shared/feed_compose" %>
        <% end %>
        <%= tag.p(notice, role: "status", class: "flash-notice") if notice %>
        <%= tag.p(alert, role: "alert", class: "flash-alert") if alert %>
        <%= yield %>
      </main>

      <div class="widgets-swiper" data-controller="edge-swiper" data-edge-swiper-edge-value="right">
      <button type="button" class="edge-grip edge-grip-right" data-edge-swiper-target="grip"
              data-action="click->edge-swiper#toggle" aria-label="<%= t("nav.show_widgets") %>" aria-expanded="false"></button>
      <aside class="widgets" aria-label="Widgets" data-edge-swiper-target="root">
        <%= form_with url: global_search_path, method: :get, class: "widget-search", role: "search", local: true do |form| %>
          <%= icon :search, size: 19 %>
          <%= form.search_field :q, value: params[:q], placeholder: t("nav.search_placeholder"), aria: { label: t("nav.search_placeholder") } %>
          <%= form.submit t("nav.search"), class: "visually-hidden" %>
        <% end %>
        <%= yield :widgets %>
        <%= render "shared/sidebar_discovery" %>
        <%= render "shared/newsletter_cta" %>
      </aside>
      </div>
    </div>

    <%# Footer menu is progressive: closed by default (scroll-chrome). Peel +
        scroll-up reveal; scroll-down hides. %>
    <button type="button"
            class="tab-bar-peel"
            data-scroll-chrome-target="peel"
            data-action="scroll-chrome#reveal"
            aria-controls="app-tab-bar"
            aria-expanded="false"
            aria-label="<%= t("nav.show_menu", default: "Show menu") %>"></button>
    <nav id="app-tab-bar"
         role="navigation"
         class="tab-bar"
         aria-label="<%= t("nav.mobile_nav") %>"
         data-scroll-chrome-target="bar"
         data-turbo-permanent
         aria-hidden="true"
         inert>
      <%= link_to root_path, class: "tab-item", aria: { label: t("nav.home"), current: current_page?(root_path) ? "page" : nil } do %>
        <%= icon :home, size: 26 %>
      <% end %>
      <%= link_to communities_path, class: "tab-item", aria: { label: t("nav.explore"), current: current_page?(communities_path) ? "page" : nil } do %>
        <%= icon :explore, size: 26 %>
      <% end %>
      <%= render "shared/ai_nav_link", class_name: "tab-item", show_label: false %>
      <%= link_to conversations_path, class: "tab-item", aria: { label: t("nav.messages"), current: current_page?(conversations_path) ? "page" : nil } do %>
        <%= icon :messages, size: 26 %>
      <% end %>
      <%= link_to nearby_path, class: "tab-item", aria: { label: t("nav.nearby"), current: current_page?(nearby_path) ? "page" : nil } do %>
        <%= icon :nearby, size: 26 %>
      <% end %>
      <button type="button" class="tab-item tab-item-button" data-action="click->bottom-sheet#toggle" data-bottom-sheet-target="trigger" aria-expanded="false" aria-label="<%= t("nav.more") %>">
        <%= icon :menu, size: 26 %>
      </button>
      <%# No compose-fab: new-post expand lives in the top compose box / Post in sidebar. %>
    </nav>
    <div class="mobile-sheet-backdrop" data-bottom-sheet-target="backdrop" data-action="click->bottom-sheet#close"></div>
    <section class="mobile-sheet" data-level="0" aria-label="Quick actions" data-bottom-sheet-target="sheet" data-action="pointerdown->bottom-sheet#pointerDown pointermove->bottom-sheet#pointerMove pointerup->bottom-sheet#pointerUp pointercancel->bottom-sheet#pointerUp touchstart->bottom-sheet#pointerDown touchmove->bottom-sheet#pointerMove touchend->bottom-sheet#pointerUp">
      <div class="mobile-sheet-handle"></div>
      <div class="mobile-sheet-links">
        <%= link_to t("nav.ai_assistant"), brgen_ai_url, data: { turbo: false } %>
        <%= link_to t("home.live"), live_path %>
        <%= link_to t("nav.channels"), channels_path %>
        <%= link_to t("nav.new_post"), new_post_path %>
        <%= link_to t("nav.new_community"), new_community_path %>
        <% if authenticated? %>
          <%= link_to t("nav.profile"), user_path(Current.user) %>
          <%= link_to t("nav.sign_out"), session_path, data: { turbo_method: :delete, turbo_prefetch: false } %>
        <% else %>
          <%= link_to t("nav.sign_in"), new_session_path %>
        <% end %>
      </div>
    </section>
  </div>
  </div>
  <%= render "shared/install_prompt",
        title: t("install.title"),
        body: t("install.body") %>
  <%= render "shared/nearby_chat_widget" %>
</body>
</html>
