<%# locals: (page_title:, page_description:) %>
<%# Open Graph and Twitter card tags — what a link to this page renders as when
    it is pasted into a chat or a social feed. Split out of
    layouts/application.html.erb, which was over the 150-code-line view ceiling.

    The canonical/description/JSON-LD tags stayed in the layout deliberately.
    They are not card metadata, and city_copy_contract_test reads that file for
    pages.default_description and website_json_ld to prove no city renders
    another city's copy — a check this split must not walk out from under. %>
<meta property="og:site_name" content="<%= city_name %>">
<meta property="og:title" content="<%= page_title || city_name %>">
<meta property="og:description" content="<%= page_description %>">
<meta property="og:url" content="<%= request.original_url %>">
<meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
<meta name="twitter:card" content="<%= content_for(:og_image).present? ? "summary_large_image" : "summary" %>">
<meta name="twitter:title" content="<%= page_title || city_name %>">
<meta name="twitter:description" content="<%= page_description %>">
<%# Share thumbnail: a per-page override (content_for :og_image) or the brand mark,
    so every link shared to social/chat renders a card instead of bare text. %>
<% share_image = content_for(:og_image).presence || "#{request.base_url}/icon.png" %>
<meta property="og:image" content="<%= share_image %>">
<meta name="twitter:image" content="<%= share_image %>">
