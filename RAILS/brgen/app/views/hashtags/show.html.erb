<% content_for :title, "##{@hashtag.name}" %>
<% content_for :json_ld, json_ld_script(collection_page_schema(
      name: "##{@hashtag.name}",
      url: hashtag_url(@hashtag.name),
      items: @posts,
      item_type: "Article"
    )) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [city_name, main_app.root_url],
      ["##{@hashtag.name}", request.original_url.split("?").first]
    ])) %>

<header class="page-header">
  <h1>#<%= @hashtag.name %></h1>
  <p><%= t("hashtag.count", count: @hashtag.usage_count, default: "%{count} posts") %></p>
</header>

<% if @posts.any? %>
  <div class="post-feed">
    <% @posts.each do |post| %>
      <%= render "posts/post", post: post %>
    <% end %>
  </div>
  <%= render "shared/pager", pagy: @pagy %>
<% else %>
  <%# The tag name is an i18n argument, not Ruby interpolation into the default.
      Built into the default string, it reached no translation — the nb entry
      added with this change takes %{name}, and had no way to be given one. %>
  <%= render "shared/empty_state", title: t("hashtag.empty_title", default: "Nothing here yet"),
        body: t("hashtag.empty_body", name: @hashtag.name, default: "No posts use ##{@hashtag.name} yet."),
        action: { label: t("empty.post_to_city", city: city_name), path: new_post_path } %>
<% end %>

<% if @city_communities.present? %>
  <aside>
    <%= tag.h2 t("hashtag.also_in_city", city: city_name) %>
    <ul>
      <% @city_communities.each do |community| %>
        <li><%= link_to community.name, community_path(community) %></li>
      <% end %>
    </ul>
  </aside>
<% end %>
