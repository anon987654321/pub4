<% reply_to = local_assigns[:reply_to] %>
<%= form_with model: message, url: conversation_messages_path(conversation),
              id: "new_message",
              class: "messenger-composer",
              aria: { label: t("messages.composer_label") },
              data: {
                turbo: true,
                controller: "typing-input",
                typing_input_url_value: conversation_typing_indicators_path(conversation),
                action: "keydown->typing-input#composerKeydown input->typing-input#ping turbo:submit-end->typing-input#markValue"
              } do |f| %>
  <% if reply_to %>
    <%# The referent travels in the form, so a reply is still a reply after a
        reload — and the line says what is being answered, because a reply with
        no visible referent is one nobody can follow.

        Above the box rather than below it: it qualifies what you are about
        to type, and it was printing after the field it qualifies. %>
    <p class="msg-reply-context">
      <%= t("messages.replying_to", name: reply_to.sender.display_name) %>:
      <%= truncate(reply_to.content.to_s, length: 60) %>
      <%= link_to t("actions.cancel"), conversation_path(conversation) %>
    </p>
    <%= f.hidden_field :parent_id, value: reply_to.id %>
  <% end %>

  <%# One box: attach, record, type, send. The four were a stacked field, a
      visually-hidden label, a paragraph holding the recorder and a second
      paragraph holding the submit — four blocks down the page for one act.

      The box carries the outline rather than the textarea inside it. Form
      fields are the single surviving exemption to the no-lines decision of
      2026-08-04 ("an input with no outline gives no target; you must see
      where to type"), and this box IS the field as far as a reader is
      concerned — the controls are inside its edge. %>
  <div class="messenger-composer-box">
    <%# camera, not plus: the field accepts audio/* and image/*, and the
        recorder beside it covers the audio half, so what this control adds
        is a picture. An icon should draw what the control does. %>
    <%= f.label :attachment, class: "messenger-composer-tool" do %>
      <%= icon :camera, size: 20 %>
      <span class="visually-hidden"><%= t("messages.attachment_label") %></span>
    <% end %>
    <%# The recorder writes into this file field and flips the type to audio, so a
        voice note goes through the same create path as a photo. %>
    <%= f.file_field :attachment, accept: "audio/*,image/*", class: "media-input-hidden", data: { voice_recorder_target: "file" } %>
    <%= f.hidden_field :message_type, value: "text", data: { voice_recorder_target: "type" } %>
    <%= f.hidden_field :duration_seconds, data: { voice_recorder_target: "duration" } %>

    <span class="messenger-composer-record"
          data-controller="voice-recorder"
          data-voice-recorder-max-seconds-value="120"
          data-voice-recorder-record-label-value="<%= t("messages.record_voice") %>"
          data-voice-recorder-stop-label-value="<%= t("messages.stop_recording") %>"
          data-denied-text="<%= t("messages.microphone_denied") %>">
      <button type="button" class="messenger-composer-tool"
              data-action="voice-recorder#toggle" data-voice-recorder-target="button"
              aria-label="<%= t("messages.record_voice") %>">
        <%= icon :mic, size: 19 %>
      </button>
      <span class="messenger-composer-record-status" data-voice-recorder-target="status" aria-live="polite"></span>
    </span>

    <div class="messenger-composer-field"
         data-controller="character-counter" data-character-counter-countdown-value="true">
      <%= f.text_area :content, rows: 1,
            placeholder: t("chat.dm_placeholder"),
            maxlength: 500,
            enterkeyhint: "send",
            aria: { label: t("chat.message_label") },
            data: { character_counter_target: "input" } %>
      <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
    </div>

    <%# A word, not a glyph. The registry has no send arrow, and the house
        rule is that a control says what happens when it is used — "Send"
        does, and it costs no new file. %>
    <%= f.submit t("actions.send"), class: "btn btn-primary messenger-composer-send" %>
  </div>
