<%= turbo_stream_from @conversation %>
<% content_for :body_attrs do %>data-push-seen="true"<% end %>

<header role="banner" aria-label="<%= t("messages.header_label") %>">
  <%= tag.h1 @conversation.display_name_for(Current.user) %>
  <nav role="navigation" aria-label="<%= t("messages.nav_label") %>">
    <%= link_to t("messages.back_all"), conversations_path %>
  </nav>
  <%= form_with url: conversation_path(@conversation), method: :patch,
        class: "disappearing-settings#{" disappearing-settings--active" if @conversation.disappearing_messages?}" do |form| %>
    <span class="disappearing-badge" aria-hidden="true"></span>
    <label for="disappearing"><%= t("messages.disappearing") %></label>
    <%= form.select :disappearing,
          Conversation::DISAPPEARING_OPTIONS.keys.map { |key| [key, key] },
          { selected: Conversation::DISAPPEARING_OPTIONS.key(@conversation.disappearing_duration) || "off" },
          { id: "disappearing", onchange: "this.form.requestSubmit()" } %>
  <% end %>
</header>

<%= turbo_frame_tag "messages", target: "_top" do %>
<ul id="messages" data-turbo-permanent>
  <% @messages.each do |m| %>
    <%= render "messages/message", message: m %>
  <% end %>
</ul>
<% end %>

<p id="typing-indicator" data-controller="typing" data-typing-conversation-id-value="<%= @conversation.id %>"></p>

<%= form_with model: @message, url: conversation_messages_path(@conversation),
              id: "new_message",
              data: {
                turbo: true,
                controller: "typing-input",
                typing_input_url_value: conversation_typing_indicators_path(@conversation),
                action: "keydown->typing-input#composerKeydown input->typing-input#ping turbo:submit-end->typing-input#markValue"
              } do |f| %>
  <div class="field" data-controller="character-counter" data-character-counter-countdown-value="true">
    <%= f.text_area :content, rows: 3,
          placeholder: t("chat.dm_placeholder"),
          maxlength: 500,
          enterkeyhint: "send",
          aria: { label: t("chat.message_label") },
          data: { character_counter_target: "input" } %>
    <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
  </div>
  <%= f.hidden_field :message_type, value: "text" %>
  <p><%= f.submit t("actions.send"), class: "btn btn-primary" %></p>
<% end %>
