<%= turbo_stream_from @conversation %>
<% content_for :body_attrs do %>data-action="turbo:load->push#clearBadge"<% end %>

<header role="banner" aria-label="Conversation header">
  <h1><%= @conversation.display_name_for(Current.user) %></h1>
  <nav role="navigation" aria-label="Conversation nav">
    <%= link_to "← all", conversations_path %>
  </nav>
  <%= form_with url: conversation_path(@conversation), method: :patch, class: "disappearing-settings" do |form| %>
    <label for="disappearing">Disappearing messages</label>
    <%= form.select :disappearing,
          Conversation::DISAPPEARING_OPTIONS.keys.map { |key| [key, key] },
          { selected: Conversation::DISAPPEARING_OPTIONS.key(@conversation.disappearing_duration) || "off" },
          { id: "disappearing", onchange: "this.form.requestSubmit()" } %>
  <% end %>
</header>

<ul id="messages">
  <% @messages.each do |m| %>
    <%= render "messages/message", message: m %>
  <% end %>
</ul>

<p id="typing-indicator" data-controller="typing" data-typing-conversation-id-value="<%= @conversation.id %>"></p>

<%= form_with model: @message, url: conversation_messages_path(@conversation),
              id: "new_message",
              data: { turbo: true, controller: "typing-input", typing_input_url_value: conversation_typing_indicators_path(@conversation) } do |f| %>
  <p><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :content, rows: 3, placeholder: "Send a message..." , maxlength: 500, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></p>
  <%= f.hidden_field :message_type, value: "text" %>
  <p><%= f.submit "Send" %></p>
<% end %>
