<%# One DM in the rooms rail: the compact size of conversations/_conversation_row.
    Rendered by the rail and by InboxBroadcastJob, once per reader into their
    own stream, so the viewer is a local there; the id is what that job
    replaces. %>
<% viewer = local_assigns[:viewer] || Current.user %>
<% unread = unread_counts.fetch(room.id, 0) %>
<% last = last_messages[room.id] %>
<% name = room.display_name_for(viewer) %>
<li role="listitem" id="<%= dom_id(room, :rail) %>">
  <%= link_to conversation_path(room), class: "messenger-inbox-room",
              data: { turbo_frame: "messenger-pane" },
              aria: { current: local_assigns[:current_room]&.id == room.id ? "page" : nil } do %>
    <span class="messenger-room-avatar" aria-hidden="true">
      <%= name.to_s.first&.upcase || "?" %>
    </span>
    <span class="messenger-room-copy">
      <%= tag.span name, class: "messenger-inbox-name" %>
      <% if last %>
        <%= tag.span conversation_preview(room, last, length: 56), class: "messenger-room-preview" %>
      <% end %>
    </span>
    <span class="messenger-room-meta">
      <% if unread.positive? %>
        <%= tag.span unread, class: "messenger-rail-unread", aria: { hidden: true } %>
        <%= tag.span t("messages.unread_badge", count: unread), class: "visually-hidden" %>
      <% elsif last %>
        <time datetime="<%= last.created_at.iso8601 %>"><%= time_ago(last.created_at) %></time>
      <% end %>
    </span>
  <% end %>
</li>
