<% content_for :title, t("messages.title") %>

<%# The messenger window. Three panes held in one frame: rooms on the left, the
    conversation in the middle, and — inside a channel — its roster on the right.
    Switching rooms swaps only the middle, so the rail keeps its scroll and the
    composer keeps what you typed.

    Geometry copied from Discord and then moved onto this tree's rules: its rails
    are 240px, which is already 30x the 8px base, so those stand. Its channel rows
    are 32px tall and those do not — layout_rules.touch.target_min_px is 44, and a
    32px row is a miss on a phone. --tap-min is the number here. %>
<%# The heading is visually hidden and it is not decoration. This page carried no
    <h1> at all — two <h2>s in the rail under nothing, and the only page-level
    name was this section's aria-label, which a heading-navigation key cannot
    reach. conversations/show has one already (the room's name), so the inbox was
    the single messenger surface without. Hidden rather than drawn because the
    window deliberately has no visible page title, and aria-labelledby rather
    than a second aria-label so the name is written once. %>
<section class="messenger-window" aria-labelledby="messenger_window_title">
  <h1 id="messenger_window_title" class="visually-hidden"><%= t("messages.title") %></h1>
  <%= render "conversations/rooms_rail" %>

  <%= turbo_frame_tag "messenger-pane", class: "messenger-pane" do %>
    <header class="messenger-conversation-header">
      <div class="messenger-header-identity">
        <%= tag.h1 @archive ? t("messages.archive_title") : t("messages.title") %>
      </div>
    </header>
    <div class="messenger-inbox-pane-content">
      <% if @conversations.any? %>
        <ul class="messenger-inbox-list" role="list" aria-label="<%= t("messages.title") %>">
          <% @conversations.each do |conversation| %>
            <%= render "conversations/conversation_row",
                       conversation: conversation,
                       unread: @unread_counts.fetch(conversation.id, 0),
                       pinned: @pinned_ids.include?(conversation.id),
                       muted: @muted_ids.include?(conversation.id),
                       last: @last_messages[conversation.id] %>
          <% end %>
        </ul>
        <%= render "shared/pager", pagy: @pagy %>
      <% elsif @archive %>
        <%= render "shared/empty_state",
              title: t("messages.archive_empty_title"),
              body: t("messages.archive_empty_body") %>
      <% else %>
        <%= render "shared/empty_state",
              title: t("messages.empty_title"),
              body: t("messages.empty_body") %>
      <% end %>
    </div>
  <% end %>
</section>

<%# The no-JS path. Without Turbo the frame above renders its empty state and
    never changes, so the plain list stays as the way through. %>
<noscript>
  <ul role="list" id="conversation-list" aria-label="<%= t("aria.conversations") %>">
    <% @conversations.each do |conversation| %>
      <%= render "conversations/conversation_row",
                 conversation: conversation,
                 unread: @unread_counts.fetch(conversation.id, 0),
                 pinned: @pinned_ids.include?(conversation.id),
                 muted: @muted_ids.include?(conversation.id),
                 last: @last_messages[conversation.id] %>
    <% end %>
  </ul>
  <%= render "shared/pager", pagy: @pagy %>
</noscript>
