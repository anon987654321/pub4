<div class="page-header" role="banner" aria-label="<%= t("messages.title") %>">
  <%= tag.h1 t("messages.title") %>
</div>

<section class="messenger-compose" aria-label="<%= t("messages.new_message") %>">
  <%= form_with url: conversations_path, method: :post, class: "messenger-compose-form" do |f| %>
    <%= f.label :username, t("messages.new_message") %>
    <div class="messenger-compose-row">
      <%= f.text_field :username, placeholder: t("messages.username"), required: true, autocomplete: "username" %>
      <%= f.submit t("messages.start_chat"), class: "btn" %>
    </div>
  <% end %>
</section>

<% if @conversations.any? %>
  <ul role="list" aria-label="<%= t("aria.conversations") %>">
    <% @conversations.each do |c| %>
      <% other = (c.participants - [Current.user]).first %>
      <% last  = c.messages.last %>
      <li role="listitem">
        <%= link_to conversation_path(c) do %>
          <%= tag.strong other&.display_name || "anon" %>
          <% if last %>
            <span><%= truncate(last.content.to_s, length: 80) %></span>
            <time datetime="<%= last.created_at.iso8601 %>"><%= time_ago(last.created_at) %></time>
          <% end %>
          <% unread = @unread_counts.fetch(c.id, 0) %>
          <% if unread.positive? %><mark><%= unread %></mark><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("messages.empty_title"),
        body: t("messages.empty_body"),
        action: { label: t("nav.nearby"), path: nearby_path } %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
