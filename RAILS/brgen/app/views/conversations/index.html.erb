<div class="page-header">
  <%= tag.h1 t("messages.title") %>
  <%= link_to t("messages.search"), search_conversations_path, class: "btn btn-ghost" %>
  <%= link_to t("messages.new_group"), new_group_path, class: "btn btn-ghost" %>
</div>

<section class="messenger-compose" aria-label="<%= t("messages.new_message") %>">
  <%= form_with url: conversations_path, method: :post, class: "messenger-compose-form" do |f| %>
    <%= f.label :username, t("messages.new_message") %>
    <div class="messenger-compose-row">
      <%= f.text_field :username, placeholder: t("messages.username"), required: true, autocomplete: "username" %>
      <%= f.submit t("messages.start_chat"), class: "btn" %>
    </div>
  <% end %>
</section>

<% if @conversations.any? %>
  <ul role="list" id="conversation-list" aria-label="<%= t("aria.conversations") %>">
    <% @conversations.each do |conversation| %>
      <%= render "conversations/conversation_row",
                 conversation: conversation,
                 unread: @unread_counts.fetch(conversation.id, 0),
                 pinned: @pinned_ids.include?(conversation.id) %>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("messages.empty_title"),
        body: t("messages.empty_body"),
        action: { label: t("nav.nearby"), path: nearby_path } %>
<% end %>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "ConversationsInfiniteScrollReflex#load_more",
           sentinel_id: "conversation-list-sentinel" %>

<%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
    ActionCable, so without JavaScript a truncated inbox would say nothing
    about the rest of itself. noscript, so a reader with JavaScript sees one
    mechanism rather than two. %>
<noscript><%= render "shared/pager", pagy: @pagy %></noscript>
