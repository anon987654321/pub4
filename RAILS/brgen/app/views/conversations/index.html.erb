<div class="page-header" role="banner" aria-label="Messages header">
  <h1>Messages</h1>
</div>

<section class="messenger-compose" aria-label="Start a conversation">
  <%= form_with url: conversations_path, method: :post, class: "messenger-compose-form" do |f| %>
    <%= f.label :username, "New message" %>
    <div class="messenger-compose-row">
      <%= f.text_field :username, placeholder: "Username", required: true, autocomplete: "username" %>
      <%= f.submit "Start chat", class: "btn" %>
    </div>
  <% end %>
</section>

<% if @conversations.any? %>
  <ul role="list" aria-label="Conversations">
    <% @conversations.each do |c| %>
      <% other = (c.participants - [Current.user]).first %>
      <% last  = c.messages.last %>
      <li role="listitem">
        <%= link_to conversation_path(c) do %>
          <strong><%= other&.display_name || "anon" %></strong>
          <% if last %>
            <span><%= truncate(last.content.to_s, length: 80) %></span>
            <time datetime="<%= last.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(last.created_at) %> ago</time>
          <% end %>
          <% unread = c.unread_count_for(Current.user) %>
          <% if unread.positive? %><mark><%= unread %></mark><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: "No conversations yet",
        body: "Message someone from a profile or match — no signup required.",
        action: { label: "Nearby", path: nearby_path } %>
<% end %>
