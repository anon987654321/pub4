<%# The Messenger entry's unread count, in the nav's counter pill; 99+ keeps the
    pill from growing past its word. The wrapper is always drawn, empty at zero,
    so InboxBroadcastJob has something to replace when the first message lands
    and when the last one is read. It is drawn twice, in the swiper and on the
    tab bar's Messages icon, each copy under its own id (InboxBroadcastJob
    replaces both); the tab bar's copy also keeps the tab title's count. %>
<% badge_id = local_assigns.fetch(:badge_id, "messenger_unread_badge") %>
<% title = local_assigns[:title] ? { controller: "unread-title", unread_title_count_value: count } : {} %>
<%= tag.span id: badge_id, data: title do %>
  <% if count.positive? %>
    <sup class="nav_link_badge"><%= count > 99 ? "99+" : count %></sup>
    <%= tag.span t("messages.unread_badge", count:), class: "visually-hidden" %>
  <% end %>
<% end %>
