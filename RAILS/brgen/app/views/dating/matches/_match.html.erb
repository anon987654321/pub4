<% other = match.other_user(Current.user) %>
<article class="match-row">
  <% if other.dating_profile&.photos&.attached? %>
    <%= lazy_image_tag other.dating_profile.photos.first, alt: other.display_name, class: "match-avatar" %>
  <% end %>
  <div class="match-info">
    <strong><%= other.email_address.split("@").first %></strong>
    <p class="dim">Matched</p>
  </div>
</article>