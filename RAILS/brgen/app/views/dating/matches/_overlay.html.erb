<div class="match-overlay">
  <div class="match-overlay-card">
    <p class="match-overlay-eyebrow">Dating</p>
    <h2>It's a match!</h2>
    <% other = current_user == match.initiator ? match.receiver : match.initiator %>
    <p><%= other&.display_name || "Someone" %> is ready to chat.</p>
    <%= link_to "Open messages", conversations_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>
