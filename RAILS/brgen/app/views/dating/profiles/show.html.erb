<% content_for :title, "Your profile" %>

<div class="page-header" role="banner">
  <h1>Your profile</h1>
  <%= link_to "Edit", edit_dating_profile_path, class: "btn btn-ghost btn-sm" %>
</div>

<nav class="sort-tabs" aria-label="Profile sections" role="tablist" data-controller="tabs">
  <a href="#photos" class="sort-tab active" id="profile-photos-tab" role="tab" aria-selected="true" data-tabs-target="tab" data-tabs-hash-value="#photos" data-action="click->tabs#select">Photos</a>
  <a href="#about" class="sort-tab" id="profile-about-tab" role="tab" aria-selected="false" data-tabs-target="tab" data-tabs-hash-value="#about" data-action="click->tabs#select">About</a>
  <a href="#details" class="sort-tab" id="profile-details-tab" role="tab" aria-selected="false" data-tabs-target="tab" data-tabs-hash-value="#details" data-action="click->tabs#select">Details</a>
</nav>

<section data-tabs-target="panel" data-tabs-hash-value="#photos" aria-labelledby="profile-photos-tab">
  <% if @profile.photos.attached? %>
    <div class="photo-strip">
      <% @profile.photos.each do |photo| %>
        <%= lazy_image_tag photo, alt: @profile.name, blurhash: photo.try(:metadata).try(:[], "blurhash"), class: "photo-thumb" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: "No photos yet", body: "Add photos on your profile edit screen." %>
  <% end %>
</section>

<section data-tabs-target="panel" data-tabs-hash-value="#about" aria-labelledby="profile-about-tab" hidden>
  <article>
    <% if @profile.bio.present? %>
      <%= read_more(@profile.bio, lines: 3, more: "Read bio", less: "Show less") %>
    <% else %>
      <p><span class="dim">Bio</span><br>—</p>
    <% end %>
  </article>
</section>

<section data-tabs-target="panel" data-tabs-hash-value="#details" aria-labelledby="profile-details-tab" hidden>
  <article>
    <p>
      <span class="dim">Age</span> · <%= @profile.age || "—" %>
      &nbsp;
      <span class="dim">Gender</span> · <%= @profile.gender || "—" %>
      &nbsp;
      <span class="dim">Looking for</span> · <%= @profile.looking_for || "—" %>
    </p>
  </article>

  <article>
    <p>
      <span class="dim">Location</span> · <%= @profile.location.presence || "—" %>
      <% if @profile.neighborhood&.name.present? %> · <span class="dim">Bydel</span> · <%= @profile.neighborhood.name %><% end %>
      &nbsp;
      <span class="dim">Visibility</span> ·
      <% if @profile.visible? %>
        <span class="text-visible">visible</span>
      <% else %>
        <span class="text-hidden">hidden</span>
      <% end %>
    </p>
  </article>

  <article>
    <p class="dim text-sm">
      Your profile is <%= @profile.visible? ? "visible to others in your city" : "hidden — no one can see it" %>.
      <%= link_to(@profile.visible? ? "Hide profile" : "Show profile", edit_dating_profile_path, class: "link-inherit") %>.
    </p>
  </article>
</section>
