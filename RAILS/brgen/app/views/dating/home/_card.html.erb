<% display_name = profile.user&.display_name.presence || profile.user&.email_address.to_s.split("@").first.presence || "anon" %>
<article
  class="swipe-card swipe-card--stack-<%= index %>"
  data-user-id="<%= profile.user_id %>"
>
  <div class="swipe-photo">
    <% if profile.photos.attached? %>
      <%= lazy_image_tag profile.photos.first, alt: display_name, blurhash: profile.photos.first.try(:metadata).try(:[], "blurhash") %>
    <% else %>
      <div class="swipe-placeholder">
        <span><%= display_name.to_s.first.upcase %></span>
      </div>
    <% end %>
    <span class="swipe-stamp swipe-stamp--like" aria-hidden="true">LIKE</span>
    <span class="swipe-stamp swipe-stamp--pass" aria-hidden="true">NOPE</span>
    <div class="swipe-overlay">
      <div class="swipe-meta">
        <h2 class="swipe-name">
          <%= display_name %>
          <% if profile.age %><span class="swipe-age">, <%= profile.age %></span><% end %>
        </h2>
        <% if profile.location.present? || profile.neighborhood&.name.present? %>
          <p class="swipe-location">
            <%= [profile.location, profile.neighborhood&.name].compact.join(" · ") %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="swipe-body">
    <% if profile.bio.present? %><p class="swipe-bio"><%= profile.bio %></p><% end %>
    <div class="chips swipe-chips">
      <% if profile.gender.present? %><span class="chip"><%= profile.gender %></span><% end %>
      <% if profile.looking_for.present? %><span class="chip">Looking for <%= profile.looking_for %></span><% end %>
      <span class="chip chip--status"><%= profile.visible? ? "visible" : "paused" %></span>
    </div>
  </div>

  <% if Current.user.present? %>
    <div class="swipe-actions">
      <%= button_tag "✕", type: "button", class: "swipe-action swipe-action--pass", title: "Pass", aria: { label: "Pass" }, data: { action: "click->swipe#pass" } %>
      <%= button_tag "♥", type: "button", class: "swipe-action swipe-action--like", title: "Like", aria: { label: "Like" }, data: { action: "click->swipe#like" } %>
    </div>
  <% else %>
    <p class="dim swipe-signin">Refresh to start swiping — no signup needed.</p>
  <% end %>
</article>
