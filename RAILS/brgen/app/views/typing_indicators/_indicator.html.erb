<p id="typing-indicator" class="messenger-typing" role="status"
   data-controller="typing"
   data-typing-conversation-id-value="<%= conversation.id %>">
  <% typers = conversation.typing_indicators.active.includes(:user).reject { |t| t.user_id == except_user&.id } %>
  <% if typers.one? %>
    <%= t("messages.typing_one", name: typers.first.user.username) %>
  <% elsif typers.size <= 2 %>
    <%= t("messages.typing_many", names: typers.map { |typing| typing.user.username }.join(", ")) %>
  <% elsif typers.any? %>
    <%= t("messages.typing_many_truncated",
          names: typers.first(2).map { |typing| typing.user.username }.join(", "),
          count: typers.size - 2) %>
  <% end %>
</p>
