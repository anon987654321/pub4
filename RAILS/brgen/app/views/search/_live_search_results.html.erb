<% if @query.present? %>
  <%# Take the eight first, then ask whether there are any.
      `records.blank?` on a relation is `records.to_a.blank?` -- it loaded every
      matching row of each of the seven verticals just to decide whether to
      render the section, and then `limit(8)` issued a second, bounded query
      for the rows actually shown. SearchController hands several of these in
      unbounded (Tv::Channel.all, Place.all), and Shared::LiveSearch adds a
      WHERE but no LIMIT -- only its counter limits, and only for counting.
      SearchSections takes the eight. %>
  <% sections = SearchSections.from(@results) %>
  <% if sections.empty? %>
    <%# empty_state: no-action-ok — the search field above is the next step %>
    <%= render "shared/empty_state", title: t("search.no_results", query: @query), body: t("search.no_results_body") %>
  <% end %>
  <%= render partial: "search/result_section", collection: sections, as: :section %>
<% end %>
