<% if @query.present? %>
  <% @results.each do |vertical, records| %>
    <% next if records.blank? %>
    <section>
      <h2><%= vertical.to_s.humanize %></h2>
      <ul>
        <% records.limit(8).each do |record| %>
          <% label = record.try(:title) || record.try(:name) || record.try(:display_name) || record.try(:username) %>
          <% href = record_public_href(record) rescue nil %>
          <li><%= href ? link_to(label, href) : label %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
