<% content_for :title, t("nav.search") %>
<%# Out of the index: a results page is a query, not a page of its own. %>
<% content_for :head, robots_meta(index: false) %>

<header class="page-header">
  <%= tag.h1 t("search.title") %>
</header>

<%= live_search_index url: global_search_path, results_partial: "search/live_search_results", placeholder: t("search.placeholder"), label: t("search.label"), query: @query %>
