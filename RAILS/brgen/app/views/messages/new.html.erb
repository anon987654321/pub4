<div class="page-header" role="banner" aria-label="New message header">
  <h1>New message</h1>
</div>

<% if @message&.errors&.any? %>
  <ul role="alert" aria-live="assertive">
    <% @message.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @message, url: conversation_messages_path(@conversation), id: "new_message", html: { role: "form", "aria-label": "Send message form" } do |f| %>
  <p><%= f.text_area :content, rows: 4, placeholder: "Message...", data: { controller: "char-counter", "char-counter-max-value": 500 } %><span class="char-counter" data-char-counter-target="counter"></span></p>
  <%= f.hidden_field :message_type, value: "text" %>
  <p><%= f.submit "Send" %></p>
<% end %>
