<% in_channel = message.conversation.channel? %>
<% who = in_channel ? message.sender.channel_handle : message.sender.display_name %>
<li id="<%= dom_id(message) %>" role="listitem">
<%# data-sender-id is viewer-independent so it stays correct when this partial
    is rendered from a broadcast job (no Current.user); the conversation-log
    controller turns it into data-from on arrival. %>
<article data-sender-id="<%= message.sender_id %>" data-from="<%= message.sender_id == Current.user&.id ? "self" : "peer" %>"<%= " data-bot" if in_channel && message.sender.bot? %><%= " data-expiry=\"#{message.expiry_urgency}\"" if message.expiry_urgency %> aria-label="Message from <%= who %>">
  <header>
    <span><%= who %></span>
    <time datetime="<%= message.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(message.created_at) %> ago</time>
    <% if message.expires_at %>
      <span class="expiry-chip" data-expiry="<%= message.expiry_urgency %>">· disappears <%= time_ago_in_words(message.expires_at) %></span>
    <% end %>
    <% receipt = message.message_receipts.find_by(user: Current.user) %>
    <% if receipt&.read? %><span class="dim">· read</span><% end %>
  </header>
  <p><%= message.content %></p>
  <%= render "messages/reactions", message: message %>
  <% if message.attachment.attached? %>
    <% if message.message_type == "image" %>
      <%= lazy_image_tag message.attachment, alt: message.attachment.filename.base, blurhash: message.attachment.try(:metadata).try(:[], "blurhash") %>
    <% elsif message.message_type == "audio" %>
      <%= audio_tag message.attachment, controls: true %>
    <% else %>
      <%= link_to message.attachment.filename, message.attachment %>
    <% end %>
  <% end %>
</article>
</li>
