<% in_channel = message.conversation.channel? %>
<% who = in_channel ? message.sender.channel_handle : message.sender.display_name %>
<li id="<%= dom_id(message) %>" role="listitem">
<%# data-sender-id is viewer-independent so it stays correct when this partial
    is rendered from a broadcast job (no Current.user); the conversation-log
    controller turns it into data-from on arrival. %>
<article data-sender-id="<%= message.sender_id %>" data-from="<%= message.sender_id == Current.user&.id ? "self" : "peer" %>"<%= " data-bot" if in_channel && message.sender.bot? %><%= " data-expiry=\"#{message.expiry_urgency}\"" if message.expiry_urgency %> aria-label="<%= t("messages.from_aria", name: who) %>">
  <header>
    <span class="msg-nick" style="<%= nick_style(who) %>"><%= who %></span>
    <%# A channel is a transcript, so the time is absolute and stable: [19:32],
        the way every IRC client prints it. Relative time ("3 minutes ago")
        suits a DM, where recency is the question, but in a room it rewrites
        every visible line on a timer and gives you nothing to refer back to.
        The timeago Stimulus controller is gone from this tree entirely: it
        reads data-timeago-datetime-value, no view ever set one, and its only
        effect if it had fired would be to overwrite the server's Norwegian
        with date-fns English. %>
    <% if in_channel %>
      <time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%H:%M") %></time>
    <% else %>
      <time datetime="<%= message.created_at.iso8601 %>"><%= time_ago(message.created_at) %></time>
    <% end %>
    <% if message.expires_at %>
      <%# A future span, so not time_ago — "forsvinner om …", not "for … siden". %>
      <span class="expiry-chip" data-expiry="<%= message.expiry_urgency %>">· <%= t("messages.disappears_in", time: time_ago_in_words(message.expires_at)) %></span>
    <% end %>
    <% receipt = message.message_receipts.find_by(user: Current.user) %>
    <% if receipt&.read? %><span class="dim">· <%= t("messages.read") %></span><% end %>
  </header>
  <p><%= format_chat_body(message.content) %></p>
  <%= render "messages/reactions", message: message %>
  <% if message.attachment.attached? %>
    <% if message.message_type == "image" %>
      <%= lazy_image_tag message.attachment, alt: message.attachment.filename.base, blurhash: message.attachment.try(:metadata).try(:[], "blurhash") %>
    <% elsif message.message_type == "audio" %>
      <%= audio_tag message.attachment, controls: true %>
    <% else %>
      <%= link_to message.attachment.filename, message.attachment %>
    <% end %>
  <% end %>
</article>
</li>
