<% in_channel = message.conversation.channel? %>
<%# A broadcast is rendered once, inside the sender's request, and delivered
    to everyone in the thread, so in it there is no viewer: Current.user is
    the sender, and reading it gave every recipient the sender's edit and
    unsend links and hid their own report button. Rendered with broadcast:
    true, the line carries every control, each marked for the sender or for
    the others, and conversation_log_controller keeps the ones that belong to
    whoever is looking. %>
<% broadcast = local_assigns.fetch(:broadcast, false) %>
<% viewer = broadcast ? nil : Current.user %>
<% who = in_channel ? message.sender.channel_handle : message.sender.display_name %>
<li id="<%= dom_id(message) %>" role="listitem">
<%# data-sender-id is viewer-independent so it stays correct when this partial
    is rendered from a broadcast job (no Current.user); the conversation-log
    controller turns it into data-from on arrival. %>
<article data-sender-id="<%= message.sender_id %>"
         data-from="<%= message.sender_id == viewer&.id ? "self" : "peer" %>"
         <%= " data-bot" if in_channel && message.sender.bot? %>
         <%= " data-expiry=\"#{message.expiry_urgency}\"" if message.expiry_urgency %>
         aria-label="<%= t("messages.from_aria", name: who) %>">
  <header>
    <span class="msg-nick" style="<%= nick_style(who) %>"><%= who %></span> <%# scan: intentional — nick_style emits only the --nick-hue custom property %>
    <%# A channel is a transcript, so the time is absolute and stable: [19:32],
        the way every IRC client prints it. Relative time ("3 minutes ago")
        suits a DM, where recency is the question, but in a room it rewrites
        every visible line on a timer and gives you nothing to refer back to.
        The timeago Stimulus controller is gone from this tree entirely: it
        reads data-timeago-datetime-value, no view ever set one, and its only
        effect if it had fired would be to overwrite the server's Norwegian
        with date-fns English. %>
    <% if in_channel %>
      <time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%H:%M") %></time>
    <% else %>
      <time datetime="<%= message.created_at.iso8601 %>"><%= time_ago(message.created_at) %></time>
    <% end %>
<%# messages#update sets edited_at and nothing ever showed it, so a message
    could change under a reader with no sign that it had. The marker is the
    whole contract: an edit is allowed because it is visible. %>
<% if message.edited_at.present? %>
  <span class="edited-mark" title="<%= l(message.edited_at, format: :short) %>">· <%= t("messages.edited") %></span>
<% end %>
    <% if message.expires_at %>
      <%# A future span, so not time_ago — "forsvinner om …", not "for … siden". %>
      <span class="expiry-chip" data-expiry="<%= message.expiry_urgency %>">· <%= t("messages.disappears_in", time: time_ago_in_words(message.expires_at)) %></span>
    <% end %>
    <% if message.conversation.view_once? %>
      <span class="expiry-chip">· <%= t("messages.view_once_chip") %></span>
    <% end %>
    <%# The sender's state for this line: sent, or read. It used to print the
        VIEWER's own receipt, so it said "read" on lines the reader had opened
        and never told a sender anything. The state comes from the other
        people's receipts, so it is the same for every viewer and a broadcast
        render with no Current.user is right too; the stylesheet shows it on the
        viewer's own lines only. The id is what Conversation#mark_read_for!
        updates in place when the recipient opens the thread. %>
    <% unless in_channel %>
      <span class="read-receipt" id="delivery_<%= dom_id(message) %>"><%= render "messages/delivery", message: message %></span>
    <% end %>
  </header>
  <% if message.story_id %>
    <p class="msg-reply-context"><%= t("messages.replying_to_story") %></p>
  <% end %>
  <% if message.forwarded? %>
    <p class="msg-forwarded"><%= t("messages.forwarded") %></p>
  <% end %>
  <%# An unsent parent keeps its row with a blank body and an expired one is
      gone from the log, so either reads as a note rather than "Name: ".
      Otherwise the line links to the parent, which :target lights up. %>
  <% if message.reply? && message.parent %>
    <% parent = message.parent %>
    <% if parent.deleted? || parent.expired? %>
      <%= tag.p t("messages.parent_gone"), class: "msg-reply-context" %>
    <% else %>
      <% replying = t("messages.replying_to", name: parent.sender.display_name) %>
      <% quoted = [ replying, truncate(parent.content.to_s, length: 60) ] %>
      <%= tag.p link_to(quoted.join(": "), "##{dom_id(parent)}"), class: "msg-reply-context" %>
    <% end %>
  <% end %>
  <%= tag.p format_chat_body(message.content) %>
  <% if message.link_preview&.ok? %>
    <%# Title, site and summary — no remote image. Hotlinking one would tell
        that server the IP of everyone reading the thread, and proxying it is
        remote media hosting, which is a larger problem than a chat preview. %>
    <%= link_to message.link_preview.url, class: "link-preview", rel: "nofollow noopener", target: "_blank" do %>
      <span class="link-preview-site"><%= message.link_preview.site_name.presence || message.link_preview.host %></span>
      <span class="link-preview-title"><%= message.link_preview.title.presence || message.link_preview.url %></span>
      <% if message.link_preview.description.present? %>
        <span class="link-preview-body"><%= truncate(message.link_preview.description, length: 160) %></span>
      <% end %>
    <% end %>
  <% end %>
  <%# Part of the message, so above its actions rather than after them. The alt
      says whose photo it is; the uploaded file's name ("IMG_4031") says nothing. %>
  <% if message.attachment.attached? %>
    <% attachment = message.attachment %>
    <% if message.message_type == "image" %>
      <%= lazy_image_tag attachment, alt: t("messages.photo_from", name: who),
            blurhash: attachment.try(:metadata).try(:[], "blurhash") %>
    <% elsif message.message_type == "audio" %>
      <%= audio_tag message.attachment, controls: true, aria: { label: t("messages.voice_note_from", name: who) } %>
      <% if message.duration_seconds.to_i.positive? %>
        <%= tag.time format("%d:%02d", *message.duration_seconds.to_i.divmod(60)),
              datetime: "PT#{message.duration_seconds.to_i}S", class: "msg-voice-duration" %>
      <% end %>
    <% else %>
      <%= link_to message.attachment.filename, message.attachment %>
    <% end %>
  <% end %>
  <%= render "messages/reactions", message: message, broadcast: broadcast %>
  <%# Reply, edit, unsend and forward all had a route, a model method and no
      control anywhere in the tree, so none of them could be reached from a
      page. Plain forms and links rather than a Stimulus controller: the state
      each one needs lives in the URL, and a message list is long. %>
  <% if !message.deleted? && (broadcast || !in_channel || message.sender_id != viewer&.id) %>
    <details class="msg-actions">
      <summary><%= t("messages.actions") %></summary>
      <% sender = message.sender %>
      <% messageable = !sender.guest? && !sender.bot? && sender.deleted_at.blank? %>
      <% if in_channel && (broadcast || viewer.present?) && messageable %>
        <%= button_to t("messages.private_message_action"), user_conversations_path(message.sender),
              method: :post, class: "msg-action", form: { data: { for: "others" } } %>
      <% else %>
        <%# Reply fills the composer in place (message-reply on the pane); Edit
            swaps only the composer's frame. Both hrefs are the no-JS path. %>
        <%= link_to t("messages.reply"), conversation_path(message.conversation, reply_to: message.id),
                    data: { action: "message-reply#start", message_reply_id_param: message.id } %>
        <% if message.editable_by?(broadcast ? message.sender : viewer) %>
          <%= link_to t("actions.edit"), conversation_path(message.conversation, edit: message.id),
                      data: { for: "sender", turbo_frame: "messenger_composer" } %>
        <% end %>
        <% if message.deletable_by?(broadcast ? message.sender : viewer) %>
          <%= button_to t("messages.unsend"), conversation_message_path(message.conversation, message), method: :delete,
                data: { turbo_confirm: t("messages.confirm_unsend") }, form: { data: { for: "sender" } } %>
        <% end %>
        <%# A link to one picker, not a select of every other thread on every
            line: fifty copies of that list made the thread page heavy. %>
        <% if message.forwardable? %>
          <%= link_to t("messages.forward"), forward_to_conversation_message_path(message.conversation, message) %>
        <% end %>
        <%# Reporting is for someone else's line, and for a signed-in person: a
            report names its author, and an anonymous visitor has no name to put
            on one. %>
        <% if broadcast || (message.sender_id != viewer&.id && authenticated?) %>
          <%= render "shared/report_button", target: message, reason: "abuse",
                     marks: (broadcast ? { for: "others", needs_account: true } : {}) %>
        <% end %>
      <% end %>
    </details>
  <% end %>
</article>
</li>
