<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mail-shell">
  <tr><td class="mail-brand">Brgen</td></tr>
  <tr>
    <td class="mail-typo-hero">
      <%= tag.h1 t("mailer.confirm_subscription") %>
      <%= tag.p t("mailer.permission_marketing") %>
    </td>
  </tr>
  <tr>
    <td class="mail-lede-wrap">
      <p class="mail-lede">
        <%= t("mailer.confirm_lede") %>
      </p>
    </td>
  </tr>
  <tr>
    <td class="mail-cta-wrap">
      <a href="<%= @confirm_url %>" class="mail-cta"><%= t("mailer.confirm_button") %></a>
    </td>
  </tr>
  <tr><td class="mail-signoff"><%= t("mailer.signoff") %></td></tr>
  <tr><td class="mail-permission"><%= t("mailer.not_you") %></td></tr>
  <tr>
    <td class="mail-footer">
      <a href="<%= @unsubscribe_url %>"><%= t("newsletter.unsubscribe_link") %></a>
    </td>
  </tr>
</table>
