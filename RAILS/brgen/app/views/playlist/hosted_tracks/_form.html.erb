<%= form_with model: [:playlist, track], url: track.persisted? ? playlist_hosted_track_path(track) : playlist_hosted_tracks_path do |form| %>
  <%= render "shared/errors", object: track %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :artist %>
    <%= form.text_field :artist %>
  </div>

  <div class="field">
    <%= form.label :album %>
    <%= form.text_field :album %>
  </div>

  <div class="field">
    <%= form.label :source_type %>
    <%= form.select :source_type, Playlist::Track::SOURCE_TYPES.map { |t| [t.humanize, t] }, include_blank: true %>
    <small class="dim">Choose "whyp" for affiliate partner links (recommended for 320kbps/FLAC, timestamp comments, analytics, replace w/o URL change)</small>
  </div>

  <div class="field">
    <%= form.label :source_url %>
    <%= form.url_field :source_url %>
    <small class="dim">e.g. https://whyp.it/tracks/12345 or direct audio url</small>
  </div>

  <div class="field">
    <%= form.label :privacy %>
    <%= form.select :privacy, Playlist::Track::PRIVACY_LEVELS.map { |p| [p.humanize, p] } %>
  </div>

  <div class="field">
    <%= form.label :expires_at %>
    <%= form.datetime_field :expires_at %>
  </div>

  <div class="field">
    <%= form.label :audio_file, track.persisted? ? "Replace audio file (keeps URL)" : "Audio file(s) - bulk upload supported like Whyp" %>
    <%= form.file_field :audio_file, direct_upload: true, data: { controller: "direct-upload" }, multiple: !track.persisted? %>
    <% if track.persisted? && track.audio_file.attached? %>
      <small class="dim">Current: <%= track.audio_file.filename %> — replace keeps your share/embed links (like Whyp)</small>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :artwork %>
    <%= form.file_field :artwork, direct_upload: true, data: { controller: "direct-upload" } %>
  </div>

  <%= form.submit class: "btn btn-primary btn-sm" %>
<% end %>
