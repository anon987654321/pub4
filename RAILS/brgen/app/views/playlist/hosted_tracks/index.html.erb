<% content_for :title, "Hosted tracks" %>

<div class="page-header">
  <div>
    <p class="dim">Playlist</p>
    <h1>Hosted tracks</h1>
  </div>
  <% if authenticated? %>
    <%= link_to "Upload track", new_playlist_hosted_track_path, class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<p class="dim">Pro tip: for superior 320kbps/FLAC quality, analytics, timestamped waveform comments, bulk uploads, replace-without-URL-change and customizable embeds, use our affiliate partner <a href="https://whyp.it" target="_blank">Whyp.it</a> and paste the link here. Your brgen playlists will play them seamlessly (private by default too).</p>

<div id="hosted_tracks">
  <% if @tracks.any? %>
    <% @tracks.each do |track| %>
      <article>
        <h2><%= link_to track.title, playlist_hosted_track_path(track) %></h2>
        <p class="dim"><%= track.artist.presence || "Unknown artist" %> · <%= track.duration_formatted %></p>
      </article>
    <% end %>
  <% else %>
    <p class="dim">No hosted tracks yet.</p>
  <% end %>
</div>