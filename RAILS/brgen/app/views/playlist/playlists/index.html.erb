<% content_for :title, "radio.brgen.no" %>

<%= render "playlist/playlists/radio_tunnel", show_library: true, playlists: @playlists, pagy: @pagy %>

<% if @trending_playlists.any? %>
  <section class="section-divider" aria-label="City trending playlists">
    <p class="section-heading--md">Trending nearby</p>
    <div class="radio-library-list">
      <% @trending_playlists.each do |playlist| %>
        <%= link_to playlist_playlist_path(playlist), class: "radio-library-item" do %>
          <strong><%= playlist.name %></strong>
          <span><%= playlist.tracks_count.to_i %> tracks · <%= playlist.plays_count.to_i %> plays</span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
