<% content_for :title, "New playlist" %>

<div class="page-header" role="banner" aria-label="New playlist header">
  <h1>New playlist</h1>
</div>

<turbo-frame id="playlist-new" data-turbo-action="replace">
<div class="form-wrap">
  <%= form_with model: @playlist, url: playlist_playlists_path, html: { role: "form", "aria-label": "Create playlist" } do |f| %>
    <%= render "shared/errors", object: @playlist %>
    <div class="field"><%= f.label :name %><%= f.text_field :name %></div>
    <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 3, data: { controller: "char-counter", "char-counter-max-value": 1000 } %><span class="char-counter" data-char-counter-target="counter"></span></div>
    <div class="field field--check"><%= f.check_box :public_access %><%= f.label :public_access, "Public" %></div>
    <div class="field field--check"><%= f.check_box :collaborative %><%= f.label :collaborative, "Collaborative" %></div>
    <div class="field"><%= f.submit "Create", class: "btn btn-primary" %></div>
  <% end %>
</div>
