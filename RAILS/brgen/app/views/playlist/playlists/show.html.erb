<% content_for :title, @playlist.name %>
<% content_for :json_ld, json_ld_for(@playlist, type: :music_playlist) if @playlist.public_access? %>

<p class="radio-back-link"><%= link_to "← radio", playlist_root_path %></p>
<%= render "playlist/playlists/player", playlist: @playlist, tracks: @tracks, color: params[:color] || "#00d4ff", comments: @comments, track_comments: @track_comments %>

<%# Simple collection analytics like Whyp %>
<p class="dim"><%= @playlist.plays_count.to_i %> plays across <%= @tracks.size %> tracks · <%= @comments.size %> comments total. For full dashboards + locations use affiliate partner Whyp.</p>

<% if authenticated? && (Current.user == @playlist.user || @playlist.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
  <section class="playlist-admin" aria-label="Playlist management">
    <nav class="cluster" role="navigation" aria-label="Playlist actions">
      <%= link_to "Edit", edit_playlist_playlist_path(@playlist), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", playlist_playlist_path(@playlist), method: :delete, data: { turbo_confirm: "Delete?" }, class: "btn btn-danger btn-sm" %>
    </nav>

    <div class="section-divider">
      <p class="section-heading">Add a track</p>
      <div class="form-wrap form-wrap--flush">
        <%= form_with url: playlist_playlist_tracks_path(@playlist), scope: :playlist_track do |f| %>
          <div class="field"><%= f.text_field :title, placeholder: "Title" %></div>
          <div class="field"><%= f.text_field :artist, placeholder: "Artist" %></div>
          <div class="field"><%= f.select :source_type, Playlist::Track::SOURCE_TYPES.map { |type| [type.humanize, type] }, include_blank: "Source" %></div>
          <div class="field"><%= f.url_field :source_url, placeholder: "URL (optional)" %></div>
          <div class="field"><%= f.datetime_field :expires_at %></div>
          <div class="field"><%= f.submit "Add", class: "btn btn-primary btn-sm" %></div>
        <% end %>
      </div>
    </div>

    <div class="section-divider">
      <p class="section-heading">Import links</p>
      <div class="form-wrap form-wrap--flush">
        <%= form_with url: playlist_playlist_imports_path(@playlist), method: :post do |f| %>
          <div class="field"><%= f.text_area :urls, rows: 4, placeholder: "Paste Spotify, YouTube, SoundCloud, Whyp, or direct audio URLs, one per line (Whyp recommended for 320kbps/FLAC + analytics + comments)" %></div>
          <div class="field"><%= f.submit "Import", class: "btn btn-primary btn-sm" %></div>
        <% end %>
      </div>
    </div>

    <div class="section-divider">
      <p class="section-heading">Embed (customize like Whyp: ?color=ff0000&amp;show_artwork=0&amp;compact=1)</p>
      <input type="text" readonly value="<iframe src=&quot;<%= embed_playlist_playlist_url(@playlist) %>&quot; loading=&quot;lazy&quot; width=&quot;100%&quot; height=&quot;520&quot;></iframe>" class="field--grow">
      <small>Examples: <a href="<%= embed_playlist_playlist_url(@playlist, color: "ff0000") %>">red</a> | <a href="<%= embed_playlist_playlist_url(@playlist, color: "00ff00", show_artwork: "0") %>">no artwork</a> | <a href="<%= embed_playlist_playlist_url(@playlist, compact: "1", hide_branding: "1") %>">compact clean</a></small>
      <p class="dim">Use our affiliate partner <a href="https://whyp.it" target="_blank">Whyp.it</a> for even better customizable embeds, timestamp comments, bulk replace, and real analytics dashboards on your audio.</p>
    </div>
  </section>
<% end %>

<% if authenticated? %>
  <details class="playlist-details">
    <summary>Collaborators &amp; dilla sketches</summary>
    <section role="region" aria-label="Collaborators">
      <h2>Collaborators</h2>
      <% if @playlist.collaborations.any? %>
        <% @playlist.collaborations.includes(:user).each do |c| %>
          <span class="dim"><%= c.user&.username || c.user&.email %> (<%= c.role %>)</span>
          <% if Current.user == @playlist.user || c.user == Current.user %>
            <%= button_to "Remove", playlist_playlist_collaboration_path(@playlist, c), method: :delete, class: "btn btn-ghost btn-sm" %>
          <% end %>
        <% end %>
      <% else %>
        <p class="dim">No collaborators yet.</p>
      <% end %>

      <% if Current.user == @playlist.user || @playlist.collaborations.exists?(user: Current.user, role: %w[owner editor]) %>
        <div class="form-wrap">
          <%= form_with url: playlist_playlist_collaborations_path(@playlist), method: :post do |f| %>
            <div class="field field--row">
              <%= f.text_field :username, placeholder: "username", class: "field--grow" %>
              <%= f.select :role, %w[editor viewer] %>
              <%= f.submit "Add collaborator", class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section role="region" aria-label="Dilla sketches">
      <h2>Dilla sketches / beats</h2>
      <% if @dilla_sketches.any? %>
        <% @dilla_sketches.each do |sk| %>
          <div>
            <strong><%= sk.name %></strong> by <%= sk.user&.display_name || "anon" %>
            <% if sk.lab_url.present? %>
              <a href="<%= sk.lab_url %>" target="_blank" class="btn btn-ghost btn-sm">open in lab</a>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="dim">No sketches yet.</p>
      <% end %>
    </section>
  </details>
<% end %>
