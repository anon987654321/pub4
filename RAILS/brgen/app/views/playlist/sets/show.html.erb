<% content_for :title, @set.name %>

<div class="page-header" role="banner">
  <div>
    <p class="dim">Playlist set</p>
    <h1><%= @set.name %></h1>
  </div>
  <% if authenticated? && (Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
    <div class="cluster">
      <%= link_to "Edit", edit_playlist_set_path(@set), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", playlist_set_path(@set), method: :delete, data: { turbo_confirm: "Delete?" }, class: "btn btn-danger btn-sm" %>
    </div>
  <% end %>
</div>

<%# Collection player: waveform, timestamp comments, queue auto-next, customizable %>
<%= render "playlist/playlists/player", playlist: @set, tracks: @tracks, playlist_name: @set.name, tracks_count: @tracks.count, plays_count: 0, color: params[:color] || "#00d4ff", comments: @comments, track_comments: @track_comments %>

<article>
  <% if @set.description.present? %>
    <p><%= @set.description %></p>
  <% end %>
  <p class="dim"><%= @set.privacy.presence&.humanize || "Public" %> · <%= @tracks.count %> tracks · <%= @set.formatted_duration %></p>
  <% if @set.collaborative? %>
    <p class="dim">Collaborative</p>
  <% end %>
  <% if authenticated? %>
    <div class="cluster">
      <% if @set.likes.exists?(user: Current.user) %>
        <%= button_to "Unlike", playlist_set_like_path(@set), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to "Like", playlist_set_like_path(@set), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
      <span class="dim"><%= @set.likes.count %> likes</span>
    </div>
  <% else %>
    <p class="dim"><%= @set.likes.count %> likes</p>
  <% end %>
</article>

<% if authenticated? %>
  <% set_can_manage = Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor]) %>
  <%= render "playlist/shared/collaborators",
        parent: @set,
        collaborations: @set.collaborations,
        collaborations_path: playlist_set_collaborations_path(@set),
        collaboration_path_proc: ->(c) { playlist_set_collaboration_path(@set, c) },
        can_manage: set_can_manage %>
  <%= render "playlist/shared/dilla_sketches",
        parent: @set,
        sketches: @dilla_sketches,
        create_url: playlist_set_dilla_sketches_path(@set),
        render_path_proc: ->(sk) { render_audio_playlist_set_dilla_sketch_path(@set, sk) },
        destroy_path_proc: ->(sk) { playlist_set_dilla_sketch_path(@set, sk) },
        can_manage: set_can_manage,
        rich_form: false %>
<% end %>

<% if @set_tracks.any? %>
  <% @set_tracks.each do |set_track| %>
    <article
      data-track-id="<%= set_track.track.id %>"
      data-controller="swipe"
      data-swipe-listen-url-value="<%= playlist_listens_path(track_id: set_track.track.id) %>"
      data-action="pointerdown->swipe#pointerDown pointermove->swipe#pointerMove pointerup->swipe#pointerUp pointercancel->swipe#pointerUp touchstart->swipe#pointerDown touchmove->swipe#pointerMove touchend->swipe#pointerUp"
      class="track-row"
    >
      <div>
        <strong><%= set_track.track.title %></strong>
        <% if set_track.track.artist.present? %> — <%= set_track.track.artist %><% end %>
        <span class="dim"> · <%= set_track.track.duration_formatted %></span>
      </div>
      <% if authenticated? && (Current.user == set_track.user || Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
        <%= button_to "Remove", playlist_set_track_path(@set, set_track), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </article>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_tracks"),
        body: "Add a track to build this set.",
        action: { label: t("playlist.browse_sets"), path: playlist_sets_path } %>
<% end %>

<% if authenticated? && (Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
  <div class="section-divider">
    <p class="section-heading">Add a track</p>
    <div class="form-wrap form-wrap--flush">
      <%= form_with url: playlist_set_tracks_path(@set), scope: :playlist_track do |form| %>
        <div class="field"><%= form.text_field :title, placeholder: t("playlist.title"), required: true %></div>
        <div class="field"><%= form.text_field :artist, placeholder: t("playlist.artist") %></div>
        <div class="field"><%= form.url_field :source_url, placeholder: t("playlist.url_optional") %></div>
        <div class="field"><%= form.submit "Add", class: "btn btn-primary btn-sm" %></div>
      <% end %>
    </div>
  </div>
<% end %>

<% if authenticated? %>
<section>
  <h2>Listening party</h2>
  <p class="dim">Start or join a real-time synced listening session with embedded player and chat.</p>
  <% if @set.listening_party&.active? %>
    <%= link_to "Join party", playlist_set_listening_party_path(@set), class: "btn btn-primary btn-sm" %>
    <span class="dim">Code: <%= @set.listening_party.join_code %></span>
  <% else %>
    <%= button_to "Start party", playlist_set_listening_party_path(@set), method: :post, class: "btn btn-primary btn-sm" %>
  <% end %>
</section>
<% end %>
