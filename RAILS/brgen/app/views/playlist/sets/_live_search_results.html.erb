<% if live_search_query.present? %>
  <p class="dim"><%= @sets.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @sets.any? %>
  <%= turbo_frame_tag "playlist-sets", target: "_top" do %>
    <div id="playlist-sets-grid">
      <% @sets.each do |set| %>
        <%= render "playlist/sets/card", set: set %>
      <% end %>
    </div>

    <%= render "shared/infinite_scroll_sentinel",
               pagy: @pagy,
               reflex: "SetsInfiniteScrollReflex#load_more",
               sentinel_id: "playlist-sets-sentinel",
               q: params[:q] %>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: "No sets yet",
        body: "Create or import a set to get started.",
        action: live_search_query.present? ?
          { label: "Clear search", path: playlist_sets_path } :
          { label: "New set", path: new_playlist_set_path } %>
<% end %>
