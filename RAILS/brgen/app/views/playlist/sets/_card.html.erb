<article class="set-card">
  <h2><%= link_to set.name, playlist_set_path(set) %></h2>
  <p class="dim"><%= set.privacy.presence&.humanize || "Public" %> · <%= set.tracks.count %> tracks · <%= set.formatted_duration %></p>
  <% if set.description.present? %>
    <p><%= set.description %></p>
  <% end %>
</article>