<% content_for :title, "Sets" %>

<div class="page-header" role="banner" aria-label="Playlist sets header">
  <div>
    <p class="dim">Local audio collections</p>
    <h1>Sets</h1>
  </div>
  <nav role="navigation" aria-label="Playlist set actions">
    <%= link_to "New set", new_playlist_set_path, class: "btn btn-primary btn-sm" if authenticated? %>
  </nav>
</div>

<%= live_search_index url: playlist_sets_path, results_partial: "playlist/sets/live_search_results", placeholder: "Search sets, tracks, artists…", label: "Playlist search", frame_id: "playlist-sets" %>