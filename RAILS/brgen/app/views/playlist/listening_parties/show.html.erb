<% content_for :title, "Listening party — #{@set.name}" %>
<%= turbo_stream_from @party.stream_name %>

div class="page-header" role="banner">
  <div>
    <p class="dim">Listening party</p>
    <h1><%= @set.name %></h1>
    <p class="dim">Join code: <strong><%= @party.join_code %></strong></p>
  </div>
  <% if @party.host == Current.user %>
    <%= button_to "End party", playlist_set_listening_party_path(@set), method: :delete, class: "btn btn-danger btn-sm" %>
  <% end %>
</div>

<div id="listening_party_sync">
  <%= render "playlist/listening_parties/sync", party: @party, track: @party.current_track %>
</div>

<section>
  <h2>Queue</h2>
  <ol>
    <% @tracks.each do |track| %>
      <li><%= track.title %> — <%= track.artist %></li>
    <% end %>
  </ol>
</section>

<section>
  <h2>Party chat</h2>
  <div id="party_messages">
    <%= render partial: "playlist/party_messages/message", collection: @messages, as: :message %>
  </div>

  <%= form_with url: playlist_set_listening_party_party_messages_path(@set), method: :post, class: "form-wrap" do |f| %>
    <div class="field field--row">
      <%= f.text_field :body, placeholder: "Say something…", required: true, class: "field--grow" %>
      <%= f.submit "Send", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</section>

<p><%= link_to "Back to set", playlist_set_path(@set), class: "btn btn-ghost btn-sm" %></p>