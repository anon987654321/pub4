<div class="auth-form">
  <h1>Forgot your password?</h1>
  <p class="auth-form-lead">We will email a link to set a new password.</p>
  <% if flash[:alert] %><p class="flash-alert" role="alert"><%= flash[:alert] %></p><% end %>
  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="actions">
      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to "Back to sign in", new_session_path %>
    </p>
  <% end %>
</div>
