<% content_for :title, t("events.title") %>

<div class="page-header">
  <%= tag.h1 t("events.title") %>
  <% if authenticated? %>
    <%= link_to t("events.new"), new_event_path, class: "btn btn-sm" %>
  <% end %>
</div>

<%= live_search_index url: events_path,
      results_partial: "events/live_search_results",
      placeholder: t("search.events"),
      label: t("search.events_label"),
      frame_id: "brgen-events" %>

<%# The h2 the past section already had. Without it the page ran h1 -> h3
    (the event cards) -> h2, so anyone navigating by heading met the section
    structure inverted. role="region" is dropped from both: a <section> with an
    accessible name is already one. %>
<section aria-labelledby="events-upcoming-heading">
  <%= tag.h2 t("events.upcoming"), id: "events-upcoming-heading" %>
  <% if @events.any? %>
    <ul class="event-list feed_list">
      <% @events.each do |event| %>
        <li><%= render "events/event", event: event, rsvp_status: @my_rsvps[event.id] %></li>
      <% end %>
    </ul>
    <% if @pagy.next %>
      <%= link_to t("actions.load_more", default: "More"),
                  events_path(page: @pagy.next), rel: "next", class: "btn btn-ghost" %>
    <% end %>
  <% else %>
    <%# empty_state: the action is posting one, and anyone signed in can. %>
    <%= render "shared/empty_state",
          title: t("events.empty_title"),
          body: t("events.empty_body"),
          action: (authenticated? ? { label: t("events.new"), path: new_event_path } : nil) %>
  <% end %>
</section>

<% if @past.any? %>
  <%# A separate strip, not mixed into the listing: an archive and a listing
      answer different questions, and interleaving them means scrolling past
      last month to find tonight. %>
  <section aria-labelledby="events-past-heading">
    <%= tag.h2 t("events.past"), id: "events-past-heading" %>
    <ul class="event-list event-list--past feed_list">
      <% @past.each do |event| %>
        <li><%= render "events/event", event: event %></li>
      <% end %>
    </ul>
  </section>
<% end %>
