<% content_for :title, t("events.title") %>

<div class="page-header">
  <%= tag.h1 t("events.title") %>
  <% if authenticated? %>
    <%= link_to t("events.new"), new_event_path, class: "button button-small" %>
  <% end %>
</div>

<%= live_search_index url: events_path,
      results_partial: "events/live_search_results",
      placeholder: t("search.events"),
      label: t("search.events_label"),
      frame_id: "brgen-events" %>

<%# The index already filters by neighborhood_id; this is the way to ask for it.
    Choosing one applies it; the button is for a browser without JavaScript. %>
<% if neighborhood_choices.any? %>
  <%= form_with url: events_path, method: :get, class: "neighborhood-filter",
        data: { controller: "auto-submit", auto_submit_delay_value: 0 } do |form| %>
    <%= form.label :neighborhood_id, t("events.neighborhood_filter"), for: "events-neighborhood" %>
    <%= form.select :neighborhood_id,
          options_from_collection_for_select(neighborhood_choices, :id, :name, params[:neighborhood_id]),
          { include_blank: t("events.all_neighborhoods") },
          id: "events-neighborhood", data: { action: "change->auto-submit#submit" } %>
    <noscript><%= form.submit t("actions.apply"), name: nil, class: "button button-ghost" %></noscript>
  <% end %>
<% end %>

<%# The h2 the past section already had. Without it the page ran h1 -> h3
    (the event cards) -> h2, so anyone navigating by heading met the section
    structure inverted. role="region" is dropped from both: a <section> with an
    accessible name is already one. %>
<section aria-labelledby="events-upcoming-heading">
  <%= tag.h2 t("events.upcoming"), id: "events-upcoming-heading" %>
  <% if @events.any? %>
    <ul class="event-list feed_list" role="list">
      <% @events.each do |event| %>
        <li><%= render "events/event", event: event, rsvp_status: @my_rsvps[event.id] %></li>
      <% end %>
    </ul>
    <%# shared/pager, like every other paginated surface. The hand-rolled
        link here offered next and nothing else, so the listing was the one
        page in the app a reader could walk forward through and not back. %>
    <%= render "shared/infinite_scroll_sentinel",
               pagy: @pagy,
               reflex: "EventsInfiniteScrollReflex#load_more",
               sentinel_id: "brgen-events-sentinel" %>
    <%# Pager kept as the no-JS path: the sentinel needs a reflex round trip over
        ActionCable, so without JavaScript a truncated list would say nothing about
        the rest of itself. noscript, so a reader with JavaScript sees one
        mechanism rather than two. %>
    <noscript><%= render "shared/pager", pagy: @pagy %></noscript>
  <% else %>
    <%# empty_state: the action is posting one, and anyone signed in can. %>
    <%= render "shared/empty_state",
          title: t("events.empty_title"),
          body: t("events.empty_body"),
          action: (authenticated? ? { label: t("events.new"), path: new_event_path } : nil) %>
  <% end %>
</section>

<% if @past.any? %>
  <%# A separate strip, not mixed into the listing: an archive and a listing
      answer different questions, and interleaving them means scrolling past
      last month to find tonight. %>
  <section aria-labelledby="events-past-heading">
    <%= tag.h2 t("events.past"), id: "events-past-heading" %>
    <ul class="event-list event-list--past feed_list" role="list">
      <% @past.each do |event| %>
        <li><%= render "events/event", event: event %></li>
      <% end %>
    </ul>
  </section>
<% end %>
