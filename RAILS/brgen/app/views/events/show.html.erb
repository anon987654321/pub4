<% content_for :title, @event.title %>
<% content_for :description, truncate(@event.description.to_s, length: 160) %>
<% content_for :og_image, seo_image_url(@event.cover) %>

<article class="event-detail" role="article">
  <div class="page-header" role="banner">
    <hgroup>
      <p>
        <time datetime="<%= @event.starts_at.iso8601 %>"><%= l(@event.starts_at, format: :event) %></time>
        <% if @event.ends_at %>–<time datetime="<%= @event.ends_at.iso8601 %>"><%= l(@event.ends_at, format: :event) %></time><% end %>
      </p>
      <%= tag.h1 @event.title %>
    </hgroup>
    <% if @event.cancelled? %>
      <span class="chip chip--cancelled"><%= t("events.cancelled") %></span>
    <% elsif @event.in_progress? %>
      <span class="chip chip--live"><%= t("events.happening_now") %></span>
    <% end %>
  </div>

  <% if @event.cover.attached? %>
    <div class="event-hero">
      <%= responsive_image_tag @event.cover, alt: "" %>
    </div>
  <% end %>

  <section role="region" aria-label="<%= t("events.where") %>">
    <% if @event.location_name.present? %>
      <p>
        <%= tag.strong @event.location_name %>
        <% if @event.place %>· <%= link_to t("events.on_the_map"), place_path(@event.place) %><% end %>
      </p>
    <% end %>
    <% if @event.address.present? %><p><%= @event.address %></p><% end %>
    <p class="chips">
      <span class="chip"><%= @event.free? ? t("events.free") : @event.price_display %></span>
      <% if (left = @event.places_left) %>
        <span class="chip"><%= t("events.places_left", count: left) %></span>
      <% end %>
      <% if @event.external_url.present? %>
        <%= link_to t("events.tickets"), @event.external_url, class: "chip", rel: "nofollow noopener" %>
      <% end %>
    </p>
  </section>

  <%= turbo_frame_tag dom_id(@event, :rsvp) do %>
    <%= render "events/rsvp", event: @event, rsvp: @rsvp %>
  <% end %>

  <% if @event.description.present? %>
    <section role="region" aria-label="<%= t("events.about") %>">
      <%= simple_format @event.description %>
    </section>
  <% end %>

  <section role="region" aria-label="<%= t("events.who_is_going") %>">
    <%= tag.h2 t("events.going_count", count: @event.going_count) %>
    <% if @attendees.any? %>
      <ul class="attendee-list">
        <% @attendees.each do |rsvp| %>
          <li><%= rsvp.user.display_name %></li>
        <% end %>
      </ul>
    <% else %>
      <p><%= t("events.nobody_yet") %></p>
    <% end %>
  </section>

  <% if @nearby.any? %>
    <section role="region" aria-label="<%= t("events.nearby") %>">
      <%= tag.h2 t("events.nearby") %>
      <div class="event-list">
        <% @nearby.each { |event| %><%= render "events/event", event: event %><% } %>
      </div>
    </section>
  <% end %>

  <section role="region" aria-label="<%= t("comments.submit") %>">
    <%= tag.h2 t("comments.submit") %>
    <%# Was a hand-rolled form and a hand-rolled comment row. The form's textarea
        had no accessible name — a screen reader announced "edit text, blank" —
        because the aria-label the shared fields carry was the one thing the copy
        left out. The row dropped the timestamp, the vote control and the delete
        the rest of the fleet renders. Both are the shared partials now. %>
    <% if @comment %>
      <%= render "comments/form", comment: @comment, commentable: @event, rows: 2 %>
    <% end %>
    <div id="comments">
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    </div>
  </section>

  <% if authenticated? && Current.user.id == @event.user_id %>
    <nav role="navigation" aria-label="<%= t("events.organiser_actions") %>">
      <%= link_to t("actions.edit"), edit_event_path(@event), class: "btn btn-ghost btn-sm" %>
      <% unless @event.cancelled? %>
        <%# Cancel, not delete: people have it in their calendar, and an event
            that vanishes tells them nothing. %>
        <%= button_to t("events.cancel_event"), cancel_event_path(@event), method: :patch,
              class: "btn btn-ghost btn-sm",
              data: { turbo_confirm: t("events.confirm_cancel") } %>
      <% end %>
    </nav>
  <% end %>
</article>
