<% content_for :title, t("partner.membership_title") %>

<section class="partner-membership">
  <%= tag.h1 @membership.program.name %>
  <p class="dim">
    <%= t("partner.status_label") %> <%= @membership.status %> ·
    <%= t("partner.token_label") %> <code><%= @membership.token %></code>
  </p>

  <p>
    <%= t("partner.tracking_link") %>
    <a href="/p/<%= @membership.token %>"><%= request.base_url %>/p/<%= @membership.token %></a>
  </p>

  <section>
    <%= tag.h2 t("partner.recent_clicks") %>
    <% if @clicks.any? %>
      <ul>
        <% @clicks.each do |click| %>
          <li>
            <%= click.occurred_at %> · <%= t("partner.click_expires", at: click.expires_at) %><%= " · #{t("partner.click_listing", id: click.listing_id)}" if click.listing_id %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="dim"><%= t("partner.no_clicks") %><%# adhoc_empty: ok — terse inline sub-section note, not a page-level empty state %></p>
    <% end %>
  </section>

  <section>
    <%= tag.h2 t("partner.conversions") %>
    <% if @conversions.any? %>
      <ul>
        <% @conversions.each do |c| %>
          <li>
            <%= c.status %> · <%= t("partner.conversion_row", commission: c.commission_cents, value: c.order_value_cents) %> ·
            <%= t("partner.payable_after", on: c.payable_after) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="dim"><%= t("partner.no_conversions") %><%# adhoc_empty: ok — terse inline sub-section note, not a page-level empty state %></p>
    <% end %>
  </section>
</section>
