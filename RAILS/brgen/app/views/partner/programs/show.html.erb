<% content_for :title, @program.name %>

<article class="partner-program">
  <header>
    <%= tag.h1 @program.name %>
    <p class="dim"><%= @program.store&.name %> · <%= @program.status %></p>
  </header>

  <dl class="meta">
    <%= tag.dt t("partner.commission") %>
    <dd>
      <% if @program.percent? %>
        <%= t("partner.commission_of_order", rate: @program.commission_rate / 100.0) %>
      <% else %>
        <%= t("partner.commission_flat_model", rate: @program.commission_rate, model: @program.commission_model) %>
      <% end %>
    </dd>
    <%= tag.dt t("partner.attribution_window") %>
    <%= tag.dd t("partner.hours", count: @program.attribution_hours) %>
    <%= tag.dt t("partner.hold_before_payable") %>
    <%= tag.dd t("partner.days", count: @program.hold_days) %>
  </dl>

  <% if @program.terms.present? %>
    <section>
      <%= tag.h2 t("partner.terms") %>
      <p><%= simple_format @program.terms %></p>
    </section>
  <% end %>

  <nav class="cluster" aria-label="<%= t("partner.actions") %>">
    <% if authenticated? && Current.user == @program.store.owner %>
      <%= link_to t("partner.edit_program"), edit_partner_program_path(@program), class: "btn" %>
    <% elsif authenticated? %>
      <% if @membership %>
        <p><%= t("partner.status_label") %> <%= tag.strong @membership.status %></p>
        <% if @membership.earning? %>
          <p class="dim"><%= t("partner.link_token") %> <code><%= @membership.token %></code></p>
          <p>
            <%= t("partner.share") %>
            <code><%= partner_click_url(token: @membership.token, host: request.host, protocol: request.protocol.delete("://")) rescue "https://#{request.host}/p/#{@membership.token}" %></code>
          </p>
          <%= link_to t("partner.membership_dashboard"), partner_membership_path(@membership), class: "btn" %>
        <% end %>
      <% elsif @program.open? %>
        <%= button_to t("partner.join"), partner_program_memberships_path(@program), method: :post, class: "btn" %>
      <% end %>
    <% else %>
      <%= link_to t("partner.sign_in_to_join"), new_session_path, class: "btn" %>
    <% end %>
    <%= link_to t("partner.all_programs"), partner_programs_path, class: "btn btn-ghost" %>
  </nav>
</article>
