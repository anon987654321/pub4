<% content_for :title, t("partner.programs_title") %>

<section class="partner-programs">
  <header class="cluster">
    <%= tag.h1 t("partner.programs_title") %>
    <p><%= t("partner.programs_lead") %></p>
  </header>

  <% if @mine.any? %>
    <section aria-label="<%= t("partner.your_memberships") %>">
      <%= tag.h2 t("partner.your_memberships") %>
      <ul class="stack">
        <% @mine.each do |m| %>
          <li>
            <%= link_to m.program.name, partner_program_path(m.program) %>
            <span class="tag"><%= m.status %></span>
            <%= link_to t("partner.dashboard"), partner_membership_path(m), class: "btn btn-sm" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section aria-label="<%= t("partner.open_programs") %>">
    <%= tag.h2 t("partner.open_programs") %>
    <% if @programs.any? %>
      <ul class="stack">
        <% @programs.each do |program| %>
          <li class="sidebar-card">
            <h3><%= link_to program.name, partner_program_path(program) %></h3>
            <p><%= program.store&.name %></p>
            <p>
              <% if program.percent? %>
                <%= t("partner.commission_percent", rate: program.commission_rate / 100.0) %>
              <% else %>
                <%= t("partner.commission_flat", rate: program.commission_rate) %>
              <% end %>
              · <%= t("partner.hold", count: program.hold_days) %>
            </p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%# adhoc_empty: ok — no viewer-actionable CTA here; programs are created by store owners, not this reader %>
      <p><%= t("partner.none_open") %></p>
    <% end %>
  </section>
</section>
