<% spec = Conversation::CHANNELS[@conversation.slug] || {} %>
<% content_for :title, @conversation.channel_title %>

<%= turbo_stream_from @conversation %>
<% content_for :body_attrs do %>data-action="turbo:load->push#clearBadge"<% end %>

<section class="channel-room" aria-label="Channel">
  <header class="channel-room-header" role="banner">
    <%= link_to "← channels", channels_path, class: "channel-back" %>
    <h1><%= @conversation.channel_title %></h1>
    <p class="dim"><%= spec[:blurb] %></p>
  </header>

  <ul id="messages" class="channel-log conversation-log"
      data-controller="conversation-log"
      data-conversation-log-viewer-id-value="<%= Current.user&.id %>">
    <% @messages.each do |m| %>
      <%= render "messages/message", message: m %>
    <% end %>
  </ul>

  <p id="typing-indicator" class="dim" data-controller="typing" data-typing-conversation-id-value="<%= @conversation.id %>"></p>

  <% if Current.user.present? %>
    <%= form_with model: @message, url: conversation_messages_path(@conversation),
                  id: "new_message", class: "channel-composer",
                  data: { turbo: true, controller: "typing-input", typing_input_url_value: conversation_typing_indicators_path(@conversation) } do |f| %>
      <div class="field" data-controller="character-counter" data-character-counter-countdown-value="true">
        <%= f.text_area :content, rows: 2, placeholder: "Message #{@conversation.name} as #{Current.user.channel_handle}…", maxlength: 500, data: { character_counter_target: "input" } %>
        <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
      </div>
      <%= f.hidden_field :message_type, value: "text" %>
      <%= f.submit "Send", class: "btn btn-primary" %>
    <% end %>
  <% else %>
    <p class="channel-signin dim">Refresh to join the conversation as a guest — no signup needed.</p>
  <% end %>
</section>
