<% content_for :title, t("channels.title") %>
<%# empty_state: coverage-ok — Conversation::CHANNELS is a static roster; this list cannot be empty %>

<section class="channels-index" aria-label="<%= t("channels.aria") %>">
  <header class="page-header">
    <h1><%= t("channels.title") %><%= " · #{@city.name}" if @city %></h1>
    <p><%= t("channels.intro", city: (@city ? t("channels.intro_city", name: @city.name) : "")) %></p>
  </header>

  <ul class="channel-list" role="list">
    <% Conversation::CHANNELS.each do |slug, spec| %>
      <% room = @channels[slug] %>
      <li class="channel-card" role="listitem">
        <%= link_to channel_path(slug), class: "channel-card-link" do %>
          <span class="channel-name"><%= spec[:name] %></span>
          <span class="channel-blurb"><%= Conversation.channel_blurb(slug) %></span>
          <span class="channel-meta">
            <% if room %>
              <% active = @active_counts.fetch(room.id, 0) %>
              <% if active.positive? %>
                <span class="channel-live">● <%= active %> <%= t("channels.active") %></span>
              <% else %>
                <%= @message_counts.fetch(room.id, 0) %> <%= t("channels.message") %>
              <% end %>
            <% else %><%= t("channels.new_room") %><% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
