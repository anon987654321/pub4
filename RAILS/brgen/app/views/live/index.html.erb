<% content_for :title, t("live.page_title") %>

<div class="page-header live-header" role="banner" aria-label="<%= t("live.header_label") %>">
  <div>
    <h1><%= t("live.heading") %></h1>
    <p class="dim live-kicker">
      <%= t("live.kicker") %>
      <% if @located %>
        <%= t("live.within_km", km: number_with_precision(@radius_km, precision: 0)) %>
      <% else %>
        <%= t("live.enable_location_hint") %>
      <% end %>
    </p>
  </div>
  <nav class="live-sort feed-tabs" role="tablist" aria-label="<%= t("live.sort_label") %>">
    <%= link_to t("live.sort_hot"), live_path(sort: "hot", radius_km: @radius_km),
          class: "feed-tab#{" active" if @sort == "hot"}", role: "tab", "aria-selected": @sort == "hot" %>
    <%= link_to t("live.sort_new"), live_path(sort: "fresh", radius_km: @radius_km),
          class: "feed-tab#{" active" if @sort == "fresh"}", role: "tab", "aria-selected": @sort == "fresh" %>
  </nav>
</div>

<p class="live-crosslinks dim" aria-label="<%= t("live.also_open") %>">
  <%= link_to t("home.marketplace"), marketplace.root_url %> ·
  <%= link_to t("nav.messages"), "//messenger.#{Current.domain}/" %> ·
  <%= link_to t("nav.nearby"), nearby_path %> ·
  <%= link_to t("empty.city_feed"), root_path %>
</p>

<section class="live-rules" aria-label="<%= t("live.rules_label") %>">
  <details>
    <summary><%= t("live.rules_summary") %></summary>
    <ul>
      <li><%= t("live.rule_names") %></li>
      <li><%= t("live.rule_short", max: Post::LIVE_CONTENT_MAX) %></li>
      <li><%= t("live.rule_gps") %></li>
      <li><%= t("live.rule_votes") %></li>
    </ul>
  </details>
</section>

<% if Current.user.present? %>
  <% if @located %>
    <%= form_with url: live_path, method: :post, class: "compose-box live-compose", data: { controller: "feed-compose form-submit", feed_compose_target: "box", action: "submit->form-submit#lock" } do |f| %>
      <div class="compose-avatar" aria-hidden="true">◎</div>
      <div class="compose-inner">
        <label class="compose-label-visible" for="live_content"><%= t("live.compose_label") %></label>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
          <%= text_area_tag "post[content]", nil,
                id: "live_content",
                rows: 2,
                maxlength: Post::LIVE_CONTENT_MAX,
                placeholder: t("live.compose_placeholder"), aria: { label: t("live.compose_placeholder") },
                class: "compose-input",
                required: true,
                data: {
                  controller: "textarea-autogrow",
                  character_counter_target: "input",
                  feed_compose_target: "input",
                  action: "focus->feed-compose#expand input->feed-compose#syncTitle blur->feed-compose#collapse"
                } %>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
        <div class="compose-footer" data-feed-compose-target="footer">
          <p class="dim compose-hint live-compose-hint"><%= t("live.compose_hint") %></p>
          <div class="compose-submit">
            <span class="dim compose-as"><%= t("chat.anon") %></span>
            <%= f.submit t("live.post_live"), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="live-locate section-divider--24" data-controller="request-location">
      <p class="section-heading--md"><%= t("live.share_to_post_title") %></p>
      <p class="dim"><%= t("live.share_to_post_body") %></p>
      <p class="nearby-locate-actions">
        <button type="button"
                class="btn btn-primary btn-sm"
                data-action="request-location#request"><%= t("chat.use_location") %></button>
        <%= link_to t("chat.open_brgen_channel"), channel_path("brgen"), class: "btn btn-sm" %>
      </p>
    </div>
  <% end %>
<% end %>

<section class="live-feed" id="live-feed" aria-label="<%= t("live.feed_label") %>">
  <% posts = Array(@posts) %>
  <% if posts.any? %>
    <% posts.each do |post| %>
      <article class="live-card" id="<%= dom_id(post) %>">
        <header class="live-card-meta">
          <span class="live-card-author"><%= t("chat.anon") %></span>
          <time datetime="<%= post.created_at.iso8601 %>"><%= time_ago(post.created_at) %></time>
          <% if @located && post.geo? && Current.user&.geo? %>
            <span class="dim"><%= number_with_precision(post.distance_to(Current.user.latitude, Current.user.longitude), precision: 1) %> km</span>
          <% end %>
        </header>
        <p class="live-card-body"><%= simple_format(post.content.presence || post.title) %></p>
        <footer class="live-card-actions">
          <button type="button"
                  class="feed-action<%= " active" if Current.user.present? && post.upvoted_by?(Current.user) %>"
                  aria-label="<%= t("live.vote_label", score: post.score) %>"
                  aria-pressed="<%= Current.user.present? && post.upvoted_by?(Current.user) %>"
                  data-controller="action"
                  data-action="click->action#toggle"
                  data-action-url-value="<%= post_vote_path(post) %>"
                  data-action-count-value="<%= post.score %>"
                  data-action-param-value="1">
            <%= render "shared/feed_icon", name: "upvote" %>
            <span class="feed-action-count" data-action-target="count"><%= post.score %></span>
          </button>
          <%= link_to post_path(post), class: "feed-action", aria: { label: t("live.comment_label") } do %>
            <%= render "shared/feed_icon", name: "comment" %>
            <span class="feed-action-count"><%= post.comment_count %></span>
          <% end %>
        </footer>
      </article>
    <% end %>
    <% if @pagy %>
      <div class="live-pagination"><%= render "shared/pager", pagy: @pagy %></div>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: @located ? t("live.empty_located_title") : t("live.empty_waiting_title"),
          body: @located ? t("live.empty_located_body") : t("live.empty_waiting_body"),
          action: @located ?
            { label: t("empty.city_feed"), path: root_path } :
            { label: t("nav.nearby"), path: nearby_path } %>
  <% end %>
</section>
