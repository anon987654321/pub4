<% content_for :title, "Live · nearby" %>

<div class="page-header live-header" role="banner" aria-label="Live feed header">
  <div>
    <h1>Live</h1>
    <p class="dim live-kicker">
      What’s happening around you — short, anonymous, vote-ranked.
      <% if @located %>Within <%= number_with_precision(@radius_km, precision: 0) %> km.<% else %>Enable location for the nearby bubble.<% end %>
    </p>
  </div>
  <nav class="live-sort feed-tabs" role="tablist" aria-label="Live sort">
    <%= link_to "Hot", live_path(sort: "hot", radius_km: @radius_km),
          class: "feed-tab#{" active" if @sort == "hot"}", role: "tab", "aria-selected": @sort == "hot" %>
    <%= link_to "New", live_path(sort: "fresh", radius_km: @radius_km),
          class: "feed-tab#{" active" if @sort == "fresh"}", role: "tab", "aria-selected": @sort == "fresh" %>
  </nav>
</div>

<p class="live-crosslinks dim" aria-label="Also open without signup">
  <%= link_to "Marketplace", marketplace_root_url %> ·
  <%= link_to "Messages", "//messenger.#{Current.domain}/" %> ·
  <%= link_to "Nearby", nearby_path %> ·
  <%= link_to "City feed", root_path %>
</p>

<section class="live-rules" aria-label="Live rules">
  <details>
    <summary>Local &amp; anonymous — ground rules</summary>
    <ul>
      <li>No real names, addresses, or doxxing of private people.</li>
      <li>Posts are short (max <%= Post::LIVE_CONTENT_MAX %> chars) and shown as <strong>anon</strong>.</li>
      <li>Exact GPS is coarsened — only a rough area is stored.</li>
      <li>Upvotes surface useful local signal; downvotes bury spam.</li>
    </ul>
  </details>
</section>

<% if Current.user.present? %>
  <% if @located %>
    <%= form_with url: live_path, method: :post, class: "compose-box live-compose", data: { controller: "feed-compose", feed_compose_target: "box", action: "submit->form-submit#lock" } do |f| %>
      <div class="compose-avatar" aria-hidden="true">◎</div>
      <div class="compose-inner">
        <label class="compose-label-visible" for="live_content">Post to Live as anon</label>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
          <%= text_area_tag "post[content]", nil,
                id: "live_content",
                rows: 2,
                maxlength: Post::LIVE_CONTENT_MAX,
                placeholder: "What’s going on near you?",
                class: "compose-input",
                required: true,
                data: {
                  controller: "textarea-autogrow",
                  character_counter_target: "input",
                  feed_compose_target: "input",
                  action: "focus->feed-compose#expand input->feed-compose#syncTitle blur->feed-compose#collapse"
                } %>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
        <div class="compose-footer" data-feed-compose-target="footer">
          <p class="dim compose-hint live-compose-hint">Local · anonymous · no signup needed</p>
          <div class="compose-submit">
            <span class="dim compose-as">anon</span>
            <%= f.submit "Post Live", class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="live-locate section-divider--24">
      <p class="section-heading--md">Share location to post</p>
      <p class="dim">Live needs a rough position so only people nearby see your note. Your exact GPS is never shown.</p>
      <p class="dim">Allow location in the browser — we already listen on this page.</p>
    </div>
  <% end %>
<% end %>

<section class="live-feed" id="live-feed" aria-label="Live posts nearby">
  <% posts = Array(@posts) %>
  <% if posts.any? %>
    <% posts.each do |post| %>
      <article class="live-card" id="<%= dom_id(post) %>">
        <header class="live-card-meta">
          <span class="live-card-author">anon</span>
          <time datetime="<%= post.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(post.created_at) %> ago</time>
          <% if @located && post.geo? && Current.user&.geo? %>
            <span class="dim"><%= number_with_precision(post.distance_to(Current.user.latitude, Current.user.longitude), precision: 1) %> km</span>
          <% end %>
        </header>
        <p class="live-card-body"><%= simple_format(post.content.presence || post.title) %></p>
        <footer class="live-card-actions">
          <button type="button"
                  class="feed-action<%= " active" if Current.user.present? && post.upvoted_by?(Current.user) %>"
                  aria-label="Vote, score <%= post.score %>"
                  aria-pressed="<%= Current.user.present? && post.upvoted_by?(Current.user) %>"
                  data-controller="action"
                  data-action="click->action#toggle"
                  data-action-url-value="<%= post_vote_path(post) %>"
                  data-action-count-value="<%= post.score %>"
                  data-action-param-value="1">
            <%= render "shared/feed_icon", name: "upvote" %>
            <span class="feed-action-count" data-action-target="count"><%= post.score %></span>
          </button>
          <%= link_to post_path(post), class: "feed-action", aria: { label: "Comment" } do %>
            <%= render "shared/feed_icon", name: "comment" %>
            <span class="feed-action-count"><%= post.comment_count %></span>
          <% end %>
        </footer>
      </article>
    <% end %>
    <% if @pagy %>
      <div class="live-pagination"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: @located ? "Quiet around here" : "Waiting for the first Live notes",
          body: @located ? "Be the first to drop a short anonymous note nearby." : "Enable location or check back when locals start posting." %>
  <% end %>
</section>
