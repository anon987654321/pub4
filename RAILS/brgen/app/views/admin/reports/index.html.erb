<% content_for :title, "Moderation reports" %>

<div class="page-header" role="banner" aria-label="Reports header">
  <div>
    <p class="dim">Admin / moderation</p>
    <h1>Reports</h1>
  </div>
  <div class="chips">
    <span class="chip"><%= pluralize(@open_count, "open") %></span>
    <span class="chip"><%= pluralize(@reviewing_count, "reviewing") %></span>
  </div>
</div>

<% if @reports.any? %>
  <div data-controller="checkbox-select-all">
    <p class="cluster">
      <label><input type="checkbox" data-checkbox-select-all-target="checkboxAll" aria-label="Select all reports"> Select all</label>
    </p>
    <% @reports.each do |report| %>
      <article role="article" aria-label="Report">
        <p class="cluster">
          <input type="checkbox" data-checkbox-select-all-target="checkbox" value="<%= report.id %>" aria-label="Select report <%= report.id %>">
          <strong><%= report.reason.humanize %> · <%= report.status.humanize %></strong>
        </p>
        <p class="dim">
          <%= report.reportable_type %>#<%= report.reportable_id %>
          · by <%= report.user.display_name %>
          · <span data-controller="timeago"><%= time_ago_in_words(report.created_at) %> ago</span>
        </p>
        <% if report.details.present? %><p><%= report.details %></p><% end %>
        <nav role="navigation" class="cluster">
          <% %w[open reviewing resolved dismissed].each do |status| %>
            <%= button_to status.humanize, admin_report_path(report, status: status), method: :patch, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </nav>
      </article>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "No reports yet", body: "Moderation queue is clear." %>
<% end %>