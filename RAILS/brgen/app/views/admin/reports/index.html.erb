<% content_for :title, t("admin.reports_title") %>

<div class="page-header">
  <hgroup>
    <p><%= t("admin.moderation") %></p>
    <%= tag.h1 t("a11y.reports_header") %>
  </hgroup>
  <div class="chips">
    <span class="chip"><%= t("community.open_count", count: @open_count) %></span>
    <span class="chip"><%= t("community.reviewing_count", count: @reviewing_count) %></span>
  </div>
</div>

<% if @reports.any? %>
  <div data-controller="checkbox-select-all">
    <p class="cluster">
      <label><input type="checkbox" data-checkbox-select-all-target="checkboxAll" aria-label="<%= t("actions.select_all_reports") %>"> <%= t("actions.select_all") %></label>
    </p>
    <% @reports.each do |report| %>
      <article aria-label="<%= t("a11y.report") %>">
        <p class="cluster">
          <input type="checkbox" data-checkbox-select-all-target="checkbox" value="<%= report.id %>" aria-label="<%= t("a11y.select_report", id: report.id) %>">
          <strong><%= report.reason.humanize %> · <%= report.status.humanize %></strong>
        </p>
        <p>
          <%= report.reportable_type %>#<%= report.reportable_id %>
          · <%= t("admin.reported_by", name: report.user.display_name) %>
          · <%= time_ago(report.created_at) %>
        </p>
        <% if report.details.present? %><%= tag.p report.details %><% end %>
        <nav class="cluster">
          <% %w[open reviewing resolved dismissed].each do |status| %>
            <%= button_to t("community.mark_#{status}"), admin_report_path(report, status: status), method: :patch, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </nav>
      </article>
    <% end %>
  </div>
<% else %>
  <%# empty_state: no-action-ok — clear queue is the desired end state for moderators %>
  <%= render "shared/empty_state", title: t("empty.no_reports"), body: t("empty.reports_clear") %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
