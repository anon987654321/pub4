<% content_for :title, @user.display_name %>
<% content_for :json_ld, json_ld_for(@user, type: :person) %>
<%= turbo_stream_from @user %>

<header class="profile-header">
  <%= image_tag @user.avatar_url, alt: "", width: 64, height: 64, class: "avatar" %>
  <%= tag.h1 @user.display_name %>
  <%= tag.p @user.bio, class: "profile-bio" if @user.bio.present? %>
  <p class="meta-facts">
    <%= link_to t("profile.followers", count: @followers_count), main_app.user_followers_path(@user) %>
    <%= link_to t("profile.following", count: @following_count), main_app.user_following_path(@user) %>
    <%= tag.span t("community.posts_count", count: @posts_count) %>
    <%= tag.span t("profile.member_since", date: l(@user.created_at.to_date, format: "%B %Y")) %>
  </p>

  <% if authenticated? && Current.user != @user %>
    <%= render "shared/follow_button", user: @user, active: @active_follow %>
    <%= button_to t("actions.message"), user_conversations_path(@user), method: :post,
          class: "button button-ghost" %>
    <% if @active_block %>
      <%# destructive: no-confirm-ok — reversible — the button becomes Block again in place %>
      <%= button_to t("block.unblock"), unblock_user_path(@user), method: :delete,
            class: "button button-ghost" %>
    <% else %>
      <%= button_to t("block.block"), block_user_path(@user), method: :post,
            class: "button button-ghost",
            data: { turbo_confirm: t("messages.confirm_block") } %>
    <% end %>
    <%# Posts, comments and messages could be reported; the account itself could not. %>
    <%= render "shared/report_button", target: @user, reason: nil %>
  <% elsif authenticated? && Current.user == @user %>
    <%= link_to t("profile.edit"), edit_user_path(@user), class: "button button-ghost" %>
  <% end %>

  <% if @user.dating_profile.present? %>
    <p><%= link_to t("dating.your_profile"), dating.root_url(subdomain: "dating"),
          class: "button button-ghost" %></p>
  <% end %>
</header>

<% if [@stores, @casual_listings, @restaurants, @channels, @playlists].any?(&:present?) %>
  <section class="profile-verticals">
    <%= tag.h2 t("profile.across_the_city") %>
    <% {
         @stores => "profile.stores",
         @casual_listings => "profile.listings",
         @restaurants => "profile.restaurants",
         @channels => "profile.channels",
         @playlists => "profile.playlists"
       }.each do |records, key| %>
      <% next if records.blank? %>
      <%= tag.h3 t(key) %>
      <ul>
        <% records.each do |record| %>
          <% href = record_public_href(record) %>
          <li>
            <% if href.present? %>
              <%= link_to record.try(:name) || record.try(:title), href %>
            <% else %>
              <%= record.try(:name) || record.try(:title) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<section>
  <%= tag.h2 t("profile.posts") %>
  <% if @posts.any? %>
    <ul class="post-feed feed_list post-card-list" id="profile-posts" role="list">
      <%= render partial: "users/profile_post", collection: @posts, as: :post %>
    </ul>
    <%= render "shared/infinite_scroll_sentinel",
               pagy: @pagy,
               reflex: "ProfilePostsInfiniteScrollReflex#load_more",
               sentinel_id: "profile-posts-sentinel",
               data: { user_id: @user.id } %>
    <%# The pager is the no-JS path, as on hashtag pages: the sentinel pages
        over ActionCable. %>
    <noscript><%= render "shared/pager", pagy: @pagy %></noscript>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_posts_yet"),
          body: t("empty.profile_empty"),
          action: { label: t("empty.city_feed"), path: root_path } %>
  <% end %>
</section>

<% if @activity.any? %>
  <section class="profile-activity">
    <%= tag.h2 t("profile.activity") %>
    <ul class="activity-list">
      <% @activity.each do |event| %>
        <li>
          <%= activity_event_title(event) %>
          <span class="activity-vertical">· <%= activity_event_vertical(event) %></span>
          <time datetime="<%= event.created_at.iso8601 %>"><%= time_ago(event.created_at) %></time>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
