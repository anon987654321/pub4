<% content_for :title, @user.display_name %>
<% content_for :json_ld, json_ld_for(@user, type: :person) %>
<%= turbo_stream_from @user %>

<header class="profile-header" role="banner" aria-label="User profile">
  <h1><%= @user.display_name %></h1>
  <p class="dim">
    <%= @followers_count %> followers · <%= @following_count %> following · <%= @posts.size %> posts
  </p>

  <% if authenticated? && Current.user != @user %>
    <%= render "shared/follow_button", user: @user, active: @active_follow %>
    <%= button_to t("actions.message"), user_conversations_path(@user), method: :post, class: "btn btn-ghost btn-sm" %>
    <% if @active_block %>
      <%= button_to t("block.unblock", default: "Unblock"), unblock_user_path(@user), method: :delete, class: "btn btn-ghost btn-sm" %>
    <% else %>
      <%= button_to t("block.block", default: "Block"), block_user_path(@user), method: :post, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% elsif authenticated? && Current.user == @user %>
    <%= link_to t("profile.edit", default: "Edit profile"), edit_user_path(@user), class: "btn btn-ghost btn-sm" %>
  <% end %>

  <% if @user.dating_profile.present? %>
    <p><%= link_to t("dating.your_profile"), dating.root_url(subdomain: "dating"), class: "btn btn-ghost btn-sm" %></p>
  <% end %>
</header>

<% if [@stores, @casual_listings, @restaurants, @channels, @playlists].any?(&:present?) %>
  <section class="profile-verticals">
    <h2><%= t("profile.across_the_city") %></h2>
    <% {
         @stores => "profile.stores",
         @casual_listings => "profile.listings",
         @restaurants => "profile.restaurants",
         @channels => "profile.channels",
         @playlists => "profile.playlists"
       }.each do |records, key| %>
      <% next if records.blank? %>
      <h3><%= t(key) %></h3>
      <ul>
        <% records.each do |record| %>
          <% href = record_public_href(record) %>
          <li>
            <% if href.present? %>
              <%= link_to record.try(:name) || record.try(:title), href %>
            <% else %>
              <%= record.try(:name) || record.try(:title) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<section>
  <h2><%= t("profile.posts") %></h2>
  <% if @posts.any? %>
    <%= render partial: "posts/post", collection: @posts %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_posts_yet"),
          body: t("empty.profile_empty"),
          action: { label: t("empty.city_feed"), path: root_path } %>
  <% end %>
</section>

<% if @activity.any? %>
  <section class="profile-activity">
    <h2><%= t("profile.activity", default: "Recent activity") %></h2>
    <ul class="activity-list">
      <% @activity.each do |event| %>
        <li class="dim">
          <%= activity_event_title(event) %>
          <span class="activity-vertical">· <%= activity_event_vertical(event) %></span>
          <time datetime="<%= event.created_at.iso8601 %>"><%= time_ago(event.created_at) %></time>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
