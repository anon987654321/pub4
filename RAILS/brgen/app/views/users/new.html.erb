<% content_for :title, t("auth.create_account") %>

<div class="auth-form">
  <%= tag.h1 t("auth.create_account") %>
  <p class="auth-form-lead"><%= t("auth.create_lead") %></p>

  <%= render "shared/oauth_links" %>

  <%= form_with model: @user, url: users_path do |f| %>
    <%= render "shared/errors", object: @user %>
    <%= render "shared/registration_fields", form: f, include_username: true %>
    <div class="actions">
      <%# Honeypot: hidden from humans, catnip for bots. Any value fails signup. %>
      <div class="hp-field" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden"> <%# scan: intentional — the honeypot is positioned inline so no stylesheet can accidentally reveal it %>
        <%= label_tag :homepage, t("auth.honeypot_label") %>
        <%= text_field_tag :homepage, nil, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= f.submit t("auth.create_account"), class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.already_have_account"), new_session_path %>
    </p>
  <% end %>
</div>
