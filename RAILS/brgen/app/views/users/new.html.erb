<% content_for :title, t("auth.create_account") %>

<div class="auth-form">
  <%= tag.h1 t("auth.create_account") %>
  <p class="auth-form-lead"><%= t("auth.create_lead") %></p>

  <%= render "shared/oauth_links" %>

  <%= form_with model: @user, url: users_path do |f| %>
    <%= render "shared/errors", object: @user %>
    <div class="field">
      <%= f.label :email_address, t("auth.email") %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= f.label :username, t("auth.username_optional") %>
      <%= f.text_field :username, autocomplete: "nickname" %>
    </div>
    <div class="field">
      <%= f.label :password, t("auth.password") %>
      <%= password_visibility_field f, :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, t("auth.confirm_password") %>
      <%= password_visibility_field f, :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="field">
      <label>
        <%= check_box_tag :accept_age, "1", params[:accept_age] == "1", required: true %>
        <%= t("legal.accept_age") %>
      </label>
    </div>
    <div class="field">
      <label>
        <%= check_box_tag :accept_terms, "1", params[:accept_terms] == "1", required: true %>
        <%= t("legal.accept_terms") %>
        (<%= link_to t("legal.terms"), terms_path %> · <%= link_to t("legal.privacy"), privacy_path %>)
      </label>
    </div>
    <div class="actions">
      <%# Honeypot: hidden from humans, catnip for bots. Any value fails signup. %>
      <div class="hp-field" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden">
        <%= label_tag :homepage, "Leave this field empty" %>
        <%= text_field_tag :homepage, nil, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= f.submit t("auth.create_account"), class: "btn btn-primary" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.already_have_account"), new_session_path %>
    </p>
  <% end %>
</div>
