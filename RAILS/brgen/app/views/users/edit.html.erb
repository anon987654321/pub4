<% content_for :title, t("profile.edit", default: "Edit profile") %>

<header class="page-header" role="banner">
  <%= tag.h1 t("profile.edit", default: "Edit profile") %>
</header>

<%= form_with model: @user, url: main_app.user_path(@user), method: :patch, class: "stack" do |f| %>
  <% if @user.errors.any? %>
    <ul class="form-errors" role="alert">
      <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :display_name, t("profile.display_name", default: "Display name") %>
    <%= f.text_field :display_name, autocomplete: "name" %>
  </div>

  <div class="field">
    <%= f.label :username, t("profile.username", default: "Username") %>
    <%= f.text_field :username, autocomplete: "username" %>
  </div>

  <div class="cluster">
    <%= f.submit t("actions.save", default: "Save"), class: "btn" %>
    <%= link_to t("actions.cancel", default: "Cancel"), main_app.user_path(@user), class: "btn btn-ghost" %>
  </div>
<% end %>
