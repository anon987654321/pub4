<% content_for :title, t("profile.edit") %>

<header class="page-header">
  <%= tag.h1 t("profile.edit") %>
</header>

<%= form_with model: @user, url: main_app.user_path(@user), method: :patch, class: "stack" do |f| %>
  <% if @user.errors.any? %>
    <ul class="form-errors" role="alert">
      <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :display_name, t("profile.display_name") %>
    <%= f.text_field :display_name, autocomplete: "name" %>
  </div>

  <div class="field" data-controller="username-availability"
       data-username-availability-url-value="<%= main_app.username_availability_users_path %>"
       data-username-availability-current-value="<%= @user.username_was %>">
    <%= f.label :username, t("profile.username") %>
    <%= f.text_field :username, autocomplete: "username", required: true,
          minlength: User::USERNAME_LENGTH.min, maxlength: User::USERNAME_LENGTH.max,
          pattern: User::USERNAME_PATTERN,
          aria: { describedby: "user_username_rule user_username_hint" },
          data: { username_availability_target: "input", action: "input->username-availability#check" } %>
    <%= tag.p t("profile.username_rule", min: User::USERNAME_LENGTH.min, max: User::USERNAME_LENGTH.max),
          id: "user_username_rule", class: "form-help" %>
    <%= tag.p "", id: "user_username_hint", class: "form-help", role: "status",
          data: { username_availability_target: "hint" } %>
  </div>

  <div class="field">
    <%= f.label :bio, t("profile.bio") %>
    <%= f.text_area :bio, rows: 3, maxlength: User::BIO_LENGTH, aria: { describedby: "user_bio_hint" } %>
    <%= tag.p t("profile.bio_hint", count: User::BIO_LENGTH), id: "user_bio_hint", class: "form-help" %>
  </div>

  <fieldset class="field">
    <%= tag.legend t("profile.avatar") %>
    <%= image_tag @user.avatar_url, alt: "", width: 64, height: 64, class: "avatar avatar--64" %>
    <%= f.label :avatar, t("profile.avatar_choose") %>
    <%= f.file_field :avatar, accept: Shared::AttachmentLimits::IMAGE_TYPES.join(","),
          aria: { describedby: "user_avatar_hint" } %>
    <%= tag.p t("profile.avatar_hint"), id: "user_avatar_hint", class: "form-help" %>
    <% if @user.avatar.attached? %>
      <div class="field field--check">
        <%= check_box_tag "user[remove_avatar]", "1", false, id: "user_remove_avatar" %>
        <%= label_tag "user_remove_avatar", t("profile.avatar_remove") %>
      </div>
    <% end %>
  </fieldset>

  <div class="cluster">
    <%= f.submit t("actions.save"), class: "button" %>
    <%= link_to t("actions.cancel"), main_app.user_path(@user), class: "button button-ghost" %>
  </div>
<% end %>

<%= tag.p link_to(t("profile.account_link"), main_app.account_path) %>
