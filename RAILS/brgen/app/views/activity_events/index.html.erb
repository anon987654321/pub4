<% content_for :title, "Activity" %>

<div class="page-header" role="banner">
  <div>
    <p class="dim">Local graph</p>
    <h1>Activity</h1>
  </div>
</div>

<div class="chips chips--bar">
  <% %w[marketplace takeaway dating tv playlist core].each do |vertical| %>
    <% active = params[:vertical] == vertical %>
    <%= link_to vertical.humanize, activity_events_path(vertical: vertical), class: "chip#{" active" if active}", aria: { current: active ? "page" : nil } %>
  <% end %>
</div>

<%= turbo_frame_tag "activity-events" do %>
<% if @events.any? %>
  <div class="activity-event-list" role="list">
    <% @events.each do |event| %>
      <div role="listitem">
        <%= render "activity_events/event", event: event %>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_activity"),
        body: "Events from your network show up here.",
        action: { label: "City feed", path: root_path } %>
<% end %>
<% end %>
