<% content_for :title, t("notifications.title") %>
<%# Notification#after_create_commit refreshes this page when a new one arrives. %>
<%= turbo_stream_from Current.user, :notifications %>

<%= turbo_frame_tag "notifications" do %>
  <div id="notification_header">
    <%= render "notifications/header" %>
  </div>

  <div id="notification_list">
    <%= render "notifications/grouped_list" %>
  </div>
<% end %>
