<% if @notifications.any? %>
  <% @group_order.each do |kind| %>
    <% items = @grouped_notifications[kind] || [] %>
    <% next if items.empty? %>
    <section class="mb-12">
      <h2 class="section-heading--md"><%= t("notifications.kinds.#{kind}") %></h2>
      <% items.each do |notification| %>
        <%= render "notifications/notification", notification: notification %>
      <% end %>
    </section>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: t("notifications.empty_title"),
        body: t("notifications.empty_body"),
        action: { label: t("nav.home"), path: root_path } %>
<% end %>
