<article id="<%= dom_id(notification) %>" class="<%= notification.read? ? "read" : "unread" %>">
  <h3><%= notification.title %></h3>
  <% if notification.body.present? %><p><%= notification.body %></p><% end %>
  <p class="dim">
    <time datetime="<%= notification.created_at.iso8601 %>" data-controller="timeago"><%= time_ago_in_words(notification.created_at) %> ago</time>
    <% if notification.read? %> · read<% end %>
  </p>
  <% unless notification.read? %>
    <%= button_to "Mark read", notification_path(notification), method: :patch, data: { turbo_stream: true }, class: "btn btn-ghost btn-sm" %>
  <% end %>
</article>
