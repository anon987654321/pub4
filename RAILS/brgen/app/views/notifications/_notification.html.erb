<% href = notification_href(notification) %>
<%# The title is the link; a second "Open" to the same place was one more stop
    for a keyboard and a duplicate link for a screen reader. %>
<%# Swipe left to dismiss (swipe_dismiss_controller presses the Dismiss button,
    which works on its own without JavaScript). %>
<article id="<%= dom_id(notification) %>" class="<%= notification.read? ? "read" : "unread" %> notification-card"
         data-controller="swipe-dismiss"
         data-swipe-dismiss-done-value="<%= t("notifications.swiped_away") %>"
         data-swipe-dismiss-undo-value="<%= t("notifications.undo_dismiss") %>"
         data-action="pointerdown->swipe-dismiss#start pointermove->swipe-dismiss#move pointerup->swipe-dismiss#end pointercancel->swipe-dismiss#reset">
<% if (actor = notification.shown_actor) %>
  <%= link_to main_app.user_path(actor), class: "notification-actor" do %>
    <%= image_tag actor.avatar_url, alt: "", width: 32, height: 32, class: "avatar" %>
    <%= tag.span actor.display_name %>
  <% end %>
<% end %>
  <% if href.present? %>
    <%= tag.h3 link_to(notification.title, open_notification_path(notification), class: "notification-title-link") %>
  <% else %>
    <%= tag.h3 notification.title %>
  <% end %>
  <% if notification.body.present? %><%= tag.p notification.body %><% end %>
  <p>
    <time datetime="<%= notification.created_at.iso8601 %>"><%= time_ago(notification.created_at) %></time>
    <% if notification.read? %> · <%= t("notifications.read_state") %><% end %>
  </p>
  <div class="notification-actions cluster">
    <% unless notification.read? %>
      <%= button_to t("actions.mark_read"), notification_path(notification), method: :patch, data: { turbo_stream: true }, class: "button button-ghost button-small" %>
    <% end %>
    <%# The view rides along so the inbox redraws as the reader was reading it. %>
    <%= button_to t("notifications.dismiss"), notification_path(notification), method: :delete, params: { view: @view },
          data: { turbo_stream: true, swipe_dismiss_target: "button" }, class: "button button-ghost button-small",
          aria: { label: t("notifications.dismiss_label") } %>
  </div>
</article>
