<div class="page-header">
  <hgroup>
    <%= tag.p t("notifications.inbox_kicker", city: city_name) %>
    <%# The heading is the page's name alone; the count is its own line, read
        after it, rather than part of what "Varsler" is called. %>
    <%= tag.h1 t("notifications.title") %>
    <% if @unread_count.to_i.positive? %>
      <%= tag.p tag.span(t("notifications.unread_count", count: @unread_count), class: "badge"), role: "status" %>
    <% end %>
  </hgroup>

  <% if @unread_count.to_i.positive? %>
    <%= button_to t("notifications.mark_all"), read_all_notifications_path, method: :patch, class: "button button-primary", data: { turbo_stream: true } %>
  <% end %>
</div>
