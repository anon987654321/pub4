<div class="page-header">
  <hgroup>
    <p><%= t("notifications.inbox_kicker", default: "Brgen inbox") %></p>
    <h1>
      <%= t("notifications.title") %>
      <% if @unread_count.to_i.positive? %>
        <span class="badge"><%= t("notifications.unread_count", count: @unread_count, default: "%{count} unread") %></span>
      <% end %>
    </h1>
  </hgroup>

  <% if @unread_count.to_i.positive? %>
    <%= button_to t("notifications.mark_all"), read_all_notifications_path, method: :patch, class: "btn btn-primary", data: { turbo_stream: true } %>
  <% end %>
</div>
