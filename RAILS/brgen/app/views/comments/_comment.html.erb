<%= turbo_frame_tag dom_id(comment) do %>
<article class="comment_item" data-depth="<%= [comment.depth, 4].min %>">
  <header>
    <span><%= comment.user&.username || "anon" %></span>
    <span> · <span data-controller="timeago"><%= time_ago_in_words(comment.created_at) %> ago</span></span>
    <% if Current.user.present? %>
      ·
      <% root = comment.commentable.is_a?(Post) ? comment.commentable : comment.commentable.commentable %>
      <%= link_to "reply", "#reply-#{comment.id}", data: { action: "click->reply#toggle" } %>
      <% if comment.user == Current.user && authenticated? %>
        <%= button_to t("actions.delete"), comment, method: :delete, data: { turbo_confirm: t("actions.confirm_delete") } %>
      <% end %>
    <% end %>
  </header>
  <p><%= comment.content %></p>

  <% if comment.long_thread? %>
    <% if comment.has_thread_summary? %>
      <p class="thread-summary"><strong>MASTER sammendrag:</strong> <%= comment.thread_summary %></p>
    <% elsif authenticated? %>
      <%= button_to t("comments.ai_summary"), generate_summary_comment_path(comment), method: :post, class: "btn btn-ghost btn-sm", data: { turbo: true } %>
    <% end %>
  <% end %>

  <% if Current.user.present? %>
    <% root_post = comment.commentable.is_a?(Post) ? comment.commentable : comment.commentable.commentable %>
    <section id="reply-<%= comment.id %>" hidden>
      <%= render "comments/form",
            comment: Comment.new,
            commentable: root_post,
            parent_id: comment.id,
            form_id: "reply_form_#{comment.id}",
            rows: 3,
            placeholder: t("comments.reply_placeholder"),
            submit: t("comments.reply") %>
    </section>
  <% end %>

  <% Comment.where(parent_id: comment.id).best.each do |reply| %>
    <%= render "comments/comment", comment: reply %>
  <% end %>
</article>
<% end %>
