<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mail-shell">
  <tr><%= tag.td t("app.name"), class: "mail-brand" %></tr>
  <tr>
    <td class="mail-typo-hero">
      <%= tag.h1 @notification.title %>
      <%= tag.p @notification.body if @notification.body.present? %>
    </td>
  </tr>
  <tr>
    <td class="mail-cta-wrap">
      <%= link_to t("notification_mail.open"), @open_url, class: "mail-cta" %>
    </td>
  </tr>
  <tr>
    <td class="mail-footer">
      <%= link_to t("notification_mail.preferences"), @preferences_url %>
    </td>
  </tr>
</table>
