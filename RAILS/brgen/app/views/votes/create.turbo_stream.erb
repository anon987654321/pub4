<% frame = request.headers["Turbo-Frame"].to_s %>
<% if @votable.is_a?(Post) && frame.start_with?("post-vote-") %>
  <%= turbo_stream.replace frame do %>
    <%= turbo_frame_tag frame, "aria-live": "polite" do %>
      <%= render "shared/post_vote_rail", post: @votable, vote_path: post_vote_path(@votable) %>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@votable) do %>
    <% if @votable.is_a?(Post) %><%= render "posts/post", post: @votable %>
    <% elsif @votable.is_a?(Comment) %><%= render "comments/comment", comment: @votable %>
    <% end %>
  <% end %>
<% end %>
