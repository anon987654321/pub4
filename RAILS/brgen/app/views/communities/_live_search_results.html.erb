<% if live_search_query.present? %>
 <p class="dim"><%= @communities.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @communities.any? %>
 <%= turbo_frame_tag "communities-list", target: "_top" do %>
 <ul class="community-list" id="communities-list" data-turbo-permanent>
 <% @communities.each do |community| %>
   <%= render "communities/card", community: community %>
 <% end %>
 </ul>

 <%= render "shared/infinite_scroll_sentinel",
            pagy: @pagy,
            reflex: "CommunitiesInfiniteScrollReflex#load_more",
            sentinel_id: "communities-sentinel",
            q: params[:q] %>
 <% end %>
<% else %>
 <p class="empty">No communities match this search.</p>
<% end %>