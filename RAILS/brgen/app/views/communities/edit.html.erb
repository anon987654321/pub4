<h1>Edit <%= @community.name %></h1>
<%= form_with model: @community do |f| %>
  <% if @community.errors.any? %>
    <ul>
      <% @community.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <p>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= f.label :description %>
    <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :description, rows: 3 , maxlength: 1000, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
  </p>
  <p>
    <%= f.label :rules, t("community.rules") %>
    <%= t("community.rules_hint") %>
    <%= f.text_area :rules, rows: 6, maxlength: 10_000 %>
  </p>
  <p>
    <%= f.label :flairs, t("community.flairs") %>
    <%= t("community.flairs_hint") %>
    <%= f.text_area :flairs, rows: 4 %>
  </p>
  <p>
    <%= f.label :privacy, t("community.privacy") %>
    <%= f.select :privacy, Community::PRIVACIES.map { |p| [ t("community.privacy_options.#{p}"), p ] } %>
    <%= t("community.privacy_hint") %>
  </p>
  <p>
    <%= f.label :icon, t("community.icon") %>
    <%= f.file_field :icon, accept: "image/*", direct_upload: true %>
  </p>
  <p>
    <%= f.label :banner, t("community.banner") %>
    <%= f.file_field :banner, accept: "image/*", direct_upload: true %>
  </p>
  <p>
    <%= f.submit t("communities.save") %>
    <%= link_to t("actions.cancel"), @community %>
  </p>
<% end %>
