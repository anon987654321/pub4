<% content_for :title, t("community.moderators") %>

<div class="page-header" role="banner">
  <hgroup>
    <p><%= link_to @community.name, community_path(@community) %></p>
    <%= tag.h1 t("community.moderators") %>
  </hgroup>
</div>

<p><%= t("community.moderators_hint") %></p>

<% if @memberships.any? %>
<ul class="member-list">
  <% @memberships.each do |membership| %>
    <li class="cluster">
      <%= membership.user.display_name %>
      <span class="chip"><%= t("community.role.#{membership.role}") %></span>
      <% if membership.role == "member" %>
        <%= button_to t("community.make_moderator"),
              community_moderators_path(@community, user_id: membership.user_id),
              method: :post, class: "btn btn-ghost btn-sm" %>
      <% elsif membership.role == "moderator" %>
        <%= button_to t("community.remove_moderator"),
              community_moderator_path(@community, membership),
              method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%# The last owner cannot be demoted: there would be nobody left who can
            appoint anyone, and nothing else in the app creates an owner. %>
        <%= t("community.owner_locked") %>
      <% end %>
    </li>
  <% end %>
</ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("community.no_members"),
        body: t("community.no_members_body"),
        action: { label: @community.name, path: community_path(@community) } %>
<% end %>
