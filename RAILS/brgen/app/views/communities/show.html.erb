<% content_for :title, @community.name %>

<header class="community-header" role="banner" aria-label="Community">
  <h1><%= @community.name %></h1>
  <% if @community.description.present? %><p><%= @community.description %></p><% end %>
  <p><strong><%= @community.posts.count %></strong> posts</p>
  <% if authenticated? && Current.user == @community.user %>
    <p class="cluster">
      <%= link_to "Edit", edit_community_path(@community), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", community_path(@community), method: :delete, data: { turbo_confirm: "Delete community?" }, class: "btn btn-danger btn-sm" %>
    </p>
  <% end %>
</header>

<% if Current.user.present? %>
  <p><%= link_to "+ New post in #{@community.name}", new_community_post_path(@community) %></p>
<% end %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post %>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: "No posts yet",
        body: "Start the conversation in #{@community.name} — guests can post without an account.",
        action: { label: "New post", path: new_community_post_path(@community) } %>
<% end %>

<aside>
  <h3>About <%= @community.name %></h3>
  <p><%= @community.description.presence || "No description." %></p>
  <% if Current.user.present? %>
    <p><%= link_to "New post", new_community_post_path(@community) %></p>
  <% end %>
</aside>
