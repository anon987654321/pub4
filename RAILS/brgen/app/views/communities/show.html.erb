<% content_for :title, @community.name %>
<% content_for :json_ld, json_ld_script(collection_page_schema(
      name: @community.name,
      url: schema_url_for(@community),
      items: @posts,
      item_type: "Article"
    )) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [city_name, main_app.root_url],
      [@community.name, request.original_url.split("?").first]
    ])) %>

<header class="community-header">
  <%= tag.h1 @community.name %>
  <% if @community.description.present? %><%= tag.p @community.description %><% end %>
  <p><%= t("community.posts_count", count: @community.posts.count) %> · <%= t("community.members_count", count: @community.members_count) %></p>
  <%# user_id, not user: comparing the association is a lazy read on a
      strict-loading record. Preloaded in the controller too, but the id
      comparison is what makes this page independent of that. %>
  <% if authenticated? && Current.user.id != @community.user_id %>
    <p class="cluster">
      <% if Current.user.member_of?(@community) %>
        <%= button_to t("community.leave"), leave_community_path(@community), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to t("community.join"), join_community_path(@community), method: :post, class: "btn btn-sm" %>
      <% end %>
    </p>
  <% end %>
  <%# The wiki is readable by whoever can read the community, so the link is not
      moderator-only — only writing it is. %>
  <p class="cluster">
    <%= link_to t("wiki.heading"), community_wiki_index_path(@community), class: "btn btn-ghost btn-sm" %>
  </p>
  <%# Moderators maintain rules and flair; only an owner can delete the place. %>
  <% if @moderator %>
    <p class="cluster">
      <%= link_to t("actions.edit"), edit_community_path(@community), class: "btn btn-ghost btn-sm" %>
      <%= link_to t("community.mod_queue"), community_moderation_index_path(@community), class: "btn btn-ghost btn-sm" %>
      <% if @community.owner?(Current.user) %>
        <%= link_to t("community.moderators"), community_moderators_path(@community), class: "btn btn-ghost btn-sm" %>
        <%= button_to t("actions.delete"), community_path(@community), method: :delete, data: { turbo_confirm: t("communities.confirm_delete") }, class: "btn btn-danger btn-sm" %>
      <% end %>
    </p>
  <% end %>
</header>

<% if @community.rule_list.any? %>
  <section class="community-rules" role="region" aria-label="<%= t("community.rules") %>">
    <%= tag.h2 t("community.rules") %>
    <ol>
      <% @community.rule_list.each do |rule| %><li><%= rule %></li><% end %>
    </ol>
  </section>
<% end %>

<% if @community.flair_options.any? %>
  <nav class="chips" role="navigation" aria-label="<%= t("community.filter_by_flair") %>">
    <%= link_to t("community.all_flair"), community_path(@community),
          class: "chip#{" active" if @flair.blank?}" %>
    <% @community.flair_options.each do |flair| %>
      <%= link_to flair, community_path(@community, flair: flair),
            class: "chip#{" active" if @flair == flair}" %>
    <% end %>
  </nav>
<% end %>

<%# postable_by? rather than "signed in": a restricted community lets the whole
    city read and only members post, and offering a compose link that will be
    refused on submit is worse than not offering it. %>
<% if @community.postable_by?(Current.user) %>
  <p><%= link_to t("community.new_post", name: @community.name), new_community_post_path(@community) %></p>
<% elsif Current.user.present? && @community.privacy != "public" %>
  <p><%= t("community.members_only_posting") %></p>
<% end %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post %>
  <% end %>
  <%# This page used to render every post a community had, unpaginated. Now that
      it pages, the rest still has to be reachable — the infinite-scroll sentinel
      the feeds use needs a reflex that knows this scope, so a plain link keeps
      it working without JS until that exists. %>
  <% if @pagy.next %>
    <nav class="cluster" aria-label="<%= t("nav.pagination", default: "Pagination") %>">
      <%= link_to t("actions.load_more", default: "Older posts"),
                  community_path(@community, page: @pagy.next), rel: "next", class: "btn btn-ghost" %>
    </nav>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_posts_yet"),
        body: t("empty.start_community", name: @community.name),
        action: { label: t("nav.new_post"), path: new_community_post_path(@community) } %>
<% end %>

<% if @other_communities.present? %>
  <aside>
    <%= tag.h2 t("communities.also_in_city", city: city_name) %>
    <ul>
      <% @other_communities.each do |community| %>
        <li><%= link_to community.name, community_path(community) %></li>
      <% end %>
    </ul>
  </aside>
<% end %>

<aside>
  <%= tag.h2 t("communities.about", name: @community.name) %>
  <%= tag.p @community.description.presence || "No description." %>
  <% if Current.user.present? %>
    <p><%= link_to t("nav.new_post"), new_community_post_path(@community) %></p>
  <% end %>
</aside>
