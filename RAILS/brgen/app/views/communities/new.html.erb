<h1>New community</h1>
<%= form_with model: @community do |f| %>
  <% if @community.errors.any? %>
    <ul>
      <% @community.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <p>
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "e.g. bergen, tech, musikk" %>
  </p>
  <p>
    <%= f.label :description %>
    <%= f.text_area :description, placeholder: "What is this community about?", rows: 3, data: { controller: "char-counter", "char-counter-max-value": 1000 } %>
    <span class="char-counter" data-char-counter-target="counter"></span>
  </p>
  <p>
    <%= f.submit "Create" %>
    <%= link_to "Cancel", communities_path %>
  </p>
<% end %>
