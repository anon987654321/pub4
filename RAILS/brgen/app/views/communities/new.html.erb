<%= tag.h1 t("communities.new_community") %>
<%= form_with model: @community do |f| %>
  <% if @community.errors.any? %>
    <ul>
      <% @community.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <p>
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: t("communities.name_placeholder") %>
  </p>
  <p>
    <%= f.label :description %>
    <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :description, placeholder: t("communities.description_placeholder"), rows: 3 , maxlength: 1000, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
  </p>
  <p>
    <%= f.submit t("communities.create") %>
    <%= link_to t("actions.cancel"), communities_path %>
  </p>
<% end %>
