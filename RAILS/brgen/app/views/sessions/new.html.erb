<div class="auth-form">
  <%= tag.h1 t("auth.sign_in") %>
  <p class="auth-form-lead"><%= t("auth.sign_in_lead") %></p>
  <%= render "shared/oauth_links" %>
  <%= form_with url: session_path do |f| %>
    <%= render "shared/errors", object: f.object if f.object.respond_to?(:errors) %>
    <%# input then label, and a one-space placeholder, because that is what
        .field--float needs: :placeholder-shown has to have a placeholder to be
        true about, and the label has to follow the input to be its sibling. The
        label is never hidden — it rises and shrinks, so it is still there while
        you type and still there when you check the form before sending it. %>
    <div class="field field--float">
      <%= f.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", inputmode: "email", enterkeyhint: "next",
            placeholder: " ", value: params[:email_address] %>
      <%= f.label :email_address, t("auth.email") %>
    </div>
    <div class="field field--float">
      <%= password_visibility_field f, :password, required: true,
            autocomplete: "current-password", enterkeyhint: "go",
            placeholder: " ", maxlength: 72 %>
      <%= f.label :password, t("auth.password") %>
    </div>
    <div class="actions">
      <%= f.submit t("auth.sign_in"), class: "btn btn-primary" %>
      <%# formaction, not a second form: the address is already in the field above,
          and formnovalidate lets it through without the password this path does
          not need. %>
      <%= f.submit t("auth.magic_link"), formaction: request_magic_session_path,
                   formnovalidate: true, class: "btn btn-link" %>
    </div>
    <p class="auth-form-footer">
      <%= link_to t("auth.create_account"), new_user_path %>
      <span class="auth-form-footer-sep" aria-hidden="true">·</span>
      <%= link_to t("auth.forgot_password"), new_password_path %>
    </p>
  <% end %>
</div>
