<% content_for :title, @set.name %>
<% content_for :json_ld, json_ld_for(@set, type: :music_playlist) if @set.privacy.blank? || @set.privacy == "public" %>

<div class="page-header">
  <hgroup>
    <p><%= t("playlist.set_kicker") %></p>
    <%= tag.h1 @set.name %>
  </hgroup>
  <% if authenticated? && (Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
    <div class="cluster">
      <%= link_to t("actions.edit"), edit_set_path(@set), class: "btn btn-ghost btn-sm" %>
      <%= button_to t("actions.delete"), set_path(@set), method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "btn btn-danger btn-sm" %>
    </div>
  <% end %>
</div>

<%# Collection player: waveform, timestamp comments, queue auto-next, customizable %>
<%= render "playlist/playlists/player", playlist: @set, tracks: @tracks, playlist_name: @set.name, tracks_count: @tracks.count, plays_count: 0, color: params[:color], comments: @comments, track_comments: @track_comments %>

<article>
  <% if @set.description.present? %>
    <%= tag.p @set.description %>
  <% end %>
  <p><%= t("playlist.privacy.#{@set.privacy.presence || "public"}") %> · <%= t("playlist.tracks", count: @tracks.count) %> · <%= @set.formatted_duration %></p>
  <% if @set.collaborative? %>
    <p>Collaborative</p>
  <% end %>
  <% if authenticated? %>
    <div class="cluster">
      <% if @set.likes.exists?(user: Current.user) %>
        <%= button_to t("actions.unlike"), set_like_path(@set), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to t("actions.like"), set_like_path(@set), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
      <%= @set.likes.count %> likes
    </div>
  <% else %>
    <p><%= @set.likes.count %> likes</p>
  <% end %>
</article>

<% if authenticated? %>
  <% set_can_manage = Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor]) %>
  <%= render "playlist/shared/collaborators",
        parent: @set,
        collaborations: @set.collaborations,
        collaborations_path: set_collaborations_path(@set),
        collaboration_path_proc: ->(c) { set_collaboration_path(@set, c) },
        can_manage: set_can_manage %>
  <%= render "playlist/shared/dilla_sketches",
        parent: @set,
        sketches: @dilla_sketches,
        create_url: set_dilla_sketches_path(@set),
        render_path_proc: ->(sk) { render_audio_playlist_set_dilla_sketch_path(@set, sk) },
        destroy_path_proc: ->(sk) { set_dilla_sketch_path(@set, sk) },
        can_manage: set_can_manage,
        rich_form: false %>
<% end %>

<% if @set_tracks.any? %>
  <% @set_tracks.each do |set_track| %>
    <article
      data-track-id="<%= set_track.track.id %>"
      data-controller="swipe"
      data-swipe-listen-url-value="<%= listens_path(track_id: set_track.track.id) %>"
      data-action="pointerdown->swipe#pointerDown pointermove->swipe#pointerMove pointerup->swipe#pointerUp pointercancel->swipe#pointerUp touchstart->swipe#pointerDown touchmove->swipe#pointerMove touchend->swipe#pointerUp"
      class="track-row"
    >
      <div> <%# scan: intentional — an anonymous text block; the flex row is the layout and a name here would have no reader %>
        <%= tag.strong set_track.track.title %>
        <% if set_track.track.artist.present? %> — <%= set_track.track.artist %><% end %>
         · <%= set_track.track.duration_formatted %>
      </div>
      <% if authenticated? && (Current.user == set_track.user || Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
        <%= button_to t("actions.remove"), set_track_path(@set, set_track), method: :delete, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </article>
  <% end %>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_tracks"),
        body: t("playlist.add_track_body", default: "Add a track to build this set."),
        action: { label: t("playlist.browse_sets"), path: sets_path } %>
<% end %>

<% if authenticated? && (Current.user == @set.user || @set.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
  <div class="section-divider">
    <p class="section-heading"><%= t("playlist.add_track", default: "Add a track") %></p>
    <div class="form-wrap form-wrap--flush">
      <%= form_with url: set_tracks_path(@set), scope: :playlist_track do |form| %>
        <div class="field"><%= form.text_field :title, placeholder: t("playlist.title"), aria: { label: t("playlist.title") }, required: true %></div>
        <div class="field"><%= form.text_field :artist, placeholder: t("playlist.artist"), aria: { label: t("playlist.artist") } %></div>
        <div class="field"><%= form.url_field :source_url, placeholder: t("playlist.url_optional"), aria: { label: t("playlist.url_optional") } %></div>
        <div class="field"><%= form.submit t("playlist.add"), class: "btn btn-primary btn-sm" %></div>
      <% end %>
    </div>
  </div>
<% end %>

<% if authenticated? %>
<section>
  <%= tag.h2 t("playlist.listening_party") %>
  <p><%= t("playlist.party_blurb") %></p>
  <% if @set.listening_party&.active? %>
    <%= link_to t("playlist.listening_party"), set_listening_party_path(@set), class: "btn btn-primary btn-sm" %>
    <% if Current.user && @set.user_id == Current.user.id %>
      <%= t("playlist.join_code") %>: <%= @set.listening_party.join_code %>
    <% end %>
  <% else %>
    <%= button_to t("playlist.start_party"), set_listening_party_path(@set), method: :post, class: "btn btn-primary btn-sm" %>
  <% end %>
</section>
<% end %>
