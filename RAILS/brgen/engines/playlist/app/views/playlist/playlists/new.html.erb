<% content_for :title, t("playlist.new_playlist") %>

<div class="page-header" role="banner" aria-label="<%= t("aria.new_playlist_header") %>">
  <%= tag.h1 t("playlist.new_playlist") %>
</div>

<turbo-frame id="playlist-new" data-turbo-action="replace">
<div class="form-wrap">
  <%= form_with model: @playlist, url: playlists_path, html: { role: "form", "aria-label": "Create playlist" } do |f| %>
    <%= render "shared/errors", object: @playlist %>
    <div class="field"><%= f.label :name %><%= f.text_field :name %></div>
    <div class="field"><%= f.label :description %><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :description, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></div>
    <div class="field field--check"><%= f.check_box :public_access %><%= f.label :public_access, t("playlist.public_access") %></div>
    <div class="field field--check"><%= f.check_box :collaborative %><%= f.label :collaborative, "Collaborative" %></div>
    <div class="field"><%= f.submit t("playlist.create"), class: "btn btn-primary" %></div>
  <% end %>
</div>
