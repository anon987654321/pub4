<%# locals: (playlist:, tracks:, active_track: nil, playlist_name: nil, tracks_count: nil, plays_count: nil, color: "#00d4ff", comments: [], track_comments: {}) %>
<%# color/comments/track_comments were read via local_assigns below but never
    declared here. Strict locals raise on any keyword the declaration omits, so
    show.html.erb — which passes all three — 500'd on every playlist page. %>
<% rows = tracks.map { |entry| entry.is_a?(Playlist::Track) ? entry : entry.track } %>
<% active = active_track || rows.first %>
<% heading = playlist_name || playlist.name %>
<% total_tracks = tracks_count || playlist.tracks_count %>
<% total_plays = plays_count || playlist.plays_count %>
<% active_src = active&.audio_file&.attached? ? main_app.url_for(active.audio_file) : (active&.source_type == "direct" ? active&.source_url : nil) %>
<% active_embed = active&.external_embed_url %>
<% active_art = active&.artwork&.attached? ? main_app.url_for(active.artwork) : nil %>

<div
  class="playlist-app"
  itemscope
  itemtype="https://schema.org/MusicPlaylist"
  data-controller="playlist-player"
  data-playlist-player-src-value="<%= active_src %>"
  data-playlist-player-embed-value="<%= active_embed %>"
  data-playlist-player-title-value="<%= active&.title %>"
  data-playlist-player-artist-value="<%= active&.artist %>"
  data-playlist-player-artwork-value="<%= active_art %>"
  data-playlist-player-track-id-value="<%= active&.id %>"
  data-playlist-player-color-value="<%= local_assigns[:color] || "#00d4ff" %>"
  data-playlist-player-comments-value="<%= (local_assigns[:comments] || []).to_json %>"
  data-playlist-player-track-comments-value="<%= (local_assigns[:track_comments] || {}).to_json %>"
  data-playlist-player-show-artwork-value="<%= (local_assigns[:show_artwork].nil? ? true : local_assigns[:show_artwork]) %>"
  data-playlist-player-compact-value="<%= !!local_assigns[:compact] %>"
  data-playlist-player-hide-branding-value="<%= !!local_assigns[:hide_branding] %>"
>
  <% unless local_assigns[:embedded] %>
<header class="playlist-top">
    <hgroup>
      <p class="playlist-top-eyebrow">brgen</p>
      <h1 class="playlist-top-title" itemprop="name"><%= heading %></h1>
    </hgroup>
    <% if authenticated? %>
      <%= link_to t("playlist.new_playlist"), new_playlist_path, class: "playlist-top-action" %>
    <% end %>
  </header>
<% end %>

  <section class="playlist-stage" aria-label="<%= t("playlist.now_playing") %>">
    <% show_art = local_assigns[:show_artwork].nil? ? true : local_assigns[:show_artwork] %>
    <% if show_art %>
    <div class="playlist-artwork-wrap">
      <% if active_art %>
        <%= image_tag active_art, alt: active.title, class: "playlist-artwork", data: { playlist_player_target: "artwork" } %>
      <% else %>
        <div class="playlist-artwork playlist-artwork--fallback" aria-hidden="true" data-playlist-player-target="artwork"></div>
      <% end %>
    </div>
    <% end %>

    <canvas
      class="playlist-waveform-canvas <%= local_assigns[:compact] ? 'is-compact' : '' %>"
      data-playlist-player-target="waveform"
      data-action="click->playlist-player#waveformScrub"
      role="img"
      aria-label="<%= t("playlist.waveform") %>"
    ></canvas>

    <div class="playlist-now-playing <%= local_assigns[:compact] ? 'is-compact' : '' %>">
      <h2 class="playlist-now-playing-title" data-playlist-player-target="title" itemprop="track"><%= active&.title || t("playlist.select_track") %></h2>
      <p class="playlist-now-playing-artist" data-playlist-player-target="artist"><%= active&.artist.presence || t("playlist.unknown_artist") %></p>
      <p class="playlist-now-playing-meta">
        <%= t("playlist.queue_stats", tracks: total_tracks, plays: total_plays) %>
        <% if active&.duration_formatted.present? %> · <%= active.duration_formatted %><% end %>
      </p>
    </div>
  </section>

  <footer class="playlist-transport" aria-label="<%= t("playlist.transport") %>">
    <button
      type="button"
      class="playlist-transport-play"
      data-playlist-player-target="playBtn"
      data-action="playlist-player#toggle"
      aria-pressed="false"
      <%= "disabled" unless active_src %>
    ><%= t("playlist.play") %></button>

    <span class="playlist-transport-time" data-playlist-player-target="currentTime">0:00</span>

    <%# tabindex is not decoration: role="slider" without it announces a control
        a keyboard cannot reach. Arrow/Home/End handling is scrubKey in the
        controller. Kept outside the tag — an ERB comment between attributes
        defeats every HTML attribute parser, including the one in
        RAILS/test/keyboard_reachable_controls_test.rb. %>
    <div
      class="playlist-scrub"
      data-playlist-player-target="scrub"
      data-action="click->playlist-player#scrub keydown->playlist-player#scrubKey"
      role="slider"
      tabindex="0"
      aria-label="<%= t("playlist.seek") %>"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="playlist-scrub-fill" data-playlist-player-target="scrubFill"></div>
    </div>

    <span class="playlist-transport-time" data-playlist-player-target="duration">0:00</span>

    <% unless local_assigns[:embedded] %>
    <button type="button" class="playlist-add-comment" data-action="playlist-player#addComment" aria-label="<%= t("playlist.add_comment_aria") %>"><%= t("playlist.add_comment") %></button>
    <% end %>
  </footer>

  <% unless local_assigns[:embedded] %>
    <%= render "playlist/playlists/comment_form" %>
  <% end %>

  <iframe class="playlist-embed-frame" src="<%= active_embed %>" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" data-playlist-player-target="embed" <%= "hidden" unless active_embed %>></iframe>
  <% if active_src %>
    <%= audio_tag active_src, data: { playlist_player_target: "audio" }, preload: "metadata" %>
  <% else %>
    <audio data-playlist-player-target="audio" preload="metadata"></audio>
  <% end %>

  <section class="playlist-queue" aria-label="<%= t("playlist.queue") %>">
    <h2 class="playlist-queue-heading"><%= t("playlist.queue") %></h2>
    <% rows.each_with_index do |track, index| %>
      <% track_src = track.audio_file.attached? ? main_app.url_for(track.audio_file) : (track.source_type == "direct" ? track.source_url : nil) %>
      <% track_embed = track.external_embed_url %>
      <% track_art = track.artwork.attached? ? main_app.url_for(track.artwork) : nil %>
      <button
        type="button"
        class="playlist-queue-item<%= " is-active" if track == active %>"
        data-playlist-player-target="queueItem"
        data-action="playlist-player#load"
        data-playlist-player-src-param="<%= track_src %>"
        data-playlist-player-embed-param="<%= track_embed %>"
        data-playlist-player-title-param="<%= track.title %>"
        data-playlist-player-artist-param="<%= track.artist %>"
        data-playlist-player-artwork-param="<%= track_art %>"
        data-playlist-player-track-id-param="<%= track.id %>"
        data-playlist-player-comments-param="<%= (local_assigns[:track_comments] && local_assigns[:track_comments][track.id] || local_assigns[:comments] || []).to_json %>"
        <%= "disabled" unless track_src || track_embed %>
        itemprop="track"
        itemscope
        itemtype="https://schema.org/MusicRecording"
      >
        <span class="playlist-queue-index"><%= index + 1 %></span>
        <span class="playlist-queue-art" aria-hidden="true">
          <% if track_art %>
            <%= image_tag track_art, alt: "" %>
          <% end %>
        </span>
        <span class="playlist-queue-meta">
          <strong itemprop="name"><%= track.title %></strong>
          <span><span itemprop="byArtist"><%= track.artist.presence || t("playlist.unknown_artist") %></span> · <%= track.duration_formatted %></span>
        </span>
      </button>
    <% end %>
    <% if tracks.empty? %>
      <%= render "shared/empty_state",
            title: t("empty.no_tracks"),
            body: t("playlist.no_tracks_body"),
            action: { label: t("playlist.library"), path: root_path } %>
    <% end %>
  </section>

  <section class="playlist-comments" aria-label="<%= t("aria.timestamped_comments") %>" id="playlist:track:<%= active&.id %>:comments" data-playlist-player-target="commentsList">
    <%= tag.h3 t("playlist.comments_seek") %>
    <% (local_assigns[:comments] || []).each do |c| %>
      <div class="playlist-comment" data-time="<%= c[:time] %>" data-action="click->playlist-player#seekToComment">
        <span class="time"><%= c[:time] %></span>
        <span class="text"><%= c[:text] %></span>
      </div>
    <% end %>
  </section>

  <%# Inside .playlist-app deliberately: the bar is position: fixed so its DOM
      position does not affect where it renders, but its data-action targets
      resolve against the playlist-player controller on this element. %>
  <%= render "playlist/shared/transport_bar", scope: "playlist-player",
        controls: %w[previous toggle stop next volume] %>
</div>
