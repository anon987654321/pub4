<%# dat.GUI only when explicitly requested (?datgui=1 + show_dat_gui).
    Default off — the light autoPlace panel steals the brand corner. %>
<% if local_assigns.fetch(:show_dat_gui, false) %>
<% content_for :head do %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dat-gui/0.7.9/dat.gui.min.js" defer></script>
<% end %>
<% end %>

<%# auto_start defaults true (including minimal playlist home) — same spirit as
    MASTER face embed autostart. Overlay stays as a silent-autoplay fallback. %>
<% auto_start = local_assigns.fetch(:auto_start, true) %>
<% hide_overlay = local_assigns.fetch(:hide_overlay, auto_start) %>
<%= tag.div(
      class: "radio-tunnel#{' radio-tunnel--autostart' if auto_start}",
      data: {
        controller: "radio-tunnel",
        radio_tunnel_tracks_value: radio_tunnel_catalog,
        radio_tunnel_auto_start_value: auto_start
      }
    ) do %>

  <canvas
    id="radio-canvas"
    data-radio-tunnel-target="canvas"
    role="img"
    aria-label="warp tunnel visualizer"
  ></canvas>

  <header class="radio-header">
    <h1 data-radio-tunnel-target="heading">brgen</h1>
  </header>

  <% unless local_assigns.fetch(:minimal, false) %>
  <nav class="radio-nav" aria-label="<%= t("aria.playlist_navigation") %>">
    <% if authenticated? %>
      <%= link_to "New", new_playlist_path %>
      <%= link_to "Upload", new_hosted_track_path %>
    <% end %>
    <% if local_assigns.fetch(:show_library, false) %>
      <button type="button" class="radio-nav-btn" data-action="click->radio-tunnel#openLibrary">Library</button>
    <% end %>
  </nav>

  <aside class="radio-archaeology" data-radio-tunnel-target="archaeology" hidden aria-label="<%= t("aria.git_archaeology_log") %>">
    <% radio_archaeology_lines.each do |line| %>
      <div class="radio-archaeology-line"><%= line %></div>
    <% end %>
  </aside>
  <% end %>

  <%# Now-playing stays on for minimal home too — auto-start is useless if you
      cannot see the track. %>
  <div class="radio-now-playing<%= " radio-now-playing--minimal" if local_assigns.fetch(:minimal, false) %>" aria-live="polite">
    <span class="radio-note-icon" aria-hidden="true">♪</span>
    <span class="radio-track-display" data-radio-tunnel-target="trackDisplay">…</span>
  </div>

  <div
    class="radio-overlay"
    data-radio-tunnel-target="overlay"
    <%= "hidden" if hide_overlay %>
    aria-labelledby="radio-overlay-title"
  >
    <h2 id="radio-overlay-title" class="visually-hidden">Radio Bergen</h2>
    <p class="radio-start-hint"><%= t("playlist.tap_to_start") %></p>
  </div>

  <div class="radio-youtube-container" aria-hidden="true">
    <iframe
      data-radio-tunnel-target="youtubePlayer"
      width="1"
      height="1"
      frameborder="0"
      allow="autoplay; encrypted-media"
      title="YouTube player"
    ></iframe>
  </div>

  <% if local_assigns.fetch(:show_library, false) %>
    <%= render "playlist/playlists/library", playlists: playlists, pagy: local_assigns[:pagy] %>
  <% end %>

  <%# play/stop/next only: this surface is driven by RadioBrgen, whose AudioEngine
      exposes start/stop/nextTrack over a YouTube iframe and has no pause and no
      previous. Rendering those two would be buttons that discard the click. %>
  <%= render "playlist/shared/transport_bar",
        scope: "radio-tunnel",
        controls: %w[play stop next] %>
<% end %>
