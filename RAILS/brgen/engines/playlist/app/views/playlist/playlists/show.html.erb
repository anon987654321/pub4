<% content_for :title, @playlist.name %>
<% content_for :json_ld, json_ld_for(@playlist, type: :music_playlist) if @playlist.public_access? %>

<p class="radio-back-link"><%= link_to t("playlist.back_to_radio"), root_path %></p>
<%= render "playlist/playlists/player", playlist: @playlist, tracks: @tracks, color: params[:color] || "#00d4ff", comments: @comments, track_comments: @track_comments %>

<p><%= t("playlist.set_stats", plays: @playlist.plays_count.to_i, tracks: @tracks.size, comments: @comments.size) %></p>

<% if authenticated? && (Current.user == @playlist.user || @playlist.collaborations.exists?(user: Current.user, role: %w[owner editor])) %>
  <section class="playlist-admin" aria-label="<%= t("playlist.management") %>">
    <nav class="cluster" role="navigation" aria-label="<%= t("playlist.actions") %>">
      <%= link_to t("actions.edit"), edit_playlist_path(@playlist), class: "btn btn-ghost btn-sm" %>
      <%= button_to t("actions.delete"), playlist_path(@playlist), method: :delete, data: { turbo_confirm: t("actions.confirm_delete") }, class: "btn btn-danger btn-sm" %>
    </nav>

    <details>
      <summary><%= t("playlist.add_track") %></summary>
      <div class="form-wrap form-wrap--flush">
        <%= form_with url: playlist_tracks_path(@playlist), scope: :playlist_track do |f| %>
          <div class="field"><%= f.text_field :title, placeholder: t("playlist.title"), aria: { label: t("playlist.title") } %></div>
          <div class="field"><%= f.text_field :artist, placeholder: t("playlist.artist"), aria: { label: t("playlist.artist") } %></div>
          <div class="field"><%= f.select :source_type, Playlist::Track::SOURCE_TYPES.reject { |type| type == "whyp" }.map { |type| [type.humanize, type] }, { include_blank: t("playlist.source") }, { aria: { label: t("playlist.source") } } %></div>
          <div class="field"><%= f.url_field :source_url, placeholder: t("playlist.url_optional"), aria: { label: t("playlist.url_optional") } %></div>
          <div class="field"><%= f.datetime_field :expires_at, aria: { label: t("playlist.expires_at") } %></div>
          <div class="field"><%= f.submit t("takeaway.add"), class: "btn btn-primary btn-sm" %></div>
        <% end %>
      </div>
    </details>

    <details>
      <summary><%= t("playlist.import_links") %></summary>
      <div class="form-wrap form-wrap--flush">
        <%= form_with url: playlist_imports_path(@playlist), method: :post do |f| %>
          <div class="field"><%= f.text_area :urls, rows: 4, placeholder: t("playlist.import_urls_placeholder"), aria: { label: t("playlist.import_urls_placeholder") } %></div>
          <div class="field"><%= f.submit t("playlist.import"), class: "btn btn-primary btn-sm" %></div>
        <% end %>
      </div>
    </details>

    <details>
      <summary><%= t("playlist.embed_customize") %></summary>
      <% embed_html = %(<iframe src="#{embed_playlist_url(@playlist)}" loading="lazy" width="100%" height="520"></iframe>) %>
      <%= render "shared/copyable", text: embed_html, label: t("playlist.embed_code") %>
      <small>
        <%= t("playlist.embed_examples") %>:
        <%= link_to t("playlist.embed_red"), embed_playlist_url(@playlist, color: "ff0000") %>
        |
        <%= link_to t("playlist.embed_no_artwork"), embed_playlist_url(@playlist, color: "00ff00", show_artwork: "0") %>
        |
        <%= link_to t("playlist.embed_compact"), embed_playlist_url(@playlist, compact: "1", hide_branding: "1") %>
      </small>
    </details>

    <% if @tracks.any? %>
      <details>
        <summary><%= t("playlist.reorder_tracks") %></summary>
        <ol class="playlist-reorder" data-controller="sortable" data-sortable-param-name-value="position">
          <% @tracks.each do |entry| %>
            <li data-sortable-update-url="<%= playlist_track_path(@playlist, entry) %>">
              <%= entry.track.title %>
            </li>
          <% end %>
        </ol>
      </details>
    <% end %>
  </section>
<% end %>

<% if authenticated? %>
  <% pl_can_manage = Current.user == @playlist.user || @playlist.collaborations.exists?(user: Current.user, role: %w[owner editor]) %>
  <details>
    <summary><%= t("playlist.collaborators_sketches") %></summary>
    <%= render "playlist/shared/collaborators",
          parent: @playlist,
          collaborations: @playlist.collaborations,
          collaborations_path: playlist_collaborations_path(@playlist),
          collaboration_path_proc: ->(c) { playlist_collaboration_path(@playlist, c) },
          can_manage: pl_can_manage %>
    <%= render "playlist/shared/dilla_sketches",
          parent: @playlist,
          sketches: @dilla_sketches,
          create_url: playlist_dilla_sketches_path(@playlist),
          render_path_proc: ->(sk) { render_audio_playlist_dilla_sketch_path(@playlist, sk) },
          can_manage: pl_can_manage,
          lab_query: "?playlist_id=#{@playlist.id}",
          rich_form: true %>
  </details>
<% end %>
