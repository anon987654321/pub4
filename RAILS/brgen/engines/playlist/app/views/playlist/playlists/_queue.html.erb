<%# locals: (rows:, active:, comments: [], track_comments: {}) %>
<%# Split out of _player.html.erb, which was over the 150-code-line view ceiling.
    The queue is the natural seam: everything above it in the player describes one
    track, and everything here describes the list. It takes `rows` already
    normalised to Playlist::Track by the caller — the player accepts either a
    Track or a join row, and resolving that in two places is how the two lists
    drift apart. %>
<section class="playlist-queue" aria-label="<%= t("playlist.queue") %>">
  <h2 class="playlist-queue-heading"><%= t("playlist.queue") %></h2>
  <% rows.each_with_index do |track, index| %>
    <% track_src = track.audio_file.attached? ? main_app.url_for(track.audio_file) : (track.source_type == "direct" ? track.source_url : nil) %>
    <% track_embed = track.external_embed_url %>
    <% track_art = track.artwork.attached? ? main_app.url_for(track.artwork) : nil %>
    <button
      type="button"
      class="playlist-queue-item<%= " is-active" if track == active %>"
      data-playlist-player-target="queueItem"
      data-action="playlist-player#load"
      data-playlist-player-src-param="<%= track_src %>"
      data-playlist-player-embed-param="<%= track_embed %>"
      data-playlist-player-title-param="<%= track.title %>"
      data-playlist-player-artist-param="<%= track.artist %>"
      data-playlist-player-artwork-param="<%= track_art %>"
      data-playlist-player-track-id-param="<%= track.id %>"
      data-playlist-player-comments-param="<%= (track_comments[track.id] || comments).to_json %>"
      <%= "disabled" unless track_src || track_embed %>
      itemprop="track"
      itemscope
      itemtype="https://schema.org/MusicRecording"
    >
      <span class="playlist-queue-index"><%= index + 1 %></span>
      <span class="playlist-queue-art" aria-hidden="true">
        <% if track_art %>
          <%= image_tag track_art, alt: "" %>
        <% end %>
      </span>
      <span class="playlist-queue-meta">
        <strong itemprop="name"><%= track.title %></strong>
        <span><span itemprop="byArtist"><%= track.artist.presence || t("playlist.unknown_artist") %></span> · <%= track.duration_formatted %></span>
      </span>
    </button>
  <% end %>
  <%# rows, not the caller's `tracks`. They are 1:1 and this only ever needed one
      of them — asking the other is how an empty state renders beside a full list. %>
  <% if rows.empty? %>
    <%= render "shared/empty_state",
          title: t("empty.no_tracks"),
          body: t("empty.add_tracks"),
          action: { label: t("playlist.library"), path: root_path } %>
  <% end %>
</section>
