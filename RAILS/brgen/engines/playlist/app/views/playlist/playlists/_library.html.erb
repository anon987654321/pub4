<aside class="radio-library" id="radio-library" hidden aria-label="<%= t("aria.playlist_library") %>">
  <header class="radio-library-header">
    <h2>Library</h2>
    <button type="button" class="radio-library-close" data-action="click->radio-tunnel#closeLibrary" aria-label="<%= t("aria.close_library") %>">×</button>
  </header>
  <div id="playlist-library-list" class="radio-library-list">
    <% playlists.each do |playlist| %>
      <%= render "playlist/playlists/row", playlist: %>
    <% end %>
    <% if playlists.empty? %>
      <%= render "shared/empty_state",
            title: t("empty.no_playlists"),
            body: t("empty.create_playlist"),
            action: { label: t("playlist.new_playlist"), path: new_playlist_path } %>
    <% end %>
  </div>

  <% if local_assigns[:pagy]&.next %>
    <%= render "shared/infinite_scroll_sentinel",
               pagy: pagy,
               reflex: "PlaylistsInfiniteScrollReflex#load_more",
               sentinel_id: "playlist-library-sentinel" %>
  <% end %>
</aside>
