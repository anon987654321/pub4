<%= form_with model: [:playlist, track], url: track.persisted? ? hosted_track_path(track) : hosted_tracks_path do |form| %>
  <%= render "shared/errors", object: track %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :artist %>
    <%= form.text_field :artist %>
  </div>

  <div class="field">
    <%= form.label :album %>
    <%= form.text_field :album %>
  </div>

  <div class="field">
    <%= form.label :source_type %>
    <%= form.select :source_type, Playlist::Track::SOURCE_TYPES.reject { |t| t == "whyp" }.map { |t| [t.humanize, t] }, include_blank: true %>
  </div>

  <div class="field">
    <%= form.label :source_url %>
    <%= form.url_field :source_url, inputmode: "url" %>
  </div>

  <div class="field">
    <%= form.label :privacy %>
    <%= form.select :privacy, Playlist::Track::PRIVACY_LEVELS.map { |p| [p.humanize, p] } %>
  </div>

  <div class="field">
    <%= form.label :expires_at %>
    <%= form.datetime_field :expires_at %>
  </div>

  <div class="field">
    <%= form.label :audio_file, track.persisted? ? "Replace audio file (keeps URL)" : "Audio file(s) - bulk upload supported" %>
    <%= form.file_field :audio_file, direct_upload: true, data: { controller: "direct-upload" }, multiple: !track.persisted? %>
    <% if track.persisted? && track.audio_file.attached? %>
      <small><%= t("playlist.current_file", name: track.audio_file.filename) %></small>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :artwork %>
    <%= form.file_field :artwork, direct_upload: true, data: { controller: "direct-upload" } %>
  </div>

  <%= form.submit class: "btn btn-primary btn-sm" %>
<% end %>
