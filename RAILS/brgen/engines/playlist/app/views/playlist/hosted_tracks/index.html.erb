<% content_for :title, t("playlist.hosted_tracks") %>

<div class="page-header">
  <hgroup>
    <p>Playlist</p>
    <%= tag.h1 t("playlist.hosted_tracks") %>
  </hgroup>
  <% if authenticated? %>
    <%= link_to "Upload track", new_hosted_track_path, class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<div id="hosted_tracks">
  <% if @tracks.any? %>
    <% @tracks.each do |track| %>
      <article>
        <h2><%= link_to track.title, hosted_track_path(track) %></h2>
        <p><%= track.artist.presence || "Unknown artist" %> · <%= track.duration_formatted %></p>
      </article>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_hosted_tracks"),
          body: "Upload or link a track to host it.",
          action: authenticated? ?
            { label: t("playlist.upload_track"), path: new_hosted_track_path } :
            { label: t("playlist.browse_playlists"), path: root_path } %>
  <% end %>
</div>
