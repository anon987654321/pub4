<% content_for :title, t("playlist.listening_party_title", name: @set.name) %>
<%= turbo_stream_from @party.stream_name %>

<div class="page-header" role="banner">
  <div>
    <p><%= t("playlist.listening_party") %></p>
    <%= tag.h1 @set.name %>
    <p><%= t("playlist.join_code") %>: <%= tag.strong @party.join_code %></p>
  </div>
  <% if @party.host == Current.user %>
    <%= button_to t("playlist.end_party"), set_listening_party_path(@set), method: :delete,
          data: { turbo_confirm: t("playlist.confirm_end_party") }, class: "btn btn-danger btn-sm" %>
  <% end %>
</div>

<div id="listening_party_sync">
  <%= render "playlist/listening_parties/sync", party: @party, track: @party.current_track %>
</div>

<section>
  <%= tag.h2 t("playlist.queue") %>
  <ol>
    <% @tracks.each do |track| %>
      <li><%= track.title %> — <%= track.artist %></li>
    <% end %>
  </ol>
</section>

<section>
  <%= tag.h2 t("playlist.party_chat") %>
  <div id="party_messages">
    <%= render partial: "playlist/party_messages/message", collection: @messages, as: :message %>
  </div>

  <%= form_with url: set_listening_party_party_messages_path(@set), method: :post, class: "form-wrap" do |f| %>
    <div class="field field--row">
      <%= f.text_field :body, placeholder: t("playlist.say_something"), required: true, class: "field--grow",
            aria: { label: t("playlist.say_something") } %>
      <%= f.submit t("actions.send"), class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</section>

<p><%= link_to t("playlist.back_to_set"), set_path(@set), class: "btn btn-ghost btn-sm" %></p>
