<% content_for :title, t("dating.matches") %>

<div class="page-header" role="banner" aria-label="<%= t("dating.matches") %>">
  <h1><%= t("dating.matches") %></h1>
  <nav role="navigation" aria-label="<%= t("dating.matches") %>">
    <%= link_to t("dating.discover"), root_path, class: "btn btn-ghost btn-sm" %>
  </nav>
</div>

<turbo-frame id="dating-matches" data-turbo-action="replace">
<% if @matches.none? %>
  <%= render "shared/empty_state",
        title: t("dating.no_matches"),
        body: t("dating.no_matches_body"),
        action: { label: t("dating.discover"), path: root_path } %>
<% else %>
  <section id="dating-matches-list" class="match-list" role="list" aria-label="<%= t("dating.matches") %>">
    <% @matches.each do |match| %>
      <%= render "dating/matches/match", match: %>
    <% end %>
  </section>

  <%= render "shared/infinite_scroll_sentinel",
             pagy: @pagy,
             reflex: "MatchesInfiniteScrollReflex#load_more",
             sentinel_id: "dating-matches-sentinel" %>
<% end %>
