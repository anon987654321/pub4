<% content_for :title, t("dating.who_liked_you") %>

<div class="page-header" role="banner" aria-label="<%= t("dating.who_liked_you") %>">
  <h1><%= t("dating.who_liked_you") %></h1>
  <%= link_to t("dating.back_to_deck"), root_path, class: "btn btn-ghost btn-sm" %>
</div>

<% if @likes.any? %>
  <%# A separate page rather than folded into the deck: people who have already
      said yes are a different decision from people who have not seen you. %>
  <ul class="like-list" role="list">
    <% @likes.each do |like| %>
      <% profile = like.liker.dating_profile %>
      <li class="like-card">
        <p>
          <strong><%= profile&.name || like.liker.display_name %></strong>
          <% if profile&.age %><span class="dim"><%= profile.age %></span><% end %>
        </p>

        <%# The comment is the whole point of the Hinge interaction: it says
            what they liked, so the reply has somewhere to start. %>
        <% if like.commented? %>
          <% if like.dating_prompt %>
            <p class="dim"><%= like.dating_prompt.question_text %></p>
            <p><em><%= like.dating_prompt.answer %></em></p>
          <% end %>
          <blockquote class="like-comment"><%= like.comment %></blockquote>
        <% end %>

        <div class="cluster">
          <%= button_to t("dating.like_back"), likes_path(user_id: like.liker_id),
                method: :post, class: "btn btn-primary btn-sm" %>
          <%= button_to t("dating.pass"), dislikes_path(user_id: like.liker_id),
                method: :post, class: "btn btn-ghost btn-sm" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("dating.no_likes_title"),
        body: t("dating.no_likes_body"),
        action: { label: t("dating.back_to_deck"), path: root_path } %>
<% end %>
