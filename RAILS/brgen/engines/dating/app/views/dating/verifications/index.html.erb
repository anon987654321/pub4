<% content_for :title, t("dating.verify_queue") %>

<div class="page-header" role="banner" aria-label="<%= t("dating.verify_queue") %>">
  <%= tag.h1 t("dating.verify_queue") %>
</div>

<% if @verifications.any? %>
  <ul role="list" class="verify-queue">
    <% @verifications.each do |verification| %>
      <li role="listitem">
        <p><%= verification.profile.user&.display_name %> — <%= t("dating.poses.#{verification.pose}") %></p>
        <% if verification.selfie.attached? %>
          <%= lazy_image_tag verification.selfie, alt: "" %>
        <% end %>
        <div class="order-actions">
          <%= button_to t("dating.verify_approve"), verification_path(verification, decision: "approve"), method: :patch, class: "btn btn-sm" %>
          <%= button_to t("dating.verify_reject"), verification_path(verification, decision: "reject"), method: :patch, class: "btn btn-ghost btn-sm" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state", title: t("dating.verify_queue_empty"), body: t("dating.verify_queue_empty_body") %>
<% end %>
