<% content_for :title, t("dating.create_profile") %>

<div class="page-header">
  <%= tag.h1 t("dating.create_profile") %>
  <p><%= t("dating.create_profile_blurb") %></p>
</div>

<div class="form-wrap dating-profile-form">
  <% draft_key = "brgen-dating-profile-new" %>
  <%= form_with(model: @profile, url: profile_path, data: { controller: "draft-store autosave", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: main_app.draft_path(draft_key)) }) do |f| %>
    <%= render "shared/errors", object: @profile %>

    <fieldset class="dating-profile-essentials">
      <legend class="visually-hidden"><%= t("dating.essentials") %></legend>
      <div class="field">
        <%= f.label :photos, t("dating.photos") %>
        <%= f.file_field :photos, multiple: true, accept: "image/*", direct_upload: true, data: { controller: "direct-upload" } %>
        <p><%= t("dating.photo_hint") %></p>
      </div>
      <div class="field">
        <%= f.label :bio, t("dating.about_you") %>
        <div data-controller="character-counter" data-character-counter-countdown-value="true">
          <div class="compose-surface" data-controller="tiptap-editor">
            <%= f.text_area :bio, rows: 4, maxlength: 500,
                  data: { character_counter_target: "input", tiptap_editor_target: "field" } %>
            <div class="tiptap_mount" data-tiptap-editor-target="mount" hidden></div>
            <div class="tiptap_toolbar" data-tiptap-editor-target="toolbar" hidden>
              <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bold" title="<%= t("compose.bold", default: "Bold") %>"><strong>B</strong></button>
              <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#italic" title="<%= t("compose.italic", default: "Italic") %>"><em>i</em></button>
              <button type="button" class="tiptap_btn" data-action="mousedown->tiptap-editor#bulletList" title="<%= t("compose.bullet_list", default: "Bullet list") %>">&bull;</button>
            </div>
          </div>
          <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
        </div>
      </div>
      <div class="field">
        <%= f.label :looking_for, t("dating.looking_for") %>
        <%= f.select :looking_for, Dating::Profile::LOOKING_FOR, { include_blank: "—" } %>
      </div>
    </fieldset>

    <details class="dating-profile-more">
      <summary><%= t("dating.more_details_optional") %></summary>
      <div class="field"><%= f.label :gender %><%= f.select :gender, Dating::Profile::GENDERS, { include_blank: "—" } %></div>
      <div class="field"><%= f.label :age %><%= f.number_field :age, min: 18, max: 99, required: true %></div>
      <p><%= t("legal.dating_age") %></p>
      <div class="field"><%= f.label :location %><%= f.text_field :location %></div>
      <div class="field">
        <%= f.label :neighborhood_id, t("dating.neighborhood") %>
        <%= f.select :neighborhood_id, @neighborhoods.map { |n| [n.name, n.id] }, { include_blank: "—" } %>
      </div>
      <div class="field field--check"><%= f.check_box :visible %><%= f.label :visible, "Make profile visible" %></div>
    </details>

    <div class="field">
      <%= f.submit t("dating.save"), class: "btn btn-primary" %>
      <span data-autosave-target="status" aria-live="polite"></span>
    </div>
  <% end %>
</div>
