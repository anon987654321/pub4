<% content_for :title, t("dating.your_profile") %>

<div class="page-header">
  <%= tag.h1 t("dating.your_profile") %>
  <%= link_to t("dating.edit_profile"), edit_profile_path, class: "btn btn-ghost btn-sm" %>
</div>

<nav class="sort-tabs" aria-label="<%= t("aria.profile_sections") %>" role="tablist" data-controller="tabs">
  <a href="#photos" class="sort-tab active" id="profile-photos-tab" role="tab" aria-selected="true" data-tabs-target="tab" data-tabs-hash-value="#photos" data-action="click->tabs#select">Photos</a>
  <a href="#about" class="sort-tab" id="profile-about-tab" role="tab" aria-selected="false" data-tabs-target="tab" data-tabs-hash-value="#about" data-action="click->tabs#select"><%= t("dating.about_tab") %></a>
  <a href="#details" class="sort-tab" id="profile-details-tab" role="tab" aria-selected="false" data-tabs-target="tab" data-tabs-hash-value="#details" data-action="click->tabs#select">Details</a>
</nav>

<section data-tabs-target="panel" data-tabs-hash-value="#photos" aria-labelledby="profile-photos-tab">
  <% if @profile.photos.attached? %>
    <div class="photo-strip">
      <% @profile.photos.each do |photo| %>
        <%= lazy_image_tag photo, alt: @profile.name, blurhash: photo.try(:metadata).try(:[], "blurhash"), class: "photo-thumb" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_photos"),
          body: t("dating.no_photos_body"),
          action: { label: "Edit profile", path: edit_profile_path } %>
  <% end %>
</section>

<section data-tabs-target="panel" data-tabs-hash-value="#about" aria-labelledby="profile-about-tab" hidden>
  <article>
    <% if @profile.bio.present? %>
      <%= read_more(@profile.bio, lines: 3, more: t("dating.read_bio"), less: t("dating.show_less")) %>
    <% else %>
      <p>Bio<br>—</p>
    <% end %>
  </article>
</section>

<section data-tabs-target="panel" data-tabs-hash-value="#details" aria-labelledby="profile-details-tab" hidden>
  <article>
    <%# Each label/value pair is its own element so the gap can separate pairs
        rather than characters. Bare text nodes between spans would become
        anonymous flex items and the gap would land inside a pair, not between. %>
    <p class="profile-meta">
      <span><%= t("dating.age") %> · <%= @profile.age || "—" %></span>
      <span>Gender · <%= @profile.gender || "—" %></span>
      <span><%= t("dating.looking_for") %> · <%= @profile.looking_for || "—" %></span>
    </p>
  </article>

  <article>
    <p class="profile-meta">
      <span>
        Location · <%= @profile.location.presence || "—" %>
        <% if @profile.neighborhood&.name.present? %> · Bydel · <%= @profile.neighborhood.name %><% end %>
      </span>
      <span>
        Visibility ·
        <% if @profile.visible? %>
          <span class="text-visible">visible</span>
        <% else %>
          <span class="text-hidden">hidden</span>
        <% end %>
      </span>
    </p>
  </article>

  <article>
    <p class="text-sm">
      Your profile is <%= @profile.visible? ? "visible to others in your city" : "hidden — no one can see it" %>.
      <%= link_to(@profile.visible? ? "Hide profile" : "Show profile", edit_profile_path, class: "link-inherit") %>.
    </p>
  </article>
</section>
