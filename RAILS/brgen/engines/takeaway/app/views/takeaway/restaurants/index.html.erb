<% content_for :title, t("storefront.restaurants") %>

<%= render "takeaway/nav_bar", active: "restaurants", live: true, hidden_fields: { cuisine: params[:cuisine] } %>

<%# Kaufland.de's front page, measured at 1440 and 400, dressed for kitchens:
    the campaign banner in --font-ad, the category shortcut rail as the
    cuisines, then the tile grid. The banner states what the surface is, a
    menu and order demo, because that is the true campaign. %>
<%# A div, not a header: main > header h1 is the page-title rule, and it would
    shrink the campaign line to a page title. %>
<% promo = if @promo_restaurant
             Shared::PromotionalArt.build(
               product: @promo_menu_item&.name || @promo_restaurant.name,
               headline: t("takeaway.promo_headline"),
               body: t("takeaway.promo_body", restaurant: @promo_restaurant.name),
               price: @promo_menu_item&.price_display,
               badge: @promo_restaurant.cuisine_type,
               cta: t("takeaway.promo_cta")
             )
           end %>

<% if promo %>
  <%= render "shared/promotional_art",
        art: promo,
        image_url: (@promo_menu_item&.photo&.attached? ? main_app.url_for(@promo_menu_item.photo.variant(:card)) : nil),
        url: restaurant_path(@promo_restaurant) %>
<% else %>
  <div class="store-hero store-hero--alone">
    <%= tag.h1 t("takeaway.order_food") %>
    <%= tag.p t("takeaway.intro") %>
  </div>
<% end %>

<%= live_search_results frame_id: "takeaway-restaurants", results_partial: "takeaway/restaurants/live_search_results",
      label: t("search.restaurants_label"), target: StorefrontSearch::RESULTS, suggestions: StorefrontSearch::SUGGESTIONS %>
