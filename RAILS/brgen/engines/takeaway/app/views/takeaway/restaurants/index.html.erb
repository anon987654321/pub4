<% content_for :title, t("storefront.restaurants") %>

<%= render "takeaway/nav_bar", active: "restaurants" %>

<%# Kaufland.de's front page, measured at 1440 and 400, dressed for kitchens:
    the campaign banner in --font-ad, the category shortcut rail as the
    cuisines, then the tile grid. The banner states what the surface is, a
    menu and order demo, because that is the true campaign. %>
<%# A div, not a header: main > header h1 is the page-title rule, and it would
    shrink the campaign line to a page title. %>
<div class="store-hero store-hero--alone" data-visitor-orientation>
  <%= tag.h1 t("takeaway.order_food") %>
  <%= tag.p t("takeaway.intro") %>
  <%= tag.p safe_join([ tag.strong(number_with_delimiter(@pagy&.count.to_i)), t("takeaway.restaurant_count_suffix", count: @pagy&.count.to_i) ], " "),
            class: "store-hero-count" %>
  <%= link_to t("storefront.add_restaurant"), new_restaurant_path, class: "store-cta" if authenticated? %>
</div>

<%= live_search_index url: restaurants_path, results_partial: "takeaway/restaurants/live_search_results", placeholder: t("search.restaurants"), label: t("search.restaurants_label"), frame_id: "takeaway-restaurants" do |f| %>
  <%= f.hidden_field :cuisine, value: params[:cuisine] if params[:cuisine].present? %>
<% end %>
