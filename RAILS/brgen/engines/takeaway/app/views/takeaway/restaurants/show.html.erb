<% content_for :title, @restaurant.name %>
<% content_for :head, robots_meta(index: false) if @restaurant.demo? %>
<% content_for :description, meta_description_for(@restaurant) %>
<% content_for :json_ld, json_ld_for(@restaurant, type: :local_business) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [t("storefront.restaurants"), restaurants_url],
      [@restaurant.name, seo_canonical_url]
    ])) %>

<%= render "takeaway/nav_bar", active: "restaurants" %>

<%# Kaufland.de's product page, measured at 1440 and 400, for a kitchen: the
    breadcrumb, a picture beside a white buy box, then the menu as the tile
    grid. The picture is the first dish that has one; a restaurant has no
    photograph of its own, so without a dish photo the well carries its
    initial. The buy box leads on the delivery fee, the figure a hungry reader
    compares, where Kaufland leads on the price. %>
<nav class="store-breadcrumb" aria-label="<%= t("storefront.breadcrumb") %>">
  <%= link_to t("storefront.restaurants"), restaurants_path %>
  <%= link_to @restaurant.cuisine_type, restaurants_path(cuisine: @restaurant.cuisine_type) if @restaurant.cuisine_type.present? %>
  <%= tag.span @restaurant.name, aria: { current: "page" } %>
</nav>

<div class="store-pdp">
  <div class="store-pdp-media">
    <% dish = @menu_items.find { |item| item.photo.attached? } %>
    <div class="deal-card-img">
      <% if dish %>
        <%= responsive_image_tag dish.photo, alt: dish.name, widths: [ 720, 1_200 ], sizes: "(max-width: 768px) 100vw, 780px" %>
      <% else %>
        <div class="deal-card-placeholder" aria-hidden="true"><%= @restaurant.name.to_s.first&.upcase %></div>
      <% end %>
    </div>
  </div>

  <div class="store-pdp-info">
    <div class="page-header">
      <%= tag.h1 @restaurant.name %>
      <% if authenticated? && @restaurant.owner?(Current.user) %>
        <nav aria-label="<%= t("takeaway.restaurant_actions") %>">
          <%= link_to t("actions.edit"), edit_restaurant_path(@restaurant), class: "btn btn-ghost btn-sm" %>
        </nav>
      <% end %>
    </div>
    <% if @restaurant.reviews_count.to_i.positive? %>
      <%= render "shared/store_stars", rating: @restaurant.rating, count: @restaurant.reviews_count %>
    <% end %>

    <section class="store-buybox" aria-label="<%= t("takeaway.restaurant_info") %>">
      <p class="store-buybox-price"><small><%= t("takeaway.delivery_label") %></small> <%= @restaurant.delivery_fee_display %></p>
      <p><%= @restaurant.cuisine_type %> · <%= @restaurant.address %>, <%= @restaurant.city_label %></p>
      <%# t(count:) goes through the locale's own plural rules. %>
      <p><%= t("takeaway.min_order_short", min: @restaurant.min_order_display) %> · <%= t("takeaway.saves", count: @restaurant.favorites.size) %></p>
      <% if @restaurant.place.present? %>
        <p><%= link_to t("maps.on_the_map"), record_public_href(@restaurant.place) %></p>
      <% end %>
      <div class="listing-buy-bar-actions">
        <%= link_to t("takeaway.browse_menu"), "#menu", class: "btn btn-primary" %>
        <% if Current.user.present? && !@restaurant.owner?(Current.user) %>
          <% if @favorited %>
            <%# destructive: no-confirm-ok — reversible — the button becomes Save again in place %>
            <%= button_to t("takeaway.unsave"), restaurant_favorite_restaurant_path(@restaurant), method: :delete, class: "btn" %>
          <% else %>
            <%= button_to t("takeaway.save_restaurant"), restaurant_favorite_restaurant_path(@restaurant), method: :post, class: "btn" %>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</div>

<% if @restaurant.description.present? %>
  <section class="store-pdp-description" aria-label="<%= t("takeaway.restaurant_info") %>">
    <%= tag.p @restaurant.description %>
  </section>
<% end %>

<% if authenticated? && @restaurant.owner?(Current.user) %>
  <section aria-labelledby="add-menu-item-heading">
    <%= tag.h2 t("takeaway.add_menu_item"), id: "add-menu-item-heading", class: "store-heading" %>
    <div class="form-wrap">
      <%= form_with scope: :takeaway_menu_item, url: restaurant_menu_items_path(@restaurant) do |f| %>
        <div class="field"><%= f.text_field :name, placeholder: t("takeaway.item_name"), aria: { label: t("takeaway.item_name") }, required: true %></div>
        <div class="field"><%= f.number_field :price_cents, placeholder: t("takeaway.item_price"), aria: { label: t("takeaway.item_price") }, required: true, inputmode: "numeric" %></div>
        <div class="field"><%= f.text_field :description, placeholder: t("takeaway.item_description"), aria: { label: t("takeaway.item_description") } %></div>
        <div class="field field--check"><%= f.check_box :available, checked: true %><%= f.label :available %></div>
        <div class="field field--check"><%= f.check_box :vegetarian %><%= f.label :vegetarian %></div>
        <div class="field field--check"><%= f.check_box :vegan %><%= f.label :vegan %></div>
        <div class="field"><%= f.submit t("takeaway.add"), class: "btn btn-primary btn-sm" %></div>
      <% end %>
    </div>
  </section>
<% end %>

<%= render "takeaway/restaurants/menu" %>

<section class="store-reviews" aria-labelledby="reviews-heading">
  <%= tag.h2 t("takeaway.reviews_heading"), id: "reviews-heading", class: "store-heading" %>
  <% if @reviews.any? %>
    <% @reviews.each do |r| %>
      <article>
        <%= render "shared/store_stars", rating: r.rating %>
        <p class="deal-meta"><%= r.user&.display_name || t("takeaway.anon") %> · <%= time_ago(r.created_at) %></p>
        <% if r.body.present? %><p><%= r.body %></p><% end %>
      </article>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_reviews"),
          body: t("empty.order_then_rate"),
          action: { label: t("takeaway.browse_menu"), path: restaurant_path(@restaurant, anchor: "menu") } %>
  <% end %>
</section>

<%= render "shared/also_nearby", items: @nearby_restaurants, title: t("takeaway.nearby_restaurants") %>

<% if @can_review %>
<section>
  <%= tag.h2 t("takeaway.leave_review") %>
  <%= form_with scope: :takeaway_review, url: restaurant_reviews_path(@restaurant) do |f| %>
    <div class="field">
      <%= f.label :rating, t("takeaway.rating") %>
      <%= f.number_field :rating, min: 1, max: 5, required: true, inputmode: "numeric" %>
    </div>
    <div class="field">
      <%= f.label :body, t("takeaway.comments_optional") %>
      <div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :body, rows: 3 , maxlength: 1000, data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div>
    </div>
    <div class="field"><%= f.submit t("marketplace.post_review"), class: "btn btn-primary btn-sm" %></div>
  <% end %>
</section>
<% end %>
