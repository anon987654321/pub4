<% content_for :title, t("takeaway.delivery_drivers") %>

<div class="page-header" role="banner" aria-label="<%= t("aria.delivery_drivers_header") %>">
  <hgroup>
    <p><%= t("takeaway.operations") %></p>
    <%= tag.h1 t("takeaway.delivery_drivers") %>
  </hgroup>
</div>

<% if @delivery_drivers.any? %>
  <div class="order-list" role="list" aria-label="<%= t("aria.delivery_drivers") %>">
    <% @delivery_drivers.each do |driver| %>
      <% label = driver.user&.display_name || "anon" %>
      <%= render "shared/feed_card",
        name: label,
        meta: "#{driver.vehicle_type.presence || t("takeaway.vehicle_unset")} · #{driver.available? ? t("takeaway.available") : t("takeaway.unavailable")}",
        content: (driver.location? ? "#{driver.current_lat}, #{driver.current_lng}" : nil),
        url: delivery_driver_path(driver),
        class: "takeaway" %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_drivers"),
        body: t("takeaway.drivers_empty_body"),
        action: { label: t("takeaway.nearby_restaurants"), path: restaurants_path } %>
<% end %>
