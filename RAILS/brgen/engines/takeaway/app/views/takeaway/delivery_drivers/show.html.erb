<% content_for :title, t("takeaway.delivery_driver") %>

<div class="page-header" role="banner" aria-label="<%= t("takeaway.driver_header") %>">
  <hgroup>
    <p><%= t("takeaway.operations") %></p>
    <%= tag.h1 @delivery_driver.user&.display_name || t("takeaway.anon") %>
  </hgroup>
  <%= link_to t("actions.all_drivers"), delivery_drivers_path, class: "btn btn-ghost btn-sm" %>
</div>

<article role="article" aria-label="<%= t("takeaway.driver_details") %>">
  <p><%= @delivery_driver.vehicle_type.presence || t("takeaway.vehicle_unset") %> · <%= @delivery_driver.available? ? t("takeaway.available") : t("takeaway.unavailable") %></p>
  <% if @delivery_driver.location? && Current.user && Current.user.id == @delivery_driver.user_id %>
    <p><%= @delivery_driver.current_lat %>, <%= @delivery_driver.current_lng %></p>
  <% end %>
</article>

<% if authenticated? && Current.user == @delivery_driver.user %>
  <%= form_with model: @delivery_driver, url: delivery_driver_path(@delivery_driver), scope: :delivery_driver, method: :patch do |form| %>
    <div class="field">
      <%= form.label :vehicle_type %>
      <%= form.select :vehicle_type, Takeaway::DeliveryDriver::VEHICLE_TYPES.map { |type| [type.humanize, type] }, include_blank: true %>
    </div>
    <div class="field">
      <%= form.label :available %>
      <%= form.check_box :available %>
    </div>
    <div class="field"><%= form.text_field :license_number, placeholder: t("takeaway.license_number"), aria: { label: t("takeaway.license_number") } %></div>
    <div class="field"><%= form.text_field :current_lat, placeholder: t("takeaway.latitude"), aria: { label: t("takeaway.latitude") } %></div>
    <div class="field"><%= form.text_field :current_lng, placeholder: t("takeaway.longitude"), aria: { label: t("takeaway.longitude") } %></div>
    <%= form.submit t("takeaway.update"), class: "btn btn-primary btn-sm" %>
  <% end %>
<% end %>
