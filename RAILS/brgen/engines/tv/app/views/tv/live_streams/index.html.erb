<% content_for :title, t("tv.live_streams.title", default: "Live streams") %>

<%= tag.section class: "tv-live-streams", role: "region", "aria-label": "Live streams" do %>
  <%= tag.header do %>
    <%= tag.h1 t("tv.live_streams.title", default: "Live streams") %>
  <% end %>

  <turbo-frame aria-live="polite" id="tv-live-streams" data-turbo-action="replace">
  <%= tag.div class: "live-stream-grid", role: "list", "aria-label": "Live streams list" do %>
    <% @live_streams.each do |live_stream| %>
      <%= render "shared/feed_card",
        name: live_stream.title,
        meta: live_stream.status,
        content: live_stream.description,
        url: live_stream_path(live_stream),
        class: "tv" %>
    <% end %>
    <% if @live_streams.empty? %>
      <%= render "shared/empty_state",
            title: t("empty.no_live_streams"),
            body: "Nothing live right now.",
            action: { label: t("actions.tv_home"), path: root_path } %>
    <% end %>
  <% end %>
  </turbo-frame>
<% end %>
