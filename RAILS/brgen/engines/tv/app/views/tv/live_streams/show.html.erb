<% content_for :title, @live_stream.title %>
<% content_for :json_ld, json_ld_for(@live_stream, type: :video) %>

<%= tag.article class: "tv-live-stream" do %>
  <%= tag.header class: "page-header" do %>
    <%= tag.h1 @live_stream.title %>
    <%= tag.span @live_stream.status, class: "live-badge" %>
  <% end %>

  <div data-controller="tv-player" data-tv-player-auto-wake-lock-value="true">
    <div class="tv-media">
      <% thumb = @live_stream.channel&.banner %>
      <% if thumb&.attached? %>
        <%= image_tag main_app.url_for(thumb), class: tv_media_image_classes(thumb), alt: @live_stream.title, width: 1280, height: 720 %>
      <% else %>
        <div class="tv-media-image repligen-hero" role="img" aria-label="<%= @live_stream.title %>"></div>
      <% end %>
    </div>
  </div>

  <%= tag.section class: "live-stream-details" do %>
    <%= tag.p @live_stream.description if @live_stream.description.present? %>
    <%= tag.p t("tv.live_streams.viewers", count: @live_stream.viewer_count, default: "%{count} viewers") %>
  <% end %>

  <%= tag.section class: "live-stream-chat" do %>
    <%= tag.h2 t("tv.live_streams.chat", default: "Chat") %>
    <%= turbo_stream_from "tv:live_stream:#{@live_stream.id}:entries" %>
    <%= tag.div id: "tv-live-stream-#{@live_stream.id}-entries" do %>
      <%= render partial: "tv/stream_chats/stream_chat", collection: @stream_chats, as: :stream_chat %>
    <% end %>
    <% if authenticated? %>
      <%= form_with url: live_stream_stream_chats_path(@live_stream), scope: :stream_chat, data: { turbo: true } do |f| %>
        <%= f.text_field :message, placeholder: t("playlist.say_something"), aria: { label: t("playlist.say_something") }, required: true %>
        <%= f.submit t("actions.send"), class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
