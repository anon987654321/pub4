<% content_for :title, @show.title %>
<% content_for :json_ld, json_ld_for(@show, type: :tv_series) %>

<div class="page-header" role="banner">
  <h1><%= @show.title %></h1>
  <p class="dim"><%= @show.description %></p>
</div>

<h2><%= t("tv.episodes") %></h2>
<% if @episodes.any? %>
  <ul class="episode-list">
    <% @episodes.each do |ep| %>
      <li>
        <%= link_to channel_show_episode_path(@channel, @show, ep.number), class: "episode-link" do %>
          <strong><%= t("tv.episode_line", number: ep.number, title: ep.title) %></strong>
          <% if ep.video %>
            <span class="chip"><%= ep.video.duration_formatted %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("empty.no_episodes"),
        body: t("empty.episodes_when_published"),
        action: { label: t("tv.back_to_channel"), path: channel_path(@channel) } %>
<% end %>
