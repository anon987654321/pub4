<% content_for :title, t("tv.channels_title") %>

<div class="page-header">
  <%= tag.h1 t("tv.channels_title") %>
  <nav aria-label="TV channel actions">
    <%= link_to "New channel", new_channel_path, class: "btn btn-primary btn-sm" if authenticated? %>
  </nav>
</div>

<%= live_search_index url: channels_path, results_partial: "tv/channels/live_search_results", placeholder: t("search.tv"), label: t("search.tv_label"), frame_id: "tv-channels" %>
