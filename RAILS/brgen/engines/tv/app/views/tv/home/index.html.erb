<% content_for :title, "Brgen TV" %>

<div class="page-header" role="banner" aria-label="TV header" data-visitor-orientation>
  <div>
    <h1>Brgen TV</h1>
    <p class="dim"><%= t("tv.home_blurb") %></p>
  </div>
  <div>
    <%= link_to "All channels", channels_path, class: "btn btn-ghost" %>
    <% if authenticated? %><%= link_to "Create channel", new_channel_path, class: "btn" %><% end %>
  </div>
</div>

<% if @live.any? %>
  <section role="region" aria-label="<%= t("tv.live_streams_label") %>">
    <h2><%= t("tv.live_now") %></h2>
    <% @live.each do |b| %>
      <%= render "shared/feed_card",
        name: b.title,
        handle: b.channel.name,
        content: tag.span(t("tv.live_badge"), class: "live-badge"),
        url: channel_path(b.channel),
        class: "tv" %>
    <% end %>
  </section>
<% end %>

<section role="region" aria-label="Trending content">
  <h2>Trending</h2>
  <% if @trending.any? %>
    <%= render "tv/home/trending_videos" %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_trending"),
          body: "Check back as channels publish.",
          action: { label: "All channels", path: channels_path } %>
  <% end %>
</section>

<section role="region" aria-label="Recent content">
  <h2>Recent</h2>
  <%= render partial: "tv/videos/tv_video", collection: @recent, as: :tv_video %>
</section>
