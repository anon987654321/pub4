<% content_for :title, "#{@show.title} - Episode #{@episode.number}" %>

<div class="page-header">
  <h1><%= @show.title %> — Episode <%= @episode.number %></h1>
  <%= tag.h2 @episode.title %>
</div>

<% if @video %>
  <div class="video-player" data-controller="tv-player">
    <%= render "tv/videos/tv_video", video: @video %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: "Video coming soon",
        body: "This episode is not ready to play.",
        action: { label: "Back to show", path: channel_show_path(@channel, @show) } %>
<% end %>

