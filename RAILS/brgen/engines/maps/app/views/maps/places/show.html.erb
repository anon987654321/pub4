<% content_for :title, @place.name %>
<% content_for :description, meta_description_for(@place) %>
<% content_for :json_ld, json_ld_for(@place, type: :local_business) %>
<% content_for :og_image, seo_image_url(@place.photo) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [t("maps.map"), root_url],
      [@place.name, request.original_url.split("?").first]
    ])) %>

<div class="page-header">
  <%= tag.h1 @place.name %>
  <nav aria-label="<%= t("aria.place_navigation") %>">
    <%= link_to t("actions.back"), :back, class: "btn" %>
  </nav>
</div>

<article class="place" aria-label="<%= t("aria.place_information") %>">
  <% if @place.photo.attached? %>
    <figure class="place-hero">
      <%= responsive_image_tag(@place.photo, alt: @place.name, class: "place-hero__image") %>
    </figure>
  <% end %>
  <dl role="list">
    <% if @place.address.present? %>
      <dt>Address</dt>
      <%= tag.dd @place.address %>
    <% end %>
    <dt>Type</dt>
    <%= tag.dd @place.kind %>
    <% if @place.city %>
      <dt>City</dt>
      <%= tag.dd @place.city.name %>
    <% end %>
    <% if @place.neighborhood %>
      <dt>Neighborhood</dt>
      <%= tag.dd @place.neighborhood.name %>
    <% end %>
    <dt>Coordinates</dt>
    <dd><%= @place.latitude %>, <%= @place.longitude %></dd>
  </dl>

  <p>
    <%= link_to t("maps.open_in_map"),
        "https://www.openstreetmap.org/?mlat=#{@place.latitude}&mlon=#{@place.longitude}#map=16/#{@place.latitude}/#{@place.longitude}",
        class: "btn", target: "_blank", rel: "noopener" %>
    <%# PlacesController#check_in asks for require_user_session -- the gate that
        means "any identity, guests included". Gating the form on authenticated?
        hid it from exactly the visitors that gate exists to admit. %>
    <% if authenticated? || guest? %>
      <% unless @checked_in %>
        <%= form_with url: check_in_place_path(@place), method: :post, local: true, html: { style: "display:inline" } do |f| %>
          <%= f.text_field :note, placeholder: t("maps.optional_note"), aria: { label: t("maps.optional_note") }, class: "field--grow" %>
          <%= f.submit t("maps.check_in"), class: "btn" %>
        <% end %>
      <% else %>
        <p><%= t("maps.checked_in_recently") %></p>
      <% end %>
    <% end %>
  </p>

  <% if @place.restaurants.active.any? || @place.stores.active.any? %>
    <section>
      <%= tag.h2 t("maps.at_this_place") %>
      <ul>
        <% @place.restaurants.active.limit(8).each do |restaurant| %>
          <li><%= link_to restaurant.name, record_public_href(restaurant) %> · <%= t("nav.takeaway", default: "takeaway") %></li>
        <% end %>
        <% @place.stores.active.limit(8).each do |store| %>
          <li><%= link_to store.name, record_public_href(store) %> · <%= t("nav.marketplace", default: "marketplace") %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "shared/also_nearby", items: @nearby_places, title: t("maps.nearby_places", default: "Nearby") %>

  <% if @recent_check_ins.any? %>
    <section>
      <%= tag.h2 t("maps.recent_check_ins") %>
      <ul>
        <% @recent_check_ins.each do |check_in| %>
          <li>
            <%= check_in.user.display_name %>
            <% if check_in.note.present? %> — <%= check_in.note %><% end %>
            · <time datetime="<%= check_in.checked_in_at.iso8601 %>"><%= time_ago(check_in.checked_in_at) %></time>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</article>
