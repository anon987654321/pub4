<% listing = local_assigns.fetch(:listing) %>
<% favorited = local_assigns.fetch(:favorited) {
     Current.user.present? && listing.favorite_for(Current.user).present?
   } %>
<% if Current.user.present? %>
  <% if favorited %>
    <%# destructive: no-confirm-ok — reversible — the listing is favourited again from the same button %>
    <%= button_to listing_favorite_path(listing),
          method: :delete,
          class: "deal-fav deal-fav--on",
          form: { class: "deal-fav-form", data: { turbo: true } },
          aria: { label: "Remove from saved", pressed: true } do %>
      <%= icon :like, size: 18 %>
    <% end %>
  <% else %>
    <%= button_to listing_favorite_path(listing),
          method: :post,
          class: "deal-fav",
          form: { class: "deal-fav-form", data: { turbo: true } },
          aria: { label: "Save listing", pressed: false } do %>
      <%= icon :like, size: 18 %>
    <% end %>
  <% end %>
<% end %>
