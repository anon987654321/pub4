<% content_for :title, @listing.title %>
<% content_for :description, meta_description_for(@listing) %>
<% content_for :json_ld, json_ld_for(@listing, type: :product) %>
<% content_for :og_type, "product" %>
<% content_for :og_image, seo_image_url(@listing.photos.first) %>
<% content_for :json_ld, json_ld_script(breadcrumb_json_ld([
      [t("marketplace.home_title", city: city_name), listings_url],
      [@listing.title, request.original_url.split("?").first]
    ])) %>

<div class="page-header marketplace-listing-header">
  <hgroup>
    <p><%= t("marketplace.listing_kicker", category: @listing.category&.name || t("marketplace.listing")) %></p>
    <%= tag.h1 @listing.title %>
  </hgroup>
  <nav role="navigation" aria-label="<%= t("aria.listing_actions") %>" class="marketplace-actions">
    <% if Current.user.present? && Current.user == @listing.user %>
      <%= link_to t("actions.edit"), edit_listing_path(@listing), class: "btn btn-ghost btn-sm" %>
    <% elsif Current.user.present? %>
      <%= render "marketplace/listings/favorite_button",
            listing: @listing,
            favorited: @listing.favorite_for(Current.user).present? %>
    <% end %>
  </nav>
</div>

<%= render "shared/media_gallery", attachments: @listing.photos, title: @listing.title %>

<article class="marketplace-listing">
  <p class="listing-price"><%= @listing.price_display %></p>
  <% if @listing.sold? %>
    <p class="listing-status"><%= t("marketplace.sold_notice") %></p>
  <% elsif @listing.expired? %>
    <p class="listing-status"><%= t("marketplace.expired_notice") %></p>
    <% if Current.user.present? && Current.user == @listing.user %>
      <%= button_to t("marketplace.renew"), renew_listing_path(@listing), method: :post, class: "btn btn-primary btn-sm" %>
    <% end %>
  <% end %>
  <p><%= [(@listing.condition.present? ? t("marketplace.conditions.#{@listing.condition}", default: @listing.condition) : nil), @listing.location, @listing.user&.display_name || "anon"].compact.join(" · ") %></p>
  <p><%= t("marketplace.views", count: @listing.views_count.to_i) %> · <%= t("marketplace.saves", count: @listing.favorites.size) %> · <%= t("marketplace.reviews_count", count: @listing.reviews_count.to_i) %></p>
  <% if @listing.reviews_count.to_i.positive? %>
    <p><%= t("marketplace.seller_rating", rating: number_with_precision(@listing.rating, precision: 1)) %></p>
  <% end %>
  <div class="listing-description"><%= read_more(@listing.description, lines: 6, more: t("actions.read_more"), less: t("actions.read_less")) %></div>
  <button class="btn-share" data-controller="share"
          data-share-title-value="<%= @listing.title %>"
          data-share-url-value="<%= request.original_url %>"
          data-action="click->share#share"><%= t("marketplace.share") %></button>
  <%# seller can read back nil: User is acts_as_tenant-scoped on city, so a
      seller with no city (or another city) is invisible under this tenant and
      the association returns nil. Without this guard the != test passes and
      main_app.user_conversations_path(nil) raises UrlGenerationError, 500ing the whole
      listing page. %>
  <% seller = @listing.user %>
  <% if @listing.buyable? && Current.user.present? && seller.present? && Current.user != seller %>
    <div class="listing-actions listing-actions--inline">
      <%= button_to t("marketplace.message_seller_btn"), main_app.user_conversations_path(seller), method: :post, class: "btn btn-ghost" %>
    </div>
  <% end %>
  <%= render "shared/affiliate_disclosure" %>
</article>

<%= render "shared/also_nearby", items: @nearby_listings, title: t("marketplace.nearby_listings", default: "Nearby") %>

<%= render "marketplace/listings/questions", listing: @listing, questions: @questions, question_form: @question %>

<div class="section-divider">
  <p class="section-heading--md"><%= t("marketplace.reviews") %></p>
  <% if @review %>
    <div class="form-wrap form-wrap--flush">
      <%= form_with(model: @review, url: listing_reviews_path(@listing)) do |f| %>
        <div class="field"><%= f.label :rating %><%= f.select :rating, options_for_select((1..5).map { |n| [ "#{n} ★", n ] }) %></div>
        <div class="field"><%= f.label :body %><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :body, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></div>
        <div class="field"><%= f.submit t("marketplace.post_review"), class: "btn btn-primary" %></div>
      <% end %>
    </div>
  <% end %>
  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <article>
        <strong><%= number_with_precision(review.rating, precision: 0) %> ★</strong>
         — <%= review.user&.display_name || "anon" %>
        <%= simple_format(review.body) if review.body.present? %>
      </article>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
          title: t("empty.no_reviews"),
          body: t("marketplace.no_reviews_body"),
          action: { label: t("marketplace.browse_listings"), path: listings_path } %>
  <% end %>
</div>

<% if Current.user.present? && Current.user != @listing.user && @listing.buyable? %>
  <div id="make-offer" class="section-divider">
    <p class="section-heading--md"><%= t("marketplace.make_offer", default: "Make an offer") %></p>
    <p><%= t("marketplace.message_seller_hint") %></p>
    <div class="form-wrap form-wrap--flush">
      <% draft_key = "brgen-marketplace-order-#{@listing.to_param}-new" %>
      <%= form_with(model: @order, url: listing_orders_path(@listing), data: { controller: "draft-store autosave", "draft-store-key-value": draft_key, **autosave_data(key: draft_key, url: main_app.draft_path(draft_key)) }) do |f| %>
        <div class="field"><div data-controller="character-counter" data-character-counter-countdown-value="true">
  <%= f.text_area :message, placeholder: t("marketplace.message_seller"), aria: { label: t("marketplace.message_seller") }, rows: 3 , data: { character_counter_target: "input" } %>
  <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
</div></div>
        <% if @variants.present? %>
          <%# A listing with sizes is bought by the size: an order naming none is
              one the seller cannot pack, and the model refuses it. %>
          <div class="field">
            <%= f.label :variant_id, t("marketplace.choose_variant") %>
            <%= f.select :variant_id,
                  @variants.map { |variant| [ "#{variant.label} — #{variant.price_display}", variant.id ] },
                  { include_blank: t("marketplace.choose_variant_blank") } %>
          </div>
        <% end %>
        <div class="field"><%= f.submit t("marketplace.send_offer"), class: "btn btn-primary" %> <span data-autosave-target="status" aria-live="polite"></span></div>
      <% end %>
    </div>
  </div>
<% end %>

<% if Current.user.present? && Current.user == @listing.user %>
  <div class="section-divider">
    <p class="section-heading--md"><%= t("marketplace.seller_dashboard") %></p>
    <div class="chips">
      <span class="chip"><%= t("marketplace.views", count: @listing.views_count.to_i) %></span>
      <span class="chip"><%= t("marketplace.offers") %>: <%= @listing.orders.size %></span>
      <span class="chip"><%= t("marketplace.saves", count: @listing.favorites.size) %></span>
      <span class="chip"><%= @listing.status %></span>
      <%= link_to t("marketplace.variants"), listing_variants_path(@listing), class: "chip" %>
    </div>
  </div>

  <div class="section-divider">
    <p class="section-heading--md"><%= t("marketplace.offers") %></p>
    <% if @listing.orders.any? %>
      <% @listing.orders.includes(:buyer).each do |order| %>
        <article>
          <%= tag.strong order.buyer&.display_name || "anon" %>
           — <%= order.status %>
          <% if order.message.present? %><%= tag.p order.message %><% end %>
          <% if order.status == "pending" %>
            <div class="cluster mt-8">
              <%= button_to t("marketplace.accept"), listing_order_path(@listing, order), params: { accept: true }, method: :patch, class: "btn btn-primary btn-sm" %>
              <%= button_to t("marketplace.decline"), listing_order_path(@listing, order), params: { decline: true }, method: :patch, class: "btn btn-ghost btn-sm" %>
            </div>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <%= render "shared/empty_state",
            title: t("empty.no_offers"),
            body: t("marketplace.no_offers_body"),
            action: { label: t("marketplace.edit_listing"), path: edit_listing_path(@listing) } %>
    <% end %>
    <%= button_to t("marketplace.remove_listing"), listing_path(@listing), method: :delete,
        data: { turbo_confirm: t("marketplace.confirm_remove_listing") }, class: "btn btn-danger btn-sm m-16" %>
  </div>
<% end %>

<%= render "marketplace/listings/buy_bar" %>
