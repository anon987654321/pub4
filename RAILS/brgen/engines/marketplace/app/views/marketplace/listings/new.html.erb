<% content_for :title, t("marketplace.new_listing") %>

<div class="page-header">
  <%= tag.h1 t("marketplace.new_listing") %>
  <p><%= t("marketplace.casual_hint") %></p>
</div>

<turbo-frame id="marketplace-new-listing" data-turbo-action="replace">
  <div class="form-wrap marketplace-listing-form-wrap">
    <%= form_with model: @listing, url: listings_path,
          html: { role: "form", "aria-label": t("marketplace.new_listing_form") },
          data: {
            controller: "listing-form draft-store form-submit",
            action: "submit->form-submit#lock input->listing-form#refresh change->listing-form#refresh",
            form_submit_blank: t("feed.compose_blank"),
            "draft-store-key-value": "brgen-marketplace-listing-new-#{@kind}",
            "listing-form-untitled-value": t("marketplace.untitled_listing"),
            "listing-form-price-unset-value": t("marketplace.price_not_set"),
            "listing-form-condition-unset-value": t("marketplace.condition_not_set"),
            "listing-form-location-unset-value": t("marketplace.location_not_set"),
            "listing-form-person-value": t("marketplace.from_a_person"),
            "listing-form-photo-prompt-value": t("marketplace.most_successful_photos"),
            "listing-form-location-unavailable-value": t("marketplace.location_unavailable"),
            "listing-form-locating-value": t("marketplace.locating"),
            "listing-form-location-pinned-value": t("marketplace.location_pinned"),
            "listing-form-location-denied-value": t("marketplace.location_denied"),
            "listing-form-draft-saved-value": t("marketplace.draft_saved")
          } do |f| %>
      <%= render "shared/errors", object: @listing %>

      <nav class="listing-steps" aria-label="<%= t("marketplace.listing_steps_label") %>" data-listing-form-target="steps">
        <% %w[photos details location review].each_with_index do |step, index| %>
          <button type="button" class="listing-step-link<%= " is-active" if index.zero? %>"
                  data-listing-form-target="stepLink"
                  data-step="<%= index %>"
                  data-action="click->listing-form#goTo">
            <span><%= index + 1 %></span>
            <%= t("marketplace.listing_steps.#{step}") %>
          </button>
        <% end %>
      </nav>

      <%= f.hidden_field :kind, value: @kind %>

      <fieldset class="listing-step" data-listing-form-target="section" data-step="0">
        <legend><%= t("marketplace.listing_steps.photos") %></legend>
        <div class="listing-photo-entry">
          <div class="field" data-controller="media-picker direct-upload"
               data-media-picker-cover-label-value="<%= t("marketplace.cover_photo") %>"
               data-media-picker-remove-label-value="<%= t("marketplace.remove_photo") %>"
               data-media-picker-move-label-value="<%= t("marketplace.move_photo") %>"
               data-media-picker-guidance-key-value="brgen-marketplace-photo-guidance">
            <%= f.file_field :photos,
                  multiple: true,
                  accept: "image/*",
                  capture: "environment",
                  direct_upload: true,
                  class: "media-input-hidden",
                  aria: { label: t("marketplace.add_photos") },
                  data: { media_picker_target: "input", action: "change->media-picker#pick" } %>
            <button type="button" class="listing-photo-camera media-btn"
                    data-action="click->media-picker#trigger">
              <%= icon :camera, size: 28 %>
              <span><%= t("marketplace.take_photo") %></span>
              <small><%= t("marketplace.photo_camera_hint") %></small>
            </button>
            <button type="button" class="listing-photo-gallery"
                    data-action="click->media-picker#trigger">
              <%= t("marketplace.upload_from_gallery") %>
            </button>

            <aside class="listing-photo-guidance"
                   data-media-picker-target="guidance"
                   aria-label="<%= t("marketplace.photo_guidance_label") %>">
              <span><%= t("marketplace.photo_guidance") %></span>
              <button type="button" class="listing-photo-guidance-dismiss"
                      data-action="click->media-picker#dismissGuidance"
                      aria-label="<%= t("marketplace.dismiss_guidance") %>">×</button>
            </aside>

            <div class="media-preview listing-media-preview"
                 data-media-picker-target="preview"
                 aria-live="polite"></div>
            <p class="form-help listing-photo-hint" data-listing-form-target="photoHint" hidden></p>
            <%= render "shared/preset_strip", f: f %>
          </div>

          <div class="field listing-video-field">
            <%= f.label :video, t("marketplace.optional_video") %>
            <%= f.file_field :video,
                  accept: "video/mp4,video/webm,video/quicktime",
                  capture: "environment",
                  direct_upload: true,
                  class: "media-input-hidden",
                  data: { action: "change->listing-form#previewVideo" } %>
            <button type="button" class="listing-photo-gallery"
                    data-action="click->listing-form#triggerVideo">
              <%= t("marketplace.add_short_video") %>
            </button>
            <div data-listing-form-target="videoPreview"></div>
          </div>
        </div>
        <div class="listing-step-actions">
          <button type="button" class="btn btn-primary" data-action="click->listing-form#next">
            <%= t("marketplace.continue") %>
          </button>
        </div>
      </fieldset>

      <fieldset class="listing-step" data-listing-form-target="section" data-step="1">
        <legend><%= t("marketplace.listing_steps.details") %></legend>

        <div class="field">
          <span class="field-label"><%= t("marketplace.kind_label") %></span>
          <nav class="listing-kinds" aria-label="<%= t("marketplace.kinds_label") %>">
            <% Marketplace::Listing::KINDS.each do |kind| %>
              <%= link_to t("marketplace.kinds.#{kind}"), new_listing_path(kind: kind),
                    class: "chip#{' active' if @kind == kind}",
                    aria: { current: (@kind == kind ? "page" : nil) } %>
            <% end %>
          </nav>
        </div>

        <div class="field">
          <%= f.label :title %>
          <%= f.text_field :title, required: true, maxlength: 200, autocomplete: "off",
                data: { listing_form_target: "title" } %>
        </div>

        <% if @kind == "goods" %>
          <div class="field">
            <%= f.label :price_cents, t("marketplace.price_ore") %>
            <%= f.number_field :price_cents, min: 0, inputmode: "numeric", required: true,
                  data: { listing_form_target: "price" } %>
            <p class="form-help"><%= t("marketplace.price_help") %></p>
          </div>

          <div class="field">
            <%= f.label :condition, t("marketplace.condition") %>
            <%= f.select :condition,
                  Marketplace::Listing::CONDITIONS.map { |value| [t("marketplace.conditions.#{value}"), value] },
                  {}, required: true, data: { listing_form_target: "condition" } %>
            <p class="form-help"><%= t("marketplace.condition_help") %></p>
          </div>

          <div class="field">
            <span class="field-label"><%= t("marketplace.source") %></span>
            <div class="listing-source-choice">
              <label class="listing-source-option">
                <%= f.radio_button :source, "person", checked: @listing.store_id.blank? %>
                <span><%= t("marketplace.from_a_person") %></span>
              </label>
              <% if @stores.any? %>
                <label class="listing-source-option">
                  <%= f.radio_button :source, "shop", checked: @listing.store_id.present? %>
                  <span><%= t("marketplace.from_a_shop") %></span>
                </label>
                <%= f.collection_select :store_id, @stores, :id, :name,
                      { include_blank: t("marketplace.choose_shop") },
                      { data: { listing_form_target: "store" } } %>
              <% end %>
            </div>
          </div>
        <% end %>

        <details class="advanced-fields listing-more-details">
          <summary><%= t("marketplace.more_details") %></summary>
          <div class="field">
            <%= f.label :description %>
            <div data-controller="character-counter" data-character-counter-countdown-value="true">
              <%= f.text_area :description, rows: 4, data: { character_counter_target: "input" } %>
              <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
            </div>
          </div>

          <% if @kind == "job" %>
            <%= f.fields_for :job_detail do |jf| %>
              <div class="field"><%= jf.label :employer, t("marketplace.job_employer") %><%= jf.text_field :employer, maxlength: 120 %></div>
              <div class="field"><%= jf.label :employment_type, t("marketplace.job_type") %><%= jf.select :employment_type, Marketplace::JobDetail::EMPLOYMENT_TYPES.map { |type| [t("marketplace.employment_types.#{type}"), type] }, include_blank: "—" %></div>
              <div class="field"><%= jf.label :salary_min_cents, t("marketplace.job_salary_min") %><%= jf.number_field :salary_min_cents, min: 0, inputmode: "numeric" %></div>
              <div class="field"><%= jf.label :salary_max_cents, t("marketplace.job_salary_max") %><%= jf.number_field :salary_max_cents, min: 0, inputmode: "numeric" %></div>
              <div class="field field--check"><%= jf.label :remote, t("marketplace.job_remote") %><%= jf.check_box :remote %></div>
            <% end %>
          <% elsif @kind == "housing" %>
            <%= f.fields_for :housing_detail do |hf| %>
              <div class="field"><%= hf.label :rent_cents, t("marketplace.housing_rent") %><%= hf.number_field :rent_cents, min: 0, required: true, inputmode: "numeric" %></div>
              <div class="field"><%= hf.label :deposit_cents, t("marketplace.housing_deposit") %><%= hf.number_field :deposit_cents, min: 0, inputmode: "numeric" %></div>
              <div class="field"><%= hf.label :housing_type, t("marketplace.housing_type") %><%= hf.select :housing_type, Marketplace::HousingDetail::HOUSING_TYPES.map { |type| [t("marketplace.housing_types.#{type}"), type] }, include_blank: "—" %></div>
              <div class="field"><%= hf.label :rooms, t("marketplace.housing_rooms") %><%= hf.number_field :rooms, min: 0.5, step: 0.5, inputmode: "decimal" %></div>
              <div class="field"><%= hf.label :size_sqm, t("marketplace.housing_size") %><%= hf.number_field :size_sqm, min: 1, inputmode: "numeric" %></div>
              <div class="field"><%= hf.label :available_from, t("marketplace.housing_available") %><%= hf.date_field :available_from %></div>
            <% end %>
          <% elsif @kind == "gig" %>
            <%= f.fields_for :gig_detail do |gf| %>
              <div class="field"><%= gf.label :pay_cents, t("marketplace.gig_pay") %><%= gf.number_field :pay_cents, min: 0, inputmode: "numeric" %></div>
              <div class="field"><%= gf.label :starts_at, t("marketplace.gig_starts") %><%= gf.datetime_field :starts_at %></div>
              <div class="field"><%= gf.label :hours, t("marketplace.gig_hours") %><%= gf.number_field :hours, min: 0.5, step: 0.5, inputmode: "decimal" %></div>
            <% end %>
          <% end %>
        </details>

        <div class="listing-step-actions">
          <button type="button" class="btn btn-ghost" data-action="click->listing-form#back"><%= t("marketplace.back") %></button>
          <button type="button" class="btn btn-primary" data-action="click->listing-form#next"><%= t("marketplace.continue") %></button>
        </div>
      </fieldset>

      <fieldset class="listing-step" data-listing-form-target="section" data-step="2">
        <legend><%= t("marketplace.listing_steps.location") %></legend>

        <div class="field">
          <%= f.label :category_id, t("marketplace.category") %>
          <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: "—" }, required: true %>
        </div>

        <div class="field">
          <%= f.label :location %>
          <div class="listing-location-row">
            <%= f.text_field :location, required: true, autocomplete: "street-address" %>
            <button type="button" class="btn btn-ghost" data-action="click->listing-form#useLocation">
              <%= t("marketplace.use_current_location") %>
            </button>
          </div>
          <span class="form-help" data-listing-form-target="locationStatus" aria-live="polite"></span>
        </div>

        <% if @kind == "goods" %>
          <div class="field">
            <%= f.label :delivery_promise, t("marketplace.delivery_estimate") %>
            <%= f.select :delivery_promise,
                  Marketplace::Listing::DELIVERY_PROMISES.map { |key, value| [t("marketplace.delivery_promise.#{key}"), value] },
                  {}, required: true %>
          </div>
          <div class="field">
            <%= f.label :fulfilment_method, t("marketplace.fulfilment_method") %>
            <%= f.select :fulfilment_method,
                  Marketplace::Listing::FULFILMENT_METHODS.map { |key, value| [t("marketplace.fulfilment_methods.#{key}"), value] },
                  {}, required: true %>
          </div>
        <% end %>

        <details class="advanced-fields">
          <summary><%= t("marketplace.precise_coordinates") %></summary>
          <div class="field"><%= f.label :latitude %><%= f.number_field :latitude, step: "0.000001", min: -90, max: 90, inputmode: "decimal" %></div>
          <div class="field"><%= f.label :longitude %><%= f.number_field :longitude, step: "0.000001", min: -180, max: 180, inputmode: "decimal" %></div>
        </details>

        <div class="listing-step-actions">
          <button type="button" class="btn btn-ghost" data-action="click->listing-form#back"><%= t("marketplace.back") %></button>
          <button type="button" class="btn btn-primary" data-action="click->listing-form#next"><%= t("marketplace.continue") %></button>
        </div>
      </fieldset>

      <fieldset class="listing-step" data-listing-form-target="section" data-step="3">
        <legend><%= t("marketplace.listing_steps.review") %></legend>

        <div class="listing-review-card">
          <div class="listing-review-cover" data-listing-form-target="reviewCover" aria-hidden="true">
            <%= @listing.title.to_s.first&.upcase || "?" %>
          </div>
          <div>
            <p class="listing-review-title" data-listing-form-target="reviewTitle"><%= @listing.title.presence || t("marketplace.untitled_listing") %></p>
            <% if @kind == "goods" %>
              <p data-listing-form-target="reviewPrice"><%= @listing.price_cents.present? ? Shared::MoneyDisplay.format(@listing.price_cents, @listing.currency || "NOK") : t("marketplace.price_not_set") %></p>
              <p data-listing-form-target="reviewCondition"><%= @listing.condition_label || t("marketplace.condition_not_set") %></p>
            <% end %>
            <p data-listing-form-target="reviewLocation"><%= @listing.location.presence || t("marketplace.location_not_set") %></p>
            <% if @kind == "goods" %>
              <p data-listing-form-target="reviewSource"><%= @listing.store_id.present? ? t("marketplace.from_a_shop") : t("marketplace.from_a_person") %></p>
            <% end %>
          </div>
        </div>

        <div class="listing-draft-row">
          <button type="button" class="btn btn-ghost" data-action="click->listing-form#saveDraft"><%= t("marketplace.save_draft") %></button>
          <span class="form-help" data-listing-form-target="draftStatus" aria-live="polite"></span>
        </div>

        <div class="listing-step-actions">
          <button type="button" class="btn btn-ghost" data-action="click->listing-form#back"><%= t("marketplace.back") %></button>
          <%= f.submit t("marketplace.list_it"), class: "btn btn-primary" %>
        </div>
      </fieldset>
    <% end %>
  </div>
</turbo-frame>
