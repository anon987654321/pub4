<% market_title = t("marketplace.home_title", city: city_name) %>
<% content_for :title, market_title %>
<% content_for :json_ld, json_ld_script(item_list_schema(@listings, title: market_title)) if @listings.any? %>

<%# The kind and a pinned position ride on the header field, so a search
    of the jobs list stays on jobs and "near me" survives the next keystroke. %>
<%= render "marketplace/nav_bar",
      active: "listings",
      search_url: listings_path,
      search_placeholder: t("search.marketplace"),
      live: true,
      hidden_fields: { kind: @kind, lat: @search_lat, lng: @search_lng },
      cart_count: (Current.user.present? ? Current.user.marketplace_orders.where(status: "pending").count : 0) %>

<%# The front page opened on a hidden h1 and a seven-control filter bar: the
    densest surface in the family had no entry point and nothing to look at, and
    its only headline was invisible. Operator instruction 2026-08-17.

    Kaufland.de's teaser row, measured at 1440: a banner block two thirds wide
    and a #f5f5f5 panel beside it, 16px apart. The banner is typography rather
    than a photograph: a marketplace whose stock changes hourly has nothing
    permanent to photograph, so the city's name in --font-ad, the storefront
    promotional face, is the honest campaign. %>
<% promo_offer = @top_offers&.first %>
<% promo_deal = promo_offer if promo_offer.is_a?(Marketplace::Deal) %>
<% promo_listing = promo_deal ? promo_deal.listing : promo_offer %>
<% promo_photo = promo_listing&.photos&.first if promo_listing&.photos&.attached? %>
<% promo = if promo_listing
             Shared::PromotionalArt.build(
               product: promo_listing.title,
               headline: promo_deal&.headline.presence || t("marketplace.hero_title", city: city_name),
               body: t("marketplace.hero_lede"),
               price: promo_listing.headline_amount,
               badge: promo_deal&.badge.presence || t("marketplace.top"),
               cta: t("marketplace.promo_cta")
             )
           end %>

<section class="store-teasers" aria-labelledby="listing-kinds-title">
  <% if promo %>
    <%= render "shared/promotional_art",
          art: promo,
          image_url: (main_app.url_for(promo_photo) if promo_photo),
          url: (promo_deal ? deal_path(promo_deal) : listing_path(promo_listing)) %>
  <% end %>

  <nav class="listing-kinds store-panel" aria-labelledby="listing-kinds-title">
    <%= tag.h2 t("marketplace.kinds_label"), id: "listing-kinds-title" %>
    <% Marketplace::Listing::KINDS.each do |kind| %>
      <%= link_to t("marketplace.kinds.#{kind}"), listings_path(kind: kind),
            class: "chip#{" active" if @kind == kind}", aria: { current: (@kind == kind ? "page" : nil) } %>
    <% end %>
  </nav>
</section>

<% active_filters = [ params[:from], params[:category_id], params[:condition],
                      params[:min_price], params[:max_price], @search_lat ].count(&:present?) +
                    ((params[:sort].present? && params[:sort] != "recent") ? 1 : 0) %>
<%# The drawer is not a form of its own. Its fields join the header search
    through the form attribute, so one submission carries the query and every
    filter, and a change here streams the results the way typing does. The
    links below carry the kind, or narrowing the jobs list lands back on goods. %>
<%= fields do |f| %>
  <details class="listing-filters" <%= "open" if active_filters.positive? %>>
    <%# .deal-cat, not a style of its own. This control opens the drawer holding
        the source chips, so it is a sibling of them and wears their geometry —
        a second chip vocabulary for one summary would be the schism at birth
        that btn_vocabulary exists to prevent. %>
    <summary class="deal-cat listing-filters-toggle">
      <%= t("marketplace.filters") %>
      <% if active_filters.positive? %>
        <span class="listing-filters-count"><%= active_filters %></span>
      <% end %>
    </summary>

    <div class="listing-filters-panel">
      <%# Six groups, none of them over the seven-item chunk. The source chips
          were a second horizontal scroller of their own directly under the
          kinds — the same movement offered twice, for a narrower question. %>
      <fieldset class="listing-filter-group">
        <legend><%= t("marketplace.listing_kind") %></legend>
        <div class="listing-filter-controls">
          <%= link_to t("marketplace.from_anyone"), listings_path(kind: @kind, category_id: params[:category_id], q: params[:q].presence),
                class: "deal-cat#{" active" if params[:from].blank?}" %>
          <%= link_to t("marketplace.from_a_person"), listings_path(kind: @kind, from: "person", category_id: params[:category_id], q: params[:q].presence),
                class: "deal-cat#{" active" if params[:from] == "person"}" %>
          <%= link_to t("marketplace.from_a_shop"), listings_path(kind: @kind, from: "shop", category_id: params[:category_id], q: params[:q].presence),
                class: "deal-cat#{" active" if params[:from] == "shop"}" %>
        </div>
      </fieldset>

      <fieldset class="listing-filter-group">
        <legend><%= t("marketplace.filter_category") %></legend>
        <div class="listing-filter-controls">
          <%= f.select :category_id,
                options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
                { include_blank: t("actions.all_categories") }, form: StorefrontSearch::FORM, aria: { label: t("marketplace.filter_category") } %>
        </div>
      </fieldset>

      <fieldset class="listing-filter-group">
        <%# filter_distance, not radius_label. The group holds "near me" and a
            radius, and "Radius i kilometer" names only the second of them —
            it stays as the number field's own aria-label. %>
        <legend><%= t("marketplace.filter_distance") %></legend>
        <div class="listing-filter-controls">
          <%# lat and lng are hidden fields of the header form, which is where
              geolocation#pin looks for them through this button's form. %>
          <button type="button" class="btn btn-ghost btn-sm" form="<%= StorefrontSearch::FORM %>" data-controller="geolocation" data-action="geolocation#pin">
            <%= t("marketplace.near_me") %>
          </button>
          <%= f.number_field :radius_km, value: @radius_km, min: 1, max: Marketplace::Listing::MAX_RADIUS_KM, step: 1, placeholder: t("marketplace.radius_km"), form: StorefrontSearch::FORM, aria: { label: t("marketplace.radius_label") }, inputmode: "numeric" %>
        </div>
      </fieldset>

      <fieldset class="listing-filter-group">
        <legend><%= t("marketplace.sort_label") %></legend>
        <div class="listing-filter-controls">
          <%= f.select :sort,
                options_for_select([[t("marketplace.sort_recent"), "recent"],
                                    [t("marketplace.sort_price_low"), "price_low"],
                                    [t("marketplace.sort_price_high"), "price_high"]], @sort),
                {}, form: StorefrontSearch::FORM, aria: { label: t("marketplace.sort_label") } %>
        </div>
      </fieldset>

      <fieldset class="listing-filter-group">
        <legend><%= t("marketplace.filter_price") %></legend>
        <div class="listing-filter-controls">
          <%= f.number_field :min_price, value: params[:min_price], min: 0, step: 1, placeholder: t("marketplace.min_price"), form: StorefrontSearch::FORM, aria: { label: t("marketplace.min_price") }, inputmode: "numeric" %>
          <%= f.number_field :max_price, value: params[:max_price], min: 0, step: 1, placeholder: t("marketplace.max_price"), form: StorefrontSearch::FORM, aria: { label: t("marketplace.max_price") }, inputmode: "numeric" %>
        </div>
      </fieldset>

      <%# The facets are links rather than fields, and they belong here rather
          than in a second disclosure: a reader narrowing a search does not care
          which of the two mechanisms a control happens to use. %>
      <%= render "marketplace/listings/facets", facets: @facets %>
    </div>
  </details>
<% end %>

<%= live_search_results frame_id: "marketplace-listings", results_partial: "marketplace/listings/live_search_results",
      label: t("search.marketplace_label"), target: StorefrontSearch::RESULTS, suggestions: StorefrontSearch::SUGGESTIONS %>

<% content_for :widgets do %>
  <%= render "shared/affiliate_deals", category: params[:category_id] %>
  <%= render "shared/newsletter_cta" %>
<% end %>
