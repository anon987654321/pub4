<%# Secondary marketplace IA — same feed-tab grammar as the brgen front page.

    Navigation, not a tab widget: every one of these loads a different page.
    It used to carry role="tablist"/role="tab"/aria-selected, which promises
    a tabpanel that does not exist and cost the page its navigation landmark.
    The current page is announced with aria-current, which is what a nav
    says. The visual grammar is unchanged — .feed-tab still styles it. %>
<nav class="marketplace-subnav feed-tabs" aria-label="<%= t("storefront.listings") %>">
  <%= link_to t("storefront.listings"), listings_path,
        class: "feed-tab#{" active" if local_assigns[:active].to_s == "listings"}",
        "aria-current": ("page" if local_assigns[:active].to_s == "listings") %>
  <%= link_to t("storefront.todays_deals"), deals_path,
        class: "feed-tab#{" active" if local_assigns[:active].to_s == "deals"}",
        "aria-current": ("page" if local_assigns[:active].to_s == "deals") %>
  <%= link_to t("storefront.stores"), shops_path,
        class: "feed-tab#{" active" if local_assigns[:active].to_s == "stores"}",
        "aria-current": ("page" if local_assigns[:active].to_s == "stores") %>
  <%= link_to t("storefront.cart"), cart_path,
        class: "feed-tab#{" active" if local_assigns[:active].to_s == "cart"}",
        "aria-current": ("page" if local_assigns[:active].to_s == "cart") %>
  <%= link_to t("storefront.sell"), new_listing_path, class: "feed-tab" %>
</nav>
