<%# Curated rail above the catalogue, in the tile anatomy the grid below wears:
    Kaufland.de runs its product sliders on the same tile as its grid, so a
    featured deal and a listing read as the same object. %>
<% offers = local_assigns[:offers] || @top_offers %>
<% if offers.present? %>
<section class="marketplace-top-offers" aria-labelledby="top-offers-heading">
  <%= tag.h2 t("marketplace.top_offers_heading"), id: "top-offers-heading", class: "store-heading" %>

  <%# The photos keep alt "": each sits inside a link whose visible text is the
      headline or title, and a filled alt would announce it twice. %>
  <div class="deal-grid top-offers-rail" role="list">
    <% offers.each do |offer| %>
      <% deal = offer if offer.is_a?(Marketplace::Deal) %>
      <% listing = deal ? deal.listing : offer %>
      <% photo = listing&.photos&.attached? ? listing.photos.first : nil %>
      <% title = deal ? deal.headline : listing.title %>
      <%# The badge falls back twice and both fallbacks were English literals on
          a surface that renders in Norwegian by default. deal.badge itself is
          seller copy and stays as written. %>
      <% badge = if deal
                   deal.badge.presence ||
                     (deal.discount_percent.present? ? t("marketplace.percent_off", percent: deal.discount_percent.to_i) : t("marketplace.deal"))
                 else
                   t("marketplace.top")
                 end %>
      <%= link_to (deal ? deal_path(deal) : listing_path(listing)), class: "deal-card", role: "listitem" do %>
        <%= render "marketplace/card_media", photo:, fallback_char: title.to_s.first&.upcase || "%", badge:, badge_soft: deal.nil? %>
        <div class="deal-card-body">
          <% if listing %><div class="deal-price"><%= listing.price_display %></div><% end %>
          <%= tag.h3 title, class: "deal-card-title" %>
          <% if listing %>
            <p class="deal-meta"><%= deal ? listing.title : [listing.location, listing.category&.name].compact.join(" · ") %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
<% end %>
