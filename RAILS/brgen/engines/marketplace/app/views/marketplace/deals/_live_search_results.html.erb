<% if live_search_query.present? %>
 <p class="dim"><%= t("search.results_for", count: @deals.size, query: live_search_query) %></p>
<% end %>

<% if @featured_deals&.any? && live_search_query.blank? %>
 <section class="featured-deals" aria-label="<%= t("aria.featured_deals") %>">
 <h2><%= t("marketplace.deals.featured", default: "Featured deals") %></h2>
 <div class="deal-grid deal-grid--featured">
 <% @featured_deals.each do |deal| %>
   <%= render "marketplace/deals/card", deal: deal %>
 <% end %>
 </div>
 </section>
<% end %>

<% if @deals.any? %>
<div class="deal-grid" id="marketplace-deals-grid">
 <% @deals.each do |deal| %>
   <%= render "marketplace/deals/card", deal: deal %>
 <% end %>
</div>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "DealsInfiniteScrollReflex#load_more",
           sentinel_id: "marketplace-deals-sentinel",
           q: params[:q] %>
<% else %>
 <%= render "shared/empty_state",
       title: t("empty.no_deals"),
       body: t("empty.no_deals_search"),
       action: { label: t("empty.clear_search"), path: deals_path } %>
<% end %>
