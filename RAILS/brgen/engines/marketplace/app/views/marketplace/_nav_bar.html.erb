<%# Storefront header. Was a two-row Amazon clone with stacked label/value
    blocks; flattened 2026-08-10 to read like the front page nav — one line per
    entry, plain text. Styles in _marketplace_nav_bar.scss, shared with takeaway. %>
<% active = local_assigns.fetch(:active, "listings") %>
<% search_url = local_assigns.fetch(:search_url, listings_path) %>
<% search_placeholder = local_assigns.fetch(:search_placeholder, t("search.marketplace")) %>
<% cart_count = local_assigns[:cart_count].to_i %>
<% deliver_to = local_assigns.fetch(:deliver_to, Current.city_record&.name.presence || "Bergen") %>

<div id="navBar">
  <div id="topHalf">
    <div id="logoWrapper">
      <%= link_to root_path, id: "logo", class: "marketplace-logo-link nav-hover", aria: { label: "Markedsplass" } do %>
        <span class="nav-logo-mark"><%= render "marketplace/animated_logo" %></span>
        <span class="nav-logo-word">markedsplass<span class="nav-logo-tld">.no</span></span>
      <% end %>
    </div>

    <%= link_to main_app.nearby_path, class: "nav-block nav-deliver nav-hover",
                aria: { label: "#{t("storefront.deliver_to")} #{deliver_to}" } do %>
      <%= icon :nearby, size: 13 %> <%= deliver_to %>
    <% end %>

    <div class="search marketplace-nav-search" data-controller="search-focus">
      <%= form_with url: search_url, method: :get, local: true do %>
        <input type="search" name="q" value="<%= params[:q] %>" class="nav-search-input"
               placeholder="<%= search_placeholder %>" aria-label="<%= t("search.marketplace_label") %>"
               data-action="focus->search-focus#focus blur->search-focus#blur" />
        <button type="submit" class="nav-search-submit" aria-label="<%= t("search.submit") %>"><%= icon :search, size: 20 %></button>
      <% end %>
    </div>

    <div id="accountStuff">
      <%= link_to(authenticated? ? main_app.user_path(Current.user) : main_app.new_session_path,
                  class: "nav-block nav-hover") do %>
        <%= authenticated? ? (Current.user.username.presence || t("storefront.account")) : t("storefront.sign_in") %>
      <% end %>
      <%= link_to cart_path, id: "cartLink", aria: { label: t("storefront.cart") },
                  class: "nav-block nav-cart nav-hover#{" nav-cart--active" if active == "cart"}" do %>
        <%= icon :cart, size: 20, css_class: "nav-cart-icon" %>
        <span class="nav-cart-count"><%= cart_count %></span>
      <% end %>
    </div>
  </div>

  <div id="bottomHalf">
    <div id="sections">
      <%= link_to t("storefront.listings"), listings_path, class: "section nav-hover#{" section--active" if active == "listings"}" %>
      <%= link_to t("storefront.todays_deals"), deals_path, class: "section nav-hover#{" section--active" if active == "deals"}" %>
      <%= link_to t("storefront.stores"), shops_path, class: "section nav-hover#{" section--active" if active == "stores"}" %>
      <% if authenticated? %>
        <%= link_to t("storefront.orders"), orders_path, class: "section nav-hover#{" section--active" if active == "orders"}" %>
      <% end %>
      <%= link_to t("storefront.sell"), new_listing_path, class: "section nav-hover" %>
      <%# The nav is saved searches' only way in — the index has no other link. %>
      <%= link_to t("storefront.saved_searches"), saved_searches_path,
                  class: "section nav-hover#{" section--active" if active == "saved_searches"}" if authenticated? %>
    </div>
  </div>
</div>
