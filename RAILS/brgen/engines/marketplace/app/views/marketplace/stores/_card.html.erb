<%= link_to shop_path(store.slug),
      class: "deal-card store",
      role: "listitem",
      aria: { label: store.name } do %>
  <div class="deal-card-img deal-card-img--store">
    <div class="deal-card-placeholder" aria-hidden="true">
      <%= store.name.to_s.first&.upcase || "S" %>
    </div>
    <% if store.verified? %>
      <span class="deal-badge deal-badge--soft">Verified</span>
    <% end %>
  </div>

  <div class="deal-card-body">
    <h2 class="deal-card-title"><%= store.name %></h2>
    <% if store.vertical.present? %>
      <% if store.vertical.present? %>
        <p class="deal-card-subtitle"><%= t("marketplace.verticals.#{store.vertical}") %></p>
      <% end %>
    <% end %>
    <% if store.description.present? %>
      <p class="deal-meta deal-meta--clamp"><%= store.description %></p>
    <% end %>
  </div>
<% end %>
