<% content_for :title, @store.name %>
<% content_for :description, meta_description_for(@store) %>
<% content_for :json_ld, json_ld_for(@store, type: :local_business) %>

<%= tag.section class: "marketplace-store" do %>
  <%= tag.header do %>
    <%= tag.h1 @store.name %>
    <%= tag.p t("marketplace.verticals.#{@store.vertical}") if @store.vertical.present? %>
    <%= tag.p @store.description if @store.description.present? %>
    <% if @store.place.present? %>
      <%= tag.p link_to(t("maps.on_the_map"), record_public_href(@store.place), class: "btn btn-ghost btn-sm") %>
    <% end %>
    <% if authenticated? && Current.user&.id == @store.owner_id %>
      <%= tag.nav class: "cluster" do %>
        <%= link_to t("marketplace.stores.edit", default: "Edit store"), edit_shop_path(@store.slug), class: "btn btn-ghost btn-sm" %>
        <%= link_to "Partner program", main_app.new_partner_program_path(store_id: @store.slug), class: "btn btn-ghost btn-sm" %>
        <%= button_to t("marketplace.stores.delete", default: "Delete store"), shop_path(@store.slug), method: :delete, data: { turbo_confirm: t("marketplace.stores.delete_confirm", default: "Delete store?") }, class: "btn btn-danger btn-sm" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @payouts %>
    <section aria-label="<%= t("marketplace.payouts") %>">
      <h2><%= t("marketplace.payouts") %></h2>
      <% @payouts.each do |payout| %>
        <article>
          <p><%= Shared::MoneyDisplay.format(payout.amount_cents, payout.currency) %> · <%= t("marketplace.payout_statuses.#{payout.status}") %></p>
          <% if payout.releasable? %>
            <%= button_to t("marketplace.payout_release"), shop_payouts_path(@store, payout_id: payout.id), method: :post, data: { turbo_confirm: t("marketplace.payout_release_confirm") }, class: "btn btn-sm" %>
          <% elsif payout.pending? %>
            <p><%= t("marketplace.payout_held") %></p>
          <% end %>
        </article>
      <% end %>
    </section>
  <% end %>

  <div class="deal-grid" aria-label="<%= t("aria.store_listings") %>">
    <% @listings.each do |listing| %>
      <%= render "marketplace/listings/card", listing: listing %>
    <% end %>
  </div>

  <% if @other_stores.present? %>
    <aside>
      <%= tag.h2 t("marketplace.stores.also_in_city", city: city_name) %>
      <ul>
        <% @other_stores.each do |store| %>
          <li><%= link_to store.name, shop_path(store) %></li>
        <% end %>
      </ul>
    </aside>
  <% end %>
<% end %>
