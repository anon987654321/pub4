<% content_for :title, t("marketplace.addresses") %>

<%= render "marketplace/nav_bar", active: "cart",
      search_url: listings_path, search_placeholder: t("search.marketplace") %>

<div class="page-header">
  <%= tag.h1 t("marketplace.addresses") %>
</div>

<% if @addresses.any? %>
  <ul class="address-list">
    <% @addresses.each do |address| %>
      <li class="address<%= " address--default" if address.default_address? %>">
        <%= tag.p address %>
        <% if address.default_address? %>
          <span class="chip"><%= t("marketplace.default_address") %></span>
        <% else %>
          <%= button_to t("marketplace.make_default"), address_path(address),
                method: :patch, class: "btn btn-ghost btn-sm" %>
        <% end %>
        <%= button_to t("actions.delete"), address_path(address), method: :delete,
              class: "btn btn-ghost btn-sm",
              data: { turbo_confirm: t("marketplace.confirm_delete_address") } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("marketplace.no_address_yet"),
        body: t("marketplace.add_address_body"),
        action: { label: t("marketplace.add_address"), path: "#new-address" } %>
<% end %>

<h2 id="new-address"><%= t("marketplace.add_address") %></h2>
<%= form_with model: @address, url: addresses_path, scope: :marketplace_address do |f| %>
  <p><%= f.label :recipient, t("marketplace.address_form.recipient") %><%= f.text_field :recipient, required: true, autocomplete: "name" %></p>
  <p><%= f.label :line1, t("marketplace.address_form.line1") %><%= f.text_field :line1, required: true, autocomplete: "address-line1" %></p>
  <p><%= f.label :line2, t("marketplace.address_form.line2") %><%= f.text_field :line2, autocomplete: "address-line2" %></p>
  <p><%= f.label :postcode, t("marketplace.address_form.postcode") %><%= f.text_field :postcode, required: true, autocomplete: "postal-code" %></p>
  <p><%= f.label :city_name, t("marketplace.address_form.city") %><%= f.text_field :city_name, required: true, autocomplete: "address-level2" %></p>
  <p><%= f.label :country_code, t("marketplace.address_form.country") %><%= f.text_field :country_code, required: true, maxlength: 2, autocomplete: "country" %></p>
  <p><%= f.label :phone, t("marketplace.address_form.phone") %><%= f.telephone_field :phone, autocomplete: "tel", inputmode: "tel" %></p>
  <p><%= f.submit t("marketplace.save_address"), class: "btn btn-primary" %></p>
<% end %>
