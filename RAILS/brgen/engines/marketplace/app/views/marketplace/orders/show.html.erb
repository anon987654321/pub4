<% content_for :title, "Order ##{@order.id}" %>
<%= turbo_stream_from @conversation if @conversation %>

<div class="page-header" role="banner" aria-label="<%= t("aria.order_details_header") %>">
  <h1>Order #<%= @order.id %></h1>
  <p>For <%= link_to @order.listing.title, listing_path(@order.listing) %></p>
</div>

<div class="order-meta">
  <p><strong>Status:</strong> <span class="chip"><%= @order.status %></span></p>
  <p><strong>Quantity:</strong> <%= @order.quantity %></p>
  <p><strong>Total:</strong> <%= @order.total_display %></p>
  <p><strong>Buyer:</strong> <%= @order.buyer.display_name %></p>
  <p><strong>Seller:</strong> <%= @order.seller.display_name %></p>
  <% if @order.message.present? %>
    <p><strong>Message:</strong> <%= @order.message %></p>
  <% end %>
</div>

<% if policy(@order).update? %>
  <div class="order-actions">
    <%= button_to t("marketplace.accept"), order_path(@order, accept: true), method: :patch, class: "btn" %>
    <%= button_to t("marketplace.decline"), order_path(@order, decline: true), method: :patch, class: "btn btn-ghost" %>
  </div>
<% end %>

<% if @conversation %>
  <%# section + h2, not a bare h3: the h1 above is the order, and this is the
      order's chat -- one level down, not two. The section gives the heading a
      region to name, so a screen reader can jump to the conversation. %>
  <section class="order-chat" aria-labelledby="order-chat-heading">
  <h2 id="order-chat-heading"><%= t("marketplace.chat_with", name: @order.buyer == Current.user ? @order.seller.display_name : @order.buyer.display_name) %></h2>
  <ul id="messages" role="list" aria-label="<%= t("aria.order_messages") %>">
    <% @messages.each do |m| %>
      <%= render "messages/message", message: m %>
    <% end %>
  </ul>

  <%= form_with model: @message, url: main_app.conversation_messages_path(@conversation),
                id: "new_message",
                data: {
                  turbo: true,
                  controller: "typing-input",
                  action: "keydown->typing-input#composerKeydown"
                } do |f| %>
    <div class="field" data-controller="character-counter" data-character-counter-countdown-value="true">
      <%= f.text_area :content, rows: 3,
            placeholder: t("chat.dm_placeholder"),
            enterkeyhint: "send",
            aria: { label: t("chat.message_label") },
            data: { character_counter_target: "input" } %>
      <span class="char-counter" data-character-counter-target="counter" aria-live="polite"></span>
    </div>
    <%= f.hidden_field :message_type, value: "text" %>
    <p><%= f.submit t("actions.send"), class: "btn btn-primary" %></p>
  <% end %>
  </section>
<% end %>
