<% content_for :title, t("marketplace.orders.title", default: "Your orders") %>

<header class="page-header" role="banner">
  <h1><%= t("marketplace.orders.title", default: "Your orders") %></h1>
</header>

<% if @orders.any? %>
  <ul class="order-list">
    <% @orders.each do |order| %>
      <li class="order-row">
        <%= link_to order, class: "order-link" do %>
          <span class="order-title"><%= order.listing&.title || t("marketplace.orders.listing", default: "Listing") %></span>
        <% end %>
        <span class="order-status chip"><%= order.try(:status) %></span>
        <time datetime="<%= order.created_at.iso8601 %>" class="dim"><%= time_ago_in_words(order.created_at) %> ago</time>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= render "shared/empty_state",
        title: t("marketplace.orders.empty_title", default: "No orders yet"),
        body: t("marketplace.orders.empty_body", default: "Your marketplace orders will show up here.") %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
