<% content_for :title, t("marketplace.orders.title", default: "Your orders") %>

<header class="page-header" role="banner">
  <%= tag.h1 t("marketplace.orders.title", default: "Your orders") %>
</header>

<% if @orders.any? %>
  <ul class="order-list">
    <% @orders.each do |order| %>
      <li class="order-row">
        <%= link_to order, class: "order-link" do %>
          <span class="order-title"><%= order.listing&.title || t("marketplace.orders.listing", default: "Listing") %></span>
        <% end %>
        <span class="order-status chip"><%= order.try(:status) %></span>
        <time datetime="<%= order.created_at.iso8601 %>" class="dim"><%= time_ago(order.created_at) %></time>
      </li>
    <% end %>
  </ul>
<% else %>
  <%# The empty case is the common one for a new account, and it was a page with
      nothing to do on it — the state NO_DEAD_ENDS names. Somebody with no orders
      wants listings, so the empty state hands them the listings. %>
  <%= render "shared/empty_state",
        title: t("marketplace.orders.empty_title"),
        body: t("marketplace.orders.empty_body"),
        action: { label: t("marketplace.orders.empty_action"), path: listings_path } %>
<% end %>

<%= render "shared/pager", pagy: @pagy %>
