<% content_for :title, @item&.localized(:name) || t("menu.title") %>
<% content_for :description, @item.localized(:description) if @item&.localized(:description).present? %>

<%# MenuController#item provides @item with its options (ordered, in @options).
    The item sheet is one form posting to add_item_cart: option chips
    (toppings = salatbar, sauces, priced extras), qty stepper, note, sticky
    price — item_sheet_controller caps sauces at two and recalculates the
    sticky total live. %>
<% item = @item %>

<article class="sheet" data-turbo-frame="_top">
  <header class="sheet-head">
    <% if (picture = food_picture(item, size: 320, class: "sheet-photo")) %>
      <%= picture %>
    <% else %>
      <span class="sheet-emoji" aria-hidden="true"><%= item.emoji %></span>
    <% end %>
    <hgroup>
      <%= tag.h1 item.localized(:name), class: "sheet-name" %>
      <%# The other language's name rides beneath, as on the menu board. %>
      <% other_name = I18n.locale == :en ? item.name : item.name_en %>
      <%= tag.p other_name if other_name.present? && other_name != item.localized(:name) %>
    </hgroup>
    <p class="sheet-facts">
      <%= origin_chip(item) %>
      <% if item.weight_g.to_i.positive? %>
        <%= tag.span "#{item.weight_g} g", class: "badge badge-weight" %>
      <% end %>
      <%= heat_dots(item) %>
      <%= badge_tags(item) %>
    </p>
  </header>

  <%= tag.p item.localized(:description), class: "sheet-description" if item.localized(:description).present? %>
  <% if item.origin.present? %>
    <p class="origin-story"><%= t(origin_story_key(item.origin)) %></p>
  <% end %>

  <%# Allergens before purchase (matinformasjonsforskriften); see MenuItem::ALLERGENS. %>
  <%= tag.section class: "sheet-allergens", aria: { labelledby: "allergens_title" } do %>
    <%= tag.h2 t("menu.allergens.title"), id: "allergens_title" %>
    <%= tag.p allergen_text(item) %>
  <% end %>

  <%= form_with url: add_item_cart_path, method: :post, class: "sheet-form",
        data: { controller: "item-sheet",
                item_sheet_base_value: item.price_ore,
                item_sheet_max_value: Cart::MAX_QUANTITY,
                item_sheet_template_value: t("menu.add_with_price"),
                item_sheet_sauce_limit_value: t("menu.sauce_limit_reached") } do |f| %>

    <%= f.hidden_field :menu_item_id, value: item.id %>

    <% option_groups = {
         "topping" => t("menu.salatbar"),
         "sauce" => t("menu.sauces"),
         "extra" => t("menu.extras")
       } %>
    <% option_groups.each do |kind, heading| %>
      <% options = @options.select { |option| option.kind == kind } %>
      <% next if options.empty? %>
      <fieldset class="option-group">
        <legend>
          <%= heading %>
          <% if kind != "extra" %><span class="badge"><%= t("menu.free") %></span><% end %>
          <%= tag.span t("menu.sauce_limit", count: Cart::MAX_SAUCES), class: "legend-note" if kind == "sauce" %>
        </legend>
        <div class="option-chips">
          <% options.each do |option| %>
            <label class="option-chip" for="option_<%= option.id %>">
              <%= check_box_tag "option_ids[]", option.id, option.default_on?,
                    id: "option_#{option.id}",
                    data: { item_sheet_target: "option",
                            kind: kind,
                            price_ore: option.price_ore.to_i,
                            action: "change->item-sheet#recalc" } %>
              <%= tag.span option.localized(:name), class: "option-name" %>
              <% if option.price_ore.to_i.positive? %>
                <span class="option-price">+<%= money(option.price_ore) %></span>
              <% end %>
            </label>
          <% end %>
        </div>
        <% if kind == "sauce" %>
          <%= tag.p "", class: "visually-hidden", "aria-live": "polite",
                data: { item_sheet_target: "sauceNotice" } %>
        <% end %>
      </fieldset>
    <% end %>

    <fieldset class="option-group">
      <legend><%= t("menu.qty") %></legend>
      <div class="quantity-stepper">
        <button type="button" class="quantity-button" data-action="item-sheet#decrease" aria-label="<%= t("cart.decrease") %>">−</button>
        <%= number_field_tag :quantity, 1, min: 1, max: Cart::MAX_QUANTITY, inputmode: "numeric",
              class: "quantity-input", aria: { label: t("menu.qty") },
              data: { item_sheet_target: "quantity", action: "input->item-sheet#recalc" } %>
        <button type="button" class="quantity-button" data-action="item-sheet#increase" aria-label="<%= t("cart.increase") %>">+</button>
      </div>
    </fieldset>

    <div class="field">
      <%= label_tag :note, t("menu.note") %>
      <%= text_field_tag :note, nil, placeholder: t("menu.note_placeholder") %>
    </div>

    <p class="sheet-total">
      <span><%= t("menu.total") %></span>
      <strong data-item-sheet-target="price"><%= money(item.price_ore) %></strong>
    </p>

    <footer class="sheet-footer">
      <%= f.submit t("menu.add_with_price", price: money(item.price_ore)),
            class: "button button-primary",
            data: { item_sheet_target: "submit" } %>
    </footer>
  <% end %>
</article>
