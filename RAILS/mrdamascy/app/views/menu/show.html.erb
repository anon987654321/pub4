<% content_for :title, t("menu.title") %>
<%= restaurant_json_ld(@kitchen, @categories) if @kitchen %>

<%# MenuController#show provides @kitchen, @categories (available_items with
    their options) and @last_order. This view only presents. %>

<section class="hero">
  <%= image_tag "/icon.svg", alt: "", class: "hero-mark" %>
  <p class="hero-greeting" aria-hidden="true"><%= t("app.greeting") %></p>
  <h1 class="hero-title"><%= t("app.tagline") %></h1>
  <% if @kitchen %>
    <p class="hero-meta">
      <%= tag.span render("shared/icons/khatam", size: 13), class: "hero-rating", aria: { hidden: true } %>
      <%= number_with_precision(@kitchen.rating, precision: 1) %> · <%= @kitchen.localized_opening_hours %>
    </p>
  <% end %>
  <%# The zones' own cheapest fee and slowest promise, once any exist. %>
  <% if @min_delivery_fee_ore && @max_eta_minutes %>
    <%= tag.p t("menu.delivery_facts", fee: money(@min_delivery_fee_ore), eta: @max_eta_minutes), class: "hero-meta" %>
  <% else %>
    <%= tag.p t("menu.zone_note"), class: "hero-meta" %>
  <% end %>
</section>

<% if @last_order && @last_order.order_items.any? %>
  <section class="reorder-card card">
    <div class="reorder-copy">
      <h2 class="reorder-title"><%= t("menu.reorder") %></h2>
      <%= tag.p t("menu.last_order") %>
      <ul class="fact-list">
        <% @last_order.order_items.each do |line| %>
          <li><%= line.quantity %>× <%= line.name %></li>
        <% end %>
      </ul>
    </div>
    <%= button_to t("menu.reorder_cta"), reorder_cart_path, params: { order_id: @last_order.id },
          class: "button button-reorder" %>
  </section>
<% end %>

<%# category_spy marks the chip of the section in view (aria-current). %>
<nav class="category-chips" aria-label="<%= t("menu.categories") %>" data-controller="category-spy">
  <% @categories.each do |category| %>
    <%= link_to "#cat-#{category.slug}", class: "chip", data: { category_spy_target: "chip" } do %>
      <%= tag.span category.emoji, aria: { hidden: true } %> <%= category.localized(:name) %>
    <% end %>
  <% end %>
</nav>

<% @categories.each do |category| %>
  <section class="menu-section" id="<%= "cat-#{category.slug}" %>">
    <h2 class="section-title">
      <%= tag.span category.emoji, aria: { hidden: true } %> <%= category.localized(:name) %>
    </h2>
    <% category.available_items.each do |item| %>
      <%= render "shared/item_card", item: item %>
    <% end %>
  </section>
<% end %>
