<% content_for :title, t("loyalty.title") %>

<%# LoyaltyController#show provides @stamp_slots (10), @unredeemed, @earned and
    @free_wrap_ready. Filled stars = unredeemed stamps; the 10th stamp IS the
    reward, so 9 filled already means the next wrap is on the house. %>
<% filled_display = [@unredeemed.to_i, @stamp_slots.to_i].min %>

<section class="loyalty-card">
  <p class="loyalty-brand">
    <%= image_tag "/icon.svg", alt: "", class: "loyalty-mark" %>
    <%= t("loyalty.title") %>
  </p>

  <ol class="loyalty-stars" aria-hidden="true">
    <% @stamp_slots.times do |slot| %>
      <%= tag.li class: ["loyalty-star", ("loyalty-star-stamped" if slot < filled_display)] %>
    <% end %>
  </ol>

  <p class="loyalty-progress">
    <% if current_user.nil? %>
      <%= t("loyalty.progress.remaining", count: @stamp_slots) %>
    <% elsif @free_wrap_ready %>
      <%= t("loyalty.progress.ready") %>
    <% else %>
      <%= t("loyalty.progress.remaining", count: @stamp_slots - filled_display) %>
    <% end %>
  </p>
  <% if current_user %>
    <%= tag.p t("loyalty.filled", count: filled_display, total: @stamp_slots) %>
  <% end %>
</section>

<% if current_user.nil? %>
  <section class="card loyalty-login">
    <%= tag.p t("loyalty.login_hint") %>
    <%= link_to t("auth.login"), new_session_path, class: "button button-primary" %>
  </section>
<% end %>

<section class="card loyalty-rules-card">
  <h2 class="section-title"><%= t("loyalty.how_title") %></h2>
  <ul class="loyalty-rules">
    <li><%= t("loyalty.rule_one") %></li>
    <li><%= t("loyalty.rule_two") %></li>
    <li><%= t("loyalty.rule_three") %></li>
  </ul>
  <%= link_to t("loyalty.cta"), root_path, class: "button button-primary" %>
</section>
