<% content_for :title, t("auth.title") %>

<%# Phone-first login (§6): POST /session/request_code sends the mock OTP,
    then POST session (session_path) verifies and signs in. Dev notice shows
    the fixed mock code; sessions#create also accepts the phone param kept
    alongside the code. %>

<section class="card auth-card">
  <h1 class="page-title"><%= t("auth.title") %></h1>
  <%= tag.p t("auth.blurb") %>

  <% if current_user %>
    <p class="auth-status">
      <%= t("auth.logged_in_as", name: current_user.name.presence || current_user.phone) %>
    </p>
    <%= button_to t("auth.logout"), session_path, method: :delete %>
  <% else %>
    <%# Fastest path first (§12): Vipps verifies the phone and hands back
        name + address — no OTP, no forms. The SMS fallback stays below. %>
    <%= link_to t("auth.vipps_login"), session_vipps_path, class: "button button-vipps" %>
    <%= tag.p t("auth.or_sms"), class: "login-or" %>

    <%= form_with url: "/session/request_code", method: :post, class: "auth-form" do %>
      <div class="field">
        <%= label_tag :phone, t("auth.phone") %>
        <%= telephone_field_tag :phone, params[:phone],
              required: true,
              inputmode: "numeric",
              autocomplete: "tel-national",
              placeholder: t("auth.phone_placeholder") %>
      </div>
      <%= tag.button t("auth.send_code"), type: "submit", class: "button-primary" %>
    <% end %>

    <%# In development SessionsController#request_code flashes the mock code
        as a notice — it renders through shared/_toast. No standing mock-code
        paragraph here: it would leak the OTP in every other environment. %>

    <%= form_with url: session_path, method: :post, class: "auth-form" do %>
      <%= hidden_field_tag :phone, params[:phone] %>
      <div class="field">
        <%= label_tag :code, t("auth.code") %>
        <%= text_field_tag :code, nil,
              required: true, maxlength: 4, pattern: "[0-9]{4}",
              inputmode: "numeric",
              autocomplete: "one-time-code",
              placeholder: t("auth.code_placeholder") %>
      </div>
      <%= tag.button t("auth.verify"), type: "submit", class: "button-primary" %>
    <% end %>
  <% end %>
</section>
