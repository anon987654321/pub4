<% content_for :title, "#{t("orders.title")} · ##{@order&.id}" %>

<%# OrdersController#show provides @order with order_items. %>
<% order = @order %>

<header class="order-head">
  <%= tag.span t("orders.states.#{order.state}"), class: "state-chip state-#{order.state}" %>
  <%= tag.span t("orders.payment_state.#{order.payment_state}"), class: "badge badge-plain" if order.payment_state.present? %>
  <% if order.payment_steps.to_i == 3 %>
    <span class="badge badge-gold"><%= t("orders.paid_steps") %></span>
  <% end %>
  <% if order.placed_at.present? %>
    <p class="ink-soft margin-bottom-0">#<%= order.id %> · <%= t("orders.placed_at", time: order.placed_at.strftime("%d.%m %H:%M")) %></p>
  <% end %>
</header>

<section class="card">
  <h2 class="section-title"><%= t("orders.items_title") %></h2>
  <ul class="order-lines-list">
  <% order.order_items.each do |line| %>
    <li class="order-line row-between">
      <span class="row">
        <span aria-hidden="true"><%= line.emoji %></span>
        <span>
          <strong><%= line.quantity %>× <%= line.name %></strong>
          <% if line.options_text.present? %>
            <span class="ink-soft line-options"><%= line.options_text %></span>
          <% end %>
        </span>
      </span>
      <strong><%= money(line.line_total_ore) %></strong>
    </li>
  <% end %>
  </ul>

  <p class="order-delivery margin-top-16 margin-bottom-0">
    <% if order.delivery_mode == "pickup" %>
      <%= render "shared/mode_icon", mode: "pickup" %> <%= t("orders.pickup_at") %>
    <% else %>
      <%= render "shared/mode_icon", mode: "delivery" %> <%= t("orders.delivery_to") %>
      <%= tag.span order.address, class: "nowrap" %> <%= tag.span order.postcode, class: "nowrap" %>
    <% end %>
  </p>
</section>

<dl class="card totals margin-top-16">
  <dt><%= t("orders.subtotal") %></dt>
  <dd><%= money(order.subtotal_ore) %></dd>
  <% if order.delivery_fee_ore.to_i.positive? && order.delivery_mode != "pickup" %>
    <dt><%= t("orders.delivery_fee") %></dt>
    <dd><%= money(order.delivery_fee_ore) %></dd>
  <% end %>
  <% if order.discount_ore.to_i.positive? %>
    <dt class="totals-discount"><%= t("orders.discount") %></dt>
    <dd class="totals-discount">−<%= money(order.discount_ore) %></dd>
  <% end %>
  <% if order.tip_ore.to_i.positive? %>
    <dt><%= t("orders.tip_line") %></dt>
    <dd><%= money(order.tip_ore) %></dd>
  <% end %>
  <dt class="totals-strong"><%= t("orders.total") %></dt>
  <dd class="totals-strong"><%= money(order.total_ore) %></dd>
</dl>

<% if order.tracking_token.present? %>
  <%= link_to t("orders.track"), track_path(order.tracking_token), class: "button button-primary button-block margin-top-16" %>
<% end %>
<%= link_to t("orders.back"), orders_path, class: "button button-block margin-top-8" %>
