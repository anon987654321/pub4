<% content_for :title, "#{t("orders.title")} · ##{@order&.id}" %>

<%# OrdersController#show provides @order with order_items. %>
<% order = @order %>

<header class="order-head">
  <%= tag.span t("orders.states.#{order.state}"), class: "state-chip state-#{order.state}" %>
  <% if order.payment_state.present? %>
    <%= tag.span t("orders.payment_state.#{order.payment_state}"), class: "badge badge-payment" %>
  <% end %>
  <% if order.payment_steps.to_i == 3 %>
    <%= tag.span t("orders.paid_steps", steps: order.payment_steps), class: "badge badge-paid-steps" %>
  <% end %>
  <% if order.placed_at.present? %>
    <p>
      #<%= order.id %> ·
      <%= tag.time t("orders.placed_at", when: order.placed_at.strftime("%d.%m %H:%M")),
            datetime: order.placed_at.iso8601 %>
    </p>
  <% end %>
</header>

<section class="card">
  <h2 class="section-title"><%= t("orders.items_title") %></h2>
  <ul class="order-lines-list">
  <% order.order_items.each do |line| %>
    <li class="order-line">
      <%= tag.span line.emoji, aria: { hidden: true } %>
      <span>
        <%= tag.strong "#{line.quantity}× #{line.name}" %>
        <%= tag.span line.options_text, class: "line-options" if line.options_text.present? %>
      </span>
      <%= tag.strong money(line.line_total_ore) %>
    </li>
  <% end %>
  </ul>

  <p class="order-delivery">
    <% if order.delivery_mode == "pickup" %>
      <%= render "shared/mode_icon", mode: "pickup" %>
      <%= t("orders.pickup_at", address: current_kitchen&.address) %>
    <% else %>
      <%= render "shared/mode_icon", mode: "delivery" %>
      <%= t("orders.delivery_to", address: [order.address, order.postcode].compact_blank.join(" ")) %>
    <% end %>
  </p>
</section>

<dl class="card totals">
  <dt><%= t("orders.subtotal") %></dt>
  <dd><%= money(order.subtotal_ore) %></dd>
  <% if order.delivery_fee_ore.to_i.positive? && order.delivery_mode != "pickup" %>
    <dt><%= t("orders.delivery_fee") %></dt>
    <dd><%= money(order.delivery_fee_ore) %></dd>
  <% end %>
  <% if order.discount_ore.to_i.positive? %>
    <dt class="totals-discount"><%= t("orders.discount") %></dt>
    <dd class="totals-discount">−<%= money(order.discount_ore) %></dd>
  <% end %>
  <% if order.tip_ore.to_i.positive? %>
    <dt><%= t("orders.tip_line") %></dt>
    <dd><%= money(order.tip_ore) %></dd>
  <% end %>
  <%= tag.dt t("orders.total"), class: "totals-sum" %>
  <%= tag.dd money(order.total_ore), class: "totals-sum" %>
</dl>

<%= tag.nav class: "page-actions", aria: { label: t("orders.title") } do %>
  <% if order.tracking_token.present? %>
    <%= link_to t("orders.track"), track_path(order.tracking_token), class: "button button-primary" %>
  <% end %>
  <%= link_to t("orders.back"), orders_path, class: "button" %>
<% end %>
