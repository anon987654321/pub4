<% content_for :title, t("orders.track_title") %>

<%# Public tracking by token (OrdersController#track provides @order).
    5-step timeline with 8-point star milestones; track_controller polls
    /track/:token/status every 10s and reloads on state change. %>
<% order = @order %>
<% steps = %w[placed confirmed preparing ready delivered] %>
<%# picked_up sits between ready and delivered; the timeline keeps everything
    through ready lit so progress never visually resets mid-courier. %>
<% current_index = order.state == "picked_up" ? 3 : steps.index(order.state) %>

<section class="track-head card"
     data-controller="track"
     data-track-token-value="<%= order.tracking_token %>"
     data-track-state-value="<%= order.state %>"
     data-track-eta-template-value="<%= t("orders.eta") %>">

  <h1 class="page-title"><%= t("orders.track_title") %></h1>
  <% mode_key = order.delivery_mode == "pickup" ? "checkout.mode_pickup" : "checkout.mode_delivery" %>
  <%= tag.p "##{order.id} · #{t(mode_key)}" %>

  <% if order.state == "cancelled" %>
    <p class="track-cancelled"><%= t("orders.states.cancelled") %></p>
  <% else %>
    <% if order.eta_minutes.present? && order.state != "delivered" %>
      <p class="track-eta" data-track-target="eta">
        <%= t("orders.eta", eta: order.eta_minutes) %>
      </p>
    <% end %>

    <ol class="timeline" data-track-target="steps">
      <% steps.each_with_index do |step, index| %>
        <%= tag.li class: ["step", ("step-done" if current_index && index <= current_index)],
              aria: { current: ("step" if current_index == index) }, data: { state: step } do %>
          <span class="step-star" aria-hidden="true"></span>
          <%= tag.span t("orders.states.#{step}"), class: "step-label" %>
        <% end %>
      <% end %>
    </ol>

    <% if order.state == "picked_up" %>
      <p class="courier-line"><%= render "shared/mode_icon", mode: "delivery" %> <%= t("orders.courier_line") %></p>
    <% end %>
  <% end %>
</section>

<% if order.state == "delivered" %>
  <section class="card">
    <h2 class="section-title"><%= t("orders.tip_title") %></h2>
    <div class="tip-choices">
      <%= button_to t("orders.tip_none"), order_tip_path(order.tracking_token),
            method: :post, params: { tip_ore: 0 } %>
      <%= button_to t("orders.tip_20"), order_tip_path(order.tracking_token),
            method: :post, params: { tip_ore: 2000 } %>
      <%= button_to t("orders.tip_40"), order_tip_path(order.tracking_token),
            method: :post, params: { tip_ore: 4000 } %>
    </div>

    <%= tag.h2 t("orders.review_title"), class: "section-title" %>
    <%= form_with url: order_review_path(order.id), class: "review-form" do %>
      <div class="field">
        <%= label_tag :rating, t("orders.review_stars") %>
        <%= select_tag :rating,
              options_for_select([["★★★★★", 5], ["★★★★", 4], ["★★★", 3], ["★★", 2], ["★", 1]]),
              prompt: t("orders.review_prompt") %>
      </div>
      <div class="field">
        <%= label_tag :body, t("orders.review_body") %>
        <%= text_area_tag :body, nil, placeholder: t("orders.review_body_placeholder") %>
      </div>
      <%= tag.button t("orders.review_submit"), type: "submit", class: "button-primary" %>
    <% end %>

    <%= tag.p t("orders.thanks"), class: "thanks-line" %>
  </section>
<% end %>
