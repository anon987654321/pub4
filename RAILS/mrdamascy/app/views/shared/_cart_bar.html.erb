<%# Pay-bar fixed above the tab bar: "Kurv · 3 varer · 387 kr → Betal".
    Rendered from the layout on every page (which passes cart_count and
    cart_total_ore); CartsController turbo-streams a fresh copy after
    quick-adds, and cart_bar_controller pulses it. Hidden on the
    cart/checkout pages (they have their own CTAs) via body class CSS. %>
<% count = local_assigns.fetch(:cart_count) { cart_count } %>
<% total_ore = local_assigns.fetch(:cart_total_ore) { cart_subtotal_ore } %>

<% if count.to_i.positive? %>
  <%= link_to cart_path, id: "cart_bar", class: "cart-bar",
        data: { controller: "cart-bar", cart_bar_cart_path_value: cart_path } do %>
    <span class="cart-bar-info">
      <span class="cart-bar-title"><%= t("cart.bar_title") %></span>
      <span class="cart-bar-meta">
        <span data-cart-bar-count><%= t("cart.bar_items", count: count.to_i) %></span>
        ·
        <span data-cart-bar-total><%= money(total_ore.to_i) %></span>
      </span>
    </span>
    <span class="cart-bar-action"><%= t("cart.bar_cta") %></span>
  <% end %>
<% end %>
