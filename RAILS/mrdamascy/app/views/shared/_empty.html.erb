<%# Empty state — gold-rimmed star, title, body, optional CTA.
    Usage: render "shared/empty", title: …, body: …,
                   action: { label: …, path: … } %>
<% action = local_assigns[:action] %>
<section class="empty card" role="status" aria-live="polite">
  <span class="empty-star" aria-hidden="true"></span>
  <h2 class="empty-title"><%= local_assigns[:title] %></h2>
  <% if local_assigns[:body].present? %>
    <p class="empty-body"><%= local_assigns[:body] %></p>
  <% end %>
  <% if action.is_a?(Hash) && action[:label].present? && action[:path].present? %>
    <%= link_to action[:label], action[:path], class: "button button-primary empty-action" %>
  <% end %>
</section>
