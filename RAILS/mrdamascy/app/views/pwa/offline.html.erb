<% content_for :title, t("offline.title") %>

<%# Friendly offline page — precached by the service worker and served when a
    navigation fails, at the URL that failed. Copy stays short; retry reloads
    that URL (retry_controller), or the menu root without script. %>
<section class="empty card offline-page">
  <span class="empty-star" aria-hidden="true"></span>
  <h1 class="empty-title"><%= t("offline.title") %></h1>
  <p class="empty-body"><%= t("offline.body") %></p>
  <%= link_to t("offline.retry"), root_path, class: "button button-primary empty-action",
        data: { controller: "retry" } %>
</section>
