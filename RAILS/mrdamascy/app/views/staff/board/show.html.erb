<% content_for :title, t("staff.title") %>

<%# Staff::BoardController#show provides @orders_by_state (grouped hash).
    Columns per state; each card's button advances the order one step.
    Cards carry order_card_<id> DOM ids (staff/board/_order_card) so the
    advance turbo-stream can replace or remove them. %>
<% orders_by_state = @orders_by_state.presence || {} %>

<header class="board-head">
  <%= tag.h1 t("staff.title") %>
</header>

<% if orders_by_state.values.all?(&:empty?) %>
  <%= tag.p t("staff.empty"), class: "board-empty" %>
<% end %>

<div class="board-grid">
  <% %w[placed confirmed preparing ready].each do |state| %>
    <% column_orders = orders_by_state[state] || [] %>
    <section class="board-column">
      <h2 class="board-column-title">
        <%= t("orders.states.#{state}") %>
        <span class="board-count"><%= column_orders.size %></span>
      </h2>

      <% column_orders.each do |order| %>
        <%= render "staff/board/order_card", order: order %>
      <% end %>
    </section>
  <% end %>
</div>
