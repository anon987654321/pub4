<% content_for :title, t("courier.title") %>

<%# Courier::RunsController#show provides @ready_orders (ready → "Hent",
    patch pickup) and @on_the_way_orders (picked_up → "Levert", patch deliver). %>

<h1 class="page-title"><%= t("courier.title") %></h1>

<section class="card">
  <h2 class="section-title"><%= t("courier.ready_title") %></h2>
  <% if @ready_orders.empty? %>
    <%= tag.p t("courier.empty") %>
  <% end %>
  <% @ready_orders.each do |order| %>
    <%= render "courier/runs/stop", order:,
          action: button_to(t("courier.pickup"), courier_pickup_order_path(order),
                            method: :patch, class: "button-primary") %>
  <% end %>
</section>

<section class="card">
  <h2 class="section-title"><%= t("courier.onway_title") %></h2>
  <% if @on_the_way_orders.empty? %>
    <%= tag.p t("courier.empty") %>
  <% end %>
  <%# "Levert" closes the run for good, so a mis-tap asks first. %>
  <% @on_the_way_orders.each do |order| %>
    <%= render "courier/runs/stop", order:,
          action: button_to(t("courier.deliver"), courier_deliver_order_path(order),
                            method: :patch, class: "button-deliver",
                            form: { data: { turbo_confirm: t("courier.deliver_confirm", id: order.id) } }) %>
  <% end %>
</section>
