# RAILS/env.sample
#
# Copy this to /etc/rails/<app>.env on OpenBSD and trim it to the app you are
# deploying. The keys below are grouped by scope so operators can see which
# app needs which variable without grepping the trees.

# Common baseline for all Rails apps in this tree.
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
PORT=3000
PIDFILE=tmp/pids/server.pid
SOLID_QUEUE_IN_PUMA=true

# Optional multi-host deploy knob used by the Kamal configs when the app needs
# a remote database host instead of the local default.
DB_HOST=

# Shared Redis endpoint for apps that use Action Cable or Solid Cache/Queue
# outside the Falcon web process.
REDIS_URL=redis://localhost:6379/1

# Optional Propshaft asset CDN host (all apps). Leave blank to serve from the
# origin (public_file_server + long cache-control). Example: https://cdn.brgen.no
CDN_ASSET_HOST=

# amber
OPENROUTER_API_KEY=

# brgen
LIGHTGALLERY_LICENSE=
OPENROUTER_API_KEY=
SCRAPE_MODEL=google/gemini-2.0-flash-001
# TradeDoubler publisher (PRODUCTS token from Account → Manage tokens).
# Site must be approved; then apply per advertiser programme.
TRADEDOUBLER_TOKEN=
# Optional aliases / extras:
# TRADEDOUBLER_PRODUCTS_TOKEN=   # overrides TRADEDOUBLER_TOKEN
# TRADEDOUBLER_VOUCHERS_TOKEN=
# TRADEDOUBLER_CONVERSIONS_TOKEN=
# TRADEDOUBLER_WEBHOOK_SECRET=   # postback auth for /webhooks/tradedoubler
# TRADEDOUBLER_WEBSITE_ID=       # Link Converter server-side sync
# TRADEDOUBLER_SITE_ID=          # shown in the site footer for publisher-team
#                                # ownership verification. Not a secret and not
#                                # the same as WEBSITE_ID above; set it BEFORE
#                                # approval, since it is what gets you approved.
# SITE_CONTACT_EMAIL=            # visible contact address in the site footer.
#                                # Must be a mailbox that actually receives —
#                                # the publisher team mails it. Leave unset
#                                # rather than guess.
# TRADEDOUBLER_FEED_IDS=123,456  # skip productFeeds discovery
# TRADEDOUBLER_IMPORT_MODE=search # or unlimited
# TRADEDOUBLER_MARKET=NO
# TRADEDOUBLER_LANGUAGE=nb
AFFILIATE_MARKET=NO
VAPID_SUBJECT=mailto:admin@brgen.no
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# bsdports
PLATFORM=openbsd
BSDPORTS_TREE_PATH=/usr/ports
FTP_FALLBACK=1
