# RAILS/env.sample
#
# Copy this to /etc/rails/<app>.env on OpenBSD and trim it to the app you are
# deploying. The keys below are grouped by scope so operators can see which
# app needs which variable without grepping the trees.

# Outbound mail. smtpd DKIM-signs brgen.no only — keep this domain.
# MAIL_FROM=Brgen <no-reply@brgen.no>
# SITE_CONTACT_EMAIL=personvern@brgen.no

# Marketplace checkout (brgen). Unset = pay buttons hidden, never a fake charge.
# STRIPE_SECRET_KEY=
# VIPPS_EPAYMENT_CLIENT_ID=
# VIPPS_EPAYMENT_CLIENT_SECRET=
# VIPPS_MSN=
# VIPPS_SUBSCRIPTION_KEY=
# VIPPS_WEBHOOK_SECRET=

# OAuth (buttons hide when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VIPPS_CLIENT_ID=
# VIPPS_CLIENT_SECRET=
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Site-admin mailbox. Unset = /admin/reports is closed. Do not default it
# to admin@brgen.no — that address is a public signup.
# BRGEN_ADMIN_EMAIL=

# Common baseline for all Rails apps in this tree.
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3

# Falcon worker count. rc.d passes it as `falcon serve -n ${FALCON_WORKERS:-1}`
# and it is also the SQLite connection pool size in database.yml. On vm23 (1 GB,
# 1 vCPU) leave it unset: each worker is another resident Ruby process.
# FALCON_WORKERS=1

# NOTE — do not put PORT in this file. rc.d/<app> sets it (38182 / 61352 /
# 47312) and then sources /etc/<app>.env, so a PORT here WINS: the app binds
# somewhere relayd is not checking, /up never answers, and the deploy reports
# a failed start with the app running fine on the wrong port.
#
# Removed rather than documented, because nothing read any of them:
# PIDFILE and WEB_CONCURRENCY are Puma knobs and these apps run Falcon;
# SOLID_QUEUE_IN_PUMA is a Puma plugin variable (rc.d/<app>_jobs runs the
# supervisor instead); DB_HOST and REDIS_URL belonged to the Kamal
# config/deploy.yml files, which are gone — this tree deploys with openrsync
# and rc.d on OpenBSD; RAILS_MASTER_KEY has no reader, secrets come from
# /etc/<app>.env.

# Content-Security-Policy. The policy in shared/config/initializers is
# report-only by default, so it blocks nothing until this is set. Verify in
# devtools first — /csp-reports collects violations while it is report-only.
# PUB4_CSP_ENFORCE=1

# Optional Propshaft asset CDN host (all apps). Leave blank to serve from the
# origin (public_file_server + long cache-control). Example: https://cdn.brgen.no
CDN_ASSET_HOST=

# amber
OPENROUTER_API_KEY=

# brgen
LIGHTGALLERY_LICENSE=
SCRAPE_MODEL=google/gemini-2.0-flash-001
# TradeDoubler publisher (PRODUCTS token from Account → Manage tokens).
# Site must be approved; then apply per advertiser programme.
TRADEDOUBLER_TOKEN=
# Optional aliases / extras:
# TRADEDOUBLER_PRODUCTS_TOKEN=   # overrides TRADEDOUBLER_TOKEN
# TRADEDOUBLER_VOUCHERS_TOKEN=
# TRADEDOUBLER_CONVERSIONS_TOKEN=
# TRADEDOUBLER_WEBHOOK_SECRET=   # postback auth for /webhooks/tradedoubler
# TRADEDOUBLER_WEBSITE_ID=       # Link Converter server-side sync
# TRADEDOUBLER_SITE_ID=          # shown in the site footer for publisher-team
#                                # ownership verification. Not a secret and not
#                                # the same as WEBSITE_ID above; set it BEFORE
#                                # approval, since it is what gets you approved.
# SITE_CONTACT_EMAIL=            # visible contact address in the site footer.
#                                # Must be a mailbox that actually receives —
#                                # the publisher team mails it. Leave unset
#                                # rather than guess.
# TRADEDOUBLER_FEED_IDS=123,456  # skip productFeeds discovery
# TRADEDOUBLER_IMPORT_MODE=search # or unlimited
# TRADEDOUBLER_MARKET=NO
# TRADEDOUBLER_LANGUAGE=nb
AFFILIATE_MARKET=NO
VAPID_SUBJECT=mailto:admin@brgen.no
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# bsdports
PLATFORM=openbsd
BSDPORTS_TREE_PATH=/usr/ports
FTP_FALLBACK=1
