#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "yaml"

ROOT = File.expand_path("..", __dir__)
RAILS_ROOT = File.join(ROOT, "DEPLOY", "rails")
APPS_YML = File.join(RAILS_ROOT, "apps.yml")
QUARANTINE_ROOT = File.join(ROOT, "DEPLOY", "quarantine", "virus_museum")
DILLA_ROOT = File.join(ROOT, "DEPLOY", "dilla")

Check = Struct.new(:name, :ok, :detail, keyword_init: true)

def run_check(name, *cmd, chdir: ROOT)
  out, err, status = Open3.capture3(*cmd, chdir: chdir)
  Check.new(name: name, ok: status.success?, detail: [out, err].join.strip)
rescue Errno::ENOENT
  Check.new(name: name, ok: false, detail: "command not found: #{cmd.first}")
end

def command_available?(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    File.executable?(File.join(dir, name))
  end
end

def print_checks(title, checks)
  puts title
  checks.each do |check|
    mark = check.ok ? "ok" : "fail"
    puts "  #{mark} #{check.name}"
    next if check.ok || check.detail.empty?

    check.detail.lines.first(6).each { |line| puts "    #{line.chomp}" }
  end
  checks.all?(&:ok)
end

def apps
  @apps ||= YAML.safe_load_file(APPS_YML).fetch("apps")
end

def no_tracked_master_keys_check
  out, err, status = Open3.capture3(
    "git", "-C", ROOT, "ls-files", "DEPLOY/rails/*/config/master.key"
  )
  detail = [out, err].join.strip
  Check.new(
    name: "no tracked Rails config/master.key files",
    ok: status.success? && detail.empty?,
    detail: detail
  )
end

def git_lines(*args)
  out, err, status = Open3.capture3("git", "-C", ROOT, *args)
  [out.lines.map(&:chomp).reject(&:empty?), err, status]
end

def quarantine_checks
  paths, err, status = git_lines("ls-files", "DEPLOY/quarantine/virus_museum")
  mode_lines, mode_err, mode_status = git_lines("ls-files", "-s", "DEPLOY/quarantine/virus_museum")
  executable = mode_lines.filter_map do |line|
    mode, _type, _sha, _stage, path = line.split(/\s+/, 5)
    path unless mode == "100644"
  end
  bad_extensions = paths.reject { |path| path.end_with?(".txt") || path.end_with?("/README.md") }

  [
    Check.new(
      name: "quarantine README exists",
      ok: File.file?(File.join(QUARANTINE_ROOT, "README.md")),
      detail: File.join(QUARANTINE_ROOT, "README.md")
    ),
    Check.new(
      name: "quarantine samples are text-only",
      ok: status.success? && bad_extensions.empty?,
      detail: (bad_extensions + [err]).join("\n").strip
    ),
    Check.new(
      name: "quarantine samples are non-executable",
      ok: mode_status.success? && executable.empty?,
      detail: (executable + [mode_err]).join("\n").strip
    )
  ]
end

def repo_checks
  [
    run_check("Rails production gate", File.join(RAILS_ROOT, "check_production_gate.rb")),
    no_tracked_master_keys_check,
    *quarantine_checks,
    run_check("git diff whitespace check", "git", "-C", ROOT, "diff", "--check")
  ]
end

def ruby_syntax_checks(title, paths)
  [
    Check.new(name: "#{title} files exist", ok: paths.all? { |path| File.file?(path) }, detail: paths.reject { |path| File.file?(path) }.join("\n")),
    *paths.select { |path| File.file?(path) }.map { |path| run_check("#{path.delete_prefix(ROOT + "/")} Ruby syntax", "ruby", "-c", path) }
  ]
end

def dilla_checks
  ruby_files = Dir.glob(File.join(DILLA_ROOT, "*.rb")).sort
  inline_installers = ruby_files.select { |path| File.read(path).include?("bundler/inline") }
  [
    Check.new(name: "Dilla README exists", ok: File.file?(File.join(DILLA_ROOT, "README.md")), detail: File.join(DILLA_ROOT, "README.md")),
    Check.new(name: "Dilla has no bundler/inline auto-installers", ok: inline_installers.empty?, detail: inline_installers.join("\n")),
    *ruby_files.map { |path| run_check("#{path.delete_prefix(ROOT + "/")} Ruby syntax", "ruby", "-c", path) }
  ]
end

def lab_checks
  postpro = %w[postpro.rb DEPLOY/postpro/postpro.rb MASTER/tools/postpro.rb].map { |path| File.join(ROOT, path) }
  repligen = %w[DEPLOY/repligen.rb MASTER/tools/repligen.rb].map { |path| File.join(ROOT, path) }
  face_tts = %w[MASTER/bin/tts-worker MASTER/lib/voice/speech.rb MASTER/lib/rails/face3d_runtime_policy.rb].map { |path| File.join(ROOT, path) }
  repligen_auto_installers = repligen.select { |path| File.file?(path) && File.read(path).match?(/gem install/) }
  face_sources = Dir.glob(File.join(ROOT, "MASTER/web/public/face*.js")).sort
  [
    *ruby_syntax_checks("postpro", postpro),
    *ruby_syntax_checks("repligen", repligen),
    Check.new(name: "repligen has no runtime gem install", ok: repligen_auto_installers.empty?, detail: repligen_auto_installers.join("\n")),
    *ruby_syntax_checks("face/TTS", face_tts),
    Check.new(name: "face runtime JavaScript exists", ok: face_sources.any?, detail: face_sources.join("\n"))
  ]
end

def openbsd_checks
  unless command_available?("rcctl")
    return [
      Check.new(
        name: "rcctl service state",
        ok: true,
        detail: "skipped: rcctl is not available on this host"
      )
    ]
  end

  services = (%w[master relayd nsd httpd] + apps.keys).uniq
  services.map { |service| run_check("rcctl check #{service}", "rcctl", "check", service) }
end

def rails_app_checks
  apps.keys.flat_map do |name|
    ci = File.join(RAILS_ROOT, name, "bin", "ci")
    [
      Check.new(name: "#{name} bin/ci exists", ok: File.file?(ci), detail: ci),
      Check.new(name: "#{name} bin/ci executable", ok: File.executable?(ci), detail: ci),
      run_check("#{name} bin/ci Ruby syntax", "ruby", "-c", ci)
    ]
  end
end

mode = ARGV.first || "all"

ok = case mode
     when "repo"
       print_checks("repo", repo_checks)
     when "rails"
       print_checks("rails", rails_app_checks)
     when "openbsd"
       print_checks("openbsd", openbsd_checks)
     when "dilla"
       print_checks("dilla", dilla_checks)
     when "lab"
       print_checks("lab", lab_checks)
     when "all"
       [
         print_checks("repo", repo_checks),
         print_checks("rails", rails_app_checks),
         print_checks("dilla", dilla_checks),
         print_checks("lab", lab_checks),
         print_checks("openbsd", openbsd_checks)
       ].all?
     else
       warn "usage: bin/probe [all|repo|rails|dilla|lab|openbsd]"
       false
     end

exit(ok ? 0 : 1)
