# Required
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional
MASTER_TOKEN=           # Web server auth token (auto-generated if empty)
MASTER_PORT=            # Web server port (auto-detected if empty)
MASTER_VOICE=false      # Enable voice mode
MASTER_DEBUG=false      # Debug logging
WEAVIATE_URL=           # Weaviate vector DB URL (optional)
REPLICATE_API_TOKEN=    # Replicate API token (optional)
