#!/bin/ksh
# /etc/rc.d/master2 — OpenBSD rc.d daemon script for MASTER2
# Install: doas install -m 0555 deploy/openbsd/rc.d/master2 /etc/rc.d/master2
#          doas rcctl enable master2
#          doas rcctl set master2 user dev
#          doas rcctl set master2 env "OPENROUTER_API_KEY=or-..."
#          doas rcctl start master2

daemon="/home/dev/pub4/MASTER2/bin/master"
daemon_flags="--daemon"
daemon_user="dev"
daemon_logger="daemon.info"
daemon_timeout=30

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_start() {
    export HOME="/home/${daemon_user}"
    export GEM_HOME="${HOME}/.gem/ruby/3.3"
    export PATH="${GEM_HOME}/bin:/usr/local/bin:/usr/bin:/bin"
    export BUNDLE_PATH="/home/dev/pub4/MASTER2/var/bundle"

    _rc_wait_for_start() { sleep 1; }
    rc_exec "${daemon} ${daemon_flags}"
}

rc_check() {
    pgrep -q -f "bin/master" && return 0 || return 1
}

rc_stop() {
    pkill -f "bin/master" 2>/dev/null || true
}

rc_cmd "$1"
