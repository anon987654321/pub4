#!/usr/bin/env ruby
# frozen_string_literal: true

# simulate — deep execution traces across edge cases
# Usage: bin/simulate [trace_id]
#   trace_id: 1-8, or omit for all

$LOAD_PATH.unshift File.join(__dir__, "../lib")
require_relative "../lib/master"

ENV["NO_COLOR"] ||= "0"

P = MASTER::UI.pastel

def section(title)
  puts
  puts P.bold.white("━" * 60)
  puts P.bold.white("  #{title}")
  puts P.bold.white("━" * 60)
end

def trace(label, &)
  puts P.blue("\n  trace: #{label}")
  yield
end

def fake_llm(response)
  MASTER::LLM.stub(:ask, MASTER::Result.ok(response)) { yield }
end

# ── Fixture code fragments ────────────────────────────────────

CLEAN_CODE = <<~RUBY
  # frozen_string_literal: true
  module MASTER
    module Review
      module Constitution
        def load(path) = YAML.safe_load_file(path, symbolize_names: true)
        def enforce(axioms, code) = axioms.filter_map { |a| violate(a, code) }
        def violate(axiom, code)  = axiom[:pattern].match?(code) ? nil : axiom[:id]
        def acquit(findings)      = findings.select { |f| f[:severity] == :critical }
      end
    end
  end
RUBY

SMELLY_CODE = <<~RUBY
  # processes the data and runs all the things
  def process_data_and_run_all_the_things(data, options = {})
    result = []
    data.each do |item|
      if item[:type] == :foo
        begin
          processed = item[:value].upcase.strip.gsub(/\s+/, "_")
          if processed.length > 10
            if options[:verbose]
              puts "Processing: \#{processed}"
            end
            result << processed
          end
        rescue => e
          puts "Error: \#{e.message}"
        end
      end
    end
    result
  end
RUBY

FAT_METHOD = <<~RUBY
  def perform_complete_analysis_and_generate_report(data, config, user, opts = {})
    # validate everything first
    raise "no data" unless data
    raise "no config" unless config
    output = []
    data.each do |record|
      next unless record[:active]
      score = 0
      config[:rules].each do |rule|
        score += rule[:weight] if record[:tags]&.include?(rule[:tag])
      end
      if score > config[:threshold]
        msg = "Record \#{record[:id]} scored \#{score}"
        puts msg if opts[:verbose]
        output << { id: record[:id], score: score, user: user[:name], ts: Time.now }
      end
    end
    File.write("report.json", JSON.generate(output)) if opts[:save]
    output
  end
RUBY

FILTER = STDOUT
old_sync = STDOUT.sync
STDOUT.sync = true

# ── Trace 1: Beauty scoring + council PRAISE ────────────────

section "1 / 8  BeautyScorer: clean domain-language module"

trace "input: constitution-style module, 4 public methods, zero comments" do
  result = MASTER::Review::BeautyScorer.score(CLEAN_CODE, filename: "constitution.rb")
  score  = result[:score]
  virtues = result[:virtues]

  puts P.bright_black("  filename   constitution.rb")
  puts P.bright_black("  lines      #{CLEAN_CODE.lines.count}")
  puts

  virtues.each do |v|
    bar = "█" * v[:points] + P.bright_black("░" * (3 - v[:points]))
    puts "  #{bar}  #{P.white(v[:id].to_s.ljust(22))} #{P.bright_black(v[:label])}"
  end

  puts
  total_bar = "█" * [score, 11].min
  puts "  #{P.blue(total_bar.ljust(11))} #{P.bold.white(score.to_s)}/11"
  puts

  if MASTER::Review::BeautyScorer.exemplar?(score)
    puts P.bold.white("  ✦ PRAISE threshold met — registering exemplar")
    puts P.bright_black("    axiom: AESTHETIC_VIRTUE  field: constitution.rb")
    puts P.bright_black("    virtue: #{virtues.map { |v| v[:id] }.join(', ')}")
  else
    puts P.bright_black("  score below threshold (#{MASTER::Review::BeautyScorer::EXEMPLAR_THRESHOLD}), no exemplar")
  end
end

# ── Trace 2: Enforcer on smelly code ────────────────────────

section "2 / 8  Enforcer: sprawl, wrong abstraction, rescued inner loop"

trace "input: method violating ZEN_METHOD, STRUNK_WHITE, INVERTED_PYRAMID" do
  result = MASTER::Review::Enforcer.check(SMELLY_CODE, filename: "processor.rb")
  violations = result[:violations] || []
  beauty     = result[:beauty_score] || 0
  virtues    = result[:virtues] || []

  puts P.bright_black("  filename   processor.rb")
  puts P.bright_black("  lines      #{SMELLY_CODE.lines.count}")
  puts

  if violations.any?
    violations.each do |v|
      sev = v[:severity] == :critical ? P.red("critical") : P.yellow("major   ")
      puts "  #{sev}  #{P.white(v[:axiom].to_s.ljust(22))} #{P.bright_black(v[:message].to_s[0..60])}"
    end
  else
    puts P.bright_black("  no structural violations detected")
  end

  puts
  puts P.bright_black("  beauty #{beauty}/11  virtues: #{virtues.empty? ? 'none' : virtues.map { |v| v[:id] }.join(', ')}")

  puts
  puts P.blue("  reflow:") + P.bright_black(" importance order would move public interface to top")
  puts P.bright_black("  ─ before: rescue block at line 8 (defensive, should be last)")
  puts P.bright_black("  ─ after:  primary branch → secondary → rescue at bottom")
end

# ── Trace 3: Free model cascade ─────────────────────────────

section "3 / 8  Graceful degradation: Replicate down → OpenRouter → free"

trace "REPLICATE_API_KEY invalid, openrouter rate-limited on strong, cascades to free" do
  puts P.bright_black("  primary    anthropic/claude-sonnet-4-6  [replicate]  ✗ 401 unauthorized")
  puts P.bright_black("  fallback1  anthropic/claude-sonnet-4-6  [openrouter] ✗ 429 rate limited")
  puts P.bright_black("  fallback2  deepseek/deepseek-r1:free    [openrouter] ✓")
  puts

  free_models = MASTER::LLM::FREE_FALLBACKS
  puts P.blue("  FREE_FALLBACKS chain:")
  free_models.each_with_index do |m, i|
    bullet = i == 1 ? P.white("▶") : P.bright_black("○")
    puts "    #{bullet} #{P.bright_black(m)}"
  end

  puts
  puts P.bright_black("  models0: deepseek-r1") + P.bright_black("  ← shown dim on stderr, no error raised")
  puts P.bright_black("  response quality: reduced (reasoning model, no tool calls)")
  puts P.bright_black("  pipeline: continues normally — Result.ok returned")
end

# ── Trace 4: ZEN_METHOD veto ─────────────────────────────────

section "4 / 8  Constitutional veto: LLM proposes 22-line method"

trace "council asks LLM to refactor; LLM returns fat method; ZEN_METHOD blocks it" do
  puts P.bright_black("  LLM response: #{FAT_METHOD.lines.count} lines, 1 method, nesting depth 4")
  puts

  result = MASTER::Review::BeautyScorer.score(FAT_METHOD, filename: "analysis.rb")
  veto_score = result[:score]

  puts P.blue("  enforcer0 checking proposed diff:")
  puts P.yellow("  ZEN_METHOD     method is #{FAT_METHOD.lines.count} lines (max 7), nesting 4 (max 1)")
  puts P.yellow("  STRUNK_WHITE   name 'perform_complete_analysis_and_generate_report' violates brevity")
  puts P.yellow("  AESTHETIC_VIRTUE  rescue inside def — defensive not expressive")
  puts
  puts P.red("  veto: 3 axiom violations — proposed edit rejected")
  puts P.bright_black("  pipeline: returns to pressure stage, re-prompts with violations as constraints")
  puts P.bright_black("  beauty #{veto_score}/11")

  puts
  puts P.blue("  re-prompt injected:")
  puts P.bright_black("    ZEN_METHOD: split into ≤3 methods, each ≤7 lines")
  puts P.bright_black("    STRUNK_WHITE: rename — one verb, one noun max")
  puts P.bright_black("    no rescue inside def body — let callers handle errors")
end

# ── Trace 5: Project memory across sessions ──────────────────

section "5 / 8  ProjectMemory: goal persistence across free and paid models"

trace "goal set in session A, read back in session B with different model" do
  mem_path = File.join(MASTER.root, ".master/context.yml")

  context = {
    goal: "Extract BeautyScorer into standalone gem publishable to rubygems.org",
    stack: ["ruby 3.4", "openBSD 7.8", "replicate", "openrouter"],
    constraints: ["no bash", "zsh native only", "pledge armed"],
    decisions: [
      "Kept BeautyScorer as module not class — composable over inheritable",
      "EXEMPLAR_THRESHOLD=6 — strict enough to be meaningful",
      "exemplars.yml as flat YAML, not SQLite — readable by humans and LLMs",
    ],
    updated: Time.now.iso8601,
  }

  puts P.bright_black("  .master/context.yml  (gitignored, persists on disk)")
  puts
  puts P.blue("  goal:")
  puts P.white("    #{context[:goal]}")
  puts
  puts P.blue("  constraints:")
  context[:constraints].each { |c| puts P.bright_black("    · #{c}") }
  puts
  puts P.blue("  decisions (last 3, newest last):")
  context[:decisions].each { |d| puts P.bright_black("    · #{d}") }
  puts

  injected_tokens = YAML.dump(context).length / 4
  puts P.bright_black("  injected into every LLM system message: ~#{injected_tokens} tokens")
  puts P.bright_black("  free model (deepseek-r1:free) sees same context as claude-sonnet-4-6")
  puts P.bright_black("  project awareness: continuous across sessions, models, and reboots")
end

# ── Trace 6: Echo chamber council ───────────────────────────

section "6 / 8  Council tribunal: contested refactor, split vote"

trace "3-model echo chamber debates removing rescue from pipeline.rb" do
  proposal = "Remove top-level rescue in Pipeline#call — let callers handle errors explicitly"

  puts P.white("  proposal: #{proposal}")
  puts

  votes = [
    { model: "claude-sonnet-4-6",  verdict: "REJECT",  reason: "Callers can't recover from unknown executor failures — silent crash worse than rescue" },
    { model: "deepseek-r1",        verdict: "APPROVE", reason: "Rescue violates ZEN_METHOD — defensiveness hidden in infrastructure" },
    { model: "grok-code-fast-1",   verdict: "APPROVE", reason: "Top-level rescue is a smell; pipeline should be a thin coordinator only" },
  ]

  votes.each do |v|
    color  = v[:verdict] == "APPROVE" ? method(:puts).tap { } : nil
    symbol = case v[:verdict]
             when "APPROVE" then P.white("✓")
             when "REJECT"  then P.red("✗")
             when "PRAISE"  then P.blue("✦")
             end
    puts "  #{symbol} #{P.blue(v[:model].ljust(22))} #{P.bright_black(v[:verdict].ljust(8))} #{P.bright_black(v[:reason][0..60])}"
  end

  approve = votes.count { |v| v[:verdict] == "APPROVE" }
  reject  = votes.count { |v| v[:verdict] == "REJECT" }
  puts
  puts P.white("  #{approve}-#{reject} majority: APPROVE")
  puts P.bright_black("  dissent logged — claude's objection added to project decisions")
  puts P.bright_black("  edit proceeds; rescue removed; axiom INVERTED_PYRAMID satisfied")
end

# ── Trace 7: Importance reflow ───────────────────────────────

section "7 / 8  Reflow: importance-ordered lines, Strunk & White applied"

trace "a config file with setup noise before the meaningful declaration" do
  before_lines = [
    "require 'yaml'",
    "require 'fileutils'",
    "# frozen_string_literal: true",
    "MASTER_ROOT = File.expand_path('..', __dir__)",
    "MASTER_ENV  = ENV.fetch('MASTER_ENV', 'production')",
    "VERSION     = '2.0.0'",
    "CODENAME    = 'CONSTITUTIONAL'",
  ]

  after_lines = [
    "# frozen_string_literal: true",
    "VERSION  = '2.0.0'",
    "CODENAME = 'CONSTITUTIONAL'",
    "MASTER_ENV  = ENV.fetch('MASTER_ENV', 'production')",
    "MASTER_ROOT = File.expand_path('..', __dir__)",
    "require 'yaml'",
    "require 'fileutils'",
  ]

  puts P.blue("  before  (discovery order):")
  before_lines.each { |l| puts P.bright_black("    #{l}") }
  puts
  puts P.blue("  after   (importance order — INVERTED_PYRAMID):")
  after_lines.each_with_index do |l, i|
    style = i < 3 ? P.white(l) : P.bright_black(l)
    puts "    #{style}"
  end
  puts
  puts P.bright_black("  rule: identity before config, config before deps, deps last")
  puts P.bright_black("  Strunk & White: omit setup ceremony — reader sees intent first")
end

# ── Trace 8: Full REPL session ───────────────────────────────

section "8 / 8  Full REPL session: boot → goal → refactor → PRAISE"

trace "realistic session on OpenBSD showing all subsystems firing" do
  lines = [
    ["banner",  "MASTER 2.0.0 (CONSTITUTIONAL) #1: Mon Feb 23 01:53:20 UTC 2026"],
    ["banner",  "    dev@dev.openbsd.amsterdam:/home/dev/pub4/MASTER2"],
    ["banner",  "runtime0: x86_64-openbsd · ruby 3.4.6 · zsh dev%"],
    ["banner",  "corpus0: 80 axioms · 12 personas"],
    ["banner",  "models0: claude-sonnet-4-6 · deepseek-v3-2 · deepseek-r1"],
    ["banner",  "routing0: Replicate primary, OpenRouter fallback"],
    ["banner",  "security0: pledge armed"],
    ["banner",  "engine0: react · pre_act · rewoo · reflexion"],
    ["banner",  "smoke0: ok"],
    ["banner",  "boot0: 52ms"],
    ["prescan", "vcs0: clean"],
    ["prescan", "pf0: httpd.conf: Consider HSTS header for HTTPS enforcement"],
    ["prescan", "pf0: doas.conf: nopass allows passwordless privilege escalation — intentional?"],
    ["session", "session0: id=daee7e9d…"],
    ["prompt",  "master · main · claude-sonnet-4-6 ❯  goal extract BeautyScorer as standalone gem"],
    ["out",     "goal saved."],
    ["prompt",  "master · main · claude-sonnet-4-6 ❯  refactor lib/review/beauty.rb"],
    ["engine",  "engine0: pre_act selected (deterministic refactor, no tool calls needed)"],
    ["engine",  "models0: strong claude-sonnet-4-6  128→892 tok  $0.014"],
    ["enforcer","enforcer0: 0 violations"],
    ["beauty",  "✦ 9"],
    ["council", "council: PRAISE — domain_language_pure · zen_method · no_comment_needed"],
    ["council", "exemplar registered: beauty.rb BeautyScorer#score  score=9"],
    ["out",     "beauty.rb rewritten — 3 methods, 0 comments, domain-pure names"],
    ["prompt",  "master · main · claude-sonnet-4-6 ❯  "],
  ]

  lines.each do |type, text|
    out = case type
          when "banner"  then P.bright_black("  #{text}")
          when "prescan" then text.include?("pf0:") ? P.yellow("  #{text}") : P.white("  #{text}")
          when "session" then P.bright_black("  #{text}")
          when "prompt"  then P.bold.white("  #{text}")
          when "engine"  then P.bright_black("  #{text}")
          when "enforcer"then P.bright_black("  #{text}")
          when "beauty"  then P.blue("  #{text}")
          when "council" then text.include?("PRAISE") ? P.bold.white("  #{text}") : P.bright_black("  #{text}")
          when "out"     then P.white("  #{text}")
          end
    puts out
    sleep 0.02
  end
end

puts
puts P.bold.white("━" * 60)
puts P.bright_black("  8 traces complete")
puts
