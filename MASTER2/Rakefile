# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/test_*.rb"]
  t.warning = false
end

task default: :test

desc "Boot smoke test (no API key needed)"
task :smoke do
  ruby "-e", "require_relative 'lib/master'; puts MASTER::Boot.smoke_test"
end

desc "Run self-test through MASTER's own review"
task :selftest do
  ruby "-e", "require_relative 'lib/master'; MASTER::DB.setup; MASTER::SelfTest.run"
end
