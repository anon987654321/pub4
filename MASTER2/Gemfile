source "https://rubygems.org"

# TTY toolkit - restored full integration from MASTER v1
gem "tty-reader", "~> 0.9"
gem "tty-spinner"
gem "tty-table"
gem "tty-box"
gem "tty-markdown"
gem "tty-prompt"
gem "tty-progressbar"
gem "tty-cursor"
gem "tty-tree"       # Tree display
gem "tty-pie"        # Pie charts for stats
gem "tty-pager"      # Pagination
gem "tty-link"       # Clickable links
gem "tty-font"       # ASCII art fonts
gem "tty-editor"     # External editor integration
gem "tty-command"    # Safe command execution
gem "tty-screen"     # Terminal dimensions
gem "tty-platform"   # Platform detection
gem "tty-which"      # Command location

# stdlib gems required explicitly for Ruby 3.5+
gem "fiddle"
gem "ostruct"

# Utilities
gem "pastel"         # Terminal colors
gem "rouge"          # Syntax highlighting
gem "nokogiri", "~> 1.19"  # HTML/XML parsing (security: safe HTML processing)

# LLM client
gem "ruby_llm", "~> 1.11"

# Circuit breaker
gem "stoplight", "~> 4.0"

# Web server
gem "falcon", "~> 0.47"
gem "async-websocket"

# MCP server — expose MASTER2 tools via Model Context Protocol
gem "fast-mcp", "~> 1.6"

# Safe experiments with automatic rollback (scientist pattern)
gem "scientist", "~> 1.6"

# Background job scheduling (replaces bare sleep loop in Heartbeat)
gem "rufus-scheduler", "~> 3.9"

group :development, :test do
  gem "rubocop", "~> 1.0",  require: false
  gem "reek",    "~> 6.0",  require: false
end

group :test do
  gem "minitest"
  gem "rake"
  gem "webmock"      # HTTP mocking
  gem "simplecov"
end
