#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../../MASTER/lib/pub4/check_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = RbConfig.ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "600"))
runner = Pub4::CheckRunner.new(prefix: "deploy-full", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "local check" unless runner.run("local check", RUBY, "OPERATOR/bin/check")
contract_loader = 'Dir["RAILS/test/**/*_test.rb"].sort.each { |file| require File.expand_path(file) }'
failures << "rails contracts" unless runner.run("rails contracts", RUBY, "-e", contract_loader)
failures << "integrity" unless runner.run("integrity", RUBY, "OPERATOR/integrity_gate.rb")

exit(failures.empty? ? 0 : 1)
