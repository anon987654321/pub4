#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "rbconfig"
require_relative "../../MASTER/lib/pub4/check_runner"
require_relative "../../MASTER/lib/pub4/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Pub4::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
profile = "operator"
OptionParser.new do |parser|
  parser.on("--profile=PROFILE", "contributor or operator (default)") { |value| profile = value }
end.parse!

runner = Pub4::CheckRunner.new(prefix: "deploy-check", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "identity" unless runner.run("identity", RUBY, "OPERATOR/verify_deploy_identity.rb")
failures << "production" unless runner.run("production", RUBY, "RAILS/check_production_gate.rb")
failures << "phantom_fk" unless runner.run("phantom fk", RUBY, "RAILS/check_phantom_foreign_keys.rb")
failures << "domain_align" unless runner.run("domain align", RUBY, "RAILS/domain_alignment_gate.rb")
failures << "openbsd_smoke" unless runner.run("openbsd smoke", RUBY, "OPENBSD/deploy_smoke_gate.rb")

if profile == "contributor"
  puts "deploy-check: extended gates     skip — contributor profile (use OPERATOR/bin/check-full for integrity)"
end

exit(failures.empty? ? 0 : 1)