#!/usr/bin/env sh
# Print mandatory follow-up after git pull on vm23.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

cat <<EOF
post-pull: source updated at ${ROOT}
post-pull: deployed /home/<app>/app trees are NOT updated by git pull alone.

Next (serial — one app at a time):
  1. ruby34 DEPLOY/bin/vps-state
  2. zsh DEPLOY/bin/vps-deploy <app>     # or: zsh DEPLOY/openbsd/sh/vps_ci.sh <app>
  3. ruby34 DEPLOY/integrity_gate.rb
  4. ruby34 DEPLOY/openbsd/health_check.rb --public --all-ready-apps

MASTER web changes also need:
  zsh DEPLOY/bin/vps-deploy master

See RECIPES.md for copy-paste recipes.
EOF