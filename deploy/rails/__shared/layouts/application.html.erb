```html
<!DOCTYPE html>
<html lang="<%= I18n.locale || I18n.default_locale || 'en' %>" dir="<%= rtl_locale?(I18n.locale) ? 'rtl' : 'ltr' %>">
<head>
  <%= render "shared/meta" %>
  <%= yield :head %>
</head>
<body data-controller="<%= controller_name %>" class="<%= body_class %>">
  <%= render "shared/skip_links" %>
  <%= render "shared/nav" %>

  <main id="main-content" class="site-main">
    <%= render "shared/flash" %>
    <%= yield %>
  </main>

  <%= render "shared/footer" %>
  <%= yield :scripts %>
</body>
</html>
