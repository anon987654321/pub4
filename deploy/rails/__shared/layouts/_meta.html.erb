```html
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF">

<title><%= content_for?(:title) ? yield(:title)<%= csrf_meta_tags %>

<meta name="description" content="<apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="<%= @status_bar_style || 'black-translucent' %>">

<%# Open Graph Tags %>
<meta property="og:type" content="website">
<meta property="og:title : @app_title || 'Rails App' %>">
<meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : @app_description || 'Rails Application' %>">
<meta property="og:url" content="<%= request.base_url %>">

<%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png' %>

<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<<%= yield %>
</body>
</html>
