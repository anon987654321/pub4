```erb
<a href="#main-content" class="skip-nav">Skip to main content</a>
<header class="site-header">
  <div class="container">
    <nav class="nav-main" aria-label="Main navigation">
      <div class="nav-brand">
        <%= link_to root_path, class: "logo-link" do %>
          <span class="logo"><%= @app_name || "App" %></span>
        <% end %>
        <% if ActsAsTenant.current_tenant %>
          <span class="tenant" aria-label="Current tenant"><%= ActsAsTenant.current_tenant.name %></span>
        <% end %>
      </div>

      <div class="nav-links">
        <% if user_signed_in? %>
          <span class="nav-user" aria-label="Logged in as"><%= current_user.email %></span>
          <%= link_to t("navigation.sign_out"), destroy_user_session_path, method: :delete, class: "nav-link" %>
        <% else %>
          <%= link_to t("navigation.sign_in"), new_user_session_path, class: "nav-link" %>
        <% end %>
      </div>
    </nav>
  </div>
</header>
```
