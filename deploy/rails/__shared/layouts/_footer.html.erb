```erb
<% app_name = @app_name || "App" %>

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  <div class="container">
    <div class="footer-content">
      <p class="footer-text" role="text">
        &copy; <%= Time.now.year %> <%= app_name %>.
        <%= link_to "Privacy", privacy_path, class: "footer-link" %> &middot;
        <%= link_to "Terms", terms_path, class: "footer-link" %> &middot;
        <%= link_to "About", about_path, class: "footer-link" %>
      </p>
    </div>
  </div>
</footer>
```
