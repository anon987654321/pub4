# CH04: service monitor — install monit, copy to /etc/monitrc, rcctl enable monit.
# Checks tracked Rails apps and MASTER; restarts on failure.

set daemon 60
set logfile /var/log/monit.log

check process master with pidfile /var/run/master.pid
  start program = "/usr/sbin/rcctl start master"
  stop program = "/usr/sbin/rcctl stop master"
  if failed host 127.0.0.1 port 53187 protocol http request "/up" status = 200 for 3 cycles then restart

check process brgen with pidfile /var/run/brgen.pid
  start program = "/usr/sbin/rcctl start brgen"
  stop program = "/usr/sbin/rcctl stop brgen"
  if failed host 127.0.0.1 port 38182 protocol http request "/up" status = 200 for 3 cycles then restart

