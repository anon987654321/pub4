# Rails / Falcon app log rotation (append to /etc/newsyslog.conf or include from there).
# Weekly rotation, 7 archives, gzip, SIGUSR1 to reopen logs.
# Install: cp DEPLOY/openbsd/etc/newsyslog.conf.d/rails /etc/newsyslog.conf.d/rails

"/var/log/brgen.log"      _brgen:_brgen      640  7  *  $W0D0  Z  /var/run/brgen.pid      30
"/var/log/amber.log"      _amber:_amber      640  7  *  $W0D0  Z  /var/run/amber.pid      30
"/var/log/bsdports.log"   _bsdports:_bsdports 640 7  *  $W0D0  Z  /var/run/bsdports.pid   30
"/var/log/baibl.log"      _baibl:_baibl      640  7  *  $W0D0  Z  /var/run/baibl.pid      30
"/var/log/blognet.log"    _blognet:_blognet  640  7  *  $W0D0  Z  /var/run/blognet.pid    30
"/var/log/hjerterom.log"  _hjerterom:_hjerterom 640 7 * $W0D0 Z /var/run/hjerterom.pid  30
"/var/log/master.log"     dev:dev            640  7  *  $W0D0  Z  /var/run/master.pid     30