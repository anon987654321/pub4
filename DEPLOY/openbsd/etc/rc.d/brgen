#!/bin/ksh
PORT=38182
APP_DIR=/home/brgen/app
[ -r /etc/brgen.env ] && . /etc/brgen.env
[ -f /etc/rails/brgen.env ] && . /etc/rails/brgen.env
: "${SECRET_KEY_BASE:?missing SECRET_KEY_BASE in /etc/brgen.env}"
daemon="/bin/ksh"
daemon_flags="-c 'cd ${APP_DIR} && export RAILS_ENV=production SOLID_QUEUE_IN_PUMA=true SECRET_KEY_BASE=${SECRET_KEY_BASE} HOME=/home/brgen PUB4_ROOT=/home/dev/pub4 PUB4_RAILS_ROOT=/home/dev/pub4/DEPLOY/rails && exec /usr/local/bin/bundle34 exec falcon serve -n 2 --health-check-timeout 300 --bind http://127.0.0.1:${PORT}'"
daemon_user="brgen"
daemon_execdir="/home/brgen/app"
daemon_logger="daemon.notice"
daemon_timeout="120"
. /etc/rc.d/rc.subr
pexp="ruby34.*${PORT}"
rc_bg=YES
rc_reload=NO

rc_pre() {
  pkill -f "falcon.*${PORT}" 2>/dev/null || true
  pkill -f "ruby34.*${PORT}" 2>/dev/null || true
  sleep 1
}

rc_cmd $1
