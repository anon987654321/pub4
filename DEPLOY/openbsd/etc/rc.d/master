#!/bin/ksh
PORT=53187
[ -r /etc/master.env ] && . /etc/master.env
daemon="/usr/local/bin/bundle34"
daemon_flags="exec env LANG=C.UTF-8 LC_ALL=C.UTF-8 RAILS_ENV=production MASTER_SAFE_MODE=1 MASTER_SKIP_SELF_TEST=1 MASTER_BACKGROUND=0 MASTER_AUTOFIX=0 MASTER_WATCH=0 MASTER_WATCHER=0 MASTER_HEARTBEAT=0 SECRET_KEY_BASE_DUMMY=1 DEEPSEEK_API_KEY=$DEEPSEEK_API_KEY OPENROUTER_API_KEY=$OPENROUTER_API_KEY REPLICATE_API_KEY=$REPLICATE_API_KEY WEAVIATE_API_KEY=$WEAVIATE_API_KEY GEMINI_API_KEY=$GEMINI_API_KEY falcon serve -n 1 --health-check-timeout 300 --bind http://127.0.0.1:${PORT}"
daemon_user="dev"
daemon_execdir="/home/dev/pub4/MASTER/web"
daemon_logger="daemon.notice"
daemon_timeout="90"
. /etc/rc.d/rc.subr
pexp="ruby34.*${PORT}"
rc_bg=YES
rc_reload=NO

rc_pre() {
	pkill -f "falcon.*${PORT}" 2>/dev/null
	pkill -f "ruby34.*${PORT}" 2>/dev/null
	pkill -f "pub4/MASTER/web" 2>/dev/null
	pkill -f "/home/dev/pub4/MASTER/bin/tts-worker" 2>/dev/null
	rm -f /home/dev/pub4/MASTER/.master/tts.sock /home/dev/pub4/MASTER/.master/tts-0.sock /home/dev/pub4/MASTER/.master/tts-1.sock 2>/dev/null || true
	# Propshaft must not re-digest public/assets/ (nested assets/assets wedges boot).
	rm -rf /home/dev/pub4/MASTER/web/public/assets/assets 2>/dev/null || true
	(cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec rails assets:build_face_runtime assets:build_face_modules_bundle) 2>/dev/null || true
	_manifest=/home/dev/pub4/MASTER/web/public/assets/.manifest.json
	_runtime=/home/dev/pub4/MASTER/web/public/face.runtime.js
	_bundle=/home/dev/pub4/MASTER/web/public/face.modules.bundle.js
	if [ ! -f "$_manifest" ] || [ "$_runtime" -nt "$_manifest" ] || [ "$_bundle" -nt "$_manifest" ]; then
		(cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec rails assets:precompile) 2>/dev/null || true
	fi
	sleep 1
}

rc_cmd $1
rc=$?
if [ "$1" = "start" ] || [ "$1" = "restart" ]; then
	if [ "$rc" = "0" ]; then
		ruby34 -ryaml -e 'c=YAML.load_file("/home/dev/pub4/MASTER/.master/config.yml") rescue {}; u=c["web_public_url"]||"http://127.0.0.1:#{c["web_port"]||53187}"; t=c["web_token"]; puts t ? "web: #{u}/?token=#{t}" : "web: #{u}"' 2>/dev/null
		# Wait for Falcon /up, then restart relayd so HTTPS does not stay empty after rcctl restart master.
		_i=0
		while [ "$_i" -lt 30 ]; do
			curl -fsS "http://127.0.0.1:${PORT}/up" >/dev/null 2>&1 && break
			sleep 1
			_i=$((_i + 1))
		done
		# Wait for MASTER container (chat/TTS need it; /up alone is too early).
		_j=0
		while [ "$_j" -lt 120 ]; do
			curl -fsS "http://127.0.0.1:${PORT}/chat/metrics" 2>/dev/null | grep -q '"model"' && break
			sleep 2
			_j=$((_j + 1))
		done
		rcctl restart relayd 2>/dev/null || true
		# Warm Edge TTS daemon as dev (not root) so sockets stay group-writable.
		doas -u dev sh -c 'cd /home/dev/pub4/MASTER && BUNDLE_GEMFILE=/home/dev/pub4/MASTER/Gemfile bundle34 exec ruby -Ilib -e "require \"master\"; puts Master::Voice::TtsSupervisor.ensure_daemon!"' \
			2>/dev/null || true
		ruby34 /home/dev/pub4/MASTER/web/script/probe_http 2>/dev/null || logger -t master "probe_http failed after restart"
	fi
fi
exit $rc
