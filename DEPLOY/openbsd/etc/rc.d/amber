#!/bin/ksh
PORT=61352
APP_DIR=/home/amber/app
[ -r /etc/amber.env ] && . /etc/amber.env
[ -f /etc/rails/amber.env ] && . /etc/rails/amber.env
: "${SECRET_KEY_BASE:?missing SECRET_KEY_BASE in /etc/amber.env}"
daemon="/bin/ksh"
daemon_flags="-c 'cd ${APP_DIR} && export RAILS_ENV=production SOLID_QUEUE_IN_PUMA=true SECRET_KEY_BASE=${SECRET_KEY_BASE} HOME=/home/amber && exec /usr/local/bin/bundle34 exec falcon serve --bind http://127.0.0.1:${PORT}'"
daemon_user="amber"
daemon_execdir="/home/amber/app"
daemon_logger="daemon.notice"
daemon_timeout="120"
. /etc/rc.d/rc.subr
pexp="ruby34.*${PORT}"
rc_bg=YES
rc_reload=NO

rc_pre() {
  pkill -f "falcon.*${PORT}" 2>/dev/null || true
  pkill -f "ruby34.*${PORT}" 2>/dev/null || true
  sleep 1
}

rc_cmd $1
