#!/usr/bin/expect -f
set timeout 600
set keyfile $env(HOME)/.ssh/id_ed25519_brgen

proc at_prompt {} {
  expect -re {brgen\$ $}
}

spawn ssh -tt -i $keyfile -p 31415 -o StrictHostKeyChecking=no dev@server4.openbsd.amsterdam vmctl console vm23
expect -re {Connected to /dev/ttypx}
send "\r"
at_prompt

send "cd /home/dev/pub4/MASTER && bundle install\r"
at_prompt

send "cd /home/dev/pub4/MASTER/web && bundle install && doas rcctl restart master\r"
at_prompt

# Fix MASTER scan to use bundle exec (zeitwerk lives in MASTER/Gemfile)
send "for a in brgen amber blognet bsdports baibl hjerterom; do sed -i '' 's|ruby34 /home/dev/pub4/MASTER/bin/cli|(cd /home/dev/pub4/MASTER \\&\\& bundle exec ruby bin/cli|g' /home/dev/pub4/DEPLOY/rails/\$a/\$a.sh; done\r"
at_prompt

send "for a in brgen amber blognet bsdports baibl hjerterom; do echo ====\$a====; zsh /home/dev/pub4/DEPLOY/rails/\$a/\$a.sh || echo FAIL_\$a; done 2>&1 | tee /tmp/console_install.log\r"

set timeout 3600
expect {
  -re {FAIL_hjerterom} { }
  -re {====hjerterom====} { exp_continue }
  timeout { puts "INSTALL_TIMEOUT"; }
}

at_prompt
send "doas rcctl check master brgen amber blognet bsdports baibl hjerterom 2>&1\r"
at_prompt
send "tail -20 /tmp/console_install.log\r"
at_prompt
send "~.\r"
expect eof