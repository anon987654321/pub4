#!/usr/bin/expect -f
set timeout 30
set keyfile $env(HOME)/.ssh/id_ed25519_brgen
set scriptfile [file dirname $argv0]/vps_on_vm_install.sh
set fd [open $scriptfile r]
set b64 [exec base64 < $scriptfile]

spawn ssh -tt -i $keyfile -p 31415 -o StrictHostKeyChecking=no dev@server4.openbsd.amsterdam vmctl console vm23
expect -re {Connected to /dev/ttypx}
send "\r"
expect -re {brgen\$ }
send "doas pfctl -t bruteforce -T flush 2>/dev/null; echo PF_FLUSH_OK\r"
expect -re {brgen\$ }
send "echo $b64 | base64 -d > /tmp/vps_on_vm_install.sh && chmod +x /tmp/vps_on_vm_install.sh && echo SCRIPT_OK\r"
expect -re {brgen\$ }
send "nohup /tmp/vps_on_vm_install.sh > /tmp/on_vm_install.log 2>&1 & echo STARTED\r"
expect -re {brgen\$ }
send "~.\r"
expect eof
close $fd