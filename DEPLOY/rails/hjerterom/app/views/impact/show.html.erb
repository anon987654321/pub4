<% content_for :title, "Impact" %>

<h1>Public impact dashboard</h1>

<div class="chips">
  <span class="chip"><%= @stats[:meals_provided] %> items distributed</span>
  <span class="chip"><%= @stats[:beneficiaries_served] %> beneficiaries</span>
  <span class="chip"><%= @stats[:donations_received] %> donations</span>
  <span class="chip"><%= @stats[:food_rescued_kg] %> kg listed</span>
  <span class="chip"><%= @stats[:partners_active] %> partners</span>
  <span class="chip"><%= @stats[:transfers_completed] %> transfers completed</span>
</div>

<h2>Recent transfers</h2>
<% @recent_transfers.each do |transfer| %>
  <p><%= transfer.partner.name %> → <%= transfer.beneficiary&.name || "TBD" %> · <%= transfer.status %></p>
<% end %>