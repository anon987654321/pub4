<% content_for :title, "Volunteers" %>
<h1>Volunteers</h1>
<% if @volunteers.any? %>
  <%= turbo_stream_from "hjerterom:volunteers" %>
  <ul id="volunteers">
    <%= render @volunteers %>
  </ul>
<% else %>
  <p>No active volunteers yet.</p>
<% end %>
<% if authenticated? %>
  <%= link_to "Register as volunteer", new_volunteer_path %>
<% end %>
