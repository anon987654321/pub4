<% content_for :title, @partner.name %>

<h1><%= @partner.name %></h1>
<p class="dim"><%= @partner.kind %> · <%= @partner.contact_email %></p>
<p><%= @partner.address %></p>

<h2>Transfers</h2>
<% @transfers.each do |transfer| %>
  <p><%= transfer.beneficiary&.name || "Unassigned" %> · <%= transfer.status %> · <%= transfer.items_count %> items</p>
<% end %>