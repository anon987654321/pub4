<% content_for :title, "New partner" %>

<h1>New partner</h1>
<%= form_with model: @partner do |f| %>
  <div class="field"><%= f.label :name %><%= f.text_field :name %></div>
  <div class="field"><%= f.label :kind %><%= f.select :kind, Partner::KINDS %></div>
  <div class="field"><%= f.label :contact_email %><%= f.email_field :contact_email %></div>
  <div class="field"><%= f.label :address %><%= f.text_field :address %></div>
  <%= f.submit "Create", class: "btn btn-primary" %>
<% end %>