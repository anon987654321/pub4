<% compact = local_assigns.fetch(:compact, false) %>
<svg viewBox="0 0 64 56" role="img" aria-label="Hjerterom" class="hjerterom-logo-svg<%= " hjerterom-logo-svg--compact" if compact %>">
  <defs>
    <linearGradient id="hjerterom-heart-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fb7185">
        <animate attributeName="stop-color" values="#fb7185;#f43f5e;#fb7185" dur="3.6s" repeatCount="indefinite"/>
      </stop>
      <stop offset="100%" stop-color="#be123c">
        <animate attributeName="stop-color" values="#be123c;#e11d48;#be123c" dur="3.6s" repeatCount="indefinite"/>
      </stop>
    </linearGradient>
    <filter id="hjerterom-heart-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <g class="hjerterom-logo__pulse" transform-origin="32 26">
    <animateTransform attributeName="transform" type="scale" values="1;1.06;1;1.03;1" keyTimes="0;0.18;0.36;0.58;1" dur="2.8s" repeatCount="indefinite" additive="sum"/>
    <path d="M32 50 C32 50 4 30 4 17 C4 9 10 4 18 4 C24 4 28 8 32 14 C36 8 40 4 46 4 C54 4 60 9 60 17 C60 30 32 50 32 50 Z" fill="url(#hjerterom-heart-gradient)" filter="url(#hjerterom-heart-glow)"/>
  </g>
  <% unless compact %>
    <text x="32" y="54" text-anchor="middle" font-size="7" letter-spacing="0.08em" fill="currentColor" font-family="system-ui, sans-serif" font-weight="700">hjerterom</text>
  <% end %>
</svg>