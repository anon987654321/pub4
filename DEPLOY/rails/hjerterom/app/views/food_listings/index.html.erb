<% content_for :title, "Food" %>
<header role="banner" aria-label="Food listings header">
  <h1>Available food</h1>
  <nav role="navigation" aria-label="Food actions">
    <% if authenticated? %><%= link_to "List food", new_food_listing_path %><% end %>
  </nav>
</header>

<%= live_search_form url: food_listings_path, placeholder: "Search food listings…", label: "Food listing search" %>

<turbo-frame id="hjerterom-food-listings" data-turbo-action="replace">
<div id="live_search_results" role="region" aria-label="Food listings results">
  <%= render "food_listings/live_search_results" %>
</div>
</turbo-frame>