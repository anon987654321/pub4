<% content_for :title, "Boxes" %>

<div class="page-header">
  <div>
    <p class="dim">Weekly support boxes</p>
    <h1>Boxes</h1>
  </div>
  <%= link_to "New box", new_box_path, class: "btn btn-primary" %>
</div>

<%= turbo_stream_from "hjerterom:boxes" if @boxes.any? %>
<div id="boxes">
  <% if @boxes.any? %>
    <%= render @boxes %>
  <% else %>
    <div id="boxes-empty" class="empty"><p>No boxes planned.</p></div>
  <% end %>
</div>