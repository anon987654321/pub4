<% content_for :title, "Beneficiaries" %>

<header class="page-header">
  <h1>Beneficiaries</h1>
</header>

<ul>
  <% @beneficiaries.each do |beneficiary| %>
    <li>
      <%= link_to beneficiary.household_label, beneficiary_path(beneficiary) %>
      <%= link_to "Match food", match_beneficiary_path(beneficiary), class: "btn btn-sm" %>
    </li>
  <% end %>
</ul>

<%= pagy_nav(@pagy) if @pagy.pages > 1 %>