<% content_for :title, "Categories" %>
<h1>Categories</h1>
<div id="categories">
  <% @categories.each do |cat| %>
    <div class="port-row">
      <%= link_to cat.name, category_path(cat), class: "port-name" %>
      <span class="port-comment"><%= cat.description %></span>
    </div>
  <% end %>
</div>
