<% content_for :title, @port.name %>
<article role="article" aria-label="Port details">
  <header role="banner" aria-label="Port header">
    <h1><%= @port.name %> <small><%= @port.version %></small></h1>
    <small><%= link_to @port.category.name, category_path(@port.category) %></small>
  </header>
  <p><%= @port.comment %></p>
  <p><%= @port.description %></p>
  <dl>
    <dt>Maintainer</dt><dd><% if @maintainer %><%= link_to @port.maintainer, maintainer_path(@maintainer) %><% else %><%= @port.maintainer %><% end %></dd>
    <dt>Local install</dt><dd><%= @pkg_info.present? ? "installed (#{@pkg_info})" : "not installed" %></dd>
    <dt>Pkgpath</dt><dd><code><%= @port.pkgpath %></code></dd>
    <% if @port.homepage.present? %><dt>Homepage</dt><dd><%= link_to @port.homepage, @port.homepage %></dd><% end %>
    <dt>Updated</dt><dd><%= @port.last_updated&.strftime("%Y-%m-%d") %></dd>
  </dl>

  <% if @dependencies.any? %>
    <h2>Dependencies</h2>
    <ul role="list" aria-label="Port dependencies">
      <% @dependencies.each do |dep| %>
        <li role="listitem">
          <%= link_to dep.depends_on.name, port_path(dep.depends_on) %>
          <small><%= dep.dep_type %></small>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= render "ports/dependency_tree", tree: @dependency_tree, heading: "Dependency tree" %>

  <% if @rdeps.any? %>
    <h2>Reverse dependencies</h2>
    <ul role="list" aria-label="Ports that depend on this package">
      <% @rdeps.each do |reverse| %>
        <li role="listitem"><%= link_to reverse.name, port_path(reverse) %></li>
      <% end %>
    </ul>
  <% end %>

  <section aria-label="Package exploration assistant">
    <h2>Exploration assistant</h2>
    <p id="port-explore-summary"><%= @explore_summary %></p>
    <p><%= link_to "JSON summary", explore_port_path(@port), data: { turbo: false } %></p>
  </section>

  <% if @deps.any? %>
    <svg class="dep-graph" width="400" height="<%= [200, 30 + @deps.size * 25].max %>" role="img" aria-labelledby="dep-graph-title" aria-hidden="true">
      <title id="dep-graph-title">Decorative dependency graph for <%= @port.name %></title>
      <circle cx="300" cy="100" r="18" fill="#fff" stroke="#000" />
      <text x="300" y="104" text-anchor="middle" font-size="7"><%= @port.name[0,10] %></text>
      <% @deps.each_with_index do |dep, i| %>
        <% y = 20 + i * 25 %>
        <line x1="282" y1="100" x2="120" y2="<%= y %>" stroke="#666" stroke-width="1" />
        <circle cx="100" cy="<%= y %>" r="12" fill="#eee" stroke="#000" />
        <text x="100" y="<%= y + 3 %>" text-anchor="middle" font-size="6"><%= dep.name[0,8] %></text>
      <% end %>
    </svg>
  <% end %>

  <% if @updates.any? %>
    <h2>Version history</h2>
    <ul>
      <% @updates.each do |update| %>
        <li>
          <pre><code>--- a/<%= @port.pkgpath %>
+++ b/<%= @port.pkgpath %>
@@ -1 +1 @@
-<%= update.old_version %>
+<%= update.new_version %>
<%= update.commit_message %></code></pre>
          <small><%= update.committed_at&.strftime("%Y-%m-%d") %></small>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2>CVEs / Security advisories</h2>
  <% if @advisories&.any? %>
    <ul>
      <% @advisories.each do |adv| %>
        <li>
          <% if adv.nvd_url %>
            <%= link_to adv.identifier, adv.nvd_url, target: "_blank" %>
          <% else %>
            <%= adv.identifier %>
          <% end %>
          <small><%= adv.severity %></small>
          <small><%= adv.published_at&.strftime("%Y-%m-%d") %></small>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No CVEs cross-referenced yet.</p>
  <% end %>
  <%= button_to "Cross-reference with NVD", crossref_cves_port_path(@port), method: :post %>

  <h2>MASTER review</h2>
  <p>Scan <code>Makefile</code> and patches for quality issues.</p>
  <%= button_to "Run MASTER review", review_port_path(@port), method: :post %>

  <nav role="navigation" aria-label="Port actions">
    <% if authenticated? %>
      <%= render "ports/watch_toggle", port: @port, watching: @watching %>
    <% end %>
  </nav>
</article>

<section id="comments" role="region" aria-label="Comments">
  <h2>Comments</h2>
  <div id="port_comments">
    <%= render @comments %>
  </div>
  <% if authenticated? %>
    <%= form_with url: port_comments_path(@port), id: "port_comment_form", data: { turbo: true } do |f| %>
      <p><%= f.text_area :content, rows: 3, placeholder: "Add a comment…", data: { controller: "char-counter", "char-counter-max-value": 1000 } %><span class="char-counter" data-char-counter-target="counter"></span></p>
      <p><%= f.submit "Comment" %></p>
    <% end %>
  <% end %>
</section>
