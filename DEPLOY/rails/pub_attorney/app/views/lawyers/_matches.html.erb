<% if lawyers.any? %>
  <ul role="list" aria-label="Matching lawyers">
    <% lawyers.each do |lawyer| %>
      <li>
        <%= link_to lawyer.name, lawyer_path(lawyer) %>
        — <%= lawyer.specialty %> (<%= lawyer.rating %>/5)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No matching lawyers found.</p>
<% end %>