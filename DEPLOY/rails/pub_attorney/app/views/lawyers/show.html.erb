<% content_for :title, @lawyer.name %>

<article role="article" aria-label="Lawyer profile">
  <header>
    <h1><%= @lawyer.name %></h1>
    <p><strong>Specialty:</strong> <%= @lawyer.specialty %></p>
    <p><strong>Bar #:</strong> <%= @lawyer.bar_number %></p>
    <p><strong>Rating:</strong> <%= @lawyer.rating %>/5</p>
  </header>
  <p><%= @lawyer.bio %></p>

  <% if @cases.any? %>
    <section aria-label="Recent cases">
      <h2>Recent cases</h2>
      <ul role="list">
        <% @cases.each do |legal_case| %>
          <li><%= legal_case.title %> — <%= legal_case.status %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</article>