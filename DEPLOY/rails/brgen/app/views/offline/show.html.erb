<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>Offline</title>
  <style>
    body { margin: 0; min-height: 100dvh; background: #000; color: #fff; font-family: system-ui, sans-serif; padding: 2rem 1.25rem; }
    main { max-width: 40rem; margin: 0 auto; }
    ul { list-style: none; padding: 0; }
    li { padding: 0.65rem 0; border-bottom: 1px solid rgba(255,255,255,.08); }
    li span { display: block; opacity: .65; font-size: .85rem; }
    a { color: #8ec5ff; }
  </style>
</head>
<body>
  <main>
    <h1>You're offline</h1>
    <p>The app shell is cached. Reconnect to load fresh content.</p>
    <section hidden data-controller="offline-feed-cache" data-offline-feed-cache-keys-value='["brgen-posts","blognet-posts","amber-items","posts"]' data-offline-feed-cache-target="section">
      <h2>Recently cached</h2>
      <ul data-offline-feed-cache-target="list"></ul>
    </section>
    <p><a href="/">Try again</a></p>
  </main>
</body>
</html>