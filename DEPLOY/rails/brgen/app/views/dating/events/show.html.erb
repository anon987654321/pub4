<% content_for :title, @event.title %>

<article>
  <h1><%= @event.title %></h1>
  <p class="dim"><%= @event.starts_at.strftime("%A %d %B %Y %H:%M") %></p>
  <p class="dim"><%= [@event.venue, @event.city].compact.join(" · ") %></p>
  <p><%= simple_format(@event.description.to_s) %></p>
  <span class="chip"><%= pluralize(@event.rsvps.count, "RSVP") %></span>

  <% if authenticated? %>
    <div style="margin-top:12px;display:flex;gap:8px">
      <%= button_to "Going", rsvp_dating_event_path(@event), params: { status: "going" }, class: "btn btn-primary btn-sm" %>
      <%= button_to "Interested", rsvp_dating_event_path(@event), params: { status: "interested" }, class: "btn btn-ghost btn-sm" %>
    </div>
    <% if @rsvp %>
      <p class="dim" style="margin-top:8px">Your RSVP: <%= @rsvp.status %></p>
    <% end %>
  <% end %>
</article>