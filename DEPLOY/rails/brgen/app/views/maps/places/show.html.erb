<% content_for :title, @place.name %>

<div class="page-header" role="banner" aria-label="Place details header">
  <h1><%= @place.name %></h1>
  <nav role="navigation" aria-label="Place navigation">
    <%= link_to "Back", :back, class: "btn" %>
  </nav>
</div>

<article class="place" role="article" aria-label="Place information">
  <dl role="list">
    <dt>Type</dt>
    <dd><%= @place.kind %></dd>
    <% if @place.city %>
      <dt>City</dt>
      <dd><%= @place.city.name %></dd>
    <% end %>
    <% if @place.neighborhood %>
      <dt>Neighborhood</dt>
      <dd><%= @place.neighborhood.name %></dd>
    <% end %>
    <dt>Coordinates</dt>
    <dd><%= @place.latitude %>, <%= @place.longitude %></dd>
  </dl>

  <p>
    <%= link_to "Open in map",
        "https://www.openstreetmap.org/?mlat=#{@place.latitude}&mlon=#{@place.longitude}#map=16/#{@place.latitude}/#{@place.longitude}",
        class: "btn", target: "_blank", rel: "noopener" %>
    <% if authenticated? %>
      <%= button_to "I'm here (check-in)", "#", class: "btn", form: { data: { turbo: true } } %> <!-- stub for AN625 -->
    <% end %>
  </p>
</article>
