<% content_for :title, "##{@hashtag.name}" %>

<%= turbo_frame_tag "tag-feed" do %>
  <header>
    <h1>##<%= @hashtag.name %></h1>
    <p class="dim"><%= pluralize(@posts.size, "post") %> tagged here</p>
  </header>

  <% if @posts.any? %>
    <div class="post-grid">
      <% @posts.each do |post| %>
        <div data-controller="offline-feed" data-offline-feed-key-value="brgen-posts" data-offline-feed-title-value="<%= post.title %>" data-offline-feed-url-value="<%= post_url(post) %>" data-offline-feed-meta-value="<%= [post.author_name, l(post.created_at, format: :short)].join(" · ") %>">
          <%= render "posts/post", post: post %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No posts tagged yet.</p>
  <% end %>
<% end %>

<aside>
  <h3>Trending tags</h3>
  <ul>
    <% @trending_tags.each do |tag| %>
      <li><%= link_to "##{tag.name}", tag_path(tag.name) %> <span class="dim">(<%= tag.usage_count %>)</span></li>
    <% end %>
  </ul>
</aside>
