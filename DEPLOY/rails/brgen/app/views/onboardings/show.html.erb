<% content_for :title, "Onboarding" %>

<%= turbo_frame_tag "onboarding" do %>
  <div class="page-header">
    <p class="dim">Step <%= @step %> of 3</p>
    <h1>Personalize Brgen</h1>
  </div>

  <% case @step %>
  <% when 1 %>
    <%= form_with url: onboarding_path, method: :patch do %>
      <%= hidden_field_tag :step, 1 %>
      <p>Pick your city</p>
      <div class="chips">
        <% @cities.each do |city_name, domain| %>
          <label class="chip">
            <%= radio_button_tag :city_domain, domain, @selected_city == domain %>
            <%= city_name %>
          </label>
        <% end %>
      </div>
      <%= submit_tag "Continue", class: "btn btn-primary" %>
    <% end %>
  <% when 2 %>
    <%= form_with url: onboarding_path, method: :patch do %>
      <%= hidden_field_tag :step, 2 %>
      <p>What interests you?</p>
      <div class="chips">
        <% @interests.each do |interest| %>
          <label class="chip">
            <%= check_box_tag "interests[]", interest, @selected_interests.include?(interest) %>
            <%= interest.humanize %>
          </label>
        <% end %>
      </div>
      <%= submit_tag "Continue", class: "btn btn-primary" %>
    <% end %>
  <% when 3 %>
    <%= form_with url: onboarding_path, method: :patch do %>
      <%= hidden_field_tag :step, 3 %>
      <p>Which verticals do you want in your feed?</p>
      <div class="chips">
        <% @verticals.each do |vertical| %>
          <label class="chip">
            <%= check_box_tag "verticals[]", vertical, @selected_verticals.include?(vertical) %>
            <%= vertical.humanize %>
          </label>
        <% end %>
      </div>
      <%= submit_tag "Finish", class: "btn btn-primary" %>
    <% end %>
  <% end %>
<% end %>