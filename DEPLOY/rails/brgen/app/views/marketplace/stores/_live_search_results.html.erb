<% if live_search_query.present? %>
 <p class="dim"><%= @stores.size %> results for "<%= live_search_query %>"</p>
<% end %>

<div class="store-grid" role="list" aria-label="Stores list">
 <% @stores.each do |store| %>
 <article class="store-card">
 <h2><%= link_to store.name, marketplace_shop_path(store.slug) %></h2>
 <% if store.vertical.present? %><p><%= store.vertical.humanize %></p><% end %>
 <% if store.description.present? %><p class="dim"><%= store.description %></p><% end %>
 </article>
 <% end %>
</div>

<% if @stores.empty? %>
 <p class="empty">No stores match this search.</p>
<% end %>