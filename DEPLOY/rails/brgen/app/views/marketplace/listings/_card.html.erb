<div class="deal-card" data-product-id="<%= listing.id %>">
  <a href="<%= marketplace_listing_path(listing) %>" class="deal-card-img">
    <% if listing.photos.attached? %>
      <%= lazy_image_tag listing.photos.first, alt: listing.title, blurhash: listing.photos.first.try(:metadata).try(:[], "blurhash"), class: media_polish_classes(listing.photos.first) %>
    <% else %>
      <span><%= listing.title.first %></span>
    <% end %>
  </a>
  <div class="deal-card-body">
    <p class="deal-card-title"><%= listing.title %></p>
    <% distance_km = local_assigns[:distance_km] %>
    <p class="deal-meta"><%= listing.location %> · <%= listing.condition %><%= " · #{number_with_precision(distance_km, precision: 1)} km away" if distance_km %></p>
    <p class="deal-meta"><%= listing.category&.name %> · <%= pluralize(listing.views_count.to_i, "view") %></p>
    <% if listing.reviews_count.to_i.positive? %>
      <p class="deal-meta"><%= number_with_precision(listing.rating, precision: 1) %> ★ · <%= pluralize(listing.reviews_count, "review") %></p>
    <% end %>
    <p class="deal-price"><%= listing.price_display %></p>
  </div>

  <div class="deal-card-actions">
    <%= link_to "View deal", marketplace_listing_path(listing), class: "deal-cta" %>
    <% if authenticated? %>
      <%= button_to "Add to cart", marketplace_listing_orders_path(listing),
            params: { quantity: 1 },
            class: "btn btn-sm btn-ghost" %>
    <% end %>
  </div>
</div>
