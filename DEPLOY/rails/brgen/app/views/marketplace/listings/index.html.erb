<% content_for :title, "Markedsplass" %>

<% unless authenticated? %>
  <% content_for :splash do %>
    <div>
      <h2>Markedsplass</h2>
      <p class="tagline">Buy and sell in your neighbourhood. Local listings in every city, in every language.</p>
      <div class="chips">
        <span class="chip">list a product</span>
        <span class="chip">browse categories</span>
        <span class="chip">buyer–seller chat</span>
        <span class="chip">geo listings</span>
      </div>
      <p class="hint">tap anywhere to browse · <%= link_to "sign in", new_session_path, class: "link-inherit" %> to sell</p>
    </div>
  <% end %>
<% end %>

<div class="page-header" role="banner" aria-label="Markedsplass header">
  <h1>Markedsplass</h1>
  <nav role="navigation" aria-label="Marketplace actions">
    <%= link_to "Sell", new_marketplace_listing_path, class: "btn btn-sm" if authenticated? %>
    <%= link_to "Saved searches", marketplace_saved_searches_path, class: "btn btn-ghost btn-sm" if authenticated? %>
    <%= link_to "Cart", marketplace_cart_path, class: "btn btn-ghost btn-sm" if authenticated? %>
  </nav>
</div>

<%= live_search_index url: marketplace_listings_path, results_partial: "marketplace/listings/live_search_results", placeholder: "Search deals…", label: "Search marketplace deals", frame_id: "marketplace-listings" do |f| %>
  <%= f.select :category_id,
        options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
        { include_blank: "All categories" }, aria: { label: "Filter by category" } %>
  <%= f.number_field :lat, value: @search_lat, step: "0.000001", placeholder: "Latitude", aria: { label: "Latitude" } %>
  <%= f.number_field :lng, value: @search_lng, step: "0.000001", placeholder: "Longitude", aria: { label: "Longitude" } %>
  <%= f.number_field :radius_km, value: @radius_km, min: 1, max: Marketplace::Listing::MAX_RADIUS_KM, step: 1, placeholder: "Radius km", aria: { label: "Radius in kilometres" } %>
<% end %>

<% content_for :widgets do %>
  <%= render "shared/affiliate_deals", category: params[:category_id] %>
  <%= render "shared/newsletter_cta" %>
<% end %>
