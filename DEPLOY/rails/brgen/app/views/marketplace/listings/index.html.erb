<% content_for :title, "Markedsplass" %>

<% unless authenticated? %>
  <% content_for :splash do %>
    <div>
      <h2>Markedsplass</h2>
      <p class="tagline">Buy and sell in your neighbourhood. Local listings in every city, in every language.</p>
      <div class="chips">
        <span class="chip">list a product</span>
        <span class="chip">browse categories</span>
        <span class="chip">buyer–seller chat</span>
        <span class="chip">geo listings</span>
      </div>
      <p class="hint">tap anywhere to browse · <%= link_to "sign in", new_session_path, style: "color:inherit" %> to sell</p>
    </div>
  <% end %>
<% end %>

<div class="page-header">
  <h1>Markedsplass</h1>
  <%= link_to "Sell", new_marketplace_listing_path, class: "btn btn-sm" if authenticated? %>
</div>

<div class="deal-search">
  <%= form_with url: marketplace_listings_path, method: :get, local: true do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Search deals…" %>
    <%= f.submit "Search", class: "btn btn-sm" %>
  <% end %>
</div>

<% if @categories.any? %>
  <div class="deal-cats">
    <%= link_to "All", marketplace_listings_path, class: "deal-cat#{" active" unless params[:category]}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat.name, marketplace_category_path(cat), class: "deal-cat#{" active" if params[:category] == cat.slug}" %>
    <% end %>
  </div>
<% end %>

<% if @listings.any? %>
  <div class="deal-grid">
    <% @listings.each do |l| %>
      <div class="deal-card">
        <a href="<%= marketplace_listing_path(l) %>" class="deal-card-img">
          <% if l.photos.attached? %>
            <%= image_tag l.photos.first, alt: l.title %>
          <% end %>
        </a>
        <div class="deal-card-body">
          <p class="deal-card-title"><%= l.title %></p>
          <p class="deal-meta"><%= l.location %> · <%= l.condition %></p>
          <p class="deal-price"><%= l.price_display %></p>
        </div>
        <%= link_to "View deal", marketplace_listing_path(l), class: "deal-cta" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty"><p>No listings yet. <%= link_to("Sell something", new_marketplace_listing_path) if authenticated? %></p></div>
<% end %>

<%= @pagy.series_nav if @pagy&.pages.to_i > 1 %>
