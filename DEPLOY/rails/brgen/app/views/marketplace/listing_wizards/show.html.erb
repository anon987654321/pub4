<% content_for :title, "New listing" %>

<%= turbo_frame_tag "listing_wizard" do %>
  <div class="page-header">
    <p class="dim">Marketplace wizard · <%= @step.humanize %></p>
    <h1>Create listing</h1>
  </div>

  <%= form_with scope: :marketplace_listing, url: marketplace_listing_wizard_path, method: :patch,
                data: { controller: "offline-draft", offline_draft_key_value: "marketplace-listing-wizard", action: "input->offline-draft#save" } do |f| %>
    <%= hidden_field_tag :step, @step %>

    <% case @step %>
    <% when "category" %>
      <div class="field"><%= f.label :category_id, "Category" %><%= f.collection_select :category_id, @categories, :id, :name, { selected: @draft["category_id"], include_blank: "—" } %></div>
    <% when "photos" %>
      <p class="dim">Photo upload attaches on the review step in this stub wizard.</p>
    <% when "details" %>
      <div class="field"><%= f.label :title %><%= f.text_field :title, value: @draft["title"] %></div>
      <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 4, value: @draft["description"] %></div>
      <div class="field"><%= f.label :condition %><%= f.select :condition, Marketplace::Listing::CONDITIONS, { selected: @draft["condition"], include_blank: "—" } %></div>
    <% when "price" %>
      <div class="field"><%= f.label :price_cents, "Price (øre)" %><%= f.number_field :price_cents, value: @draft["price_cents"] %></div>
    <% when "location" %>
      <div class="field"><%= f.label :location %><%= f.text_field :location, value: @draft["location"] %></div>
    <% when "review" %>
      <article>
        <h2><%= @draft["title"] || "Untitled listing" %></h2>
        <p><%= @draft["description"] %></p>
        <p class="dim"><%= @draft["price_cents"] %> øre · <%= @draft["location"] %></p>
      </article>
      <%= render "shared/errors", object: @listing if @listing&.errors&.any? %>
    <% end %>

    <div class="field">
      <%= f.submit (@step == "review" ? "Publish listing" : "Continue"), class: "btn btn-primary" %>
      <span class="dim" data-offline-draft-target="status"></span>
    </div>
  <% end %>
<% end %>