<% content_for :title, t("marketplace.deals.title", default: "Deals") %>

<%= tag.section class: "marketplace-deals", role: "region", "aria-label": "Marketplace deals" do %>
  <%= tag.header role: "banner", "aria-label": "Deals header" do %>
    <%= tag.h1 t("marketplace.deals.title", default: "Deals") %>
  <% end %>

  <%= live_search_index url: marketplace_deals_path, results_partial: "marketplace/deals/live_search_results", placeholder: "Search deals…", label: "Deals search", frame_id: "marketplace-deals" %>
<% end %>