<% unless authenticated? %>
  <% content_for :splash do %>
    <div>
      <h2 id="splash-title">Brgen</h2>
      <p class="tagline">City-native social. Post, vote, discover local communities across Europe and beyond.</p>
      <nav role="navigation" class="chips" aria-label="Quick links">
        <span class="chip"><%= link_to "sign in", new_session_path %></span>
        <span class="chip">markedsplass</span>
        <span class="chip">tv</span>
        <span class="chip">dating</span>
        <span class="chip">playlist</span>
        <span class="chip">takeaway</span>
      </nav>
      <p class="hint">tap anywhere to browse · <%= link_to "sign in", new_session_path %> to post</p>
    </div>
  <% end %>
<% end %>

<% content_for :widgets do %>
  <aside class="sidebar-card" data-controller="toggle" data-toggle-class="hidden">
    <div class="row-between">
      <h3>Communities</h3>
      <button type="button" class="btn btn-ghost btn-sm" data-action="click->toggle#toggle" aria-label="Toggle communities">Hide</button>
    </div>
    <ul data-toggle-target="item">
      <% @communities.each do |c| %>
        <li><%= link_to c.name, community_path(c) %></li>
      <% end %>
    </ul>
    <% if authenticated? %>
      <p><%= link_to "+ New community", new_community_path, class: "btn btn-ghost btn-sm" %></p>
    <% end %>
  </aside>
<% end %>

<nav class="sort-tabs" aria-label="Sort posts" role="tablist" data-controller="tabs">
  <%= link_to "Hot", root_path(anchor: "hot"), class: "sort-tab active", id: "hot-tab", role: "tab", aria: { selected: true }, data: { tabs_target: "tab", tabs_hash_value: "#hot", action: "click->tabs#select" } %>
  <%= link_to "Latest", posts_path(sort: "fresh", anchor: "latest"), class: "sort-tab", id: "latest-tab", role: "tab", aria: { selected: false }, data: { tabs_target: "tab", tabs_hash_value: "#latest", action: "click->tabs#select" } %>
</nav>

<section id="feed-panel" role="tabpanel" aria-labelledby="hot-tab" data-tabs-target="panel">
<% if @posts.any? %>
  <div class="post-grid">
    <% @posts.each do |post| %>
      <%= render "posts/post", post: post %>
    <% end %>
  </div>
<% else %>
  <section class="empty">
    <p>No posts yet. <%= authenticated? ? link_to("Create one", new_post_path) : link_to("Sign in to post", new_session_path) %>.</p>
  </section>
<% end %>
</section>
