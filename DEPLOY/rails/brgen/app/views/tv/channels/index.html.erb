<h1>Channels</h1>
<section>
  <% @channels.each do |c| %>
    <article>
      <%= link_to c.name, tv_channel_path(c) %>
      <small><%= c.subscribers_count %> subscribers<% if c.live? %> · <mark>LIVE</mark><% end %></small>
    </article>
  <% end %>
</section>
<%= @pagy.series_nav if @pagy.pages > 1 %>
