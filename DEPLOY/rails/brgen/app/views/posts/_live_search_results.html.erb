<% if live_search_query.present? %>
 <p class="dim"><%= @posts.size %> results for "<%= live_search_query %>"</p>
<% end %>

<% if @posts.any? %>
 <div class="post-grid">
 <% @posts.each do |post| %>
 <div data-controller="offline-feed" data-offline-feed-key-value="brgen-posts" data-offline-feed-title-value="<%= post.title %>" data-offline-feed-url-value="<%= post_url(post) %>" data-offline-feed-meta-value="<%= [post.author_name, l(post.created_at, format: :short)].join(" · ") %>">
 <%= render "posts/post", post: post %>
 </div>
 <% end %>
 </div>
<% else %>
 <p class="empty">No posts match this search.</p>
<% end %>