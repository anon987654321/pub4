<%= turbo_stream_from "posts" %>

<header>
  <h1>All posts</h1>
  <% if authenticated? %><%= link_to "+ New post", new_post_path %><% end %>
</header>

<nav role="navigation">
  <%= link_to "hot",   posts_path,                class: ("active" unless params[:sort]) %>
  <%= link_to "fresh", posts_path(sort: "fresh"), class: ("active" if params[:sort] == "fresh") %>
  <%= link_to "top",   posts_path(sort: "top"),   class: ("active" if params[:sort] == "top") %>
</nav>

<% if @posts.any? %>
    <div class="post-grid">
      <% @posts.each do |post| %>
      <div data-controller="offline-feed" data-offline-feed-key-value="brgen-posts" data-offline-feed-title-value="<%= post.title %>" data-offline-feed-url-value="<%= post_url(post) %>" data-offline-feed-meta-value="<%= [post.author_name, l(post.created_at, format: :short)].join(" · ") %>">
        <%= render "posts/post", post: post %>
      </div>
      <% end %>
    </div>
<% else %>
  <p>No posts yet.</p>
<% end %>

<aside>
  <h3>Communities</h3>
  <ul>
    <% Community.popular.limit(8).each do |c| %>
      <li><%= link_to c.name, community_path(c) %></li>
    <% end %>
  </ul>
</aside>
