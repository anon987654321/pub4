<% content_for :title, @restaurant.name %>

<div class="page-header">
  <h1><%= @restaurant.name %></h1>
  <%= link_to "Edit", edit_takeaway_restaurant_path(@restaurant), class: "btn btn-ghost btn-sm" if authenticated? && Current.user == @restaurant.user %>
</div>

<article>
  <p><%= @restaurant.description %></p>
  <p class="dim"><%= @restaurant.cuisine_type %> · <%= @restaurant.address %>, <%= @restaurant.city %></p>
  <p class="dim">Min order: <%= @restaurant.min_order_cents.to_i / 100.0 %> NOK · Delivery: <%= @restaurant.delivery_fee_cents.to_i / 100.0 %> NOK</p>
</article>

<% if authenticated? && Current.user == @restaurant.user %>
  <div style="padding:16px;border-bottom:1px solid var(--border)">
    <p style="font-size:20px;font-weight:800;margin-bottom:12px">Add menu item</p>
    <div class="form-wrap" style="padding:0">
      <%= form_with url: takeaway_restaurant_menu_items_path(@restaurant) do |f| %>
        <div class="field"><input name="takeaway_menu_item[name]" placeholder="Name" required class=""></div>
        <div class="field"><input name="takeaway_menu_item[price_cents]" type="number" placeholder="Price (øre)" required></div>
        <div class="field"><input name="takeaway_menu_item[description]" placeholder="Description"></div>
        <div class="field"><button type="submit" class="btn btn-primary btn-sm">Add</button></div>
      <% end %>
    </div>
  </div>
<% end %>

<div style="padding:16px;border-bottom:1px solid var(--border)">
  <p style="font-size:20px;font-weight:800;margin-bottom:12px">Menu</p>
  <% if authenticated? %>
    <%= form_with url: takeaway_restaurant_orders_path(@restaurant) do |f| %>
      <% @menu_items.each do |item| %>
        <article style="display:flex;align-items:center;justify-content:space-between">
          <div>
            <strong><%= item.name %></strong> · <%= item.price_display %>
            <% if item.description.present? %><p class="dim"><%= item.description %></p><% end %>
          </div>
          <input type="number" name="takeaway_order[items][<%= item.id %>]" min="0" value="0" style="width:60px">
        </article>
      <% end %>
      <div class="field" style="margin-top:12px"><input name="takeaway_order[delivery_address]" placeholder="Delivery address" required></div>
      <div class="field"><textarea name="takeaway_order[special_instructions]" placeholder="Special instructions (optional)"></textarea></div>
      <div class="field"><button type="submit" class="btn btn-primary">Place order</button></div>
    <% end %>
  <% else %>
    <p><%= link_to "Sign in to order", new_session_path %></p>
  <% end %>
</div>
