<% content_for :title, @track.title %>

<div class="page-header">
  <div>
    <p class="dim">Hosted track</p>
    <h1><%= @track.title %></h1>
    <p class="dim"><%= @track.artist.presence || "Unknown artist" %> · <%= track.duration_formatted %></p>
  </div>
  <% if authenticated? %>
    <div class="cluster">
      <%= link_to "Edit", edit_playlist_hosted_track_path(@track), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Delete", playlist_hosted_track_path(@track), method: :delete, data: { turbo_confirm: "Delete?" }, class: "btn btn-danger btn-sm" %>
    </div>
  <% end %>
</div>

<article>
  <% if @track.audio_file.attached? %>
    <%= audio_tag url_for(@track.audio_file), controls: true %>
  <% elsif @track.source_url.present? %>
    <p><%= link_to "Open source", @track.source_url, rel: "noopener" %></p>
  <% end %>
  <% if @track.artwork.attached? %>
    <%= image_tag @track.artwork, alt: @track.title, class: "track-artwork" %>
  <% end %>
</article>

<% if @comments.any? %>
  <section>
    <h2>Timestamped comments</h2>
    <% @comments.each do |comment| %>
      <article>
        <p class="dim"><%= comment.timestamp %>s</p>
        <p><%= comment.body %></p>
      </article>
    <% end %>
  </section>
<% end %>