<% content_for :title, "Sets" %>

<div class="page-header">
  <div>
    <p class="dim">Local audio collections</p>
    <h1>Sets</h1>
  </div>
  <%= link_to "New set", new_playlist_set_path, class: "btn btn-primary btn-sm" if authenticated? %>
</div>

<%= live_search_form url: playlist_sets_path, placeholder: "Search sets, tracks, artists…", label: "Playlist search" %>

<div id="live_search_results">
  <%= render "playlist/sets/live_search_results" %>
</div>