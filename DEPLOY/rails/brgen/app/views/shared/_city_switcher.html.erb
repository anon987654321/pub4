<div class="city-switcher" data-controller="city-switcher">
  <label for="city-switcher-select" class="dim">City</label>
  <select id="city-switcher-select"
          data-city-switcher-target="select"
          data-url="<%= city_path %>"
          data-action="change->city-switcher#switch">
    <% Brgen::DomainRegistry::ENTRIES.sort_by(&:city).each do |entry| %>
      <option value="<%= entry.domain %>" <%= "selected" if (session[:city_override_domain] || Current.domain) == entry.domain %>>
        <%= entry.city %>
      </option>
    <% end %>
  </select>
</div>