<%= form_with url: votes_path(votable_type: votable.class.name, votable_id: votable.id), method: :post do |f| %>
  <%= f.hidden_field :value, value: 1 %>
  <%= f.button "▲", type: :submit %>
<% end %>
<span><%= votable.score %></span>
<%= form_with url: votes_path(votable_type: votable.class.name, votable_id: votable.id), method: :post do |f| %>
  <%= f.hidden_field :value, value: -1 %>
  <%= f.button "▼", type: :submit %>
<% end %>
