<% if query.present? %>
  <p class="search-meta dim">
    <%= pluralize(search_meta[:result_count].to_i, "result") %>
    <% if search_meta[:latency_ms].to_i.positive? %>
      · <%= search_meta[:latency_ms] %>ms
    <% end %>
  </p>
<% end %>

<% if results.any? %>
  <% groups.each do |group_name, group_results| %>
    <% next if group_results.blank? %>
    <section class="search-group">
      <h2><%= group_name.to_s.humanize %></h2>
      <% group_results.each do |result| %>
        <article>
          <%= link_to result.title, result.url %>
          <% if result.subtitle.present? %>
            <p class="dim"><%= result.subtitle %></p>
          <% end %>
        </article>
      <% end %>
    </section>
  <% end %>
<% elsif query.present? %>
  <%= render "shared/search_empty", query: query, search_meta: search_meta %>
<% else %>
  <div class="empty"><p>Search across all Brgen verticals from one place.</p></div>
<% end %>