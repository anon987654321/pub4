<% content_for :title, "Search" %>

<header class="page-header">
  <h1>Search Brgen</h1>
</header>

<div data-controller="live-search" role="search" aria-label="Search all verticals">
  <%= form_with url: global_search_path, method: :get, data: { turbo_frame: "live_search_results" } do |f| %>
    <%= f.search_field :q, value: @query, placeholder: "Search posts, listings, TV, playlists…",
          data: { live_search_target: "input", action: "input->live-search#input" } %>
    <%= f.submit "Search", class: "btn btn-sm" %>
  <% end %>
</div>

<%= render "shared/search_suggestions", suggestions: search_suggestions %>

<turbo-frame id="live_search_results">
  <% if @query.present? %>
    <% @results.each do |vertical, records| %>
      <% next if records.blank? %>
      <section>
        <h2><%= vertical.to_s.humanize %></h2>
        <ul>
          <% records.limit(8).each do |record| %>
            <li><%= record.try(:title) || record.try(:name) %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</turbo-frame>