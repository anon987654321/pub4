<%# PWA install prompt — shown after third visit when beforeinstallprompt fires %>
<div id="install-prompt" class="install-prompt" hidden data-controller="install-prompt">
  <strong>Install this app</strong>
  <p>Get quicker access from your home screen.</p>
  <div class="install-prompt__actions">
    <button type="button" class="install-prompt__secondary" data-action="click->install-prompt#dismiss">Not now</button>
    <button type="button" class="install-prompt__primary" data-action="click->install-prompt#install">Install</button>
  </div>
</div>