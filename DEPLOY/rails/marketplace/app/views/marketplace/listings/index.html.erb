<h1>Marketplace Deals</h1>

<div
  data-controller="live-search"
  data-live-search-url-value="<%= marketplace_listings_path %>">

  <input
    data-live-search-target="input"
    placeholder="Search deals..." />

  <div data-live-search-target="results">
    <% @listings.each do |listing| %>
      <%= render partial: "listing_card", locals: { listing: listing } %>
    <% end %>
  </div>
</div>
