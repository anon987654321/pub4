<h1>New post on <%= @blog.name %></h1>
<p><strong><%= @post.title %></strong></p>
<p><%= @post.body.to_plain_text.truncate(400) %></p>
<p><a href="<%= blog_post_url(@blog, @post) %>">Read full post</a></p>
<p><small><a href="<%= newsletter_subscription_url(@subscription.token) %>">Unsubscribe</a></small></p>