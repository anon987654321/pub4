<% content_for :title, "Tags" %>

<header class="page-header">
  <h1>Tags</h1>
</header>

<%= live_search_form url: tags_path, placeholder: "Search tags…", label: "Tag search", show_submit: false %>

<turbo-frame id="live_search_results">
  <ul>
    <% @tags.each do |tag| %>
      <li><%= tag.name %></li>
    <% end %>
  </ul>
  <%= pagy_nav(@pagy) if @pagy.pages > 1 %>
</turbo-frame>