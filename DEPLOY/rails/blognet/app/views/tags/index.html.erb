<% content_for :title, "Tags" %>

<header>
  <h1>Tags</h1>
</header>

<div data-controller="live-search"
     data-live-search-url-value="<%= autocomplete_tags_path(format: :json) %>"
     data-live-search-delay-value="250"
     data-live-search-min-length-value="2">
  <%= render "shared/search_loading" %>
  <%= form_with url: tags_path, method: :get, local: true,
        data: { turbo_frame: "live_search_results" } do |f| %>
    <div class="search-form" role="search">
      <%= f.search_field :q, value: params[:q], placeholder: "Search tags…", list: "tag-suggestions",
            data: { live_search_target: "input", action: "input->live-search#input" } %>
      <%= f.submit "Search", class: "btn btn-sm" %>
    </div>
  <% end %>
  <datalist id="tag-suggestions" data-live-search-target="results"></datalist>

  <%= turbo_frame_tag "live_search_results" do %>
    <section id="tags">
      <% @tags.each do |tag| %>
        <%= render "tags/tag", tag: tag %>
      <% end %>
    </section>
    <% if @tags.empty? && params[:q].present? %>
      <%= render "shared/search_empty", query: params[:q], search_meta: search_meta %>
    <% end %>
    <%= @pagy.series_nav if @pagy.pages > 1 %>
  <% end %>
</div>