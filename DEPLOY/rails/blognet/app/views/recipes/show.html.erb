<% content_for :title, @recipe.title %>
<%= json_ld_for(@recipe, type: :recipe) if respond_to?(:json_ld_for) %>

<article itemscope itemtype="https://schema.org/Recipe">
  <h1 itemprop="name"><%= @recipe.title %></h1>
  <p itemprop="description"><%= @recipe.description %></p>
  <p class="dim">
    Prep <%= @recipe.prep_time_minutes %>m · Cook <%= @recipe.cook_time_minutes %>m · Serves <%= @recipe.servings %>
  </p>

  <h2>Ingredients</h2>
  <ul>
    <% @recipe.recipe_ingredients.each do |ing| %>
      <li itemprop="recipeIngredient"><%= [ing.quantity, ing.unit, ing.name].compact.join(" ") %></li>
    <% end %>
  </ul>
</article>