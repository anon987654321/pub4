<% content_for :title, "Posts · #{@blog.name}" %>

<header role="banner" aria-label="Blog posts header">
  <h1><%= @blog.name %></h1>
  <p><%= @blog.description %></p>
  <nav role="navigation" aria-label="Blog actions">
    <% if @blog.user == Current.user %>
      <%= link_to "New post", new_blog_post_path(@blog) %>
    <% end %>
  </nav>
</header>

<%= live_search_index url: blog_posts_path(@blog), results_partial: "posts/live_search_results", placeholder: "Search posts…", label: "Post search", frame_id: "blognet-posts" %>