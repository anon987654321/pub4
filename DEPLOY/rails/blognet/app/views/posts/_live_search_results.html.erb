<section id="posts">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <%= render "posts/row", post: post, blog: @blog %>
    <% end %>
  <% else %>
    <p>No posts published yet.</p>
  <% end %>
</section>

<%= render "shared/infinite_scroll_sentinel",
           pagy: @pagy,
           reflex: "PostsInfiniteScrollReflex#load_more",
           sentinel_id: "blognet-posts-sentinel",
           blog_id: @blog.id %>