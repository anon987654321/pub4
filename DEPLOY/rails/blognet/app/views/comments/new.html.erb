<% content_for :title, "Comment on #{@post.title}" %>

<h1>Comment</h1>
<%= render "shared/errors", object: @comment %>
<%= form_with url: blog_post_comments_path(@blog, @post), data: { turbo: true } do |f| %>
  <p><%= f.text_area :content, rows: 4, placeholder: "Add a comment…", data: { controller: "char-counter", "char-counter-max-value": 1000 } %><span class="char-counter" data-char-counter-target="counter"></span></p>
  <p><%= f.submit "Comment" %></p>
<% end %>
<p><%= link_to "Back to post", [@blog, @post] %></p>