<%= form_with url: url, method: :get, local: true,
      data: data_attrs do |f| %>
  <div class="search-form" role="search">
    <%= f.search_field :q,
          value: query,
          placeholder: placeholder,
          aria: { label: "Search" },
          data: { live_search_target: "input", action: "input->live-search#input" } %>
    <% if facets.present? %>
      <div class="search-facets">
        <% facets.each do |facet| %>
          <%= f.select facet[:name],
                facet[:options],
                { selected: params[facet[:name]], include_blank: facet[:blank] },
                { aria: { label: facet[:label] } } %>
        <% end %>
      </div>
    <% end %>
    <%= f.submit "Search", class: "btn btn-sm" %>
  </div>
<% end %>