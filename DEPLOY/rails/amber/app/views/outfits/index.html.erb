<% content_for :title, "Outfits" %>
<%= turbo_stream_from "outfits" %>

<header role="banner" aria-label="Outfits header">
  <div>
    <p class="dim">Style combinations</p>
    <h1>Outfits</h1>
  </div>
  <nav role="navigation" aria-label="Outfit actions">
    <%= link_to "New outfit", new_outfit_path, class: "btn" %>
    <%= link_to "Dressing room", dressing_room_outfits_path, class: "btn" %>
    <%= link_to t("amber.nav.ai_suggest", default: "AI outfit suggestions (vision)"), ai_suggest_outfits_path, class: "btn" %>
  </nav>
</header>

<%= live_search_index url: outfits_path, results_partial: "outfits/live_search_results", placeholder: "Search outfits by name, occasion, season, items…", label: "Outfit search", frame_id: "amber-outfits" %>