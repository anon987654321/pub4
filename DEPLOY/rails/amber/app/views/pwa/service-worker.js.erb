<%# Shared Workbox 7 service worker — copy to each app as app/views/pwa/service-worker.js.erb %>
<% app_slug = local_assigns.fetch(:app_slug) { Rails.application.class.module_parent_name.underscore.dasherize } %>
<% cache_version = ENV.fetch("CACHE_VERSION", "1") %>
importScripts("https://storage.googleapis.com/workbox-cdn/releases/7.3.0/workbox-sw.js")

const APP_SLUG = "<%= app_slug %>"
const CACHE_VERSION = "<%= cache_version %>"
const OFFLINE_URL = "/offline"
const CACHE_PREFIX = `${APP_SLUG}-v${CACHE_VERSION}`

workbox.setConfig({ debug: false })
self.skipWaiting()
workbox.core.setCacheNameDetails({ prefix: APP_SLUG, suffix: `v${CACHE_VERSION}` })

const precache = [
  { url: "/", revision: CACHE_VERSION },
  { url: OFFLINE_URL, revision: CACHE_VERSION },
  { url: "/manifest", revision: CACHE_VERSION }
]

workbox.precaching.precacheAndRoute(precache)

workbox.routing.registerRoute(
  ({ request }) => request.destination === "image" || request.destination === "font",
  new workbox.strategies.CacheFirst({
    cacheName: `${CACHE_PREFIX}-static`,
    plugins: [new workbox.expiration.ExpirationPlugin({ maxEntries: 200, maxAgeSeconds: 30 * 24 * 60 * 60 })]
  })
)

workbox.routing.registerRoute(
  ({ request }) => request.destination === "script" || request.destination === "style",
  new workbox.strategies.StaleWhileRevalidate({
    cacheName: `${CACHE_PREFIX}-assets`,
    plugins: [new workbox.expiration.ExpirationPlugin({ maxEntries: 80, maxAgeSeconds: 7 * 24 * 60 * 60 })]
  })
)

const networkFirst = new workbox.strategies.NetworkFirst({
  cacheName: `${CACHE_PREFIX}-pages`,
  networkTimeoutSeconds: 3,
  plugins: [
    new workbox.expiration.ExpirationPlugin({ maxEntries: 40, maxAgeSeconds: 24 * 60 * 60 }),
    {
      handlerDidError: async () => caches.match(OFFLINE_URL)
    }
  ]
})

workbox.routing.registerRoute(({ request }) => request.mode === "navigate", networkFirst)

workbox.routing.setCatchHandler(async ({ event }) => {
  if (event.request.mode === "navigate") return caches.match(OFFLINE_URL)
  return Response.error()
})

self.addEventListener("activate", event => {
  event.waitUntil((async () => {
    const keys = await caches.keys()
    await Promise.all(keys.filter(key => !key.includes(`v${CACHE_VERSION}`)).map(key => caches.delete(key)))
    await self.clients.claim()
    const clients = await self.clients.matchAll({ type: "window" })
    clients.forEach(client => client.postMessage({ type: "RELOAD_SUGGESTED" }))
  })())
})

self.addEventListener("sync", event => {
  if (event.tag === "offline-queue") {
    event.waitUntil(self.clients.matchAll().then(list => list.forEach(c => c.postMessage({ type: "REPLAY_SYNC_QUEUE" }))))
  }
})

self.addEventListener("periodicsync", event => {
  if (event.tag === "feed-prewarm") {
    event.waitUntil(fetch("/").catch(() => {}))
  }
  if (event.tag === "badge-refresh") {
    event.waitUntil(self.registration.getNotifications().then(notes => navigator.setAppBadge?.(notes.length)))
  }
})

self.addEventListener("push", event => {
  const data = event.data?.json() ?? {}
  const title = data.title || "<%= app_slug.titleize %>"
  event.waitUntil(
    self.registration.showNotification(title, {
      body: data.body || "",
      icon: "/icon.png",
      badge: "/icon.png",
      data: { url: data.url || "/" },
      vibrate: [80, 40, 80]
    }).then(() => self.registration.getNotifications())
      .then(notes => navigator.setAppBadge?.(notes.length))
  )
})

self.addEventListener("notificationclick", event => {
  event.notification.close()
  event.waitUntil(
    self.registration.getNotifications()
      .then(notes => navigator.setAppBadge?.(notes.length))
      .then(() => self.clients.matchAll({ type: "window", includeUncontrolled: true }))
      .then(wins => {
        const url = event.notification.data?.url || "/"
        const match = wins.find(w => w.url.includes(url))
        return match ? match.focus() : self.clients.openWindow(url)
      })
  )
})