<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f59e0b" data-light-color="#fef3c7" data-dark-color="#f59e0b">
  <meta name="turbo-cache-control" content="no-preview">
  <%= tag.meta name: "turbo-cache-control", content: "no-cache" %>
  <title><%= content_for?(:title) ? "#{yield :title} — MyToonz" : "MyToonz" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "MyToonz — AI comic strip generator." %>">
  <link rel="canonical" href="<%= request.original_url.split("?").first %>">
  <meta property="og:site_name" content="MyToonz">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "MyToonz" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "AI comic strip generator." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preload" href="/icon.png" as="image">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= json_ld_script(website_json_ld(site_name: "MyToonz", url: root_url, description: "AI comic strip generator.")) %>
  <%= javascript_importmap_tags %>
</head>
<body class="zen-minimal" data-pwa-key="mytoonz" data-controller="pwa-standalone">
<a class="skip-link" href="#main-content">Skip to main content</a>
<nav role="navigation" data-pwa-primary-nav data-turbo-permanent aria-label="Primary navigation">
  <%= link_to "MyToonz", root_path, class: "brand", aria: { current: current_page?(root_path) ? "page" : nil } %>
  <%= link_to "Gallery", comic_strips_path, aria: { current: current_page?(comic_strips_path) ? "page" : nil } %>
  <% if authenticated? %>
    <%= render "shared/inbox_link" %>
    <%= link_to "Sign out", session_path, data: { turbo_method: :delete, turbo_prefetch: false } %>
  <% else %>
    <%= link_to "Sign in", new_session_path %>
  <% end %>
</nav>
<%= tag.p(notice, role: "status", class: "flash-notice") if notice %>
<%= tag.p(alert, role: "alert", class: "flash-alert") if alert %>
<main id="main-content" role="main"><%= yield %></main>
<%= render "shared/install_prompt" %>
</body>
</html>