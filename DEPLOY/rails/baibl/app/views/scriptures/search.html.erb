<% content_for :title, "Search" %>

<%= live_search_form url: scripture_search_path, placeholder: "Search scripture…", label: "Scripture search" %>

<turbo-frame id="live_search_results">
  <% if live_search_query.present? %>
    <p><%= @pagy.count %> results for "<%= live_search_query %>"</p>
    <% @verses.each do |verse| %>
      <article>
        <p><%= link_to "#{verse.book.abbreviation} #{verse.chapter.number}:#{verse.number}", scripture_chapter_path(verse.book.abbreviation, verse.chapter.number) %></p>
        <p><%= verse.content %></p>
      </article>
    <% end %>
    <%= pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% end %>
</turbo-frame>