<% content_for :title, "Scripture" %>

<%= live_search_index url: scripture_index_path, results_partial: "scriptures/live_search_results", placeholder: "Search scripture…", label: "Scripture search", frame_id: "baibl-scriptures" %>

<nav role="navigation" aria-label="Bible books navigation">
  <% @books.each do |book| %>
    <%= link_to book.abbreviation, scripture_book_path(book.abbreviation), title: book.name %>
  <% end %>
</nav>

<div class="compare-promo">
  <strong>New:</strong> <%= link_to "Multi-tradition Comparisons &amp; Visualizations", scripture_compare_path, 
    "aria-label": "Compare Bible, Quran, Bhagavad Gita and more with parallel views and interactive visualizations" %> 
  — Bible, Quran, Bhagavad Gita + thematic cross-links and concept thread viz.
</div>

<% if @books.any? %>
  <p role="status">Select a book to begin reading. Or explore comparisons above.</p>
<% end %>
