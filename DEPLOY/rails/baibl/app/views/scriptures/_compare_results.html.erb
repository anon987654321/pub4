<% results ||= {} %>
<% cross_links ||= [] %>
<% theme ||= "creation" %>

<div class="compare-header">
  <h2>Results for theme: <em><%= theme %></em></h2>
  <p class="dim">Side-by-side verses from different traditions. Click words for studies (where available). Visualizations below.</p>
</div>

<div class="parallel" role="region" aria-label="Parallel scripture comparison">
  <% results.each do |trad, verses| %>
    <div class="trad-card" data-tradition="<%= trad %>">
      <h4><%= trad.upcase %></h4>
      <% if verses.any? %>
        <% verses.each do |v| %>
          <div class="verse-match">
            <span class="ref"><%= v.book.name %> <%= v.chapter.number %>:<%= v.number %></span>
            <p><%= highlight(v.content, theme) rescue v.content %></p>
            <% if v.cross_references.any? %>
              <small class="dim">Linked to <%= v.cross_references.size %> other tradition(s)</small>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="dim">No direct matches. Explore cross-references below.</p>
      <% end %>
    </div>
  <% end %>
</div>

<div class="viz" role="figure" aria-labelledby="viz-title">
  <div id="viz-title" class="viz-header">Visualization: Thematic Threads &amp; Cross-Tradition Links</div>

  <div class="concept-threads" data-controller="comparison-viz" data-comparison-viz-theme-value="<%= theme %>">
    <% %w[creation love duty light compassion].each do |concept| %>
      <div class="thread" data-concept="<%= concept %>">
        <div class="thread-bar" style="width: <%= 40 + rand(50) %>%"></div>
        <div class="thread-label"><%= concept %> (overlap across texts)</div>
      </div>
    <% end %>
  </div>

  <% if cross_links.any? %>
    <div class="cross-viz" style="margin-top:1rem;">
      <h4>Curated Cross-Tradition Links</h4>
      <ul>
        <% cross_links.each do |xr| %>
          <% v = xr.verse; tv = xr.target_verse %>
          <li>
            <strong><%= v.book.tradition || 'bible' %></strong>: <%= v.reference %> ↔ 
            <strong><%= tv.book.tradition || 'other' %></strong>: <%= tv.reference %>
            <% if xr.kind %>(<span class="xr-kind"><%= xr.kind %></span>)<% end %>
            <br>
            <small><%= truncate(v.content, length: 60) %> … <%= truncate(tv.content, length: 60) %></small>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="dim" style="margin-top:.5rem; font-size:.75rem;">Visualization is interactive (hover/click threads to highlight parallels in future). Data seeded with thematic cross-references.</p>
</div>

<% if results.blank? %>
  <p class="dim">Seed data includes Bible, Quran, and Bhagavad Gita samples. Run <code>bin/rails db:seed</code> after migration for fresh multi-tradition comparisons.</p>
<% end %>
