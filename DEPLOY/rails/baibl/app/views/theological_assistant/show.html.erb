<% content_for :title, "Theological assistant" %>

<h1>Theological assistant</h1>

<%= form_with url: theological_assistant_path, method: :post do |f| %>
  <%= f.text_area :question, value: @question, rows: 3, placeholder: "Ask about doctrine, context, or application…" %>
  <%= f.hidden_field :verse_id, value: @verse&.id %>
  <%= f.submit "Ask", class: "btn btn-primary" %>
<% end %>

<% if @answer %>
  <article>
    <h2><%= @answer[:summary] %></h2>
    <% if @answer[:context].present? %><blockquote><%= @answer[:context] %></blockquote><% end %>
    <% if @answer[:cross_references].any? %>
      <p>Related: <%= @answer[:cross_references].join(", ") %></p>
    <% end %>
    <ul>
      <% @answer[:guidance].each do |tip| %>
        <li><%= tip %></li>
      <% end %>
    </ul>
    <p class="dim"><%= @answer[:disclaimer] %></p>
  </article>
<% end %>