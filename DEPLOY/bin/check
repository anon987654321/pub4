#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../../MASTER/lib/pub4/check_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = RbConfig.ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
runner = Pub4::CheckRunner.new(prefix: "deploy-check", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "identity" unless runner.run("identity", RUBY, "DEPLOY/verify_deploy_identity.rb")
failures << "production" unless runner.run("production", RUBY, "DEPLOY/rails/check_production_gate.rb")
failures << "phantom_fk" unless runner.run("phantom fk", RUBY, "DEPLOY/rails/check_phantom_foreign_keys.rb")
failures << "domain_align" unless runner.run("domain align", RUBY, "DEPLOY/rails/domain_alignment_gate.rb")
failures << "openbsd_smoke" unless runner.run("openbsd smoke", RUBY, "DEPLOY/openbsd/deploy_smoke_gate.rb")

exit(failures.empty? ? 0 : 1)
