#!/usr/bin/env ruby
# frozen_string_literal: true

# relayd-watchdog — restart relayd when unhealthy or backends are stale (CY11).
# Cron: */5 * * * * /usr/local/bin/relayd-watchdog

require "open3"

# The doas.conf "heal" that used to live here ran, as root every 5 minutes,
#   ksh /home/dev/pub4/OPENBSD/validate_doas.ksh install /home/dev/pub4/OPENBSD/etc/doas.conf
# — root executing a script AND installing a doas.conf from a dev-owned git
# checkout, i.e. root code execution on the next tick for anyone who can write
# either file, plus a silent revert of any hand-hardening of /etc/doas.conf.
# stale_ci_cleanup.ksh dropped the identical pattern for the same reason; this
# watchdog and config-drift-check were the two survivors. doas policy is now
# only installed deliberately by OPERATOR.sh (root-run), never auto-synced from
# a user-writable tree. See OPENBSD/data/debt.yml root_dot_sources_dev_owned_repo.

BACKENDS = {
  "brgen" => 38182,
  "amber" => 61352,
  "master" => 53187,
  "bsdports" => 47312
}.freeze

def run(*cmd)
  out, status = Open3.capture2e(*cmd)
  [status.success?, out.strip]
end

def log(message)
  system("logger", "-t", "relayd-watchdog", message)
  warn message
end

def relayd_running?
  ok, out = run("/usr/sbin/rcctl", "check", "relayd")
  ok && out.include?("(ok)")
end

def restart_relayd(reason)
  log("#{reason} — restarting relayd")
  run("/usr/sbin/rcctl", "restart", "relayd")
end

def backend_live?(port)
  ok, = run("/usr/local/bin/curl", "-fsS", "--max-time", "5", "http://127.0.0.1:#{port}/up")
  ok
end

def stale_backends
  ok, out = run("/usr/sbin/relayctl", "show", "hosts")
  return [] unless ok

  stale = []
  current = nil
  out.each_line do |line|
    if (match = line.match(/table\s+(\w+):(\d+)\s+(active|empty)/))
      name, port, state = match.captures
      current = { name: name, port: port.to_i, state: state }
      next
    end
    next unless current
    if line.include?("down") || current[:state] == "empty"
      stale << current if backend_live?(current[:port])
    end
    current = nil if line.include?("total:")
  end
  stale.uniq { |entry| entry[:name] }
end

unless relayd_running?
  restart_relayd("relayd check failed")
  exit 0
end

stale = stale_backends
if stale.any?
  names = stale.map { |entry| entry[:name] }.join(", ")
  restart_relayd("stale relayd tables (#{names}) with live /up backends")
  sleep 3
  _, hosts = run("/usr/sbin/relayctl", "show", "hosts")
  log(hosts) unless hosts.empty?
end

exit 0
