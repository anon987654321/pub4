#!/usr/bin/env ruby
# frozen_string_literal: true

# relayd-watchdog — restart relayd when unhealthy or backends are stale (CY11).
# Cron: */5 * * * * /usr/local/bin/relayd-watchdog

require "open3"

# The doas.conf "heal" that used to live here ran, as root every 5 minutes,
#   ksh /home/dev/pub4/OPENBSD/validate_doas.ksh install /home/dev/pub4/OPENBSD/etc/doas.conf
# — root executing a script AND installing a doas.conf from a dev-owned git
# checkout, i.e. root code execution on the next tick for anyone who can write
# either file, plus a silent revert of any hand-hardening of /etc/doas.conf.
# stale_ci_cleanup.ksh dropped the identical pattern for the same reason; this
# watchdog and config-drift-check were the two survivors. doas policy is now
# only installed deliberately by OPERATOR.sh (root-run), never auto-synced from
# a user-writable tree. See TODO.md root_dot_sources_dev_owned_repo.

# No port table here: stale_backends reads each table's name and port from
# `relayctl show hosts`, so relayd.conf is the only list this watchdog follows.

def run(*cmd)
  out, status = Open3.capture2e(*cmd)
  [status.success?, out.strip]
end

def log(message)
  system("logger", "-t", "relayd-watchdog", message)
  warn message
end

def relayd_running?
  ok, out = run("/usr/sbin/rcctl", "check", "relayd")
  ok && out.include?("(ok)")
end

# A restart that works is the symptom healed, and a symptom that keeps coming back
# is a fault the heal is hiding. Every restart is stamped; when RESTART_ALERT_AT of
# them fall inside RESTART_WINDOW seconds, pub4-alert records one durable line that
# says what to read. Alert failures never stop the restart itself.
RESTART_STATE = ENV.fetch("PUB4_WATCHDOG_STATE", "/var/db/pub4/relayd-watchdog.restarts")
RESTART_WINDOW = Integer(ENV.fetch("PUB4_WATCHDOG_WINDOW", "3600"))
RESTART_ALERT_AT = Integer(ENV.fetch("PUB4_WATCHDOG_ALERT_AT", "3"))
ALERT = ENV.fetch("PUB4_ALERT", "/usr/local/bin/pub4-alert")

def recent_restarts(now: Time.now.to_i)
  File.readlines(RESTART_STATE, chomp: true).filter_map { |l| Integer(l, exception: false) }.select { |t| now - t < RESTART_WINDOW }
rescue SystemCallError
  []
end

def record_restart(reason, now: Time.now.to_i)
  stamps = recent_restarts(now: now) + [now]
  File.write(RESTART_STATE, stamps.join("\n") + "\n")
  return stamps.size if stamps.size < RESTART_ALERT_AT

  run(ALERT, "raise", "relayd-restarts",
      "relayd restarted #{stamps.size} times in #{RESTART_WINDOW / 60} minutes (last: #{reason}) - " \
      "the watchdog is hiding a recurring fault; read /var/log/messages and /var/log/daemon, " \
      "then: doas relayctl show hosts; doas relayd -n")
  stamps.size
rescue SystemCallError => e
  log("restart counter unwritable (#{e.class}) - the repeated-restart alert is blind")
  0
end

def restart_relayd(reason)
  log("#{reason} — restarting relayd")
  run("/usr/sbin/rcctl", "restart", "relayd")
  record_restart(reason)
end

def backend_live?(port)
  ok, = run("/usr/local/bin/curl", "-fsS", "--max-time", "5", "http://127.0.0.1:#{port}/up")
  ok
end

def stale_backends
  ok, out = run("/usr/sbin/relayctl", "show", "hosts")
  return [] unless ok

  stale = []
  current = nil
  out.each_line do |line|
    if (match = line.match(/table\s+(\w+):(\d+)\s+(active|empty)/))
      name, port, state = match.captures
      current = { name: name, port: port.to_i, state: state }
      next
    end
    next unless current
    if line.include?("down") || current[:state] == "empty"
      stale << current if backend_live?(current[:port])
    end
    current = nil if line.include?("total:")
  end
  stale.uniq { |entry| entry[:name] }
end

def main
  unless relayd_running?
    restart_relayd("relayd check failed")
    exit 0
  end

  stale = stale_backends
  if stale.any?
    names = stale.map { |entry| entry[:name] }.join(", ")
    restart_relayd("stale relayd tables (#{names}) with live /up backends")
    sleep 3
    _, hosts = run("/usr/sbin/relayctl", "show", "hosts")
    log(hosts) unless hosts.empty?
  end
end

main if $PROGRAM_NAME == __FILE__
