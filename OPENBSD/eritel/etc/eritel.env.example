# Reference only. Copy to /etc/eritel.env manually after review.
# File permissions should be root:eritel 0640.

SECRET_KEY_BASE=replace-me
RAILS_ENV=production
ERITEL_REGISTRY_PROVIDER=disabled
ERITEL_REGISTRY_ENDPOINT=
FALCON_WORKERS=1

# When EriTel authorizes a registry integration, credentials belong here or
# another protected secret store selected by the deployment owner.
# ERITEL_REGISTRY_USERNAME=
# ERITEL_REGISTRY_PASSWORD=
