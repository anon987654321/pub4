#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "time"
require "tmpdir"

root = File.expand_path(ENV.fetch("PUB4_DR_DIR", "~/pub4-dr"))
stamps = Dir.glob(File.join(root, "*")).select { |path| File.directory?(path) }.sort
latest = stamps.reverse.find { |path| !Dir.glob(File.join(path, "*.sqlite3")).empty? }
abort("dr-restore-check: no pulled sqlite database under #{root}") unless latest

source = Dir.glob(File.join(latest, "*.sqlite3")).max_by { |path| File.mtime(path) }
tmp = File.join(Dir.tmpdir, "pub4-restore-#{Process.pid}.sqlite3")
FileUtils.cp(source, tmp)

integrity, integrity_status = Open3.capture2("sqlite3", tmp, "PRAGMA integrity_check;")
abort("dr-restore-check: integrity_check failed: #{integrity.strip}") unless integrity_status.success? && integrity.strip == "ok"

foreign_keys, foreign_status = Open3.capture2("sqlite3", tmp, "PRAGMA foreign_key_check;")
abort("dr-restore-check: foreign_key_check failed: #{foreign_keys.strip}") unless foreign_status.success? && foreign_keys.strip.empty?

# A restored database that can be opened read-write is materially different from
# a file that merely copied. The transaction is rolled back by closing sqlite3
# after the explicit temp-table write.
write, write_status = Open3.capture2e("sqlite3", tmp, <<~SQL)
  BEGIN;
  CREATE TABLE IF NOT EXISTS _pub4_restore_probe (id INTEGER PRIMARY KEY);
  INSERT INTO _pub4_restore_probe DEFAULT VALUES;
  DROP TABLE _pub4_restore_probe;
  ROLLBACK;
SQL
abort("dr-restore-check: read-write probe failed: #{write.strip}") unless write_status.success?

age = ((Time.now - File.mtime(latest)) / 86_400).round(2)
puts "dr-restore-check: ok — restored #{File.basename(source)}, pull age=#{age}d, integrity=ok, foreign_keys=ok, write_probe=ok"
