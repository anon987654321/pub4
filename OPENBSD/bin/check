#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "rbconfig"
require_relative "../../MASTER/lib/pub4/check_runner"
require_relative "../../MASTER/lib/pub4/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Pub4::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
profile = "operator"
OptionParser.new do |parser|
  parser.on("--profile=PROFILE", "contributor or operator (default)") { |value| profile = value }
end.parse!

runner = Pub4::CheckRunner.new(prefix: "deploy-check", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "identity" unless runner.run("identity", RUBY, "OPENBSD/verify_deploy_identity.rb")
failures << "production" unless runner.run("production", RUBY, "RAILS/gates/runner.rb", "production")
failures << "phantom_fk" unless runner.run("phantom fk", RUBY, "RAILS/gates/runner.rb", "phantom_foreign_keys")
failures << "domain_align" unless runner.run("domain align", RUBY, "RAILS/gates/runner.rb", "domain_alignment")
failures << "openbsd_smoke" unless runner.run("openbsd smoke", RUBY, "OPENBSD/deploy_smoke_gate.rb")

# The only copy of production data that leaves vm23 is dr-pull's, and it stopped
# for seven nights without anything noticing. This asks how old the newest pull
# is; it skips on any machine without the directory, so it costs nothing
# anywhere but the operator's Mac, which is the one place it can be true.
failures << "dr_freshness" unless runner.run("dr freshness", RUBY, "OPENBSD/bin/dr-pull", "--check")

# OPENBSD/test was reachable from no entrypoint at all (MASTER/tools/runs.rb):
# four files covering the gate library, health check, restore scripts and the VPS
# safety gate, 80 assertions, running nowhere. They pass, and passing tests that
# never execute prove nothing.
contracts = 'Dir["OPENBSD/test/**/test_*.rb"].sort.each { |file| require File.expand_path(file) }'
failures << "openbsd_contracts" unless runner.run("openbsd contracts", RUBY, "-e", contracts)

if profile == "contributor"
  puts "deploy-check: extended gates     skip — contributor profile (use OPENBSD/bin/check-full for integrity)"
end

exit(failures.empty? ? 0 : 1)
