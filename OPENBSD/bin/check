#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../../MASTER/lib/operator/check_runner"
require_relative "../../MASTER/lib/operator/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Operator::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
profile = "operator"
OptionParser.new do |parser|
  parser.banner = <<~BANNER
    Usage: OPENBSD/bin/check [--profile=operator|contributor]

    Local deploy gates, no box required:
      openbsd              OPENBSD/bin/check-openbsd (identity, installed targets, ports,
                           dns zones, deploy smoke, resource guard, shell syntax, vps safety)
      production           MASTER/gates/runner.rb production
      phantom fk           MASTER/gates/runner.rb phantom_foreign_keys
      domain align         MASTER/gates/runner.rb domain_alignment
      dr freshness         OPENBSD/bin/dr-pull --check (skips off the operator Mac)
      openbsd contracts    OPENBSD/test/run_all.rb, one process per file

    Both profiles run the same steps; contributor only adds the reminder that
    OPENBSD/bin/check-full is the one that runs the integrity chain.
  BANNER
  parser.on("--profile=PROFILE", "contributor or operator (default)") { |value| profile = value }
end.parse!

runner = Operator::CheckRunner.new(prefix: "deploy-check", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
# check-openbsd owns identity and the deploy smoke gate, and brings installed
# targets, dns zones and vps safety into the one command most people type.
failures << "openbsd" unless runner.run("openbsd", RUBY, "OPENBSD/bin/check-openbsd")
failures << "production" unless runner.run("production", RUBY, "MASTER/gates/runner.rb", "production")
failures << "phantom_fk" unless runner.run("phantom fk", RUBY, "MASTER/gates/runner.rb", "phantom_foreign_keys")
failures << "domain_align" unless runner.run("domain align", RUBY, "MASTER/gates/runner.rb", "domain_alignment")

# The only copy of production data that leaves vm23 is dr-pull's, and it stopped
# for seven nights without anything noticing. This asks how old the newest pull
# is; it skips on any machine without the directory, so it costs nothing
# anywhere but the operator's Mac, which is the one place it can be true.
failures << "dr_freshness" unless runner.run("dr freshness", RUBY, "OPENBSD/bin/dr-pull", "--check")

failures << "openbsd_contracts" unless runner.run("openbsd contracts", RUBY, "OPENBSD/test/run_all.rb")

if profile == "contributor"
  puts "deploy-check: extended gates     skip — contributor profile (use OPENBSD/bin/check-full for integrity)"
end

exit(failures.empty? ? 0 : 1)
