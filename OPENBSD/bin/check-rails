#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../../MASTER/lib/pub4/check_runner"
require_relative "../../MASTER/lib/pub4/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Pub4::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
profile = "operator"
OptionParser.new do |parser|
  parser.on("--profile=PROFILE", "contributor (source gates) or operator (default)") { |value| profile = value }
end.parse!

runner = Pub4::CheckRunner.new(prefix: "deploy-rails", root: ROOT, timeout: STEP_TIMEOUT)
failures = []

GATES_RUNNER = "RAILS/gates/runner.rb"

# Label -> gate name in RAILS/gates/gates.yml. These used to be paths to
# per-gate scripts at the RAILS root; the scripts were shims over the classes
# the runner already loads, so a name is both shorter and one fewer thing that
# can point at a file that no longer exists.
source_gates = [
  ["ports", "port_inventory"],
  ["production", "production"],
  ["walkthrough", "human_walkthrough"],
  ["phantom fk", "phantom_foreign_keys"],
  ["domain align", "domain_alignment"],
  ["frontend", "frontend_production"],
  ["schema", "schema_migration"],
  ["asset freshness", "generated_asset"],
  # Previously invoked by no runner, deploy script or CI entrypoint at all
  # (OPENBSD/data/debt.yml: rails_gates_not_wired) — they only ever ran when
  # someone remembered to call them by hand, which meant in practice they did
  # not run. All four are static source checks, same shape as the gates above,
  # and all four pass as of 2026-07-27.
  ["shared wiring", "shared_wiring"],
  ["stimulus adoption", "stimulus_components"],
  ["css constitution", "css_constitution"],
  ["payment honesty", "payment_honesty"],
  # Design craft stack (P0–P5); GATE_AUTOFIX off in CI-like checks
  ["layout suite", "layout_suite"],
]

source_gates.each do |name, gate|
  env = name == "layout suite" ? { "GATE_AUTOFIX" => "0" } : {}
  failures << name.tr(" ", "_") unless runner.run(name, RUBY, GATES_RUNNER, gate, env: env)
end

# Static family contracts (no app boot / Ruby 3.4 required).
contract_loader = 'Dir["RAILS/test/**/*_test.rb"].sort.each { |file| require File.expand_path(file) }'
failures << "rails_contracts" unless runner.run("rails contracts", RUBY, "-e", contract_loader)

if profile == "contributor"
  puts "deploy-rails: auditor            skip — contributor profile"
  puts "deploy-rails: runtime              skip — contributor profile"
else
  failures << "auditor" unless runner.run("auditor", RUBY, GATES_RUNNER, "frontend_auditor")
  if Pub4::RubyRunner.runtime_gate_skipped?
    puts "deploy-rails: runtime              skip — #{Pub4::RubyRunner.runtime_skip_reason}"
  else
    # Called directly, not through the runner: --runtime is its own flag, and
    # the runner only forwards arguments to visual_contract.
    failures << "runtime" unless runner.run("runtime", RUBY, "RAILS/gates/rails_runtime.rb", "--runtime")
  end
end

exit(failures.empty? ? 0 : 1)
