#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../../MASTER/lib/pub4/check_runner"
require_relative "../../MASTER/lib/pub4/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Pub4::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
profile = "operator"
OptionParser.new do |parser|
  parser.on("--profile=PROFILE",
            "contributor (source gates), operator (default), or full (+ release/rendered/visual/scan)") do |value|
    profile = value
  end
end.parse!

runner = Pub4::CheckRunner.new(prefix: "deploy-rails", root: ROOT, timeout: STEP_TIMEOUT)
failures = []

GATES_RUNNER = "RAILS/gates/runner.rb"

# Label -> gate name in RAILS/gates/gates.yml. These used to be paths to
# per-gate scripts at the RAILS root; the scripts were shims over the classes
# the runner already loads, so a name is both shorter and one fewer thing that
# can point at a file that no longer exists.
source_gates = [
  ["ports", "port_inventory"],
  ["production", "production"],
  ["walkthrough", "human_walkthrough"],
  ["phantom fk", "phantom_foreign_keys"],
  ["domain align", "domain_alignment"],
  ["frontend", "frontend_production"],
  ["schema", "schema_migration"],
  ["asset freshness", "generated_asset"],
  # Previously invoked by no runner, deploy script or CI entrypoint at all
  # (OPENBSD/data/debt.yml: rails_gates_not_wired) — they only ever ran when
  # someone remembered to call them by hand, which meant in practice they did
  # not run. All four are static source checks, same shape as the gates above,
  # and all four pass as of 2026-07-27.
  ["shared wiring", "shared_wiring"],
  ["stimulus adoption", "stimulus_components"],
  ["css constitution", "css_constitution"],
  ["payment honesty", "payment_honesty"],
  # Design craft stack (P0–P5); GATE_AUTOFIX off in CI-like checks
  ["layout suite", "layout_suite"],
  # Second wave of the same debt entry. These four were still invoked by nothing
  # after the 2026-07-27 pass, and the reason given for leaving them out — cost —
  # did not survive measurement: all four together run in 1.4s off the deploy
  # host, because each degrades to its source half when no app is listening.
  # deploy_drift reports INCONCLUSIVE rather than green, which is the point.
  ["page sim", "page_simulation"],
  ["flow journey", "flow_journey"],
  ["gate mutation", "gate_mutation"],
  ["deploy drift", "deploy_drift"],
]

source_gates.each do |name, gate|
  env = name == "layout suite" ? { "GATE_AUTOFIX" => "0" } : {}
  failures << name.tr(" ", "_") unless runner.run(name, RUBY, GATES_RUNNER, gate, env: env)
end

# Gates that are real but too slow for every run, or need a browser and warm
# apps. constitutional_scan alone is four full MASTER scans (~21 min measured
# 2026-08-01), which is why it sat unwired instead of being wired badly.
# --profile=full is where the cost is acceptable; CHECK_RAILS_DEEP=1 opts in
# from anywhere.
deep_gates = [
  ["release", "release"],
  ["rendered suite", "rendered_suite"],
  ["visual contract", "visual_contract"],
  ["constitutional scan", "constitutional_scan"],
]

deep = profile == "full" || %w[1 true yes on].include?(ENV["CHECK_RAILS_DEEP"].to_s.strip.downcase)
if deep
  # CheckRunner's timeout is per-runner, and the default 240s would kill
  # constitutional_scan a fifth of the way in — a timeout kill reads as a gate
  # failure, which is worse than not running it.
  deep_runner = Pub4::CheckRunner.new(
    prefix: "deploy-rails", root: ROOT,
    timeout: Integer(ENV.fetch("DEPLOY_DEEP_CHECK_TIMEOUT", "2400"))
  )
  deep_gates.each do |name, gate|
    env = { "GATE_AUTOFIX" => "0" }
    # On the deploy host every live half is REQUIRED: a closed port reading
    # as green is how amber and bsdports were once down for days invisibly
    # (rails_gates_not_wired, final item — closed 2026-08-22). Off-host runs
    # keep the skip so a laptop without triangle does not false-fail.
    env["GATE_REQUIRE_LIVE"] = "1" if %w[rendered\ suite release constitutional\ scan].include?(name) || File.exist?("/etc/rc.d/brgen")
    failures << name.tr(" ", "_") unless deep_runner.run(name, RUBY, GATES_RUNNER, gate, env: env)
  end
else
  deep_gates.each { |name, _| puts "deploy-rails: #{name.ljust(18)} skip — --profile=full or CHECK_RAILS_DEEP=1" }
end

# Static family contracts (no app boot / Ruby 3.4 required).
contract_loader = 'Dir["RAILS/test/**/*_test.rb"].sort.each { |file| require File.expand_path(file) }'
failures << "rails_contracts" unless runner.run("rails contracts", RUBY, "-e", contract_loader)

if profile == "contributor"
  puts "deploy-rails: auditor            skip — contributor profile"
  puts "deploy-rails: runtime              skip — contributor profile"
else
  failures << "auditor" unless runner.run("auditor", RUBY, GATES_RUNNER, "frontend_auditor")
  if Pub4::RubyRunner.runtime_gate_skipped?
    puts "deploy-rails: runtime              skip — #{Pub4::RubyRunner.runtime_skip_reason}"
  else
    # Called directly, not through the runner: --runtime is its own flag, and
    # the runner only forwards arguments to visual_contract.
    failures << "runtime" unless runner.run("runtime", RUBY, "RAILS/gates/rails_runtime.rb", "--runtime")
  end
end

exit(failures.empty? ? 0 : 1)
