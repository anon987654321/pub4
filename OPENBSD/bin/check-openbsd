#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../../MASTER/lib/pub4/check_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = RbConfig.ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
runner = Pub4::CheckRunner.new(prefix: "deploy-openbsd", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "identity" unless runner.run("identity", RUBY, "OPERATOR/verify_deploy_identity.rb")
failures << "ports" unless runner.run("ports", RUBY, "RAILS/port_inventory_gate.rb")
failures << "deploy_smoke" unless runner.run("deploy smoke", RUBY, "OPERATOR/openbsd/deploy_smoke_gate.rb")
failures << "vps_ci_all syntax" unless runner.run("vps_ci_all syntax", "zsh", "-n", "OPERATOR/openbsd/sh/vps_ci_all.sh")
failures << "openbsd deploy syntax" unless runner.run("openbsd deploy syntax", "zsh", "-n", "OPERATOR/openbsd/OPERATOR.sh")
failures << "vps safety" unless runner.run("vps safety", RUBY, "OPERATOR/openbsd/vps_safety_gate.rb")

exit(failures.empty? ? 0 : 1)
