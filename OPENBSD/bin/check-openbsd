#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../../MASTER/lib/operator/check_runner"
require_relative "../../MASTER/lib/operator/environment"

ROOT = File.expand_path("../..", __dir__)
RUBY = RbConfig.ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
runner = Operator::CheckRunner.new(prefix: "deploy-openbsd", root: ROOT, timeout: STEP_TIMEOUT)

# dns_zones queries our own nameserver and reports skipped_live when it cannot
# reach it. On the box that serves the zone, unreachable is the finding.
LIVE_ENV = Operator::Environment.on_vps? ? { "GATE_REQUIRE_LIVE" => "1" } : {}

failures = []
failures << "identity" unless runner.run("identity", RUBY, "OPENBSD/verify_deploy_identity.rb")
# Repo-side on purpose: a guard whose target nothing installs fails OPEN, and
# the one that did (daily.local -> config_drift_gate.rb) went unnoticed for as
# long as it existed because the only check that could see it ran on the box.
failures << "installed targets" unless runner.run("installed targets", RUBY, "OPENBSD/installed_targets_gate.rb")
failures << "ports" unless runner.run("ports", RUBY, "RAILS/gates/runner.rb", "port_inventory")
# dns_zones was registered in RAILS/gates/gates.yml and invoked by nothing — the
# only one of the 47 that no script in this repo named, so `runner.rb --all`
# being uncalled (TODO.md: rails_gates_not_wired) meant it had never run.
# It belongs here rather than in check-rails: what it compares is
# OPENBSD/var/nsd/zones against what bin/render_dns.rb generates, plus a live
# query to our own nameserver. Nothing about it is a Rails concern except the
# directory its file happens to sit in.
failures << "dns_zones" unless runner.run("dns zones", RUBY, "RAILS/gates/runner.rb", "dns_zones", env: LIVE_ENV)
failures << "deploy_smoke" unless runner.run("deploy smoke", RUBY, "OPENBSD/deploy_smoke_gate.rb")
# The shed ladder decides which site goes down under memory pressure, and its
# test was named by nothing. It asserted litestream went first for as long as the
# guard had stopped shedding it, and read green because nobody ran it.
failures << "resource guard" unless runner.run("resource guard", "ksh",
                                               "OPENBSD/test/resource_guard_test.sh",
                                               "OPENBSD/resource_guard.sh")
# Two files were named here by hand out of 43, and the deploy path was not among
# them: bin/vps-deploy, vps_ci.sh and deploy_all.sh are what a deploy runs.
# shell_syntax_gate reads each script's shebang, so the set is the tree and the
# parser is the one that file declares.
failures << "shell syntax" unless runner.run("shell syntax", RUBY, "OPENBSD/shell_syntax_gate.rb")
failures << "vps safety" unless runner.run("vps safety", RUBY, "OPENBSD/vps_safety_gate.rb")

exit(failures.empty? ? 0 : 1)
