#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../../MASTER/lib/operator/check_runner"
require_relative "../../MASTER/lib/operator/environment"
require_relative "../../MASTER/lib/operator/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
RUBY = Operator::RubyRunner.gate_ruby
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))
runner = Operator::CheckRunner.new(prefix: "deploy-openbsd", root: ROOT, timeout: STEP_TIMEOUT)

# dns_zones queries our own nameserver and reports skipped_live when it cannot
# reach it. On the box that serves the zone, unreachable is the finding.
LIVE_ENV = Operator::Environment.on_vps? ? { "GATE_REQUIRE_LIVE" => "1" } : {}

failures = []
failures << "identity" unless runner.run("identity", RUBY, "OPENBSD/gates/verify_deploy_identity.rb")
# Repo-side on purpose: a guard whose target nothing installs fails OPEN, and
# the one that did (daily.local -> config_drift_gate.rb) went unnoticed for as
# long as it existed because the only check that could see it ran on the box.
failures << "installed targets" unless runner.run("installed targets", RUBY, "OPENBSD/gates/installed_targets_gate.rb")
# The other half of the same question: every cron line, rc.d service and nsd
# zone reaches a file the tree ships.
failures << "reach" unless runner.run("reach", RUBY, "OPENBSD/tools/reach.rb")
failures << "ports" unless runner.run("ports", RUBY, "MASTER/gates/runner.rb", "port_inventory")
# The generator's own --check first, so a DNS edit is judged without the Rails
# gate registry; dns_zones then adds the live query to our own nameserver.
failures << "dns render" unless runner.run("dns render", RUBY, "OPENBSD/bin/render_dns.rb", "--check")
# dns_zones is registered in MASTER/gates/gates.yml. It belongs here rather than
# in check-rails: what it compares is OPENBSD/var/nsd/zones against what
# bin/render_dns.rb generates, plus a live query to our own nameserver.
failures << "dns_zones" unless runner.run("dns zones", RUBY, "MASTER/gates/runner.rb", "dns_zones", env: LIVE_ENV)
failures << "deploy_smoke" unless runner.run("deploy smoke", RUBY, "OPENBSD/gates/deploy_smoke_gate.rb")
# The shed ladder decides which site goes down under memory pressure.
failures << "resource guard" unless runner.run("resource guard", "ksh",
                                               "OPENBSD/test/resource_guard_test.sh",
                                               "OPENBSD/bin/resource_guard.sh")
# shell_syntax_gate reads each script's shebang, so the set is the tree and the
# parser is the one that file declares.
failures << "shell syntax" unless runner.run("shell syntax", RUBY, "OPENBSD/gates/shell_syntax_gate.rb")
failures << "vps safety" unless runner.run("vps safety", RUBY, "OPENBSD/gates/vps_safety_gate.rb")

exit(failures.empty? ? 0 : 1)
