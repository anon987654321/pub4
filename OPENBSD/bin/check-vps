#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../../MASTER/lib/operator/check_runner"
require_relative "../../MASTER/lib/operator/environment"
require_relative "../../MASTER/lib/operator/ruby_runner"

ROOT = File.expand_path("../..", __dir__)
STEP_TIMEOUT = Integer(ENV.fetch("DEPLOY_CHECK_TIMEOUT", "240"))

unless Operator::Environment.on_vps?
  warn "deploy-vps: skip — not on vm23/OpenBSD VPS (set DEPLOY_ASSUME_VPS=1 only when intentionally testing)"
  exit 0
end

RUBY = Operator::RubyRunner.gate_ruby
runner = Operator::CheckRunner.new(prefix: "deploy-vps", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "health core" unless runner.run("health core", RUBY, "OPENBSD/gates/health_check.rb", "--core")
failures << "public health" unless runner.run("public health", RUBY, "OPENBSD/gates/health_check.rb", "--public", "--all-ready-apps")
failures << "config drift" unless runner.run("config drift", RUBY, "OPENBSD/gates/config_drift_gate.rb")

exit(failures.empty? ? 0 : 1)
