#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

# Narrow, auditable OpenBSD administration from MASTER. There is deliberately no
# arbitrary shell mode: every remote operation is one of these named commands.
module OpenBSDAdmin
  SERVICE_ACTIONS = %w[check start stop restart enable disable].freeze
  SERVICE_NAME = /\A[a-z][a-z0-9_]*\z/.freeze

  module_function

  def usage
    <<~TEXT
      usage: OPENBSD/bin/vps-admin <command>

      status
      services [failed|on|off]
      service <name> <check|start|stop|restart|enable|disable>
      pf <status|rules|reload>
      disk
      memory
      swap
      dmesg
      packages
      updates [check|apply]
      upgrade [check|stage]
      reboot

      Mutating operations are limited to explicit service actions, pf reload,
      updates apply, upgrade stage, and reboot. No arbitrary command or shell is accepted.
    TEXT
  end

  def commands_for(args)
    argv = Array(args).map(&:to_s)
    case argv
    when ["status"]
      [["hostname"], ["uptime"], ["uname", "-a"], ["doas", "df", "-h"],
       ["doas", "swapctl", "-s"], ["doas", "vmstat", "-s"]]
    when ["services"]
      [["doas", "rcctl", "ls", "failed"], ["doas", "rcctl", "ls", "on"]]
    when ["services", "failed"], ["services", "on"], ["services", "off"]
      [["doas", "rcctl", "ls", argv[1]]]
    when ["disk"]
      [["doas", "df", "-h"]]
    when ["memory"]
      [["doas", "vmstat", "-s"]]
    when ["swap"]
      [["doas", "swapctl", "-s"]]
    when ["dmesg"]
      [["doas", "dmesg"]]
    when ["packages"]
      [["doas", "pkg_info"]]
    when ["updates"], ["updates", "check"]
      [["doas", "syspatch", "-c"]]
    when ["updates", "apply"]
      [["doas", "syspatch"]]
    when ["upgrade"], ["upgrade", "check"]
      [["doas", "sysupgrade", "-n"]]
    when ["upgrade", "stage"]
      [["doas", "sysupgrade", "-n"]]
    when ["pf", "status"]
      [["doas", "pfctl", "-si"]]
    when ["pf", "rules"]
      [["doas", "pfctl", "-sr"]]
    when ["pf", "reload"]
      [["doas", "pfctl", "-nf", "/etc/pf.conf"], ["doas", "pfctl", "-f", "/etc/pf.conf"]]
    when ["reboot"]
      [["doas", "/sbin/reboot"]]
    else
      if argv.length == 3 && argv[0] == "service"
        service, action = argv[1], argv[2]
        raise ArgumentError, "invalid service name: #{service}" unless service.match?(SERVICE_NAME)
        raise ArgumentError, "invalid service action: #{action}" unless SERVICE_ACTIONS.include?(action)
        return [["doas", "rcctl", action, service]]
      end
      raise ArgumentError, "unknown admin command: #{argv.join(" ")}"
    end
  end

  def run(argv, executor: method(:execute), output: $stdout)
    commands_for(argv).each do |command|
      status, body = executor.call(*command)
      output.write(body)
      return status.exitstatus || 1 unless status.success?
    end
    0
  end

  def execute(*command)
    output, status = Open3.capture2e(*command)
    [status, output]
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    args = ARGV.map(&:to_s)
    if args.empty?
      warn OpenBSDAdmin.usage
      exit 2
    end
    exit OpenBSDAdmin.run(args)
  rescue ArgumentError => e
    warn "vps-admin: #{e.message}"
    exit 2
  rescue StandardError => e
    warn "vps-admin: #{e.class}: #{e.message}"
    exit 1
  end
end
