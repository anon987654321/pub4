#!/usr/bin/env zsh
# Serial VPS deploy entrypoint — sync, CI, restart, health, deploy stamp.
# Usage: zsh OPENBSD/bin/vps-deploy all|brgen|amber|bsdports|master
set -euo pipefail

# Run as dev, not under doas. This script escalates for the individual steps
# that need root and pulls as dev for the one that must not: root has no
# github.com host key, so `doas vps-deploy master` dies at step one with
#
#   ==> git pull
#   Host key verification failed.
#   fatal: Could not read from remote repository.
#   Please make sure you have the correct access rights and the repository exists.
#
# which reads as a revoked deploy key rather than a wrong user. Adding the host
# key to root's known_hosts would "fix" it by giving root a path to fetch and
# execute code from the network, which is the thing the split avoids.
#
# The habit is easy to acquire because everything else on this box is doas'd, and
# RUNBOOK.md listed OPERATOR.sh, vps-deploy and vps_ci.sh in one breath after the
# word doas. That line now says which is which.
if [[ $(id -u) -eq 0 ]]; then
  print -u2 "vps-deploy: run this as dev, not root — it escalates per step, and"
  print -u2 "            root cannot reach github (no host key). Try:"
  print -u2 "            cd /home/dev/pub4 && zsh OPENBSD/bin/vps-deploy ${1:-all}"
  exit 2
fi

app=${1:-}
[[ -n $app ]] || { print -u2 "usage: vps-deploy all|APP|master"; exit 2 }

# A full deploy outlives the ssh session that starts it. When that session is
# cut — a timeout, a dropped link — the pipe carrying its output dies with it and
# the only record of what happened is gone, while the deploy itself carries on to
# completion on the box. Twice now the outcome had to be reconstructed from
# rcctl and curl afterwards. tee keeps a copy that survives the caller.
deploy_log=${VPS_DEPLOY_LOG:-$HOME/vps-deploy.log}
print "vps-deploy: $app, logging to $deploy_log"
exec > >(tee -a "$deploy_log") 2>&1
print "==> vps-deploy $app started $(date '+%Y-%m-%d %H:%M:%S')"

# The whole fleet, in the order that survives its own side effects.
#
# There was no way to say "deploy everything", so the list lived in whoever was
# typing, and master fell out of it: it is not under /home/*/app, so an operator
# enumerating the Rails apps does not see it. Naming the four here makes the set
# a definition rather than a habit.
#
# Order is load-bearing. Every deploy sheds amber and bsdports — they go to
# rcctl failed with their ports closed while TLS keeps answering, so the outage
# reads as a hang rather than a 5xx and nothing reports it. Deploying those two
# last folds the restore into the same pass instead of leaving a window where
# they are down and nobody is looking. master leads because it is independent of
# the Rails apps and is the one that gets forgotten.
DEPLOY_ALL=(master brgen amber bsdports)

if [[ $app == all ]]; then
  typeset -i first=1
  for one in $DEPLOY_ALL; do
    # Let the previous app's deploy drain before starting the next one's CI.
    #
    # One CPU, four apps back to back: each deploy leaves precompile, a restart
    # and a settling app server behind it, and the next app's test suite walks
    # straight into that. brgen's CI was killed mid-run on 2026-08-14 at load
    # 3.43 during exactly this loop, and the same commit passed at load 0.32
    # when run alone. The load is the pass's own wake, so the pass should wait
    # for it rather than hand the bill to whichever app is next.
    #
    # CiGuard also waits now, so this is the cheap half — a fixed pause costs a
    # minute and avoids most of the waiting the guard would otherwise do.
    if (( ! first )); then
      print "vps-deploy: all — settling for ${PUB4_DEPLOY_COOLDOWN:-60}s before $one"
      sleep ${PUB4_DEPLOY_COOLDOWN:-60}
    fi
    first=0
    print "vps-deploy: all -> $one"
    # Re-entrant rather than inlined: each app gets the full path including its
    # own health gate and deploy stamp, and a failure halts the pass instead of
    # deploying the next one on top of a broken box.
    zsh "$0" "$one" || { print -u2 "vps-deploy: all halted at $one"; exit 1 }
  done
  print "vps-deploy: all ok ($DEPLOY_ALL)"
  exit 0
fi

repo=${PUB4_ROOT:-/home/dev/pub4}
stamp_dir=/var/db/pub4
mkdir -p "$stamp_dir" 2>/dev/null || doas mkdir -p "$stamp_dir"
doas chmod 755 "$stamp_dir" 2>/dev/null || true

# SHA and time are captured at write_stamp, not here. vps_deploy_master.sh
# pulls origin/main; reading HEAD before that call stamped the pre-pull SHA
# (76f1a65fa on 2026-08-12 while /health correctly said 5eff4d87a).

write_stamp() {
  local name=$1 stamp_status=$2
  local sha started file
  sha=$(git -C "$repo" rev-parse --short HEAD)
  started=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  file=$stamp_dir/last_deploy_${name}.json
  doas tee "$file" >/dev/null <<EOF
{"app":"$name","sha":"$sha","at":"$started","status":"$stamp_status","host":"$(hostname)"}
EOF
  doas chmod 644 "$file" 2>/dev/null || true
}

if [[ $app == master ]]; then
  print "vps-deploy: master web"
  if zsh "$repo/OPENBSD/vps_deploy_master.sh"; then
    write_stamp master ok
    exit 0
  fi
  # A failed restart used to leave last_deploy_master.json saying ok from
  # the last good run, so /health and the operator read a live SHA while
  # :53187 was closed (measured 2026-08-13).
  write_stamp master failed
  exit 1
fi

[[ -d /home/${app}/app ]] || { print -u2 "missing /home/${app}/app"; exit 1 }

# Rails apps do not pull inside vps_ci.sh. A laptop `vps-deploy brgen --remote`
# used to CI and sync whatever the VPS checkout already had, which lagged
# origin/main by days. master pulls inside vps_deploy_master.sh; this is the
# matching step for the three copy-tree apps.
print "vps-deploy: $app (git pull --ff-only)"
git -C "$repo" pull --ff-only origin main

print "vps-deploy: $app (preflight load)"
if [[ -x $repo/OPENBSD/resource_guard.sh ]]; then
  doas ksh "$repo/OPENBSD/resource_guard.sh" || true
fi

if [[ ${SKIP_CI:-} == 1 ]]; then
  print "vps-deploy: $app (sync via ${app}.sh, SKIP_CI=1)"
  zsh "$repo/RAILS/${app}/${app}.sh"
else
  print "vps-deploy: $app (ci + sync)"
  zsh "$repo/OPENBSD/vps_ci.sh" "$app"
fi

# Primary database, then the cache/queue/cable schemas.
#
# This used to call rails_prepare_secondary_dbs_as_app directly, so the
# secondary schemas were loaded on every deploy and the PRIMARY database was
# never migrated at all. A migration could be written, reviewed, merged and
# deployed and still not exist in production.
#
# That bit twice on 2026-07-29. brgen shipped a counter-cache column its views
# already read, so every feed render raised NoMethodError and the whole site
# 500'd until the three pending migrations were run by hand. MASTER/web had no
# schema tracked at all while cable.yml selected solid_cable, so every
# ActionCable broadcast wrote to a table that did not exist.
#
# db_create_migrate_as_app runs db:prepare, which is idempotent — it creates the
# database when absent, loads the schema when empty, and otherwise runs only
# pending migrations — and then does the secondary schemas itself.
print "vps-deploy: $app (primary db migrate + secondary schemas)"
. "$repo/RAILS/_core.sh"
. "$repo/RAILS/_bundle.sh"
. "$repo/RAILS/_runtime_gate.sh"
. "$repo/RAILS/_database.sh"
. "$repo/RAILS/_assets.sh"
# Same reason RAILS/_deploy.sh stops first: db:prepare hangs on the write
# lock a live Falcon worker already holds on production.sqlite3.
print "vps-deploy: $app (stop for sqlite migrate)"
doas rcctl stop "$app" 2>/dev/null || true
db_create_migrate_as_app "$app" "/home/${app}/app"

# The SKIP_CI=1 path (${app}.sh -> deploy_tracked_app -> rails_runtime_gate)
# already precompiles as part of its gate. The default ci+sync path
# (vps_ci.sh) only runs tests against a throwaway test DB and never
# touches production assets -- without this, public/assets/ is simply
# never created for a plain `vps-deploy $app` run, so Propshaft 404s
# every asset_path() and the page renders with no CSS at all. Safe to
# call unconditionally: Propshaft precompile is idempotent.
print "vps-deploy: $app (assets precompile)"
rails_assets_precompile_as_app "$app" "/home/${app}/app" || exit 1

print "vps-deploy: $app (restart)"
if ! doas rcctl restart "$app" || ! doas rcctl check "$app"; then
  write_stamp "$app" failed
  exit 1
fi

port=$(ruby34 -ryaml -e 'puts YAML.safe_load(File.read("'"$repo"'/RAILS/apps.yml")).dig("apps","'"$app"'","port")')
up_ok=0
for i in {1..30}; do
  curl -fsS "http://127.0.0.1:${port}/up" >/dev/null 2>&1 && { up_ok=1; break; }
  sleep 2
done
[[ $up_ok -eq 1 ]] || { write_stamp "$app" failed; print -u2 "vps-deploy: $app /up not ready on :${port}"; exit 1; }

# /up answers before Propshaft is involved, so it says nothing about whether the
# page a visitor gets is styled. On 2026-08-14 brgen served every page with a
# <link> to a stylesheet that 404'd — public/assets held zero files — and /up,
# rcctl check, the port probe and the public TLS check all passed. The site was
# plainly broken and the only thing that noticed was a person looking at it.
#
# So ask for the stylesheet the page actually links, through the Host that owns
# it: these apps are domain-constrained and a bare-IP request is a 403, which
# would make this check pass by never finding a link to test.
domain=$(ruby34 -ryaml -e 'puts YAML.safe_load(File.read("'"$repo"'/RAILS/apps.yml")).dig("apps","'"$app"'","domain")')
css_href=$(curl -fsS --max-time 30 -H "Host: ${domain}" "http://127.0.0.1:${port}/" 2>/dev/null \
  | grep -oE '/assets/[^"]+\.css' | head -1)
if [[ -n $css_href ]]; then
  if curl -fsS -o /dev/null --max-time 30 -H "Host: ${domain}" "http://127.0.0.1:${port}${css_href}" 2>/dev/null; then
    print "vps-deploy: $app stylesheet ok (${css_href})"
  else
    write_stamp "$app" failed
    print -u2 "vps-deploy: $app serves ${css_href} as 404 — precompiled assets missing, the site is unstyled"
    exit 1
  fi
else
  print "vps-deploy: $app no /assets stylesheet linked on / — nothing to verify"
fi

queue_schema="$repo/RAILS/${app}/db/queue_schema.rb"
if [[ -f $queue_schema ]] && ! grep -q 'define(version: 0)' "$queue_schema" 2>/dev/null; then
  print "vps-deploy: $app (solid_queue proof)"
  ksh "$repo/OPENBSD/solid_queue_proof.sh" "$app" \
    || { write_stamp "$app" failed; print -u2 "vps-deploy: solid_queue proof failed for $app"; exit 1; }
fi

print "vps-deploy: $app ok"
write_stamp "$app" ok
