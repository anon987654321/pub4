#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "securerandom"
require "tmpdir"

repository = ENV["RESTIC_REPOSITORY"].to_s
password_file = ENV["RESTIC_PASSWORD_FILE"].to_s
password_command = ENV["RESTIC_PASSWORD_COMMAND"].to_s
db_paths = ENV["PUB4_DB_PATHS"].to_s.split(",").map(&:strip).reject(&:empty?)
abort("dr-backup: RESTIC_REPOSITORY is required") if repository.empty?
abort("dr-backup: RESTIC_PASSWORD_FILE or RESTIC_PASSWORD_COMMAND is required") if password_file.empty? && password_command.empty?
abort("dr-backup: PUB4_DB_PATHS is required") if db_paths.empty?

db_paths.each { |path| abort("dr-backup: database missing: #{path}") unless File.file?(path) }

tag = "pub4-#{Time.now.utc.strftime("%Y%m%dT%H%M%SZ")}"
Dir.mktmpdir("pub4-dr") do |dir|
  db_paths.each do |database|
    filename = File.basename(database, File.extname(database)) + ".sqlite3"
    destination = File.join(dir, filename)
    stdout, stderr, status = Open3.capture3("sqlite3", database, ".backup #{destination}")
    abort("dr-backup: sqlite backup failed for #{database}: #{stderr.strip}") unless status.success?
    abort("dr-backup: backup is empty: #{destination}") unless File.size?(destination)
  end

  command = ["restic", "backup", dir, "--tag", "pub4", "--tag", tag]
  stdout, stderr, status = Open3.capture3(*command)
  abort("dr-backup: restic backup failed: #{stderr.strip.empty? ? stdout.strip : stderr.strip}") unless status.success?
end

puts "dr-backup: ok — #{db_paths.length} sqlite database(s) copied to encrypted restic repository with tag=#{tag}"
