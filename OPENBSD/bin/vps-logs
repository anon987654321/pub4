#!/usr/bin/env ruby
# frozen_string_literal: true

# The last lines an app wrote, on vm23.
#
# Every rc.d service here sets daemon_logger="daemon.notice", so falcon's output
# goes to syslog's daemon facility and lands in /var/log/daemon beside every other
# daemon's. There is no per-app log file to look in first, so this reads that one
# file and keeps the lines tagged with the app's name.

require "optparse"
require "open3"

ROOT = File.expand_path("../..", __dir__)
$LOAD_PATH.unshift(File.join(ROOT, "MASTER", "lib"))
require "operator/environment"

DAEMON_LOG = "/var/log/daemon"

options = { lines: 20 }
OptionParser.new do |parser|
  parser.banner = "Usage: vps-logs APP [--lines N]   (the APP-tagged lines of #{DAEMON_LOG})"
  parser.on("--lines N", Integer) { |n| options[:lines] = n }
end.parse!

app = ARGV.shift
abort "usage: vps-logs APP [--lines N]" if app.to_s.empty?

unless Operator::Environment.on_vps?
  warn "vps-logs: skip — not on VPS (use: bin/operator vps logs #{app} --remote)"
  exit 0
end

body = if File.readable?(DAEMON_LOG)
         File.read(DAEMON_LOG, encoding: "UTF-8").scrub
       else
         out, status = Open3.capture2("doas", "cat", DAEMON_LOG)
         abort "vps-logs: cannot read #{DAEMON_LOG}" unless status.success?
         out.scrub
       end

tag = /\b#{Regexp.escape(app)}\b/
puts body.lines.grep(tag).last(options[:lines])
