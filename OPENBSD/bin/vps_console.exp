#!/usr/bin/expect -f
# Parameterized vm23 console automation. Modes:
#   short [cmd]  status  probe  fix_key  start_install  poll_install
#   install  sync_and_install  drop_install
#
# This is the only console script, so the mode is an argument rather than a
# file per mode: one door means one place the ack below can be bypassed from.
# What each mode does: OPENBSD/RUNBOOK.md, "vps_console.exp modes".
#
# Usage: I_UNDERSTAND_CONSOLE_RISK=1 expect -f OPENBSD/bin/vps_console.exp <mode> [args...]
#        expect -f OPENBSD/bin/vps_console.exp --help

set mode [lindex $argv 0]
if {$mode eq "" || $mode eq "-h" || $mode eq "--help"} {
  puts "usage: I_UNDERSTAND_CONSOLE_RISK=1 vps_console.exp <mode> \[args...\]"
  puts "modes: short \[cmd\] | status | probe | fix_key | start_install | poll_install | install | sync_and_install | drop_install"
  puts "recovery-only; see OPENBSD/RUNBOOK.md, \"vps_console.exp modes\""
  exit [expr {$mode eq "" ? 1 : 0}]
}

# Recovery-only: agents never run this without a human's explicit approval,
# and the refusal comes before anything is spawned.
proc require_console_risk_ack {} {
  global env
  if {![info exists env(I_UNDERSTAND_CONSOLE_RISK)] || $env(I_UNDERSTAND_CONSOLE_RISK) != "1"} {
    puts stderr "REFUSING: vmctl console automation is recovery-only."
    puts stderr "Human operator must approve: export I_UNDERSTAND_CONSOLE_RISK=1"
    puts stderr "See OPENBSD/RUNBOOK.md, \"vps_console.exp modes\"."
    exit 1
  }
}
require_console_risk_ack

# Host, port and key live here once; console_spawn is the only ssh line.
set keyfile [expr {[info exists env(SSH_KEY)] ? $env(SSH_KEY) : "$env(HOME)/.ssh/id_ed25519_brgen"}]
set console_host dev@server4.openbsd.amsterdam
set console_port 31415

# fix_key installs the public half of the key this script connects with, read at
# run time, so rotating the key leaves no stale pasted copy to re-install.
proc public_key {} {
  global keyfile
  set fh [open "$keyfile.pub"]
  set key [string trim [read $fh]]
  close $fh
  return $key
}

proc at_prompt {} {
  expect -re {brgen\$ $}
}

proc at_prompt_loose {} {
  expect -re {brgen\$ }
}

proc console_spawn {} {
  global keyfile console_host console_port
  spawn ssh -tt -i $keyfile -p $console_port -o StrictHostKeyChecking=accept-new $console_host vmctl console vm23
}

proc console_open {} {
  console_spawn
  expect -re {Connected to /dev/ttypx}
  send "\r"
}

proc console_close {} {
  send "~.\r"
  expect eof
}

switch -- $mode {
  short {
    set timeout 15
    set cmd [lindex $argv 1]
    if {$cmd eq ""} { set cmd "uptime" }
    console_open
    at_prompt_loose
    send "$cmd\r"
    at_prompt_loose
    console_close
  }
  status {
    set timeout 20
    console_open
    at_prompt_loose
    send "tail -15 /tmp/pub4_install_latest.log 2>/dev/null; pgrep -lf bundle\r"
    at_prompt_loose
    send "doas rcctl check master brgen amber bsdports 2>/dev/null\r"
    at_prompt_loose
    console_close
  }
  probe {
    set timeout 60
    console_spawn
    sleep 2
    send "\r\r\r"
    expect {
      -re {login:} { puts "LOGIN_PROMPT"; send "dev\r"; exp_continue }
      -re {OpenBSD} { puts "OPENBSD_BANNER\n$expect_out(buffer)"; exp_continue }
      -re {password:} { puts "PASSWORD_PROMPT"; exp_continue }
      timeout { puts "TIMEOUT_BUF:\n$expect_out(buffer)" }
      eof { puts "EOF" }
    }
  }
  fix_key {
    set timeout 30
    set pubkey [public_key]
    set keybody [lindex $pubkey 1]
    console_open
    at_prompt
    send "whoami; hostname; uname -a\r"
    at_prompt
    send "mkdir -p /home/dev/.ssh && chmod 700 /home/dev/.ssh\r"
    at_prompt
    send "grep -q '$keybody' /home/dev/.ssh/authorized_keys 2>/dev/null || echo '$pubkey' >> /home/dev/.ssh/authorized_keys\r"
    at_prompt
    send "chown -R dev:dev /home/dev/.ssh && chmod 600 /home/dev/.ssh/authorized_keys\r"
    at_prompt
    send "doas pfctl -t bruteforce -T flush 2>/dev/null || true\r"
    at_prompt
    console_close
  }
  start_install {
    set timeout 20
    console_open
    at_prompt_loose
    send "doas pfctl -t bruteforce -T flush 2>/dev/null\r"
    at_prompt_loose
    send "nohup /tmp/vps_on_vm_install.sh >/tmp/pub4_on_vm_install.log 2>&1 &\r"
    at_prompt_loose
    send "sleep 1; head -3 /tmp/pub4_on_vm_install.log\r"
    at_prompt_loose
    console_close
  }
  poll_install {
    set timeout 25
    console_open
    at_prompt
    send "tail -25 /tmp/pub4_on_vm_install.log 2>/dev/null; echo ---; pgrep -lf 'bundle|vps_on_vm|vps_install_all|brgen.sh|amber.sh|bsdports.sh'\r"
    at_prompt
    send "doas rcctl check master brgen amber bsdports 2>&1\r"
    at_prompt
    console_close
  }
  install {
    set timeout 600
    console_open
    at_prompt
    send "cd /home/dev/pub4/MASTER && bundle install\r"
    at_prompt
    send "cd /home/dev/pub4/MASTER/web && bundle install && RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile && bundle exec ruby /home/dev/pub4/MASTER/gates/runner.rb master_web_assets && doas rcctl restart master\r"
    at_prompt
    send "for a in brgen amber bsdports; do sed -i '' 's|ruby34 /home/dev/pub4/MASTER/bin/cli|(cd /home/dev/pub4/MASTER \\&\\& bundle exec ruby bin/cli|g' /home/dev/pub4/RAILS/\$a/\$a.sh; done\r"
    at_prompt
    send "for a in brgen amber bsdports; do echo ====\$a====; zsh /home/dev/pub4/RAILS/\$a/\$a.sh || echo FAIL_\$a; done 2>&1 | tee /tmp/console_install.log\r"
    set timeout 3600
    expect {
      timeout { puts "INSTALL_TIMEOUT"; }
    }
    at_prompt
    send "doas rcctl check master brgen amber bsdports 2>&1\r"
    at_prompt
    send "tail -20 /tmp/console_install.log\r"
    at_prompt
    console_close
  }
  sync_and_install {
    set timeout 30
    set tgzfile /tmp/pub4_deploy_sync.tgz
    set b64 [exec base64 -i $tgzfile]
    console_open
    at_prompt
    send "doas pfctl -t bruteforce -T flush 2>/dev/null; echo PF_FLUSH_OK\r"
    at_prompt
    send "echo $b64 | base64 -d > /tmp/pub4_deploy_sync.tgz && tar xzf /tmp/pub4_deploy_sync.tgz -C /home/dev/pub4 && echo SYNC_OK\r"
    at_prompt
    send "chmod +x /home/dev/pub4/OPENBSD/bin/vps_on_vm_install.sh /home/dev/pub4/OPENBSD/bin/vps_install_all.sh\r"
    at_prompt
    send "pkill -f vps_on_vm_install.sh 2>/dev/null; pkill -f vps_install_all.sh 2>/dev/null; true\r"
    at_prompt
    send "nohup zsh /home/dev/pub4/OPENBSD/bin/vps_on_vm_install.sh > /tmp/pub4_on_vm_install.log 2>&1 & echo INSTALL_PID:\$!\r"
    at_prompt
    send "sleep 2; head -8 /tmp/pub4_on_vm_install.log\r"
    at_prompt
    console_close
  }
  drop_install {
    set timeout 30
    set scriptfile [file join [file dirname $argv0] vps_on_vm_install.sh]
    set b64 [exec base64 < $scriptfile]
    console_open
    at_prompt_loose
    send "doas pfctl -t bruteforce -T flush 2>/dev/null; echo PF_FLUSH_OK\r"
    at_prompt_loose
    send "echo $b64 | base64 -d > /tmp/vps_on_vm_install.sh && chmod +x /tmp/vps_on_vm_install.sh && echo SCRIPT_OK\r"
    at_prompt_loose
    send "nohup /tmp/vps_on_vm_install.sh > /tmp/on_vm_install.log 2>&1 & echo STARTED\r"
    at_prompt_loose
    console_close
  }
  default {
    puts "unknown mode: $mode"
    exit 1
  }
}
