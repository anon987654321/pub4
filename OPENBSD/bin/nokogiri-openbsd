#!/usr/bin/env ruby
# frozen_string_literal: true

# Build nokogiri for OpenBSD and install it into the given bundles.
#
#   doas ruby34 OPENBSD/bin/nokogiri-openbsd 1.19.7 /home/brgen/.bundle/gems/ruby/3.4:brgen ...
#
# nokogiri 1.19.5 to 1.19.7 vendor a gumbo hashmap.c whose function-pointer
# variables are named __malloc, __realloc and __free. OpenBSD's <sys/cdefs.h>
# defines __malloc as a macro, unconditionally, so the extension does not
# compile there and `bundle install` fails on vm23. No compiler flag wins: the
# header's definition always comes last. This fetches the upstream release,
# renames those three identifiers in that one file, rebuilds the gem at the
# same version and installs it into each bundle as that bundle's owner, so
# `bundle install` finds it present and never compiles the unpatched source.
#
# Delete this tool once an upstream nokogiri release builds on OpenBSD.

require "fileutils"
require "rbconfig"
require "tmpdir"

module NokogiriOpenbsd
  HASHMAP = File.join("gumbo-parser", "src", "hashmap.c")
  CLASHING = /\b__(malloc|realloc|free)\b/

  module_function

  # The rename is the whole patch; everything else is upstream's.
  def patch(source) = source.gsub(CLASHING) { "gumbo_hashmap_#{Regexp.last_match(1)}" }

  def gem_cmd(*args) = [RbConfig.ruby, "-S", "gem", *args]

  def run!(*cmd, chdir: Dir.pwd)
    system(*cmd, chdir:) || abort("nokogiri-openbsd: failed: #{cmd.join(" ")}")
  end

  def build(version, dir)
    run!(*gem_cmd("fetch", "nokogiri", "-v", version, "--platform", "ruby"), chdir: dir)
    run!(*gem_cmd("unpack", "nokogiri-#{version}.gem"), chdir: dir)

    root = File.join(dir, "nokogiri-#{version}")
    hashmap = File.join(root, HASHMAP)
    File.write(hashmap, patch(File.read(hashmap)))
    spec = IO.popen(gem_cmd("spec", File.join(dir, "nokogiri-#{version}.gem"), "--ruby"), &:read)
    File.write(File.join(root, "nokogiri.gemspec"), spec)
    run!(*gem_cmd("build", "nokogiri.gemspec"), chdir: root)
    File.join(root, "nokogiri-#{version}.gem")
  end

  # Each bundle is installed by its owner, so the files belong to the app
  # user exactly as `bundle install` would have left them.
  def install(gem_path, target, version:)
    dir, user = target.split(":", 2)
    stale = File.join(dir, "gems", "nokogiri-#{version}")
    # A failed `bundle install` leaves the unpacked source without a spec.
    half_built = File.directory?(stale) && !File.exist?(File.join(dir, "specifications", "nokogiri-#{version}.gemspec"))
    FileUtils.rm_rf(stale) if half_built
    cmd = gem_cmd("install", "--local", "--ignore-dependencies", "--no-document", "--install-dir", dir, gem_path)
    user ? run!("su", "-s", "/bin/sh", user, "-c", cmd.map { |part| "'#{part}'" }.join(" ")) : run!(*cmd)
    puts "nokogiri-openbsd: #{version} installed in #{dir}#{" as #{user}" if user}"
  end

  def main(argv)
    version, *targets = argv
    abort("usage: nokogiri-openbsd VERSION BUNDLE_DIR[:USER] ...") if version.nil? || targets.empty?

    Dir.mktmpdir("nokogiri-openbsd") do |dir|
      File.chmod(0o755, dir)
      gem_path = build(version, dir)
      File.chmod(0o644, gem_path)
      targets.each { |target| install(gem_path, target, version:) }
    end
  end
end

NokogiriOpenbsd.main(ARGV) if $PROGRAM_NAME == __FILE__
