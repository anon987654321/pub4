$ORIGIN brgen.no.
$TTL 3600
@ IN SOA ns.brgen.no. hostmaster.brgen.no. (
    2026082701 1800 900 604800 86400)
@ IN NS ns.brgen.no.
@ IN NS ns.hyp.net.
@ IN A 46.23.89.226
www IN A 46.23.89.226
@ IN MX 10 mail.brgen.no.
mail IN A 46.23.89.226
ai IN A 46.23.89.226
amber IN A 46.23.89.226
dating IN A 46.23.89.226
maps IN A 46.23.89.226
markedsplass IN A 46.23.89.226
messenger IN A 46.23.89.226
