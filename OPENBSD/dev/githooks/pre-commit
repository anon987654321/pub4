#!/usr/bin/env ruby
# frozen_string_literal: true

# One git index, many agents.
#
# A shared checkout can still carry another session's uncommitted changes.
# Keep commits path-scoped, and use a disposable worktree for broad or parallel
# work. This hook still refuses cross-tree commits, untracked files that would
# be omitted, and Ruby files that do not parse. On 2026-08-10 one push carried
# four commits another session had told its user were still local. On 2026-08-12
# a session's debt write-up was committed by a different session under a message
# about something else, and that session's own commit body says it was "carrying
# a four-line path correction from another session" — it carried rather more.
#
# This hook cannot tell sessions apart. Nothing in git can: everything commits as
# the same author, and paths do not identify a session either. What it can do is
# make the shared tree visible at the moment it matters, and refuse the one shape
# that is almost always an accident.
#
#   1. A commit spanning more than one top-level tree is refused. That is the
#      signature of `git commit -a` in this repo. Deliberate cross-tree commits
#      are real but rare: set PUB4_CROSS_TREE=1 to say you meant it.
#
#   2. Everything left uncommitted is printed, grouped by tree. Some of it is
#      probably not yours. That is the point.
#
# Installed by `bin/operator hooks`, which sets core.hooksPath to this directory.

TREES = %w[MASTER RAILS OPENBSD STUDIO].freeze

def tree_of(path)
  head = path.split("/").first
  TREES.include?(head) ? head : "(root)"
end

def paths(*args)
  out = IO.popen(["git", *args, "-z"], &:read)
  out.split("\0").reject(&:empty?)
end

staged = paths("diff", "--cached", "--name-only")
exit 0 if staged.empty?

staged_trees = staged.map { |path| tree_of(path) }.uniq.sort
unstaged = paths("diff", "--name-only") + paths("ls-files", "--others", "--exclude-standard")
left = (unstaged - staged).group_by { |path| tree_of(path) }

unless left.empty?
  summary = left.sort.map { |tree, files| "#{tree} (#{files.size})" }.join(", ")
  warn "pre-commit: leaving uncommitted: #{summary}"
  left.sort.each do |tree, files|
    files.sort.first(6).each { |file| warn "    #{file}" }
    warn "    … and #{files.size - 6} more in #{tree}" if files.size > 6
  end
  warn "pre-commit: some of that may belong to another session. Read before you claim it."
end

# A staged deletion whose basename reappears as an untracked file is a file
# MOVE that half-landed: `git commit -- <paths>` stages tracked changes and
# silently skips untracked files, so the commit records the delete and the
# replacement stays behind on one machine. On 2026-08-21 exactly this shipped
# a MASTER tree missing Ground::SqliteStore and a brgen card rendering a
# partial that did not exist in git — every local suite green, the pushed
# tree broken. The pair is refused, not warned: the warning above printed
# both files that day and was scrolled past.
untracked = paths("ls-files", "--others", "--exclude-standard")
deleted = paths("diff", "--cached", "--name-only", "--diff-filter=D")
half_moves = deleted.filter_map do |gone|
  twin = untracked.find { |u| File.basename(u) == File.basename(gone) && tree_of(u) == tree_of(gone) }
  [gone, twin] if twin
end
if !half_moves.empty? && ENV["PUB4_SPLIT_MOVE"] != "1"
  warn ""
  warn "pre-commit: REFUSED — staged deletion + untracked twin = a move that would half-land:"
  half_moves.each { |gone, twin| warn "    deleting #{gone} while #{twin} is untracked" }
  warn ""
  warn "  `git add` the new path so the move lands whole, or set PUB4_SPLIT_MOVE=1"
  warn "  if the deletion and the untracked file genuinely have nothing to do"
  warn "  with each other."
  warn ""
  exit 1
end

# New untracked files in the SAME tree as this commit deserve more than the
# grouped summary: they will not ride along, and if the staged diff references
# them the pushed tree breaks while every local run stays green.
same_tree_untracked = untracked.select { |u| staged_trees.include?(tree_of(u)) }
if !same_tree_untracked.empty? && ENV["PUB4_UNTRACKED"] != "1"
  warn ""
  warn "pre-commit: REFUSED — untracked file(s) in the tree(s) you are committing:"
  same_tree_untracked.sort.first(8).each { |file| warn "    #{file}" }
  warn ""
  warn "  These will NOT ride along, and three times in two days a commit has"
  warn "  referenced a file it did not stage. `git add` them, or say they belong"
  warn "  to a different change: PUB4_UNTRACKED=1 git commit -- <paths>"
  warn ""
  exit 1
end

# MASTER/tools ownership is guarded through its session file. Tool work remains inside MASTER's tree
# but a live session can still reserve media-heavy changes explicitly.
session_file = "MASTER/tools/.session"
if staged.any? { |path| path.start_with?("MASTER/tools/") } && File.file?(session_file)
  owner = File.read(session_file).strip
  unless owner.empty? || ENV["PUB4_SESSION"].to_s == owner
    warn ""
    warn "pre-commit: REFUSED — MASTER/tools is owned by session '#{owner}' (MASTER/tools/.session)."
    warn "  If you are that session: PUB4_SESSION=#{owner} git commit -- <paths>"
    warn ""
    exit 1
  end
end

if staged_trees.size > 1 && ENV["PUB4_CROSS_TREE"] != "1"
  warn ""
  warn "pre-commit: REFUSED — this commit spans #{staged_trees.size} trees: #{staged_trees.join(', ')}"
  warn ""
  warn "  In a shared checkout that is usually `git commit -a` sweeping up work that"
  warn "  is not yours. Commit path-scoped instead:"
  warn ""
  warn "      git commit -- <paths>          # no prior `git add`"
  warn ""
  warn "  If the change genuinely spans trees, say so:"
  warn ""
  warn "      PUB4_CROSS_TREE=1 git commit -- <paths>"
  warn ""
  warn "  For broad or parallel work, take a managed worktree:"
  warn ""
  warn "      bin/operator worktree <name>"
  warn ""
  exit 1
end

# Any staged Ruby file must parse before it lands. The broken law inventory regression
# exposed why Dilla-only protection was insufficient: the same shared checkout can
# commit a malformed MASTER/lib file and the next process dies before /fix can
# start. This is deliberately local, cheap, and scoped to staged Ruby only.
if ENV["PUB4_RUBY_PARSE_SKIP"] != "1"
  require "open3"
  ruby_staged = staged.select { |path| path.end_with?(".rb") && File.file?(path) }
  ruby_staged.each do |path|
    out, status = Open3.capture2e(RbConfig.ruby, "-c", path)
    next if status.success?

    warn ""
    warn "pre-commit: REFUSED — #{path} does not parse:"
    warn "  #{out.lines.first(4).join.strip}"
    warn ""
    warn "  Fix the Ruby syntax error before committing."
    warn "  Bypass only this one commit: PUB4_RUBY_PARSE_SKIP=1 git commit -- <paths>"
    warn ""
    exit 1
  end
end

# A commit that clears an execute bit breaks every caller that runs the file
# directly. ecbc1a0f6 on 2026-10-26 arrived through an editor connector that
# rewrote MASTER/bin/fix-here as 100644, and the one-/fix-at-a-time wrapper
# then failed with permission denied. Clearing the bit on purpose is rare.
summary = IO.popen(%w[git diff --cached --summary], &:read)
lost_exec = summary.scan(/mode change 100755 => 100644 (.+)$/).flatten

if !lost_exec.empty? && ENV["PUB4_MODE_CHANGE"] != "1"
  warn ""
  warn "pre-commit: REFUSED — this commit removes the execute bit from:"
  lost_exec.each { |path| warn "    #{path}" }

  warn ""
  warn "  Restore it: chmod 755 <path> && git update-index --chmod=+x -- <path>"
  warn "  If you meant it: PUB4_MODE_CHANGE=1 git commit -- <paths>"
  warn ""
  exit 1
end

# The constitution, applied to what is about to land: the rules MASTER documents
# for coding agents become something git enforces on any of them, rather than
# something claude, grok or codex has to remember. It costs about six seconds,
# because building the scanner boots the runtime. On by default; LINT=0 turns it
# off for one commit. --changed-lines scopes it to the lines this commit adds, so
# a file's standing debt never blocks the change that merely touched it. A launch
# failure proceeds; only a real finding refuses.
#
# The lint reads pub4's own index, so it runs only when the commit is being made
# in pub4 itself, as the pre-push snapshot does. Committed from any other
# repository wired to these hooks (the githooks suite's throwaway repos), it
# judged whatever other sessions had staged in pub4 instead of that commit.
pub4_root = File.expand_path("../../..", __dir__)
committing_in_pub4 = IO.popen(%w[git rev-parse --show-toplevel], &:read).to_s.strip == pub4_root
if committing_in_pub4 && ENV["LINT"] != "0" && ENV["LINT_SKIP"] != "1"
  pub4 = File.expand_path("../../../MASTER/bin/operator", __dir__)
  master = File.expand_path("../../../MASTER", __dir__)
  ran = system(RbConfig.ruby, pub4, "lint", "--staged", "--changed-lines", chdir: master)
  if ran == false
    warn ""
    warn "pre-commit: REFUSED — bin/operator lint found violations in the lines you staged."
    warn "  Fix them, or bypass this one commit: LINT_SKIP=1 git commit -- <paths>"
    warn ""
    exit 1
  end
end

# A commit that stops MASTER booting is refused here, not at push: a law change
# that made the boot recurse forever was caught only by pre-push, after it had
# been committed and built on. Only a commit touching what the boot reads pays the
# 20-40 s. It boots the working tree, as pre-push does, so another session's
# unstaged edit there can fail it too; the smoke's own output names the error. A
# boot that never returns is stopped at the deadline and refused, not waited on.
BOOT_PATHS = %w[MASTER/lib/ MASTER/law/ MASTER/data/].freeze
BOOT_SMOKE_DEADLINE_S = 180

def boot_smoke_status(ruby, smoke)
  pid = Process.spawn(ruby, smoke, out: $stderr, pgroup: true)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + BOOT_SMOKE_DEADLINE_S
  until Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
    _, status = Process.wait2(pid, Process::WNOHANG)
    return status if status

    sleep 0.25
  end
  Process.kill("KILL", -pid)
  Process.wait(pid)
  nil
end

if ENV["PUB4_SKIP_BOOT_SMOKE"] != "1" && staged.any? { |path| path.start_with?(*BOOT_PATHS) }
  root = File.expand_path("../../..", __dir__)
  smoke = File.join(root, "MASTER", "tools", "boot_smoke.rb")

  status = File.file?(smoke) ? boot_smoke_status(File.join(root, "MASTER", "bin", "ruby"), smoke) : true

  unless status == true || status&.success?
    verdict = status ? "boot smoke failed" : "boot smoke still running after #{BOOT_SMOKE_DEADLINE_S}s"

    warn ""
    warn "pre-commit: REFUSED — #{verdict}."
    warn "  MASTER must boot with what this commit touches in MASTER/lib, law or data."
    warn "  Bypass only this one commit: PUB4_SKIP_BOOT_SMOKE=1 git commit -- <paths>"
    warn ""
    exit 1
  end
end

exit 0
