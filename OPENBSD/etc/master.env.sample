CACHE_VERSION=v2
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_KEY=
REPLICATE_API_TOKEN=
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WRAPPER_URL=
COMFYUI_MOTION_LORA=
COMFYUI_MOTION_LORA_WEIGHT=0.75
MOTION_CRITIQUE_VISION=0
MOTION_CRITIQUE_PER_CHUNK=0
WEAVIATE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Keyless free mode: auto when all keys empty; force with MASTER_KEYLESS=1
# MASTER_KEYLESS=1
# MASTER_WEB_CHAT=1
# OpenBSD 1GB VPS — CLI auto-applies these when hw.physmem <= 1100MB
# MASTER_SKIP_TTS=1
# MASTER_SKIP_BOOT_SCAN=1
# MASTER_WEB=0
VAPID_SUBJECT=admin@brgen.no
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Ingress bridge auth (generate: openssl rand -hex 32)
MASTER_INGRESS_TOKEN=
# CSP: set PUB4_CSP_ENFORCE=1 after manual verify in browser devtools
# PUB4_CSP_ENFORCE=1

# Production safety profile (applied in rc.d/master for 1GB VPS / stable face).
# These disable self-scan, watch, autofix, heartbeat to reduce resource use and
# avoid noisy failures on prod. See TODO.md and rc.d comments.
# MASTER_SAFE_MODE=1
# MASTER_SKIP_SELF_TEST=1
# MASTER_BACKGROUND=0
# MASTER_AUTOFIX=0
# MASTER_WATCH=0
# MASTER_WATCHER=0
# MASTER_HEARTBEAT=0
# MASTER_TTS_MODE=classic
# MASTER_TTS_TIMEOUT=45
# MASTER_TTS_POOL_SIZE=2
