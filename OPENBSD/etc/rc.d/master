#!/bin/ksh
# rc_pre and the post-start block below run bundle34, ruby34 and curl — all
# packages in /usr/local/bin. rcctl inherits its caller's PATH, and root's cron
# PATH has no /usr/local/bin, so every one of them resolved when an operator
# restarted master from a login shell and none of them resolved when
# resource_guard.sh's cron tick did. For master that was fatal rather than
# degraded: the asset gate reported "bundle34: not found", could not tell that
# apart from broken assets, and took the exit-1 branch that refuses to start.
# ai.brgen.no was down from 08:20 to 14:50 on 2026-07-31 for exactly this, and
# again from 15:10 — twice, because the guard's restart is what triggers it.
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
PORT=53187
[ -r /etc/master.env ] && . /etc/master.env
CACHE_VERSION="${CACHE_VERSION:-$(cd /home/dev/pub4 2>/dev/null && git rev-parse --short HEAD 2>/dev/null)}"
CACHE_VERSION="${CACHE_VERSION:-v2}"
daemon="/bin/ksh"
# Falcon workers: keep at 1 on 1GB VPS so amber/bsdports can boot alongside master+brgen.
# Secrets stay in /etc/master.env and are sourced inside the child so they
# do not appear in `ps` argv. CACHE_VERSION is not a secret.
# BUNDLE_FROZEN is load-bearing now that this runs as master rather than dev.
#
# Bundler.setup ends in Definition#write_lock, which touches Gemfile.lock on every
# boot even when the resolution has not changed. The lock is owned by dev, so as
# dev that write was silent and nobody knew it happened; as master it is EACCES
# and falcon never binds. ai.brgen.no went down for exactly this the first time
# daemon_user="master" reached the box, and the stack trace named File.utime
# rather than anything about permissions or users.
#
# Frozen makes the daemon a reader. It also turns the repo's structural lock drift
# (MASTER/Gemfile declares rb-kqueue on BSD only, and the lock is committed from a
# Mac) from a silent rewrite into a startup error that says which gem disagrees —
# which is the failure this box should have, because the rewrite was papering over
# a lock that does not describe what is installed here.
daemon_flags="-c 'cd /home/dev/pub4/MASTER/web && set -a && . /etc/master.env && set +a && export PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 RAILS_ENV=production CACHE_VERSION=${CACHE_VERSION} SECRET_KEY_BASE_DUMMY=1 BUNDLE_FROZEN=true && exec /usr/local/bin/bundle34 exec falcon serve -n ${FALCON_WORKERS:-1} --health-check-timeout 300 --bind http://127.0.0.1:${PORT}'"
# Prod safety flags (MASTER_SAFE_MODE etc.) live in /etc/master.env (see master.env.sample).
# rc.d sets a minimal set; env can override for the face runtime. See DeployPaths and
# MASTER/data/limits.yml for resource budgets on 1GB VPS.
# The public-facing process does not run as the user who can become root.
#
# This was daemon_user="dev", and dev's doas rule is nopass with no command
# scoping, so any code execution inside the process serving ai.brgen.no was root
# without a password — the one app on this box whose daemon_user was not its own
# user. debt.yml has called that operator-priority since it was written, and the
# fix it names is a dedicated user, not doas command rules (DECISIONS.md,
# "/etc/doas.conf installs only on a deliberate root run").
#
# master:1005, in _pub4ci for read on /home/dev -- traverse alone is not enough,
# because this is the one service whose working directory sits under it and
# getcwd(3) names an ancestor by reading it. /bin/ksh like every other
# app user because rc.subr starts a daemon through a login shell. It reads the
# code and gems from /home/dev/pub4 (0755, so read-only to it) and writes only
# MASTER/.master, web/tmp and web/log, which are dev:master 2775 — setgid so new
# files stay group-shared with the dev CLI. /etc/master.env is root:master 0640,
# the same shape as brgen.env and amber.env.
#
# Verified as master before the switch: cd, env, gems, and all three writes
# succeed; writing repo code is refused and `doas` is refused. That second pair
# is the whole point — a fold that cannot write code cannot hand dev something
# to execute, which is the path a shared checkout would otherwise leave open.
#
# Note what this does NOT cover: `bin/master` run from a terminal is still dev,
# and dev is still nopass root. This closes the REMOTE path, which is the one an
# attacker reaches.
daemon_user="master"
daemon_execdir="/home/dev/pub4/MASTER/web"
daemon_logger="daemon.notice"
daemon_timeout="300"
. /etc/rc.d/rc.subr
pexp="ruby34.*${PORT}"
rc_bg=YES
rc_reload=NO

rc_pre() {
  # Production bundle must not require dev-only gems (ferrum, debug).
  (cd /home/dev/pub4/MASTER/web && bundle34 config set --local without 'development test' 2>/dev/null
    BUNDLE_GEMFILE=Gemfile bundle34 check 2>/dev/null) || \
    (cd /home/dev/pub4/MASTER/web && bundle34 config set --local without 'development test' \
      BUNDLE_GEMFILE=Gemfile bundle34 install) 2>/dev/null || true
  # The tts-worker + media tools use MASTER/Gemfile (root), NOT web's. A drifted
  # root lock (e.g. new dilla gems never installed) crashes tts-worker at
  # Bundler.setup on every spawn -> silent TTS outage / degraded /health. Ensure
  # it here too so a restart self-heals the exact recurring failure.
  (cd /home/dev/pub4/MASTER && BUNDLE_GEMFILE=Gemfile bundle34 check 2>/dev/null) || \
    (cd /home/dev/pub4/MASTER && BUNDLE_GEMFILE=Gemfile bundle34 install) 2>/dev/null || true
  pkill -f "falcon.*${PORT}" 2>/dev/null
  pkill -f "ruby34.*${PORT}" 2>/dev/null
  pkill -f "pub4/MASTER/web" 2>/dev/null
  pkill -f "/home/dev/pub4/MASTER/bin/tts-worker" 2>/dev/null
  rm -f /home/dev/pub4/MASTER/.master/tts.sock /home/dev/pub4/MASTER/.master/tts-0.sock /home/dev/pub4/MASTER/.master/tts-1.sock 2>/dev/null || true
  # Propshaft must not re-digest public/assets/ (nested assets/assets wedges boot).
  rm -rf /home/dev/pub4/MASTER/web/public/assets/assets 2>/dev/null || true
  # Deploy-in-progress lock: other tooling (or a future agent) can check this file
  # before assuming the asset tree is in a stable, servable state.
  touch /home/dev/pub4/.deploying 2>/dev/null || true
  _face_ok=1
  for _f in /home/dev/pub4/MASTER/web/public/face.js /home/dev/pub4/MASTER/web/public/face.modules.bundle.js /home/dev/pub4/MASTER/web/public/face_vision.bundle.js; do
    [ -f "$_f" ] || _face_ok=0
  done
  if [ "$_face_ok" = "0" ]; then
    (cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec rails assets:build_face_runtime assets:build_face_modules_bundle assets:build_face_vision_bundle) 2>/dev/null || true
  fi
  _manifest=/home/dev/pub4/MASTER/web/public/assets/.manifest.json
  _stamp=/home/dev/pub4/MASTER/web/tmp/.assets_precompile_stamp
  # Every asset the chat shell loads comes from web/config/face_assets.yml via
  # face_asset_paths.rb, so a new face module is covered the moment it is added
  # to the manifest. The hand-maintained list this replaces covered 23 of 38
  # files; the 15 it missed included particle_kernel.js, face.runtime.js and
  # three.face.module.js — edit one of those, restart, and precompile was
  # silently skipped with a stale fingerprint. The tail below is the non-asset
  # inputs (stylesheet, service worker, the views themselves), which the
  # manifest does not and should not describe.
  _face_assets=$(cd /home/dev/pub4/MASTER/web && ruby34 script/face_asset_paths.rb 2>/dev/null)
  _digest=$(cksum $_face_assets \
    /home/dev/pub4/MASTER/web/public/face.part*.txt \
    /home/dev/pub4/MASTER/web/public/face.css \
    /home/dev/pub4/MASTER/web/public/face.js \
    /home/dev/pub4/MASTER/web/public/face.modules.bundle.js \
    /home/dev/pub4/MASTER/web/public/sw.js \
    /home/dev/pub4/MASTER/web/app/views/shared/_face_boot.html.erb \
    /home/dev/pub4/MASTER/web/app/views/chat/index.html.erb 2>/dev/null | cksum)
  _skip=0
  if [ -f "$_manifest" ] && [ -f "$_stamp" ] && [ "$(cat "$_stamp" 2>/dev/null)" = "$_digest" ]; then
    _skip=1
  fi
  if [ "$_skip" = "0" ]; then
    # Stamp only on success. `|| true` swallowed a failed precompile and the
    # stamp went down regardless — and because the skip test above is
    # stamp-equals-digest, one failure then made every later start skip
    # precompile as well. Nothing retries until an input file changes.
    #
    # Measured 2026-08-13 on vm23: MASTER/web had no public/assets directory at
    # all, a stamp from that day's deploy, and /health reporting
    # face_runtime_digest: null — the field the deploy-confidence playbook says
    # to check. It stayed invisible because public/ is served undigested, so the
    # face kept working while every fingerprinted asset was missing.
    if (cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec rails assets:precompile) 2>/dev/null; then
      mkdir -p /home/dev/pub4/MASTER/web/tmp
      echo "$_digest" > "$_stamp"
    else
      logger -t master "assets:precompile failed — stamp not written, will retry next start"
    fi
  fi
  # Load-bearing asset gate: refuse to start serving a broken face.js/manifest
  # mismatch (the exact class of bug that wedged the primer boot on 2026-07-10).
  # One self-heal precompile retry before actually blocking the start.
  _gate=/home/dev/pub4/RAILS/gates/runner.rb
  _gate_name=master_web_assets
  if [ -f "$_gate" ]; then
    _gate_out=$(cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec ruby "$_gate" "$_gate_name" 2>&1)
    _gate_rc=$?
    if [ "$_gate_rc" != "0" ]; then
      logger -t master "assets gate failed, forcing fresh precompile and retrying once: $_gate_out"
      (cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec rails assets:precompile) 2>/dev/null || true
      echo "$_digest" > "$_stamp"
      _gate_out=$(cd /home/dev/pub4/MASTER/web && RAILS_ENV=production bundle34 exec ruby "$_gate" "$_gate_name" 2>&1)
      _gate_rc=$?
      if [ "$_gate_rc" != "0" ]; then
        logger -t master "CRITICAL: assets gate still failing after retry, refusing to start with broken assets: $_gate_out"
        rm -f /home/dev/pub4/.deploying 2>/dev/null || true
        exit 1
      fi
      logger -t master "assets gate passed after retry precompile"
    fi
  fi
  rm -f /home/dev/pub4/.deploying 2>/dev/null || true
  sleep 1
}

rc_cmd $1
rc=$?
if [ "$1" = "start" ] || [ "$1" = "restart" ]; then
  if [ "$rc" = "0" ]; then
    ruby34 -ryaml -e 'c=YAML.load_file("/home/dev/pub4/MASTER/.master/config.yml") rescue {}; u=c["web_public_url"]||"http://127.0.0.1:#{c["web_port"]||53187}"; t=c["web_token"]; puts t ? "web: #{u}/?token=#{t}" : "web: #{u}"' 2>/dev/null
    # Wait for Falcon /up, then restart relayd so HTTPS does not stay empty after rcctl restart master.
    _i=0
    _up_ok=0
    while [ "$_i" -lt 300 ]; do
      curl -fsS "http://127.0.0.1:${PORT}/up" >/dev/null 2>&1 && { _up_ok=1; break; }
      sleep 1
      _i=$((_i + 1))
    done
    # Wait for MASTER container (smoke ping — metrics requires auth since tier gate).
    _ping_ok=0
    _j=0
    while [ "$_j" -lt 120 ]; do
      curl -fsS "http://127.0.0.1:${PORT}/chat/message?message=ping" 2>/dev/null | grep -q 'pong' && { _ping_ok=1; break; }
      sleep 2
      _j=$((_j + 1))
    done
    if [ "$_up_ok" = "1" ]; then
      rcctl restart relayd 2>/dev/null || true
    else
      logger -t master "relayd skipped: /up not ready after restart"
    fi
    if [ "$_ping_ok" = "0" ]; then
      logger -t master "container warmup: ping not ready after 240s"
    fi
    # Warm TTS with MASTER Gemfile only — never inherit Falcon web/vendor/bundle env.
    _tts_warm_ok=0
    if su -m dev -c 'unset BUNDLE_PATH GEM_HOME GEM_PATH BUNDLE_BIN_PATH BUNDLE_WITHOUT BUNDLE_DEPLOYMENT RUBYOPT; cd /home/dev/pub4/MASTER && BUNDLE_GEMFILE=/home/dev/pub4/MASTER/Gemfile MASTER_TTS_TIMEOUT=45 bundle34 exec ruby -Ilib -e "require \"master\"; exit(Master::Voice::TtsSupervisor.ensure_daemon! ? 0 : 1)"' 2>>/var/log/daemon; then
      _l=0
      while [ "$_l" -lt 30 ]; do
        [ -S /home/dev/pub4/MASTER/.master/tts-0.sock ] && { _tts_warm_ok=1; break; }
        sleep 1
        _l=$((_l + 1))
      done
    fi
    if [ "$_tts_warm_ok" = "0" ]; then
      logger -t master "CRITICAL: TTS sockets missing after ensure_daemon (check .master/tts-worker-*.log)"
    fi
    ruby34 /home/dev/pub4/MASTER/web/script/probe_http 2>/dev/null || logger -t master "probe_http failed after restart"
  fi
fi
exit $rc
