#!/bin/ksh
# rc_pre and the post-start block run curl (a package, /usr/local/bin/curl).
# rcctl inherits its caller PATH and root cron has no /usr/local/bin, so from
# a cron restart the /up wait always timed out and the relayd restart behind
# it was skipped — the app came up with an empty relayd backend table. Same
# gap that refused to start master outright (see rc.d/master).
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
PORT=38182
APP_DIR=/home/brgen/app
[ -r /etc/rails/common.env ] && . /etc/rails/common.env
[ -r /etc/brgen.env ] && . /etc/brgen.env
[ -f /etc/rails/brgen.env ] && . /etc/rails/brgen.env
: "${SECRET_KEY_BASE:?missing SECRET_KEY_BASE in /etc/brgen.env}"
daemon="/bin/ksh"
# SECRET_KEY_BASE is sourced from /etc/brgen.env at runtime by the app user and
# re-exported (the file holds a bare KEY=value, which `.` sets un-exported) — NOT
# interpolated into daemon_flags, where it landed in falcon's ps(1) argv for any
# local account to read (debt.yml secrets_in_process_argv). /etc/brgen.env is
# root:brgen 640. PUB4_ROOT/PUB4_RAILS_ROOT are not secrets and stay inline.
# SOLID_QUEUE_IN_PUMA=true was here and is gone. In-Puma mode is a Puma plugin;
# this app runs under Falcon and has no config/puma.rb, so no plugin ever loaded
# and the variable was read by nothing. It was the only thing that looked like a
# job worker and it had never started one — 1670 jobs enqueued on brgen and 0
# finished, measured 2026-08-12. rc.d/<app>_jobs is the real worker; read its
# footer before enabling it, because vm23 has 1 GB.
#
# RUBY_YJIT_ENABLE=0 is a decision, not a default.
#
# Ruby 3.4 on vm23 has YJIT built in and switched off, so today this changes
# nothing — which is the point. YJIT reserves an executable code region and costs
# tens of megabytes per process to buy 15-30% more speed, and here the scarce
# resource is memory rather than CPU: measured 2026-08-17 at 918M real with swap
# 91% full and the single core 84% idle. Four Rails processes' worth of code
# cache is the wrong trade on this box.
#
# Pinned because the default is drifting the other way: the Dockerfile Rails
# generates sets RUBY_YJIT_ENABLE=1, and a future Ruby may turn it on at build
# time. Without this line the box would quietly start paying for it, and the
# symptom would be swap rather than anything that names YJIT.
daemon_flags="-c 'cd ${APP_DIR} && . /etc/brgen.env && export RUBY_YJIT_ENABLE=0 RAILS_ENV=production SECRET_KEY_BASE HOME=/home/brgen PUB4_ROOT=/home/dev/pub4 PUB4_RAILS_ROOT=/home/dev/pub4/RAILS && exec /usr/local/bin/bundle34 exec falcon serve -n ${FALCON_WORKERS:-1} --health-check-timeout 300 --bind http://127.0.0.1:${PORT}'"
daemon_user="brgen"
daemon_execdir="/home/brgen/app"
daemon_logger="daemon.notice"
daemon_timeout="120"
. /etc/rc.d/rc.subr
pexp="ruby34.*${PORT}"
rc_bg=YES
rc_reload=NO

rc_pre() {
  touch /home/dev/pub4/.deploying-brgen 2>/dev/null || true
  pkill -f "falcon.*${PORT}" 2>/dev/null || true
  pkill -f "ruby34.*${PORT}" 2>/dev/null || true
  sleep 1
  rm -f /home/dev/pub4/.deploying-brgen 2>/dev/null || true
}

rc_cmd $1
rc=$?
if [ "$1" = "start" ] || [ "$1" = "restart" ]; then
  if [ "$rc" = "0" ]; then
    # relayd can keep routing to the old (now-dead) backend connection after a
    # restart until it's kicked — same fix already used by MASTER's rc.d script.
    _i=0
    _up_ok=0
    while [ "$_i" -lt 30 ]; do
      curl -fsS "http://127.0.0.1:${PORT}/up" >/dev/null 2>&1 && { _up_ok=1; break; }
      sleep 1
      _i=$((_i + 1))
    done
    if [ "$_up_ok" = "1" ]; then
      rcctl restart relayd 2>/dev/null || true
    else
      logger -t brgen "relayd skipped: /up not ready after restart"
    fi
  fi
fi
exit $rc
