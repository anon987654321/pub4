#!/bin/ksh
# rc_pre and the post-start block run curl (a package, /usr/local/bin/curl).
# rcctl inherits its caller PATH and root cron has no /usr/local/bin, so from
# a cron restart the /up wait always timed out and the relayd restart behind
# it was skipped — the app came up with an empty relayd backend table. Same
# gap that refused to start master outright (see rc.d/master).
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
PORT=61352
APP_DIR=/home/amber/app
# /etc/amber.env is the one env file: daemon_flags sources nothing else, so a
# key anywhere else never reaches the app.
[[ -r /etc/amber.env ]] && . /etc/amber.env
: "${SECRET_KEY_BASE:?missing SECRET_KEY_BASE in /etc/amber.env}"
daemon="/bin/ksh"
# --health-check-timeout: Falcon defaults to 30s, and on 1 vCPU with master and
# brgen already resident this app has never booted that fast — the container
# declared startup failed and SIGKILLed its own worker on every restart, which
# is a large part of why this service kept reading as "shed but never
# restored". master and brgen have carried 300 since the same discovery.
# SECRET_KEY_BASE is sourced from /etc/amber.env at runtime by the app user and
# re-exported (the file holds a bare KEY=value, which `.` sets un-exported) —
# NOT interpolated into daemon_flags, where it landed in falcon's ps(1) argv for
# any local account to read (secrets in process argv). The env file is
# root:amber 640, so only amber and root can read it (not dev-via-wheel, not
# another app user). Proven on bsdports first.
# SOLID_QUEUE_IN_PUMA=true was here and is gone. In-Puma mode is a Puma plugin;
# this app runs under Falcon and has no config/puma.rb, so no plugin ever loaded
# and the variable was read by nothing. It was the only thing that looked like a
# job worker and it had never started one — 1670 jobs enqueued on brgen and 0
# finished, measured 2026-08-12. rc.d/<app>_jobs is the real worker; read its
# header before enabling it, because vm23 has 1 GB.
# rc.d cannot source the repo, so pick whichever bundler the package manager
# installed (OpenBSD ships Ruby by version; none is named here).
for _bundle in /usr/local/bin/bundle4.0 /usr/local/bin/bundle40 /usr/local/bin/bundle3.4 /usr/local/bin/bundle34 /usr/local/bin/bundle3.3 /usr/local/bin/bundle33 /usr/local/bin/bundle; do
  if [ -x "$_bundle" ]; then break; fi
done
daemon_flags="-c 'cd ${APP_DIR} && set -a && . /etc/amber.env && set +a && export RUBY_YJIT_ENABLE=0 RAILS_ENV=production HOME=/home/amber && export BUNDLE_VERSION=system && exec ${_bundle} exec falcon serve -n ${FALCON_WORKERS:-1} --health-check-timeout 300 --bind http://127.0.0.1:${PORT}'"
daemon_user="amber"
daemon_execdir="/home/amber/app"
daemon_logger="daemon.notice"
daemon_timeout="120"
. /etc/rc.d/rc.subr
pexp="ruby[0-9.]*.*${PORT}"
rc_bg=YES
rc_reload=NO

# port holders: begin
# The pkills match falcon by its argv, so a process bound to the port under any
# other name (a worker that retitled itself, a hand-started server, a test run)
# survives them, the next falcon dies on EADDRINUSE, and rc reports a start that
# never serves. fstat(1) names every process with a socket on the port whatever
# its argv. Its socket lines read USER CMD PID FD internet stream tcp ADDR
# LOCAL [ARROW PEER]; a listener is the line with no peer, which leaves relayd's
# connections to the port and the app's accepted ones alone.
port_holders() {
  fstat 2>/dev/null | while read -r _u _c _pid _fd _kind _type _proto _addr _local _rest; do
    [[ $_kind == internet || $_kind == internet6 ]] || continue
    [[ $_proto == tcp && -z $_rest ]] || continue
    [[ $_local == *:"$PORT" ]] && print -n -- "$_pid "
  done
}

# Sends signal $1 to every holder, one pid at a time.
signal_holders() {
  for _p in $(port_holders); do
    kill "-$1" "$_p" 2>/dev/null
  done
}

# TERM whatever still holds the port, KILL it after the grace period, and fail
# when the port is still held, so the start is refused with the reason logged.
free_port() {
  _holders=$(port_holders)
  [[ -n $_holders ]] || return 0
  logger -t "$PORT_OWNER" "stale :${PORT} holder(s) ${_holders% } before start, TERM"
  signal_holders TERM
  _w=0
  while [[ -n $(port_holders) ]] && (( _w < ${PORT_GRACE:-20} )); do
    sleep 1
    _w=$((_w + 1))
  done
  _holders=$(port_holders)
  [[ -n $_holders ]] || return 0
  logger -t "$PORT_OWNER" "stale :${PORT} holder(s) ${_holders% } survived TERM, KILL"
  signal_holders KILL
  sleep 1
  [[ -z $(port_holders) ]] && return 0
  logger -t "$PORT_OWNER" "CRITICAL: :${PORT} still held after TERM and KILL, refusing to start"
  return 1
}
# port holders: end

rc_pre() {
  touch /home/dev/pub4/.deploying-amber 2>/dev/null || true
  pkill -f "falcon.*${PORT}" 2>/dev/null || true
  pkill -f "ruby[0-9.]*.*${PORT}" 2>/dev/null || true
  sleep 1
  PORT_OWNER=amber
  free_port || { rm -f /home/dev/pub4/.deploying-amber 2>/dev/null; return 1; }
}

rc_cmd $1
rc=$?
if [[ "$1" = "start" ]] || [[ "$1" = "restart" ]]; then
  if [[ "$rc" = "0" ]]; then
    # relayd can keep routing to the old (now-dead) backend connection after a
    # restart until it's kicked — same fix already used by MASTER's rc.d script.
    _i=0
    _up_ok=0
    while [[ "$_i" -lt 300 ]]; do
      curl -fsS -m 5 "http://127.0.0.1:${PORT}/up" >/dev/null 2>&1 && { _up_ok=1; break; }
      sleep 1
      _i=$((_i + 1))
    done
    if [[ "$_up_ok" = "1" ]]; then
      rcctl restart relayd 2>/dev/null || true
    else
      logger -t amber "relayd skipped: /up not ready after restart"
    fi
  fi
fi
# rc_pre touched the deploy flag; it comes off here, after the /up wait, so the
# cold boot is inside the window resource_guard reads it for.
if [ "$1" = "start" ] || [ "$1" = "restart" ]; then
  rm -f /home/dev/pub4/.deploying-amber 2>/dev/null || true
fi
exit $rc
