#!/bin/ksh
# Solid Queue worker for brgen. Enabled on vm23 since 2026-08-25 (e511ccba1): the one resident worker
# this box can hold.
#
# Why the workers exist, what went unrun before them, how to enable one and
# how to confirm it took: OPENBSD/DECISIONS.md, "Falcon Only (No Puma)".
# health_check.rb fails when a queue has due work and no registered process.
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
APP_DIR=/home/brgen/app
# /etc/brgen.env is the one env file: daemon_flags sources nothing else.
[[ -r /etc/brgen.env ]] && . /etc/brgen.env
: "${SECRET_KEY_BASE:?missing SECRET_KEY_BASE in /etc/brgen.env}"

daemon="/bin/ksh"
# Sourced inside the app user's shell rather than interpolated here, where the
# secret would sit in ps(1) argv; under set -a because `.` sets a bare
# KEY=value unexported, and the job classes need every key in the file.
daemon_flags="-c 'cd ${APP_DIR} && set -a && . /etc/brgen.env && set +a && export RAILS_ENV=production HOME=/home/brgen PUB4_ROOT=/home/dev/pub4 PUB4_RAILS_ROOT=/home/dev/pub4/RAILS && exec /usr/local/bin/bundle34 exec rake solid_queue:start'"
daemon_user="brgen"
daemon_execdir="/home/brgen/app"
daemon_logger="daemon.notice"
daemon_timeout="120"

. /etc/rc.d/rc.subr
# The process renames itself to "ruby34: solid-queue-supervisor(1.2.4): ...",
# hence both - and _. rc.subr checks with `pgrep -q -xf "${pexp}"`, and -x
# anchors the whole argv, which continues past the name: the trailing .* is
# what lets rcctl check and stop see a running worker at all.
pexp="ruby34.*solid[-_]queue.*"
rc_bg=YES
rc_reload=NO

rc_cmd $1
