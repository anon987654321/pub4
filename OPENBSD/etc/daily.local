#!/bin/sh
# Interpreters by absolute path, and PATH set anyway.
#
# /etc/daily inherits cron's environment, which does not include /usr/local/bin —
# where every interpreter on this box lives. `ruby` on line 2 and `ruby34` on the
# config_drift_gate line both failed to exec on every run, and the second one was
# invisible because its `2>&1` sent the shell's own "not found" into the output
# file it was writing. See etc/crontab.vm23 for the full accounting; the PATH line
# there is the real fix, and this is the belt to its braces — daily.local is also
# run by hand, from shells that have their own ideas about PATH.
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin
export PATH

/usr/local/bin/ruby34 /usr/local/bin/nsd-resign
/usr/local/bin/config-drift-check || logger -t daily.local "config-drift-check failed"
/usr/local/bin/ruby34 /home/dev/pub4/OPENBSD/config_drift_gate.rb >/tmp/config-drift.out 2>&1 || \
  logger -t daily.local "repo/live config drift — see /tmp/config-drift.out (e.g. sshd PasswordAuthentication)"
# su without -l, and its failure is now audible. `su -l` runs dev's login profile,
# which boots MASTER's sqlite store and prints "disk I/O error" and "Must be
# connected to a terminal" before the backup even starts — noise that made the
# real error below it look like more of the same. And the `||` matters: this
# failed every night for months (wrong port, wrong host alias, no remote
# directory, and openssl prompting for a passphrase with no terminal to type it
# on) and daily(8) carried straight on to report the rest of the run.
su dev -c 'cd /home/dev/pub4 && zsh OPENBSD/backup_priv.sh' ||
  logger -t daily.local "backup_priv failed - ~/priv was not backed up (see OPENBSD/backup_priv.sh header)"

# The guest prune moved out of here on 2026-08-14, the morning after its one run.
#
# It removed nothing. /etc/daily starts at 01:30 and has the box at load 4.12 by
# the time it reaches daily.local, which is over PruneGuestUsersJob's own ceiling
# of 3.0 — so the job's safety guard refused, correctly, every time this file was
# going to call it. The schedule and the guard were fighting each other, and the
# schedule was the part that was chosen here.
#
# It is now /usr/local/bin/prune-guests.sh at 04:20 from the root crontab, which
# waits for the load to fall instead of skipping the night, sets HOME (cron has
# it at /var/log and `su -m` preserves it), and prints its result rather than
# trusting Rails.logger — brgen's production logger does not write to stdout, so
# the one run that did happen left no line about brgen at all.

if command -v drill >/dev/null 2>&1; then
  drill @127.0.0.1 brgen.no SOA >/tmp/nsd-check.out 2>&1 || \
    logger -t daily.local "NSD smoke check failed for brgen.no"
elif command -v dig >/dev/null 2>&1; then
  dig @127.0.0.1 brgen.no SOA +short >/tmp/nsd-check.out 2>&1 || \
    logger -t daily.local "NSD smoke check failed for brgen.no"
else
  logger -t daily.local "NSD smoke check skipped — no drill or dig"
fi
