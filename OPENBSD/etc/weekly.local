#!/bin/sh
# Run by /etc/weekly, which cron invokes Saturday 03:30. Same PATH caveat as
# daily.local: cron does not carry /usr/local/bin, and every interpreter here
# lives there.
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin
export PATH

# Are the domains still ours, and how long have we got.
#
# Weekly rather than daily because it makes one whois query per domain and the
# registries rate-limit; and as dev rather than root because it only reads whois
# and writes a file inside dev's own checkout — root executing a dev-owned tree
# is the hazard that got the doas.conf "heal" removed from relayd-watchdog.
#
# It exits non-zero when something is expiring, lapsed, or has changed hands, so
# the logger line is the alert. It went in on 2026-08-12, the day a whois sweep
# found cardff.uk and edinbrgh.uk — two of the seven cities that serve — expiring
# the next morning, denvr.us the same day, and four .uk domains that had expired
# in June and were still inside Nominet's protected period. Every one of those
# dates was already in OPENBSD/data/domain_inventory.yml, committed, and nothing
# read it. Five days earlier the same thing happened to bsdports.org.
# su without -l. The login profile boots MASTER's sqlite store and prompts for a
# passphrase, so `su -l` put three lines of "disk I/O error" and "Must be
# connected to a terminal" at the top of a log whose whole job is to be read when
# something is wrong. (That prompt is also why daily.local's backup_priv.sh has
# been failing every night.)
#
# Plain ASCII in the logger line: syslog renders an em dash as M-bM^@M^T.
su dev -c 'cd /home/dev/pub4 && /usr/local/bin/ruby34 OPENBSD/bin/domain_watch.rb' \
  > /var/log/domain_watch.log 2>&1 ||
  logger -t weekly.local "domain_watch: a domain is expiring, lapsed or changed hands - see /var/log/domain_watch.log"

# Repack the checkout on a schedule instead of whenever a pull happens to trip
# git's threshold.
#
# git runs `gc --auto` after a pull and detaches it, so the repack is invisible
# and its timing is decided by loose-object count. On 2026-08-23 a pull before a
# deploy spawned pack-objects holding 266 MB on a 1 GB box; the Rails suite died
# on SIGTERM after 18 tests and the seed step after it, and the deploy log showed
# only "bin/rails aborted!" with no cause in it. `gc.auto 0` is set in dev's
# checkout, so this line is not an optimisation — it is the only thing that packs
# the repo now. 51 packs and 4400 loose objects when it went in.
#
# As dev for the same reason domain_watch is: root repacking a dev-owned tree
# leaves root-owned pack files behind, and the next pull cannot write them.
su dev -c 'cd /home/dev/pub4 && /usr/local/bin/git gc --quiet' \
  > /var/log/git_gc.log 2>&1 ||
  logger -t weekly.local "git gc failed in /home/dev/pub4 - see /var/log/git_gc.log"
