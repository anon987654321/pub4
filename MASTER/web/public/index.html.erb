<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <%= csrf_meta_tags %>
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <meta name="master-runtime" content="face">
  <meta name="master-visual-profile" content="auto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>brgen</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="preload" href="/face.css" as="style">
  <link rel="modulepreload" href="/three.module.js?v=29">
  <link rel="modulepreload" href="/face.js?v=29">
  <link rel="stylesheet" href="/face.css?v=29">
</head>
<body class="zen face-loading" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face">
  <div class="top-left-logo" aria-hidden="true">brgen</div>
  <canvas id="face" aria-hidden="true"></canvas>
  <div id="ascii-star" aria-hidden="true"></div>
  <div id="tts-live" aria-live="polite" aria-atomic="true"></div>
  <div id="primer" role="dialog" aria-modal="true" aria-labelledby="primer-title" tabindex="0">
    <h1 id="primer-title">tap to start</h1>
  </div>
  <main id="chat-shell" aria-label="MASTER chat" hidden>
    <div id="chat-log" aria-live="polite" aria-relevant="additions text"></div>
  </main>
  <div class="ui-status" id="ui-status" hidden aria-live="polite" aria-atomic="true">idle</div>
  <div id="soul-drift" class="soul-drift" aria-hidden="true"></div>
  <div id="mood-sparkline" class="mood-sparkline" aria-hidden="true"></div>
  <div class="face-controls" aria-label="Face controls">
    <button id="theme-btn" type="button" class="tool" aria-pressed="false" title="Toggle theme">◐</button>
    <button id="focus-btn" type="button" class="tool" aria-pressed="false" title="Toggle focus mode">◎</button>
    <label class="face-scale" for="font-scale" title="Adjust font size">
      <span aria-hidden="true">A</span>
      <input id="font-scale" type="range" min="0.85" max="1.4" step="0.05" value="1">
    </label>
    <label class="voice-picker" for="voice-picker" title="Select voice">
      <span aria-hidden="true">◉</span>
      <select id="voice-picker" aria-label="Voice selection">
        <option value="ms-MY-OsmanNeural">Osman</option>
        <option value="en-GB-RyanNeural">Ryan</option>
        <option value="nb-NO-FinnNeural">Finn</option>
        <option value="en-US-AndrewNeural">Andrew</option>
        <option value="en-US-GuyNeural">Guy</option>
        <option value="en-AU-WilliamNeural">William</option>
        <option value="en-US-ChristopherNeural">Christopher</option>
        <option value="en-US-EricNeural">Eric</option>
        <option value="nb-NO-PernilleNeural">Pernille</option>
        <option value="en-US-DavisNeural">Davis</option>
        <option value="en-SG-WayneNeural">Wayne</option>
        <option value="en-NG-EzinneNeural">Ezinne</option>
        <option value="en-US-JennyNeural">Jenny</option>
      </select>
    </label>
    <button id="voice-preview-btn" type="button" class="tool" aria-label="Preview selected voice" title="Preview selected voice">▶</button>
  </div>
  <div id="mood-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <form id="zsh" role="search" hidden aria-label="MASTER prompt" autocomplete="off">
    <span class="pp">master</span><span class="sep2">$ </span>
    <input id="zin" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything" aria-label="Message">
    <span id="char-count" aria-hidden="true"></span>
    <span id="zsh-status" aria-live="polite" aria-atomic="true"></span>
    <div id="zsh-wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <button id="spin-btn" type="button" aria-label="Pause or resume" title="Pause or resume">❚❚</button>
  </form>
  <script>
    window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v1").to_json.html_safe %>;
    window.MASTER_SOUL_SUMMARY = "persona malay; voice ms-MY-OsmanNeural; language english primary and norwegian secondary; golden rule preserve then improve never break";
    window.MASTER_SOUL_DRIFT = (function(text) {
      let hash = 0;
      for (let i = 0; i < text.length; i++) hash = ((hash << 5) - hash + text.charCodeAt(i)) | 0;
      return Math.abs(hash % 1000) / 1000;
    })(window.MASTER_SOUL_SUMMARY);
    (function(){
      var p=document.getElementById('primer'),z=document.getElementById('zsh'),fired=false;
      function go(){if(fired)return;fired=true;window._primerFired=true;p.style.transition='opacity 160ms ease';p.style.opacity='0';setTimeout(function(){if(p&&p.parentNode)p.parentNode.removeChild(p);},220);if(z)z.classList.add('live');}
      if(p){p.addEventListener('pointerdown',go);p.addEventListener('touchstart',go,{passive:true});p.addEventListener('click',go);}
      setTimeout(function(){if(!fired)go();},1200);
    })();
  </script>
  <script type="module" src="/face.js?v=29"></script>
  <script src="/chat.js?v=29" defer></script>
</body>
</html>
