<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <title>MASTER — mission control</title>
  <link rel="stylesheet" href="/face.css">
</head>
<body class="mission-control" data-layout="document" data-surface="face" data-theme="dark">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="page-header" role="banner">
    <h1><a href="/">← chat</a> · mission control</h1>
  </header>
  <main id="main-content" role="main" aria-label="Mission control">
    <div class="grid" id="mission-grid">
      <div class="panel"><h2>status</h2><pre id="status" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>rtk savings</h2><pre id="rtk" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>active plan</h2><pre id="plan" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>rsi inbox</h2><pre id="rsi" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>skills</h2><pre id="skills" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>context pressure</h2><pre id="pressure" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>provider health</h2><pre id="providers" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>repair queue</h2><pre id="repair" aria-live="polite">loading…</pre></div>
      <div class="panel"><h2>recent bus</h2><pre id="bus" aria-live="polite">loading…</pre></div>
    </div>
  </main>
  <script>
    async function refresh() {
      const r = await fetch('/dashboard/live');
      const d = await r.json();
      if (d.error) { document.getElementById('status').textContent = d.error; return; }
      document.getElementById('status').textContent = [
        `model: ${d.model}`,
        `ctx: ${d.tokens} tokens`,
        `cost: $${Number(d.cost || 0).toFixed(4)}`,
        `agent pool: ${d.agent_pool} active`,
        `breakers: ${(d.open_breakers || []).join(', ') || 'none'}`
      ].join('\n');
      const rtk = d.rtk || {};
      document.getElementById('rtk').textContent = [
        `commands: ${rtk.commands || 0}`,
        `saved: ${rtk.saved_pct || 0}%`,
        `bytes: ${rtk.bytes_out || 0} / ${rtk.bytes_in || 0}`
      ].join('\n');
      document.getElementById('plan').textContent = d.active_plan || '(none)';
      document.getElementById('rsi').textContent = (d.rsi_inbox || []).map(i => `${i.path}\n${i.excerpt}`).join('\n\n') || '(empty)';
      document.getElementById('skills').textContent = (d.skills || []).join('\n') || '(none)';
      const p = d.context_pressure || {};
      document.getElementById('pressure').textContent = [
        `band: ${p.band || 'ok'}`,
        `tokens: ${p.tokens || 0} / ${p.limit || 0}`,
        `pct: ${p.pct || 0}%`,
        `headroom: ${p.headroom || 0}`
      ].join('\n');
      const ph = d.provider_health || {};
      document.getElementById('providers').textContent = [
        `status: ${ph.status || 'unknown'}`,
        `open breakers: ${(ph.open_breakers || []).join(', ') || 'none'}`,
        `agent pool: ${ph.agent_pool || 0}`
      ].join('\n');
      document.getElementById('repair').textContent = (d.repair_queue || []).map((item) => {
        const recent = (item.recent || []).join('\n  ');
        return `${item.path} (${item.count || 0} bytes)\n  ${recent}`;
      }).join('\n\n') || '(empty)';
      document.getElementById('bus').textContent = (d.bus_events || []).slice(-12).map(e => JSON.stringify(e)).join('\n') || '(quiet)';
    }
    refresh();
    setInterval(refresh, 8000);
  </script>
</body>
</html>
