<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "MASTER" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MASTER">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark">
    <meta name="master-runtime" content="face">
    <meta name="master-visual-profile" content="auto">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">
    <script>
      window.MASTER_ASSET_PATHS = {
        threeModule: "<%= asset_path("three.face.module.js") %>"
      };
    </script>
    <script>
      <% persona = Rails.application.config.x.master_container&.[](:personality) %>
      window.MASTER_PERSONA = <%= raw((persona.respond_to?(:browser_profile) ? persona.browser_profile : {}).to_json) %>;
    </script>
    <link rel="preload" href="<%= asset_path("face.css") %>" as="style">
    <link rel="stylesheet" href="<%= asset_path("face.css") %>">
    <link rel="stylesheet" href="<%= asset_path("photo_upload.css") %>">
  </head>
  <body class="x-app zen" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="app-shell">
      <div class="layout">
        <aside class="sidebar" aria-label="Sidebar">
          <a href="/" class="brand" aria-label="MASTER">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <nav aria-label="Primary navigation">
            <a href="/" class="nav-item">Chat</a>
            <a href="https://brgen.no" class="nav-item">Brgen</a>
            <a href="/dashboard" class="nav-item">Status</a>
          </nav>
        </aside>
        <main id="main-content" role="main">
          <%= yield %>
        </main>
        <aside class="widgets" aria-label="Widgets"></aside>
      </div>
    </div>
    <script>
      window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v2").to_json.html_safe %>;
    </script>
    <script src="<%= asset_path("topology_registry.js") %>" defer></script>
    <script src="<%= asset_path("particle_kernel.js") %>" defer></script>
    <script src="<%= asset_path("chat_actions.js") %>" defer></script>
    <script src="<%= asset_path("visual_bridge.js") %>" defer></script>
    <script src="<%= asset_path("cognition_ecology.js") %>" defer></script>
    <script src="<%= asset_path("cognition_ecology_render.js") %>" defer></script>
    <script src="<%= asset_path("codebase.js") %>" defer></script>
    <script src="<%= asset_path("chat.js") %>" defer></script>
  </body>
</html>