<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "MASTER" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MASTER">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="master-tier" content="<%= request.env['master.tier'] || 'visitor' %>">
    <meta name="theme-color" content="#000000">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag :app, defer: true %>
  </head>

  <body
    data-master-tier="<%= request.env['master.tier'] || 'visitor' %>"
    data-runtime-profile="calm"
    data-runtime-visible="true"
    data-visual-runtime="rails">
    <canvas id="mask" aria-hidden="true"></canvas>
    <section class="face-plate" aria-hidden="true">
      <div class="face-core">
        <span class="face-eye face-eye-left"></span>
        <span class="face-eye face-eye-right"></span>
        <span class="face-mouth"></span>
      </div>
    </section>
    <main id="app-shell">
      <%= yield %>
    </main>
    <nav aria-label="Primary"><a href="/">chat</a></nav>
    <section class="runtime-console" aria-label="MASTER prompt">
      <textarea id="input" rows="1" placeholder="type here..." autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
      <div id="status" aria-live="polite" data-runtime-status="idle">ready</div>
    </section>
    <script src="/visual_governor.js" defer></script>
    <script src="/topology_registry.js" defer></script>
    <script src="/particle_kernel.js" defer></script>
    <script type="module" src="/mask.js" defer></script>
  </body>
</html>