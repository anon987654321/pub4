<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "brgen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="brgen">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#030303">
    <meta name="master-runtime" content="face">
    <meta name="master-visual-profile" content="auto">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;700&display=swap">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">
    <script>
      window.MASTER_ASSET_PATHS = {
        threeModule: "<%= asset_path("three.face.module.js") %>",
        face3dEngine: "<%= asset_path("face3d_engine.js") %>",
        face3dRenderer: "<%= asset_path("face3d_renderer.js") %>"
      };
    </script>
    <script>
      <% persona = Rails.application.config.x.master_container&.[](:personality) %>
      window.MASTER_PERSONA = <%= raw((persona.respond_to?(:browser_profile) ? persona.browser_profile : {}).to_json) %>;
    </script>
    <link rel="preload" href="<%= asset_path("face.css") %>" as="style">
    <link rel="modulepreload" href="<%= asset_path("three.face.module.js") %>">
    <link rel="modulepreload" href="<%= asset_path("face.js") %>">
    <link rel="stylesheet" href="<%= asset_path("face.css") %>">
    <link rel="stylesheet" href="<%= asset_path("photo_upload.css") %>">
  </head>
  <body class="zen" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face">
    <a class="skip-link" href="#main-content">skip to main content</a>
    <div class="top-left-logo" aria-hidden="true">brgen</div>
    <canvas id="cognition-ecology" aria-hidden="true"></canvas>
    <canvas id="face" aria-hidden="true"></canvas>
    <div id="primer" role="dialog" aria-modal="true" aria-labelledby="primer-title" tabindex="0">
      <div>
        <h1 id="primer-title">master</h1>
        <p class="tagline">Constitutional AI. Ask anything.</p>
        <div class="chips">
          <span class="chip">tap to begin</span>
          <span class="chip">+ photo</span>
          <span class="chip">mic voice</span>
          <span class="chip">swipe up input</span>
        </div>
      </div>
    </div>
    <main id="chat-shell" aria-label="MASTER chat">
      <div id="chat-log" aria-live="polite" aria-relevant="additions text"></div>
    </main>
    <form id="zsh" role="search" aria-label="MASTER prompt" autocomplete="off">
      <button id="photo-button" type="button" aria-label="Attach photo">+</button>
      <input id="photo" type="file" accept="image/*" capture="environment" hidden>
      <span class="pp">visitor</span><span class="sep">@master</span><span class="sep2"> $ </span>
      <input id="zin" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything" aria-label="Message">
    </form>
    <main id="main-content" aria-label="MASTER content">
      <%= yield %>
    </main>
    <script>
      window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v2").to_json.html_safe %>;
      (function(){
        var p=document.getElementById('primer'),z=document.getElementById('zsh'),fired=false,timer=null,fallback=null;
        function dismissPrimer(){
          document.body.classList.remove('face-loading');
          if(!p)return;
          p.classList.add('gone');
          window.setTimeout(function(){p.remove();},220);
        }
        function revealPrompt(){if(z)z.classList.add('live');}
        function boot(){
          if(window.MASTER_FACE&&window.MASTER_FACE.startEverything){
            window.MASTER_FACE.startEverything();
            return true;
          }
          return false;
        }
        function finishBoot(){
          if(timer){clearInterval(timer);timer=null;}
          if(fallback){clearTimeout(fallback);fallback=null;}
          dismissPrimer();
          revealPrompt();
        }
        function go(){
          if(fired)return;
          fired=true;
          window._primerFired=true;
          if(boot()){finishBoot();return;}
          timer=setInterval(function(){if(boot())finishBoot();},40);
          fallback=setTimeout(function(){
            if(window.MASTER_FACE&&window.MASTER_FACE.primerFired)finishBoot();
            else finishBoot();
          },15000);
        }
        addEventListener('master:face-ready',function(){if(fired&&boot())finishBoot();});
        if(p){
          p.addEventListener('pointerdown',go);
          p.addEventListener('touchend',go,{passive:true});
          p.addEventListener('click',go);
          p.addEventListener('keydown',function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();go();}});
        }
      })();
    </script>
    <script src="<%= asset_path("topology_registry.js") %>" defer></script>
    <script src="<%= asset_path("particle_kernel.js") %>" defer></script>
    <script src="<%= asset_path("chat_actions.js") %>" defer></script>
    <script type="module" src="<%= asset_path("face.js") %>"></script>
    <script src="<%= asset_path("visual_bridge.js") %>" defer></script>
    <script src="<%= asset_path("cognition_ecology.js") %>" defer></script>
    <script src="<%= asset_path("cognition_ecology_render.js") %>" defer></script>
    <script src="<%= asset_path("codebase.js") %>" defer></script>
    <script src="<%= asset_path("chat.js") %>" defer></script>
  </body>
</html>
