  const rmD1=audioCtx.createGain();rmD1.gain.value=0.5;
  rmOsc1.connect(rmD1);rmD1.connect(rm1.gain);rmOsc1.start();
  const rm2=audioCtx.createGain();rm2.gain.value=0.4;
