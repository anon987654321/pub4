<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <meta name="master-runtime" content="face">
  <meta name="master-tier" content="<%= @tier.to_s %>">
  <meta name="master-visual-profile" content="auto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>MASTER</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23030303'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%23fff'/%3E%3C/svg%3E">
  <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">
  <script nonce="<%= content_security_policy_nonce %>">
    window.MASTER_ASSET_PATHS = {
      threeModule: "<%= asset_path("three.face.module.js") %>",
      faceParts: <%= raw((1..5).map { |part| asset_path("face.part#{part}.txt") }.to_json) %>,
      faceModulesList: <%= raw(%w[
        face_particles.js face_audio_bridge.js face_tts_bridge.js face_expression_bridge.js face_blendshape_bridge.js
        face_council_multi.js face_phosphor_trail.js face_offscreen_ecology.js face_micro_interactions.js
        face_perf_guards.js face_brutalist.js
      ].to_json) %>,
      faceModules: <%= raw(%w[
        face_particles.js face_audio_bridge.js face_tts_bridge.js face_expression_bridge.js face_blendshape_bridge.js
        face_council_multi.js face_phosphor_trail.js face_offscreen_ecology.js face_micro_interactions.js
        face_perf_guards.js face_brutalist.js
        face_semantics.js face_minimal_ui.js face_loops_music.js face_loops_nudge.js
      ].to_h { |name| [name, asset_path(name)] }.to_json) %>
    };
  </script>
  <script nonce="<%= content_security_policy_nonce %>">
    <% persona = Rails.application.config.x.master_container&.[](:personality) %>
    window.MASTER_PERSONA = <%= raw((persona.respond_to?(:browser_profile) ? persona.browser_profile : {}).to_json) %>;
    window.MASTER_SOUL_SUMMARY = "persona malay; voice ms-MY-OsmanNeural; constitutional face";
    window.MASTER_RUNTIME = <%= raw Master::Ground::RuntimeCatalog.web_boot_payload.to_json %>;
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# non-blocking font load: preload as style, then promote to stylesheet on load via a
      nonce'd script (CSP forbids inline onload handlers). Keeps the Inter CSS request off
      the render-blocking critical path; display=swap already prevents invisible-text FOIT. %>
  <link rel="preload" as="style" id="inter-font" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;700&display=swap">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;700&display=swap"></noscript>
  <script nonce="<%= content_security_policy_nonce %>">
    (function(){var f=document.getElementById('inter-font');if(!f)return;
      var on=function(){f.rel='stylesheet';};
      f.addEventListener('load',on);if(f.sheet)on();})();
  </script>
  <link rel="preload" href="<%= asset_path("face.css") %>" as="style">
  <%# prefetch (not modulepreload) THREE.js: warms the 514KB into cache WITHOUT compiling it,
      so the ~10-20s parse happens on primer tap (deferred boot), not on initial page load %>
  <link rel="prefetch" href="<%= asset_path("three.face.module.js") %>" as="script">
  <link rel="modulepreload" href="<%= asset_path("face.js") %>">
  <link rel="stylesheet" href="<%= asset_path("face.css") %>">
  <style nonce="<%= content_security_policy_nonce %>">
    html, body { background: #000; color: #f5f0e8; }
    canvas#face { display: block; position: fixed; inset: 0; width: 100%; height: 100%; background: #000; }
    #primer { background: transparent; }
    #zsh { background: #000; }
  </style>
</head>
<body class="zen face-loading" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face" data-theme="dark">
  <a href="#zin" class="skip-link">skip to prompt</a>
  <div id="error-live" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
  <div class="top-left-logo" aria-hidden="true">brgen</div>
  <canvas id="cognition-ecology" aria-hidden="true"></canvas>
  <canvas id="face" aria-hidden="true"></canvas>
  <div id="mic-dot" aria-hidden="true"></div>
  <div id="yt-player-a" aria-hidden="true" style="position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"></div>
  <div id="yt-player-b" aria-hidden="true" style="position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"></div>
  <iframe id="yt-fallback-a" src="about:blank" title="Radio A" aria-hidden="true" tabindex="-1" width="1" height="1" frameborder="0" allow="autoplay;encrypted-media" style="position:fixed;top:-9999px;left:-9999px;opacity:0;pointer-events:none"></iframe>
  <iframe id="yt-fallback-b" src="about:blank" title="Radio B" aria-hidden="true" tabindex="-1" width="1" height="1" frameborder="0" allow="autoplay;encrypted-media" style="position:fixed;top:-9999px;left:-9999px;opacity:0;pointer-events:none"></iframe>
  <div id="tts-live" aria-live="polite" aria-atomic="true"></div>
  <div id="primer" role="button" aria-labelledby="primer-title" tabindex="0">
    <h1 id="primer-title">tap to start</h1>
  </div>
  <main id="chat-shell" aria-label="MASTER chat">
    <div id="chat-log" aria-live="polite" aria-relevant="additions text"></div>
  </main>
  <div class="ui-status" id="ui-status" aria-live="polite" aria-atomic="true"></div>
  <div id="mood-sparkline" class="mood-sparkline" aria-hidden="true"></div>
  <div id="mood-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <div class="face-controls" aria-label="Face controls">
    <button id="focus-btn" type="button" class="tool" aria-pressed="false" title="Toggle focus mode">◎</button>
    <button id="describe-face-btn" type="button" class="tool" title="Describe face state">◎?</button>
    <label class="face-scale" for="font-scale" title="Adjust font size">
      <span aria-hidden="true">A</span>
      <input id="font-scale" type="range" min="0.85" max="1.4" step="0.05" value="1">
    </label>
    <label class="voice-picker" for="voice-picker" title="Select voice">
      <span aria-hidden="true">◉</span>
      <select id="voice-picker" aria-label="Voice selection">
        <option value="osman" selected>osman</option>
        <option value="pernille">pernille</option>
        <option value="finn">finn</option>
        <option value="ryan">ryan</option>
        <option value="wayne">wayne</option>
        <option value="ezinne">ezinne</option>
      </select>
    </label>
    <button id="voice-preview-btn" type="button" class="tool" aria-label="Preview selected voice" title="Preview selected voice">▶</button>
    <div class="tts-style-chips" role="group" aria-label="TTS style">
      <button type="button" class="style-chip" data-style="clear">clear</button>
      <button type="button" class="style-chip" data-style="dramatic">dramatic</button>
      <button type="button" class="style-chip" data-style="whispered">whispered</button>
      <button type="button" class="style-chip" data-style="energetic">energetic</button>
      <button type="button" class="style-chip" data-style="intimate">intimate</button>
      <button type="button" class="style-chip" data-style="storyteller">storyteller</button>
    </div>
    <span id="tts-style-indicator" aria-live="polite"></span>
  </div>
  <form id="zsh" role="search" aria-label="MASTER prompt" autocomplete="off">
    <span class="pp">master</span><span class="sep2">* </span>
    <button type="button" class="tool" data-cmd="/photograph " aria-label="Photo">photo</button>
    <button type="button" class="tool" data-cmd="/repligen generate " aria-label="Video">video</button>
    <button type="button" class="tool" data-cmd="/sing " aria-label="Sing">sing</button>
    <button type="button" class="tool" data-act="mic" aria-label="Microphone">mic</button>
    <textarea id="zin" rows="1" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything" aria-label="Message"></textarea>
    <span id="zsh-wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
    <span id="tts-rate" aria-label="TTS speed" title="Ctrl+[ / Ctrl+]"></span>
    <span id="char-count" aria-hidden="true"></span>
    <span id="zsh-status" aria-live="polite" aria-atomic="true"></span>
    <button id="spin-btn" type="button" aria-label="Pause or resume speech"></button>
  </form>
  <%# Loaded ahead of the manifest below: defines window.ParticleKernel, the base global that
      particle_worker, the cognition-ecology scripts, and the lazily-imported face modules read. %>
  <script src="<%= asset_path("particle_kernel.js") %>" defer></script>
  <script nonce="<%= content_security_policy_nonce %>">
    window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v2").to_json.html_safe %>;
    (function(){
      var p=document.getElementById('primer'),z=document.getElementById('zsh'),ui=document.getElementById('ui-status'),title=document.getElementById('primer-title');
      var fired=false,timer=null,fallback=null;
      function primeAudio(){
        try{
          var Ctx=window.AudioContext||window.webkitAudioContext;
          if(!Ctx||window.__MASTER_AUDIO_PRIME__)return;
          var ctx=new Ctx();
          window.__MASTER_AUDIO_PRIME__=ctx;
          ctx.resume().catch(function(){});
        }catch(_e){}
      }
      function dismissPrimer(){
        document.body.classList.remove('face-loading');
        if(!p)return;
        p.classList.add('gone');
        window.setTimeout(function(){p.remove();},220);
      }
      function revealPrompt(){
        if(z)z.classList.add('live');
        if(ui&&!ui.textContent)ui.textContent='starting';
      }
      function boot(){
        if(window.MASTER_FACE&&window.MASTER_FACE.startEverything){
          window.MASTER_FACE.startEverything();
          return true;
        }
        return false;
      }
      function showLoadState(){
        if(title)title.textContent='loading…';
        if(ui)ui.textContent='loading face';
      }
      function fallbackUi(){
        dismissPrimer();
        revealPrompt();
        if(ui)ui.textContent='face failed to load — reload';
      }
      // Deferred boot: the WebGL face (THREE.js ~514KB parse) is loaded only AFTER the
      // primer tap, so the initial page stays light and the shell is interactive at once.
      function loadFace(retried){
        if(window.__MASTER_FACE_IMPORT__)return;
        window.__MASTER_FACE_IMPORT__=true;
        import("<%= asset_path("face.js") %>").catch(function(){
          // Nielsen #9 (help users recover): one silent auto-retry before asking to reload.
          // Retry lives here, not on a timer — a timer retry would double-run a merely-slow import.
          window.__MASTER_FACE_IMPORT__=false;
          if(retried){fallbackUi();return;}
          if(ui)ui.textContent='retrying…';
          setTimeout(function(){loadFace(true);},1200);
        });
      }
      function go(){
        if(fired)return;
        fired=true;
        window._primerFired=true;
        primeAudio();
        dismissPrimer();
        revealPrompt();
        loadFace();
        if(boot())return;
        showLoadState();
        // Nielsen #1 (visibility of system status): reassure at 8s, hard-fail at 35s (was a silent 60s).
        var hintT=setTimeout(function(){if(ui)ui.textContent='still loading the face…';},8000);
        timer=setInterval(function(){if(boot()){clearInterval(timer);timer=null;clearTimeout(hintT);clearTimeout(fallback);}},40);
        fallback=setTimeout(function(){clearInterval(timer);if(!(window.MASTER_FACE&&window.MASTER_FACE.primerFired))fallbackUi();},35000);
      }
      if(p){
        p.addEventListener('pointerdown',go);
        p.addEventListener('touchend',go,{passive:true});
        p.addEventListener('click',go);
        p.addEventListener('keydown',function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();go();}});
      }
      addEventListener('keydown',function(e){if(!fired&&(e.key==='Enter'||e.key===' ')){e.preventDefault();go();}});
    })();
  </script>
  <script src="/master_events.js" defer></script>
  <script src="/shortcut_sheet.js" defer></script>
  <%# Deferred boot modules — single ordered manifest, loaded after the shell paints.
      face.js (the THREE.js WebGL face) is intentionally absent: loadFace() imports it
      lazily on the primer tap (see the boot script above). %>
  <%= javascript_include_tag(*%w[face_state visual_governor topology_registry particle_worker
        chat_actions visual_bridge cognition_ecology cognition_ecology_render chat], defer: true) %>
  <script nonce="<%= content_security_policy_nonce %>">
    fetch('/runtime/config').then((r) => r.ok ? r.json() : null).then((cfg) => {
      if (cfg && typeof cfg === 'object') window.MASTER_RUNTIME = { ...window.MASTER_RUNTIME, ...cfg };
    }).catch(() => {});
  </script>
</body>
</html>
