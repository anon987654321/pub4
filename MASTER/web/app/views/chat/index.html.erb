<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#000000">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>MASTER</title>
  <link rel="preload" href="/face.css" as="style">
  <link rel="preload" href="/face.js"  as="script">
  <link rel="preload" href="/visual_bridge.js"  as="script">
  <link rel="preload" href="/cognition_ecology.js"  as="script">
  <link rel="preload" href="/codebase.js"  as="script">
  <link rel="stylesheet" href="/face.css">
</head>
<body>
  <canvas id="cognition-ecology"></canvas>
  <canvas id="face"></canvas>
  <div id="primer"></div>
  <div id="chat-panel">
    <div id="chat-banner">
      <span class="banner-name">MASTER</span>
      <span class="banner-sub" id="banner-sub">constitutional agent</span>
    </div>
    <div id="chat-log"></div>
    <div id="zsh">
      <span class="pp">visitor</span><span class="sep">@master</span><span class="sep2"> $ </span>
      <input id="zin" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything">
    </div>
  </div>
  <script src="/face.js" defer></script>
  <script src="/tts.js" defer></script>
  <script src="/gestures.js" defer></script>
  <script src="/sse.js" defer></script>
  <script src="/visual_bridge.js" defer></script>
  <script src="/cognition_ecology.js" defer></script>
  <script src="/codebase.js" defer></script>
  <script src="/chat.js" defer></script>
</body>
</html>
