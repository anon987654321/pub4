          speakWithAudio((ev.data||{}).text||'');
        }else if(t==='scan:complete'){
          ringPulses.push({r:1,maxR:Math.min(W,H)*0.25,a:0.35,col:'#1a3a1a'});
        }
      };
      es.onerror=function(){ try{ es.close(); }catch(_){} };
    })();
  </script>
</body>
</html>
