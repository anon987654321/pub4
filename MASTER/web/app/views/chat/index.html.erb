        lad1.Q.linearRampToValueAtTime(0.5+Math.random()*3,t+rampTime);

        warmth.frequency.linearRampToValueAtTime(200+Math.random()*500,t+rampTime);
        warmth.gain.linearRampToValueAtTime(3+Math.random()*6,t+rampTime);

