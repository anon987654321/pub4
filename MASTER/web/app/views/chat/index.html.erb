    const N=(()=>{const c=navigator.hardwareConcurrency||2;const m=navigator.deviceMemory||2;const lowEnd=c<=4&&m<=2;const midLow=c<=4||m<=2;if(lowEnd)return 200;if(midLow)return 400;if(c<=6)return 800;return 1400;})();
