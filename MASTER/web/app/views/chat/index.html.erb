    });

    input.addEventListener('keydown',e=>{
      if(e.key==='Escape'){
        inputField.classList.remove('active');
        input.blur();
        return;
      }
      if(e.key==='Enter'&&input.value.trim()){
        const msg=input.value.trim();
        input.value='';
        isTyping=false;
        inputField.classList.remove('active');
        input.blur();
        statusEl.classList.remove('speak');
        statusEl.classList.add('think');
