<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <%= csrf_meta_tags %>
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <meta name="master-runtime" content="face">
  <meta name="master-tier" content="<%= @tier.to_s %>">
  <meta name="master-visual-profile" content="auto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>MASTER</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23030303'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%23fff'/%3E%3C/svg%3E">
  <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  <link rel="apple-touch-icon" href="<%= asset_path("icon.png") %>">
  <script nonce="<%= content_security_policy_nonce %>">
    window.MASTER_ASSET_PATHS = {
      threeModule: "<%= asset_path("three.face.module.js") %>",
      faceParts: <%= raw((1..5).map { |part| asset_path("face.part#{part}.txt") }.to_json) %>,
      faceModules: <%= raw(%w[face_semantics.js face_minimal_ui.js face_loops_music.js face_loops_nudge.js].to_h { |name| [name, asset_path(name)] }.to_json) %>
    };
  </script>
  <script nonce="<%= content_security_policy_nonce %>">
    <% persona = Rails.application.config.x.master_container&.[](:personality) %>
    window.MASTER_PERSONA = <%= raw((persona.respond_to?(:browser_profile) ? persona.browser_profile : {}).to_json) %>;
    window.MASTER_SOUL_SUMMARY = "persona malay; voice ms-MY-OsmanNeural; constitutional face";
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;700&display=swap">
  <link rel="preload" href="<%= asset_path("face.css") %>" as="style">
  <link rel="modulepreload" href="<%= asset_path("three.face.module.js") %>">
  <link rel="modulepreload" href="<%= asset_path("face.js") %>">
  <link rel="stylesheet" href="<%= asset_path("face.css") %>">
  <style nonce="<%= content_security_policy_nonce %>">
    html, body { background: #000; color: #f5f0e8; }
    canvas#face { display: block; position: fixed; inset: 0; width: 100%; height: 100%; background: #000; }
    #primer { background: transparent; }
    #zsh { background: #000; }
  </style>
</head>
<body class="zen face-loading" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face" data-theme="dark">
  <a href="#zin" class="skip-link">skip to prompt</a>
  <div id="error-live" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
  <div class="top-left-logo" aria-hidden="true">brgen</div>
  <canvas id="cognition-ecology" aria-hidden="true"></canvas>
  <canvas id="face" aria-hidden="true"></canvas>
  <div id="mic-dot" aria-hidden="true"></div>
  <div id="yt-player-a" aria-hidden="true" style="position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"></div>
  <div id="yt-player-b" aria-hidden="true" style="position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none"></div>
  <iframe id="yt-fallback-a" src="about:blank" title="Radio A" aria-hidden="true" tabindex="-1" width="1" height="1" frameborder="0" allow="autoplay;encrypted-media" style="position:fixed;top:-9999px;left:-9999px;opacity:0;pointer-events:none"></iframe>
  <iframe id="yt-fallback-b" src="about:blank" title="Radio B" aria-hidden="true" tabindex="-1" width="1" height="1" frameborder="0" allow="autoplay;encrypted-media" style="position:fixed;top:-9999px;left:-9999px;opacity:0;pointer-events:none"></iframe>
  <div id="tts-live" aria-live="polite" aria-atomic="true"></div>
  <div id="primer" role="dialog" aria-modal="true" aria-labelledby="primer-title" tabindex="0">
    <h1 id="primer-title">tap to start</h1>
  </div>
  <main id="chat-shell" aria-label="MASTER chat">
    <div id="chat-log" aria-live="polite" aria-relevant="additions text"></div>
  </main>
  <div class="ui-status" id="ui-status" aria-live="polite" aria-atomic="true"></div>
  <div id="mood-sparkline" class="mood-sparkline" aria-hidden="true"></div>
  <div id="mood-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <div class="face-controls" aria-label="Face controls">
    <button id="focus-btn" type="button" class="tool" aria-pressed="false" title="Toggle focus mode">◎</button>
    <button id="describe-face-btn" type="button" class="tool" title="Describe face state">◎?</button>
    <label class="face-scale" for="font-scale" title="Adjust font size">
      <span aria-hidden="true">A</span>
      <input id="font-scale" type="range" min="0.85" max="1.4" step="0.05" value="1">
    </label>
    <label class="voice-picker" for="voice-picker" title="Select voice">
      <span aria-hidden="true">◉</span>
      <select id="voice-picker" aria-label="Voice selection">
        <option value="osman" selected>osman</option>
        <option value="pernille">pernille</option>
        <option value="finn">finn</option>
        <option value="ryan">ryan</option>
        <option value="wayne">wayne</option>
        <option value="ezinne">ezinne</option>
      </select>
    </label>
    <button id="voice-preview-btn" type="button" class="tool" aria-label="Preview selected voice" title="Preview selected voice">▶</button>
  </div>
  <form id="zsh" role="search" aria-label="MASTER prompt" autocomplete="off">
    <span class="pp">master</span><span class="sep2">* </span>
    <button type="button" class="tool" data-cmd="/photograph " aria-label="Photo">photo</button>
    <button type="button" class="tool" data-cmd="/repligen generate " aria-label="Video">video</button>
    <button type="button" class="tool" data-cmd="/sing " aria-label="Sing">sing</button>
    <button type="button" class="tool" data-act="mic" aria-label="Microphone">mic</button>
    <textarea id="zin" rows="1" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything" aria-label="Message"></textarea>
    <span id="zsh-wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
    <span id="tts-rate" aria-label="TTS speed" title="Ctrl+[ / Ctrl+]"></span>
    <span id="char-count" aria-hidden="true"></span>
    <span id="zsh-status" aria-live="polite" aria-atomic="true"></span>
    <button id="spin-btn" type="button" aria-label="Pause or resume speech"></button>
  </form>
  <script nonce="<%= content_security_policy_nonce %>">
    window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v2").to_json.html_safe %>;
    (function(){
      var p=document.getElementById('primer'),z=document.getElementById('zsh'),fired=false,timer=null,fallback=null;
      function boot(){if(window.MASTER_FACE&&window.MASTER_FACE.startEverything){window.MASTER_FACE.startEverything();return true;}return false;}
      function fallbackUi(){if(p&&p.parentNode)p.parentNode.removeChild(p);if(z)z.classList.add('live');}
      function go(){
        if(fired)return;fired=true;window._primerFired=true;
        if(boot())return;
        timer=setInterval(function(){if(boot()){clearInterval(timer);timer=null;clearTimeout(fallback);}},40);
        fallback=setTimeout(function(){clearInterval(timer);fallbackUi();},8000);
      }
      if(p){p.addEventListener('pointerdown',go,{passive:true});p.addEventListener('touchstart',go,{passive:true});p.addEventListener('click',go);p.addEventListener('keydown',function(e){if(e.key===' '||e.key==='Enter')go();});}
      addEventListener('keydown',function(e){if(!fired&&(e.key==='Enter'||e.key===' '||e.key==='OK'))go();},{once:false});
    })();
  </script>
  <script src="/master_events.js" defer></script>
  <script src="/shortcut_sheet.js" defer></script>
  <script src="<%= asset_path("face_state.js") %>" defer></script>
  <script src="<%= asset_path("visual_governor.js") %>" defer></script>
  <script src="<%= asset_path("topology_registry.js") %>" defer></script>
  <script src="<%= asset_path("particle_kernel.js") %>" defer></script>
  <script src="<%= asset_path("chat_actions.js") %>" defer></script>
  <script type="module" src="<%= asset_path("face.js") %>"></script>
  <script src="<%= asset_path("visual_bridge.js") %>" defer></script>
  <script src="<%= asset_path("cognition_ecology.js") %>" defer></script>
  <script src="<%= asset_path("cognition_ecology_render.js") %>" defer></script>
  <script src="<%= asset_path("chat.js") %>" defer></script>
</body>
</html>
