<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <%= csrf_meta_tags %>
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <meta name="master-runtime" content="face">
  <meta name="master-visual-profile" content="auto">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>MASTER</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="preload" href="/face.css" as="style">
  <link rel="modulepreload" href="/three.module.js?v=17">
  <link rel="modulepreload" href="/face.js?v=17">
  <link rel="stylesheet" href="/face.css?v=17">
  <link rel="stylesheet" href="/photo_upload.css">
</head>
<body class="zen" data-runtime-profile="boot" data-runtime-visible="true" data-visual-runtime="face">
  <div class="top-left-logo" aria-hidden="true">maestro</div>
  <canvas id="face" tabindex="0" aria-hidden="true"></canvas>
  <div id="primer" role="dialog" aria-modal="true" aria-labelledby="primer-title" tabindex="0">
    <h1 id="primer-title">tap to start</h1>
  </div>
  <main id="chat-shell" aria-label="MASTER chat">
    <div id="chat-log" aria-live="polite" aria-relevant="additions text"></div>
  </main>
  <div class="ui-status" id="ui-status" aria-live="polite" aria-atomic="true">idle</div>
  <div id="mood-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <form id="zsh" role="search" aria-label="MASTER prompt" autocomplete="off">
    <button id="photo-button" type="button" aria-label="Attach photo">+</button>
    <input id="photo" type="file" accept="image/*" capture="environment" hidden>
    <span class="pp">visitor</span><span class="sep">@master</span><span class="sep2"> $ </span>
    <input id="zin" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" placeholder="ask anything" aria-label="Message">
  </form>
  <script type="module" src="/face.js?v=17"></script>
  <script src="/chat.js?v=17" defer></script>
</body>
</html>
