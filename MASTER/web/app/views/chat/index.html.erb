          flutterDepth.connect(osc.detune);
          wowDepth.connect(osc.detune);

          osc.connect(g);g.connect(lad1);
          osc.start(now+Math.random()*0.1); // stagger starts
          padOscs.push({osc,gain:g,baseFreq:freq});
        });
      });

