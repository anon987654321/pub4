<script nonce="<%= content_security_policy_nonce %>">
  window.MASTER_CACHE_VERSION = <%= ENV.fetch("CACHE_VERSION", "v2").to_json.html_safe %>;
  (function(){
    var p=null,form=null,z=null,ui=null,err=document.getElementById('error-live'),title=null;
    function syncShellRefs(){
      z=document.getElementById('zsh')||z;
      ui=document.getElementById('ui-status')||ui;
    }
    syncShellRefs();
    var fired=false,armed=false,timer=null,fallback=null,pinTimer=null,faceWatch=null;
    function syncPrimerRefs(){
      form=document.getElementById('primer-form');
      p=document.getElementById('primer');
      title=document.getElementById('primer-title');
      return p;
    }
    function safariBrowser(){
      var vendor=navigator.vendor||'';
      var ua=navigator.userAgent||'';
      return vendor.indexOf('Apple')>-1&&ua.indexOf('CriOS')<0&&ua.indexOf('FxiOS')<0&&ua.indexOf('Chrome')<0&&ua.indexOf('Chromium')<0&&ua.indexOf('Edg')<0;
    }
    function sessionReady(){
      return !!(window.MASTER_FACE&&window.MASTER_FACE.primerFired);
    }
    function primerVisible(){
      var el=document.getElementById('primer');
      return !!(el&&el.parentNode&&!el.classList.contains('gone')&&!el.disabled);
    }
    function primerRoot(){
      return document.getElementById('primer-form')||document.getElementById('primer');
    }
    function primeAudio(){
      try{
        var Ctx=window.AudioContext||window.webkitAudioContext;
        if(!Ctx||window.__MASTER_AUDIO_PRIME__)return;
        var ctx=new Ctx();
        window.__MASTER_AUDIO_PRIME__=ctx;
        ctx.resume().catch(function(){});
      }catch(_e){}
    }
    function dismissPrimer(){
      document.documentElement.classList.remove('face-loading');
      document.body.classList.remove('face-loading');
      delete document.body.dataset.faceBooting;
      delete document.body.dataset.faceBehindPrimer;
      syncPrimerRefs();
      if(form){
        delete form.dataset.facePrimed;
        form.classList.add('gone');
        form.style.pointerEvents='none';
      }
      if(p){
        p.setAttribute('aria-busy','false');
        p.disabled=true;
        p.classList.add('gone');
        p.style.pointerEvents='none';
      }
      window.setTimeout(function(){
        syncPrimerRefs();
        if(form){
          form.style.display='none';
          if(form.parentNode)form.remove();
        } else if(p&&p.parentNode) {
          p.style.display='none';
          p.remove();
        }
      },220);
    }
    function revealPrompt(){
      syncShellRefs();
      document.body.classList.add('face-session');
      if(z){
        z.classList.add('live');
        z.style.pointerEvents='auto';
      }
      var input=document.getElementById('zin');
      if(input){
        window.setTimeout(function(){
          try{input.focus({preventScroll:true});}catch(_e){}
        },260);
      }
    }
    function boot(){
      if(sessionReady())return true;
      if(window.MASTER_FACE&&window.MASTER_FACE.startEverything)window.MASTER_FACE.startEverything();
      return sessionReady();
    }
    function showBootStatus(label){
      syncShellRefs();
      document.body.dataset.faceBooting='1';
      if(ui)ui.textContent=label;
    }
    function clearBootTimers(){
      if(timer){clearInterval(timer);timer=null;}
      if(fallback){clearTimeout(fallback);fallback=null;}
    }
    function reportError(msg){
      if(err)err.textContent=msg;
    }
    function finishBoot(){
      if(!sessionReady())return;
      clearBootTimers();
      delete document.body.dataset.faceBooting;
      syncShellRefs();
      if(ui)ui.textContent='';
      dismissPrimer();
      revealPrompt();
    }
    function resetFaceSession(){
      if(window.MASTER_FACE&&typeof window.MASTER_FACE.resetPrimer==='function'){
        window.MASTER_FACE.resetPrimer();
      }
    }
    function trackpadPrimary(e){
      if(!e)return true;
      if(typeof e.button==='number'&&(e.button===1||e.button===2))return false;
      return true;
    }
    function primerTarget(node){
      if(!node)return false;
      syncPrimerRefs();
      if(node===form||node===p)return true;
      if(node.id==='primer-text')return false;
      return !!((p&&p.contains(node))||(form&&form.contains(node)));
    }
    function primerActivate(e,opts){
      opts=opts||{};
      if(fired||!primerVisible())return;
      if(e){
        if(e.type==='submit')e.preventDefault();
        if(e.type==='click'&&e.button!==0)return;
        if(e.type==='keydown'&&e.key!=='Enter'&&e.key!==' ')return;
        if(e.type==='keydown')e.preventDefault();
      }
      if(!opts.anywhere){
        if(e&&!primerTarget(e.target))return;
        if(e&&!trackpadPrimary(e))return;
      }
      go();
    }
    function wirePrimer(el){
      if(!el||el.dataset.bootWired==='1')return;
      el.dataset.bootWired='1';
      el.addEventListener('click',primerActivate,false);
      el.addEventListener('pointerdown',function(e){primerActivate(e);},{capture:false,passive:true});
      ['pointerup','touchend','mousedown'].forEach(function(type){
        var passive=type==='touchend'||type==='mousedown';
        el.addEventListener(type,primerActivate,{capture:false,passive:passive});
      });
      el.addEventListener('keydown',function(e){primerActivate(e);});
    }
    function wirePrimerForm(){
      form=document.getElementById('primer-form');
      if(!form||form.dataset.bootWired==='1')return;
      form.dataset.bootWired='1';
      form.addEventListener('click',function(e){primerActivate(e);},true);
      form.addEventListener('keydown',function(e){primerActivate(e);});
      form.addEventListener('pointerdown',function(e){primerActivate(e);},{capture:false,passive:true});
      ['pointerup','touchend','mousedown'].forEach(function(type){
        var passive=type==='touchend'||type==='mousedown';
        form.addEventListener(type,primerActivate,{capture:false,passive:passive});
      });
      form.addEventListener('keydown',function(e){primerActivate(e);});
    }
    function ensurePrimer(){
      syncPrimerRefs();
      var el=p;
      form=form||document.getElementById('primer-form');
      if(!el){
        if(!form){
          form=document.createElement('div');
          form.id='primer-form';
          form.className='primer-form';
          form.setAttribute('role','button');
          form.tabIndex=0;
        }
        el=document.createElement('button');
        el.type='button';
        el.id='primer';
        el.setAttribute('aria-busy','false');
        var label=document.createElement('span');
        label.id='primer-title';
        label.className='primer-label';
        label.textContent='tap to retry';
        el.appendChild(label);
        var tier=document.createElement('span');
        tier.id='primer-tier';
        tier.className='primer-tier';
        var tierMeta=document.querySelector('meta[name="master-tier"]');
        tier.textContent=(tierMeta&&tierMeta.content==='authenticated')?'full access':'visitor';
        el.appendChild(tier);
        form.appendChild(el);
        wirePrimerForm();
        title=label;
        wirePrimer(el);
      }else{
        title=document.getElementById('primer-title');
        wirePrimerForm();
        wirePrimer(el);
      }
      p=el;
      if(p.disabled)p.disabled=false;
      return primerRoot();
    }
    function pinPrimer(){
      if(fired||!primerVisible())return;
      var root=ensurePrimer();
      if(!root||!root.parentNode)return;
      if(document.body.lastElementChild===root)return;
      document.body.appendChild(root);
    }
    function schedulePin(){
      pinPrimer();
      if(pinTimer)clearTimeout(pinTimer);
      pinTimer=setTimeout(pinPrimer,0);
    }
    function showFaceBehindPrimer(){
      if(fired||!primerVisible())return;
      syncPrimerRefs();
      document.body.dataset.faceBehindPrimer='1';
      if(form)form.dataset.facePrimed='1';
      if(p){
        p.dataset.facePrimed='1';
        try{p.focus({preventScroll:true});}catch(_e){}
      }
      if(title)title.textContent='face ready — tap or press return';
    }
    function watchFaceBoot(){
      if(faceWatch||fired)return;
      faceWatch=window.setInterval(function(){
        if(fired||!primerVisible()){clearInterval(faceWatch);faceWatch=null;return;}
        if(window.FACE3D_ACTIVE){
          clearInterval(faceWatch);
          faceWatch=null;
          return;
        }
        syncPrimerRefs();
        if(title&&!document.body.dataset.faceBehindPrimer)title.textContent='loading face…';
      },500);
      window.setTimeout(function(){
        if(fired||window.FACE3D_ACTIVE||!primerVisible())return;
        if(title&&!document.body.dataset.faceBehindPrimer)title.textContent='face slow — tap or press return';
        reportError('face render slow');
      },5000);
    }
    function showBootError(msg){
      clearBootTimers();
      delete document.body.dataset.faceBooting;
      delete document.body.dataset.faceBehindPrimer;
      syncShellRefs();
      reportError(msg||'reload page');
      if(document.body.classList.contains('face-session')){
        if(ui)ui.textContent='face boot issue — text mode ok';
        return;
      }
      fired=false;
      window._primerFired=false;
      resetFaceSession();
      document.body.classList.remove('face-session');
      if(z)z.classList.remove('live');
      ensurePrimer();
      if(form){
        delete form.dataset.facePrimed;
        form.classList.remove('gone');
        form.style.pointerEvents='auto';
      }
      p.classList.remove('gone');
      p.disabled=false;
      p.style.opacity='1';
      p.style.transform='';
      p.style.pointerEvents='auto';
      p.setAttribute('aria-busy','false');
      if(title)title.textContent='tap to retry';
      document.documentElement.classList.add('face-loading');
      document.body.classList.add('face-loading');
      if(ui)ui.textContent='';
      schedulePin();
    }
    function armFaceBoot(){
      if(timer)return;
      showBootStatus('starting…');
      timer=setInterval(function(){if(boot())finishBoot();},40);
      fallback=setTimeout(function(){
        clearBootTimers();
        if(boot()){finishBoot();return;}
        showBootError('timed out');
      },60000);
    }
    function go(){
      if(fired||!primerVisible())return;
      if(ui)ui.textContent='tap received';
      document.body.dataset.primerTap='1';
      window.setTimeout(function(){delete document.body.dataset.primerTap;},240);
      fired=true;
      window._primerFired=true;
      document.body.dataset.primerFlash='1';
      window.setTimeout(function(){delete document.body.dataset.primerFlash;},180);
      primeAudio();
      showBootStatus('starting face…');
      window.dispatchEvent(new CustomEvent('primer:ready'));
      try{
        if(window.MASTER_FACE&&window.MASTER_FACE.startEverything)window.MASTER_FACE.startEverything();
      }catch(err){
        reportError(String(err&&err.message||err));
      }
      if(boot()){finishBoot();return;}
      armFaceBoot();
    }
    function onSessionReady(){if(fired)finishBoot();}
    addEventListener('master:face-ready',function(){if(fired&&boot())finishBoot();});
    addEventListener('master:face-live',showFaceBehindPrimer);
    addEventListener('primer:ready',onSessionReady);
    addEventListener('master:session-ready',onSessionReady);
    addEventListener('master:face-error',function(ev){
      if(!fired)return;
      var detail=ev&&ev.detail||{};
      var msg=detail.message||detail.module||'face boot failed';
      if(document.body.classList.contains('face-session')){
        reportError(msg);
        if(ui)ui.textContent='face loading…';
        return;
      }
      showBootError(msg);
    });
    addEventListener('master:face-stage',function(ev){
      if(!fired||sessionReady())return;
      var label=ev.detail&&ev.detail.stage;
      if(label)showBootStatus(label);
    });
    function armPrimer(){
      if(armed)return;
      armed=true;
      ensurePrimer();
      schedulePin();
      watchFaceBoot();
      document.addEventListener('click',function(ev){
        if(fired||!primerVisible())return;
        syncPrimerRefs();
        if(form&&form.contains(ev.target))return;
        if(ev.target&&ev.target.id==='primer-text')return;
        primerActivate(ev,{anywhere:true});
      },false);
      ['pointerup','touchend','mousedown'].forEach(function(type){
        var passive=type==='touchend'||type==='mousedown';
        document.addEventListener(type,function(ev){
          if(fired||!primerVisible())return;
          syncPrimerRefs();
          if(form&&form.contains(ev.target))return;
          if(ev.target&&ev.target.id==='primer-text')return;
          primerActivate(ev,{anywhere:true});
        },{capture:false,passive:passive});
      });
      addEventListener('keydown',function(e){if(!fired&&primerVisible()&&(e.key==='Enter'||e.key===' ')){e.preventDefault();go();}});
      if(typeof MutationObserver!=='undefined'){
        var pinObserver=null;
        new MutationObserver(function(){
          if(pinObserver)clearTimeout(pinObserver);
          pinObserver=setTimeout(schedulePin,32);
        }).observe(document.body,{childList:true});
      }
      addEventListener('load',schedulePin);
      addEventListener('pageshow',function(ev){
        if(!ev.persisted||!primerVisible())return;
        fired=false;
        window._primerFired=false;
        resetFaceSession();
        if(p)p.disabled=false;
        schedulePin();
      });
      window.__MASTER_PRIMER_GO__=go;
      window.__MASTER_PRIMER_TAP__=go;
      if(window.__MASTER_PRIMER_PENDING__&&window.__MASTER_PRIMER_PENDING__()){
        window.__MASTER_PRIMER_CLEAR__();
        go();
      }
      window.__MASTER_FACE_STATUS__=function(){
        syncPrimerRefs();
        return {
          primerVisible:primerVisible(),
          fired:fired,
          face3d:!!window.FACE3D_ACTIVE,
          face3dLit:window.Face3DPreview?.renderer?.lastLitPixels??null,
          masterFace:!!window.MASTER_FACE,
          faceReady:document.body.classList.contains('face-ready'),
          behindPrimer:document.body.dataset.faceBehindPrimer==='1',
          safari:safariBrowser(),
          primerDisabled:!!(p&&p.disabled),
          primerGone:!!(p&&p.classList.contains('gone'))
        };
      };
    }
    armPrimer();
  })();
</script>