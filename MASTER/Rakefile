# frozen_string_literal: true

require "rake/testtask"
require "timeout"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.libs << "lib"
  # One flat directory, so one glob reaches every test. The suite was split
  # across nine subdirectories this glob did not match, and thirty tests went
  # unasked while `rake test` reported a full run.
  t.test_files = FileList["test/test_*.rb"].exclude(
    "test/test_browser.rb",
    "test/test_web_http.rb",
    # rack/test lives in the web bundle, which is not installable on a
    # contributor Mac. Leaving this in the default glob aborted `rake test`
    # before any other file ran.
    "test/test_web_ui.rb"
  )
  t.warning = false
end

desc "Run spec/ — Minitest specs organized by subsystem instead of one flat test/ dir"
Rake::TestTask.new(:spec) do |t|
  t.libs << "test"
  t.libs << "lib"
  t.ruby_opts << "-r./test/test_helper"
  t.test_files = FileList["spec/**/*_spec.rb"]
  t.warning = false
end

desc "Scan for tracked secrets and validate the quarantine/virus_museum structure"
task :security_sweep do
  sh RbConfig.ruby, "tools/security_sweep.rb"
end

desc "STUDIO parses, has no orphans, its entry points boot, and its suite is green"
task studio: %i[studio_gate studio_test]

desc "STUDIO parses, has no orphans, and its entry points still boot"
task :studio_gate do
  # A subprocess, not a require. `bin/gate`'s /fix step mutates the whole shared
  # worktree, and STUDIO was the only tree with nothing that fails when it
  # breaks -- dilla and postpro have each been broken by it silently. Running it
  # from here is what makes the fix loop's own damage visible to the fix loop.
  #
  # Subprocess specifically, because MASTER requires nothing from the sibling
  # trees and the gate requires OPENBSD/lib/gate_result. That independence is
  # deliberate (TODO.md: gate_result_is_a_shared_kernel_filed_
  # under_deploy) and a rake task is not a reason to spend it.
  gate = File.expand_path("../STUDIO/gate.rb", __dir__)
  if File.file?(gate)
    sh RbConfig.ruby, gate
  else
    warn "studio: #{gate} not found — skipping (STUDIO tree absent?)"
  end
end

# The gate's three checks are parse, inventory and load: they catch a tree that
# has stopped being valid Ruby. They cannot catch a swing offset applied to the
# wrong role, a seed that reads as pinned and is not, or a chord template that
# voices a ninth as a second -- all of which parse, boot, and have shipped.
# STUDIO/test is that half. Same subprocess reasoning as above.
desc "STUDIO's own suite — engine arithmetic, the single-file tools, the gate"
task :studio_test do
  studio = File.expand_path("../STUDIO", __dir__)
  unless File.file?(File.join(studio, "Rakefile"))
    warn "studio: no suite at #{studio} — skipping (STUDIO tree absent?)"
    next
  end

  # Outside MASTER's bundle. STUDIO's tools resolve their own gems -- postpro
  # needs ruby-vips and dilla needs coltrane/midilib/wavefile, none of which are
  # in MASTER's Gemfile and none of which should be: the trees are independent
  # and that is the point of the subprocess. Inheriting BUNDLE_GEMFILE makes
  # bundler refuse every one of them, which reads as "postpro is broken".
  clean = %w[BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH RUBYOPT RUBYLIB]
          .to_h { |key| [key, nil] }

  Dir.chdir(studio) { sh clean, RbConfig.ruby, "-S", "rake", "test" }
end

desc "Deep scan lib/ — triage scanner self-findings separately from actionable violations"
task :constitution do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  require "review/scan/constitution_triage"

  root    = __dir__
  scanner = Master::Review::Scan::InfraHelpers.build_scanner(root:)
  scanner.rules.reject! { |rule| rule.id.to_s == "ast_omission" }
  timeout = Integer(ENV.fetch("MASTER_CONSTITUTION_FILE_TIMEOUT", "4"))
  # data/scan_coverage.yml, not File.join(root, "lib") — a path literal here is
  # how core/ stayed outside its own law for three weeks. rake lint:scan_coverage
  # audits the manifest; this reads it.
  paths = Master.scan_roots(root:).flat_map { |dir| Dir.glob(File.join(root, dir, Master::Review::Scan::Scanner::SCAN_GLOB)) }
                .select { |path| File.file?(path) && !Master::Review::Scan::Scanner.skip_path?(path, root:) }
  puts "constitution: #{paths.size} file(s) across #{Master.scan_roots(root:).join(', ')}"
  # Which half of the law is running. Rules needing a model return [] without
  # one, and no local gate attaches one, so "clean" over 99 rules and "clean"
  # over 225 are different claims that otherwise print the same.
  audit = Master::Review::Scan::RuleRegistryAudit.new(root:).call
  # Rules that need a model and did not get one return [] and say nothing, so
  # a report that omits them offers the mechanical half as the whole law.
  idle = scanner.rules.select { |rule| rule.respond_to?(:agent?) && !rule.agent? }
  puts "constitution: #{audit.yaml_rules - audit.semantic_only.size} of #{audit.yaml_rules} declared rules active" \
       "#{idle.empty? ? '' : " (#{idle.map(&:id).join(', ')} idle without a model — rake lint:rule_reach)"}"

  violations = paths.each_with_index.flat_map do |path, index|
    puts "constitution: scanned #{index}/#{paths.size}" if index.positive? && (index % 25).zero?
    result = Timeout.timeout(timeout) { scanner.scan(path, depth: :deep) }
    abort "constitution: scan failed for #{path}: #{result.message}" unless result.ok?

    result.value!.map { |finding| finding.merge(file: path) }
  rescue Timeout::Error
    [{ rule: "SCAN_TIMEOUT", rule_id: "SCAN_TIMEOUT", severity: :error, line: 1,
       message: "scan exceeded #{timeout}s per-file budget", file: path }]
  end
  triage = Master::Review::Scan::ConstitutionTriage.new(root:)
  buckets = triage.buckets(violations)
  actionable = triage.actionable_count(violations)
  budget = Integer(ENV.fetch("MASTER_CONSTITUTION_MAX_ACTIONABLE", "1500"))

  if violations.empty?
    puts "constitution: clean"
  else
    buckets.each do |bucket|
      next if bucket.findings.empty?

      puts "[#{bucket.name}] #{bucket.findings.size}"
      bucket.findings.group_by { |v| v[:rule] }.sort_by { |_, vs| -vs.size }.first(8).each do |rule, vs|
        puts "  #{rule}: #{vs.size}"
        vs.first(3).each { |v| puts "    #{v[:file]}:#{v[:line]}: #{v[:message]}" }
      end
    end
    puts "constitution: #{violations.size} finding(s), #{actionable} actionable (budget #{budget})"
    exit 1 if actionable > budget
  end
end

desc "Run rules.yml self_test laws against MASTER itself"
task :selftest do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  result = Master::Review::Scan::SelfTest.new(root: __dir__).call
  abort result.message unless result.ok?

  summary = result.value!
  # What this gate did not measure, said before what it did. bin/check
  # --profile=agent runs this task, and "0 findings" over 99 rules and over 225
  # are different claims that printed identically.
  puts "selftest: #{Master::Review::Scan::RuleRegistryAudit.new(root: __dir__).call.coverage_line}"
  puts summary.line
  summary.checks.each do |check|
    puts "  [#{check.law}] #{check.findings.size}"
    check.findings.first(5).each { |finding| puts "    #{finding[:path]}:#{finding[:line]}: #{finding[:message]}" }
  end
  # abort, not exit(0) on success: this task is a prerequisite of `rake audit`,
  # and exiting zero here ended the process before the five lints after it ran.
  abort "selftest: #{summary.line}" unless summary.ok?
end

desc "Fast error/critical-only scan of lib/ (Fix::SelfCheck) -- a quick fail-fast gate ahead of the heavier rake constitution triage scan"
task :selfcheck do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  audit = Master::Review::Scan::RuleRegistryAudit.new(root: __dir__).call
  puts "selfcheck: #{audit.yaml_rules - audit.semantic_only.size} of #{audit.yaml_rules} declared " \
       "rules active (rake lint:rule_reach for what the rest need), " \
       "error/critical only, across #{Master.scan_roots.join(', ')}"
  report = Master::Fix::SelfCheck.new(root: __dir__).quick
  puts report.summary
  abort report.summary unless report.clean?
end

