# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.libs << "lib"
  t.test_files = FileList["test/test_*.rb"].exclude(
    "test/test_browser.rb",
    "test/test_web_http.rb"
  )
  t.warning = false
end

desc "Deep scan lib/ — exit 1 if any violations found (static rules, no LLM)"
task :constitution do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"

  root    = __dir__
  scanner = Master::Judge::Scan::InfraHelpers.build_scanner(root:)

  result = scanner.scan_dir(File.join(root, "lib"), depth: :deep, stream: false)
  abort "constitution: scan failed: #{result.message}" unless result.ok?

  violations = result.value!.flat_map do |file, scan_result|
    next [] unless scan_result.ok?

    scan_result.value!.map { |finding| finding.merge(file: file) }
  end
  total      = violations.size

  if total.zero?
    puts "constitution: clean"
  else
    by_rule = violations.group_by { |v| v[:rule] }
    by_rule.sort_by { |_, vs| -vs.size }.each do |rule, vs|
      puts "[#{rule}] #{vs.size}"
      vs.first(5).each { |v| puts "  #{v[:file]}:#{v[:line]}: #{v[:message]}" }
    end
    puts "constitution: #{total} violation(s)"
    exit 1
  end
end

desc "Run MASTER's canonical scan rules against its own lib/"
task :selftest do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  report = Master::Loop::SelfCheck.new(root: __dir__).full
  puts report.summary
  report.by_rule.sort_by { |_rule, count| -count }.each { |rule, count| puts "  [#{rule}] #{count}" }
  exit(report.clean? ? 0 : 1)
end

desc "Eager-load all Zeitwerk-managed constants"
task :autoload do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  Master.eager_load!
  puts "autoload: clean"
end

namespace :test do
  desc "Kernel spine tests (isolated from lib/master Zeitwerk load)"
  task :kernel do
    sh "ruby -Itest test/kernel/test_kernel_spine.rb test/kernel/test_no_secret_note.rb test/kernel/test_world_rollback.rb"
  end

  desc "Live web HTTP/browser tests (requires Falcon on MASTER_WEB_PORT)"
  task :integration_web do
    sh "ruby -Itest test/test_web_http.rb test/test_browser.rb"
  end

  desc "Rails web integration tests (MASTER/web)"
  task :web do
    sh "cd web && bundle exec rails test"
  end

  desc "Subprocess CLI boot tests (MASTER_CLI_E2E=1)"
  task :cli_e2e do
    ENV["MASTER_CLI_E2E"] = "1"
    ruby "-Itest", "test/test_cli_boot_e2e.rb"
  end
end

task default: :test

namespace :test do
  desc "Run web system tests"
  task :web do
    sh "ruby -Ilib:test test/test_web_ui.rb"
  end
end

namespace :lint do
  desc "Check all Ruby files have # frozen_string_literal: true"
  task :frozen do
    missing = Dir.glob(File.join(__dir__, "lib", "**", "*.rb")).reject do |f|
      File.read(f, 100).include?("# frozen_string_literal: true")
    end
    if missing.empty?
      puts "lint:frozen: all files frozen"
    else
      missing.each { |f| puts "  missing: #{f.sub("#{__dir__}/", "")}" }
      abort "lint:frozen: #{missing.size} file(s) missing frozen_string_literal"
    end
  end
end

desc "Full audit: constitution + lint:frozen"
task audit: %i[constitution lint:frozen] do
  puts "audit: passed"
end
