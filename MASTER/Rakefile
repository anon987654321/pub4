# frozen_string_literal: true

require "rake/testtask"
require "timeout"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.libs << "lib"
  t.test_files = FileList["test/test_*.rb"].exclude(
    "test/test_browser.rb",
    "test/test_web_http.rb"
  )
  t.warning = false
end

desc "Run spec/ — Minitest specs organized by subsystem instead of one flat test/ dir"
Rake::TestTask.new(:spec) do |t|
  t.libs << "test"
  t.libs << "lib"
  t.ruby_opts << "-r./test/test_helper"
  t.test_files = FileList["spec/**/*_spec.rb"]
  t.warning = false
end

desc "Scan for tracked secrets and validate the quarantine/virus_museum structure"
task :security_sweep do
  sh RbConfig.ruby, "tools/security_sweep.rb"
end

desc "Deep scan lib/ — triage scanner self-findings separately from actionable violations"
task :constitution do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  require "judge/scan/constitution_triage"

  root    = __dir__
  scanner = Master::Judge::Scan::InfraHelpers.build_scanner(root:)
  scanner.rules.reject! { |rule| rule.id.to_s == "ast_omission" }
  timeout = Integer(ENV.fetch("MASTER_CONSTITUTION_FILE_TIMEOUT", "4"))
  lib     = File.join(root, "lib")
  paths   = Dir.glob(File.join(lib, Master::Judge::Scan::Scanner::SCAN_GLOB))
               .select { |path| File.file?(path) && !Master::Judge::Scan::Scanner.skip_path?(path, root:) }

  violations = paths.each_with_index.flat_map do |path, index|
    puts "constitution: scanned #{index}/#{paths.size}" if index.positive? && (index % 25).zero?
    result = Timeout.timeout(timeout) { scanner.scan(path, depth: :deep) }
    abort "constitution: scan failed for #{path}: #{result.message}" unless result.ok?

    result.value!.map { |finding| finding.merge(file: path) }
  rescue Timeout::Error
    [{ rule: "SCAN_TIMEOUT", rule_id: "SCAN_TIMEOUT", severity: :error, line: 1,
       message: "scan exceeded #{timeout}s per-file budget", file: path }]
  end
  triage = Master::Judge::Scan::ConstitutionTriage.new(root:)
  buckets = triage.buckets(violations)
  actionable = triage.actionable_count(violations)
  budget = Integer(ENV.fetch("MASTER_CONSTITUTION_MAX_ACTIONABLE", "1500"))

  if violations.empty?
    puts "constitution: clean"
  else
    buckets.each do |bucket|
      next if bucket.findings.empty?

      puts "[#{bucket.name}] #{bucket.findings.size}"
      bucket.findings.group_by { |v| v[:rule] }.sort_by { |_, vs| -vs.size }.first(8).each do |rule, vs|
        puts "  #{rule}: #{vs.size}"
        vs.first(3).each { |v| puts "    #{v[:file]}:#{v[:line]}: #{v[:message]}" }
      end
    end
    puts "constitution: #{violations.size} finding(s), #{actionable} actionable (budget #{budget})"
    exit 1 if actionable > budget
  end
end

desc "Run rules.yml self_test laws against MASTER itself"
task :selftest do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  result = Master::Judge::Scan::SelfTest.new(root: __dir__).call
  abort result.message unless result.ok?

  summary = result.value!
  puts summary.line
  summary.checks.each do |check|
    puts "  [#{check.law}] #{check.findings.size}"
    check.findings.first(5).each { |finding| puts "    #{finding[:path]}:#{finding[:line]}: #{finding[:message]}" }
  end
  exit(summary.ok? ? 0 : 1)
end

desc "Eager-load all Zeitwerk-managed constants"
task :autoload do
  $LOAD_PATH.unshift(File.join(__dir__, "lib"))
  require "master"
  Master.eager_load!
  puts "autoload: clean"
end

desc "Run core/spec/core_smoke.rb — Effect → Constitution → World loop"
task :core_smoke do
  sh RbConfig.ruby, File.join(__dir__, "core", "spec", "core_smoke.rb")
end

namespace :test do
  desc "Core spine tests (isolated from lib/master Zeitwerk load)"
  task :core do
    # Each file runs in its own process: `ruby a.rb b.rb c.rb` runs only a.rb and
    # passes the rest as ARGV, so the old single-invocation form silently skipped
    # every file after the first.
    FileList["test/core/test_*.rb"].each { |f| ruby "-Itest", f }
  end

  desc "Live web HTTP/browser tests (requires Falcon on MASTER_WEB_PORT)"
  task :integration_web do
    %w[test/test_web_http.rb test/test_browser.rb].each { |file| ruby "-Itest", file }
  end

  desc "Rails web integration tests (MASTER/web)"
  task :web do
    sh "cd web && bundle exec rails test"
  end

  desc "Static web UI checks (asset manifest, boot contract)"
  task :web_ui do
    sh "ruby -Ilib:test test/test_web_ui.rb"
  end

  desc "Subprocess CLI boot tests (MASTER_CLI_E2E=1)"
  task :cli_e2e do
    ENV["MASTER_CLI_E2E"] = "1"
    ruby "-Itest", "test/test_cli_boot_e2e.rb"
  end
end

task default: :test

namespace :lint do
  desc "Check all Ruby files have # frozen_string_literal: true"
  task :frozen do
    missing = Dir.glob(File.join(__dir__, "lib", "**", "*.rb")).reject do |f|
      File.read(f, 100).include?("# frozen_string_literal: true")
    end
    if missing.empty?
      puts "lint:frozen: all files frozen"
    else
      missing.each { |f| puts "  missing: #{f.sub("#{__dir__}/", "")}" }
      abort "lint:frozen: #{missing.size} file(s) missing frozen_string_literal"
    end
  end

  desc "Check top-level YAML registry keys are singular"
  task :data_singularity do
    $LOAD_PATH.unshift(File.join(__dir__, "lib"))
    require "master"
    result = Master::Judge::Scan::SelfTest.new(root: __dir__).call(laws: ["SINGULARITY"])
    abort result.message unless result.ok?

    check = result.value!.checks.fetch(0)
    if check.ok?
      puts "lint:data_singularity: clean"
    else
      check.findings.each { |finding| puts "  #{finding[:path]}:#{finding[:line]}: #{finding[:message]}" }
      abort "lint:data_singularity: #{check.findings.size} violation(s)"
    end
  end
end

desc "Full audit: constitution + selftest + lint:frozen + lint:data_singularity"
task audit: %i[constitution selftest lint:frozen lint:data_singularity] do
  puts "audit: passed"
end

namespace :constitution do
  desc "Autofix Group C hygiene: FINAL_NEWLINE, CONSECUTIVE_BLANK_LINES, PERCENT_LITERAL (safe cases)"
  task :autofix_group_c do
    $LOAD_PATH.unshift(File.join(__dir__, "lib"))
    require "master"

    root = __dir__
    lib = File.join(root, "lib")
    paths = Dir.glob(File.join(lib, "**", "*.rb"))
               .select { |path| File.file?(path) && !Master::Judge::Scan::Scanner.skip_path?(path, root:) }

    fixed = { final_newline: 0, consecutive_blank_lines: 0, percent_literal: 0 }
    percent_re = /\[:([a-z_]+),\s*(:[a-z_]+(?:,\s*:[a-z_]+)+)\]/

    paths.each do |path|
      bytes = File.binread(path)
      next if bytes.empty?

      updated = bytes.dup
      changed = false

      unless updated.end_with?("\n")
        updated << "\n"
        changed = true
        fixed[:final_newline] += 1
      end

      collapsed = updated.gsub(/\n{3,}/, "\n\n")
      if collapsed != updated
        updated = collapsed
        changed = true
        fixed[:consecutive_blank_lines] += 1
      end

      text = updated.force_encoding("UTF-8")
      text = text.gsub(percent_re) do
        symbols = Regexp.last_match(0).scan(/:[a-z_]+/).map { |sym| sym.delete_prefix(":") }.join(" ")
        fixed[:percent_literal] += 1
        "%i[#{symbols}]"
      end

      if text != updated
        updated = text
        changed = true
      end

      next unless changed

      File.binwrite(path, updated)
      abort "constitution:autofix_group_c: syntax error in #{path}" unless system(RbConfig.ruby, "-c", path)
    end

    puts "constitution:autofix_group_c: #{fixed.values.sum} fix(es) — #{fixed.map { |k, v| "#{k}=#{v}" }.join(", ")}"
  end
end
