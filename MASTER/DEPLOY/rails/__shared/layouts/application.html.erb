```html
<!DOCTYPE html>
<html lang="<%= html_escape((I18n.locale || I18n.default_locale || 'en').to_s) %>" dir="<%= html_escape(rtl_locale?(I18n.locale) ? 'rtl' : 'ltr') %>">
<head>
  <%= render "shared/meta", title: content_for?(:title) ? yield(:title) : "Default Site Title" %>
  <%= yield :head if content_for?(:head) %>
</head>
<body data-controller="<%= html_escape(controller_name) %>"<%= " class=\"#{html_escape(body_class)}\"".html_safe if defined?(body_class) && body_class.present? %>>
  <%= render "shared/skip_links" %>
  <%= render "shared/nav" %>

  <main id="main-content" class="site-main" role="main">
    <%= render "shared/flash" %>
    <%= yield %>
  </main>

  <%= render "shared/footer" %>
  <%= yield :scripts if content_for?(:scripts) %>
</body>
</html>
```
