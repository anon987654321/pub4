<!DOCTYPE html>
<html lang="<%= h((I18n.locale.presence || I18n.default_locale || 'en').to_s) %>" dir="<%= h(rtl_locale?(I18n.locale) ? 'rtl' : 'ltr') %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/meta", title: (content_for?(:title) ? yield(:title) : t('site.title', default: 'Default Site Title')) %>
    <%= yield :head if content_for?(:head) %>
  </head>
  <body data-controller="<%= h(controller_name) %>"<% if defined?(body_class) && body_class.present? %> class="<%= h(body_class) %>"<% end %>>
    <%= render "shared/skip_links" %>
    <%= render "shared/nav" %>

    <main id="main-content" class="site-main" role="main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= yield :scripts if content_for?(:scripts) %>
  </body>
</html>