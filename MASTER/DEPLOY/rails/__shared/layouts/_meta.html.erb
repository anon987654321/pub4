<%= tag.meta charset: "utf-8" %>
<%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1" %>

<%# Open Graph tags %>
<% og_title = content_for?(:title) ? h(yield(:title)) : "My App" %>
<% og_description = content_for?(:description) ? h(yield(:description)) : "My App Description" %>
<% og_image = content_for?(:og_image) ? h(yield(:og_image)) : asset_path("default_og_image.png") %>
<%= tag.meta property: "og:type", content: "website" %>
<%= tag.meta property: "og:image", content: og_image %>
<%= tag.meta property: "og:url", content: u(request.original_url) %>
<%= tag.meta property: "og:description", content: og_description %>
<%= tag.meta property: "og:title", content: og_title %>

<%# Twitter Card tags – fall back to Open Graph values when not provided %>
<%= tag.meta name: "twitter:card", content: "summary_large_image" %>
<%= tag.meta name: "twitter:title", content: og_title %>
<%= tag.meta name: "twitter:description", content: og_description %>
<%= tag.meta name: "twitter:image", content: og_image %>