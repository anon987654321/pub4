#compdef master

# The slash surface is generated from CommandRegistry's public help contract.
# test/test_completions.rb keeps this list equal to the live command registry.
_master() {
  local -a commands
  commands=(
    'agenda:read a paired owner'\''s imported local calendar'
    'android:start Android/Termux onboarding and pair the local owner'
    'capabilities:discover core tools and optional plugin observation capabilities'
    'clear:clear the session transcript'
    'commit:commit the named paths'
    'critique:read-only: the council, without the principle map'
    'deploy:deploy MASTER or the Rails fleet to vm23 through the canonical VPS path'
    'doctor:host, provider, exposure and hardware health'
    'events:show the existing EventBus publisher/subscriber reach census'
    'explain:explain the living four-tree architecture from the checkout'
    'face:the live terminal face with one clean stage and control strip'
    'fix:the convergence loop: observe, critique, repair, observe again'
    'help:this list'
    'ios:start iOS/PWA onboarding'
    'laws:the declared laws, one line each'
    'model:show or switch the active model, inspect laboratory outcomes, and connect its subscriptions'
    'mov:find and download films and series from the free, legal collections, into ~/Downloads'
    'narrate:story narration of what MASTER is doing, on by default'
    'bard:lyrical telling of what MASTER is doing, on by default'
    'reload:restart the current session in place'
    'incident:a private dated log of what happened, kept on this machine'
    'orders:the objective ledger — the work that runs without being asked'
    'play:play the curated Blue Hour Dilla showcase or a named progression through the canonical effects rig'
    'plugin:list and invoke governed plugins'
    'pair:issue and redeem one-time pairing codes for consent-gated local access'
    'preferences:inspect and control per-person interaction settings and staged suggestions'
    'privacy:inspect personal-memory consent and manage the paired subject'\''s stored data'
    'prove:run the deterministic local PUB4 convergence proof and write a receipt'
    'quit:leave the current MASTER session'
    'review:read-only compatibility view over the /fix pipeline'
    'screen:keep MASTER running in a screen session you can leave and reattach'
    'session:the conversations: list, continue or branch one'
    'size:measured byte, file and Ruby-line mass for the four governed trees'
    'snapshot:write one source snapshot per governed tree at the pub4 root, sized for another model'\''s context'
    'skill:review declared skill contracts and approve or revoke one exact content revision'
    'soul:read and amend the constitution'
    'status:one-frame health, services and the known-good runtime'
    'support:practical personal support and a bounded synthetic quality benchmark'
    'task:keep a durable private task list with bounded steps and evidence'
    'undo:revert the last recorded change'
    'voice:CLI speech is off by default; enable it explicitly when wanted'
    'wake:control the Android/Termux wake-word listener'
    'why:what a law says, and where it comes from'
    'wishlist:the governed assistant wishlist, with an honest state per workstream'
    'exit:leave the current MASTER session'
  )

  _arguments -C '1: :->command' '*:: :->args'

  case $state in
    command) _describe 'master commands' commands ;;
  esac
}

_master "$@"
