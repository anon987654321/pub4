#compdef master cli

# The slash surface is generated from CommandRegistry's public help contract.
# test/test_completions.rb keeps this list equal to the live command registry.
_master() {
  local -a commands
  commands=(
    'android:start Android/Termux onboarding and pair the local owner'
    'clear:clear the session transcript'
    'commit:commit the named paths'
    'critique:read-only council review'
    'deploy:deploy MASTER or the Rails fleet to vm23 through the canonical VPS path'
    'doctor:host, provider, exposure and hardware health'
    'events:show the existing EventBus publisher/subscriber reach census'
    'explain:explain the living four-tree architecture from the checkout'
    'face:open the full-screen 3D terminal face'
    'fix:observe, critique, repair, observe again until it converges'
    'help:OpenBSD Operator command map; /fix is the primary repair operation'
    'ios:start iOS/PWA onboarding'
    'laws:the declared laws, one line each'
    'model:show or switch the active model, and connect its subscriptions'
    'narrate:story narration of what MASTER is doing, on by default'
    'bard:lyrical telling of what MASTER is doing, on by default'
    'orders:the objective ledger'
    'play:render a Dilla progression with a drum pattern and play it'
    'plugin:list and invoke governed plugins'
    'privacy:inspect and revoke subject-specific personal-memory consent'
    'prove:run the deterministic local PUB4 convergence proof and write a receipt'
    'quit:leave MASTER'
    'review:read-only compatibility view over the /fix pipeline'
    'screen:keep MASTER running in a screen session you can leave and reattach'
    'session:list, continue or branch a conversation'
    'size:measured byte, file and Ruby-line mass for the four governed trees'
    'snapshot:write source snapshots for all four governed trees at the pub4 root'
    'soul:read and amend the constitution, and its portable contract'
    'status:one-frame health, services and the known-good runtime'
    'undo:revert the last recorded change'
    'voice:CLI voice status and an explicit speaker test'
    'wake:control the Android/Termux wake-word listener'
    'why:what a rule says, and where it comes from'
    'wishlist:the governed assistant wishlist, with an honest state per workstream'
    'exit:leave MASTER'
  )

  _arguments -C '1: :->command' '*:: :->args'

  case $state in
    command) _describe 'master commands' commands ;;
  esac
}

_master "$@"
