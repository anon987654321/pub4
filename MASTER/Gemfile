# frozen_string_literal: true

source 'https://rubygems.org'

# Core - SQLite for state layer
gem 'sqlite3'

# LLM - using stdlib net/http and uri
# (no external gems needed - using stdlib)

# UI (only used by bin/render)
gem 'tty-table'         # Data tables
gem 'tty-box'           # Framed output
gem 'tty-spinner'       # Progress
gem 'tty-screen'        # Terminal dimensions

# Testing
group :test do
  gem 'minitest'
end

# Optional: Bot integrations (lazy loaded, not required for core pipeline)
group :optional do
  gem 'discordrb', '~> 3.5', require: false
  gem 'telegram-bot-ruby', '~> 1.0', require: false
  gem 'slack-ruby-client', '~> 2.0', require: false
end

