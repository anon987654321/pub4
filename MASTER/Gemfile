# frozen_string_literal: true

source "https://rubygems.org"
# Development stays pinned by .ruby-version at 4.0.5; OpenBSD 7.8 packages provide Ruby 3.3.9 and 3.4.9p0, both accepted by MASTER.
ruby ">= 3.3", "< 4.1"

gem "fiddle"
gem "psych"
gem "yaml"
# Ruby 4.0.5 ships json 2.18.0 as its default gem; keep boot on that pre-activated version.
gem "json", "= 2.18.0"

gem "ruby_llm", "~> 2.0"
gem "mcp", "~> 1.6"
gem "event_stream_parser", ">= 1.0"
gem "faraday", ">= 2.0"
gem "reline", "~> 0.6"
gem "tty-prompt", "~> 0.23"
gem "tty-reader", "~> 0.9"
gem "tty-screen", "~> 0.8"
gem "tty-command", "~> 0.10"
gem "pastel", "~> 0.8"
gem "diffy", "~> 3.4"
gem "ferrum", "~> 0.15"
gem "ruby-vips", "~> 2.3"
group :fan_ops do
  gem "mail", "~> 2.9"
end
gem "zeitwerk", "~> 2.7"
group :tts do
  gem "rb-edge-tts", "= 1.0.1"
end

group :test do
  gem "minitest", "~> 5.25"
  gem "rack-test", "~> 2.1"
  gem "simplecov", require: false
end
gem "rake", "~> 13.2", require: false
gem "rubocop", "~> 1.60", require: false
gem "reek", "~> 6.4", require: false
gem "opentelemetry-sdk", "~> 1.11", require: false

gem "sqlite3", "~> 2.9"
# Termux has no prebuilt sqlite3 gem and the SQLite it vendors fails to build
# there, so a phone links the gem against pkg's libsqlite (pkg install sqlite).
# A build.sqlite3 the operator set with bundle config wins.
if RUBY_PLATFORM.include?("android") && Bundler.settings["build.sqlite3"].nil?
  Bundler.settings.temporary("build.sqlite3" => "--enable-system-libraries")
end
gem "wisper", "~> 2.0"

# Architecture #7: file-watcher reactive trigger (kqueue on OpenBSD, inotify on Linux)
# The condition belongs to the dependency declaration so the lock can describe
# every supported host without executing a platform-sensitive Gemfile branch.
install_if -> { RUBY_PLATFORM =~ /bsd|dragonfly/i } do
  gem "rb-kqueue", "~> 0.2", require: false
end
install_if -> { RUBY_PLATFORM =~ /linux/ && !RUBY_PLATFORM.include?("android") } do
  gem "rb-inotify", "~> 0.10", require: false
end

# Dilla Lab — outsourced to GitHub gems (coltrane, midilib, wavefile).
# Auto-loaded from tools/dilla via DillaMusicGems.bootstrap! when bundle is present.
group :dilla do
  gem "coltrane", "~> 2.1"
  gem "midilib", "~> 4.0"
  gem "wavefile", "~> 1.1"
  gem "ostruct", "~> 0.6" # coltrane on Ruby 4.0
end
