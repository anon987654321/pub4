.DS_Store

# Soulseek material is cached locally; provenance lives in loops.json.
samples/slskd/

# A/B comparison renders from master-chain work; regenerate, do not track.
full_track_*.wav
# Every render's quality sidecar, at any depth.
*.wav.quality.json

# Stem splits. A stems render writes <name>_stems/ beside the render: four wavs
# at about 15 MB apiece plus their provenance and session sidecars, 121 MB a split.
# The render is not tracked, so its parts are not either.
*_stems/

# Audio is irreplaceable and does not belong in git. Source loops, vocal takes
# and synthesised drums are on disk and backed up as files; a 4.1 GB .git is
# already the cost of the ones that got in.
crate/
samples/
project/learnings/vocals/**/*.wav
*.320kbps.original.mp3
# Renders land in OUTPUT_DIR: the working directory, or beside dilla.rb when the
# command is typed from the repo root. Audio is never tracked wherever it lands,
# and neither is the sidecar of an untracked render.
*.wav
*.mp3
# Anchored to this directory. The vocal-fit sidecars under project/learnings are
# tracked on purpose -- they are the record of which take was fitted to what --
# and an unanchored pattern would sweep them up with the render sidecars.
/*.wav.provenance.json
/*.mp3.provenance.json

# Installed tools. The demucs virtualenv is 23,783 files and was living in
# scratch/, where its own venv .gitignore happened to cover it -- protection
# that would not extend to the next tool put beside it.
tools/

# Render sessions filed away by hand. The whole tree, not a pattern list: the
# anchored sidecar rules above stop matching one level down.
renders/
/ears/
/project/imported/
