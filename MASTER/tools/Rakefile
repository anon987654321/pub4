# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new("test:gate") do |t|
  t.libs << "test"
  t.test_files = ["test/test_tools_gate.rb"]
  t.warning = false
end

Rake::TestTask.new("test:event_bus_reach") do |t|
  t.libs << "test"
  t.test_files = ["test/test_event_bus_reach.rb"]
  t.warning = false
end

task test: ["test:gate", "test:event_bus_reach"]

desc "Parse and load the MASTER tools"
task :gate do
  ruby File.expand_path("gate.rb", __dir__)
end

desc "Run the deterministic voice quality regression harness without synthesis"
task :voice_quality do
  ruby File.expand_path("voice_quality.rb", __dir__)
end

task default: %i[gate test]
