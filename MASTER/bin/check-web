#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../lib/pub4/check_runner"

ROOT = File.expand_path("..", __dir__)
RUBY = RbConfig.ruby
STEP_TIMEOUT = Integer(ENV.fetch("MASTER_CHECK_TIMEOUT", "240"))
runner = Pub4::CheckRunner.new(prefix: "check-web", root: ROOT, timeout: STEP_TIMEOUT)

failures = []
failures << "web ui static" unless runner.run("web ui static", RUBY, "-Ilib:test", "test/test_web_ui.rb")

if ENV["MASTER_WEB_LIVE"] == "1"
  failures << "rails web" unless runner.run("rake test:web", RUBY, "-S", "rake", "test:web")
  failures << "integration web" unless runner.run("integration web", RUBY, "-S", "rake", "test:integration_web")
else
  puts "check-web: live web checks skipped (set MASTER_WEB_LIVE=1)"
end

exit(failures.empty? ? 0 : 1)
