#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"
require_relative "../lib/master"

# Initialize schema
MASTER::DB.initialize_schema

db = MASTER::DB.connection

# Load principles
principles_file = File.join(MASTER.root, "data", "principles.yml")
if File.exist?(principles_file)
  principles = YAML.load_file(principles_file)
  count = 0
  
  principles.each do |principle|
    db.execute(
      "INSERT OR IGNORE INTO principles (name, text, protection_level, category) VALUES (?, ?, ?, ?)",
      principle["name"],
      principle["text"],
      principle["protection_level"] || 0,
      principle["category"]
    )
    count += 1
  end
  
  puts "Imported #{count} principles"
end

# Load personas
personas_file = File.join(MASTER.root, "data", "personas.yml")
if File.exist?(personas_file)
  personas = YAML.load_file(personas_file)
  count = 0
  
  personas.each do |persona|
    db.execute(
      "INSERT OR REPLACE INTO personas (name, role, instructions, weight) VALUES (?, ?, ?, ?)",
      persona["name"],
      persona["role"],
      persona["instructions"],
      persona["weight"] || 0
    )
    count += 1
  end
  
  puts "Imported #{count} personas"
end

puts "Seeding complete!"
