#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# Print operator playbook lessons codified from production sessions.
# Usage: bin/playbook [area]

Encoding.default_external = Encoding::UTF_8
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"
require "ground/operator_playbook"

area = ARGV.first
area = nil if area.to_s.strip.empty?
puts Master::Ground::OperatorPlaybook.render(area: area)