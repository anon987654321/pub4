#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# master-nsaudit — find Master::* references that no longer resolve.
# Useful after namespace refactors. Exits 0 clean, 1 if any unresolved.

Encoding.default_external = Encoding::UTF_8
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"

# Eager-load so Zeitwerk-ignored fragments (loaded via explicit require, e.g.
# judge/scan/rules/*.rb) are defined and resolve like any other constant. Without
# this, lazy const_get can't autoload a plural-filename fragment and false-alarms.
Master.eager_load!

ROOT = File.expand_path("..", __dir__)
SKIP = %r{/(vendor|tmp|log|public/assets|public/packs|node_modules|\.git)/}
# bin/master-kernel boots the *kernel spine* (kernel/master.rb) on its own $LOAD_PATH,
# which defines a distinct Master:: namespace (Effect, Constitution, World, Kernel,
# Memory). Those constants don't live in lib/master, so scanning it here only yields
# false positives — the kernel has its own smoke (kernel/spec/kernel_smoke.rb).
SKIP_FILES = %w[bin/master-kernel].freeze

def resolve(name)
  name.split("::").inject(Object) { |k, p| k.const_get(p, false) }
  true
rescue NameError
  false
end

refs = Hash.new { |h, k| h[k] = [] }
Dir.glob(["lib/**/*.rb", "web/app/**/*.rb", "web/config/**/*.rb", "bin/*"], base: ROOT).each do |rel|
  path = File.join(ROOT, rel)
  next if path =~ SKIP
  next if SKIP_FILES.include?(rel)
  next unless File.file?(path)
  File.foreach(path, encoding: "UTF-8").with_index(1) do |line, lineno|
    next unless line.valid_encoding?
    line.scan(/\bMaster(?:::[A-Z][A-Za-z0-9_]*)+\b/).uniq.each do |name|
      refs[name] << "#{rel}:#{lineno}"
    end
  end
end

unresolved = refs.reject { |name, _| resolve(name) }
if unresolved.empty?
  puts "nsaudit: clean (#{refs.size} distinct refs)"
  exit 0
end

puts "nsaudit: #{unresolved.size} unresolved ref(s):"
unresolved.sort.each do |name, sites|
  puts "  #{name}"
  sites.first(5).each { |s| puts "    #{s}" }
  puts "    (+#{sites.size - 5} more)" if sites.size > 5
end
exit 1
