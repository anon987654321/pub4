#!/usr/bin/env ruby
# frozen_string_literal: true

# Drives the CLI end to end. test/test_dogfood.rb, which `rake dogfood` runs, proves the laws
# against their fixtures; the two are different checks.
require "open3"
require "rbconfig"
require "timeout"
require_relative "../lib/trace/dmesg"

MASTER_ROOT = File.expand_path("..", __dir__)
RUBY = RbConfig.ruby
BUNDLE = ENV.fetch("MASTER_BUNDLE", RUBY_PLATFORM.include?("openbsd") ? "bundle34" : "bundle")
TIMEOUT_SECONDS = Integer(ENV.fetch("MASTER_DOGFOOD_TIMEOUT", "90"))
BAD_OUTPUT = /\b(NameError|NoMethodError|LoadError|SyntaxError|ArgumentError|uninitialized constant|unknown category|aborted)\b/i

def run_step(name, env, *cmd, stdin_data: nil, chdir: MASTER_ROOT)
  Master::Trace::Dmesg.status("test0", "dogfood=#{name} state=running")
  out, status = Timeout.timeout(TIMEOUT_SECONDS) do
    Open3.capture2e(env, *cmd, stdin_data:, chdir:)
  end
  bad_line = out.lines.find { |line| line.match?(BAD_OUTPUT) }
  if status.success? && bad_line.nil?
    Master::Trace::Dmesg.status("test0", "dogfood=#{name} state=ok")
    true
  else
    Master::Trace::Dmesg.status("test0", "dogfood=#{name} state=failed")
    warn out.lines.last(120).join
    false
  end
rescue Timeout::Error
  Master::Trace::Dmesg.status("test0", "dogfood=#{name} state=timeout seconds=#{TIMEOUT_SECONDS}")
  warn "timeout after #{TIMEOUT_SECONDS}s"
  false
rescue StandardError => e
  Master::Trace::Dmesg.status("test0", "dogfood=#{name} state=failed error=#{e.class}")
  warn "#{e.class}: #{e.message}"
  false
end

env = ENV.to_h.merge(
  "MASTER_BACKGROUND" => "0",
  "MASTER_WATCH" => "0",
  "MASTER_WATCHER" => "0",
  "MASTER_AUTOFIX" => "0",
  "MASTER_WEB" => "0",
  "MASTER_QUIET" => "1",
  "MASTER_DOGFOOD" => "1"
)

script = [
  "/help",
  "/status",
  "/doctor",
  "/why FILE_SPRAWL",
  "/exit",
].join("\n") + "\n"

failures = []
failures << "cli" unless run_step("bundle exec ruby bin/cli", env, BUNDLE, "exec", RUBY, "bin/cli", stdin_data: script)
failures << "kernel" unless run_step("ruby bin/master-core", env, RUBY, "bin/master-core", "dogfood noop")

if failures.empty?
  Master::Trace::Dmesg.status("test0", "dogfood state=clean")
  exit 0
end

Master::Trace::Dmesg.status("test0", "dogfood state=failed failures=#{failures.join(",")}")
warn "dogfood failures: #{failures.join(", ")}"
exit 1
