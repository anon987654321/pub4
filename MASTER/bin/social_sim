#!/usr/bin/env ruby
# frozen_string_literal: true

# Closed social inbox sandbox — synthetic NPCs only, no real messengers.
#
#   bundle exec ruby bin/social_sim init --subject ragnhild --personas 12
#   bundle exec ruby bin/social_sim tick --hours 24 --auto ghost
#   bundle exec ruby bin/social_sim tui --run output/social_sim/ragnhild_...

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
require "ground/env_loader"
Master::Ground::EnvLoader.load!
require "master"

parsed = Master::Reach::SocialSim::CLI.parse_args(ARGV)
puts Master::Reach::SocialSim::CLI.run(parsed, root: root)