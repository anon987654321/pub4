#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  specs = [
    "spec/ops/process_budget_spec.rb",
    "spec/ops/runtime_loop_guards_spec.rb",
    "spec/ops/source_loop_guards_spec.rb",
    "spec/ops/loop_owner_spec.rb",
    "spec/ops/boot_safety_spec.rb",
    "spec/ops/gate_contract_spec.rb",
    "spec/web/visual_governor_spec.rb",
    "spec/web/web_screenshot_spec.rb",
    "spec/web/face_state_spec.rb",
    "spec/web/boot_fsm_spec.rb",
    "spec/web/master_namespace_spec.rb",
    "spec/web/attention_model_spec.rb",
    "spec/web/idle_profile_spec.rb",
    "spec/web/face_speech_runtime_spec.rb",
    "spec/web/face_speech_playback_spec.rb",
    "spec/voice/speech_contract_spec.rb",
    "spec/social/assistant_contract_spec.rb",
    "spec/social/tool_honesty_spec.rb",
    "spec/providers/catalog_index_spec.rb",
    "spec/smoke/static_syntax_spec.rb",
    "spec/tools/lifecycle_tools_spec.rb",
  ]

  failed = specs.reject do |spec|
    system(RbConfig.ruby, spec)
  end

  abort "FAIL safety tests: #{failed.join(', ')}" unless failed.empty?
  puts "OK safety tests"
end
