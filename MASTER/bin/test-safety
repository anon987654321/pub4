#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  specs = [
    "spec/ops/process_budget_spec.rb",
    "spec/ops/runtime_loop_guards_spec.rb",
    "spec/web/visual_governor_spec.rb",
    "spec/social/assistant_contract_spec.rb",
    "spec/social/tool_honesty_spec.rb",
    "spec/providers/catalog_index_spec.rb"
  ]

  failed = specs.reject do |spec|
    system(RbConfig.ruby, spec)
  end

  abort "FAIL safety tests: #{failed.join(', ')}" unless failed.empty?
  puts "OK safety tests"
end
