#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone cinematic video generator — mirrors /video inside MASTER CLI.
#
# Usage:
#   bundle exec ruby bin/video --backend kling --minutes 2 "neon alley chase"
#   bundle exec ruby bin/video --backend animatediff_camera --motion-stack slow_dolly_push_in,elegant_orbit_tracking \
#     --critique --vision-critique --auto-retry "epic cyberpunk chase"

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
require "ground/env_loader"
Master::Ground::EnvLoader.load!
require "master"

subcommand = ARGV.first.to_s
case subcommand
when "motion-dataset", "dataset"
  parsed = Master::Reach::VideoCli.parse_motion_dataset_args(ARGV[1..].join(" "))
  if parsed[:usage]
    warn parsed[:usage]
    exit 1
  end
  result = Master::Reach::MotionLoraDataset.bootstrap(
    preset: parsed[:preset],
    subject: parsed[:subject],
    clips: parsed[:clips],
    backend: parsed[:backend],
    lora_id: parsed[:lora_id],
    root: root
  )
  puts "motion-dataset: dir=#{result[:dir]} clips=#{result[:clips]}"
when "lora-train", "lora"
  parsed = Master::Reach::VideoCli.parse_lora_train_args(ARGV[1..].join(" "))
  if parsed[:usage]
    warn parsed[:usage]
    exit 1
  end
  puts Master::Reach::VideoCli.run_lora_train(parsed, root: root)
when "help", "-h", "--help"
  puts Master::Reach::VideoCli.video_usage
  puts
  puts Master::Reach::VideoCli.motion_dataset_usage
  puts
  puts Master::Reach::VideoCli.lora_train_usage
else
  parsed = Master::Reach::VideoCli.parse_video_args(ARGV.join(" "))
  if parsed[:usage]
    warn parsed[:usage]
    exit 1
  end
  puts Master::Reach::VideoCli.run_generate(parsed, root: root)
end