#!/usr/bin/env ruby
# frozen_string_literal: true

# The name GitHub Actions, bin/preflight and the vm23 runbook all invoke, over
# the step list bin/check owns.
#
# The steps themselves lived here in a second copy — the same rake tasks
# bin/check's profiles name, maintained separately and free to drift, with
# `bin/check --profile=full` shelling out to this file and so paying for
# selftest and core_smoke twice. One registry now: this resolves to
# `bin/check --profile=ci`, and MASTER_CI_FULL, MASTER_CI_WEB and
# MASTER_CI_BROWSER still widen it exactly as before.
#
# Kept as a script rather than folded away because the callers are outside this
# repo's reach: a workflow file, a zsh preflight and an operator's muscle memory.

require "rbconfig"

exec(RbConfig.ruby, File.join(__dir__, "check"), "--profile=ci", *ARGV)
