#!/usr/bin/env ruby
# frozen_string_literal: true
#
# TTS subprocess — runs EventMachine in isolation from Falcon's Async fiber
# scheduler. Reads text from stdin, writes audio to argv[3].
#
# Usage: tts-worker VOICE RATE PITCH OUT_PATH < text

require "bundler/setup"
require "rb_edge_tts"
require "faye/websocket"

# EM 1.2.7 ignores ca_file in TLS options — known upstream bug.
# Pass system CA bundle and enable peer verification; EM may not enforce it
# but we do not explicitly disable it. Real fix: upgrade EM or replace Faye.
SYSTEM_CA = %w[/etc/ssl/cert.pem /etc/ssl/certs/ca-certificates.crt].find { |p| File.exist?(p) }
Faye::WebSocket::Client.singleton_class.prepend(Module.new do
  def new(url, protocols = [], options = {})
    tls = { verify_peer: true }
    tls[:ca_file] = SYSTEM_CA if SYSTEM_CA
    super(url, protocols, options.merge(tls:))
  end
end)

voice, rate, pitch, out_path = ARGV
if [voice, rate, pitch, out_path].any?(&:nil?)
  warn "tts-worker: usage: tts-worker VOICE RATE PITCH OUT_PATH < text"
  exit 64 # EX_USAGE
end
text = $stdin.read
if text.to_s.strip.empty?
  warn "tts-worker: empty stdin"
  exit 65 # EX_DATAERR
end

begin
  RbEdgeTTS::Communicate.new(text, voice, rate: rate, pitch: pitch).save_sync(out_path)
  exit(File.exist?(out_path) && File.size(out_path) > 0 ? 0 : 1)
rescue StandardError => e
  warn "tts-worker: #{e.class}: #{e.message}"
  exit 1
end
