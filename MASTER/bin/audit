#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

# master-audit — pre-commit constitution check.
# Runs the scanner over staged files and exits non-zero on any kernel-tier
# or critical/error violation. Wire as a git pre-commit hook:
#   exec MASTER/bin/audit --profile critical
# Other tiers (design, style, etc.) are reported but do not fail the commit —
# the scan rule registry is the place to tighten or loosen the bar.

Encoding.default_external = Encoding::UTF_8
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"
require "open3"
require "set"

CRITICAL_SEVERITIES = %i[critical error veto].freeze

KERNEL_RULES = begin
  data = Master.load_rules(root: Master::ROOT)
  rules = (data["rules"] || {}).values.flatten
  rules.select { |r| r["tier"] == "kernel" }.map { |r| r["id"].to_s.downcase }.to_set
rescue StandardError => e
  Set.new
end

container = Master.bootstrap_container(root: Dir.pwd)
scanner   = container[:scanner]

staged, _ = Open3.capture2e("git", "diff", "--cached", "--name-only", "--diff-filter=ACM")
files     = staged.lines.map(&:strip).reject(&:empty?).select { |f| File.file?(f) }
abort "audit: no staged files" if files.empty?

violations = files.flat_map do |f|
  result = scanner.scan(f)
  result.respond_to?(:value!) && result.ok? ? result.value! : []
end

failing = violations.select do |v|
  KERNEL_RULES.include?(v[:rule].to_s.downcase) ||
    CRITICAL_SEVERITIES.include?(v[:severity].to_sym)
end

failing.each { |v| warn "#{v[:file]}:#{v[:line]}: [#{v[:severity]}] #{v[:rule]}: #{v[:message]}" }
exit(failing.empty? ? 0 : 1)
