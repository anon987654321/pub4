#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Readable source snapshots — one markdown per repo subtree, git-tracked text only.
# Media, vendored deps, generated assets, and the .master cache never inline --
# but every git-tracked TEXT file is, in full, no size cap, no "large file, not
# inlined" placeholders (unlike SnapshotPublisher's small boot-context digest).
# This is the full-snapshot tool; the small boot-context snapshot still lives in
# MASTER/lib/trace/snapshot_publisher.rb.
#
#   bin/snapshot [all|MASTER|RAILS|OPENBSD|OPERATOR] [--out DIR]
#
# Default: all present pillars, written as snapshot_<LABEL>.md at the pub4 repo root
# (LLM-shareable codebase packs — git-tracked text only). Each file embeds
# SnapshotAgentGuide's protocol so another LLM opening it cold knows how to work
# through it (orient -> cross-reference -> trace -> assess -> rehydrate).

require "optparse"
require_relative "../lib/trace/snapshot_collector"
require_relative "../lib/trace/snapshot_agent_guide"

REPO_ROOT = File.expand_path("../..", __dir__) # pub4 (parent of MASTER/)
# Real monorepo pillars first; OPERATOR is optional/legacy.
DEFAULT_LABELS = %w[MASTER RAILS OPENBSD].freeze
OPTIONAL_LABELS = %w[OPERATOR].freeze
LANG = {
  ".rb" => "ruby", ".rake" => "ruby", ".ru" => "ruby", ".gemspec" => "ruby",
  ".js" => "javascript", ".mjs" => "javascript", ".ts" => "typescript",
  ".yml" => "yaml", ".yaml" => "yaml", ".json" => "json", ".toml" => "toml",
  ".md" => "markdown", ".markdown" => "markdown", ".erb" => "erb", ".sh" => "bash",
  ".bash" => "bash", ".zsh" => "bash", ".css" => "css", ".scss" => "scss",
  ".html" => "html", ".sql" => "sql", ".xml" => "xml"
}.freeze

out = REPO_ROOT
OptionParser.new do |opts|
  opts.banner = "usage: bin/snapshot [all|MASTER|RAILS|OPENBSD|OPERATOR] [--out DIR]"
  opts.on("--out DIR") { |dir| out = File.expand_path(dir) }
end.parse!

which = (ARGV.first || "all").downcase
labels =
  if which == "all"
    present = DEFAULT_LABELS.select { |label| File.directory?(File.join(REPO_ROOT, label)) }
    present + OPTIONAL_LABELS.select { |label| File.directory?(File.join(REPO_ROOT, label)) }
  else
    [which.upcase]
  end

def fence(body) = "`" * [body.scan(/`+/).map(&:length).max.to_i + 1, 3].max

def rel_path(path, repo_root) = path.delete_prefix("#{repo_root}/")

def snapshot(label, out_dir, repo_root)
  target = File.join(repo_root, label)
  unless File.directory?(target) || label == "OPENBSD"
    # OPENBSD collector also packs deploy pillars; directory still expected for clarity.
    warn "snapshot: skip #{label} (missing #{target})"
    return
  end

  # cap: nil -- this pack promises "everything, in full" to the LLM reading it;
  # `large` is therefore always empty, never a truncation bucket to render.
  parts = Master::Trace::SnapshotCollector.partition(
    Master::Trace::SnapshotCollector.collect_paths(label:, repo_root:, target: target), cap: nil
  )
  inlined = parts[:inlined]
  if inlined.empty?
    warn "snapshot: skip #{label} (no git-tracked text files)"
    return
  end

  dest = File.join(out_dir, "snapshot_#{label}.md")
  git_sha = `git -C #{Shellwords.escape(repo_root)} rev-parse --short HEAD 2>/dev/null`.strip
  git_sha = "unknown" if git_sha.empty?

  File.open(dest, "w") do |io|
    io.puts "# #{label} — source snapshot", ""
    io.puts "Generated #{Time.now.utc.strftime('%Y-%m-%d %H:%M UTC')} · git #{git_sha} · " \
            "#{inlined.size} files, every one inlined in full (no size cap, no placeholders) · " \
            "git-tracked text only (binaries/vendor/generated assets excluded, see policy below).", ""
    io.puts "Share this file with another LLM as the full readable #{label} codebase pack.", ""
    io.puts Master::Trace::SnapshotAgentGuide.render(label:, full_inline: true), ""
    io.puts "## Tree", "```"
    inlined.each { |path| io.puts rel_path(path, repo_root) }
    io.puts "```", ""
    io.puts "## Files"
    inlined.each do |path|
      body = File.read(path, encoding: "UTF-8").scrub
      wrap = fence(body)
      io.puts "", "## `#{rel_path(path, repo_root)}`", "", "#{wrap}#{LANG[File.extname(path).downcase] || "text"}", body, wrap
    end
  end
  puts "snapshot: #{label} -> #{dest} (#{(File.size(dest) / 1024.0 / 1024).round(1)} MB, " \
       "#{inlined.size} files, all inlined in full)"
end

require "shellwords"
Dir.chdir(REPO_ROOT) { labels.each { |label| snapshot(label, out, REPO_ROOT) } }
