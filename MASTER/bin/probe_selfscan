#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"

root = File.expand_path("..", __dir__)
container = Master.bootstrap_container(root: root)
scanner = container[:scanner]
target = File.join(root, "lib", "master.rb")
result = scanner.scan(target, depth: :deep)
findings = result.ok? ? result.value! : []
violations = findings.select { |f| %i[error critical].include?(f[:severity].to_sym) }
puts "selfscan: #{target} findings=#{findings.size} critical=#{violations.size}"
violations.first(10).each do |finding|
  warn "#{finding[:file]}:#{finding[:line]} [#{finding[:severity]}] #{finding[:rule]}: #{finding[:message]}"
end
exit(violations.empty? ? 0 : 1)