#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

require "fileutils"
require "json"
require "open3"
require "optparse"
require "time"
require_relative "../lib/trace/dmesg"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
REPORT_DIR = File.join(ROOT, "reports", "cleanup")
STAMP = Time.now.utc.strftime("%Y%m%d-%H%M%S")

options = { apply: false }
OptionParser.new do |opts|
  opts.banner = "usage: cleanup [--apply]"
  opts.on("--apply") { options[:apply] = true }
end.parse!

def capture(*argv, chdir: REPO)
  stdout, stderr, status = Open3.capture3(*argv, chdir: chdir)
  raise "#{argv.join(' ')} failed: #{stderr}" unless status.success?
  stdout
end

def clean_tree?
  capture("git", "status", "--porcelain", chdir: REPO).strip.empty?
end

def write_report(name, body)
  FileUtils.mkdir_p(REPORT_DIR)
  path = File.join(REPORT_DIR, "#{name}_#{STAMP}")
  File.write(path, body)
  path
end

# A tool that could not run still leaves a report, so the before-state is on disk
# either way — but the line says WARN, because a report holding only the failure
# is not the snapshot the rest of this run assumes it took.
def maybe_run_tool(name, *argv)
  [capture(*argv, chdir: ROOT), true]
rescue StandardError => e
  ["#{name}: unavailable: #{e.message}\n", false]
end

unless clean_tree?
  Master::Trace::Dmesg.status("cleanup0", "failed, working tree dirty", io: $stderr)
  exit 1
end

reports = {
  "inventory_before.json" => maybe_run_tool("inventory", "ruby", "tools/repo_inventory.rb", "--json"),
  "history_before.txt" => maybe_run_tool("history", "ruby", "tools/history_valuables.rb", "."),
}
Master::Trace::Dmesg.attach("cleanup0", "master0", "reports")
reports.each do |file, (body, ran)|
  path = write_report(file, body)
  Master::Trace::Dmesg.status("cleanup0", ran ? "wrote #{path}" : "wrote #{path}, tool did not run: #{body.strip}")
end

candidates = Dir.glob(File.join(REPO, "test_*.jpg")).map { |path| path.sub(REPO + "/", "") }
Master::Trace::Dmesg.status("cleanup0", candidates.empty? ? "no root test_*.jpg candidates" : "#{candidates.size} cleanup candidate(s)")
candidates.each { |candidate| Master::Trace::Dmesg.status("cleanup0", candidate) }

if options[:apply]
  candidates.each { |rel| File.delete(File.join(REPO, rel)) if File.file?(File.join(REPO, rel)) } # scan: intentional — each candidate was listed above and --apply names them
  capture("git", "add", "-u", *candidates, chdir: REPO) unless candidates.empty?
  Master::Trace::Dmesg.status("cleanup0", "applied cleanup candidates")
else
  Master::Trace::Dmesg.status("cleanup0", "dry run only, rerun with --apply to remove candidates")
end
