#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

require "optparse"
require_relative "../lib/io/exec"
require "shellwords"

# Two levels: this lives in MASTER/bin/, and every sibling tree is reached
# from the repo root above it.
ROOT = File.expand_path("../..", __dir__)
OPENBSD_OPS = File.join(ROOT, "OPENBSD")
$LOAD_PATH.unshift(File.join(ROOT, "MASTER", "lib")) unless $LOAD_PATH.include?(File.join(ROOT, "MASTER", "lib"))

require "operator/environment"
require "operator/ruby_runner"
require "operator/status_report"
require "operator/strict_mode"
require "operator/law_inventory"
require_relative "../lib/trace/dmesg"

RUBY = Operator::RubyRunner.ruby_cmd
BUNDLE = Operator::RubyRunner.bundle_cmd

def die(command, message, code = 1)
  Master::Trace::Dmesg.status("#{command}0", "failed, #{message}", io: $stderr)
  exit code
end

def usage
  <<~HELP
    operator — repo-wide operator surface

    Usage:
      bin/operator gate [--scan-only] [--only=a,b] [--tree=T] [--list] [--release]  every gate in the repo, fixing as it goes
      bin/operator status [--json]
      bin/operator vps state [--json] [--remote]
      bin/operator vps master <status|start|stop|restart> [--remote]
      bin/operator vps deploy <app|master> [--remote]
      bin/operator vps logs <app> [--lines N] [--remote]
      bin/operator vps admin <status|services|service|pf|disk|memory|swap|dmesg|packages|updates|upgrade|reboot> [args] [--remote]
      bin/operator post-pull
      bin/operator measure [--deep] [--json]
      bin/operator measure --why <row>    the members behind one number
      bin/operator measure --since <ref>  which recorded ceilings moved since <ref>
      bin/operator lint [--staged] [--changed-lines] [<path>...]  judge files by MASTER's laws, no model
      bin/operator test [<path>...]       smallest complete proof for the paths (default: dirty files)
      bin/operator land -m <msg> <path>...  commit, rebase, re-check, push
      bin/operator worktree <name>|finish own checkout, or finish (rebase, push the branch, do not merge main)
      bin/operator laws <ID> [--card] [--health] [--deep] [--json] [--corpus MASTER|all] [path...]
                                      the rule, its exemption, then what it finds
      bin/operator hooks                  install the shared-tree commit guard
      bin/operator readers <path>         who reaches this file, across all four governed trees
      bin/operator pushed? <path>...      is this content on origin/main, or only here
      bin/operator snapshot [MASTER|RAILS|OPENBSD|STUDIO]  regenerate source snapshots at the pub4 root
      bin/operator event-bus [--strict] [--json]  census Ruby publishers/subscribers and browser event references
      bin/operator wishlist [--all]     show the current bounded next-work queue

    Profiles (passed through to check scripts):
      OPENBSD/bin/check --profile=contributor
      cd MASTER && bin/check --profile=contributor
  HELP
end

def ssh_host
  ENV.fetch("PUB4_SSH_HOST", "dev@brgen.no")
end

def ssh_key
  File.expand_path(ENV.fetch("PUB4_SSH_KEY", "~/.ssh/id_ed25519_brgen"))
end

# A command for the box that runs a Ruby script with whatever Ruby the box has.
# The resolution happens there, through OPENBSD/lib/ruby_select.sh, never here.
def remote_ruby(*argv)
  resolver = %q(. OPENBSD/lib/ruby_select.sh && exec "$RUBY" "$@")
  "cd /home/dev/pub4 && #{Shellwords.join(["sh", "-c", resolver, "sh", *argv])}"
end

def ssh_run(remote_cmd)
  cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-i", ssh_key, ssh_host, remote_cmd]
  exec(*cmd)
end

command = ARGV.shift
case command
when "gate"
  # The whole ladder, autofixing, in one invocation — the default way to find
  # out whether this repo is conformant. The stages and the reasoning behind
  # their order live in lib/operator/gate_chain.rb.
  #
  # It writes by default, because a scanner that finds a fixable defect and
  # leaves it is a scanner whose findings someone has to walk back to later.
  # --scan-only measures and writes nothing; every stage says which files it
  # changed, under its own name, so a bad fix is attributable to the stage that
  # made it rather than to the diff as a whole.
  require "operator/gate_chain"
  release = !ARGV.delete("--release").nil?
  ENV["MASTER_STRICT"] = "deploy" if release
  scan_only = !ARGV.delete("--scan-only").nil? || ENV["MASTER_GATE_SCAN_ONLY"] == "1"
  # --explain is the same question people actually ask before starting an hour
  # of gates: what is this going to run.
  list = !ARGV.delete("--list").nil? || !ARGV.delete("--explain").nil?
  only = ARGV.filter_map { |arg| arg[/\A--only=(.+)\z/, 1] }.flat_map { |value| value.split(",") }
  # --tree is the common case made cheap: working inside one tree, the other
  # four trees' suites and gates prove nothing about the change and cost most of
  # the wall clock. It drops whole stages rather than shrinking them; the
  # reasoning is in lib/operator/gate_chain.rb.
  trees = ARGV.filter_map { |arg| arg[/\A--tree=(.+)\z/, 1] }
  trees << ARGV[ARGV.index("--tree") + 1].to_s if ARGV.include?("--tree")
  exit Operator::GateChain.run(scan_only:, only:, list:, trees:)
when "status", nil
  json = ARGV.include?("--json")
  output = Operator::StatusReport.new(root: ROOT).render(json:)
  json ? puts(output) : Master::Trace::Dmesg::Report.print("/status", output)
when "measure"
  # Every ratchet in the repo, current beside recorded. Non-zero when any is over
  # its ceiling OR slack beneath it, because a ceiling above the real number is
  # room the next change grows into without failing anything.
  #
  # --why names the files behind a number and --since names the ceilings that
  # moved, because neither question can be answered from the table: "OVER +826"
  # is not something a session can act on or disclaim.
  require_relative "../lib/operator/ratchets"
  deep = !ARGV.delete("--deep").nil?
  why = ARGV.filter_map { |arg| arg[/\A--why(?:=(.*))?\z/, 1] }.first
  why ||= ARGV[ARGV.index("--why") + 1].to_s if ARGV.include?("--why")
  since = ARGV.filter_map { |arg| arg[/\A--since(?:=(.*))?\z/, 1] }.first
  since ||= ARGV[ARGV.index("--since") + 1] if ARGV.include?("--since")
  die("measure", "usage, bin/operator measure --since <ref>", 64) if ARGV.include?("--since") && since.to_s.empty?
  if since
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.since(since))
    exit 0
  end
  rows = Operator::Ratchets.all(deep:)
  if why
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.why(rows, why))
    exit 0
  end
  if ARGV.include?("--json")
    puts Operator::Ratchets.json(rows)
  else
    Master::Trace::Dmesg::Report.print("measure", Operator::Ratchets.render(rows))
  end
  exit(Operator::Ratchets.ok?(rows) ? 0 : 1)
when "lint"
  # Inheritance made mechanical. The same deterministic rules MASTER runs on
  # itself — every lexical and AST rule plus law/, no model, no autofix — judge
  # whatever files an agent touched, so claude, grok or codex can run it on a
  # diff before committing and be held to the constitution regardless of which
  # tool typed the change. Paths given are scanned as named; with none, the diff
  # against HEAD is.
  require "master"
  require "fix/scanner"
  # --changed-lines judges only the lines this diff added, so a file's standing
  # debt does not block the commit that merely touched it — the shape a
  # pre-commit hook wants.
  changed_only = !ARGV.delete("--changed-lines").nil?
  # --staged reads the index (what this commit includes), the scope a pre-commit
  # hook wants; without it, the whole working tree against HEAD.
  diff_base = ARGV.delete("--staged").nil? ? "HEAD" : "--cached"
  scanner = Master::Fix::Scanner.build(root: Master::ROOT, agent: nil)
  changed, = Master::Io::Exec.capture2e("git", "-C", ROOT, "diff", "--name-only", diff_base)
  targets = ARGV.empty? ? changed.lines.map { |line| File.join(ROOT, line.chomp) } : ARGV
  files = targets.flat_map { |t| File.directory?(t) ? Dir.glob(File.join(t, "**/*")) : [t] }.select { |p| File.file?(p) }
  touched = nil
  if changed_only
    touched = Hash.new { |hash, key| hash[key] = [] }
    current = nil
    hunks, = Master::Io::Exec.capture2e("git", "-C", ROOT, "diff", "-U0", diff_base)
    hunks.each_line do |diff_line|
      current = File.join(ROOT, diff_line[6..].chomp) if diff_line.start_with?("+++ b/")
      next unless current && (hunk = diff_line.match(/^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@/))

      start = hunk[1].to_i
      touched[current].concat((start...(start + (hunk[2] || "1").to_i)).to_a)
    end
  end
  findings = files.flat_map do |path|
    result = scanner.scan(path, depth: :deep)
    rows = result.ok? ? Array(result.value!) : []
    rows = rows.select { |finding| touched.fetch(path, []).include?(finding[:line]) } if touched
    rows.map { |finding| [path, finding] }
  end
  if findings.empty?
    Master::Trace::Dmesg.status("lint0", "clean, #{files.size} files, no law broken")
    exit 0
  end
  Master::Trace::Dmesg.attach("lint0", "master0", "#{findings.size} finding(s) across #{findings.map(&:first).uniq.size} files")
  findings.sort_by { |path, finding| [path, finding[:line].to_i] }.each do |path, finding|
    Master::Trace::Dmesg.status("lint0", "#{path.sub("#{ROOT}/", "")}:#{finding[:line]}, #{finding[:message]}")
  end
  exit 1
when "land"
  # Commit, rebase onto origin/main, re-check, push — in that order, because the
  # order is where it goes wrong.
  #
  # Every landing in a worktree is the same five steps, and the two that get
  # skipped are the two that matter. Rebasing onto a main that moved can
  # invalidate a green run, so the checks run again AFTER the rebase and not
  # only before it. And `git push` sends every commit beneath yours, so this
  # prints what is going before it goes.
  #
  # Path-scoped by construction: with no paths it commits nothing, rather than
  # sweeping up whatever else is in a shared checkout.
  message = nil
  message_file = nil
  OptionParser.new do |o|
    o.on("-m MSG") { |v| message = v }
    o.on("-F FILE") { |v| message_file = v }
  end.parse!(ARGV)
  paths = ARGV
  die("land", "usage, bin/operator land -m <message> <path>...", 64) if paths.empty?
  die("land", "usage, bin/operator land needs -m <message> or -F <file>", 64) unless message || message_file

  # A worktree carries .git as a file. In the shared checkout the rebase below
  # would carry other sessions' local commits onto origin/main with this one.
  unless File.file?(File.join(ROOT, ".git"))
    die("land", "refused outside a worktree, use bin/operator worktree <name> first")
  end

  def run!(*cmd, chdir: ROOT)
    out, status = Master::Io::Exec.capture2e(*cmd, chdir: chdir)
    [out.strip, status.success?]
  end

  measure_out, measure_ok = run!(File.join(__dir__, "operator"), "measure")
  unless measure_ok
    Master::Trace::Dmesg::Report.print("measure", measure_out, io: $stderr)
    die("land", "ratchet is off before you started")
  end
  Master::Trace::Dmesg.status("land0", "ratchets clean")

  commit = ["git", "commit", "-q"]
  commit += message_file ? ["-F", message_file] : ["-m", message]
  _, ok = run!(*commit, "--", *paths)
  die("land", "nothing committed, paths matched no changes?") unless ok

  run!("git", "fetch", "-q", "origin")
  rebase_out, rebased = run!("git", "rebase", "-q", "origin/main")
  abort("land: rebase onto origin/main failed — resolve, then run land again\n#{rebase_out}") unless rebased

  # The same measurement again. A rebase brings other people's commits under
  # yours, and theirs can put a ceiling over the edge that yours did not.
  after_out, after_ok = run!(File.join(__dir__, "operator"), "measure")
  unless after_ok
    Master::Trace::Dmesg::Report.print("measure", after_out, io: $stderr)
    die("land", "green before rebase, off after it, origin/main moved under you")
  end

  ahead, = run!("git", "log", "--oneline", "origin/main..HEAD")
  Master::Trace::Dmesg.attach("land0", "master0", "publishing")
  ahead.each_line { |line| Master::Trace::Dmesg.status("land0", line.chomp) }
  push_out, pushed = run!("git", "push", "origin", "HEAD:main")
  abort("land: push refused\n#{push_out}") unless pushed
  Master::Trace::Dmesg.status("land0", "on origin/main")
when "snapshot"
  # Regenerates snapshot_<TREE>.md — the verbatim packs handed to another model
  # when it needs the whole tree rather than a summary. The generator that made
  # them was bin/snapshot, deleted with the DEPLOY tree, so the four files sat
  # stale at a commit no checkout still has and nothing could refresh them.
  # Lives in MASTER/tools so it is one implementation, reachable from here.
  exec(RbConfig.ruby, File.join(ROOT, "MASTER", "tools", "snapshot.rb"), *ARGV)
when "wishlist"
  # Wishlist state is machine-owned JSON under .master, never another markdown
  # backlog. Display the same queue /fix reads, so the operator and fixer cannot
  # diverge about what remains claimable.
  require "fix/wishlist"
  full = !ARGV.delete("--all").nil?
  path = File.join(ROOT, Master::Fix::Wishlist::LEDGER_PATH)
  unless File.file?(path)
    Master::Trace::Dmesg.status("wishlist0", "empty, a successful /fix run will draft the next queue")
    exit 0
  end

  if full
    Master::Trace::Dmesg::Report.print("wishlist", File.read(path, encoding: "UTF-8"))
  else
    context = Master::Fix::Wishlist.pending_context(ROOT, target: ROOT, limit: Master::Fix::Wishlist::BATCH_SIZE)
    Master::Trace::Dmesg::Report.print("wishlist", context || "no claimable next_fix proposals")
  end
when "event-bus"
  exec(RbConfig.ruby, File.join(ROOT, "MASTER", "tools", "event_bus_reach.rb"), *ARGV)
when "post-pull"
  script = File.join(OPENBSD_OPS, "bin", "post-pull-checklist")
  exec(script, *ARGV)
when "worktree"
  # The one command, because the friction was the whole problem. CLAUDE.md has
  # said "take a worktree if more than one agent is active" for months while the
  # worktree took a remembered path to a shell script and the shared tree took
  # nothing. Sessions kept picking nothing, and kept committing each other's work.
  # finish rebases onto origin/main and pushes the branch — it does not merge
  # to local main, which is how another session's push published commits twice.
  name = ARGV.shift
  die("worktree", "usage, bin/operator worktree <name>|finish [--remove]", 64) if name.to_s.empty?
  exec("sh", File.join(OPENBSD_OPS, "dev", "agent_worktree.sh"), name, *ARGV)
when "law:silent"
  output = Operator::LawInventory.render_collection(:silent, json: ARGV.include?("--json"))
  if output
    ARGV.include?("--json") ? puts(output) : Master::Trace::Dmesg::Report.print(command.to_s, output)
  end
  exit 0
when "law:costly"
  output = Operator::LawInventory.render_collection(:costly, json: ARGV.include?("--json"))
  Master::Trace::Dmesg::Report.print(command.to_s, output) if output
  exit 0
when "law:twin"
  output = Operator::LawInventory.render_collection(:twin, json: ARGV.include?("--json"))
  Master::Trace::Dmesg::Report.print(command.to_s, output) if output
  exit 0
when "law:matrix"
  output = Operator::LawInventory.render_collection(:matrix, json: ARGV.include?("--json"))
  Master::Trace::Dmesg::Report.print(command.to_s, output) if output
  exit 0
when "laws"
  # One law: what it says, what it spares, and what it finds — in that order.
  # The same word as the CLI's /laws, which lists them; this is one in full.
  #
  # It printed findings and nothing else, so the one thing a session actually
  # needs before writing a line was the one thing it could not get cheaply.
  # CLAUDE.md's instruction is to hold the rule AND its exemption before the
  # first edit, and "the exemption is the half that gets skipped and the half
  # that was earned against a measured false positive". A findings list carries
  # neither.
  #
  # The exemption is not a field anywhere. In law/ it is a clause inside the
  # detect block with the measurement that earned it in the comment above; in
  # the registry it is an early return with the same comment. So the card prints
  # the definition verbatim, comments included, rather than a summary of it —
  # a summary is where an exemption goes missing.
  require "master"
  require "fix/scanner"
  require "yaml"
  require "json"
  health = !ARGV.delete("--health").nil? || !ARGV.delete("--deep").nil?
  json_health = ARGV.include?("--json")
  id = ARGV.shift.to_s
  die("laws", "usage, bin/operator laws <ID> [--card] [--json] [--corpus MASTER|all] [path...]", 64) if id.empty?

  corpus = "MASTER"
  ARGV.delete_if { |arg| (m = arg.match(/\A--corpus=(.+)\z/)) && (corpus = m[1]) }
  card_only = !ARGV.delete("--card").nil?
  as_json = !ARGV.delete("--json").nil?
  ENV["MASTER_SCAN_DETERMINISTIC"] = "1"
  master_root = File.join(ROOT, "MASTER")

  if health
    row = Operator::LawInventory.health(id)
    die("laws", "nothing named #{id.inspect}") unless row
    output = Operator::LawInventory.render(id:, deep: true, json: json_health)
    json_health ? puts(output) : Master::Trace::Dmesg::Report.print("laws", output)
    exit 0
  end

  # The declaration, from the file CLAUDE.md calls the law. A rule can be
  # declared here and have no detector — 78 of them are — so this is looked up
  # first and separately from the scanner.
  # Walked rather than read from `rules`: ids live under `laws`, `beauty` and
  # `anti_patterns` too, and a lookup that knows only one section answers "no
  # such rule" about a rule that exists.
  def declarations_in(node, found = [])
    case node
    when Hash
      found << node if node["id"].is_a?(String)
      node.each_value { |value| declarations_in(value, found) }
    when Array
      node.each { |value| declarations_in(value, found) }
    end
    found
  end

  declared = declarations_in(YAML.safe_load_file(File.join(master_root, "data/laws.yml"), aliases: true))
             .find { |row| row["id"].to_s.casecmp?(id) }

  require File.join(master_root, "law", "law")
  Law.load_all(File.join(master_root, "law")) if Law.definitions.empty?
  executable_law = Law.definitions[id.to_sym]

  # Where it is written. Every ruby file under law/ and the scan registry is
  # searched for the id, and the enclosing block plus its leading comment is the
  # answer — that comment is where the exemption's reason lives.
  def definition_at(root, id)
    Dir.glob(File.join(root, "{law/*.rb,lib/review/scan/laws/*.rb}")).sort.each do |path|
      lines = File.readlines(path)
      index = rule_anchor(lines, id)
      next unless index

      span = enclosing_span(lines, index)
      return { path: path.sub("#{root}/", "MASTER/"), line: span.first + 1, body: clipped(lines[span], path) }
    end
    nil
  end

  # The declaration first; a bare mention of the id only when nothing declares it.
  def rule_anchor(lines, id)
    declaration = /(?:Law\.define\(:|declare\s+id:\s*["']|declare\s+:)#{Regexp.escape(id)}\b/i
    lines.index { |line| line.match?(declaration) } || lines.index { |line| line.include?(id) }
  end

  # The block is the enclosing definition, so back up past the comment that
  # explains it — and take the indent from the code, not the comment, or a
  # comment indented one step deeper runs the block on to the file's end.
  def enclosing_span(lines, index)
    first = index
    first -= 1 while first.positive? && lines[first - 1].strip.start_with?("#")
    opener = (first..index).find { |i| !lines[i].strip.start_with?("#") && !lines[i].strip.empty? } || index
    opener = index.downto(0).find { |i| lines[i].match?(/\A\s*(class|module|Law\.define)\b/) } || opener
    first..block_end(lines, opener)
  end

  def block_end(lines, opener)
    closer = "#{' ' * lines[opener][/\A\s*/].length}end"
    last = opener
    last += 1 while last + 1 < lines.length && lines[last].rstrip != closer
    last
  end

  def clipped(body, path)
    return body.join if body.size <= 80

    (body.first(80) + ["    … #{body.size - 80} more line(s); open #{path} to read the rest\n"]).join
  end

  scanner = Master::Fix::Scanner.build(root: master_root, agent: nil)
  rule = scanner.laws.find { |item| item.id.to_s.casecmp?(id) }
  if rule.nil? && declared.nil?
    abort("rule: nothing named #{id.inspect} — neither a declaration in data/laws.yml " \
          "nor one of the #{scanner.laws.size} rules the scanner loaded")
  end

  where = definition_at(master_root, rule&.id.to_s.empty? ? id : rule.id.to_s)
  card = {
    id: (rule&.id || declared&.dig("id")).to_s,
    declared: declared,
    detector: rule ? rule.class.name || "anonymous scan rule" : nil,
    severity: rule&.severity&.to_s || declared&.dig("severity"),
    description: rule.respond_to?(:description) ? rule.description : nil,
    defined_at: where && "#{where[:path]}:#{where[:line]}",
    definition: where && where[:body],
  }

  unless as_json
    lines = []
    reach = if card[:detector]
              nil
            elsif card[:defined_at].to_s.start_with?("MASTER/law/")
              "no scan-registry rule, enforced from law/"
            else
              "declared only, no detector; resolves through a fold or prompt"
            end
    lines << "law #{card[:id]}, #{reach}" if reach
    lines << "law #{card[:id]}" unless reach
    if declared
      %w[name source tier severity autofix fix detect detect_semantic detect_structural].each do |key|
        lines << "#{key}, #{declared[key]}" if declared[key]
      end
    end
    if executable_law
      surfaces = [("detector" if executable_law.detect), ("semantic" if executable_law.ask), ("practice" if executable_law.practice)].compact
      lines << "enforcement, #{surfaces.join(", ")}" unless surfaces.empty?
      lines << "mode, #{executable_law.mode}" if executable_law.mode
      lines << "fix, #{executable_law.fix}" if !declared || declared["fix"].nil?
    end
    lines << "detector, #{card[:detector]}" if card[:detector]
    if card[:definition]
      lines << "defined at #{card[:defined_at]}, fixtures and exemption follow"
      card[:definition].each_line { |line| lines << line.chomp.strip }
    else
      lines << "no definition found under law/ or lib/review/scan/laws/"
    end
    Master::Trace::Dmesg::Report.print("laws", lines.join("\n"))
  end

  if card_only
    puts JSON.pretty_generate(card) if as_json
    exit 0
  end

  die("laws", "#{card[:id]} has no executable detector, nothing to run") unless rule

  one = Master::Fix::Scanner.new(laws: [rule])
  default = corpus.casecmp?("all") ? ROOT : master_root
  targets = ARGV.empty? ? [default] : ARGV.map { |path| File.expand_path(path, ROOT) }
  hits = one.findings(targets)
  rows = hits.map do |item|
    { path: item[:path].to_s.sub(%r{\A#{Regexp.escape(ROOT)}/}, ""), line: item[:line],
      rule: item[:rule].to_s, message: item[:message].to_s }
  end
  if as_json
    puts JSON.pretty_generate(card.merge(corpus: corpus, findings: rows))
  else
    Master::Trace::Dmesg.attach("laws0", "operator0", "#{rule.id}, #{rows.size} finding(s) over #{corpus}")
    rows.each { |row| Master::Trace::Dmesg.status("laws0", "#{row[:path]}:#{row[:line]}, #{row[:rule]}, #{row[:message]}") }
  end
  exit(rows.empty? ? 0 : 1)
when "readers"
  # Before you believe "its only reader is X". That sentence has been wrong four
  # times in this repo and each time the grep behind it could not see the
  # reference that mattered — most expensively hash_dig_compat.rb, whose second
  # reader was in another tree, built its path with File.expand_path, left the
  # extension off, and sat inside a `rescue LoadError` so the breakage warned
  # instead of raising and dilla rendered without coltrane for days.
  require "operator/readers"
  target = ARGV.shift
  die("readers", "usage, bin/operator readers <path>", 64) if target.to_s.empty?

  hits = Operator::Readers.find(root: ROOT, target: target)
  if hits.empty?
    Master::Trace::Dmesg.status("readers0", "no reference to #{target} anywhere in #{Operator::Readers::TREES.join(", ")}")
    Master::Trace::Dmesg.status("readers0", "deleting it is a reader-count question")
    exit 0
  end

  by_kind = hits.group_by(&:kind)
  # Ordered by how load-bearing the reference is, not alphabetically: a require
  # breaks on delete, a mention is usually a comment.
  %i[require path_build render test constant mention].each do |kind|
    rows = by_kind[kind] or next
    label = { require: "require", path_build: "path built at runtime", render: "rendered by name", test: "asserted by a test",
              constant: "constant (Zeitwerk or direct)", mention: "mentioned" }.fetch(kind)
    Master::Trace::Dmesg.attach("reader#{kind}", "readers0", "#{label}, #{rows.length}")
    rows.first(40).each { |r| Master::Trace::Dmesg.status("reader#{kind}", "#{r.path}:#{r.line}, #{r.text[0, 120]}") }
    Master::Trace::Dmesg.status("reader#{kind}", "#{rows.length - 40} more") if rows.length > 40
  end
  # A constant reference is a Zeitwerk load and breaks exactly like a require;
  # prose mentions were reclassified before they got here.
  hard = (by_kind[:require].to_a + by_kind[:path_build].to_a + by_kind[:render].to_a +
          by_kind[:test].to_a + by_kind[:constant].to_a).length
  Master::Trace::Dmesg.status("readers0", "#{hard} references would break on delete or move")
  exit(hard.zero? ? 0 : 1)

when "hooks"
  # core.hooksPath rather than copying into .git/hooks: a copy is a second
  # implementation that drifts from the tracked one, silently, which is the
  # defect this repo has the most of.
  hooks = File.join(OPENBSD_OPS, "dev", "githooks")
  system("git", "-C", ROOT, "config", "core.hooksPath", "OPENBSD/dev/githooks") ||
    die("hooks", "git config failed")
  Master::Trace::Dmesg.attach("hooks0", "operator0", "core.hooksPath -> OPENBSD/dev/githooks")
  Dir.children(hooks).sort.each { |hook| Master::Trace::Dmesg.status("hooks0", "#{hook}#{File.executable?(File.join(hooks, hook)) ? "" : ", not executable"}") }
  Master::Trace::Dmesg.status("hooks0", "cross-tree commits refused unless PUB4_CROSS_TREE=1")
  Master::Trace::Dmesg.status("hooks0", "post-commit records this session SHAs")
  Master::Trace::Dmesg.status("hooks0", "PUB4_SESSION keys that ledger explicitly; without it the shell is the key")
when "test"
  # The smallest COMPLETE proof for the paths given (dirty files when none
  # are). Complete means whole suites — a green over hand-picked tests is
  # unmeasured. The mapping that lived in CLAUDE.md prose and session
  # memory, made executable:
  #   MASTER/**        -> MASTER rake test (+ dogfood when law/ moved)
  #   RAILS/__shared/**  -> all three app suites (shared lands in three apps)
  #   RAILS/<app>/**   -> that app suite
  #   RAILS/test       -> the standalone contract suite
  #   OPENBSD/**       -> its local minitests (box-side proof stays on vm23)
  #   MASTER/tools/**        -> MASTER tool suite
  paths = ARGV.dup
  if paths.empty?
    listing, status = Master::Io::Exec.capture2("git", "status", "--porcelain", "-z", chdir: ROOT)
    die("test", "git status failed", 1) unless status.success?
    paths = listing.split("\0").filter_map { |l| l[3..] }
  end
  trees = paths.map { |p| p.split("/").first(2) }
  # MASTER/tools is part of MASTER, but it has its own complete suite so tool
  # regressions cannot hide behind the core MASTER tests.
  tool_paths = paths.select { |path| path.start_with?("MASTER/tools/") }

  jobs = []
  rails_parts = trees.select { |t| t.first == "RAILS" }.map(&:last).uniq
  if trees.any? { |t| t.first == "MASTER" }
    jobs << ["MASTER suite", %w[bundle exec rake test], File.join(ROOT, "MASTER"), {}]
    if tool_paths.any?
      jobs << ["MASTER tools suite", [BUNDLE, "exec", RUBY, "-S", "rake"], File.join(ROOT, "MASTER", "tools"), {}]
    end
    if paths.any? { |p| p.start_with?("MASTER/law/") }
      jobs << ["MASTER dogfood", %w[bundle exec rake dogfood], File.join(ROOT, "MASTER"), {}]
    end
  end
  app_suites = rails_parts.include?("shared") ? %w[brgen amber bsdports] : (rails_parts & %w[brgen amber bsdports])
  app_suites.each do |app|
    jobs << ["#{app} suite", [BUNDLE, "exec", RUBY, "bin/rails", "test"],
             File.join(ROOT, "RAILS", app), {}]
  end
  if rails_parts.any? { |part| %w[gates test].include?(part) } || !app_suites.empty?
    jobs << ["RAILS contracts", [RUBY, "test/run_all.rb"], File.join(ROOT, "RAILS"), {}]
  end
  if trees.any? { |t| t.first == "OPENBSD" }
    runner = 'Dir["test/test_*.rb"].sort.each { |f| system(RbConfig.ruby, f) || abort(f) }'
    jobs << ["OPENBSD minitests", ["ruby", "-e", runner], File.join(ROOT, "OPENBSD"), {}]
  end
  if jobs.empty?
    die("test", "no suite maps to #{paths.first(3).join(", ")}", 64)
  end

  # Say what was chosen before running it, so a surprising suite is visible
  # up front rather than after a long run.
  Master::Trace::Dmesg.attach("test0", "master0", "#{paths.size} paths, #{jobs.map(&:first).uniq.join(", ")}")
  failed = jobs.reject do |name, cmd, dir, env|
    Master::Trace::Dmesg.attach("test#{jobs.index([name, cmd, dir, env]) || 0}", "test0", name)
    system(env, *cmd, chdir: dir)
  end
  failed.each { |name, *| Master::Trace::Dmesg.status("test0", "failed, #{name}") }
  exit(failed.empty? ? 0 : 1)
when "vps"
  sub = ARGV.shift
  case sub
  when "master"
    action = ARGV.shift.to_s
    remote = !ARGV.delete("--remote").nil?
    die("vps", "usage, bin/operator vps master <status|start|stop|restart> [--remote]", 64) unless %w[status start stop restart].include?(action) && ARGV.empty?
    script = <<~ZSH
      set -e
      cd /home/dev/pub4
      case #{Shellwords.escape(action)} in
      status)
        sessions="$(screen -ls 2>/dev/null || true)"
        if [[ "$sessions" == *".master"* ]]; then
          print "master0: screen master active"
          screen -S master -Q select . 2>&1 || true
        else
          print "master0: screen master stopped"
        fi
        MASTER/bin/ruby -I MASTER/lib -e 'require "master"; p=Master::Ops::ProcessLock.owner(File.join(Master::ROOT, ".master", "process.lock")); puts(p.empty? ? "master0: process lock free" : "master0: process #{p["pid"]} on #{p["host"]}, mode #{p["mode"]}")'
        ;;
      stop)
        screen -S master -X quit 2>/dev/null || true
        print "master0: screen master stopped"
        ;;
      start)
        sessions="$(screen -ls 2>/dev/null || true)"
        if [[ "$sessions" == *".master"* ]]; then
          print "master0: screen master already active"
        else
          screen -dmS master zsh -lc 'cd /home/dev/pub4; exec MASTER/bin/master --daemon'
          print "master0: screen master started"
        fi
        ;;
      restart)
        screen -S master -X quit 2>/dev/null || true
        sleep 1
        screen -dmS master zsh -lc 'cd /home/dev/pub4; exec MASTER/bin/master --daemon'
        print "master0: screen master restarted"
        ;;
      esac
    ZSH
    if remote
      ssh_run(Shellwords.join(["zsh", "-fc", script]))
    else
      exec("zsh", "-fc", script)
    end
  when "state"
    if ARGV.delete("--remote")
      ssh_run(remote_ruby("OPENBSD/bin/vps-state", *ARGV))
    else
      exec(File.join(OPENBSD_OPS, "bin", "vps-state"), *ARGV)
    end
  when "deploy"
    app = ARGV.shift
    die("vps", usage.lines.first.to_s.strip, 64) if app.to_s.empty?
    if ARGV.delete("--remote")
      ssh_run("cd /home/dev/pub4 && #{Shellwords.join(["zsh", "OPENBSD/bin/vps-deploy", app])}")
    else
      exec(File.join(OPENBSD_OPS, "bin", "vps-deploy"), app, *ARGV)
    end
  when "admin"
    remote = !ARGV.delete("--remote").nil?
    args = ARGV.dup
    die("vps", "usage, bin/operator vps admin <status|services|service|pf|disk|memory|swap|dmesg|packages|updates|upgrade|reboot> [args] [--remote]", 64) if args.empty?
    if remote
      ssh_run(remote_ruby("OPENBSD/bin/vps_admin.rb", *args))
    else
      exec(File.join(OPENBSD_OPS, "bin", "vps_admin.rb"), *args)
    end
  when "logs"
    app = ARGV.shift
    abort(usage) if app.to_s.empty?
    if ARGV.delete("--remote")
      ssh_run(remote_ruby("OPENBSD/bin/vps-logs", app, *ARGV))
    else
      exec(File.join(OPENBSD_OPS, "bin", "vps-logs"), app, *ARGV)
    end
  else
    Master::Trace::Dmesg::Report.print("/help", usage, io: $stderr)
    exit 2
  end
when "pushed?"
  # Cherry-picking onto a moving origin/main rewrites SHAs, so "is my work
  # pushed?" cannot be answered by commit id. Content vs origin/main can.
  paths = ARGV
  die("pushed", "usage, bin/operator pushed? <path>...", 64) if paths.empty?

  failed = false
  paths.each do |path|
    porcelain, = Master::Io::Exec.capture2e("git", "-C", ROOT, "status", "--porcelain", "--", path)
    unless porcelain.strip.empty?
      Master::Trace::Dmesg.status("pushed0", "dirty, #{path}")
      failed = true
      next
    end
    ahead, = Master::Io::Exec.capture2e("git", "-C", ROOT, "log", "--oneline", "origin/main..HEAD", "--", path)
    if ahead.strip.empty?
      Master::Trace::Dmesg.status("pushed0", "pushed, #{path}")
    else
      Master::Trace::Dmesg.attach("pushed0", "master0", "unpushed, #{path}")
      ahead.each_line { |line| Master::Trace::Dmesg.status("pushed0", line.chomp) }
      failed = true
    end
  end
  exit(failed ? 1 : 0)
else
  Master::Trace::Dmesg::Report.print("/help", usage, io: $stderr)
  exit 2
end
