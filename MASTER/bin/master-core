#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "rbconfig"

# The fold spine only. bin/master boots the full runtime (soul, scan, voice).
# This drives lib/core.rb with a scripted model unless --real.
#
# The scripted run is a check of the constitution, not a completed goal. It
# execs three commands that label themselves as evidence without being able to
# produce any, then declares done. Core::Proof scores evidence only from a
# command that can produce it, so `done` must be refused: exit 0 says the fold
# held, and exit 1 says it admitted done on self-graded evidence. With --real,
# exit 0 means the model's goal completed.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"

class NullModel
  def initialize(goal)
    @goal = goal
    @script = [
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :test_pass),
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :scan_clean),
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :code_review),
      Master::Core::Effect.done("noop complete: #{@goal}"),
    ]
  end

  def turns = @script.size

  def propose(_context, verbs:)
    unsupported = @script.map(&:verb).uniq - verbs
    raise "kernel verbs unavailable: #{unsupported.join(", ")}" unless unsupported.empty?

    @script.shift || Master::Core::Effect.done("noop complete: #{@goal}")
  end
end

options = { root: Dir.pwd, max_turns: 40, real: false, model: nil }

parser = OptionParser.new do |opts|
  opts.banner = "usage: master-core [--root PATH] [--max-turns N] [--real [--model ID]] GOAL"
  opts.on("--root PATH") { |path| options[:root] = path }
  opts.on("--max-turns N", Integer) { |n| options[:max_turns] = n }
  opts.on("--real", "drive a live LLM (needs a provider key); default is the scripted constitution check") { options[:real] = true }
  opts.on("--model ID") { |id| options[:model] = id }
end

parser.parse!(ARGV)
goal = ARGV.join(" ").strip

if goal.empty?
  warn parser.to_s
  exit 64
end

root = File.expand_path(options.fetch(:root))
data_dir = File.join(File.expand_path("..", __dir__), "data")
constitution = Master::Core::Constitution.load(data_dir:)
world = Master::Core::World.new(root:)
memory = Master::Core::Memory.new
model = options[:real] ? Master::Core::Model.new(**{ model_id: options[:model] }.compact) : NullModel.new(goal)
refusals = []
observer = lambda do |turn:, effect:, observation:|
  refusals << observation.detail if effect.done? && !observation.ok?
end

result = Master::Core::Fold.new(
  model:,
  constitution:,
  world:,
  memory:,
  max_turns: options[:real] ? options.fetch(:max_turns) : model.turns,
  observer:,
).run(goal)

if options[:real]
  puts "master-core: #{result.reason} turns=#{result.turns} summary=#{result.summary}"
  exit(result.reason == :complete ? 0 : 1)
end

if result.reason != :complete && refusals.any? { |detail| detail.include?("evidence_for_done") }
  puts "master-core: held — done refused without passing evidence (#{refusals.last})"
  exit 0
end

puts "master-core: #{result.reason} — the scripted done was not refused for want of evidence"
exit 1
