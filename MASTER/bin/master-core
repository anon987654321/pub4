#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "rbconfig"

# The fold spine only. bin/master boots the full runtime (soul, scan, voice).
# This drives lib/core.rb with a scripted no-op model unless --real.
#
# Was `unshift "../core"` + `require "master"`, which resolved to core/master.rb
# purely by load-path order — two files named master.rb, one process, and the
# winner decided by whichever directory came first. The fold spine is lib/core.rb
# since 2026-08-12, so this is now the ordinary fold entrypoint.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "master"

class NullModel
  def initialize(goal)
    @goal = goal
    @script = [
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :test_pass),
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :scan_clean),
      Master::Core::Effect.exec([RbConfig.ruby, "-e", "exit 0"], evidence: :code_review),
      Master::Core::Effect.done("noop complete: #{@goal}"),
    ]
  end

  def propose(_context, verbs:)
    unsupported = @script.map(&:verb).uniq - verbs
    raise "kernel verbs unavailable: #{unsupported.join(", ")}" unless unsupported.empty?

    @script.shift || Master::Core::Effect.done("noop complete: #{@goal}")
  end
end

options = { root: Dir.pwd, max_turns: 40, real: false, model: nil }

parser = OptionParser.new do |opts|
  opts.banner = "usage: master-core [--root PATH] [--max-turns N] [--real [--model ID]] GOAL"
  opts.on("--root PATH") { |path| options[:root] = path }
  opts.on("--max-turns N", Integer) { |n| options[:max_turns] = n }
  opts.on("--real", "drive a live LLM (needs a provider key); default is the scripted no-op") { options[:real] = true }
  opts.on("--model ID") { |id| options[:model] = id }
end

parser.parse!(ARGV)
goal = ARGV.join(" ").strip

if goal.empty?
  warn parser.to_s
  exit 64
end

root = File.expand_path(options.fetch(:root))
data_dir = File.join(File.expand_path("..", __dir__), "data")
constitution = Master::Core::Constitution.load(data_dir:)
world = Master::Core::World.new(root:)
memory = Master::Core::Memory.new
model = options[:real] ? Master::Core::Model.new(**{ model_id: options[:model] }.compact) : NullModel.new(goal)

result = Master::Core::Fold.new(
  model:,
  constitution:,
  world:,
  memory:,
  max_turns: options.fetch(:max_turns)
).run(goal)

puts "master-core: #{result.reason} turns=#{result.turns} summary=#{result.summary}"
