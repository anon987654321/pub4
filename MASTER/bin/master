#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

# Repo-wide instruction surface for the MASTER runtime.
#
#   bin/master                          interactive session
#   bin/master "tighten brgen's feed"   one instruction, then interactive
#   bin/master --daemon                 persistent vm23 control plane
#   bin/master --fold "<goal>"          route the goal through the core Fold and exit
#   echo /status | bin/master           pipe mode
#
# MASTER already accepts free-text instructions, but only from inside MASTER/ —
# it boots with `root: Dir.pwd` and its siblings are reached relatively
# (MASTER/bin/gate reads ../RAILS and ../OPENBSD). Run it from the repo root and
# it looks for ./data and finds nothing. So this wrapper does the one thing that
# was missing: chdir into MASTER so the constitution and the sibling trees both
# resolve, then hand the instruction over unchanged.
#
# Everything past this point is MASTER's: data/soul.yml and data/rules.yml
# govern the session, and every durable write is validated against them. This
# wrapper parses only --help and --fix-context; all other arguments belong to
# MASTER/bin/cli.
#
# Two surfaces at the repo root and no third: bin/operator is the operator surface
# (status, vps state/deploy/logs, post-pull) and this is the instruction
# surface.

# Two levels: this lives in MASTER/bin/, and every sibling tree is reached
# from the repo root above it.
ROOT = File.expand_path("../..", __dir__)
MASTER = File.join(ROOT, "MASTER")
CLI = File.join(MASTER, "bin", "cli")

unless File.executable?(CLI) || File.file?(CLI)
  warn "master: #{CLI} is missing — is this a full pub4 checkout?"
  exit 1
end

if ARGV.first == "--fix-context"
  target = ARGV[1] && !ARGV[1].start_with?("-") ? ARGV[1] : ROOT
  full = ARGV.include?("--full")
  exec(File.join(MASTER, "bin", "ruby"), File.join(MASTER, "tools", "agent_context.rb"), "--fix-context", target, *(["--full"] if full))
end

if ARGV.first == "--help" || ARGV.first == "-h"
  puts <<~HELP
    master — instruct the MASTER runtime with the whole repo in scope

    Usage:
      bin/master                        interactive session
      bin/master "<instruction>"        run one instruction, then interactive
      bin/master --fold "<goal>"        route one coding goal through the core Fold
      bin/master --fix-context [target] emit the canonical /fix context for external LLMs
      bin/master --fix-context [target] --full
      bin/master --daemon               persistent vm23 control plane
      bin/master --fast                  skip optional boot services; one command, then exit
      echo '/status' | bin/master        pipe mode

    vm23 control plane:
      screen -S master
      cd /home/dev/pub4
      bin/master --daemon
      # detach: Ctrl-A D
      screen -r master

    --daemon keeps this interactive MASTER process alive and adds the control
    plane: main is fast-forward synced both ways with origin/main and accepted
    commits are deployed with OPENBSD/bin/vps-deploy all. Only one MASTER
    process may run at a time.

    Slash commands (/review, /status, /commit, /help, …) work as they do
    in MASTER/bin/cli — this is the same runtime, booted from MASTER/ so that
    data/soul.yml and the sibling RAILS, OPENBSD and MASTER/tools trees all resolve.

    Repo operator surface (unchanged): bin/operator status | vps | post-pull
    Gate chain over the whole tree:    bin/operator gate
  HELP
  exit 0
end

# Let MASTER's own tooling find the checkout without recomputing it from a
# Rails root, which Operator::DeployPaths exists to stop callers doing.
ENV["PUB4_ROOT"] ||= ROOT

# The vm23 control plane is the one long-lived MASTER process. The lock file is
# deliberately never deleted; flock(2) releases it on normal exit, crash, or
# SSH loss, and the next process can acquire it without stale-pid cleanup.
daemon = ARGV.delete("--daemon")
ENV["MASTER_CONTROL_PLANE"] = "1" if daemon
require_relative "../lib/master"
$MASTER_PROCESS_LOCK = Master::Ops::ProcessLock.acquire!(
  root: MASTER, mode: daemon ? "control_plane" : "interactive"
)
unless $MASTER_PROCESS_LOCK
  owner = Master::Ops::ProcessLock.owner(File.join(MASTER, ".master", "process.lock"))
  detail = owner.empty? ? "" : " pid=#{owner["pid"]} host=#{owner["host"]} mode=#{owner["mode"]}"
  warn "master0: another MASTER process owns the control plane#{detail}"
  exit 75
end

# A bare instruction is what a person types; -m is what bin/cli parses. Passing
# it through as -m keeps quoting behaviour identical whether the instruction has
# spaces, slashes or neither, and leaves every flag bin/cli owns untouched.
args = ARGV.dup
if args.length == 1 && !args.first.start_with?("-")
  args = ["-m", args.first]
end

# bin/ruby resolves pub4's preferred interpreter (ruby40 on OpenBSD, rbenv on
# the Mac). Inheriting whatever `env ruby` happened to pick is how the local
# boot broke before .ruby-version was pinned, and MASTER needs ~> 3.4.
Dir.chdir(MASTER)
exec(File.join(MASTER, "bin", "ruby"), CLI, *args)
