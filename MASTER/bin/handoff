#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "socket"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
DEPLOY_TODO = File.join(REPO, "DEPLOY", "TODO.md")
MASTER_TODO = File.join(ROOT, "TODO.md")

def capture(*cmd, chdir: REPO)
  out, status = Open3.capture2e(*cmd, chdir:)
  status.success? ? out.strip : nil
end

def unchecked_todos(path)
  return [] unless File.file?(path)

  File.readlines(path, chomp: true).filter_map do |line|
    next unless line.match?(/^\s*-\s+\[\s\]/)

    line.sub(/^\s*-\s+\[\s\]\s+/, "").strip
  end
end

def port_open?(port)
  socket = Socket.tcp("127.0.0.1", port, connect_timeout: 0.2)
  socket.close
  true
rescue StandardError
  false
end

def probe_status(label, env_key)
  if ENV[env_key] == "1"
    "#{label}: required"
  elsif ENV["PROBE_REQUIRE_BROWSER"] == "1" && env_key == "PROBE_REQUIRE_BROWSER"
    "#{label}: required (PROBE_REQUIRE_BROWSER=1)"
  else
    "#{label}: optional (set #{env_key}=1 to require)"
  end
end

branch = capture("git", "branch", "--show-current") || "unknown"
commit = capture("git", "rev-parse", "--short", "HEAD") || "unknown"
dirty = capture("git", "status", "--porcelain")&.lines&.count.to_i
behind = capture("git", "rev-list", "--count", "HEAD..@{u}") || "0"

puts "handoff: pub4 agent state"
puts "repo: #{REPO}"
puts "branch: #{branch} @ #{commit} (#{dirty} dirty, #{behind} behind upstream)"
puts

master_open = unchecked_todos(MASTER_TODO)
deploy_open = unchecked_todos(DEPLOY_TODO)
puts "MASTER/TODO.md open: #{master_open.size}"
master_open.first(8).each { |item| puts "  - #{item}" }
puts "  …" if master_open.size > 8
puts
puts "DEPLOY/TODO.md open: #{deploy_open.size}"
deploy_open.first(8).each { |item| puts "  - #{item}" }
puts "  …" if deploy_open.size > 8
puts

puts "golden checks (last commands to rerun):"
puts "  cd MASTER && bin/check"
puts "  cd MASTER && bin/check-agent"
puts "  cd MASTER && bin/check-web"
puts "  DEPLOY/bin/check-rails"
puts "  ruby DEPLOY/integrity_gate.rb"
puts "  cd MASTER && bundle exec ruby bin/cli /scan DEPLOY/rails/<app>"
puts

ports = {
  "MASTER web" => Integer(ENV.fetch("MASTER_WEB_PORT", "53187")),
  "brgen" => 38_182,
  "amber" => 61_352,
  "bsdports" => 47_312,
  "hjerterom" => 38_891,
}
puts "dev ports:"
ports.each do |name, port|
  state = port_open?(port) ? "listening" : "closed"
  puts "  #{name.ljust(12)} #{port} (#{state})"
end
puts

puts "browser/audio probes:"
puts "  #{probe_status('WebGL/tap probe', 'PROBE_REQUIRE_BROWSER')}"
puts "  #{probe_status('Live web tests', 'MASTER_CI_WEB')}"
puts "  TTS: edge-tts or espeak on PATH (#{capture('which', 'edge-tts') || capture('which', 'espeak') || 'not found'})"