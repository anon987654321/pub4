#!/usr/bin/env sh
# Resolve pub4's exact pinned Ruby where rbenv is available; never silently downgrade
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
PINNED_VERSION=""

if [ -f "$ROOT/.ruby-version" ]; then
  PINNED_VERSION="$(cat "$ROOT/.ruby-version")"
fi

install_system_runtime() {
  case "$(uname -s 2>/dev/null || true)" in
    OpenBSD)
      if command -v pkg_add >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
          pkg_add -I "ruby%${PINNED_VERSION%.*}" || true
        elif command -v doas >/dev/null 2>&1; then
          doas -n pkg_add -I "ruby%${PINNED_VERSION%.*}" || true
        elif command -v sudo >/dev/null 2>&1; then
          sudo -n pkg_add -I "ruby%${PINNED_VERSION%%.*}" || true
        fi
      fi
      ;;
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        brew install rbenv ruby-build || true
      fi
      ;;
    Linux)
      if [ -n "${PREFIX:-}" ] && command -v pkg >/dev/null 2>&1; then
        pkg install -y ruby || true
      elif command -v apt-get >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
          apt-get update && apt-get install -y rbenv ruby-build || true
        elif command -v sudo >/dev/null 2>&1; then
          sudo -n apt-get update && sudo -n apt-get install -y rbenv ruby-build || true
        fi
      elif command -v brew >/dev/null 2>&1; then
        brew install rbenv ruby-build || true
      fi
      ;;
  esac
}

find_rbenv() {
  RBENV="${RBENV:-}"
  if [ -n "$RBENV" ] && [ -x "$RBENV" ]; then
    printf '%s
' "$RBENV"
    return
  fi

  RBENV="$(command -v rbenv 2>/dev/null || true)"
  if [ -n "$RBENV" ] && [ -x "$RBENV" ]; then
    printf '%s
' "$RBENV"
    return
  fi

  if [ -x "$RBENV_ROOT/bin/rbenv" ]; then
    printf '%s
' "$RBENV_ROOT/bin/rbenv"
  fi
}

rbenv_path() {
  RBENV="$1"
  direct="$RBENV_ROOT/versions/$PINNED_VERSION/bin/ruby"
  if [ -x "$direct" ]; then
    printf '%s
' "$direct"
    return
  fi

  [ -n "$PINNED_VERSION" ] || return
  output="$(RBENV_VERSION="$PINNED_VERSION" "$RBENV" which ruby 2>/dev/null || true)"
  if [ -n "$output" ] && [ -x "$output" ]; then
    printf '%s
' "$output"
  fi
}

install_pinned_ruby() {
  RBENV="$1"
  [ -n "$PINNED_VERSION" ] || return 1
  [ "${MASTER_AUTO_INSTALL_RUBY:-1}" = "0" ] && return 1

  if ! "$RBENV" install -s "$PINNED_VERSION"; then
    return 1
  fi

  rbenv_path "$RBENV"
}

RUBY=""
RBENV="$(find_rbenv || true)"

if [ -n "$RBENV" ]; then
  RUBY="$(rbenv_path "$RBENV" || true)"
  if [ -z "$RUBY" ]; then
    RUBY="$(install_pinned_ruby "$RBENV" || true)"
  fi
fi

RUBY="${RUBY:-$(command -v ruby 2>/dev/null || true)}"
if [ -z "$RUBY" ]; then
  install_system_runtime
  RBENV="$(find_rbenv || true)"
  if [ -n "$RBENV" ]; then
    RUBY="$(rbenv_path "$RBENV" || true)"
    if [ -z "$RUBY" ]; then
      RUBY="$(install_pinned_ruby "$RBENV" || true)"
    fi
  fi
  RUBY="${RUBY:-$(command -v ruby 2>/dev/null || true)}"
fi
if [ -z "${RUBY:-}" ]; then
  printf '%s
' "pub4: no Ruby executable found; .ruby-version requires $PINNED_VERSION" >&2
  exit 1
fi

ACTUAL="$("$RUBY" -e 'print RUBY_VERSION')"
if [ "$ACTUAL" != "$PINNED_VERSION" ]; then
  if [ "${MASTER_AUTO_INSTALL_RUBY:-1}" != "0" ]; then
    install_system_runtime
    RBENV="$(find_rbenv || true)"
    if [ -n "$RBENV" ]; then
      RUBY="$(rbenv_path "$RBENV" || true)"
      if [ -z "$RUBY" ]; then
        RUBY="$(install_pinned_ruby "$RBENV" || true)"
      fi
      if [ -n "$RUBY" ]; then
        ACTUAL="$("$RUBY" -e 'print RUBY_VERSION')"
      fi
    fi
  fi

  if [ "$ACTUAL" != "$PINNED_VERSION" ]; then
    printf '%s
' "pub4: Ruby $ACTUAL detected; .ruby-version requires $PINNED_VERSION" >&2
    if [ -n "$RBENV" ]; then
      printf '%s
' "pub4: run: RBENV_VERSION=$PINNED_VERSION $RBENV install -s $PINNED_VERSION" >&2
    else
      printf '%s
' "pub4: install rbenv + ruby-build, then run: rbenv install -s $PINNED_VERSION" >&2
    fi
    exit 1
  fi
fi

exec "$RUBY" "$@"
