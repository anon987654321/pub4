#!/usr/bin/env sh
# Resolve pub4's exact pinned Ruby where rbenv is available; never downgrade
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
PINNED_VERSION=""

if [ -f "$ROOT/.ruby-version" ]; then
  PINNED_VERSION="$(cat "$ROOT/.ruby-version")"
fi

if [ -n "$PINNED_VERSION" ] && [ -x "$RBENV_ROOT/versions/$PINNED_VERSION/bin/ruby" ]; then
  RUBY="$RBENV_ROOT/versions/$PINNED_VERSION/bin/ruby"
else
  RBENV="$(command -v rbenv 2>/dev/null || true)"
  if [ -z "$RBENV" ] && [ -x "$RBENV_ROOT/bin/rbenv" ]; then
    RBENV="$RBENV_ROOT/bin/rbenv"
  fi

  if [ -n "$RBENV" ] && [ -n "$PINNED_VERSION" ]; then
    RUBY="$(RBENV_VERSION="$PINNED_VERSION" "$RBENV" which ruby 2>/dev/null || true)"
  fi

fi

RUBY="${RUBY:-$(command -v ruby 2>/dev/null || true)}"
if [ -z "${RUBY:-}" ]; then
  printf '%s\n' "pub4: no Ruby executable found; .ruby-version requires $PINNED_VERSION" >&2
  exit 1
fi

ACTUAL="$("$RUBY" -e 'print RUBY_VERSION')"
if [ "$ACTUAL" != "$PINNED_VERSION" ]; then
  printf '%s\n' "pub4: Ruby $ACTUAL detected; .ruby-version requires $PINNED_VERSION" >&2
  exit 1
fi

exec "$RUBY" "$@"
