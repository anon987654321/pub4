#!/usr/bin/env sh
# Resolve pub4's exact pinned Ruby where rbenv is available; OpenBSD falls back
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ -f "$ROOT/.ruby-version" ] && command -v rbenv >/dev/null 2>&1; then
  RUBY="$(RBENV_VERSION="$(cat "$ROOT/.ruby-version")" rbenv which ruby 2>/dev/null || true)"
fi

if [ -z "${RUBY:-}" ] && command -v ruby34 >/dev/null 2>&1; then
  RUBY=ruby34
elif [ -z "${RUBY:-}" ] && command -v ruby3.4 >/dev/null 2>&1; then
  RUBY=ruby3.4
fi

RUBY="${RUBY:-ruby}"
exec "$RUBY" "$@"
