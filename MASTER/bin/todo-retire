#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "yaml"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
BACKLOG = File.join(REPO, "BACKLOG.yml")
LEGACY = [File.join(ROOT, "TODO.md"), File.join(REPO, "DEPLOY", "TODO.md")]

def run_step(name, *cmd, chdir:)
  print "todo-retire: #{name.ljust(20)} "
  $stdout.flush
  _out, status = Open3.capture2e(*cmd, chdir:)
  puts(status.success? ? "ok" : "fail")
  status.success?
end

open_items = []
if File.file?(BACKLOG)
  data = YAML.safe_load(File.read(BACKLOG)) || {}
  open_items = Array(data["open"])
end

legacy_open = LEGACY.any? do |path|
  File.file?(path) && File.readlines(path).any? { |line| line.match?(/^\s*-\s+\[\s\]/) }
end

if open_items.any? || legacy_open
  warn "todo-retire: blocked — open items remain in BACKLOG.yml or legacy TODO.md files"
  warn "todo-retire: run bin/handoff or bin/pub4 status"
  exit 1
end

checks = [
  ["MASTER check", File.join(ROOT, "bin", "check"), "--profile=contributor"],
  ["DEPLOY check-rails", File.join(REPO, "DEPLOY", "bin", "check-rails"), "--profile=contributor"],
  ["integrity gate", File.join(REPO, "DEPLOY", "integrity_gate.rb")],
]
failures = checks.reject { |name, cmd, *args| run_step(name, cmd, *args) }.map(&:first)

if failures.any?
  warn "todo-retire: golden checks failed: #{failures.join(', ')}"
  exit 1
end

unless ENV["TODO_RETIRE_CONFIRM"] == "1"
  puts "todo-retire: all checks passed; set TODO_RETIRE_CONFIRM=1 to delete legacy TODO.md files"
  exit 0
end

LEGACY.each { |path| File.delete(path) if File.file?(path) }
puts "todo-retire: deleted legacy MASTER/TODO.md and DEPLOY/TODO.md (BACKLOG.yml is canonical)"