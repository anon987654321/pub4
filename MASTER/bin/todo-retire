#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "yaml"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
DEBT = File.join(REPO, "OPENBSD", "data", "debt.yml")
# The TODO files this retires. Every name in the previous list —
# MASTER/TODO.md, OPENBSD/TODO.md, RAILS/TODO.md, MASTER/tools/dilla/TODO.md —
# referred to a file that does not exist and, from the git history, had not for
# some time. So `legacy_open` was `false` unconditionally, the guard passed
# having read nothing, and the delete step at the bottom deleted nothing. The two
# files that do carry open checkboxes were in neither list.
#
# Verify with `ruby -e 'puts Dir.glob("**/*TODO*.md")'` from the repo root before
# changing this, rather than trusting it.
LEGACY = [
  File.join(REPO, "TODO.md"),
  File.join(REPO, "RAILS", "FINAL_TODO.md"),
].freeze

def run_step(name, *cmd, chdir:)
  print "todo-retire: #{name.ljust(20)} "
  $stdout.flush
  _out, status = Open3.capture2e(*cmd, chdir:)
  puts(status.success? ? "ok" : "fail")
  status.success?
end

# The destination has to exist and parse before anything is deleted into it.
# It is NOT required to be empty: debt.yml is the canonical register these files
# retire *into*, so it is expected to carry open items indefinitely. The previous
# version blocked on `open_items.any?`, which made the precondition
# unsatisfiable — this script could never have completed a run, in any tree state.
unless File.file?(DEBT)
  warn "todo-retire: blocked — #{DEBT} is missing, and it is where these files retire to"
  exit 1
end

begin
  debt = YAML.safe_load(File.read(DEBT)) || {}
rescue Psych::SyntaxError => e
  warn "todo-retire: blocked — #{DEBT} does not parse (#{e.message})"
  exit 1
end

unless debt.key?("open")
  warn "todo-retire: blocked — #{DEBT} has no `open:` list to have retired anything into"
  exit 1
end

still_open = LEGACY.select do |path|
  File.file?(path) && File.readlines(path).any? { |line| line.match?(/^\s*-\s+\[\s\]/) }
end

if still_open.any?
  warn "todo-retire: blocked — unchecked items remain in:"
  still_open.each do |path|
    count = File.readlines(path).count { |line| line.match?(/^\s*-\s+\[\s\]/) }
    warn "  #{path.delete_prefix("#{REPO}/")}  (#{count} unchecked)"
  end
  warn "todo-retire: close them, or move them to OPENBSD/data/debt.yml and tick the box"
  exit 1
end

checks = [
  ["MASTER check", ROOT, [File.join(ROOT, "bin", "check"), "--profile=contributor"]],
  ["OPERATOR check-rails", REPO, [File.join(REPO, "OPENBSD", "bin", "check-rails"), "--profile=contributor"]],
  ["integrity gate", REPO, [File.join(REPO, "OPENBSD", "integrity_gate.rb")]],
]
failures = checks.reject { |name, dir, cmd| run_step(name, *cmd, chdir: dir) }.map(&:first)

if failures.any?
  warn "todo-retire: golden checks failed: #{failures.join(', ')}"
  exit 1
end

unless ENV["TODO_RETIRE_CONFIRM"] == "1"
  puts "todo-retire: all checks passed; set TODO_RETIRE_CONFIRM=1 to delete legacy TODO.md files"
  exit 0
end

LEGACY.each { |path| File.delete(path) if File.file?(path) }
puts "todo-retire: deleted legacy TODO.md files (OPENBSD/data/debt.yml is canonical)"
