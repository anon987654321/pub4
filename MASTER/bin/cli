#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
$stdout.set_encoding("UTF-8")
$stderr.set_encoding("UTF-8")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

if File.readable?("/etc/master.env")
  File.foreach("/etc/master.env") do |line|
    key, val = line.chomp.split("=", 2)
    ENV[key] ||= val if key && val
  end
end

unless ENV["MASTER_UNSAFE_PROCESS_DEFAULTS"] == "1"
  ENV["MASTER_SAFE_MODE"] ||= "1"
  ENV["MASTER_BACKGROUND"] ||= "0"
  ENV["MASTER_AUTOFIX"] ||= "0"
  ENV["MASTER_WATCH"] ||= "0"
  ENV["MASTER_WATCHER"] ||= "0"
  ENV["MASTER_HEARTBEAT"] ||= "0"
  ENV["MASTER_DRIFT"] ||= "0"
end

require "optparse"
require "set"
require "master"
require "ops/loop_slot"
require "ops/process_budget"
require "ops/runtime_loop_guards"
Master::Ops::LoopSlot.validate!
Master::Ops::ProcessBudget.validate_loop_slot!
Master::Ops::RuntimeLoopGuards.install!

options = { version: false, config: false, quiet: false, message: nil }
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/cli [options] [message]"
  opts.on("--version", "print git SHA + build date") { options[:version] = true }
  opts.on("--config", "show effective config") { options[:config] = true }
  opts.on("--quiet", "suppress non-essential output") { options[:quiet] = true }
end
parser.parse!
options[:message] = ARGV.join(" ").strip unless ARGV.empty?

if options[:version]
  rev = `git -C #{Master::ROOT} rev-parse --short HEAD 2>/dev/null`.strip
  rev = "unknown" if rev.empty?
  puts "master #{rev} #{Time.now.utc.strftime("%Y-%m-%d")}"
  exit 0
end

cli = nil

trap("INT")  { cli&.container&.dig(:session)&.save! rescue nil; $stderr.puts "\nsaved\n"; exit 0 }
trap("TERM") { cli&.container&.dig(:session)&.save! rescue nil; exit 0 }

Master::Now::BootBanner.print
cli = Master.boot(root: Dir.pwd)
Master::Ops::RuntimeLoopGuards.install!

if options[:config]
  cfg = cli.container[:config]
  puts "model=#{cfg['model']} persona=#{cfg.persona} reasoning=#{cfg.reasoning_mode}"
  puts "safe=#{ENV.fetch('MASTER_SAFE_MODE', '1')} web=#{ENV.fetch('MASTER_WEB', '0')}"
  exit 0
end

ENV["MASTER_QUIET"] = "1" if options[:quiet]

if $stdin.tty?
  Master::Now::WebServer.start(config: cli.container[:config])
  cli.run(options[:message].empty? ? nil : options[:message])
else
  $stdout.sync = true
  $stdin.each_line { |line| cli.pipe(line) }
end