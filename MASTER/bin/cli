#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
ENV["MASTER_STRICT_BOOT"] = "0" if ARGV.first.to_s.strip.start_with?("/fix") && !ENV.key?("MASTER_STRICT_BOOT")
$stdout.set_encoding("UTF-8")
$stderr.set_encoding("UTF-8")
# Always unbuffered so tee/logs capture progress before EOF (scan can run minutes).
$stdout.sync = true
$stderr.sync = true

pinned_ruby = File.expand_path("../.ruby-version", __dir__)
if File.file?(pinned_ruby)
  expected_ruby = File.read(pinned_ruby).strip
  if !expected_ruby.empty? && RUBY_VERSION != expected_ruby && ENV["MASTER_ALLOW_UNPINNED_RUBY"] != "1"
    ruby_wrapper = File.expand_path("../bin/ruby", __dir__)
    if File.executable?(ruby_wrapper)
      reexec = -> { exec(ruby_wrapper, __FILE__, *ARGV) }
      defined?(Bundler) ? Bundler.with_unbundled_env(&reexec) : reexec.call
    end
    warn "cli: Ruby #{expected_ruby} required; running #{RUBY_VERSION} — use #{ruby_wrapper} bin/cli"
    exit 78
  end
end

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
# The tree is this file's parent, not Dir.pwd. bin/master exists to chdir
# here; a caller from the repo root must get the same runtime without it.
Dir.chdir(File.expand_path("..", __dir__))
require "ground/env_loader"
Master::Ground::EnvLoader.load!

if !$stdin.tty? && ENV["MASTER_FAST"] == "1"
  $stdin.each_line do |line|
    case line.strip
    when "/status"
      puts ["status", "mode    fast pipe", "service master/not-booted fast", "pipeline fast"].join("\n")
    when "/help", "/?"
      puts "help: /status /help commands available in fast pipe mode"
    else
      puts "fast mode: /status /help only"
    end
  end
  exit!(0)
end

require "optparse"
require "master"

def initial_message_from_argv(argv)
  options = parse_initial_message_options(argv)
  (options[:message] || argv.join(" ")).to_s.strip
rescue OptionParser::ParseError => e
  $stderr.puts "cli: #{e.message}"
  argv.reject { |arg| arg.start_with?("--") }.join(" ").strip
end

def parse_initial_message_options(argv)
  options = {}
  parser = OptionParser.new do |opts|
    opts.banner = "Usage: bin/cli [-p PROMPT|-m MSG] [--continue [ID]|--session ID|--fork [ID]|--sessions] [--effort low|medium|high] [--headless] [--fast] [--web|--no-web] [--boot-status]"
    opts.on("-h", "--help") do
      puts opts
      puts ""
      puts "Pipe mode:  echo '/status' | bin/cli"
      puts "Fast mode:  bin/cli --fast   (skip optional boot services; one command, then exit)"
      puts "Headless:   bin/cli --headless -p PROMPT   (JSON mission receipt, non-interactive)"
      puts "Gates:      MASTER/bin/check --profile=contributor|agent|full"
      puts "VPS 1GB:    auto-skips TTS/boot-scan/web — scope a scan to a path, not the whole repo"
      exit 0
    end
    opts.on("-m", "--message TEXT") { |text| options[:message] = text }
    opts.on("-p", "--prompt TEXT") { |text| options[:message] = text }
    opts.on("--effort LEVEL", %w[low medium high]) { |level| ENV["MASTER_EFFORT"] = level }
    opts.on("--headless", "run one autonomous goal and emit one JSON mission receipt") do
      ENV["MASTER_HEADLESS"] = "1"
      ENV["MASTER_FOLD"] = "1"
      ENV["MASTER_FAST"] = "1"
      ENV["MASTER_SKIP_BOOT_SCAN"] = "1"
      ENV["MASTER_SKIP_TTS"] = "1"
      ENV["MASTER_WEB"] = "0"
    end
    opts.on("-c", "--continue [ID]") { |id| options[:message] = "/session continue #{id}".strip }
    opts.on("--resume [ID]") { |id| options[:message] = "/session continue #{id}".strip }
    opts.on("-s", "--session ID") { |id| options[:message] = "/session continue #{id}" }
    opts.on("--fork [ID]") { |id| options[:message] = "/session fork #{id}".strip }
    opts.on("--sessions") { options[:message] = "/session" }
    opts.on("--fold", "run the message through the core Fold, then exit") { ENV["MASTER_FOLD"] = "1" }
    opts.on("--web") { ENV["MASTER_WEB"] = "1" }
    opts.on("--no-web") { ENV["MASTER_WEB"] = "0" }
    opts.on("--boot-status") { ENV["MASTER_BOOT_STATUS"] = "1" }
    opts.on("--fast") do
      ENV["MASTER_FAST"] = "1"
      ENV["MASTER_SKIP_BOOT_SCAN"] = "1"
      ENV["MASTER_SKIP_TTS"] = "1"
      ENV["MASTER_WEB"] = "0"
    end
  end
  parser.parse!(argv)
  options
end

# Help is answered before the runtime boots. The parser that prints it runs
# after Master.boot everywhere else, and a full boot costs seconds and can
# raise before the usage text is ever reached.
initial_message_from_argv(ARGV.dup) if ARGV.include?("-h") || ARGV.include?("--help")

cli = nil

def save_cli_session_safely(cli)
  cli&.container&.dig(:session)&.save!
rescue StandardError => e
  warn "cli: session save failed: #{e.class}: #{e.message}"
end

def stop_cli_background_loop_safely(cli)
  cli&.send(:stop_background_loop)
rescue StandardError => e
  warn "cli: background stop failed: #{e.class}: #{e.message}"
end

trap("INT") { $stderr.puts "\nexiting"; exit!(130) }
trap("TERM") { exit!(143) }
trap("TSTP") do
  $stderr.puts "\ncli: suspended — fg then /exit; Ctrl-Z leaves ~200MB ruby on 1GB hosts"
  trap("TSTP", "DEFAULT")
  Process.kill("STOP", Process.pid)
end

fast_boot = ARGV.include?("--fast") || ENV["MASTER_FAST"] == "1"
require "ground/host_budget"
Master::Ground::HostBudget.warn_or_reap_suspended!
unless $stdin.tty?
  ENV["MASTER_PIPE"] = "1"
  ENV["MASTER_SKIP_BOOT_SCAN"] = "1"
  ENV["MASTER_SKIP_TTS"] = "1"
end
cli = Master.boot(root: Dir.pwd)
Master::Ops::RuntimeLoopGuards.install!

# --fold routes one coding goal through the core Fold, then exits. Plain-language
# agent turns and /run <goal> use the Fold; other slash commands dispatch directly.
if ENV["MASTER_FOLD"] == "1"
  goal = initial_message_from_argv(ARGV)
  container = cli.container
  result = Master::CLI::CoreBridge.run(
    goal, root: Dir.pwd, bus: container[:bus], model_id: container[:agent]&.model
  )
  if ENV["MASTER_HEADLESS"] == "1"
    puts JSON.generate(result.merge(status: result[:reason] == :complete ? "SUCCESS" : "INCONCLUSIVE"))
  else
    header = "core: #{result[:reason]} turns=#{result[:turns]}"
    puts [header, *result[:transcript], result[:summary]].compact.join("\n")
  end
  save_cli_session_safely(cli)
  exit!(result[:reason] == :complete ? 0 : 1)
end

if $stdin.tty?
  message = initial_message_from_argv(ARGV)
  message = "/status" if fast_boot && message.empty?
  if !fast_boot && Master::CLI::Face::Window.asked?(message.split)
    puts Master::CLI::CommandRegistry.dispatch_face
    stop_cli_background_loop_safely(cli)
    save_cli_session_safely(cli)
    exit!(0)
  end
  if fast_boot
    cli.pipe(message) unless message.empty?
    stop_cli_background_loop_safely(cli)
    save_cli_session_safely(cli)
    exit!(cli.exit_code || 0)
  else
    cli.run(message.empty? ? nil : message)
  end
else
  $stdout.sync = true
  # Pipe mode used to ignore ARGV, so `bin/cli /scan RAILS` with no TTY
  # printed nothing and exited 0. Honor the argument, then stdin.
  message = initial_message_from_argv(ARGV)
  cli.pipe(message) unless message.empty?
  $stdin.each_line { |line| cli.pipe(line) }
  stop_cli_background_loop_safely(cli)
  save_cli_session_safely(cli)
  $stdout.flush
  $stderr.flush
  exit!(cli.exit_code || 0)
end

exit(cli.exit_code || 0)
