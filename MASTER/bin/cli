#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
$stdout.set_encoding("UTF-8")
$stderr.set_encoding("UTF-8")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "ground/env_loader"
Master::Ground::EnvLoader.load!

# CPU incident containment: CLI boots safe-idle unless explicitly overridden.
# Active background loops require MASTER_UNSAFE_PROCESS_DEFAULTS=1 plus explicit env.
unless ENV["MASTER_UNSAFE_PROCESS_DEFAULTS"] == "1"
  ENV["MASTER_SAFE_MODE"] ||= "1"
  ENV["MASTER_BACKGROUND"] ||= "0"
  ENV["MASTER_AUTOFIX"] ||= "0"
  ENV["MASTER_WATCH"] ||= "0"
  ENV["MASTER_WATCHER"] ||= "0"
  ENV["MASTER_HEARTBEAT"] ||= "0"
  ENV["MASTER_DRIFT"] ||= "0"
end

require "set"
require "optparse"
require "master"
require "now/boot_banner"
require "now/web_server"
require "ops/loop_slot"
require "ops/process_budget"
require "ops/runtime_loop_guards"
Master::Ops::LoopSlot.validate!
Master::Ops::ProcessBudget.validate_loop_slot!
Master::Ops::RuntimeLoopGuards.install!

def initial_message_from_argv(argv)
  options = parse_initial_message_options(argv)
  (options[:message] || argv.join(" ")).to_s.strip
rescue OptionParser::ParseError => e
  $stderr.puts "cli: #{e.message}"
  argv.reject { |arg| arg.start_with?("--") }.join(" ").strip
end

def parse_initial_message_options(argv)
  options = {}
  parser = OptionParser.new do |opts|
    opts.on("-m", "--message TEXT") { |text| options[:message] = text }
    opts.on("--web") { ENV["MASTER_WEB"] = "1" }
    opts.on("--no-web") { ENV["MASTER_WEB"] = "0" }
    opts.on("--boot-status") { ENV["MASTER_BOOT_STATUS"] = "1" }
  end
  parser.parse!(argv)
  options
end

cli = nil

trap("INT")  { cli&.container&.dig(:session)&.save! rescue nil; $stderr.puts "\nsaved"; exit 0 }
trap("TERM") { cli&.container&.dig(:session)&.save! rescue nil; exit 0 }

Master::Now::BootBanner.print
cli = Master.boot(root: Dir.pwd)
Master::Ops::RuntimeLoopGuards.install!

if $stdin.tty?
  Master::Now::WebServer.start(cli.container[:config])

  message = initial_message_from_argv(ARGV)
  cli.run(message.empty? ? nil : message)
else
  $stdout.sync = true
  $stdin.each_line { |line| cli.pipe(line) }
  cli.send(:stop_background_loop) rescue nil
  cli.container&.dig(:session)&.save! rescue nil
  $stdout.flush
  $stderr.flush
  exit!(cli.exit_code || 0)
end

exit(cli.exit_code || 0)
