#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
SAFE_ENV = {
  "MASTER_SAFE_MODE" => "1",
  "MASTER_BACKGROUND" => "0",
  "MASTER_AUTOFIX" => "0",
  "MASTER_WATCH" => "0",
  "MASTER_WATCHER" => "0",
  "MASTER_HEARTBEAT" => "0"
}.freeze

# Full chain mutates the tree via /fix. Prefer SCAN_ONLY=1 in CI/preflight.
SCAN_ONLY = ENV["MASTER_GATE_SCAN_ONLY"] == "1" || ARGV.include?("--scan-only")

COMMANDS = {
  master: (
    if SCAN_ONLY
      ["/scan --no-autofix .", "/critique ."].freeze
    else
      [
        "/scan .",
        "/fix .",
        "/scan .",
        "/critique .",
        "/review ."
      ].freeze
    end
  ),
  # DEPLOY was renamed to RAILS + OPENBSD (OPERATOR was later folded into
  # OPENBSD). /scan takes one path per invocation, so each former DEPLOY
  # child gets its own pass.
  deploy: %w[../RAILS ../OPENBSD].flat_map { |path|
    if SCAN_ONLY
      ["/scan --no-autofix #{path}", "/critique #{path}"]
    else
      ["/scan #{path}", "/fix #{path}", "/scan #{path}", "/critique #{path}", "/review #{path}"]
    end
  }.freeze
}.freeze

def run_command(*argv, chdir: ROOT)
  puts "$ #{argv.join(" ")}"
  stdout, status = Open3.capture2e(*argv, chdir: chdir)
  puts stdout
  abort "err: command failed: #{argv.join(" ")}" unless status.success?
end

def run_master_line(line)
  puts "master> #{line}"
  stdout, status = Open3.capture2e(SAFE_ENV, "bundle", "exec", "ruby", "bin/cli", chdir: ROOT, stdin_data: "#{line}\n")
  puts stdout
  abort "err: MASTER command failed: #{line}" unless status.success?
end

def git_diff(*paths)
  run_command("git", "diff", "--", *paths, chdir: REPO)
end

def assert_clean(*paths)
  run_command("git", "diff", "--exit-code", "--", *paths, chdir: REPO)
end

puts "gate: mode=#{SCAN_ONLY ? 'scan-only' : 'full-fix'}"

COMMANDS[:master].each { |line| run_master_line(line) }
git_diff("MASTER")
assert_clean("MASTER") unless SCAN_ONLY

COMMANDS[:deploy].each { |line| run_master_line(line) }
git_diff("RAILS", "OPENBSD", "MASTER")
assert_clean("RAILS", "OPENBSD", "MASTER") unless SCAN_ONLY

puts SCAN_ONLY ? "ok: MASTER gate scan-only complete" : "ok: MASTER gate clean"
