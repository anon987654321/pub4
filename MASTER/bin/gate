#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

ROOT = File.expand_path("..", __dir__)
REPO = File.expand_path("..", ROOT)
SAFE_ENV = {
  "MASTER_SAFE_MODE" => "1",
  "MASTER_BACKGROUND" => "0",
  "MASTER_AUTOFIX" => "0",
  "MASTER_WATCH" => "0",
  "MASTER_WATCHER" => "0",
  "MASTER_HEARTBEAT" => "0"
}.freeze

COMMANDS = {
  master: [
    "/scan .",
    "/fix .",
    "/scan .",
    "/critique .",
    "/review ."
  ].freeze,
  # DEPLOY was renamed to RAILS + OPERATOR (2026-07). /scan takes one path
  # per invocation, so each former DEPLOY child gets its own pass.
  deploy: %w[../RAILS ../OPERATOR].flat_map { |path|
    ["/scan #{path}", "/fix #{path}", "/scan #{path}", "/critique #{path}", "/review #{path}"]
  }.freeze
}.freeze

def run_command(*argv, chdir: ROOT)
  puts "$ #{argv.join(" ")}"
  stdout, status = Open3.capture2e(*argv, chdir: chdir)
  puts stdout
  abort "err: command failed: #{argv.join(" ")}" unless status.success?
end

def run_master_line(line)
  puts "master> #{line}"
  stdout, status = Open3.capture2e(SAFE_ENV, "bundle", "exec", "ruby", "bin/cli", chdir: ROOT, stdin_data: "#{line}\n")
  puts stdout
  abort "err: MASTER command failed: #{line}" unless status.success?
end

def git_diff(*paths)
  run_command("git", "diff", "--", *paths, chdir: REPO)
end

def assert_clean(*paths)
  run_command("git", "diff", "--exit-code", "--", *paths, chdir: REPO)
end

COMMANDS[:master].each { |line| run_master_line(line) }
git_diff("MASTER")
assert_clean("MASTER")

COMMANDS[:deploy].each { |line| run_master_line(line) }
git_diff("RAILS", "OPENBSD", "MASTER")
assert_clean("RAILS", "OPENBSD", "MASTER")

puts "ok: MASTER gate clean"
