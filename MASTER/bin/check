#!/usr/bin/env ruby
# frozen_string_literal: true
#
# One check entrypoint. A profile is a named list of steps — pick one:
#
#   bin/check [--profile NAME]
#
#   operator     (default) unit suite + core spine + data singularity
#   contributor  fast: unit suite + data singularity
#   agent        law/agent changes: selftest + data singularity
#   web          the face: static web UI (+ live web when MASTER_WEB_LIVE=1)
#   full         operator-grade gate: bin/ci + bin/probe all + rake audit
#
# Steps compose from two makers (rake / bin), so a new profile is one line of data.

require "optparse"
require_relative "../lib/pub4/check_runner"
require_relative "../lib/pub4/ruby_runner"

ROOT = File.expand_path("..", __dir__)
RUBY = Pub4::RubyRunner.ruby_cmd

profile = "operator"
OptionParser.new do |parser|
  parser.banner = "usage: bin/check [--profile operator|contributor|agent|web|full]"
  parser.on("--profile=NAME") { |value| profile = value }
end.parse!

rake = ->(*task) { [task.join(" "), RUBY, "-S", "rake", *task] }
run_bin = ->(name, *args) { ["bin/#{name} #{args.join(' ')}".strip, RUBY, File.join(ROOT, "bin", name), *args] }
web_live = ENV["MASTER_WEB_LIVE"] == "1"

PROFILES = {
  "operator"    => [rake["test"], rake["test:core"], rake["lint:data_singularity"]],
  "contributor" => [rake["test"], rake["lint:data_singularity"]],
  "agent"       => [rake["selftest"], rake["lint:data_singularity"]],
  "web"         => [["web ui static", RUBY, "-Ilib:test", "test/test_web_ui.rb"],
                    *(web_live ? [rake["test:web"], rake["test:integration_web"]] : [])],
  "full"        => [run_bin["ci"], run_bin["probe", "all"], rake["audit"]],
}.freeze

steps = PROFILES[profile] or abort "check: unknown profile '#{profile}' (have: #{PROFILES.keys.join(', ')})"
warn "check[web]: live web checks skipped (set MASTER_WEB_LIVE=1)" if profile == "web" && !web_live

timeout = Integer(ENV.fetch("MASTER_CHECK_TIMEOUT", profile == "full" ? "600" : "240"))
runner = Pub4::CheckRunner.new(prefix: "check:#{profile}", root: ROOT, timeout:)

failures = steps.reject { |step| runner.run(*step) }.map(&:first)
if failures.empty?
  puts "check[#{profile}]: clean"
  exit 0
end
puts "check[#{profile}]: #{failures.size} failure(s): #{failures.join(', ')}"
exit 1
