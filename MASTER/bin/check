#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

# The ladder, law/ and the scan registry and then the critique tier, is a mode of this command rather than
# a second one: --ladder, or any of its own flags, hands the arguments to lib/operator/check_ladder.rb.
LADDER_FLAGS = %w[--ladder --scan-only --lexical-only --semantic-only --explain].freeze
if ARGV.any? { |arg| LADDER_FLAGS.include?(arg) || arg.start_with?("--tree=") }
  ARGV.delete("--ladder")
  load File.expand_path("../lib/operator/check_ladder.rb", __dir__)
  exit
end
#
# One check entrypoint. A profile is a named list of steps — pick one:
#
#   bin/check [--profile NAME] [--format brief]
#
#   operator     (default) unit suite + core spine + data singularity
#   contributor  fast: unit suite + data singularity
#   agent        law/agent changes: selftest + data singularity
#   web          the face: static web UI (+ live web when MASTER_WEB_LIVE=1)
#   ci           the canonical local CI floor; MASTER_CI_FULL/WEB/BROWSER widen it
#   full         operator-grade check: ci + bin/probe all + rake audit
#
# `bin/operator check` runs this as one stage of the repo-wide chain, alongside the
# scanner, the RAILS checks, the ratchets and the sprawl census.
#
# Steps compose from two makers (rake / bin), so a new profile is one line of data.

require "optparse"
require_relative "../lib/operator/check_runner"
require_relative "../lib/operator/check_brief"
require_relative "../lib/operator/ruby_runner"
require_relative "../lib/trace/dmesg"

ROOT = File.expand_path("..", __dir__)
RUBY = Operator::RubyRunner.ruby_cmd
BUNDLE = Operator::RubyRunner.bundle_cmd

profile = "operator"
format = "human"
OptionParser.new do |parser|
  parser.banner = "usage: bin/check [--profile operator|contributor|agent|web|ci|full] [--format human|brief]"
  parser.on("--profile=NAME") { |value| profile = value }
  parser.on("--format=NAME") { |value| format = value }
end.parse!
unless %w[human brief].include?(format)
  Master::Trace::Dmesg.status("check0", "unknown format #{format}, have human or brief")
  exit 64
end

rake = ->(*task) { [task.join(" "), BUNDLE, "exec", "rake", *task] }
run_bin = ->(name, *args) { ["bin/#{name} #{args.join(' ')}".strip, RUBY, File.join(ROOT, "bin", name), *args] }
web_live = ENV["MASTER_WEB_LIVE"] == "1"
# vm23 has node at /usr/local/bin, which is not on cron's PATH — so resolve it
# rather than assuming the shell will.
node_bin = ENV["PATH"].to_s.split(File::PATH_SEPARATOR).push("/usr/local/bin")
                      .map { |dir| File.join(dir, "node") }.find { |p| File.executable?(p) }
web_test_dir = File.join(ROOT, "..", "RAILS", "master", "test")
web_node_tests = Dir[File.join(web_test_dir, "**/*.test.mjs")].sort
web_node_step = if node_bin && web_node_tests.any?
  ["web ui behaviour", node_bin, "--test", *web_node_tests]
else
  reason = node_bin ? "no JavaScript tests found beneath #{web_test_dir}" :
    "Node.js unavailable; web behavior was not measured"
  ["web ui behaviour unavailable", RUBY, "-e", "warn #{reason.inspect}; exit 3"]
end

# test:subsystems groups the cli/io/fix suites for a focused run, and the step
# is in the operator and contributor profiles and the ci list so a break there
# is caught by the checks contributors actually run, not only under full.
# 17s, measured 2026-08-01.
# rake["tools"] is in agent as well as the two heavy profiles, and it is the
# only step that is. The agent profile is what runs around law and fix-loop work,
# which is exactly the work that has silently broken tools before — `bin/check --ladder`'s
# /fix step rewrites the whole shared worktree, and until MASTER/tools/check.rb there
# was nothing in any profile that noticed. It costs ~3s: parse is in-process AST
# and the two load probes are about a second each.

# One list of CI steps, not two.
#
# `bin/ci` kept its own copy of these rake tasks beside this file's profiles:
# the same seven steps declared twice, free to drift, and `--profile=full`
# shelled out to that copy — so full ran selftest and core_smoke once through
# bin/ci and again through `rake audit`, and paid for both. bin/ci is this
# profile now, and full composes the list rather than re-running the script.
#
# The three MASTER_CI_* widenings are the workflow's, kept here because the
# workflow sets them and this is where the steps they add are declared.
# Boots the container and builds the FixLoop, no model call: the only step that
# sees a reader of a method that no longer exists (Laws#thresholds, 2026-10).
boot_smoke = ["boot smoke", RUBY, File.join(ROOT, "tools", "boot_smoke.rb")]

law_syntax = ["law syntax", RUBY, "-e", <<~'RUBY', ROOT]
  Dir.glob(File.join(ARGV.fetch(0), "law", "*.rb")).sort.each do |path|
    RubyVM::InstructionSequence.compile_file(path)
  rescue SyntaxError => e
    warn "#{path.delete_prefix(ARGV.fetch(0) + File::SEPARATOR)}: #{e.message.lines.first.to_s.strip}"
    exit 1
  end
RUBY

# gem:build_proof is here and nowhere else: the gemspec claims a file list that
# nothing verified, and a package built from a silently-shortened list ships
# fewer files than it claims. The proof is one package build, ~2s.
ci_steps = [law_syntax, boot_smoke, rake["test"], rake["test:core"], rake["test:subsystems"],
            rake["test:web"], rake["test:web_ui"], rake["selftest"],
            rake["lint:data_singularity"], rake["core_smoke"], rake["tools"],
            rake["gem:build_proof"]]
ci_steps += [run_bin["smoke"], rake["selfcheck"], rake["constitution"]] unless ENV["MASTER_CI_FULL"] == "0"
ci_steps << web_node_step
ci_steps << rake["test:integration_web"] unless ENV["MASTER_CI_WEB"] == "0"
unless ENV["MASTER_CI_BROWSER"] == "0"
  webgl = File.join(ROOT, "..", "RAILS", "master", "script", "probe_webgl_guard.mjs")
  if node_bin && File.file?(webgl)
    # The probe reads this itself; without it a machine with no browser reports
    # a pass having launched nothing.
    ENV["PROBE_REQUIRE_BROWSER"] ||= "1"
    ci_steps << ["webgl probe", node_bin, webgl]
  else
    Master::Trace::Dmesg.status("web0", "webgl probe skipped, #{node_bin ? "missing #{webgl}" : "no node"}")
  end
end

# rake audit already runs selftest, core_smoke and constitution, so full lists
# the CI steps that audit does not cover rather than the whole of ci.
full_ci = ci_steps.reject { |step| %w[selftest core_smoke constitution].include?(step.first) }

PROFILES = {
  "operator"    => [law_syntax, boot_smoke, rake["test"], rake["test:subsystems"], rake["security_sweep"],
                    rake["test:core"], rake["lint:data_singularity"], rake["lint:dedup"], rake["tools"]],
  "contributor" => [law_syntax, boot_smoke, rake["test"], rake["test:subsystems"], rake["security_sweep"],
                    rake["lint:data_singularity"], rake["lint:dedup"], rake["tools"]],
  # lint:word_boundary is here and nowhere else: its subject is a `\b` written
  # next to punctuation in a rule regex, which is a word boundary that can never
  # fire, and the agent profile is the one that runs around rule work. It has
  # cost something four times — TYPE_CHECK's `is_a\?\b` clause was dead from the
  # day it was written, so half of what OPEN_CLOSED promised never ran. The lint
  # existed for weeks in no profile at all, which is the defect it detects,
  # wearing the other coat. 0.2s.
  "agent"       => [law_syntax, boot_smoke, rake["selftest"], rake["lint:data_singularity"], rake["lint:dedup"],
                    rake["lint:word_boundary"], rake["tools"]],
  # Face tests keep three runtimes: the MASTER Rack UI test, the Rails-backed
  # RAILS/master suite, and every shipped JavaScript behavior test under Node.
  # The canonical web tree moved to RAILS/master; the old MASTER/web glob
  # selected zero files without failing, so CI reported green without measuring
  # any of those JavaScript tests. An empty inventory or missing runtime is now
  # a visible non-pass rather than a silent omission.
  "web"         => [law_syntax, rake["test:web_ui"], web_node_step, rake["test:web"],
                    *(web_live ? [rake["test:integration_web"]] : [])],
  "ci"          => ci_steps,
  "full"        => [*full_ci, run_bin["probe", "all"], rake["audit"]],
}.freeze

# line count awareness (soul SIMPLEST_WORKS, file warn 200/hard 300)
# runs fast; warns on non-light profiles for lib/**/*.rb
lib_rbs = Dir[File.join(ROOT, "lib/**/*.rb")]
oversized = lib_rbs.select { |f| File.readlines(f).size > 300 }
if profile != "contributor" && oversized.any?
  Master::Trace::Dmesg.status("check0", "oversized lib files, #{oversized.map { |f| File.basename(f) }.join(", ")}")
end

steps = PROFILES[profile]
unless steps
  Master::Trace::Dmesg.status("check0", "unknown profile #{profile}, have #{PROFILES.keys.join(", ")}")
  exit 64
end
Master::Trace::Dmesg.status("web0", "live web checks skipped, set MASTER_WEB_LIVE=1") if profile == "web" && !web_live

# Hang guard, not a performance budget — see CheckRunner::SLOW_STEP_FRACTION.
# 360 was under `rake test`'s real cost the moment anything else used the CPU
# (247s measured idle, 2026-08-02), so the check reported starved-clock timeouts
# as failing unit tests. CheckRunner now warns on a *passing* step that eats
# most of its allowance, which is the signal that was missing.
timeout = Integer(ENV.fetch("MASTER_CHECK_TIMEOUT", profile == "full" ? "1200" : "900"))
runner = Operator::CheckRunner.new(prefix: "check:#{profile}", root: ROOT, timeout:, quiet: format == "brief")

steps.each { |step| runner.run(*step) }
failures = runner.results.reject { |r| r.success }.map(&:name)
body = if format == "brief"
         Operator::CheckBrief.render(profile:, results: runner.results)
       elsif failures.empty?
         "clean"
       else
         "#{failures.size} failure(s), #{failures.join(", ")}"
       end
Master::Trace::Dmesg::Report.print("check0", body, parent: "master0")
exit(failures.empty? ? 0 : 1)
