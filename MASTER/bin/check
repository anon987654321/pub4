#!/usr/bin/env ruby
# frozen_string_literal: true
#
# One check entrypoint. A profile is a named list of steps — pick one:
#
#   bin/check [--profile NAME] [--format brief]
#
#   operator     (default) unit suite + core spine + data singularity
#   contributor  fast: unit suite + data singularity
#   agent        law/agent changes: selftest + data singularity
#   web          the face: static web UI (+ live web when MASTER_WEB_LIVE=1)
#   full         operator-grade gate: bin/ci + bin/probe all + rake audit
#
# Steps compose from two makers (rake / bin), so a new profile is one line of data.

require "optparse"
require_relative "../lib/pub4/check_runner"
require_relative "../lib/pub4/check_brief"
require_relative "../lib/pub4/ruby_runner"

ROOT = File.expand_path("..", __dir__)
RUBY = Pub4::RubyRunner.ruby_cmd
BUNDLE = Pub4::RubyRunner.bundle_cmd

profile = "operator"
format = "human"
OptionParser.new do |parser|
  parser.banner = "usage: bin/check [--profile operator|contributor|agent|web|full] [--format human|brief]"
  parser.on("--profile=NAME") { |value| profile = value }
  parser.on("--format=NAME") { |value| format = value }
end.parse!
abort "check: unknown format '#{format}' (have: human, brief)" unless %w[human brief].include?(format)

rake = ->(*task) { [task.join(" "), BUNDLE, "exec", "rake", *task] }
run_bin = ->(name, *args) { ["bin/#{name} #{args.join(' ')}".strip, RUBY, File.join(ROOT, "bin", name), *args] }
web_live = ENV["MASTER_WEB_LIVE"] == "1"

# test:subsystems ran in no profile but full (i.e. only through bin/ci), so the 14
# files under test/{cli,io,fix,lib} were skipped by the gate START_HERE.md tells
# contributors to run. rake test's glob is test/test_*.rb and does not reach them.
# 17s, measured 2026-08-01.
# rake["studio"] is in agent as well as the two heavy profiles, and it is the
# only step that is. The agent profile is what runs around law and fix-loop work,
# which is exactly the work that has silently broken STUDIO before — `bin/gate`'s
# /fix step rewrites the whole shared worktree, and until STUDIO/gate.rb there
# was nothing in any profile that noticed. It costs ~3s: parse is in-process AST
# and the two load probes are about a second each.
PROFILES = {
  "operator"    => [rake["test"], rake["spec"], rake["test:subsystems"], rake["security_sweep"],
                    rake["test:core"], rake["lint:data_singularity"], rake["studio"]],
  "contributor" => [rake["test"], rake["spec"], rake["test:subsystems"], rake["security_sweep"],
                    rake["lint:data_singularity"], rake["studio"]],
  "agent"       => [rake["selftest"], rake["lint:data_singularity"], rake["studio"]],
  "web"         => [["web ui static", RUBY, "-Ilib:test", "test/test_web_ui.rb"],
                    *(web_live ? [rake["test:web"], rake["test:integration_web"]] : [])],
  "full"        => [run_bin["ci"], run_bin["probe", "all"], rake["audit"]],
}.freeze

# line count awareness (soul SIMPLEST_WORKS, file warn 200/hard 300)
# runs fast; warns on non-light profiles for lib/**/*.rb
lib_rbs = Dir[File.join(ROOT, "lib/**/*.rb")]
oversized = lib_rbs.select { |f| File.readlines(f).size > 300 }
if profile != "contributor" && oversized.any?
  warn "check: oversized (>300 lines) in lib: #{oversized.map { |f| File.basename(f) }.join(', ')}"
end

steps = PROFILES[profile] or abort "check: unknown profile '#{profile}' (have: #{PROFILES.keys.join(', ')})"
warn "check[web]: live web checks skipped (set MASTER_WEB_LIVE=1)" if profile == "web" && !web_live

# Hang guard, not a performance budget — see CheckRunner::SLOW_STEP_FRACTION.
# 360 was under `rake test`'s real cost the moment anything else used the CPU
# (247s measured idle, 2026-08-02), so the gate reported starved-clock timeouts
# as failing unit tests. CheckRunner now warns on a *passing* step that eats
# most of its allowance, which is the signal that was missing.
timeout = Integer(ENV.fetch("MASTER_CHECK_TIMEOUT", profile == "full" ? "1200" : "900"))
runner = Pub4::CheckRunner.new(prefix: "check:#{profile}", root: ROOT, timeout:, quiet: format == "brief")

steps.each { |step| runner.run(*step) }
failures = runner.results.reject { |r| r.success }.map(&:name)
if failures.empty?
  if format == "brief"
    puts Pub4::CheckBrief.render(profile:, results: runner.results)
  else
    puts "check[#{profile}]: clean"
  end
  exit 0
end
if format == "brief"
  puts Pub4::CheckBrief.render(profile:, results: runner.results)
else
  puts "check[#{profile}]: #{failures.size} failure(s): #{failures.join(', ')}"
end
exit 1
