#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

# master-smoke — boot + wire-check + (optional) web ping. Exits 0 clean, 1 on
# any failure. Use after every refactor pass and as a pre-restart check:
#   bin/smoke && doas rcctl restart master

Encoding.default_external = Encoding::UTF_8
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "ground/env_loader"
require "bundler/setup"

require "open3"
require "pty"
require "rbconfig"
require "net/http"
require "uri"
require "tmpdir"
require "yaml"
require_relative "../lib/trace/dmesg"

RUBY = RbConfig.ruby

PIPE_TIMEOUT_SECONDS = Integer(ENV.fetch("MASTER_SMOKE_PIPE_TIMEOUT", ENV["MASTER_LOW_RESOURCE"] ? "90" : "30"))

def step(name)
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  ok, msg = yield
  dt = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0) * 1000).round
  Master::Trace::Dmesg.status("test0", "#{name}, #{ok ? "ok" : "failed"}, #{dt}ms#{msg ? ", #{msg}" : ""}")
  ok
end

failures = []

require "master"
require_relative "../lib/io/exec"
failures << "require" unless step("require master") { [true, nil] }

container = nil
failures << "bootstrap" unless step("bootstrap container") do
  container = Master.bootstrap_container(root: Dir.pwd)
  [container.is_a?(Hash), "got #{container.class}"]
end

failures << "builder" unless step("builder.build") do
  res = Master::Builder.build
  [res.is_a?(Hash) && !res.empty?, "got #{res.class}"]
end

%i[agent pipeline scanner config bus renderer].each do |key|
  failures << "wire:#{key}" unless step("wire #{key}") do
    [container && container[key], "missing"]
  end
end

config = container.dig(:config)
port = (config&.respond_to?(:web_port) ? config.web_port : nil) || 53_187

failures << "auth_tier" unless step("auth tier") do
  require_relative "../../RAILS/master/app/middleware/auth_tier"

  token = "x" * 64
  ok = Dir.mktmpdir("master-auth-tier") do |dir|
    config_path = File.join(dir, "config.yml")
    File.write(config_path, { "web_token" => token }.to_yaml)

    app = lambda do |env|
      [200, { "Content-Type" => "text/plain" }, [env["master.tier"].to_s]]
    end

    middleware = AuthTier.new(app, config_path:)
    base_env = {
      "PATH_INFO" => "/",
      "QUERY_STRING" => "",
      "rack.url_scheme" => "https",
    }

    visitor_status, _visitor_headers, visitor_body = middleware.call(base_env.dup)
    author_status, _author_headers, author_body =
      middleware.call(base_env.merge("QUERY_STRING" => "author=johann_manaf_tepstad"))
    token_status, token_headers, _token_body =
      middleware.call(base_env.merge("QUERY_STRING" => "token=#{token}"))

    visitor_status == 200 &&
      visitor_body.join == "visitor" &&
      author_status == 200 &&
      author_body.join == "visitor" &&
      token_status == 302 &&
      token_headers["Set-Cookie"].to_s.include?("HttpOnly") &&
      token_headers["Set-Cookie"].to_s.include?("Secure")
  end

  [ok, "visitor/auth/token separation failed"]
end

failures << "launcher" unless step("bin/ruby bin/master boot") do
  ruby_wrapper = File.expand_path("ruby", __dir__)
  master = File.expand_path("master", __dir__)
  output = +""
  status = nil

  # EIO is how a PTY reports that the child closed its side: the output is complete.
  read_chunk = lambda do |io|
    io.wait_readable(0.2) ? io.readpartial(4096) : ""
  rescue Errno::EIO, EOFError
    ""
  end

  stop = lambda do |pid|
    Process.kill("TERM", pid) rescue nil
    Process.waitpid2(pid).last rescue nil
  end

  PTY.spawn(
    { "MASTER_FAST" => nil, "MASTER_WEB" => "0", "MASTER_SKIP_TTS" => "1",
      "MASTER_SKIP_BOOT_SCAN" => "1", "MASTER_BACKGROUND" => "0",
      "MASTER_AUTOFIX" => "0", "MASTER_WATCH" => "0", "MASTER_WATCHER" => "0",
      "MASTER_HEARTBEAT" => "0" },
    ruby_wrapper, master, "--fast",
  ) do |reader, writer, pid|
    writer.close
    deadline = Time.now + PIPE_TIMEOUT_SECONDS

    until status
      output << read_chunk.call(reader)

      _done, status = Process.waitpid2(pid, Process::WNOHANG)
      next unless Time.now >= deadline

      status = stop.call(pid)
      break
    end
  ensure
    writer.close unless writer.closed?
    reader.close unless reader.closed?
  end

  ok = status&.success?
  [ok, ok ? nil : output.lines.last.to_s.strip]
rescue StandardError => e
  [false, "launcher boot: #{e.class}: #{e.message}"]
end

failures << "pipe" unless step("pipe command") do
  exe = File.expand_path("master", __dir__)
  Master::Ground::EnvLoader.load!
  env = ENV.to_h.merge("MASTER_QUIET" => "1")
  out, _st = Master::Io::Exec.capture2e(env, exe, stdin_data: "/help\n", timeout: PIPE_TIMEOUT_SECONDS, raise_on_timeout: true)
  bug = out =~ /\b(unknown category|NameError|NoMethodError|uninitialized constant)/i
  message = out.lines.find { |line| line =~ /\b(unknown category|NameError|NoMethodError|uninitialized constant)/i }
  [bug.nil?, message&.strip]
rescue Master::Io::Exec::TimeoutError
  [false, "pipe command timed out after #{PIPE_TIMEOUT_SECONDS}s"]
end

if ARGV.include?("--tts")
  failures << "tts" unless step("tts-e2e poll") do
    exe = File.expand_path("tts-e2e", __dir__)
    out, st = Open3.capture2e(exe)
    puts out unless out.empty?
    [st.success?, st.success? ? nil : out.lines.last&.strip]
  end
end

if ARGV.include?("--web")
  failures << "web" unless step("web smoke-web") do
    exe = File.expand_path("smoke-web", __dir__)
    env = { "MASTER_WEB_URL" => "http://127.0.0.1:#{port}" }
    out, st = Open3.capture2e(env, RUBY, exe)
    puts out unless out.empty?
    [st.success?, st.success? ? nil : out.lines.grep(/fail/).last&.strip]
  end

  if File.readable?("/var/log/daemon")
    failures << "log" unless step("daemon log errors") do
      out, = Open3.capture2e("doas", "tail", "-200", "/var/log/daemon")
      recent = out.lines.last(200).join
      bad = recent.scan(/NameError|uninitialized constant|undefined method|NoMethodError/i).size
      [bad.zero?, "#{bad} suspicious entries"]
    end
  end
end

if failures.empty?
  Master::Trace::Dmesg.status("test0", "clean")
  exit 0
else
  Master::Trace::Dmesg.status("test0", "smoke state=failed failures=#{failures.join(",")}")
  exit 1
end
