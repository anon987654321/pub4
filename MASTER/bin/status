#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

root = File.expand_path("..", __dir__)
repo = File.expand_path("..", root)

def capture(*cmd, chdir:)
  out, status = Open3.capture2e(*cmd, chdir:)
  status.success? ? out.strip : "ERR: #{out.strip}"
end

branch = capture("git", "branch", "--show-current", chdir: repo)
dirty = capture("git", "status", "--porcelain", chdir: repo).lines.count
commit = capture("git", "rev-parse", "--short", "HEAD", chdir: repo)

puts "MASTER status"
puts "root: #{root}"
puts "repo: #{repo}"
puts "branch: #{branch}"
puts "commit: #{commit}"
puts "dirty: #{dirty} file(s)"
puts "safe_mode: #{ENV.fetch("MASTER_SAFE_MODE", "1")}"
puts "loop: #{ENV.fetch("MASTER_LOOP", "none")}"