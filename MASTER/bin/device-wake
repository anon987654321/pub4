#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["MASTER_DEVICE_AGENT"] = "0"
ENV["MASTER_WEB"] = "0"
ENV["MASTER_SKIP_TTS"] = "0"
ENV["MASTER_CLI_SPEAK"] = "0"

ROOT = File.expand_path("..", __dir__)
Dir.chdir(ROOT)
$LOAD_PATH.unshift File.join(ROOT, "lib")

require "master"
require_relative "../lib/device/wake_word"

session = Master.boot(root: ROOT)
container = session.container
ear = Master::CLI::Face::Ear.new(device: Master::Device)
talk = Master::CLI::Face::Talk.for_session(session)
wake = Master::Device::WakeWord.new(root: ROOT)

trap("TERM") { wake.stop! }
trap("INT") { wake.stop! }

def speak(text)
  return if text.to_s.strip.empty?
  return unless system("command", "-v", "termux-tts-speak", out: File::NULL, err: File::NULL)

  system("termux-tts-speak", "-s", "MUSIC", text.to_s, out: File::NULL, err: File::NULL)
end

wake.run_forever do |_phrase, _heard|
  subject = Master::Device::Agent.owner_subject(root: ROOT)
  greeting = if subject.empty?
               "Hello. I'm MASTER. Pair me first if this is your phone."
             else
               Master::Device::OwnerProfile.wake_greeting(root: ROOT, subject:)
             end

  speak(greeting)
  container[:bus]&.publish("device:wake", subject:, phrase: _phrase)
  conversation_deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 20
  loop do
    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= conversation_deadline
    heard = ear.listen(
      stop: -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) >= conversation_deadline },
    )
    break if heard.to_s.strip.empty?

    result = talk.call(heard.to_s.strip)
    unless result.ok?
      speak(result.message)
      break
    end

    speak(result.value!)
    conversation_deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 20
  end
end
