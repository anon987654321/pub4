#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/boot/entrypoint"
Master::Boot::Entrypoint.prepare!(root: File.expand_path("..", __dir__))

# Speak text via transcendent TTS — stdout path or writes last.mp3 target.
require "fileutils"
require_relative "../lib/trace/dmesg"

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
require "master"

text_file = ARGV[0]
out_target = ARGV[1]
unless text_file && File.file?(text_file)
  Master::Trace::Dmesg.status("tts0", "usage, tts-speak TEXT_FILE [OUT_MP3]", io: $stderr)
  exit 64
end

text = File.read(text_file, encoding: "UTF-8").strip
exit 0 if text.empty? || text.length < 20

ENV["MASTER_TTS_MODE"] = "transcendent"
path = Master::Voice::Transcendent.synthesize(text)
unless path && File.size?(path)
  Master::Trace::Dmesg.status("tts0", "synthesis failed", io: $stderr)
  exit 1
end

if out_target && !out_target.empty?
  FileUtils.cp(path, out_target)
  Master::Trace::Dmesg.status("tts0", "wrote #{out_target}")
else
  Master::Trace::Dmesg.status("tts0", "audio #{path}")
end
