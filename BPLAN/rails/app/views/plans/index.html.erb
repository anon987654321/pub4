<% content_for :title, "Forretningsplaner" %>

<article>
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1>Forretningsplaner</h1>
    <p class="meta"><%= @plans.size %> ideer · én side per idé</p>
  </header>
  <div class="content">
    <div class="plan-cards">
      <% @plans.each do |plan| %>
        <article class="plan-card">
          <h2><%= link_to plan[:title], plan_path(slug: plan[:slug]) %></h2>
          <p>
            <span class="track-pill track-pill--<%= plan[:track] %>"><%= plan[:track] %></span>
            <% if plan[:trl].present? %><span class="meta">TRL <%= plan[:trl] %></span><% end %>
          </p>
          <p><%= truncate(plan[:pitch], length: 160) %></p>
          <p class="meta">
            Legat: NOK <%= number_with_delimiter(plan[:ask_legat_nok]) %>
            <% if catalog.show_in_pay?(plan) %>
              · IN-mål: NOK <%= number_with_delimiter(plan[:ask_in_nok]) %>
            <% end %>
          </p>
          <% if show_pay_buttons? && plan[:ask_legat_nok].positive? %>
            <%= button_to "Betal", pay_path(slug: plan[:slug]), method: :post,
                  params: { kind: "legat" },
                  class: "bplan-btn-pay", form: { data: { turbo: false } } %>
          <% end %>
        </article>
      <% end %>
    </div>
    <p><%= link_to "← BPLAN", root_path %></p>
  </div>
</article>