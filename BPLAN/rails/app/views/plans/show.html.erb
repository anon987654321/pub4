<% content_for :title, @plan[:title] %>

<article data-plan="<%= @plan[:slug] %>">
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1><%= @plan[:title] %></h1>
    <p class="meta">
      <span class="track-pill track-pill--<%= @plan[:track] %>"><%= @plan[:track] %></span>
      Bergen
      <% if show_pay_buttons? && @plan[:ask_legat_nok].positive? %>
        · <%= button_to "Betal NOK #{number_with_delimiter(@plan[:ask_legat_nok])}",
              pay_path(slug: @plan[:slug]),
              method: :post,
              params: { kind: "legat" },
              class: "bplan-btn-pay",
              form: { data: { turbo: false } } %>
      <% end %>
    </p>
  </header>
  <div class="content">
    <%= @body.html_safe %>
  </div>
  <footer class="bplan-doc-footer">
    <p><%= link_to "Alle ideer", plans_path %> · <%= link_to "BPLAN", root_path %></p>
  </footer>
</article>