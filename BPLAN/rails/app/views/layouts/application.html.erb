<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} — BPLAN" : "BPLAN — MASTER + RAILS" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Bergen. MASTER utvikler. RAILS leverer. Forretningsplaner og legatsøknader." %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/content/htu/htu.css">
  <link rel="stylesheet" href="/site.css">
</head>
<body class="bplan-site">
<a class="skip-link" href="#main-content">Hopp til innhold</a>
<header class="bplan-nav">
  <%= link_to "BPLAN", root_path, class: "bplan-brand" %>
  <button type="button" class="bplan-nav-toggle" aria-expanded="false" aria-controls="bplan-nav-menu">Meny</button>
  <nav id="bplan-nav-menu" class="bplan-nav-menu" aria-label="Hovedmeny">
    <%= link_to "Ideer", plans_path %>
    <%= link_to "Legater", legats_path %>
    <%= link_to "Portefølje", portfolio_path %>
    <%= link_to "Frister", deadlines_path %>
    <%= link_to "brgen.no", "https://brgen.no", target: "_blank", rel: "noopener" %>
  </nav>
</header>
<%= tag.p(notice, role: "status", class: "flash flash-notice") if notice %>
<%= tag.p(alert, role: "alert", class: "flash flash-alert") if alert %>
<main id="main-content" class="bplan-main">
  <%= yield %>
</main>
<footer class="bplan-footer">
  <p>PubHealthcare · Kanalveien 10, Bergen · <%= mail_to "bergen@pub.attorney" %></p>
  <p class="meta">Konvergens v<%= catalog.convergence_version %> · funding.yml</p>
</footer>
<script>
  document.querySelector(".bplan-nav-toggle")?.addEventListener("click", function () {
    const menu = document.getElementById("bplan-nav-menu");
    const open = this.getAttribute("aria-expanded") === "true";
    this.setAttribute("aria-expanded", String(!open));
    menu.classList.toggle("is-open", !open);
  });
  document.querySelectorAll("[data-copy-ref]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      const text = btn.getAttribute("data-copy-ref");
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = "Kopiert!";
        setTimeout(function () { btn.textContent = "Kopier referanse"; }, 2000);
      });
    });
  });
</script>
</body>
</html>