<% content_for :title, "Legatsøknader" %>

<article>
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1>Legatsøknader</h1>
    <p class="meta">
      <%= @sendable_count %> sendbare · sortert etter frist · MASTER + RAILS · Bergen
    </p>
  </header>
  <div class="content">
    <nav class="track-filters" aria-label="Filtrer etter spor">
      <%= link_to "Alle", legats_path, class: @track.blank? ? "is-active" : nil %>
      <% @tracks.each do |track| %>
        <%= link_to track, legats_path(track: track), class: @track == track ? "is-active" : nil %>
      <% end %>
    </nav>

    <table>
      <tr><td>#</td><td>Giver</td><td>Spor</td><td>Frist</td><td>Status</td></tr>
      <% @legats.each_with_index do |legat, i| %>
        <% offset = (@page - 1) * @per_page %>
        <tr>
          <td><%= offset + i + 1 %>.</td>
          <td><%= link_to legat["funder"], legat_path(id: legat["id"]) %></td>
          <td><span class="track-pill track-pill--<%= legat['track'] %>"><%= legat["track"] %></span></td>
          <td><%= legat["deadline"] %></td>
          <td class="badge-cell">
            <% if legat["draft"] %><span class="status-badge status-badge--draft">Utkast</span><% end %>
            <% if catalog.sendable?(legat) %>
              <span class="status-badge status-badge--sendable">Sendbar</span>
            <% else %>
              <span class="status-badge status-badge--hold">Ikke send</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </table>

    <% if @total_pages > 1 %>
      <nav class="pagination" aria-label="Sideinndeling">
        <% if @page > 1 %>
          <%= link_to "← Forrige", legats_path(track: @track, page: @page - 1) %>
        <% end %>
        <span class="meta">Side <%= @page %> av <%= @total_pages %></span>
        <% if @page < @total_pages %>
          <%= link_to "Neste →", legats_path(track: @track, page: @page + 1) %>
        <% end %>
      </nav>
    <% end %>

    <p><%= link_to "← BPLAN", root_path %></p>
  </div>
</article>