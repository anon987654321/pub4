<% content_for :title, @legat["funder"] %>

<article>
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1><%= @legat["title"] || @legat["subject"] %></h1>
    <p class="meta">
      <%= @legat["funder"] %>
      · <span class="track-pill track-pill--<%= @legat['track'] %>"><%= @legat["track"] %></span>
      · <%= @legat["deadline"] %>
    </p>
    <p class="badge-cell">
      <% if @legat["draft"] %><span class="status-badge status-badge--draft">Utkast</span><% end %>
      <% if @sendable %>
        <span class="status-badge status-badge--sendable">Sendbar</span>
      <% else %>
        <span class="status-badge status-badge--hold">Ikke send automatisk</span>
      <% end %>
    </p>
  </header>

  <% if @legat["verify_to"] || @legat["contact_url"].present? %>
    <aside class="verify-banner" role="note">
      <strong>Verifiser før sending:</strong>
      Bekreft mottaker og frist på giverens nettside.
      <% if @legat["contact_url"].present? %>
        <%= link_to "Åpne giver", @legat["contact_url"], target: "_blank", rel: "noopener" %>
      <% end %>
      <% if @legat["to"].present? %>
        · Foreslått mottaker: <code><%= @legat["to"] %></code>
      <% end %>
    </aside>
  <% end %>

  <div class="content">
    <section class="attachment-checklist">
      <h2>Vedleggssjekkliste</h2>
      <ul>
        <% @attachments.each do |item| %>
          <li><%= item %></li>
        <% end %>
      </ul>
    </section>

    <section class="legat-metadata">
      <h2>Manifest</h2>
      <table>
        <tr><td>ID</td><td><code><%= @legat["id"] %></code></td></tr>
        <tr><td>Prosjekt</td><td><%= @legat["project"] %></td></tr>
        <tr><td>Emne</td><td><%= @legat["subject"] %></td></tr>
        <% if @legat["notes"].present? %>
          <tr><td>Notater</td><td><%= @legat["notes"] %></td></tr>
        <% end %>
      </table>
    </section>

    <%= @body.html_safe %>
  </div>
  <footer class="bplan-doc-footer">
    <p><%= link_to "Alle legater", legats_path %> · <%= link_to "BPLAN", root_path %></p>
  </footer>
</article>