<% deadlines = local_assigns.fetch(:deadlines, catalog.deadlines) %>
<% today = local_assigns.fetch(:today, catalog.funding["generated"].to_s) %>

<h2>Fristkalender</h2>
<p class="meta">
  Verifiser alltid på giverens nettside før sending.
  <%= link_to "Last ned ICS", deadlines_ics_path %>
</p>
<table class="deadline-table">
  <tr><td>#</td><td>Frist</td><td>Giver</td><td>Spor</td><td>Handling</td></tr>
  <% deadlines.each_with_index do |deadline, i| %>
    <% span = deadline["end_date"].present? ? "#{deadline['date']} – #{deadline['end_date']}" : deadline["date"] %>
    <% open_now = deadline["date"].to_s <= today && (deadline["end_date"].blank? || deadline["end_date"].to_s >= today) %>
    <% soon = catalog.deadline_urgent?(deadline, today: today) %>
    <tr class="<%= 'deadline-urgent' if open_now || soon %>">
      <td><%= i + 1 %>.</td>
      <td><%= span %>
        <% if open_now %> <span class="deadline-badge">åpen nå</span>
        <% elsif soon %> <span class="deadline-badge deadline-badge--soon">≤7 dager</span>
        <% end %>
      </td>
      <td><%= deadline["funder"] %></td>
      <td><span class="track-pill track-pill--<%= deadline['track'] %>"><%= deadline["track"] %></span></td>
      <td><%= deadline["action"] %></td>
    </tr>
  <% end %>
</table>