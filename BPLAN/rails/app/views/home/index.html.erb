<% content_for :title, "Forretningsplaner og legater" %>
<% content_for :description, "BPLAN — forretningsplaner, legatsøknader og støtteknapper. Egen app, separat fra RAILS/." %>

<article class="bplan-hero">
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1>BPLAN — Bergen</h1>
    <p class="meta">
      Denne siden er <strong>BPLAN/rails</strong> — en egen, innholdsstyrt Rails-app.<br>
      Den er <em>ikke</em> en del av <code>RAILS/brgen</code>, <code>RAILS/amber</code> eller andre deploy-apper.<br>
      <strong>MASTER</strong> utvikler; <strong>RAILS/</strong> deployer brgen.no, pub.healthcare m.fl. — BPLAN dokumenterer og søker støtte til det arbeidet.
    </p>
  </header>

  <div class="content">
    <aside class="bolig-cta">
      <h2>Bolig i Bergen</h2>
      <p>Startlån og tilskudd er et eget spor — separat fra FoU-budsjett.</p>
      <p>
        <%= link_to "Les boligplanen", plan_path(slug: "bolig_bergen"), class: "bplan-btn-pay" %>
        <%= link_to "Bolig-legater", legats_path(track: "bolig"), class: "bplan-btn-pay bplan-btn-pay--secondary" %>
      </p>
    </aside>

    <% if show_pay_buttons? %>
      <h2>Støtt en idé nå</h2>
      <p class="meta">Beløp fra funding.yml — legatstipend eller innovasjonsmål.</p>
      <table>
        <tr><td><strong>Idé</strong></td><td><strong>Støtt nå</strong></td></tr>
        <% @plans.each do |plan| %>
          <tr>
            <td>
              <%= link_to plan[:title], plan_path(slug: plan[:slug]) %>
              <br><span class="meta"><%= truncate(plan[:pitch], length: 120) %></span>
            </td>
            <td class="bplan-pay-cell">
              <% if plan[:ask_legat_nok].positive? %>
                <%= button_to "Betal NOK #{number_with_delimiter(plan[:ask_legat_nok])}",
                      pay_path(slug: plan[:slug]),
                      method: :post,
                      params: { kind: "legat" },
                      class: "bplan-btn-pay",
                      form: { data: { turbo: false } } %>
              <% end %>
              <% if catalog.show_in_pay?(plan) %>
                <%= button_to "IN-mål #{number_with_delimiter(plan[:ask_in_nok])}",
                      pay_path(slug: plan[:slug]),
                      method: :post,
                      params: { kind: "in" },
                      class: "bplan-btn-pay bplan-btn-pay--secondary",
                      form: { data: { turbo: false } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <h2>Portefølje</h2>
    <p><%= link_to "Full porteføljeoversikt →", portfolio_path %></p>
    <%= catalog.portfolio_summary_html.html_safe %>

    <%= render "shared/deadline_calendar" %>

    <h2>Alt innhold</h2>
    <table>
      <tr><td>→</td><td><%= link_to "#{@plans.size} forretningsplaner", plans_path %></td></tr>
      <tr><td>→</td><td><%= link_to "#{@legat_count} legatsøknader", legats_path %></td></tr>
      <tr><td>→</td><td><%= link_to "Fristkalender", deadlines_path %></td></tr>
    </table>
  </div>
</article>