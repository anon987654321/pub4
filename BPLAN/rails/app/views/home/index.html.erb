<% content_for :title, "Forretningsplaner og legater" %>
<% content_for :description, "BPLAN — forretningsplaner, legatsøknader og støtteknapper. Egen app, separat fra RAILS/." %>

<article class="bplan-hero">
  <img src="/content/htu/bergen.svg" alt="" class="logo">
  <header>
    <h1>BPLAN — Bergen</h1>
    <p class="meta bplan-hierarchy">
      <strong>MASTER</strong> — selvforbedrende AI-kjerne (utvikler kode)<br>
      <strong>RAILS/</strong> — deploybare apper: brgen.no, amber, bsdports (produksjon)<br>
      <strong>BPLAN/rails</strong> — denne siden: forretningsplaner, legater, frister (egen app, ikke i RAILS/apps.yml)
    </p>
  </header>

  <div class="content">
    <% if bolig_asap_pending? %>
      <aside class="bolig-cta bolig-cta--urgent" role="alert">
        <h2>Bolig først — bolig_asap venter</h2>
        <p>Sendbare e-postsøknader i <code>bolig_asap</code> er ikke logget som sendt. Prioriter Startlån, NAV og sosiale legater med ekstern mottaker.</p>
        <%= link_to "Åpne bolig-legater", legats_path(track: "bolig"), class: "bplan-btn-pay" %>
      </aside>
    <% end %>
    <% if bolig_portal_sept_pending? %>
      <aside class="bolig-cta bolig-cta--urgent" role="alert">
        <h2>Stipendportalen — sept 2026</h2>
        <p>Manuell innsending i <code>bolig_portal_sept</code>: Gunvor Minde (20.09), Zuccarelli (01.09) og vanskeligstilte. Ikke mutt — last opp PDF på stipendportalen.no.</p>
        <%= link_to "Les boligplanen", plan_path(slug: "bolig_bergen"), class: "bplan-btn-pay" %>
        <%= link_to "Portal-legater", legats_path(track: "bolig"), class: "bplan-btn-pay bplan-btn-pay--secondary" %>
      </aside>
    <% end %>

    <aside class="bolig-cta">
      <h2>Bolig i Bergen</h2>
      <p>Startlån og tilskudd er et eget spor — separat fra FoU-budsjett.</p>
      <p>
        <%= link_to "Les boligplanen", plan_path(slug: "bolig_bergen"), class: "bplan-btn-pay" %>
        <%= link_to "Bolig-legater", legats_path(track: "bolig"), class: "bplan-btn-pay bplan-btn-pay--secondary" %>
      </p>
    </aside>

    <% if show_pay_buttons? %>
      <h2>Støtt en idé nå</h2>
      <p class="meta">Beløp fra funding.yml — legatstipend eller innovasjonsmål.</p>
      <table>
        <tr><td><strong>Idé</strong></td><td><strong>Støtt nå</strong></td></tr>
        <% @plans.each do |plan| %>
          <tr>
            <td>
              <%= link_to plan[:title], plan_path(slug: plan[:slug]) %>
              <br><span class="meta"><%= truncate(plan[:pitch], length: 120) %></span>
            </td>
            <td class="bplan-pay-cell">
              <% if plan[:ask_legat_nok].positive? %>
                <%= button_to "Brostøtte NOK #{number_with_delimiter(plan[:ask_legat_nok])}",
                      pay_path(slug: plan[:slug]),
                      method: :post,
                      params: { kind: "legat" },
                      class: "bplan-btn-pay",
                      form: { data: { turbo: false } },
                      title: "Uformell brostøtte — ikke offisiell søknad" %>
              <% end %>
              <% if catalog.show_in_pay?(plan) %>
                <%= button_to "Offisiell IN-mål #{number_with_delimiter(plan[:ask_in_nok])}",
                      pay_path(slug: plan[:slug]),
                      method: :post,
                      params: { kind: "in" },
                      class: "bplan-btn-pay bplan-btn-pay--secondary",
                      form: { data: { turbo: false } },
                      title: "Målbeløp for Innovasjon Norge — krever møte og egenandel" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <h2>Portefølje</h2>
    <p><%= link_to "Full porteføljeoversikt →", portfolio_path %></p>
    <%= catalog.portfolio_summary_html.html_safe %>

    <%= render "shared/deadline_calendar" %>

    <h2>Alt innhold</h2>
    <table>
      <tr><td>→</td><td><%= link_to "#{@plans.size} forretningsplaner", plans_path %></td></tr>
      <tr><td>→</td><td><%= link_to "#{@legat_count} legatsøknader", legats_path %></td></tr>
      <tr><td>→</td><td><%= link_to "Fristkalender", deadlines_path %></td></tr>
    </table>
  </div>
</article>