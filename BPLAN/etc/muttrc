# BPLAN legat batch mailer — use with MUTT_CONFIG=$PWD/BPLAN/etc/muttrc
# OpenBSD: local smtpd relays outbound (see OPENBSD/etc/mail/smtpd.conf)

set from = "bergen@pub.attorney"
set realname = "Johann Tepstad"
set use_from = yes
set envelope_from = yes

# Local OpenBSD smtpd
set smtp_url = "smtp://127.0.0.1:25/"

set charset = "utf-8"
set send_charset = "utf-8"
set content_type = "text/plain"

set copy = no
set record = "~/pub4/BPLAN/legats/outbox/mutt-sent"