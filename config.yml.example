# Claude CLI Configuration Example
# Copy this to ~/.claude/config.yml and customize

# Your Claude API key (required)
# Get your key from: https://console.anthropic.com/
api_key: YOUR_API_KEY_HERE

# API endpoint (default: https://api.anthropic.com)
api_base: https://api.anthropic.com

# Claude model to use
# Available models:
#   - claude-3-5-sonnet-20241022 (recommended, best balance)
#   - claude-3-5-haiku-20241022 (fast, cost-effective)
#   - claude-3-opus-20240229 (most capable, slower)
#   - claude-sonnet-4-20250514 (newest)
model: claude-3-5-sonnet-20241022

# Maximum tokens in response (1-200,000)
max_tokens: 4096

# Sampling temperature (0.0-1.0)
# Lower = more focused/deterministic
# Higher = more creative/random
temperature: 1.0

# Enable streaming responses (true/false)
# When enabled, you'll see responses appear character-by-character
stream: true

# Enable debug logging (true/false)
# Shows retry attempts, API errors, etc.
debug: false
