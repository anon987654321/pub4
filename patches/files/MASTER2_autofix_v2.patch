       private
 
+      # Uses Open3 + explicit argv — no backtick interpolation, no shell injection risk.
+      def git_commit_if_dirty(root, message = "autofix: #{Time.now.utc.iso8601}")
+        return unless system("git", "-C", root, "rev-parse", "--git-dir",
+                             out: File::NULL, err: File::NULL)
+        status, = Open3.capture2("git", "-C", root, "status", "--porcelain")
+        return if status.strip.empty?
+        system("git", "-C", root, "add", "-A")
+        if system("git", "-C", root, "commit", "-m", message)
+          puts "    + committed: #{message}"
+        else
+          warn "    git commit failed"
+        end
+      end

