+    # Reverse alias map: "alias_string" => :canonical_key — built once at load time.
+    ALIAS_MAP = COMMANDS.each_with_object({}) do |(key, cmd), map|
+      (cmd[:aliases] || []).each { |a| map[a.to_s] = key }
+    end.freeze
+
+    def lookup(input)
+      key = input.to_s.strip.downcase.to_sym
+      return COMMANDS[key] if COMMANDS.key?(key)
+      canonical = ALIAS_MAP[key.to_s]
+      COMMANDS[canonical] if canonical
+    end
+
+    def all_aliases  = ALIAS_MAP
+    def primary_commands = COMMANDS.keys
+    def groups = COMMANDS.group_by { |_, v| v[:group] }.transform_values { |cmds| cmds.map(&:first) }
