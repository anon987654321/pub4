+
+    # Text generation via Replicate using Client.complete.
+    # Client.complete handles: build_llm_input (anthropic/deepseek/default schema),
+    # create_prediction, polling, and Result normalisation.
+    # This method is deliberately thin — no HTTP here.
+    def execute_replicate_llm_request(prompt:, messages:, model:, reasoning: nil)
+      unless Replicate.available?
+        return Result.err("REPLICATE_API_TOKEN not set", category: :infrastructure)
+      end
