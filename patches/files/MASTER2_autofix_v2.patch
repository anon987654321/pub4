diff --git a/lib/executor/step_loop.rb b/lib/executor/step_loop.rb
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/lib/executor/step_loop.rb
@@ -0,0 +1,44 @@
+# frozen_string_literal: true
+
+module MASTER
+  class Executor
+    # StepLoop - shared iteration logic for ReAct, PreAct, ReWOO, Reflexion.
+    # Result::Error is defined in lib/result.rb (class Error < StandardError).
+    module StepLoop
+      def run_step_loop(goal, max_steps)
+        start_time = MASTER::Utils.monotonic_now
+        plan       = Plan.new
+
+        max_steps.times do |i|
+          step_num = i + 1
+          return err if (err = timeout_error_for(start_time))
+          step_result = yield step_num, plan
+          case step_result
+          when :continue then next
+          when Result    then return step_result
+          else return Result.err("StepLoop: unexpected block return: #{step_result.inspect}")
+          end
+        end
+
+        Result.err("Max steps (#{max_steps}) reached without completion")
+      end
+
+      private
+
+      def timeout_error_for(start_time)
+        check_timeout!(start_time)
+        nil
+      rescue Result::Error => err
+        Result.err(err.message, category: :timeout)
+      end
+    end
+  end
+end

diff --git a/lib/file_collector.rb b/lib/file_collector.rb
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/lib/file_collector.rb
@@ -0,0 +1,34 @@
+# frozen_string_literal: true
+
+module MASTER
+  module FileCollector
+    SKIP_DIRS = %w[.git vendor tmp node_modules var log coverage .bundle].freeze
+    module_function
+
+    def ruby_files(path) = collect(path, ["*.rb"])
+
+    def all_files(path, extensions: %w[.rb .sh .zsh .html .erb .yml .yaml .js .ts .css])
+      collect(path, extensions.map { |e| "*#{e}" })
+    end
+
+    private
+    module_function
+
+    def collect(path, globs)
+      path = path.to_s
+      return [path] if File.file?(path)
+      return [] unless File.directory?(path)
+      globs.flat_map { |g| Dir.glob(File.join(path, "**", g)) }
+           .uniq.reject { |f| SKIP_DIRS.any? { |d| f.include?("/#{d}/") } }.sort
+    end
+  end
+end

