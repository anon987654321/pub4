+      sys = messages&.find { |m| m[:role] == "system" }
+      opts = {}
+      opts[:reasoning_effort] = reasoning[:effort].to_s if reasoning.is_a?(Hash) && reasoning[:effort]
+
+      Replicate::Client.complete(model, prompt, system_prompt: sys&.dig(:content), **opts)
+    end

