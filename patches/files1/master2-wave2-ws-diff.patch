+  // ── WebSocket connection (replaces HTTP POST + poll) ───────────────────────
+  // DeepSeek: "polling halves latency" — WebSocket was already on server but
+  // cli.html never used it. Fixed in wave 2.
+  let ws = null;
+  let wsReady = false;
+  let wsRetryDelay = 1000;
+  let wsRetryTimer = null;
+  let pendingBub = null;
+  let pendingCursor = null;
+  let pendingFullText = '';
+
+  function wsUrl() {
+    const proto = location.protocol === 'https:' ? 'wss' : 'ws';
+    const tok   = TOKEN ? `?token=${encodeURIComponent(TOKEN)}` : '';
+    const sid   = sessionId ? `&session_id=${encodeURIComponent(sessionId)}` : '';
+    return `${proto}://${location.host}/ws${tok}${sid}`;
+  }
+
+  function connectWs() {
+    clearTimeout(wsRetryTimer);
+    try {
+      ws = new WebSocket(wsUrl(), ['chat']);
+    } catch (e) {
+      scheduleWsRetry();
+      return;
+    }
+
+    ws.onopen = () => {
+      wsReady = true;
+      wsRetryDelay = 1000;
+      Logging.dmesg_log?.('ws0', 'connected');
+    };
+
+    ws.onclose = () => {
+      wsReady = false;
+      scheduleWsRetry();
+    };
+
+    ws.onerror = () => {
+      wsReady = false;
+    };
+
+    ws.onmessage = evt => {
+      let data;
+      try { data = JSON.parse(evt.data); } catch { return; }
+
+      if (data.type === 'chunk') {
+        // Append chunk to streaming bubble
+        if (pendingBub) {
+          if (pendingCursor) { pendingCursor.remove(); pendingCursor = null; }
+          pendingFullText += data.text || '';
+          pendingBub.textContent = pendingFullText;
+          transcript.scrollTop = transcript.scrollHeight;
+        }
+      } else if (data.type === 'done') {
+        // Response complete — start TTS, update meta
+        const meta = data.meta?.tier ? `${data.meta.tier}` : '';
+        modelLine.textContent = meta;
+        if (pendingBub) pendingBub = null;
+        setState('speaking');
+        speak(pendingFullText);
+        pendingFullText = '';
+      } else if (data.type === 'error') {
+        if (pendingBub) {
+          if (pendingCursor) { pendingCursor.remove(); pendingCursor = null; }
+          pendingBub.textContent = `error: ${data.message}`;
+          pendingBub.style.color = '#ff4444';
+          pendingBub = null;
+        }
+        setState('idle');
+        pendingFullText = '';
+      } else if (data.type === 'session') {
+        sessionId = data.session_id || sessionId;
+        sessionStorage.setItem('master_session_id', sessionId);
+      }
+    };
+  }
+
+  function scheduleWsRetry() {
+    wsRetryTimer = setTimeout(() => {
+      wsRetryDelay = Math.min(wsRetryDelay * 1.5, 30000);
+      connectWs();
+    }, wsRetryDelay);
+  }
+
+  // Send a message via WebSocket; fall back to HTTP POST if WS not ready.
+  async function sendMessage(text) {
+    if (!text.trim()) return;
+    setState('thinking');
+    addMsg('user', text);
+    liveText.textContent = '';
+    liveText.className = 'hint';
+
+    const { bub, cursor } = addStreamingMsg();
+    pendingBub    = bub;
+    pendingCursor = cursor;
+    pendingFullText = '';
+
+    if (wsReady && ws?.readyState === WebSocket.OPEN) {
+      // WebSocket path — low latency, streaming chunks
+      ws.send(JSON.stringify({ type: 'chat', message: text, session_id: sessionId }));
+    } else {
+      // HTTP fallback (WS not yet connected or degraded environment)
+      try {
+        const res = await fetch('/chat', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json',
+                     ...(TOKEN && { 'Authorization': `Bearer ${TOKEN}` }) },
+          body: JSON.stringify({ text, session_id: sessionId }),
+        });
+        if (!res.ok) throw new Error(`HTTP ${res.status}`);
+        const data = await res.json();
+        sessionId = data.session_id || sessionId;
+        sessionStorage.setItem('master_session_id', sessionId);
+        const fullText = data.response || data.text || '';
+        cursor.remove();
+        bub.textContent = fullText;
+        pendingBub = null;
+        setState('speaking');
+        speak(fullText);
+      } catch (e) {
+        cursor.remove();
+        bub.textContent = `error: ${e.message}`;
+        bub.style.color = '#ff4444';
+        pendingBub = null;
+        setState('idle');
+      }
+    }
+  }

