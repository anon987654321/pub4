 # frozen_string_literal: true
 
 module MASTER
-  # SelfRefactor — applies the refactor pipeline to MASTER2's own source
-  # REPLACED: All batch/staging/convergence logic now lives in MultiRefactor.
-  # See wave-2 pruning rationale in CHANGELOG.
+  # SelfRefactor — thin wrapper over MultiRefactor for self-application.
+  # ONE_SOURCE: MultiRefactor owns the batch-refactor engine; this module
+  # provides the conventional entry point expected by bin/master.
   module SelfRefactor
-    # [68 lines of duplicated implementation — REMOVED in wave 2]
-    # Pruned: staging loop, convergence detection, resume-on-interrupt,
-    # backup logic, syntax validation (all now in MultiRefactor).
-
-    def self.run(...)
-      # [was 40-line method]
-    end
-
-    def self.apply_to_self(...)
-      # [was 20-line method]
-    end
+    extend self
+
+    DEFAULT_PATH = File.join(MASTER.root, "lib").freeze
+
+    # Apply MASTER2's refactor pipeline to its own source.
+    def run(path: nil, dry_run: true, budget_cap: 2.0,
+            force_rewrite: false, align_axioms: true,
+            include_all_files: false, grounded_depth: :own)
