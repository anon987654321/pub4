### 1. lib/server.rb — OpenBSD fstat fix
# lsof is not installed on OpenBSD. This caused kill_port_users to silently
# fail, leaving stale server processes on port. Fixed with fstat/sockstat.

diff --git a/lib/server.rb b/lib/server.rb
--- a/lib/server.rb
+++ b/lib/server.rb
@@ -56,9 +56,21 @@ module MASTER
 
     def kill_port_users(port)
-      pids = `lsof -ti:#{port} 2>/dev/null`.strip.split("\n").map(&:to_i).reject(&:zero?)
+      pids = openbsd_port_pids(port)
       pids.each { |pid| Process.kill("TERM", pid) rescue nil }
       sleep 0.3 unless pids.empty?
     rescue StandardError
       nil
     end
 
+    # OpenBSD: fstat lists open files; awk extracts PIDs on our port.
+    # Falls back to lsof for Linux/macOS dev environments.
+    def openbsd_port_pids(port)
+      if File.exist?("/usr/bin/fstat")
+        `fstat 2>/dev/null | awk '$NF == "#{port.to_i}" {print $3}'`
+          .strip.split("\n").map(&:to_i).reject(&:zero?)
+      else
+        `lsof -ti:#{port} 2>/dev/null`.strip.split("\n").map(&:to_i).reject(&:zero?)
+      end
+    end

