### 5. lib/executor/tools.rb — ONE_SOURCE: generate from ToolProtocol registry

# DeepSeek: "The same tools are described in three places (ToolProtocol,
# ToolDispatch, llm/tools.rb), leading to drift risk."
# Fix: build RubyLLM tool wrappers dynamically from ToolProtocol.registry.

diff --git a/lib/executor/tools.rb b/lib/executor/tools.rb
--- a/lib/executor/tools.rb
+++ b/lib/executor/tools.rb
@@ Head of file @@
 # frozen_string_literal: true
+# ONE_SOURCE: Tool class definitions are generated from ToolProtocol.registry.
+# Do not add tool descriptions here manually — add them to ToolProtocol instead.
+# This file's job is to translate the registry into RubyLLM::Tool subclasses.
 
 module MASTER
   module Executor
     module Tools
+      # Build RubyLLM-compatible tool class from a ToolProtocol entry.
+      # Called once at boot after ToolProtocol.register_all.
+      def self.build_tool_class(name, spec)
+        klass = Class.new(RubyLLM::Tool) do
+          description spec[:description]
+          spec[:params]&.each do |param_name, param_spec|
+            param param_name,
+                  desc: param_spec[:description],
+                  type: param_spec[:type] || "string",
+                  required: param_spec[:required] != false
+          end
+
+          define_method(:execute) do |**args|
+            ToolDispatch.call(name, **args)
+          end
+        end
+        # Register under a constant so ruby_llm can find it
+        const_set(name.to_s.camelize, klass)
+        klass
+      end
+
+      # Generate all tool classes from registry on first call.
+      def self.all
+        @all ||= ToolProtocol.registry.map do |name, spec|
+          build_tool_class(name, spec)
+        end
+      end

-      # [Previously: ~200 lines of manually duplicated tool class definitions]
-      # Each class re-stated tool name, description, params — identical to
-      # what ToolProtocol.register already stores.
-      # REMOVED: All manually written tool classes replaced by build_tool_class.
-      # Callers use Tools.all to get the generated array.
     end
   end
 end

