### 7. lib/pipeline.rb — Legacy :stages mode deprecation notice

# DeepSeek: "Maintaining two parallel paths doubles testing effort.
# The executor mode already replicates all stage pipeline functionality."
#
# This patch adds a DEPRECATION warning but does not remove :stages yet.
# Removal planned for wave 3 after confirming no external callers.

diff --git a/lib/pipeline.rb b/lib/pipeline.rb
--- a/lib/pipeline.rb
+++ b/lib/pipeline.rb
@@ Pipeline#call @@
     def call(input, session: nil)
       case @mode
       when :stages
+        # DEPRECATED: :stages mode will be removed in wave 3.
+        # Use :executor mode (the default). All stage logic is available
+        # in Executor and its strategies. This path is no longer tested.
+        Logging.warn("pipeline: :stages mode is deprecated; switch to :executor",
+                     subsystem: "Pipeline")
         run_stages(input, session: session)
       when :executor
         run_executor(input, session: session)
       else
         raise ArgumentError, "unknown pipeline mode: #{@mode}"
       end
     end

