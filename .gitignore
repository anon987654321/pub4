OUTPUT_*.md
*.gem
*.rbc
*.so
*.tgz
*.tar.gz
.bundle
vendor/bundle/
node_modules/
coverage/

# Logs and databases
*.log
*.log.*
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# Runtime and temp files
tmp/
.session_recovery

# OS files
.DS_Store
Thumbs.db

