# --- MASTER -----------------------------------------------------------------

# Runtime state: memory journals, constitution cost tracking, locks, output.
memory/*.jsonl
:memory:/
.constitutional_costs.jsonl
.constitutional_memory.json
# Per-check outcome history (OPENBSD/lib/check_ledger.rb). Append-only and written
# by every check run, so a committed copy would conflict in a shared checkout.
.check_ledger.jsonl
.master/
MASTER/.constitutional_locks/
MASTER/output/
MASTER/web/script/three_build/
MASTER/web/public/assets/

# Snapshots are generated local transport packs; they never belong in git history.
snapshot_*.md

# Each generated pack contains a tree listing and every tracked text file verbatim.
# The operator regenerates the parts when a fresh source mirror is needed.
# --- RAILS ------------------------------------------------------------------

# Propshaft digest output — regenerated by assets:precompile on every deploy;
# committing it bloats history and goes stale immediately.
RAILS/*/public/assets/
RAILS/*/app/assets/builds/
RAILS/*/vendor/bundle/

# visual_contract_check.rb screenshot/diff renders — regenerated every check run
# from live app pages; only the *-manifest.json baselines are tracked.
RAILS/visual_contract/*.png

# Generated by CHECK_CALIBRATION_APPLY=1
RAILS/checks/data/calibration_weights.yml

# ActiveStorage blobs. These are user uploads, written at runtime into
# RAILS/<app>/storage/ as two-character shard directories, plus the sqlite
# database files themselves. 91 of them were sitting untracked on 2026-07-29,
# one `git add -A` away from committing user content into the repo.
# The .keep files stay tracked so the directory survives a clean checkout.
RAILS/*/storage/*
!RAILS/*/storage/.keep

# --- OPENBSD ----------------------------------------------------------------

# Zone files are generated by OPENBSD/bin/render_dns.rb and tracked. Git is where
# the SOA serial history lives: a fresh checkout that regenerated them from
# nothing would restart serials at today's 01 and could hand ns.hyp.net a lower
# number than it already holds, which makes a secondary refuse every transfer
# until we climb back past it. Tracking them is also what lets `render_dns.rb
# --check` and config_drift_check say whether the box and the repo agree.
#
# Everything derived from a signing key stays out: K*.private is the key itself,
# and .zone.signed, K*.key and *.ds are all reproducible from it on the box.
OPENBSD/var/nsd/zones/master/*
!OPENBSD/var/nsd/zones/master/*.zone

# --- studio/dilla -----------------------------------------------------------
#
# Generated and scratch audio: large (~4GB locally) and reproducible by running
# the engine, so none of it is tracked. Two of these files are past GitHub's
# 100MB hard push limit and LFS is not an option — the account's budget is
# exhausted.
#
# samples/ is NOT tracked either, and this paragraph used to say it was. The
# rule that governs it lives in STUDIO/dilla/.gitignore, which ignores both
# samples/ and crate/ on the newer decision that audio is irreplaceable, is
# backed up as files, and does not belong in git. That reversal came out of
# the same 2026-08-03 incident as the vocals note below: samples/ carries
# source takes from released records, which is exactly what should not be in
# a public repository. What IS worth tracking from a sample directory is the
# provenance record beside it, not the audio — the split the vocals note
# describes.
#
# This mattered: read literally, this file promised that 51 curated files
# existing only on one laptop were safely in the repo.

# Vocal stems the learner reads at render time. The audio is NOT tracked; the
# meta.json and catalog.json beside it are, because the record of what a stem is
# and where it came from is the part worth keeping in the repo -- the same split
# samples/dug/provenance.json already makes.
#
# 1029.7 MB across 101 files was tracked until 2026-08-03, in a PUBLIC repository,
# including acapellas from commercially released records. Untracking fixes the tip
# only: the blobs remain reachable in history exactly as MASTER/web/config/master.key
# does, so treat a clone as still carrying them until someone purges it.
MASTER/tools/dilla/project/learnings/vocals/**/*.wav
MASTER/tools/dilla/project/learnings/vocals/**/*.flac
MASTER/tools/dilla/project/learnings/vocals/**/*.raw

# Engine output. Every renderer writes beside dilla.rb, and the audio is NOT
# tracked -- a render reproduces from its seed and the repo is not where 15MB
# takes belong, the same split the vocals section above makes. What IS tracked
# is the record: the .provenance.json sidecar, the quality.json measurement and
# the stem motifs/session json. STUDIO/dilla/.gitignore names the audio; the
# lines here name the ones that would otherwise reach the repo root.
#
# A full session sat at the repo root until 2026-08-31, which is how the
# root-invariant rule in CLAUDE.md learned about renders at all: dilla writes to
# $PWD unless DILLA_OUTPUT_DIR says otherwise.
MASTER/tools/dilla/demo*.wav
MASTER/tools/dilla/demo*.mp3
# No rendered audio is tracked, demo.mp3 and RELEASE.mp3 included (operator,
# 2026-08-24). demo.mp3 carried an exception here for a while on the argument
# that a demo which exists on one machine is not a demo; that argument lost to
# the simpler one, which is that a render is reproducible output and the repo is
# not where it belongs. They were 88 MB and 33 MB against GitHub's hard 100 MB
# per-file push limit, with no LFS available (see the note at the top of this
# section) — so the exception was also one good render away from blocking a push.
#
# Untracked, not deleted: both files stay on disk. A dilla render is not
# reproducible — the seed and performer rotate per run — so deleting one loses a
# take for good, whatever its current state.
MASTER/tools/dilla/RELEASE.mp3
# `demo-each` writes the catalogue one mp3 per track into the dilla root as
# NN_title.mp3. These are TRACKED, against the rule above that generated audio
# is not, and the exception is deliberate: this set IS the current demo -- the
# thing you send someone, and the thing the next change gets compared against --
# and a demo that exists on one machine can serve neither purpose.
#
# They are small enough to justify it. Eight tracks at 12-16 bars is under 10 MB,
# against the 508 MB the full-catalogue concat ran to, which is why demo*.wav
# two lines up stays ignored. demo.mp3 is now the exception to that exception --
# see its note above; the 508 MB figure is the WAV, and the mp3 of the curated
# catalogue is a fifth of it.
#
# Prune freely: re-running demo-each replaces them, and demo_manifest.tsv beside
# them records the seed, the engine and the settings behind each take.
MASTER/tools/dilla/check_*.wav
MASTER/tools/dilla/dilla_beat_live*.mp3
# Round renders (rN_title.mp3) and their pre-master intermediates. Unlike the
# NN_title.mp3 demo set above these are per-session takes, not the current demo,
# so nobody is sent them and nothing is compared against them -- they are the
# reproducible output the rule at the top of this section describes. 22 MB was
# sitting untracked here because no pattern named them.
MASTER/tools/dilla/r[0-9]_*.mp3
MASTER/tools/dilla/*.pre.raw
# Full-length liveset bounces pulled from a YouTube source rip.
MASTER/tools/dilla/liveset_yt_*.wav

# Engine scratch. scratch/ is one visible folder instead of a dozen dot-entries
# at the project root; the dot-patterns catch strays from pre-scratch versions,
# and .dilla_progressions_log.txt is unanchored because old code wrote it into
# whatever directory it ran from.
MASTER/tools/dilla/scratch/
MASTER/tools/dilla/.cache/
MASTER/tools/dilla/.dilla_*
MASTER/tools/dilla/.harmony_*.wav
MASTER/tools/dilla/.live_tmp.wav
MASTER/tools/dilla/.all_tracks_demo/
MASTER/tools/dilla/analysis/
.dilla_progressions_log.txt

# Machine-produced sample subtrees: demux/ is demucs stem output, yt_*.wav are
# downloaded source rips, dug/ audio is public domain and re-fetchable from the
# provenance manifest beside it.
MASTER/tools/dilla/samples/demux/
MASTER/tools/dilla/samples/yt_*.wav
MASTER/tools/dilla/samples/crate/
MASTER/tools/dilla/samples/dug/**/*.mp3
MASTER/tools/dilla/samples/dug/**/*.flac
MASTER/tools/dilla/samples/dug/**/*.wav

# "ikke dele" is the operator saying do not share, in the filename, and this repo
# is public. Three such files were sitting untracked in
# samples/johann_ableton/ on 2026-08-13 with nothing stopping a `git add -A` from
# publishing them — the same shape as the seven master.key blobs that are burned
# into this repository's history and cannot be un-burned, which is what
# RAILS/test/tracked_secrets_test.rb exists to remember.
#
# Narrow on purpose. 427 sample files under samples/ are tracked deliberately;
# the crate is the point of dilla and its copyright exposure is a decision
# already taken. This matches the marking, not the directory, so the rule
# travels with any file the operator names that way.
#
# None of the three had ever been committed when this went in, so ignoring them
# is sufficient. If one ever is, ignoring will not remove it. The current
# historical-secret and private-media review is the private_media_and_history seam in MASTER/data/operator_seams.yml and
# RAILS/test/tracked_secrets_test.rb. Deleting from HEAD never purges public Git
# history; any purge requires a separate filter-repo plan coordinated across
# reachable refs and clones before rewriting and force-pushing.
*ikke-dele*
*ikke_dele*

# Python venvs the audio tools shell out to (demucs stem separation, librosa
# analysis) — rebuilt locally, never shipped.
MASTER/tools/dilla/.venv-demucs/
MASTER/tools/dilla/venv-librosa/

# --- studio/lora ------------------------------------------------------------

# Training caches, extracted frames, staging copies, and reproducible bundles.
# <subject>/.cache/ is every lane's scratch: dataset zips, downloaded trainer
# tars, staged Kaggle payloads.
STUDIO/replicate/lora/**/.cache/
STUDIO/replicate/lora/**/_frames/
STUDIO/replicate/lora/**/_latent_cache/
STUDIO/replicate/lora/**/.aitk_size.json
STUDIO/replicate/lora/**/raw/
STUDIO/replicate/lora/**/*.zip
STUDIO/replicate/lora/**/*.pid

# ai-toolkit run artifacts: it writes samples and a copy of the config it was
# handed into the training folder on every run.
STUDIO/replicate/lora/*/train_run.log
STUDIO/replicate/lora/*/weights/*/samples/
STUDIO/replicate/lora/*/weights/*/config.yaml

# Photographs of people, and everything derived from them.
#
# These were untracked because nobody had run `git add` on them, which is not
# the same as being protected: one `git add STUDIO/replicate/lora` and seventeen
# photographs of a real person are in a public repository's history forever.
# lora/README.md has always said committing them publishes the face and that
# deleting them later does not remove it — this is that sentence made
# load-bearing.
#
# The subject is not the operator. Ragnhild's likeness is hers, and the cost of
# an accident here is not a revert.
#
# Deliberate publication is still possible with `git add -f`, which is the point:
# it should take a decision rather than a reflex.
MASTER/tools/lora/*/sources/
MASTER/tools/lora/*/dataset/
MASTER/tools/lora/*/dataset_*/
MASTER/tools/lora/*/retouched/
MASTER/tools/lora/*/out/
MASTER/tools/lora/*/weights/
MASTER/tools/lora/*/contact_sheet.jpg

# --- STUDIO/replicate/lora privacy ----------------------------------------------------
#
# The live tool moved from MASTER/tools/lora to STUDIO/replicate/lora. Keep subject
# datasets, source captures, retouched media, outputs and weights out of the
# public repo at their actual path; deliberate publication still requires -f.
STUDIO/replicate/lora/*/sources/
STUDIO/replicate/lora/*/_previous/
STUDIO/replicate/lora/*/dataset/
STUDIO/replicate/lora/*/dataset_*/
STUDIO/replicate/lora/*/retouched/
STUDIO/replicate/lora/*/out/
STUDIO/replicate/lora/out/
STUDIO/replicate/lora/*/weights/
STUDIO/replicate/lora/*/contact_sheet.jpg

# Postpro's fetched model weights and the depth maps cached under them are
# generated assets — the fetch command and sizes live in STUDIO/postpro/README.md.
STUDIO/postpro/models/

# Postpro source captures and generated renders. These rules prevent future
# untracked additions; they do not untrack originals that are already in Git.
# The publication and history decision is recorded in MASTER/data/operator_seams.yml.
# A render always sits beside its source, wherever in the tree that is, so the
# render rules apply repo-wide.
STUDIO/postpro/IMG_*
postpro_*.jpg
postpro_*.jpeg
postpro_*.png
postpro_*.webp
postpro_*.tif
postpro_*.tiff
postpro_*.jpg.json
postpro_*.jpeg.json
postpro_*.png.json
postpro_*.webp.json
postpro_*.tif.json
postpro_*.tiff.json

# Claude Code per-machine permission allowlist. settings.json is the shared
