# --- MASTER -----------------------------------------------------------------

# Runtime state: memory journals, constitution cost tracking, locks, output.
memory/*.jsonl
:memory:/
.constitutional_costs.jsonl
.constitutional_memory.json
.master/
MASTER/.constitutional_locks/
MASTER/output/
MASTER/web/script/three_build/
MASTER/web/public/assets/

# Generated snapshots. Share-packs (a tree listing plus every text file
# verbatim, ~13MB a set) are written to the repo root carrying their date, so
# they sit beside the code they describe.
/snapshot.md
/snapshot_*.md
MASTER/snapshot.md
/*_snapshot.md
/*_snapshot_*.md

# --- RAILS ------------------------------------------------------------------

# Propshaft digest output — regenerated by assets:precompile on every deploy;
# committing it bloats history and goes stale immediately.
RAILS/*/public/assets/
RAILS/*/app/assets/builds/*.css.map
RAILS/*/vendor/bundle/

# visual_contract_gate.rb screenshot/diff renders — regenerated every gate run
# from live app pages; only the *-manifest.json baselines are tracked.
RAILS/visual_contract/*.png

# Generated by GATE_CALIBRATION_APPLY=1
RAILS/gates/data/calibration_weights.yml

# ActiveStorage blobs. These are user uploads, written at runtime into
# RAILS/<app>/storage/ as two-character shard directories, plus the sqlite
# database files themselves. 91 of them were sitting untracked on 2026-07-29,
# one `git add -A` away from committing user content into the repo.
# The .keep files stay tracked so the directory survives a clean checkout.
RAILS/*/storage/*
!RAILS/*/storage/.keep

# --- OPENBSD ----------------------------------------------------------------

# NSD zone and DNSSEC outputs are regenerated from OPENBSD/var/nsd templates.
OPENBSD/var/nsd/zones/master/*
!OPENBSD/var/nsd/zones/master/zone.tmpl

# --- studio/dilla -----------------------------------------------------------
#
# Generated and scratch audio: large (~4GB locally) and reproducible by running
# the engine, so none of it is tracked. Two of these files are past GitHub's
# 100MB hard push limit and LFS is not an option — the account's budget is
# exhausted. What IS tracked on purpose: samples/ (the curated kits and source
# takes the generator reads at runtime) and samples/dug/provenance.json, the
# record of what each dug side is and why it may be used.

# Vocal stems the learner reads at render time. The audio is NOT tracked; the
# meta.json and catalog.json beside it are, because the record of what a stem is
# and where it came from is the part worth keeping in the repo -- the same split
# samples/dug/provenance.json already makes.
#
# 1029.7 MB across 101 files was tracked until 2026-08-03, in a PUBLIC repository,
# including acapellas from commercially released records. Untracking fixes the tip
# only: the blobs remain reachable in history exactly as MASTER/web/config/master.key
# does, so treat a clone as still carrying them until someone purges it.
STUDIO/dilla/project/learnings/vocals/**/*.wav
STUDIO/dilla/project/learnings/vocals/**/*.flac
STUDIO/dilla/project/learnings/vocals/**/*.raw

# Engine output
STUDIO/dilla/renders/
STUDIO/dilla/demo*.wav
STUDIO/dilla/demo*.mp3
# demo.mp3 itself is tracked, and only that one name. dilla.rb has always called
# it "the artifact worth tracking" and printed "(tracked artifact)" to the
# operator as it wrote the file -- while this rule ignored it. One of the two was
# wrong for as long as both existed; the code's account is the one being kept.
#
# The WAV above stays ignored and that is not an oversight: it is the working
# master and runs 5-7x the mp3 (130 MB for 25 tracks against roughly 30 MB).
#
# Size is the live constraint here, not a formality. GitHub's hard per-file push
# limit is 100 MB, LFS is not available (see the note at the top of this
# section), and the curated 86-track demo measures 71 minutes -- which is 102 MB
# at dilla's default 192kbps and would be REJECTED at push. It fits at 128k
# (68 MB) or 96k (51 MB). If the catalogue grows or bars go up, re-measure before
# assuming the next demo still fits.
!STUDIO/dilla/demo.mp3
# `demo-each` writes the catalogue one mp3 per track into the dilla root as
# NN_title.mp3. These are TRACKED, against the rule above that generated audio
# is not, and the exception is deliberate: this set IS the current demo -- the
# thing you send someone, and the thing the next change gets compared against --
# and a demo that exists on one machine can serve neither purpose.
#
# They are small enough to justify it. Eight tracks at 12-16 bars is under 10 MB,
# against the 508 MB the full-catalogue concat ran to, which is why demo*.wav
# two lines up stays ignored. demo.mp3 is now the exception to that exception --
# see its note above; the 508 MB figure is the WAV, and the mp3 of the curated
# catalogue is a fifth of it.
#
# Prune freely: re-running demo-each replaces them, and demo_manifest.tsv beside
# them records the seed, the engine and the settings behind each take.
STUDIO/dilla/check_*.wav
STUDIO/dilla/dilla_beat_live*.mp3
# Round renders (rN_title.mp3) and their pre-master intermediates. Unlike the
# NN_title.mp3 demo set above these are per-session takes, not the current demo,
# so nobody is sent them and nothing is compared against them -- they are the
# reproducible output the rule at the top of this section describes. 22 MB was
# sitting untracked here because no pattern named them.
STUDIO/dilla/r[0-9]_*.mp3
STUDIO/dilla/*.pre.raw
# Full-length liveset bounces pulled from a YouTube source rip.
STUDIO/dilla/liveset_yt_*.wav

# Engine scratch. scratch/ is one visible folder instead of a dozen dot-entries
# at the project root; the dot-patterns catch strays from pre-scratch versions,
# and .dilla_progressions_log.txt is unanchored because old code wrote it into
# whatever directory it ran from.
STUDIO/dilla/scratch/
STUDIO/dilla/.cache/
STUDIO/dilla/.dilla_*
STUDIO/dilla/.harmony_*.wav
STUDIO/dilla/.live_tmp.wav
STUDIO/dilla/.all_tracks_demo/
STUDIO/dilla/analysis/
.dilla_progressions_log.txt

# Machine-produced sample subtrees: demux/ is demucs stem output, yt_*.wav are
# downloaded source rips, dug/ audio is public domain and re-fetchable from the
# provenance manifest beside it.
STUDIO/dilla/samples/demux/
STUDIO/dilla/samples/yt_*.wav
STUDIO/dilla/samples/crate/
STUDIO/dilla/samples/dug/**/*.mp3
STUDIO/dilla/samples/dug/**/*.flac
STUDIO/dilla/samples/dug/**/*.wav

# Python venvs the audio tools shell out to (demucs stem separation, librosa
# analysis) — rebuilt locally, never shipped.
STUDIO/dilla/.venv-demucs/
STUDIO/dilla/venv-librosa/

# --- studio/lora ------------------------------------------------------------

# Training caches, extracted frames, staging copies, and reproducible bundles.
# <subject>/.cache/ is every lane's scratch: dataset zips, downloaded trainer
# tars, staged Kaggle payloads.
STUDIO/lora/**/.cache/
STUDIO/lora/**/_frames/
STUDIO/lora/**/_latent_cache/
STUDIO/lora/**/.aitk_size.json
STUDIO/lora/**/raw/
STUDIO/lora/**/*.zip
STUDIO/lora/**/*.pid

# ai-toolkit run artifacts: it writes samples and a copy of the config it was
# handed into the training folder on every run.
STUDIO/lora/*/train_run.log
STUDIO/lora/*/weights/*/samples/
STUDIO/lora/*/weights/*/config.yaml
