# Build artifacts and outputs
OUTPUT_*.md
*.gem
*.rbc
*.tgz
*.tar.gz
.bundle
vendor/bundle
# Propshaft digest output — regenerated by assets:precompile on every deploy;
# committing it bloats history and goes stale immediately.
RAILS/*/public/assets/
MASTER/web/public/assets/

# visual_contract_gate.rb screenshot/diff renders — regenerated every gate
# run from live app pages; only the *-manifest.json baselines are tracked.
RAILS/visual_contract/*.png

# Logs and databases
*.log
*.log.*
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# Runtime and temp files
.session_recovery

# Local IDE caches
.aider.tags.cache.v4/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
.claude/worktrees/
*.swp
*.swo

# Memory files (runtime data)
memory/*.jsonl
:memory:/

# Constitution costs (runtime tracking)
.constitutional_costs.jsonl
.constitutional_memory.json

# Operator secrets (keys live in priv/; see priv/.gitignore)
priv/ssh/
!priv/ssh/*.pub

# Environment files with secrets
.env
.env.local
!.env.example
**/config/master.key

# Coverage reports
coverage/

# Node modules (if any JS tooling)
node_modules/
MASTER/web/script/three_build/
MASTER/.constitutional_locks/

# Repo-relative temp dir
tmp/
RAILS/*/vendor/bundle/
*.so

# Generated MASTER snapshots / runtime
/snapshot.md
/snapshot_*.md
MASTER/snapshot.md
# Full share-pack snapshots (MASTER/OPENBSD/RAILS/STUDIO — tree listing plus
# every text file verbatim, ~13MB a set). Written into the repo root from
# 2026-07-31, each carrying its date, so they sit beside the code they
# describe and are findable without a folder or a dotfolder to look in.
/*_snapshot_*.md
/*_snapshot.md
.master/
MASTER/output/

# studio/dilla build artifacts and local audio scratch
# (moved 2026-07-25 from MASTER/tools/dilla/ to the sibling studio/dilla/;
# dilla itself never moved to OPERATOR)
studio/dilla/analysis/
# .cache/ is the engine's consolidated scratch dir (SCRATCH_DIR in engine.rb);
# the dotfile patterns below it catch strays from pre-.cache versions.
studio/dilla/.cache/
studio/dilla/.dilla_*
# pre-.cache engine versions wrote this into whatever directory they ran
# from — match it anywhere until no old-code process remains
.dilla_progressions_log.txt
studio/dilla/.live_tmp.wav
studio/dilla/dilla_beat_live*.mp3
# Python venvs for the audio tools studio/dilla and studio/radio-bergen shell
# out to (demucs stem separation, librosa analysis) — rebuilt locally, never shipped.
studio/dilla/.venv-demucs/
studio/radio-bergen/.venv/
# ad-hoc check renders left in the tool's own directory by manual listening passes
studio/dilla/check_*.wav
# demo-all's per-piece scratch: 84 intermediate WAVs plus concat/order/catalog
# lists, regenerated on every run and resumable from disk. The demo itself is
# tracked as studio/dilla/demo.mp3 — 192kbps keeps the whole catalogue in git
# at a couple of megabytes, where the WAV master runs to hundreds.
studio/dilla/.all_tracks_demo/
RAILS/*/app/assets/builds/*.css.map

# NSD zone and DNSSEC outputs are regenerated from OPENBSD/var/nsd templates.
OPENBSD/var/nsd/zones/master/*
!OPENBSD/var/nsd/zones/master/zone.tmpl

# LoRA training caches, extracted frames, staging copies, and reproducible bundles.
lora/**/.cache/
lora/**/_frames/
lora/**/_latent_cache/
lora/**/.aitk_size.json
lora/**/raw/
lora/**/*.zip
lora/**/*.pid

# MASTER/tools/dilla generated + scratch audio — large, regenerable. Never track.
# KEPT on purpose (inputs the generator reads, do NOT ignore):
#   - MASTER/tools/dilla/vocals_*.wav  (source vocal takes — VOCALS{} in dilla.rb)
#   - MASTER/tools/dilla/samples/      (drum kits read at runtime)
MASTER/tools/dilla/renders/
MASTER/tools/dilla/.harmony_*.wav
vendor/bundle/

# Generated by GATE_CALIBRATION_APPLY=1
RAILS/gates/data/calibration_weights.yml
studio/dilla/samples/crate/
# Dug public-domain audio: large, and re-fetchable from the manifest beside it.
# samples/dug/provenance.json is deliberately NOT ignored -- it is the record of
# what each side is, where it came from and why it may be used, and it is worth
# more than the audio.
studio/dilla/samples/dug/**/*.mp3
studio/dilla/samples/dug/**/*.flac
studio/dilla/samples/dug/**/*.wav

# ActiveStorage blobs. These are user uploads, written at runtime into
# RAILS/<app>/storage/ as two-character shard directories, plus the sqlite
# database files themselves. 91 of them were sitting untracked on 2026-07-29,
# one `git add -A` away from committing user content into the repo.
# The .keep files stay tracked so the directory survives a clean checkout.
RAILS/*/storage/*
!RAILS/*/storage/.keep
studio/dilla/demo*.wav

# The renders/scratch rules above still name MASTER/tools/dilla/, which stopped
# existing when dilla moved to studio/dilla on 2026-07-25 — so ~2GB of
# regenerable audio has been sitting unignored ever since, one `git add -A`
# away from entering history permanently. Same intent, current path.
#
# studio/dilla/samples/ itself stays tracked on purpose (the curated drum kits
# the generator reads at runtime). Only the machine-produced subtrees are
# ignored: demux/ is demucs stem output, yt_*.wav are downloaded source rips.
studio/dilla/renders/
studio/dilla/.harmony_*.wav
studio/dilla/samples/demux/
studio/dilla/samples/yt_*.wav

# dilla scratch: one visible folder instead of a dozen dot-entries at the
# project root (.cache, .dilla_*.wav, .harmony_*.wav, .live_tmp.wav,
# .venv-demucs, .all_tracks_demo). Generated audio should be findable by
# anyone looking at the tree, and all of it is regenerable.
studio/dilla/scratch/
